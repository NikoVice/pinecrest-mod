/*

    Стоимость предметов для ограбления: 10000 + 20000 + 25000 + 10000 + 20000 + 25000 + 10000 + 5000 + 5000 + 10000 + 5000 = 145000
        Nope: 145000;
        C: 290000;
        B: 435000;
        A: 580000;
    
    Стоимость предметов интерьера: 30000 + 27500 + 25000 + 22500 + 20000 + 17500 + 15000 + 12500 + 10000 + 7500 + 7500 + 7500 + 5000 + 2500 + 1000 = 211000
        Nope: 211000;
        C: 422000;
        B: 633000;
        A: 844000;

    Если приобрести всё, чистая прибыль:
        Nope: 211000 - 145000 - 25000 = 41000;
        C: 422000 - 290000 - 50000 = 82000;
        B: 633000 - 435000 - 75000 = 123000;
        A: 844000 - 580000 - 100000 = 164000;

    Если приобрести всё и совершить ограбление скрытно:
        Nope: 211000 + 42200 = 253200 (чистыми 253200 - 145000 - 25000 = 83200);
        C: 422000 + 84400 = 506400 (чистыми 506400 - 290000 - 50000 = 166400);
        B: 633000 + 126600 = 759600 (чистыми 759600 - 435000 - 75000 = 249600);
        A: 844000 + 168800 = 1012800 (чистыми 1012800 - 580000 - 100000 = 332800);

*/

