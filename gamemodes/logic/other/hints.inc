SendHints(playerid)
{
    p_temp[playerid][hints_idx]++;
    if(p_temp[playerid][hints_idx] >= MAX_HINTS) p_temp[playerid][hints_idx] = 0;
    SendMes(playerid, COLOR_GREEN, "=============== [ ПОДСКАЗКА ] ================");
    SendMes(playerid, COLOR_WHITE, HintsInfoList[p_temp[playerid][hints_idx]]);
    SendMes(playerid, COLOR_GREEN, "==============================================");
    return 1;
}