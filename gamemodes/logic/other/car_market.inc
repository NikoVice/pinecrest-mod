ShowPlayerCarMarketDialog(playerid, vehicle_model, idx)
{
    new price = GetVehicleData(vehicle_model, E_VD_PRICE);
    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, ""W"Вы действительно хотите выставить транспортное средство "I"\"%s\""W" на авторынок?\n\n\
    {"#cLIGHTRED"}Обратите внимание! Транспортное средство выставляется на авторынок до момента его выгрузки!"W"\n\n\
    Стоимость аренды составляет 0.5%% от гос. стоимости транспортного средства: "I"%d$."W"\n\n\
    Введите стоимость транспортного средства от "I"%d$"W" до "I"%d$:"W"", GetVehicleName(INVALID_VEHICLE_ID, vehicle_model), price / 200, price / 2, price * 3);
    ShowPlayerDialog(playerid, D_CAR_MARKET_BET, DIALOG_STYLE_INPUT, ""I"Выставить транспортное средство на авторынок", STRING_GLOBAL, "Далее", "Отмена");
    SetPVarInt(playerid, "CarMarket:vehicle_model", vehicle_model);
    SetPVarInt(playerid, "CarMarket:mysql_idx", idx);
    return 1;
}

CarMarketVehicleDestroy(playerid, vehicleid)
{
    if(vehicleid == INVALID_VEHICLE_ID) return 1;
    if(!IsPlayerInDynamicArea(playerid, VEHICLE_MARKET_CUBE)) return SendError(playerid, "Вы должны быть на территории авторынка.");
    if(veh_info[vehicleid][v_mysql_id] == 0)
        return SendError(playerid, "Произошла неизвестная ошибка, сообщите на форум в тех. раздел.");

    new idx = -1;
    for(new i = 0; i < MAX_CAR_MARKET; i++)
    {
        if(CarMarketInfo[i][cmVehicleIDx] == vehicleid)
        {
            idx = i;
            break;
        }
    }
    if(idx == -1) return 1;

    CarMarketVehicleClear(idx);

    SendAccess(playerid, "Вы забрали транспортное средство \"%s\" с авторынка.", GetVehicleName(vehicleid));
    SendInfo(playerid, "Используйте /cars чтобы загрузить его на сервер.");

    // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2)[$12345] забрал <Infernus>(411)[1550] с авторынка
    Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] забрал <%s>(%d)[%d] с авторынка",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
        GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id]);

    DestroyPlayerVehicle(playerid, vehicleid);
    return 1;
}

CarMarketVehicleClear(idx)
{
    CarMarketInfo[idx][cmVehicleIDx] = INVALID_VEHICLE_ID;
    CarMarketInfo[idx][cmPrice] = 0;
    UpdateDynamic3DTextLabelText(CarMarketInfo[idx][cmText], COLOR_MAIN, "Авторынок\n"W"Место под аренду свободно");
    SetDynamicObjectMaterialText(CarMarketInfo[idx][cmObject], 0, "Авторынок\nМесто под\nаренду\nсвободно", 130, "Verdana", 50, 1, 0xFF000000, 0x00000000, 1);
    return 1;
}

GetSlotVehicleMarket(vehicle_mysql_id)
{
    if(vehicle_mysql_id == INVALID_MYSQL_ID) return -1;
    for(new i = 0; i < MAX_CAR_MARKET; i++)
    {
        if(CarMarketInfo[i][cmVehicleIDx] != INVALID_VEHICLE_ID &&
            veh_info[CarMarketInfo[i][cmVehicleIDx]][v_mysql_id] == vehicle_mysql_id)
            return i;
    }
    return -1;
}

CMD:use(playerid)
{
    if(!IsPlayerInDynamicArea(playerid, VEHICLE_MARKET_CUBE)) return SendError(playerid, "Вы должны быть на территории авторынка.");
    STRING_GLOBAL = "[#] Парковочное место\tСтатус\n";
    for(new i = 0; i < MAX_CAR_MARKET; i++)
    {
        f(STRING_GLOBAL, "%s"I"[%d]"W" Номер: %d\t%s\n", STRING_GLOBAL, i + 1, i + 1, CarMarketInfo[i][cmVehicleIDx] == INVALID_VEHICLE_ID ? "{"#cGREEN"}Свободно"W"" : "{"#cLIGHTRED"}Используется"W"");
    }
    ShowPlayerDialog(playerid, D_CAR_MARKET, DIALOG_STYLE_TABLIST_HEADERS, ""I"Авторынок", STRING_GLOBAL, "Далее", "Отмена");
    return 1;
}

forward OnPlayerCarMarketVehicleList(playerid, veh_type);
public OnPlayerCarMarketVehicleList(playerid, veh_type)
{
    if(veh_type < 0 || veh_type > 3) return SendError(playerid, "Код ошибки: 1008-2 (Обратитесь к администрации)"), DeletePVar(playerid, "CarMarket:idx");

    new rows = cache_num_rows();

    new status_used[36],
        modelid,
        fmt_str[144],
        twinturbo,
        premium,
        bonus, count_veh, sell_block;
    static const twinturbo_status[][] = {"", "[{ffff00}TT"W"]"};
    static const premium_status[][] = {"", "[{ffff00}PREMIUM"W"]"};
    STRING_GLOBAL[0] = EOS;
    if(rows)
    {
        for(new idx; idx < rows; idx++)
        {
            if(count_veh >= 49) break;

            p_temp[playerid][p_listitem_cars][count_veh] = -1;
            p_temp[playerid][p_listitem][count_veh] = -1;
            cache_get_value_name_int(idx, "v_model", modelid);
            if(GetVehicleData(modelid, E_VD_TYPE) != veh_type) continue;
            cache_get_value_name_int(idx, "v_mysql_id", p_temp[playerid][p_listitem_cars][count_veh]);
            cache_get_value_name_int(idx, "v_model", p_temp[playerid][p_listitem][count_veh]);

            cache_get_value_name_int(idx, "v_twinturbo", twinturbo);
            cache_get_value_name_int(idx, "v_premium", premium);
            cache_get_value_name_int(idx, "v_bonus", bonus);
            cache_get_value_name_int(idx, "v_sell_block", sell_block);

            if(GetSlotVehicleMarket(p_temp[playerid][p_listitem_cars][count_veh]) != -1) format(status_used, sizeof status_used, ""A"[На авторынке]");
            else format(status_used, sizeof status_used, "%s", GetPlayerVehicleMySQLID(playerid, p_temp[playerid][p_listitem_cars][count_veh]) != -1 ? "[{ffcc00}Используется"W"]" : "[{669900}Не используется"W"]");
            f(STRING_GLOBAL, "%s"I"[%d]"W" %s %s %s \t%s%s%s\n", STRING_GLOBAL, count_veh+1, GetVehicleName(INVALID_VEHICLE_ID, modelid), twinturbo_status[twinturbo], premium_status[premium], status_used, bonus == 0 ? "" : "[{ffff00}BONUS"W"]", sell_block == 0 ? "" : "[{"#cLIGHTRED"}Подарочный т/с, продажа за 0$"W"]");
            count_veh++;
        }
    }
    if(count_veh < GetPlayerLimiteCars(playerid, veh_type))
    {
        for(new idx = count_veh; idx < GetPlayerLimiteCars(playerid, veh_type); idx++)
        {
            p_temp[playerid][p_listitem_cars][idx] = -1;
            p_temp[playerid][p_listitem][idx] = -1;
            f(STRING_GLOBAL, "%s"I"[%d]"W" Слот свободный\n", STRING_GLOBAL, idx+1);
        }
    }
    p_temp[playerid][loadcar_max] = count_veh;
    p_temp[playerid][p_listitem_int] = veh_type;
    f(fmt_str, ""I"%s | Слоты: %d/%d", vehicle_type_name[veh_type], count_veh, GetPlayerLimiteCars(playerid, veh_type));
    ShowPlayerDialog(playerid, D_CAR_MARKET_VEHICLE, DIALOG_STYLE_TABLIST, fmt_str, STRING_GLOBAL, "Далее", "Отмена");
    return 1;
}

forward OnPlayerLoadVehicleCarMarket(playerid, id, input_price);
public OnPlayerLoadVehicleCarMarket(playerid, id, input_price)
{
    new rows;
    cache_get_row_count(rows);
    if(!rows) return 1;

    new iCountVehicle = GetFreeSlotVehicle(playerid);
    if(iCountVehicle == ALL_BUSY_SLOT_VEHICLE)
        return SendError(playerid, "Максимально загруженных транспортных средств: %d.", p_info[playerid][p_vip] == 3 && p_info[playerid][p_add_vip] == 1 ? MAX_PLAYER_VEHICLES : 2);

    new temp_v_mysql_id, temp_v_premium, temp_v_insurance,
        temp_v_virt, temp_v_int, temp_v_bonus, temp_v_sell_block, temp_v_number[16],
        model,
        v_color1,
        v_color2,
        data[256];

   
    cache_get_value_name_int(0, "v_mysql_id",temp_v_mysql_id);
    if(GetPlayerVehicleMySQLID(playerid, temp_v_mysql_id) != -1) return 1;
    
    cache_get_value_name_int(0, "v_virt", temp_v_virt);
    cache_get_value_name_int(0, "v_int", temp_v_int);

    cache_get_value_name_int(0, "v_model", model);
    cache_get_value_name_int(0, "v_color_0", v_color1);
    cache_get_value_name_int(0, "v_color_1", v_color2);
    cache_get_value_name_int(0, "v_premium", temp_v_premium);
    cache_get_value_name_int(0, "v_insurance", temp_v_insurance);
    cache_get_value_name_int(0, "v_bonus", temp_v_bonus);
    cache_get_value_name_int(0, "v_sell_block", temp_v_sell_block);
    cache_get_value_name(0, "v_number", temp_v_number, 16);

    if(!IsPlayerInDynamicArea(playerid, VEHICLE_MARKET_CUBE)) return SendError(playerid, "Вы должны быть на территории авторынка.");

    if(temp_v_bonus != 0) return SendError(playerid, "Вы не можете выставить бонусное транспортное средство на авторынок.");
    if(temp_v_sell_block != 0) return SendError(playerid, "Вы не можете выставить подарочное транспортное средство на авторынок.");
    if(GetVehicleData(model, E_VD_TYPE) != VEHICLE_STATE_CAR && GetVehicleData(model, E_VD_TYPE) != VEHICLE_STATE_MOTO && GetVehicleData(model, E_VD_TYPE) != VEHICLE_STATE_VELO_MOPED)
        return SendError(playerid, "Выставить на авторынок можно только: автомобили, мотоциклы, велосипеды и мопеды.");
    /*
    if(temp_v_insurance == 0 && (GetVehicleData(model, E_VD_TYPE) == VEHICLE_STATE_VELO_MOPED || GetVehicleData(model, E_VD_TYPE) == VEHICLE_STATE_MOTO || GetVehicleData(model, E_VD_TYPE) == VEHICLE_STATE_CAR))
        return SendError(playerid, "На транспортном средстве должна быть страховка.");
    if(strequals(temp_v_number, "NULL"))
        return SendError(playerid, "На транспортном средстве должны быть номера.");
    */
    if(CarMarketInfo[id][cmVehicleIDx] != INVALID_VEHICLE_ID) return SendError(playerid, "Данное место уже используется.");

    new
        price = GetVehicleData(model, E_VD_PRICE),
        arend_price = price / 200;

    if(arend_price <= 0 || arend_price > p_info[playerid][cash]) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

    new vehicleid = CreateVehicleVEx(NPO_PLAYERCAR, NPO_NONE, model, CarMarketInfo[id][cmPos][0], CarMarketInfo[id][cmPos][1], CarMarketInfo[id][cmPos][2], CarMarketInfo[id][cmPos][3], v_color1, v_color2, -1);

    SetFreeSlotVehicle(playerid, vehicleid);

    veh_info[vehicleid][v_virt] = temp_v_virt;
    veh_info[vehicleid][v_int] = temp_v_int;
    veh_info[vehicleid][v_mysql_id] = temp_v_mysql_id;
    veh_info[vehicleid][v_premium] = temp_v_premium;
    veh_info[vehicleid][v_insurance] = temp_v_insurance;
    veh_info[vehicleid][v_bonus] = temp_v_bonus;
    veh_info[vehicleid][v_sell_block] = temp_v_sell_block;

    SetPlayerMoney(playerid, -arend_price, true, "выставил т/с на авторынок");

    cache_get_value_name_int(0, "v_owner_id", veh_info[vehicleid][v_owner_id]);
    cache_get_value_name_int(0, "v_lock", veh_info[vehicleid][v_lock]);
    cache_get_value_name_float(0, "v_fuel", veh_info[vehicleid][v_fuel]);
    cache_get_value_name_int(0, "v_twinturbo", veh_info[vehicleid][v_twinturbo]);

    cache_get_value_name(0, "v_twinturbo_data", data); // 0|0|0|0
    sscanf(data, "p<|>a<i>[4]", veh_info[vehicleid][v_twinturbo_data]);

    cache_get_value_name(0, "v_number", veh_info[vehicleid][v_number], 16);

    cache_get_value_name(0, "v_details", data); // 100.0|100.0|100.0|100.0|100.0
    sscanf(data, "p<|>a<f>[5]", veh_info[vehicleid][v_details]);

    cache_get_value_name_int(0, "v_insurance_time", veh_info[vehicleid][v_insurance_time]);
    cache_get_value_name_int(0, "v_wanted", veh_info[vehicleid][v_wanted]);
    cache_get_value_name_int(0, "v_impound", veh_info[vehicleid][v_impound]);

    cache_get_value_name_int(0, "v_tun_0", veh_info[vehicleid][v_tune][v_hydraulics]);
    cache_get_value_name_int(0, "v_tun_1", veh_info[vehicleid][v_tune][v_nitro]);
    cache_get_value_name_int(0, "v_tun_2", veh_info[vehicleid][v_tune][v_wheels]);
    cache_get_value_name_int(0, "v_tun_3", veh_info[vehicleid][v_tune][v_front_bumper]);
    cache_get_value_name_int(0, "v_tun_4", veh_info[vehicleid][v_tune][v_pear_bumper]);
    cache_get_value_name_int(0, "v_tun_5", veh_info[vehicleid][v_tune][v_spoiler]);
    cache_get_value_name_int(0, "v_tun_6", veh_info[vehicleid][v_tune][v_paintjob]);
    cache_get_value_name_int(0, "v_tun_7", veh_info[vehicleid][v_tune][v_lamps]);
    cache_get_value_name_int(0, "v_tun_8", veh_info[vehicleid][v_tune][v_exhausts]);
    cache_get_value_name_int(0, "v_tun_9", veh_info[vehicleid][v_tune][v_roofs]);
    cache_get_value_name_int(0, "v_tun_10", veh_info[vehicleid][v_tune][v_hoods]);
    cache_get_value_name_int(0, "v_tun_11", veh_info[vehicleid][v_tune][v_sideskirt]);
    cache_get_value_name_int(0, "v_tun_12", veh_info[vehicleid][v_tune][v_vents]);

    cache_get_value_name(0, "v_attach_data", data); // -1|-1|-1|-1|-1|-1|-1|-1
    sscanf(data, "p<|>a<i>[8]", veh_info[vehicleid][v_attach_data]);

    cache_get_value_name_int(0, "v_wheel_width", veh_info[vehicleid][v_wheel_width]);
    cache_get_value_name_float(0, "v_wheel_size", veh_info[vehicleid][v_wheel_size]);
    cache_get_value_name_int(0, "v_wheel_offset_x_0", veh_info[vehicleid][v_wheel_offset_x][0]);
    cache_get_value_name_int(0, "v_wheel_offset_x_1", veh_info[vehicleid][v_wheel_offset_x][1]);
    cache_get_value_name_int(0, "v_wheel_alignment_0", veh_info[vehicleid][v_wheel_alignment][0]);
    cache_get_value_name_int(0, "v_wheel_alignment_1", veh_info[vehicleid][v_wheel_alignment][1]);
    cache_get_value_name_int(0, "v_lights_color_0", veh_info[vehicleid][v_lights_color][0]);
    cache_get_value_name_int(0, "v_lights_color_1", veh_info[vehicleid][v_lights_color][1]);
    cache_get_value_name_int(0, "v_lights_color_2", veh_info[vehicleid][v_lights_color][2]);
    cache_get_value_name_int(0, "v_toner", veh_info[vehicleid][v_toner]);
    if(veh_info[vehicleid][v_wheel_width] != 0) SetVehicleWheelWidth(vehicleid, veh_info[vehicleid][v_wheel_width]);
    if(veh_info[vehicleid][v_wheel_size] != 0.0) SetVehicleWheelSize(vehicleid, veh_info[vehicleid][v_wheel_size]);
    if(veh_info[vehicleid][v_wheel_offset_x][0] != 0) SetVehicleWheelOffsetX(vehicleid, 0, veh_info[vehicleid][v_wheel_offset_x][0]);
    if(veh_info[vehicleid][v_wheel_offset_x][1] != 0) SetVehicleWheelOffsetX(vehicleid, 1, veh_info[vehicleid][v_wheel_offset_x][1]);
    if(veh_info[vehicleid][v_wheel_alignment][0] != 0) SetVehicleWheelAngle(vehicleid, 0, veh_info[vehicleid][v_wheel_alignment][0]);
    if(veh_info[vehicleid][v_wheel_alignment][1] != 0) SetVehicleWheelAngle(vehicleid, 1, veh_info[vehicleid][v_wheel_alignment][1]);
    if(veh_info[vehicleid][v_lights_color][0] != 0 || veh_info[vehicleid][v_lights_color][1] != 0 || veh_info[vehicleid][v_lights_color][2] != 0)
        SetVehicleLightsColors(vehicleid, veh_info[vehicleid][v_lights_color][0], veh_info[vehicleid][v_lights_color][1], veh_info[vehicleid][v_lights_color][2]);
    if(veh_info[vehicleid][v_toner] != 0)
        SetVehicleToner(vehicleid, veh_info[vehicleid][v_toner]);

    if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_CAR)
    {
        for (new i; i < v_all-1; i++){
            if(veh_info[vehicleid][v_tune][i] !=0) {
                VEx_AddVehicleComponent (vehicleid, veh_info[vehicleid][v_tune][i]);
                if(i == v_sideskirt || i == v_vents) VEx_AddVehicleComponent (vehicleid, veh_info[vehicleid][v_tune][i]);
            }
        }
        if(veh_info[vehicleid][v_tune][v_paintjob] != 0) ChangeVehiclePaintjob(vehicleid, veh_info[vehicleid][v_tune][v_paintjob]-1);
    }

    LinkVehicleToInterior(vehicleid, 0);
    SetVehicleVirtualWorld(vehicleid, 0);

    LoadVehicleAccessories(playerid, vehicleid);

    veh_info[vehicleid][v_lock] =
    veh_info[vehicleid][v_engine] = 0;
    SetVehicleParamsVEx(vehicleid, veh_info[vehicleid][v_engine], veh_info[vehicleid][v_light], alarm, veh_info[vehicleid][v_lock], bonnet, boot, objective);

    CarMarketInfo[id][cmPrice] = input_price;
    CarMarketInfo[id][cmVehicleIDx] = vehicleid;

    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "%s\n"W"Стоимость: "I"%s "W"| Гос. стоимость: "I"%s\n"W"Номер: "I"%s\n\n"W"Нажмите "I"\"ALT\"", GetVehicleName(vehicleid), ConvertNumber(input_price),
        ConvertNumber(price), veh_info[vehicleid][v_number]);
    UpdateDynamic3DTextLabelText(CarMarketInfo[id][cmText], COLOR_MAIN, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "%s\n%d$\n%s\n%s", GetVehicleName(vehicleid), input_price,
    veh_info[vehicleid][v_number], veh_info[vehicleid][v_premium] != 0 ? "PREMIUM" : "");
    SetDynamicObjectMaterialText(CarMarketInfo[id][cmObject], 0, STRING_GLOBAL, 130, "Verdana", 50, 1, 0xFF000000, 0x00000000, 1);

    SendAccess(playerid, "Вы выставили транспортное средство \"%s\" на авторынок за %d$.", GetVehicleName(vehicleid), input_price);
    SendInfo(playerid, "Вы можете заниматься своими делами, транспортное средство будет продаваться до выхода из игры.");

    // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) выставил <%s>(%d)[%d] на авторынке за %d$
    Log(LOG_player, INFO, "%s[%d](%s %s) выставил <%s>(%d)[%d] на авторынке за %d$",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        GetVehicleName(vehicleid), model, veh_info[vehicleid][v_mysql_id], input_price);
    return 1;
}
