ShowNewyearQuest(playerid)
{
    if(p_info[playerid][level] < 10) return SendError(playerid, "У Вас нет 10-ого уровня.");
    if(p_info[playerid][event_quest_id] == 1) return SendError(playerid, "Вы уже прошли праздничный квест.");
    switch(p_info[playerid][event_quest_stage])
    {
        case 0:
        {
            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Праздничный квест", ""W"\
            Хоу-хоу-хоу! Здравствуй путник. Слышал ли ты что-то о времени, когда все вокруг\n\
            становится волшебным? Конечно! Я говорю про Новый год, время волшебства.\n\
            Знаешь, что в это время исполняются любые желания? Я докажу. Я подарю тебе\n\
            "I"300 Flin Money, 300000$ и уникальный аксессуар \"Новогодняя шапка\","W" но для\n\
            этого тебе необходимо выполнить все задания.\n\n\
            Кто-то вытпается испортить наш любимый праздник. Пока я покупал подарки для\n\
            детей в супермаркете, мою упряжку с оленями и Снегурочкой украли. Помоги найти\n\
            мне пропажу и мы снова сможем порадовать всех детишек! Отправляйся искать\n\
            оленей, местные говорили как видели пару оленей в охотничьем доме. Удачи!\n\n\
            Награда: "I"25000$", "ОК", "");
        }
        case 1:
        {
            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Праздничный квест", ""W"\
            Поздравляю, ты нашёл первого оленя. Заноси местоположение в свою карту, после возвращения\n\
            Деда Мороза отдашь карту ему. Местные видели следы оставшихся оленей, оправляйся на поиски!\n\n\
            Награда: "I"25000$", "ОК", "");
        }
        case 2:
        {
            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Праздничный квест", ""W"\
            Молодец! Ты нашёл всех оленей, не забудь где находится это место. Теперь необходимо найти сани\n\
            Деда Мороза, чтобы этих оленей куда-то прицепить. Кто-то видел как большую железяку тащили в\n\
            заброшенный аэропорт. Торопись пока их не сдали на металлолом!\n\n\
            Награда: "I"50000$", "ОК", "");
        }
        case 3:
        {
            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Праздничный квест", ""W"\
            Фух, вроде ещё целые. Быстро справился! Дед Мороз скоро прибудет, нужно поторопиться с поисками\n\
            волшебного посоха. Что за посох? Ах да, забыл тебе сказать, волшебный посох Деда Мороза позволяет\n\
            превращать людей в сосульки и создавать бесконечные леденцы. Но ты ничего не слышал. Хорошо, что его\n\
            можно отследить по последнему заклинанию в деревне Паломино-Крик. В дорогу, пока его не нашли злые\n\
            люди и не заморозили пол города.\n\n\
            Награда: "I"50000$", "ОК", "");
        }
        case 4:
        {
            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Праздничный квест", ""W"\
            Здравствуй, путник. Говорят ты помогаешь Деду Морозу в поисках пропажи. Мы ничего не знаем, куда\n\
            пропала Снегурочка и упряжка Дедушки. Они пропали когда мы отвечали на письма детишек. Но мы можем\n\
            дать тебе волшебный компас, он покажет тебе путь к вещам снегурочки. Когда она покупала себе новогодний\n\
            костюм, она забыла снять магнит в магазине возле автовокзала города Сан-Фиерро. Поторопись, их может\n\
            замести снег!\n\n\
            Награда: "I"25000$", "ОК", "");
        }
        case 5:
        {
            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Праздничный квест", ""W"\
            Отлично! Ты нашёл шапку Снегурочки. Но вероятно должно быть что-то ещё. Продолжай поиски.\n\n\
            Награда: "I"25000$", "ОК", "");
        }
        case 6:
        {
            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Праздничный квест", ""W"\
            Не может быть, это же ее шарфик. Наверное она чертовски замёрзла без него. Необходимо найти последнюю\n\
            вещь, чтобы выйти на ее след.\n\n\
            Награда: "I"25000$", "ОК", "");
        }
        case 7:
        {
            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Праздничный квест", ""W"\
            Надо же, это пальто Снегурочки. Подождите, вот же ее следы! Срочно необходимо пройти по ним и отыскать\n\
            ее. Есть информация, что её примерное местоположение где-то в океане и скоро её переправят в другой город.\n\
            Осталось совсем немного и Новый Год никто не испортит!\n\n\
            Награда: "I"75000$", "ОК", "");
        }
        case 8:
        {
            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Праздничный квест", ""W"\
            Вот же она! Сама внучка Деда Мороза. Но кто ее сюда притащил и почему здесь лежит шапка гнома? Ладно,\n\
            это уже не важно. Теперь праздник будет полноценным! Осталось отдать Деду Мороду карту с местоположением\n\
            его утерянных предметов и вызвать вертолет Снегурочке. С Новым Годом, хоу-хоу-хоу!\n\n\
            Награда: "I"300 Flin Money и уникальный аксессуар \"Новогодняя шапка\"", "ОК", "");

            p_info[playerid][event_quest_stage] = 9;
            MysqlUpdatePlayerInt(playerid, "event_quest_stage", p_info[playerid][event_quest_stage]);
        }
        case 9:
        {
            if(!GivePlayerInventory(playerid, 509)) return SendError(playerid, "В инвентаре нет места.");

            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Праздничный квест", ""W"\
            Хоу-хоу-хоу! Ты всё-таки нашёл все что нужно, и тем самым спас Новый Год! Это карта с местоположением\n\
            всех вещей? Спасибо! Вот тебе "I"300 Flin Money"W" и уникальный аксессуар "I"\"Новогодняя шапка\"."W" Спасибо, путник.\n\
            С наступающим Новым годом!", "ОК", "");

            p_info[playerid][event_quest_stage] = 9;
            MysqlUpdatePlayerInt(playerid, "event_quest_stage", p_info[playerid][event_quest_stage]);

            p_info[playerid][event_quest_id] = 1;
            MysqlUpdatePlayerInt(playerid, "event_quest_id", p_info[playerid][event_quest_id]);

            p_info[playerid][flinmoney] += 300;
            MysqlUpdatePlayerInt(playerid, "flinmoney", p_info[playerid][flinmoney]);

            SendInfo(playerid, "За выполнение задания Вам выдана награда в размере 300 Flin Money и уникальный аксессуар \"Новогодняя шапка\".");
        }
    }
    return 1;
}


