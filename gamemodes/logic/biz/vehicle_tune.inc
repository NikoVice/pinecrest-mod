IsVehicleAccessories(playerid, vehicleid)
{
    if((GetPlayerState(playerid) == PLAYER_STATE_DRIVER && GetPVarInt(playerid, #VEHICLEID_ACCESSORIES) == vehicleid && 
            veh_info[vehicleid][v_mysql_id] != INVALID_MYSQL_ID) &&
            (IsPlayerOwnerVehicle(playerid, vehicleid) || veh_info[vehicleid][v_family_id] == GetPlayerFamilyID(playerid))) return 1;
    return 0;
}