SetVehicleObejcts(vehicleid, object_id)
{
    if(!IsValidVehicle(vehicleid)) return 1;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL),
        "SELECT * FROM `vehicle_tune_coords` WHERE `model_id` = %d AND `object_id` = %d",
            GetVehicleModelEx(vehicleid), object_id);
    mysql_tquery(con_bd, STRING_GLOBAL, "SetVehicleObjectsCallback", "ii", vehicleid, GetVehicleModelEx(vehicleid));
    return 1;
}

this::SetVehicleObjectsCallback(vehicleid, vehicle_model)
{
    if(!IsValidVehicle(vehicleid)) return 1;
    new rows = cache_num_rows();
    if(!rows) return 1;

    new attach_slot, model_id, object_id, Float:accPos[6];

    for(new i; i < rows; i++)
    {
        attach_slot = GetFreeSlotVehicleAttach(vehicleid);
        if(attach_slot == -1) return 1;

        cache_get_value_name_int(i, "model_id", model_id);
        if(model_id != vehicle_model) return print("[ERROR ATTACH VEHICLE OBJECTS] Model not current");

        cache_get_value_name_int(i, "object_id", object_id);
        cache_get_value_name_float(i, "fOffsetX", accPos[0]);
        cache_get_value_name_float(i, "fOffsetY", accPos[1]);
        cache_get_value_name_float(i, "fOffsetZ", accPos[2]);
        cache_get_value_name_float(i, "fRotX", accPos[3]);
        cache_get_value_name_float(i, "fRotY", accPos[4]);
        cache_get_value_name_float(i, "fRotZ", accPos[5]);

        veh_info[vehicleid][v_attach_object][attach_slot] = CreateDynamicObject(object_id, 
            accPos[0], accPos[1] , accPos[2], accPos[3], accPos[4] , accPos[5]);

        AttachDynamicObjectToVehicle(veh_info[vehicleid][v_attach_object][attach_slot], vehicleid,
            accPos[0], accPos[1] , accPos[2], accPos[3], accPos[4] , accPos[5]);

        if(object_id == 2993 && 
            GetFactionCategory(veh_info[vehicleid][v_npoId]) == FACTION_CATEGORY_GANG &&
            veh_info[vehicleid][v_npoId] == GhettoKingID)
        {
            SetDynamicObjectMaterial(veh_info[vehicleid][v_attach_object][attach_slot], 1, 18979, "MatClothes", "bandanaskull", 0xFFFFFFFF);
        }
    }
    return 1;
}

DeleteVehicleObjects(vehicleid, slot = -1)
{
    if(vehicleid == INVALID_VEHICLE_ID) return 1;
    if(slot == -1)
    {
        for(new i = MAX_VEHICLE_OBJECT_ATTACH-1; i != -1; i--)
        {
            if(veh_info[vehicleid][v_attach_object][i] != INVALID_OBJECT_ID)
            {
                DestroyDynamicObject(veh_info[vehicleid][v_attach_object][i]);
                veh_info[vehicleid][v_attach_object][i] = INVALID_OBJECT_ID;
            }
        }
    }
    else
    {
        if(veh_info[vehicleid][v_attach_object][slot] != INVALID_OBJECT_ID)
            DestroyDynamicObject(veh_info[vehicleid][v_attach_object][slot]);
        veh_info[vehicleid][v_attach_object][slot] = INVALID_OBJECT_ID;
    }
    return 1;
}


