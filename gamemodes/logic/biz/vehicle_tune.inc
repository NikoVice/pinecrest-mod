UseVehicleAccessories(playerid, slot_id, slot_use)
{
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return SendError(playerid, "Нужно быть за рулем.");
    new vehicleid = GetPlayerVehicleID(playerid);
    if(!IsVehicleAccessories(playerid, vehicleid))
        return SendError(playerid, "На этот автомобиль нельзя одеть акссесуар, только личный или семейный.");

    if(InventoryPlayer[playerid][slot_id][inv_status_use] != 0 && slot_use == -1) 
    {
        DeleteVehicleAccessories(playerid, slot_id);
    }
    else
    {
        HideTextDraw_Speedometr(playerid, true);
        HideTextDrawForPlayer(playerid, TD_ID_INVENTORY_PLAYER);

        SetPVarInt(playerid, #VEHICLEID_ACCESSORIES, vehicleid);
        SetTimerEx("ShowPlayerEditor", 1000, false, "ddd", playerid, slot_id, slot_use);
    }
    return 1;
}

GetFreeSlotVehicleAttach(vehicleid)
{
    for(new i = MAX_VEHICLE_OBJECT_ATTACH-1; i != -1; i--)
    {
        if(veh_info[vehicleid][v_attach_object][i] == INVALID_OBJECT_ID)
            return i;
    }

    return -1;
}

this::LoadInfoVehicleAccessories(playerid, mysql_id, vehicleid)
{
    if(p_info[playerid][ID] != mysql_id) return 1;
    new rows;
    cache_get_row_count(rows);
    if(!rows) return 1;
    new data[128], min_slot = MAX_PLAYER_EQUIPMENT;

    for(new i; i < rows; i++)
    {
        if(min_slot+i > MAX_ALL_EQUIPMENT) 
        {
            SendError(playerid, "Не возможно загрузить информацию по слоту: %d/%d", min_slot+i, MAX_ALL_EQUIPMENT);
            break;
        }
        cache_get_value_name_int(i, "slot_id",          InventoryPlayer[playerid][min_slot+i][inv_slot_id]);
        cache_get_value_name_int(i, "mysql_id",         InventoryPlayer[playerid][min_slot+i][inv_mysql_id]);
        cache_get_value_name_int(i, "item_id",          InventoryPlayer[playerid][min_slot+i][inv_item_id]);
        cache_get_value_name_int(i, "amount",           InventoryPlayer[playerid][min_slot+i][inv_amount]);
 
        if(ItemsInfo[InventoryPlayer[playerid][min_slot+i][inv_item_id]][iType] == TYPE_ITEMS_VEHICLE_TUNE)
        {
            cache_get_value_name_int(i, "status_use",       InventoryPlayer[playerid][min_slot+i][inv_status_use]);
            cache_get_value_name_int(i, "acc_slot",         InventoryPlayer[playerid][min_slot+i][inv_acc_slot]);
 
            cache_get_value_name(i, "acc_pos", data);
            sscanf(data, "p<|>a<f>[9]",              InventoryPlayer[playerid][min_slot+i][inv_acc_pos]);
        }
        cache_get_value_name_int(i, "freeze_time",          InventoryPlayer[playerid][min_slot+i][inv_freeze_time]);
    }
    for(new i = min_slot+rows; i < MAX_ALL_EQUIPMENT; i++)
    {
        Equipment_ClearSlot(playerid, i);
    }
    Equipment_AccessoriesUse(playerid);
    return 1;
}

LoadVehicleAccessories(playerid, vehicleid)
{
    new bool:isMessage = false,
        vehicle_model = GetVehicleModelEx(vehicleid);
    if(veh_info[vehicleid][v_mysql_id] != INVALID_MYSQL_ID && 400 <= vehicle_model <= 611)
    {
        new ModelObjectID[2], item_id, family_idx, iOwnerID;
        for(new i = 7; i != -1; i--)
        {
            if(veh_info[vehicleid][v_attach_data][i] != -1)
            {
                item_id = -1;
                for(new j; j < 2; j++) 
                    ModelObjectID[j] = TuneObjData[vehicle_model-400][i][veh_info[vehicleid][v_attach_data][i]][uModelId][j];
            
                for(new i = 765; i < MAX_ITEMS; i++)
                {
                    if(ItemsInfo[i][iModel] == ModelObjectID[0])
                    {
                        item_id = i;
                        break;
                    }
                }
                if(item_id == -1)
                {
                    printf("Error one - transfer vehicle accessories: %s - %s", get_name(playerid), GetVehicleName(vehicleid));
                    continue;
                }
                family_idx = veh_info[vehicleid][v_family_id];
                if(family_idx != -1)
                    iOwnerID = FamilyData[family_idx][fOwnerID];
                else if(veh_info[vehicleid][v_owner_id] != INVALID_MYSQL_ID)
                    iOwnerID = veh_info[vehicleid][v_owner_id];
                else
                {
                    printf("Error two - transfer vehicle accessories: %s - %s", get_name(playerid), GetVehicleName(vehicleid));
                    continue;
                }

                for(new j; j < 2; j++)
                {
                    if(ModelObjectID[j] != 0)
                        SetPlayerItem(INVALID_PLAYER_ID, 12, iOwnerID, TYPE_GIVE_ITEM_INVENTORY, 1, item_id);
                }
                veh_info[vehicleid][v_attach_data][i] = -1;
                isMessage = true;
            }
        }
        if(isMessage)
        {
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `vehicle` SET `v_attach_data` = '%d|%d|%d|%d|%d|%d|%d|%d' WHERE `v_mysql_id` = %d",
            veh_info[vehicleid][v_attach_data][0], veh_info[vehicleid][v_attach_data][1], veh_info[vehicleid][v_attach_data][2], veh_info[vehicleid][v_attach_data][3], veh_info[vehicleid][v_attach_data][4], veh_info[vehicleid][v_attach_data][5], veh_info[vehicleid][v_attach_data][6],
            veh_info[vehicleid][v_attach_data][7], veh_info[vehicleid][v_mysql_id]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, "Обновление аксессуаров Т/С", 
                ""W"В связи с "I"обновлением "W"старый тюнинг (аксессуары) автомобилей был полностью переработан.\n\
                Все детали тюнинга перенесены в "I"/items "W"(если автомобиль семейный - владельцу семьи), дальше вам нужно забрать их в инвентарь.\n\
                После этого вы сможете 'одеть' их на Т/С через "I"/inv (в Т/С).", "Понял", "");
        }
    }
    if(!isMessage)
    {
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL),
        "SELECT * FROM `inventory` WHERE `owner_id` = %d AND `owner_type` = %d AND `status_use` > 0 LIMIT 15",
            veh_info[vehicleid][v_mysql_id], INVENTORY_OWNER_TYPE_VEHICLE);
        mysql_tquery(con_bd, STRING_GLOBAL, "LoadVehicleAccessoriesCallback", "iii", playerid, vehicleid, veh_info[vehicleid][v_mysql_id]);
    }
}

this::LoadVehicleAccessoriesCallback(playerid, vehicleid, mysql_vehicle_id)
{
    if(veh_info[vehicleid][v_mysql_id] != mysql_vehicle_id)
        return 1;
    
    new rows;
    cache_get_row_count(rows);
    if(!rows) return 1;
    
    new item_id, data[256], Float:accPos[9], accSlot, statusUse;
    for(new i; i < rows; i++)
    {
        cache_get_value_name_int(i, "item_id",          item_id);
        if(ItemsInfo[item_id][iType] != TYPE_ITEMS_VEHICLE_TUNE)
        {
            printf("[ERROR CRASH] logic failed in LoadVehicleAccessoriesCallback: %d", item_id);
            continue;
        }
        cache_get_value_name_int(i, "status_use",       statusUse);
        cache_get_value_name_int(i, "acc_slot",         accSlot);
        cache_get_value_name(i, "acc_pos", data);
        sscanf(data, "p<|>a<f>[9]",                     accPos);

        if(veh_info[vehicleid][v_attach_object][accSlot] != INVALID_OBJECT_ID) 
            DestroyDynamicObject(veh_info[vehicleid][v_attach_object][accSlot]);

        veh_info[vehicleid][v_attach_object][accSlot] = CreateDynamicObject(ItemsInfo[item_id][iModel], 
            veh_info[vehicleid][v_pos][0], veh_info[vehicleid][v_pos][1], veh_info[vehicleid][v_pos][2]+2.0, accPos[3], accPos[4], accPos[5]);

        AttachDynamicObjectToVehicle(veh_info[vehicleid][v_attach_object][accSlot], vehicleid, accPos[0], accPos[1], accPos[2], accPos[3], accPos[4], accPos[5]);
    }
    if(playerid != INVALID_PLAYER_ID) Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
    return 1;
}

DeleteVehicleAccessories(playerid, slot_id, free_slot = -1)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid != GetPVarInt(playerid, #VEHICLEID_ACCESSORIES)) return 1;

    if(free_slot == -1)
        free_slot = GetFreeSlotInventory(playerid, EQUIPMENT_INVENTORY_PLAYER);
    if(free_slot == -1)
    {
        SendError(playerid, "Снять аксессуар невозможно. Причина: у Вас нет места в инвентаре.");
        return 0;
    }

    new family_idx = GetPlayerFamilyID(playerid);
    if(veh_info[vehicleid][v_family_id] != -1 && family_idx != -1 && GetFamilyRang(playerid) < FamilyData[family_idx][fSettingRang][F_VEHICLE])
        return SendError(playerid, "У Вас слишком маленький ранг в семье.");

    new accSlot = InventoryPlayer[playerid][slot_id][inv_acc_slot];
    InventoryPlayer[playerid][free_slot][inv_mysql_id]      = InventoryPlayer[playerid][slot_id][inv_mysql_id];
    InventoryPlayer[playerid][free_slot][inv_slot_id]       = free_slot;
    InventoryPlayer[playerid][free_slot][inv_item_id]       = InventoryPlayer[playerid][slot_id][inv_item_id];
    InventoryPlayer[playerid][free_slot][inv_amount]        = 1;
    InventoryPlayer[playerid][free_slot][inv_acc_slot]      = -1;
    InventoryPlayer[playerid][free_slot][inv_status_use]    =
    InventoryPlayer[playerid][free_slot][inv_acc_mt][0]     =
    InventoryPlayer[playerid][free_slot][inv_acc_mt][1]     = 0;
    InventoryPlayer[playerid][free_slot][inv_acc_wear]      =
    InventoryPlayer[playerid][free_slot][inv_skin_wear]     = 100.0;
    InventoryPlayer[playerid][free_slot][inv_acc_premium]   =
    InventoryPlayer[playerid][free_slot][inv_skin_premium]  =
    InventoryPlayer[playerid][free_slot][inv_freeze_time]   = 0;
    for(new i = 8; i != -1; i--) InventoryPlayer[playerid][free_slot][inv_acc_pos][i] = InventoryPlayer[playerid][slot_id][inv_acc_pos][i];

    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL),
        "UPDATE `inventory` SET `owner_id` = %d, `owner_type` = %d, `slot_id` = %d, `acc_slot` = %d, `status_use` = %d, `acc_pos` = '%f|%f|%f|%f|%f|%f|%f|%f|%f' WHERE `mysql_id` = %d",
            p_info[playerid][ID], INVENTORY_OWNER_TYPE_PLAYER, InventoryPlayer[playerid][free_slot][inv_slot_id],
            InventoryPlayer[playerid][free_slot][inv_acc_slot], InventoryPlayer[playerid][free_slot][inv_status_use],
            InventoryPlayer[playerid][free_slot][inv_acc_pos][0], InventoryPlayer[playerid][free_slot][inv_acc_pos][1], InventoryPlayer[playerid][free_slot][inv_acc_pos][2],
            InventoryPlayer[playerid][free_slot][inv_acc_pos][3], InventoryPlayer[playerid][free_slot][inv_acc_pos][4], InventoryPlayer[playerid][free_slot][inv_acc_pos][5],
            InventoryPlayer[playerid][free_slot][inv_acc_pos][6], InventoryPlayer[playerid][free_slot][inv_acc_pos][7], InventoryPlayer[playerid][free_slot][inv_acc_pos][8],
            InventoryPlayer[playerid][slot_id][inv_mysql_id]);
    mysql_tquery(con_bd, STRING_GLOBAL);

    Equipment_ClearSlot(playerid, slot_id);

    if(veh_info[vehicleid][v_attach_object][accSlot] != INVALID_OBJECT_ID)
    {
        DestroyDynamicObject(veh_info[vehicleid][v_attach_object][accSlot]);
        veh_info[vehicleid][v_attach_object][accSlot] = INVALID_OBJECT_ID;
        Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
    }

    Equipment_AccessoriesUse(playerid);
    return 1;
}
