GetPriceTuneElement(tune_id, select_id = 0)
{
    switch(tune_id)
    {
        case v_paintjob: return 100000;
        case v_nitro:
        {
            if(select_id == 0) return 200000;
            else if(select_id == 1) return 100000;
            else return 300000;
        }
        case v_wheels: return 200000;
        case v_hydraulics: return 200000;
        case v_front_bumper: return 100000;
        case v_pear_bumper: return 100000;
        case v_spoiler: return 200000;
        case v_lamps: return 100000;
        case v_exhausts: return 100000;
        case v_roofs: return 100000;
        case v_hoods: return 100000;
        case v_sideskirt: return 100000;
        case v_vents: return 100000;
        default: return 99900000;
    }
    return 999_999_000;
}

GetMaxCountComponentTune(playerid, type, getmodel)
{
    new components[ZVEH_MAX_COMPONENTS],
        components_size;

    new isok = GetVehicleCompatibleUpgrades(getmodel, components, components_size);
    if (!isok) return -1;
    new item_index;
    for (new i; i < components_size; i++) {
        if (type == GetVehicleComponentType(components[i]))
        {
            if(type == CARMODTYPE_VENT_LEFT) continue;
            p_temp[playerid][e_tListComponents][item_index] = components[i];
            item_index++;
        }
    }
    if(!item_index) item_index = -1;
    return item_index;
}

