GetTuningOtherPrice(playerid, vehicleid, idx)
{
    new price = 100000, model = GetVehicleModelEx(vehicleid);
    switch(idx)
    {
        /*
        "I"[1]"W" Подвеска (%d/3)\n\
        "I"[2]"W" Трансмиссия (%d/3)\n\
        "I"[3]"W" Турбонаддув (%d/3)\n\
        "I"[4]"W" Двигатель (%d/3)\n\
        "I"[5]"W" Замена стартера (%.1f)\n\
        "I"[6]"W" Замена аккумулятора (%.1f)\n\
        "I"[7]"W" Замена топливной системы (%.1f)\n\
        "I"[8]"W" Замена сцепления (%.1f)\n\
        "I"[9]"W" Замена двигателя (%.1f)",
        */
        case 0: price = floatround((GetVehicleData(model, E_VD_PRICE) * 0.01) * (veh_info[vehicleid][v_twinturbo_data][idx] + 1), floatround_ceil); // 5 процента от стоимости;
        case 1: price = floatround((GetVehicleData(model, E_VD_PRICE) * 0.0125) * (veh_info[vehicleid][v_twinturbo_data][idx] + 1), floatround_ceil); // 10 процентов от стоимости;
        case 2: price = floatround((GetVehicleData(model, E_VD_PRICE) * 0.0175) * (veh_info[vehicleid][v_twinturbo_data][idx] + 1), floatround_ceil); // 15 процентов от стоимости;
        case 3: price = floatround((GetVehicleData(model, E_VD_PRICE) * 0.025) * (veh_info[vehicleid][v_twinturbo_data][idx] + 1), floatround_ceil); // 20 процентов от стоимости;
        case 4: price = floatround(GetVehicleData(model, E_VD_PRICE) * 0.0175, floatround_ceil); // 1.75 процента от стоимости;
        case 5: price = floatround(GetVehicleData(model, E_VD_PRICE) * 0.035, floatround_ceil); // 3.5 процента от стоимости;
        case 6: price = floatround(GetVehicleData(model, E_VD_PRICE) * 0.05, floatround_ceil); // 5 процента от стоимости;
        case 7: price = floatround(GetVehicleData(model, E_VD_PRICE) * 0.075, floatround_ceil); // 7.5 процентов от стоимости;
        case 8: price = floatround(GetVehicleData(model, E_VD_PRICE) * 0.1, floatround_ceil); // 10 процентов от стоимости;
        default: return SendError(playerid, "Ошибка, обратитесь к администрации.");
    }
    return price;
}

