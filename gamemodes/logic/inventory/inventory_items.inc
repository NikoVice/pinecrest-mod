CMD:givetestitems(playerid)
{
    if(SRV_ID) return 1;
    for(new i = 765; i < 830; i++)
    {
        if(!GivePlayerInventory(playerid, i, 1))
            break;
    }
    return 1;
}

CMD:show_items_info(playerid, params[])
{
    if(sscanf(params, "i", params[0])) return 1;
    if(params[0] < 0 || params[0] > sizeof(ItemsInfo)-1) return SendError(playerid, "ID не может быть меньше 0 и больше %d.", sizeof(ItemsInfo)-1);
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
        ID модели: {"#cBLUE"}%d"W"\n\n\
        Использовать: %s\n\
        Продавать: %s\n\
        Передавать / обменивать: %s\n\
        Выбрасывать: %s\n\n\
        Цена: {"#cGREEN"}%d$"W"\n\
        Макс. количество в 1 ячейке: {"#cYELLOW"}%d"W"\n\n\
        Название: "I"%s"W"\n\n\
        Описание:\n\n\
        %s",
        ItemsInfo[params[0]][iModel],
        ItemsInfo[params[0]][iUsed] == false ? "{"#cLIGHTRED"}Нет"W"" : "{"#cGREEN"}Да"W"",
        ItemsInfo[params[0]][iSale] == false ? "{"#cLIGHTRED"}Нет"W"" : "{"#cGREEN"}Да"W"",
        ItemsInfo[params[0]][iChange] == false ? "{"#cLIGHTRED"}Нет"W"" : "{"#cGREEN"}Да"W"",
        ItemsInfo[params[0]][iAway] == false ? "{"#cLIGHTRED"}Нет"W"" : "{"#cGREEN"}Да"W"",
        ItemsInfo[params[0]][iPrice],
        ItemsInfo[params[0]][iMax],
        ItemsInfo[params[0]][iName],
        ItemsInfo[params[0]][iInfo]);
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Items info", STRING_GLOBAL, "ОК", "");
    return 1;
}

