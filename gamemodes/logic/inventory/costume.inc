ShowPlayerCostume(playerid)
{
    STRING_GLOBAL = ""W"Название\t"W"Наличие\t"W"Статус\n";
    for(new i; i < MAX_COSTUME; i++)
    {
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" %s\t%s\t%s\n", STRING_GLOBAL, i+1, CostumeName[i], (!p_info[playerid][costume][i]) ? ("{"#cLIGHTRED"}Нет"W"") : ("{"#cGREEN"}Есть"W""), (!p_info[playerid][costume_use][i]) ? ("{"#cLIGHTRED"}Не используется"W"") : ("{"#cGREEN"}Используется"W""));
    }
    ShowPlayerDialog(playerid, D_COSTUME, DIALOG_STYLE_TABLIST_HEADERS, ""I"Костюмы", STRING_GLOBAL, "Далее", "Отмена");
    return 1;
}

GivePlayerCostume(playerid, idx)
{
    p_info[playerid][costume][idx] = 1;
    p_info[playerid][costume_use][idx] = 0;
    SavePlayerCostume(playerid);
    return 1;
}

SetPlayerAttachedCostume(playerid, idx, bool:isMessage, forplayerid = INVALID_PLAYER_ID)
{
    RemovePlayerAccessories(playerid, true);
    new iOldCustomeID = GetPlayerAttachedCostume(playerid);
    for(new i = MAX_COSTUME_SLOT-1; i != -1; i--)
    {
        if(IsPlayerAttachedObjectSlotUsed(playerid, i)) RemovePlayerAttachedObject(playerid, i);
        if(CostumeInfo[idx][i][cModelID] == -1) continue;
        SetPlayerAttachedObject(playerid, CostumeInfo[idx][i][cIndex], CostumeInfo[idx][i][cModelID], CostumeInfo[idx][i][cBone], CostumeInfo[idx][i][cPos][0], CostumeInfo[idx][i][cPos][1], CostumeInfo[idx][i][cPos][2], CostumeInfo[idx][i][cPos][3], CostumeInfo[idx][i][cPos][4], CostumeInfo[idx][i][cPos][5], CostumeInfo[idx][i][cPos][6], CostumeInfo[idx][i][cPos][7], CostumeInfo[idx][i][cPos][8], CostumeInfo[idx][i][cMaterialColor][0], CostumeInfo[idx][i][cMaterialColor][1]);
        if(forplayerid != INVALID_PLAYER_ID && !p_info[forplayerid][p_settings][ACC_VISIBLE])
            RemoveAttachedObjectForPlayer(playerid, forplayerid, i);
        else
        {
            foreach(new targetid: PlayerPlayersStream[playerid])
            {
                if(!p_info[targetid][p_settings][ACC_VISIBLE])
                    RemoveAttachedObjectForPlayer(playerid, targetid, i);
            }
        }
    }
    if(isMessage == true)
    {
        SendAccess(playerid, "Вы надели костюм \"%s\".", CostumeName[idx]);
        ShowPlayerCostume(playerid);
    }
    if(iOldCustomeID != -1 && iOldCustomeID != idx) p_info[playerid][costume_use][iOldCustomeID] = 0;
    p_info[playerid][costume_use][idx] = 1;
    SavePlayerCostume(playerid);
    return 1;
}

GetPlayerAttachedCostume(playerid)
{
    for(new i = MAX_COSTUME-1; i != -1; i--)
    {
        if(p_info[playerid][costume][i] != 0 && p_info[playerid][costume_use][i] != 0) return i;
    }
    return -1;
}

TakePlayerAttachedCostume(playerid, idx, bool:save_status)
{
    if(idx == -1) return 1;
    for(new i = MAX_COSTUME_SLOT-1; i != -1; i--)
    {
        if(IsPlayerAttachedObjectSlotUsed(playerid, i)) RemovePlayerAttachedObject(playerid, i);
    }
    if(save_status == true && p_info[playerid][costume_use][idx] != 0)
    {
        p_info[playerid][costume_use][idx] = 0;
        SendAccess(playerid, "С Вас снят костюм \"%s\".", CostumeName[idx]);
        SavePlayerCostume(playerid);
    }
    return 1;
}

SavePlayerCostume(playerid)
{
    STRING_GLOBAL[0] = EOS;
