        idx = random(212);
        if((GetVehicleData(idx, E_VD_CLASS) >= VEHICLE_CLASS_NOPE && GetVehicleData(idx, E_VD_CLASS) <= VEHICLE_CLASS_A) && GetVehicleData(idx, E_VD_TYPE) == VEHICLE_STATE_CAR && GetVehicleData(idx, E_VD_ID) != 508) return GetVehicleData(idx, E_VD_ID);
