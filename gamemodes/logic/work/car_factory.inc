UpdateCarFactory(idx)
{
    CarFactory[idx][cfCraneStatus]++;
    switch(CarFactory[idx][cfCraneStatus])
    {
        case 1, 4, 7, 10, 13: CarFactory[idx][cfTimer] = SetTimerEx("UpdatePosCarFactory", 1000, true, "ii", idx, 0);
        case 3, 6, 9, 12, 15: CarFactory[idx][cfTimer] = SetTimerEx("UpdatePosCarFactory", 1000, true, "ii", idx, 1);
        default: CarFactory[idx][cfTimer] = SetTimerEx("UpdatePosCarFactory", 1000, true, "ii", idx, 2);
    }
	new coord = CarFactoryCraneIDx[idx][CarFactory[idx][cfCraneStatus]];
	for(new i = 0; i < 26; i++) MoveDynamicObject(CarFactory[idx][cfCraneObjects][i], CarFactoryObjectPos[coord][i][0], CarFactoryObjectPos[coord][i][1], CarFactoryObjectPos[coord][i][2], 1.0, CarFactoryObjectPos[coord][i][3], CarFactoryObjectPos[coord][i][4], CarFactoryObjectPos[coord][i][5]);
    return 1;
}

forward UpdatePosCarFactory(idx, type);
public UpdatePosCarFactory(idx, type)
{
    switch(type)
    {
        case 0:
        { // Поднятие вверх;
            CarFactory[idx][cfVehicleStatus]++;
            if(CarFactory[idx][cfVehicleStatus] == 3)
            {
                KillTimer(CarFactory[idx][cfTimer]);
                CarFactory[idx][cfVehicleStatus] = 0;
                UpdateCarFactory(idx);
            }
        }
        case 1:
        { // Спуск вниз;
            new type;
            switch(CarFactoryCraneIDx[idx][CarFactory[idx][cfCraneStatus]])
            {
                case 9, 10, 11: type = 1;
                case 15, 16, 17: type = 2;
                case 21, 22, 23: type = 3;
                case 27, 28, 29: type = 4;
                case 33, 34, 35: type = 5;
            }
            CarFactory[idx][cfVehicleStatus]++;
            if(CarFactory[idx][cfVehicleStatus] == 4)
            {
                KillTimer(CarFactory[idx][cfTimer]);
                CarFactory[idx][cfVehicleStatus] = 0;
                CarFactory[idx][cfType] = type;
                if(CarFactory[idx][cfPlayerID][type - 1] != INVALID_PLAYER_ID)
                {
                    UpdatePlayerCarFactory(CarFactory[idx][cfPlayerID][type - 1]);
                }
            }
        }
        case 2:
        { // Движение;
            new max_value;
            switch(CarFactoryCraneIDx[idx][CarFactory[idx][cfCraneStatus]])
            {
                case 6, 7, 8: max_value = 48;
                case 12, 13, 14: max_value = 24;
                case 18, 19, 20: max_value = 24;
                case 24, 25, 26: max_value = 24;
                case 30, 31, 32: max_value = 30;
                case 36, 37, 38: max_value = 5;
            }
            CarFactory[idx][cfVehicleStatus]++;
            if(CarFactory[idx][cfVehicleStatus] == max_value)
            {
                KillTimer(CarFactory[idx][cfTimer]);
                if(CarFactoryCraneIDx[idx][CarFactory[idx][cfCraneStatus]] >= 36)
                {
                    CarFactory[idx][cfVehicleStatus] = 0;
                    CreateCarFactory(idx, 1);
                }
                else
                {
                    CarFactory[idx][cfVehicleStatus] = 0;
                    UpdateCarFactory(idx);
                }
            }
        }
    }
    return 1;
}

UpdateCarFactoryStatusPos(idx, i)
{
    if(IsValidDynamic3DTextLabel(CarFactory[idx][cfText][i]))
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s\n\nСтатус: %s", CarFactoryTypeName[i], CarFactory[idx][cfPlayerID][i] == INVALID_PLAYER_ID ? "{"#cGREEN"}Свободно"W"" : "{"#cLIGHTRED"}Занято"W"");
        UpdateDynamic3DTextLabelText(CarFactory[idx][cfText][i], COLOR_MAIN, STRING_GLOBAL);
    }
    return 1;
}

ShowPlayerCarFactory(playerid)
{
    LoadPlayerCarFactoryTextDraw(playerid);

    new i = CarFactoryIDx[playerid];
    PlayerTextDrawSetPreviewModel(playerid, CarFactoryInfo[playerid][1], CarFactory[i][cfVehicleID]);

    for(new i = 0; i < 16; i++)
    {
        TextDrawShowForPlayer(playerid, CarFactoryOther[i]);
        if(i < 2) PlayerTextDrawShow(playerid, CarFactoryInfo[playerid][i]);
    }

    p_temp[playerid][TextDrawCarFactory] = true;

    UpdatePlayerCarFactory(playerid);
    return 1;
}

HidePlayerCarFactory(playerid)
{
    if(p_temp[playerid][TextDrawCarFactory] == false) return 1;

    for(new i = 0; i < 16; i++)
    {
        TextDrawHideForPlayer(playerid, CarFactoryOther[i]);
        if(i < 2)
        {
            if(CarFactoryInfo[playerid][i] != PlayerText:INVALID_TEXT_DRAW)
            {
                PlayerTextDrawDestroy(playerid, CarFactoryInfo[playerid][i]);
                CarFactoryInfo[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
            }
        }
    }

    p_temp[playerid][TextDrawCarFactory] = false;
    return 1;
}

UpdatePlayerCarFactory(playerid, type = 0)
{
    if(p_temp[playerid][TextDrawCarFactory] == false) return 1;

    new i = CarFactoryIDx[playerid], idx = CarFactoryType[playerid];

    STRING_GLOBAL[0] = EOS;
    if(CarFactory[i][cfType] != 0 && CarFactory[i][cfType] - 1 == idx)
    {
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "~w~Vehicle: ~b~%s~n~~w~Progress: ~r~%d/100~n~~w~Press: ~y~%s~n~~w~Salary: ~g~%d$", GetVehicleName(INVALID_VEHICLE_ID, CarFactory[i][cfVehicleID]), CarFactory[i][cfProgress], CarFactory[i][cfPress] == 0 ? "Y" : "N", CarFactorySalary[playerid]);
    }
    else
    {
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "~w~Vehicle: ~b~%s~n~~r~Waiting for a car~n~~w~Salary: ~g~%d$", GetVehicleName(INVALID_VEHICLE_ID, CarFactory[i][cfVehicleID]), CarFactorySalary[playerid]);
    }

    PlayerTextDrawSetString(playerid, CarFactoryInfo[playerid][0], STRING_GLOBAL);
    if(type == 1)
    {
        PlayerTextDrawSetPreviewModel(playerid, CarFactoryInfo[playerid][1], CarFactory[i][cfVehicleID]);
        PlayerTextDrawShow(playerid, CarFactoryInfo[playerid][1]);
    }
    return 1;
}

