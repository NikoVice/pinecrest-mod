new TruckerLoadAreas[3];

new TruckerLoadName[3][24] = {"Древесина", "Уголь", "Топливо"};
new TruckerUnloadName[3][24] = {"Лесопилка", "Шахта", "Нефтезавод"};
new TruckerTrailerIDx[3] = {591, 450, 584};
new TruckerTimer[3] = {200, 180, 120};
new TruckerOrder[3] = {0, 0, 0};
new TruckerObject[6] = {INVALID_OBJECT_ID, ...};

/*

    Древесина - в пути 3.2 мин, 9 поездок в час;
    Уголь - в пути 3 мин, 10 поездок в час;
    Топливо - в пути 2 мин, 15 поездок в час;

*/

LoadTrucker()
{
    for(new i = 0; i < sizeof(TruckerLoadPos); i++)
    {
        TruckerLoadAreas[i] = CreateDynamicSphere(TruckerLoadPos[i][0], TruckerLoadPos[i][1], TruckerLoadPos[i][2], 7.5, -1, -1, -1);
        UpdateAreaInfo(TruckerLoadAreas[i], TYPE_WORK_TRUCKER_LOAD, AREA_SUBTYPE_INVALID_ID, i);

        STRING_MIN[0] = EOS;
        format(STRING_MIN, sizeof(STRING_MIN), "%s\nЗагрузка для дальнобойщиков", TruckerLoadName[i]);
        CreateDynamic3DTextLabel(STRING_MIN, COLOR_MAIN, TruckerLoadPos[i][0], TruckerLoadPos[i][1], TruckerLoadPos[i][2], 20.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, streamer_TESTLOL, -1, -1, -1);

        CreateDynamicPickup(1239, 23, TruckerLoadPos[i][0], TruckerLoadPos[i][1], TruckerLoadPos[i][2]);
    }
    return 1;
}

CreatePlayerTrucker(playerid, idx)
{
    if(!IsPlayerInAnyVehicle(playerid)) return 1;
    new vehicleid = GetPlayerVehicleID(playerid);
    if(!IsPlayerRentedVehicle(playerid, vehicleid)) return SendError(playerid, "Данное транспортное средство не является Вашим арендованным транспортным средством.");
    if(veh_info[vehicleid][v_npoType] != NPO_JOB && veh_info[vehicleid][v_npoId] != JOB_TC_TRUCK && veh_info[vehicleid][v_temp_job] != JOB_TC_TRUCK) return SendError(playerid, "Данное транспортное средство не является транспортным средством принадлежащем транспортной компании.");
    if(GetVehicleModelEx(vehicleid) != 403 && GetVehicleModelEx(vehicleid) != 514 && GetVehicleModelEx(vehicleid) != 515) return SendError(playerid, "На данном транспортном средства нет возможности загрузить груз.");
    if(AntiCheatWarningTime[playerid][1] > timestamp) return SendError(playerid, "Вы не можете доставлять заказы так часто, подождите."); 
    if(TruckerOrder[idx] <= 0) return SendError(playerid, "В данный момент нет заказов, они появляются каждый час.");

    if(p_temp[playerid][TruckerLoad] == 0 || p_temp[playerid][TruckerLoad] == idx - 1)
    {
        SetVehiclePos(vehicleid, 900.0000, -1220.8302, 17.9664);
        SetVehicleZAngle(vehicleid, -90.0000);
        if(p_temp[playerid][TruckerTrailer] != INVALID_VEHICLE_ID) DestroyVehicleVEx(p_temp[playerid][TruckerTrailer]);
        new vehicle_model = TruckerTrailerIDx[idx];
        p_temp[playerid][TruckerTrailer] = CreateVehicleVEx(NPO_NONE, NPO_NONE, vehicle_model, vehicle_model == 584 ? 889.9200 : 890.9200, -1220.8302, 17.9664, -90.0000, random(128), random(128), 86400);
        AttachTrailerToVehicle(p_temp[playerid][TruckerTrailer], vehicleid);
    }
    else
    {
        if(GetVehicleTrailer(vehicleid) != p_temp[playerid][TruckerTrailer])
        {
            new t_idx = p_temp[playerid][TruckerLoad] - 1, Float:distance = GetPlayerDistanceFromPoint(playerid, TruckerLoadPos[t_idx][0], TruckerLoadPos[t_idx][1], TruckerLoadPos[t_idx][2]);
            SendError(playerid, "Вы не можете взять прицеп в данном месте.");
            SendMes(playerid, COLOR_WHITE, "Местоположение {"#cBLUE"}отмечено на GPS навигаторе. Расстояние: "W"%.0f{"#cBLUE"} метров.", distance);
            CancelPlayerGPS(playerid);
            SetPlayerGPS(playerid, TruckerLoadPos[t_idx][0], TruckerLoadPos[t_idx][1], TruckerLoadPos[t_idx][2], 5.0);
        } else SendError(playerid, "У Вас уже есть прицеп, отправляйтесь по маршруту.");
        return 1;
    }

    TruckerOrder[idx]--;
    new str[12];
    f(str, "%d", TruckerOrder[idx]);
    
    switch(idx)
    {
        case 0:
        {
            SetDynamicObjectMaterialText(TruckerObject[0], 0, str, 130, "Arial Black", 55, 0, 0xFF000000, 0x00000000, 1);
            SetDynamicObjectMaterialText(TruckerObject[1], 0, str, 130, "Arial Black", 55, 0, 0xFFFFFFFF, 0x00000000, 1);
        }
        case 1:
        {
            SetDynamicObjectMaterialText(TruckerObject[2], 0, str, 130, "Arial Black", 55, 0, 0xFF000000, 0x00000000, 1);
            SetDynamicObjectMaterialText(TruckerObject[3], 0, str, 130, "Arial Black", 55, 0, 0xFFFFFFFF, 0x00000000, 1);
        }
        case 2:
        {
            SetDynamicObjectMaterialText(TruckerObject[4], 0, str, 130, "Arial Black", 55, 0, 0xFF000000, 0x00000000, 1);
            SetDynamicObjectMaterialText(TruckerObject[5], 0, str, 130, "Arial Black", 55, 0, 0xFFFFFFFF, 0x00000000, 1);
        }
    }

    CancelPlayerGPS(playerid);
    DisablePlayerCheckpoint(playerid);
    DisablePlayerRaceCheckpoint(playerid);

    p_temp[playerid][TruckerLoad] = idx + 1;
    p_temp[playerid][TruckerSalary] = 0;

    p_temp[playerid][pPressed] = 0;
    TruckerGoNext(playerid);

    SendMes(playerid, COLOR_BLUE, "Вы начали выполнение заказа.");
    SendMes(playerid, COLOR_SEA_WAVE, "Вам необходимо следовать по маршруту до места разгрузки.");
    SendMes(playerid, COLOR_LYELLOW, "Информация о заказе: "W"Товар: {"#cLYELLOW"}\"%s\". "W"Место разгрузки: {"#cLYELLOW"}\"%s\".", TruckerLoadName[idx], TruckerUnloadName[idx]);

    AntiCheatWarningTime[playerid][0] = timestamp + TruckerTimer[idx];
    return 1;
}

DestroyPlayerTrucker(playerid)
{
    if(!IsPlayerInAnyVehicle(playerid)) return 1;
    new vehicleid = GetPlayerVehicleID(playerid);

    SendMes(playerid, COLOR_BLUE, "Вы выполнили заказ.");

    new vehicle_salary;
    if(veh_info[vehicleid][v_temp_job] == JOB_TC_TRUCK)
    {
        vehicle_salary = (p_temp[playerid][TruckerSalary] / 100) * 20;
        p_temp[playerid][TruckerSalary] += vehicle_salary;
    }

    new salary = GetPlayerTruckerSalary(playerid, p_temp[playerid][TruckerSalary]);

    if(CheckPlayerMaxSalarySkill(playerid, 9, salary))
    {
        SetPlayerMoney(playerid, salary, true, "зарплата дальнобойщик");
        OnServerInfoForMoney[17] += salary;
        SendMes(playerid, COLOR_LYELLOW, "К Вашей зарплате добавлено: {"#cLIME"}%d$.", salary);

        TransferBizMoney(playerid, TYPE_TC_TRUCKER, p_temp[playerid][fix_bug_biz_tc_salary]);

        p_info[playerid][job_skill_salary][9] += salary;
    }
    else SendError(playerid, "За последний час игры было заработано максимальное количество денежных средств.");

    if(GetPlayerGiveCasket(100, 5) != -1) GivePlayerCasket(playerid, -1);

    UpdatePlayerWorkSkill(playerid, 9);

    new idx = p_temp[playerid][TruckerLoad];

    p_temp[playerid][TruckerLoad] = 0;
    p_temp[playerid][TruckerSalary] = 0;

    if(p_temp[playerid][TruckerTrailer] != INVALID_VEHICLE_ID)
    {
        DestroyVehicleVEx(p_temp[playerid][TruckerTrailer]);
        p_temp[playerid][TruckerTrailer] = INVALID_VEHICLE_ID;
    }

    CheckPlayerMission(playerid, START_TRUCKER);
    CheckPlayerMission(playerid, DAILY_TRUCKER);
    CheckPlayerMission(playerid, ACHIEVEMENT_TRUCKER);

    CheckPlayerFreelance(playerid, FREELANCE_TRUCKER);
    CheckPlayerBattlePass(playerid, BATTLEPASS_TRUCKER);

    UpdateFamilyLevel(playerid);
    UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_TRUCKER); // Контракты: Дальнобойщик

    CancelPlayerGPS(playerid);
    DisablePlayerCheckpoint(playerid);
    DisablePlayerRaceCheckpoint(playerid);

    AntiCheatWarningTime[playerid][1] = timestamp + TruckerTimer[idx - 1];

    SendMes(playerid, COLOR_SEA_WAVE, "Для продолжения работы отправляйтесь на базу дальнобойщиков.");
    SendMes(playerid, COLOR_LIME, "Если не знаете как добраться, используйте: {"#cYELLOW"}/gps > [10] База дальнобойщиков");
    return 1;
}

GetPlayerTruckerSalary(playerid, salary) return GetBizPercent(playerid, TYPE_TC_TRUCKER, GetPlayerMoneySkill(playerid, salary, 9));

TruckerGoNext(playerid)
{
    new i = p_temp[playerid][pPressed], type = p_temp[playerid][TruckerLoad];
    switch(type)
    {
        case 1: SetPlayerRaceCheckpoint(playerid, i == 47 ? 1 : 0, TruckerWood[i][0], TruckerWood[i][1], TruckerWood[i][2], TruckerWood[i][3], TruckerWood[i][4], TruckerWood[i][5], 5.0);
        case 2: SetPlayerRaceCheckpoint(playerid, i == 36 ? 1 : 0, TruckerCoal[i][0], TruckerCoal[i][1], TruckerCoal[i][2], TruckerCoal[i][3], TruckerCoal[i][4], TruckerCoal[i][5], 5.0);
        case 3: SetPlayerRaceCheckpoint(playerid, i == 32 ? 1 : 0, TruckerFuel[i][0], TruckerFuel[i][1], TruckerFuel[i][2], TruckerFuel[i][3], TruckerFuel[i][4], TruckerFuel[i][5], 5.0);
    }
    return 1;
}

CMD:createtrucker(playerid)
{
    if(!FD(playerid) || p_info[playerid][admin] < 10) return 1;

    TruckerOrder[0] += random(10);
    if(TruckerOrder[0] > 30) TruckerOrder[0] = 0;
    TruckerOrder[1] += random(10);
    if(TruckerOrder[1] > 30) TruckerOrder[1] = 0;
    TruckerOrder[2] += random(10);
    if(TruckerOrder[2] > 30) TruckerOrder[2] = 0;

    new str[12];
    f(str, "%d", TruckerOrder[0]);
    SetDynamicObjectMaterialText(TruckerObject[0], 0, str, 130, "Arial Black", 55, 0, 0xFF000000, 0x00000000, 1);
    SetDynamicObjectMaterialText(TruckerObject[1], 0, str, 130, "Arial Black", 55, 0, 0xFFFFFFFF, 0x00000000, 1);
    f(str, "%d", TruckerOrder[1]);
    SetDynamicObjectMaterialText(TruckerObject[2], 0, str, 130, "Arial Black", 55, 0, 0xFF000000, 0x00000000, 1);
    SetDynamicObjectMaterialText(TruckerObject[3], 0, str, 130, "Arial Black", 55, 0, 0xFFFFFFFF, 0x00000000, 1);
    f(str, "%d", TruckerOrder[2]);
    SetDynamicObjectMaterialText(TruckerObject[4], 0, str, 130, "Arial Black", 55, 0, 0xFF000000, 0x00000000, 1);
    SetDynamicObjectMaterialText(TruckerObject[5], 0, str, 130, "Arial Black", 55, 0, 0xFFFFFFFF, 0x00000000, 1);

    SendAccess(playerid, "Вы создали заказы для дальнобойщиков.");
    return 1;
}