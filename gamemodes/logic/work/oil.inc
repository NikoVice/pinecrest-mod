CheckPlayerBuyOil(playerid)
{
    if(p_info[playerid][p_vip] == 3 && p_info[playerid][p_add_vip] == 1) return MAX_PLAYER_OIL_COUNT * 2;
    return MAX_PLAYER_OIL_COUNT;
}

GetVehicleMaxOil(vehicle_model)
{
    switch(vehicle_model)
    {
        case 454: return 5;
        case 472: return 10;
        case 452: return 15;
        case 446: return 20;
        case 493: return 25;
        case 578: return 25;
        default: return 5;
    }
    return 5;
}

