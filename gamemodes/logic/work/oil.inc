CMD:oil(playerid, params[])
{
    if(p_info[playerid][job] != JOB_OIL) return SendError(playerid, "Вы не работаете нефтяником.");
    if(p_temp[playerid][Work_ID] != OIL_WORK) return SendError(playerid, "Вы не начали рабочий день.");
    new vehicleid = p_temp[playerid][rented_veh];
    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "У Вас нет арендованного рабочего транспортного средства.");
    if(veh_info[vehicleid][v_npoType] != NPO_JOB && veh_info[vehicleid][v_npoId] != JOB_OIL && veh_info[vehicleid][v_temp_job] != JOB_OIL) return SendError(playerid, "У Вас нет арендованного рабочего транспортного средства.");
    ShowPlayerDialog(playerid, D_OIL_MENU, DIALOG_STYLE_LIST, ""I"Нефтяник", ""I"[1]"W" Начать загрузку\n"I"[2]"W" Начать разгрузку\n"I"[3]"W" Список нефтевышек", "Далее", "Отмена");
    return 1;
}

CMD:oil_test(playerid, params[])
{
    if(SRV_ID) return 1;
    CheckBizz();
    return 1;
}