forward house_rent_user(playerid, h_r_id);
public house_rent_user(playerid, h_r_id)
{
    new rows, name_rent[MAX_PLAYER_NAME];
    cache_get_row_count(rows);
    STRING_GLOBAL[0] = EOS;
    if(!rows) {
        name_rent = "Свободно";
        format(STRING_GLOBAL, 256, ""I"[1]"W" Заселить игрока\n");
    }
    else {
        cache_get_value_name(0, "name", name_rent, MAX_PLAYER_NAME);
        format(STRING_GLOBAL, 256, ""I"[1]"W" Выселить "A"%s\n", name_rent);
    }
    format(STRING_GLOBAL, 256, "%s"I"[2]"W" Сменить плату за аренду\n"I"[3]"W" Выставить настройки доступа", STRING_GLOBAL);
    p_temp[playerid][p_listitem_int] = h_r_id;
    ShowPlayerDialog(playerid, D_HOUSE_RENT_MENU, DIALOG_STYLE_LIST, ""I"Меню управления арендатором", STRING_GLOBAL, "Выбрать", "Отмена");
    return 1;
}

forward house_rent_settings(playerid, h_r_id);
public house_rent_settings(playerid, h_r_id)
{
    new rows;
    cache_get_row_count(rows);
    if(!rows)  return SendError(playerid, "Код ошибки: 1005 (Обратитесь к администрации)");

    for(new i; i < 5; i++) p_temp[playerid][p_listitem][i] = 0;

    new str_data[32];
    cache_get_value_name(0, "h_r_settings", str_data); // 0|0|0 house rent settings
    sscanf(str_data, "p<|>iii",
        p_temp[playerid][p_listitem][R_GARAGE],
        p_temp[playerid][p_listitem][R_BASEMENT],
        p_temp[playerid][p_listitem][R_UNDERGROUND]);

    static const h_access[][] = {"Нет", "Есть"};
    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL,
        ""I"[1]"W" Возможность парковать в гараже: "A"%s\n\
        "I"[2]"W" Возможность доступа к подвалу: "A"%s\n\
        "I"[3]"W" Возможность доступа к подпольному помещению: "A"%s\n",
        h_access[p_temp[playerid][p_listitem][R_GARAGE]],
        h_access[p_temp[playerid][p_listitem][R_BASEMENT]],
        h_access[p_temp[playerid][p_listitem][R_UNDERGROUND]]);

    ShowPlayerDialog(playerid, D_HOUSE_RENT_SETTINGS, DIALOG_STYLE_LIST, ""I"Управление доступом арендатора", STRING_GLOBAL, "Выбрать", "Отмена");
    return 1;
}

forward house_rent_leave(h, i);
public house_rent_leave(h, i)
{
    new playerid = GetPlayerUserID(h_info[h][h_r_user_id][i]);
    if(playerid != INVALID_PLAYER_ID)
    {
        p_info[playerid][h_r_settings][R_GARAGE] =
        p_info[playerid][h_r_settings][R_BASEMENT] =
        p_info[playerid][h_r_settings][R_UNDERGROUND] = 0;

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%i|%i|%i",
        p_info[playerid][h_r_settings][R_GARAGE], p_info[playerid][h_r_settings][R_BASEMENT], p_info[playerid][h_r_settings][R_UNDERGROUND]);
        MysqlUpdatePlayerStr(playerid, "h_r_settings", STRING_GLOBAL);

        if(GetPlayerVirtualWorld(playerid) == h+50) {
            SetPlayerInterior(playerid,0);
            SetPlayerVirtualWorld(playerid,0);
            SetPlayerPos(playerid,h_info[h][h_enter][0], h_info[h][h_enter][1], h_info[h][h_enter][2]);
            SetPlayerFacingAngle(playerid, h_info[h][h_enter][3]);
        }
        p_info[playerid][key_h_rent] = -1;

        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `v_mysql_id`, `v_model` FROM `vehicle` WHERE `v_owner_id` = %d",
        p_info[playerid][ID]);
        mysql_tquery(con_bd, STRING_GLOBAL, "restore_cars", "i", playerid);
    }
    else
    {
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL, ""W"Вас выселено из дома "I"№%d. "W"Причина: "I"Не уплата", h);
        AddNotify(h_info[h][h_r_user_id][i], STRING_GLOBAL);

        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `spawn` = 0, `h_r_settings` = '0|0' WHERE `id` = %d",
        h_info[h][h_r_user_id][i]);
        mysql_tquery(con_bd, STRING_GLOBAL);

        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `v_mysql_id`, `v_model` FROM `vehicle` WHERE `v_owner_id` = %d",
        h_info[h][h_r_user_id][i]);
        mysql_tquery(con_bd, STRING_GLOBAL, "restore_cars", "i", INVALID_PLAYER_ID);
    }
    h_info[h][h_r_price][i] = h_info[h][h_squar]*200;
    h_info[h][h_r_user_id][i] = INVALID_MYSQL_ID;
    save_house(h);
    return 1;
}
////
GetPlayerHotelID(playerid, type)
{
    switch(type)
    {
        case 0: if(p_info[playerid][key_hotel] != -1) return p_info[playerid][key_hotel];
        case 1: if(p_info[playerid][key_hotel_room] != -1) return p_info[playerid][key_hotel_room];
        default: return -1;
    }
    return -1;
}

public OnPlayerInteriorChange(playerid, newinteriorid, oldinteriorid)
{
    new
        playerSpectatorId = pSpectatorId[playerid];

    if(playerSpectatorId != INVALID_PLAYER_ID)
        UpdateSpectatingStatus(playerSpectatorId, playerid);

    if(newinteriorid > 0)
        SetPlayerWeather(playerid, 1);
    else if(newinteriorid == 0 && oldinteriorid > 0)
        SetPlayerWeather(playerid, Default_Weather);

    if(p_temp[playerid][DuelID] == INVALID_PLAYER_ID && RegisterPaintBall[playerid] != 2 && p_temp[playerid][cossack_robbers_register] != 2 && player_lobby_status[playerid] == false)
    {
        ResetPlayerWeapons(playerid);
        for (new i; i < MAX_WEAPONS; i++) GivePlayerWeapon(playerid, p_info[playerid][Weapon][i], p_info[playerid][Ammo][i]);
        SetPlayerArmedWeapon(playerid, 0);
    }
    return 1;
}

CMD:eat(playerid, params[])
{
    if(sscanf(params, "i", params[0]))
    {
        SendInfo(playerid, "Используйте: /eat [тип]");
        SendInfo(playerid, "ТИП 1: Сэндвич | ТИП 2: Бургер");
        return 1;
    }
    if(params[0] < 1 || params[0] > 2) return SendError(playerid, "Тип должен быть не менее 1 и не более 2.");
    switch(params[0])
    {
        case 1:
        {
            if(!GivePlayerInventory(playerid, 638, -1))
                return SendError(playerid, "У Вас нет сэндвича.");

            if(floatcmp(floatadd(p_info[playerid][satiety], 40.0), 100.0) == 1) p_info[playerid][satiety] = 100.0;
            else p_info[playerid][satiety] += 40.0;

            if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid, "FOOD", "EAT_Pizza", 4.1, 0, 0, 0, 0, 0, 1);
            SendAccess(playerid, "Вы съели сэндвич.");

            if(GetPlayerDisease(playerid, 1, 10, 2) == 1) // Шанс 20 процентов;
            {
                p_info[playerid][Disease][1]++;
                SendInfo(playerid, "У Вас появилось новое заболевание - диарея %d степени.", p_info[playerid][Disease][1]);
            }
        }
        case 2:
        {
            if(!GivePlayerInventory(playerid, 639, -1))
                return SendError(playerid, "У Вас нет бургера.");

            if(floatcmp(floatadd(p_info[playerid][satiety], 40.0), 100.0) == 1) p_info[playerid][satiety] = 100.0;
            else p_info[playerid][satiety] += 40.0;

            SendAccess(playerid, "Вы съели бургер.");

            if(GetPlayerDisease(playerid, 1, 10, 2) == 1) // Шанс 20 процентов;
            {
                p_info[playerid][Disease][1]++;
                SendInfo(playerid, "У Вас появилось новое заболевание - диарея %d степени.", p_info[playerid][Disease][1]);
            }
        }
    }
    return 1;
}

CMD:drink(playerid, params[])
{
    if(sscanf(params, "i", params[0]))
    {
        SendInfo(playerid, "Используйте: /drink [тип]");
        SendInfo(playerid, "ТИП 1: Вода | ТИП 2: Пиво | ТИП 3: Вино | ТИП 4: Коньяк | ТИП 5: Водка");
        return 1;
    }
    if(params[0] < 1 || params[0] > 5) return SendError(playerid, "Тип должен быть не менее 1 и не более 5.");
    new Float:thirst_count[5] = {20.0, 40.0, 60.0, 80.0, 100.0}, Float:count = thirst_count[params[0] - 1], drink_type[5] = {695, 696, 697, 698, 699}, type = drink_type[params[0] - 1];
    if(!GetInventoryAmount(playerid, type)) return SendError(playerid, "У Вас нет \"%s\".", ItemsInfo[type][iName]);
    if(floatcmp(floatadd(p_info[playerid][thirst], count), 100.0) == 1) p_info[playerid][thirst] = 100.0;
    else p_info[playerid][thirst] += count;
    GivePlayerInventory(playerid, type, -1);
    if(params[0] > 1 && GetPlayerDrunkLevel(playerid) < 20000) SetPlayerDrunkLevel(playerid, GetPlayerDrunkLevel(playerid) + 1000 * (params[0] - 1));
    if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid, "BAR", "dnk_stndF_loop", 4.1, 0, 0, 0, 0, 0, 1);
    SendAccess(playerid, "Вы выпили бутылку \"%s\".", ItemsInfo[type][iName]);
    return 1;
}
////////////////////////////// twinturbo
cmd:tt(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(veh_info[vehicleid][v_twinturbo] == 1 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
    {
        p_temp[playerid][twinturbo_on] ^= 1;
        SendAccess(playerid, "Вы %s TwinTurbo.", p_temp[playerid][twinturbo_on] == 1 ? "включили" : "выключили");
        OnPlayerUpdateVehicleInfo(playerid, SPEEDO_TWINTURBO);
        if(150 <= GetPlayerPing(playerid) <= 299)
            SendInfo(playerid, "Обратите внимание, у вас повышенный ping, TT может работать не корректно.");
    }
    return true;
}
