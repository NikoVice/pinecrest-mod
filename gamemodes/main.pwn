                SetPlayerPos(i, 288.6758,-135.2414,1004.0625), SetPlayerFacingAngle(i, 90.4716);
                SetPlayerInterior(i, 7);
                SetPlayerVirtualWorld(i, 1);
            }
            if(p_temp[i][prison_escape] <= 0) p_info[i][jail_time]--;
