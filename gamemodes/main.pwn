                        else SendError(playerid, "За последний час игры было заработано максимальное количество денежных средств.");

                        if(p_temp[playerid][pPressed] == 0 || p_temp[playerid][pPressed] == 8 || p_temp[playerid][pPressed] == 45 || p_temp[playerid][pPressed] == 48 || p_temp[playerid][pPressed] == 52 || p_temp[playerid][pPressed] == 86|| p_temp[playerid][pPressed] == 96) e_type = 1;
                        else e_type = 0;
                        new i = p_temp[playerid][pPressed];
                        SetPlayerRaceCheckpoint(playerid,e_type,BusSchool[i][0],BusSchool[i][1],BusSchool[i][2],BusSchool[i][3],BusSchool[i][4],BusSchool[i][5],7.0);
                    }
                }
                case 5:
                {
                    //name = "АвтоВокзал LS << >> АвтоВокзал LV";
                    if(p_temp[playerid][pPressed] == 0 || p_temp[playerid][pPressed] == 10 || p_temp[playerid][pPressed] == 36  || p_temp[playerid][pPressed] == 60 || p_temp[playerid][pPressed] == 69)
                    {
                        if(GetPVarInt(playerid, "BusStop") == 0)
