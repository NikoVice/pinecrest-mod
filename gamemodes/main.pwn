            new targetid = MarketInfo[idx][mOwnerID];
            if(targetid == INVALID_PLAYER_ID) return SendError(playerid, "������� �� ����� ����������."), ClearPlayerMarketUse(playerid), p_temp[playerid][market_buy_items][0] = -1;
            new count = 1,
                price_item = p_temp[playerid][market_buy_items][1],
