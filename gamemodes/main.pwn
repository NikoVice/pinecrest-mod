                                    if(statusUse) return SkinsPlayerList(playerid, SKINS_ID_REPAIR), SendError(playerid, "������ ���� ������������.");
                                    if(InventoryPlayer[playerid][listitem][inv_skin_wear] > 99.8) return SkinsPlayerList(playerid, SKINS_ID_REPAIR), SendError(playerid, "������ ���� ��� ��� ������������� �������.");
                                    new biz_id = GetPVarInt(playerid, "bID"), till = b_info[biz_id][_till];
                                    STRING_GLOBAL[0] = EOS;
                                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"�� ������������� ������ ��������� ������ \"%s\" �� %d$?", ItemsInfo[itemID][iName], GetPriceWashSkins(InventoryPlayer[playerid][listitem][inv_skin_wear]) * till);
                                    ShowPlayerDialog(playerid, D_WASH_REPAIR, DIALOG_STYLE_MSGBOX, ""I"������ ������", STRING_GLOBAL, "��", "���");
                                    SetPVarInt(playerid, "WASH:idx", listitem);
                                }
                                case SKINS_ID_PREMIUM:
                                {
                                    if(!response) return 1;
                                    if(!statusUse) return SkinsPlayerList(playerid, SKINS_ID_REPAIR), SendError(playerid, "������ ���� �� ������������.");
                                    STRING_GLOBAL[0] = EOS;
                                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"�� ������������� ������ ���������� \"Premium\" �� \"%s\"?", ItemsInfo[itemID][iName]);
                                    ShowPlayerDialog(playerid, D_INSTALL_PREMIUM_SKIN, DIALOG_STYLE_MSGBOX, ""I"Premium �� ����", STRING_GLOBAL, "��", "���");
                                    SetPVarInt(playerid, "INSTALL_PREMIUM_SKIN:idx", listitem+1);
