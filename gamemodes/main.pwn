                        return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");
                    SetPlayerMoney(playerid, -10_000, true, "�������� ��� ���������� ������� <%s>", GetFractionName(p_info[playerid][member]));
                    foreach(new v: Vehicle)
