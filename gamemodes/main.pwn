                    mysql_tquery(con_bd, STRING_GLOBAL);
                }
            }
            SendAccess(playerid, "�� ����� %d BTC.", iBTC);

            MysqlUpdatePlayerInt(playerid, "bitcoin", p_info[playerid][bitcoin]);
            ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]);
            return 1;
