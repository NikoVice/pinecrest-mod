CMD:frisk(playerid, params[])
{
    if((!IsPlayerFractionPolice(playerid) && p_info[playerid][member] != PRISON) || p_info[playerid][rang] < 3) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "�����������: /frisk [id ������]");
    if(!IsPlayerConnected(params[0])) return true;
    if(!IsPlayerStream(3.0, playerid, params[0])) return true;
    if(params[0] == playerid) return SendError(playerid, "�� ����� ���� ID.");

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "�������� ����� � �������.");
        MeAction(playerid, "������� ������ ���� � ������, ����� ���� ������� ��������...");
        MeAction(playerid, "...������ �� � ���� �� ����");
        MeAction(playerid, "�������� ������ ������ � ������� ��������, ��������...");
        MeAction(playerid, "...����� � ��� ������� ���� ���-�� �����");
    }

    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "�������(-�) %s", get_name(params[0]));
    MeAction(playerid, STRING_GLOBAL);

    SendInfo(playerid, "���� %s.", get_name(params[0]));
    SendInfo(playerid, "%s", (GetInventoryAmount(params[0], 629)) ? ("���������.") : ("������ ������."));
    SendInfo(playerid, "%s", (GetInventoryAmount(params[0], 627)) ? ("���������.") : ("������ ������."));
    SendInfo(playerid, "%s", (GetInventoryAmount(params[0], 628)) ? ("�������.") : ("������ ������."));

    SetPlayerSpecialAction(params[0], SPECIAL_ACTION_HANDSUP);

    p_info[playerid][fracdata][6]++;
    SaveFracData(playerid);

    CheckPlayerMission(playerid, POLICE_FRISK);

    p_info[playerid][ftop_frisk]++;
    MysqlUpdatePlayerInt(playerid, "ftop_frisk", p_info[playerid][ftop_frisk]);
    return 1;
}

