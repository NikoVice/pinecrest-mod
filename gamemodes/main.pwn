CMD:fly(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10) return 1;
    if(GetPVarInt(playerid, "FlyMode")) CancelFlyMode(playerid);
    else FlyMode(playerid);
    return 1;
}

FlyMode(playerid)
{
    if(GetPVarInt(playerid, "FlyMode") == 1) return SendMes(playerid, COLOR_GRAY, "Выйдите из режима флай.");
    new Float:X, Float:Y, Float:Z;
    GetPlayerPos(playerid, X, Y, Z);
    noclipdata[playerid][flyobject] = CreatePlayerObject(playerid, 19300, X, Y, Z, 0.0, 0.0, 0.0);
    TogglePlayerSpectating(playerid, true);
    AttachCameraToPlayerObject(playerid, noclipdata[playerid][flyobject]);
    SetPVarInt(playerid, "FlyMode", 1);
    SetPVarInt(playerid, "ReconOn", 1);
    noclipdata[playerid][cameramode] = CAMERA_MODE_FLY;
    if(GetPlayerState(playerid) != PLAYER_STATE_SPECTATING)
    {
        GetPlayerPos(playerid, pPosBeforeSpectateX[playerid], pPosBeforeSpectateY[playerid], pPosBeforeSpectateZ[playerid]);
        pInteriorBeforeSpectate[playerid] = GetPlayerInterior(playerid);
        pVirtualWorldBeforeSpectate[playerid] = GetPlayerVirtualWorld(playerid);
        SetPVarInt(playerid, !"spawn_after_spectate_mode", 2);
    }
    return 1;
}

CancelFlyMode(playerid)
{
    GetPlayerObjectPos(playerid, noclipdata[playerid][flyobject], pPosBeforeSpectateX[playerid], pPosBeforeSpectateY[playerid], pPosBeforeSpectateZ[playerid]);
    TogglePlayerSpectating(playerid, false);

    DestroyPlayerObject(playerid, noclipdata[playerid][flyobject]);
    noclipdata[playerid][cameramode] = CAMERA_MODE_NONE;
    DeletePVar(playerid, "FlyMode");
    return 1;
}

MoveCamera(playerid)
{
    new Float:FV[3], Float:CP[3];
    GetPlayerCameraPos(playerid, CP[0], CP[1], CP[2]);
    GetPlayerCameraFrontVector(playerid, FV[0], FV[1], FV[2]);
    if(noclipdata[playerid][accelmul] <= 1) noclipdata[playerid][accelmul] += ACCEL_RATE;
    new Float:speed = MOVE_SPEED * noclipdata[playerid][accelmul];
    new Float:X, Float:Y, Float:Z;
    GetNextCameraPosition(noclipdata[playerid][nmode], CP, FV, X, Y, Z);
    MovePlayerObject(playerid, noclipdata[playerid][flyobject], X, Y, Z, speed);
    noclipdata[playerid][lastmove] = GetTickCount();
    return 1;
}

GetNextCameraPosition(move_mode, Float:CP[3], Float:FV[3], &Float:X, &Float:Y, &Float:Z)
{
    #define OFFSET_X (FV[0]*6000.0)
    #define OFFSET_Y (FV[1]*6000.0)
    #define OFFSET_Z (FV[2]*6000.0)
    switch(move_mode)
    {
        case MOVE_FORWARD:
        {
            X = CP[0]+OFFSET_X;
            Y = CP[1]+OFFSET_Y;
            Z = CP[2]+OFFSET_Z;
        }
        case MOVE_BACK:
        {
            X = CP[0]-OFFSET_X;
            Y = CP[1]-OFFSET_Y;
            Z = CP[2]-OFFSET_Z;
        }
        case MOVE_LEFT:
        {
            X = CP[0]-OFFSET_Y;
            Y = CP[1]+OFFSET_X;
            Z = CP[2];
        }
        case MOVE_RIGHT:
        {
            X = CP[0]+OFFSET_Y;
            Y = CP[1]-OFFSET_X;
            Z = CP[2];
        }
        case MOVE_BACK_LEFT:
        {
            X = CP[0]+(-OFFSET_X - OFFSET_Y);
            Y = CP[1]+(-OFFSET_Y + OFFSET_X);
            Z = CP[2]-OFFSET_Z;
        }
        case MOVE_BACK_RIGHT:
        {
            X = CP[0]+(-OFFSET_X + OFFSET_Y);
            Y = CP[1]+(-OFFSET_Y - OFFSET_X);
            Z = CP[2]-OFFSET_Z;
        }
        case MOVE_FORWARD_LEFT:
        {
            X = CP[0]+(OFFSET_X  - OFFSET_Y);
            Y = CP[1]+(OFFSET_Y  + OFFSET_X);
            Z = CP[2]+OFFSET_Z;
        }
        case MOVE_FORWARD_RIGHT:
        {
            X = CP[0]+(OFFSET_X  + OFFSET_Y);
            Y = CP[1]+(OFFSET_Y  - OFFSET_X);
            Z = CP[2]+OFFSET_Z;
        }
    }
    return 1;
}

GetMoveDirectionFromKeys(ud, lr)
{
    new direction = 0;
    if(lr < 0)
    {
        if(ud < 0)         direction = MOVE_FORWARD_LEFT;     // Up & Left key pressed
        else if(ud > 0) direction = MOVE_BACK_LEFT;     // Back & Left key pressed
        else            direction = MOVE_LEFT;  // Left key pressed
    }
    else if(lr > 0)
    {
        if(ud < 0)      direction = MOVE_FORWARD_RIGHT;  // Up & Right key pressed
        else if(ud > 0) direction = MOVE_BACK_RIGHT;     // Back & Right key pressed
        else            direction = MOVE_RIGHT;  // Right key pressed
    }
    else if(ud < 0)     direction = MOVE_FORWARD;     // Up key pressed
    else if(ud > 0)     direction = MOVE_BACK;// Down key pressed
    return direction;
}

CheckPlayerVehicleDetails(playerid)
{
    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
    {
        new vehicleid = GetPlayerVehicleID(playerid),
            modelid = GetVehicleModelEx(vehicleid);
        if(modelid >= 400 && (veh_info[vehicleid][v_owner_id] != INVALID_MYSQL_ID || veh_info[vehicleid][v_family_id] != -1) && veh_info[vehicleid][v_premium] == 0)
        {
            if(GetVehicleData(modelid, E_VD_TYPE) == VEHICLE_STATE_MOTO || GetVehicleData(modelid, E_VD_TYPE) == VEHICLE_STATE_CAR)
            {
                if(veh_info[vehicleid][v_engine] == 1)
                {
                    if(veh_info[vehicleid][v_details][1] == 0.0)
                    {
                        p_temp[playerid][VehicleDetailsTime][0]++;
                        if(p_temp[playerid][VehicleDetailsTime][0] > 10)
                        {
                            SendInfo(playerid, "В транспортом средстве необходимо заменить аккумулятор.");
                            p_temp[playerid][VehicleDetailsTime][0] = 0;
                            if(random(3) != 2)
                            {
                                SendInfo(playerid, "Двигатель заглох. Замените аккумулятор.");
                                SetVehicleParamsVEx(vehicleid, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective);
                                veh_info[vehicleid][v_engine] = 0;
                                OnPlayerUpdateVehicleInfo(playerid, SPEEDO_ENGINE);
                            }
                        }
                    }
                    else
                    {
                        if(p_temp[playerid][VehicleDetailsTime][1] > 180)
                        {
                            veh_info[vehicleid][v_details][1] -= 0.2;
                            if(veh_info[vehicleid][v_details][1] < 0.0) veh_info[vehicleid][v_details][1] = 0.0;
                            p_temp[playerid][VehicleDetailsTime][1] = 0;
                        }
                        p_temp[playerid][VehicleDetailsTime][1]++;
                    }
                    if(veh_info[vehicleid][v_details][3] == 0.0 && PRESS_UP[playerid] == 1)
                    {
                        p_temp[playerid][VehicleDetailsTime][2]++;
                        if(p_temp[playerid][VehicleDetailsTime][2] > 15)
                        {
                            SendInfo(playerid, "В транспортом средстве необходимо заменить сцепление.");
                            p_temp[playerid][VehicleDetailsTime][2] = 0;
                            if(random(3) != 2)
                            {
                                SendInfo(playerid, "Двигатель заглох. Замените сцепление.");
                                SetVehicleParamsVEx(vehicleid, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective);
                                veh_info[vehicleid][v_engine] = 0;
                                OnPlayerUpdateVehicleInfo(playerid, SPEEDO_ENGINE);
                            }
                        }
                    }
                    else
                    {
                        if(p_temp[playerid][VehicleDetailsTime][3] > 180)
                        {
                            veh_info[vehicleid][v_details][3] -= 0.1;
                            if(veh_info[vehicleid][v_details][3] < 0.0) veh_info[vehicleid][v_details][3] = 0.0;
                            p_temp[playerid][VehicleDetailsTime][3] = 0;
                        }
                        p_temp[playerid][VehicleDetailsTime][3]++;
                    }
                    if(veh_info[vehicleid][v_details][4] == 0.0)
                    {
                        p_temp[playerid][VehicleDetailsTime][4]++;
                        if(p_temp[playerid][VehicleDetailsTime][4] > 30)
                        {
                            SendInfo(playerid, "В транспортом средстве необходимо заменить двигатель.");
                            p_temp[playerid][VehicleDetailsTime][4] = 0;
                            if(random(3) != 2)
                            {
                                SendInfo(playerid, "Двигатель заглох. Замените его.");
                                SetVehicleParamsVEx(vehicleid, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective);
                                veh_info[vehicleid][v_engine] = 0;
                                OnPlayerUpdateVehicleInfo(playerid, SPEEDO_ENGINE);
                            }
                        }
                    }
                    else
                    {
                        if(p_temp[playerid][VehicleDetailsTime][5] > 180)
                        {
                            veh_info[vehicleid][v_details][4] -= 0.1;
                            if(veh_info[vehicleid][v_details][4] < 0.0) veh_info[vehicleid][v_details][1] = 0.0;
                            p_temp[playerid][VehicleDetailsTime][5] = 0;
                        }
                        p_temp[playerid][VehicleDetailsTime][5]++;
                    }
                }
            }
        }
    }
}

ConvertTime(seconds, type = 0)
{
    new time[64], h, m, s;
    h = seconds / 3600;
    m = (seconds - h * 3600) / 60;
    s = seconds  - (h * 3600) - (m * 60);
    if(type)
    {
        if(h > 0) format(time, sizeof(time), "%02d:%02d:%02d", h, m, s);
        else format(time, sizeof(time), "%02d:%02d", m, s);
    }
    else format(time, sizeof(time), "%d ч %d мин %d сек", h, m, s);
    return time;
}

