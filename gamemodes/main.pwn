            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s [%d] предложил Вам участвовать в дуэли!", get_name(playerid), playerid, DuelData[playerid][dBank], WEAPON_Name[DuelData[playerid][dGun]], DuelData[playerid][dRound]);
            ShowPlayerDialog(targetid, D_DUEL_PLAYER_CALL, DIALOG_STYLE_MSGBOX, ""I"Приглашение", STRING_GLOBAL, "Принять", "Отмена");
            //OnServerShowDialogDuelMenu(playerid);
            return 1;
