forward TazerEndTimer(playerid);
public TazerEndTimer(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    Fix_TogglePlayerControllable(playerid, 1);
    ClearAnimations(playerid, true);
    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
    ApplyAnimation(playerid,"FAT","IDLE_tired", 4.0, 0, 0, 0, 0, 1);
    p_temp[playerid][tazer_dest] = false;
    return 1;
}

CheckDMAnalyze(playerid, targetid)
{
    new pWeapon = GetPlayerWeapon(playerid);
    if( targetid != playerid &&
        p_info[playerid][p_settings][STATUS_REPORT_DM] == 0 &&
        player_lobby_status[playerid] != true && player_lobby_status[targetid] != true &&
        p_info[playerid][admin] < 1 &&
        GetPlayerWeapon(targetid) == 0 &&
        pSpectatorId[playerid] == INVALID_PLAYER_ID &&
        p_info[playerid][jail] == 0 && p_info[targetid][jail] == 0 &&
        p_temp[playerid][DuelID] == INVALID_PLAYER_ID &&
        GetPlayerStatusCapture(targetid) == CAPTURE_ID_NONE && GetPlayerStatusCapture(playerid) == CAPTURE_ID_NONE &&
        p_temp[targetid][SparringID] == -1 && p_temp[playerid][SparringID] == -1)
    {
        if(p_temp[playerid][anti_dm_oldtargetid] == targetid)
        {
            new Float:target_hp;
            GetPlayerHealth(targetid, target_hp);

            p_temp[playerid][anti_dm_count]++;
            if (p_temp[playerid][anti_dm_count] >= 8 && (pWeapon >= 0 && pWeapon <= 15) || // ��������
                p_temp[playerid][anti_dm_count] >= 2 && (pWeapon >= 22 && pWeapon <= 27) || // ��������� + ���������
                p_temp[playerid][anti_dm_count] >= 4 && (pWeapon == 31 || pWeapon == 30)  ||// M4, AK
                target_hp < 30.0)
            {
                new admin_count;
                foreach(new i: gAdmins)
                {
                    if(p_temp[i][avto_dm_check] == true && GetPlayerState(i) == PLAYER_STATE_ONFOOT && p_info[i][p_afkTime] < 2)
                    {
                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, "%d",  playerid);
                        callcmd::recon(i, STRING_GLOBAL);

                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s[%d] �������� DM %s[%d] ������������� %s ��������� � �����.",
                            get_name(playerid), playerid, get_name(targetid), targetid, get_name(i));
                        SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);
                        admin_count++;

                        /*a_info[i][a_ans] = 1;
                        MysqlUpdateAdminInt(i, "a_ans", a_info[i][a_ans]);*/
                        break;
                    }
                }
                /*
                if(!admin_count)
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s[%d] �������� DM %s[%d] - ���������(!).",
                        get_name(playerid), playerid, get_name(targetid), targetid);
                    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);
                }
                */
                if(ServerInfo[FreezeOnDM])
                {
                    Fix_TogglePlayerControllable(playerid, 0);

                    p_temp[playerid][UnFreezeFix] = 1;
                    p_temp[playerid][UnFreezeTimerFix] = timestamp + 2;
                    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, "���������� � ��", "�� �������������� � DM, ������� ���������� ��� �� 3 �������.\n��������, DM - ���������� ��������� ������(!).", "�����", "");
                }
            }
        }
        else
        {
            p_temp[playerid][anti_dm_oldtargetid] = targetid;
            p_temp[playerid][anti_dm_count] = 1;
        }
    }
}

CheckPlayerDM(playerid)
{
    if(ServerInfo[AntiDMSystem])
    {
        if( p_info[playerid][level] < 5 &&
            p_info[playerid][member] == 0 &&
            p_info[playerid][Lic][LIC_WEAPON] != 1 &&
            GetPlayerVirtualWorld(playerid) == 0 &&
            GetPlayerInterior(playerid) == 0 &&
            RegisterPaintBall[playerid] != 2 &&
            p_temp[playerid][cossack_robbers_register] != 2 &&
            player_lobby_status[playerid] != true)
        {
            ShowPlayerDialog(playerid, D_DM_ZONE, DIALOG_STYLE_MSGBOX, ""I"��� ��������� �������� ����", ""W"\
            ���� �� �� �������� �� �������, � ��� ��� �������� �� ������ � �� �� ���������� � �����������,\n\
            �� �� "I"5-��� ������"W" ��� ��������� �������� ���� ������ �������.", "��", "");
            return 0;
        }
    }
    return 1;
}
///////////////////////////////////////////
// treiler systems
GetPlayerCheckTreiler(mysql_id)
{
    new Cache: result, rows;
    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `v_mysql_id` FROM `vehicle` WHERE `v_owner_id` = %d AND `v_model` = 508", mysql_id);
    result = mysql_query(con_bd, STRING_GLOBAL);
    rows = cache_num_rows();
    cache_delete(result);
    return rows;
}

GetPlayerCountCars(idx, type)
{
    new count = 0;
    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `v_mysql_id`, `v_owner_id`, `v_model` FROM `vehicle` WHERE `v_owner_id` = %d", idx);
    new Cache:result = mysql_query(con_bd, STRING_GLOBAL);
    if(cache_num_rows())
    {
        new modelid;
        for(new i; i < cache_num_rows(); i++)
        {
            cache_get_value_name_int(i, "v_model", modelid);
            if(GetVehicleData(modelid, E_VD_TYPE) == type) count++;
        }
    }
    cache_delete(result);
    return count;
}

SpawnToTreiler(playerid, vehicleid)
{
    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "��������� �� ��������� ������: ST3107");
    SetPlayerPos(playerid, 4511.3545,-1724.8218,778.6371);
    SetPlayerFacingAngle(playerid, 180.0);
    SetCameraBehindPlayer(playerid);
    SetPlayerInterior(playerid, vehicleid);
    SetPlayerVirtualWorld(playerid, vehicleid);
    Fix_TogglePlayerControllable(playerid, 0);

    p_temp[playerid][UnFreezeFix] = 1;
    p_temp[playerid][UnFreezeTimerFix] = timestamp + 2;

    p_temp[playerid][in_enter_vehicle] = vehicleid;
    return 1;
}

/////////////////////////////////////////////////////////////////////////
LoadACSettings()
{
    new DB:db = db_open("anticheat.db");
/*
    CREATE TABLE "anticheat" (
    "id"    INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT UNIQUE,
    "name"    TEXT,
    "value"    INTEGER DEFAULT 1,
    "maxwarns"    INTEGER DEFAULT 3)
*/
    new DBResult:res = db_query(db, "SELECT * FROM anticheat");

    for(new i, num_rows = db_num_rows(res); i < num_rows; i++)
    {
        db_get_field_assoc(res, "name", AntiCheat[i][acName], 64);
        AntiCheat[i][acValue] = db_get_field_assoc_int(res, "value");
        AntiCheat[i][acMaxWarns] = db_get_field_assoc_int(res, "maxwarns");
        db_next_row(res);
    }

    db_close(db);
}
ShowSetMaxWarns(const playerid, const cheat)
{
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"������� ��������: %d\n\n����� ��������:", AntiCheat[cheat][acMaxWarns]);
    ShowPlayerDialog(playerid, D_AC_SETMAXWARNS, DIALOG_STYLE_INPUT, ""I"���������� �������������� �� ����",
        STRING_GLOBAL, "��", "�����");
    return 1;
}

ShowCheatList(const playerid, const dialogid)
{
    if(dialogid == D_AC_PANEL)
    {
        ShowPlayerDialog(playerid, D_AC_PANEL, DIALOG_STYLE_LIST,
            ""I"���������� ���������",
            ""I"[1]"W" ��������/���������\n"I"[2]"W" ���������� �������������� �� ����", "�������", "�������");
        return 1;
    }

    new num[4];

    STRING_GLOBAL[0] = EOS;
    for(new i; i < sizeof AntiCheat; i++)
    {
        strcat(STRING_GLOBAL, AntiCheat[i][acName]);
        strcat(STRING_GLOBAL, "\t");
        if(dialogid == D_AC_ONOFF)
        {
            strcat(STRING_GLOBAL, AntiCheat[i][acValue] ? ("{1cb81c}") : ("{ff6347}"));
            strcat(STRING_GLOBAL, AntiCheat[i][acValue] ? ("true") : ("false"));
        }
        else
        {
            valstr(num, AntiCheat[i][acMaxWarns]);
            strcat(STRING_GLOBAL, num);
        }
        strcat(STRING_GLOBAL, "\n");
    }

    ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_TABLIST,
        dialogid == D_AC_ONOFF ? ("��������/���������") : ("���������� �������������� �� ����"),
        STRING_GLOBAL, "�������", "�����");
    return 1;
}

SaveAntiCheat(const cheat)
{
    static const fqstr[] = "UPDATE `anticheat` SET `value` = %d, `maxwarns` = %d WHERE `id` = %d";
    new qstr[sizeof fqstr + 1];
    format(qstr, sizeof qstr, fqstr, AntiCheat[cheat][acValue], AntiCheat[cheat][acMaxWarns], cheat + 1);

    new DB:db = db_open("anticheat.db");
    db_free_result(db_query(db, qstr));
    db_close(db);
}

///////////////////////////////////////////////
// ���� ���������
CheckHouse()
{
    new bool:check_house = false,
        playerid,
        city;

    for(new h = 0; h < totalhouses; h++)
    {
        if(h_info[h][h_mysql_id] == INVALID_MYSQL_ID) continue;
        if(timestamp_hour == 20)
        {
            if(h_info[h][h_paydays_received] == -1) h_info[h][h_rent] = 0;
        }
        if(h_info[h][h_auction_bet] > 0)
        {
            if(h_info[h][h_auction_user_id] == INVALID_MYSQL_ID) continue;
            if(h_info[h][h_auction_time] > 0) h_info[h][h_auction_time]--;
            check_house = false;
            if(h_info[h][h_auction_time] <= 0)
            { //������ ���������� �������� ���
                playerid = GetPlayerUserID(h_info[h][h_auction_user_id]);
                if(playerid != INVALID_PLAYER_ID)
                {
                    if(GetFreeSlotHouse(playerid) == ALL_BUSY_SLOT_HOUSE || p_info[playerid][key_h_rent] != INVALID_HOUSE_ID)
                    {
                        SendError(playerid, "� ��� ��� ���� ��� ��� �� ���������.");
                        SendInfo(playerid, "��� ���������� %d$ � ������. ������.", (h_info[h][h_auction_bet]/100)*90);
                        p_info[playerid][bank] += (h_info[h][h_auction_bet]/100)*90;
                        MysqlUpdatePlayerInt(playerid, "bank",  p_info[playerid][bank]);
                        check_house = true;
                    }
                    SetFreeSlotHouse(playerid, h);
                    strmid(h_info[h][h_owner], get_name(playerid), 0, strlen(get_name(playerid)), MAX_PLAYER_NAME);
                    p_info[playerid][spawn] = SPAWN_HOUSE;
                    SendInfo(playerid, "�� �������� �� �������� \"��� � %d\". ������: %d$.", h, h_info[h][h_auction_bet]);

                    //lastlog(BUY_HOUSE_GOS,"������� ���� ��������", h_info[h][h_mysql_id], playerid, playerid, -h_info[h][h_auction_bet]);
                    // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) ����� �� �������� ��� (%d)[%d] �� %d$
                    // [logs] ����������� ��������� ������ �������
                    Log(LOG_player, INFO, "%s[%d](%s %s) ����� �� �������� ��� (%d)[%d] �� %d$",
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                        h, h_info[h][h_mysql_id], h_info[h][h_auction_bet]);

                    CheckPlayerMission(playerid, START_HOUSE);
                }
                else
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `house` WHERE `h_user_id` = %d OR\
                        `h_r_user_id_0` = %d OR `h_r_user_id_1` = %d OR `h_r_user_id_2` = %d OR `h_r_user_id_3` = %d OR `h_r_user_id_4` = %d LIMIT 1",
                        h_info[h][h_auction_user_id], h_info[h][h_auction_user_id], h_info[h][h_auction_user_id], h_info[h][h_auction_user_id], h_info[h][h_auction_user_id], h_info[h][h_auction_user_id]);
                    new Cache:result = mysql_query(con_bd, STRING_GLOBAL);

                    if(cache_num_rows() != 0)
                    {
                        STRING_GLOBAL[0] = EOS;
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank` = `bank` + %d WHERE `id` = %d",
                        h_info[h][h_auction_bet]-(h_info[h][h_auction_bet]/10), h_info[h][h_auction_user_id]);
                        mysql_tquery(con_bd, STRING_GLOBAL);
                        check_house = true;
                    }
                    else
                    {
                        STRING_GLOBAL[0] = EOS;
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name` FROM `accounts` WHERE `id` = %d LIMIT 1",
                        h_info[h][h_auction_user_id]);
                        mysql_tquery(con_bd, STRING_GLOBAL, "set_new_owner", "ii", h, 0);

                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, ""W"�� ������� ��������� ��� "I"�%d ������� �� ��������", h);
                        AddNotify(h_info[h][h_auction_user_id], STRING_GLOBAL);

                        //lastlog(FLY_HOUSE_PLAYER,"������� ���� �������� [offline]", h_info[h][h_mysql_id], -1, -1, -h_info[h][h_auction_bet], h_info[h][h_owner]);
                    }
                    cache_delete(result);
                }
                if(check_house == true)
                {
                    h_info[h][h_auction_bet] /= 2;
                    h_info[h][h_auction_user_id] = INVALID_MYSQL_ID;
                    save_house(h);
                }
                else
                {
                    if(h_info[h][h_user_id] != INVALID_MYSQL_ID) //��������� ���� ������ ������ �� ��������� ��������
                    {
                        playerid = GetPlayerUserID(h_info[h][h_user_id]);
                        if(playerid != INVALID_PLAYER_ID)
                        {
                            p_info[playerid][spawn] = p_info[playerid][bank];

                            SendInfo(playerid, "��� ���������� %d$ � ��������� ������.", (h_info[h][h_auction_bet]/100)*90);
                            p_info[playerid][bank] += (h_info[h][h_auction_bet]/100)*90;
                            MysqlUpdatePlayerInt(playerid, "bank",  p_info[playerid][bank]);

                            ClearOwnerHouse(playerid, h);
                        }
                        else
                        {
                            STRING_GLOBAL[0] = EOS;
                            f(STRING_GLOBAL, ""W"��� ���������� %d$ � ��������� ������ �� ��� "I"�%d", (h_info[h][h_auction_bet]/100)*90, h);
                            AddNotify(h_info[h][h_user_id], STRING_GLOBAL);

                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank` = `bank` + %d, `spawn` = 0 WHERE `id` = %d",
                            h_info[h][h_auction_bet]-(h_info[h][h_auction_bet]/10), h_info[h][h_user_id]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                        }
                    }

                    new family_idx = GetFamilyIDFromHouseID(h);
                    if(family_idx != -1)
                    {
                        DeleteFamilyVehicle(family_idx);

                        FamilyData[family_idx][fHouseID] = INVALID_HOUSE_ID;
                        h_info[h][h_family_id] = -1;

                        SendFamilyMessage(family_idx, "��� ����� ������ ��-�� ������� �� ��������.");
                    }

                    h_info[h][h_user_id] = h_info[h][h_auction_user_id];
                    h_info[h][h_lock] = 1;
                    h_info[h][h_garage_lock] = 1;
                    h_info[h][h_rent] = 24;
                    h_info[h][h_owned_at] = timestamp;
                    h_info[h][h_paydays_received] = 0;
                    //set default house new
                    h_info[h][h_int] =
                    h_info[h][h_improve][SUBSIDY] =
                    h_info[h][h_improve][RENTERS] =
                    h_info[h][h_improve][BASEMENT] =
                    h_info[h][h_improve][UNDERGROUND] = 0;
                    h_info[h][h_family_id] = -1;

                    ClearInventoryItems(h_info[h][h_mysql_id], INVENTORY_OWNER_TYPE_HOUSE);

                    for(new i = 0; i < 28; i++) h_info[h][h_garden_items][i] = 0;
                    h_info[h][h_panel_items] = 0;
                    for(new i = 1; i <= totalgarden; i++)
                    {
                        if(GardenInfo[i][gHouseIDx] != h) continue;
                        DestroyGarden(i);
                    }
                    for(new i = 1; i <= totalpanel; i++)
                    {
                        if(PanelHouseInfo[i][PanelHouseIDx] != h) continue;
                        DestroyPanel(i);
                    }
                    for(new i = 1; i <= totalvideocards; i++)
                    {
                        if(VideoCardsInfo[i][vcHouseIDx] != h) continue;
                        DestroyVideoCards(i);
                    }
                    for(new i = 1; i <= totalundergroundbots; i++)
                    {
                        if(UndergroundBotsInfo[i][ubHouseIDx] != h) continue;
                        DestroyUndergroundBots(i);
                    }

                    save_house_interior(h); // ��������� ��������� ����
                    save_garage_interior(h);

                    update_house(h);
                    save_house(h);
                    h_info[h][h_auction_bet] = 0;
                    h_info[h][h_auction_user_id] = INVALID_MYSQL_ID;
                }
            }
        }
        else
        {
            if(h_info[h][h_rent] > 0) h_info[h][h_rent]--;


            if(h_info[h][h_user_id] == INVALID_MYSQL_ID && h_info[h][h_delete] == 0 && SRV_ID)
            {
                h_info[h][h_delete_time]++;
                if(h_info[h][h_delete_time] == 24)
                {
                    h_info[h][h_delete] = 1;
                    if(IsValidDynamicMapIcon(h_info[h][h_icon])) DestroyDynamicMapIcon(h_info[h][h_icon]);
                    if(IsValidDynamic3DTextLabel(h_info[h][h_text])) DestroyDynamic3DTextLabel(h_info[h][h_text]);
                    if(IsValidDynamicPickup(h_info[h][h_pickup_enter])) DestroyDynamicPickup(h_info[h][h_pickup_enter]);
                    if(IsValidDynamic3DTextLabel(h_info[h][h_attic_text])) DestroyDynamic3DTextLabel(h_info[h][h_attic_text]);
                    if(IsValidDynamicArea(h_info[h][h_garage_area][0])) DestroyDynamicArea(h_info[h][h_garage_area][0]);
                    if(IsValidDynamic3DTextLabel(h_info[h][h_garage_text])) DestroyDynamic3DTextLabel(h_info[h][h_garage_text]);
                }
            }

            if(h_info[h][h_rent] <= 0 && h_info[h][h_user_id] != INVALID_MYSQL_ID)
            {
                city = GetCityName(h_info[h][h_enter][0], h_info[h][h_enter][1]);
                SendMesAll(COLOR_LIGHTRED, "��������! "W"��� � ������ %s ��� ������ ��������. �������: �������� �������.", gSAZonesCity[city][SAZONE_NAME]);

                if(h_info[h][h_paydays_received] == -1)
                    Log(LOG_player, INFO, "%s[%d](Offline) ��� (%d)[%d] ��� ������ �������� ��-�� �������������� ������� ��������� �� %d$",
                        h_info[h][h_owner], h_info[h][h_user_id], h, h_info[h][h_mysql_id], h_info[h][h_value]/2);
                else
                    Log(LOG_player, INFO, "%s[%d](Offline) ��� (%d)[%d] ��� ������ �������� ��-�� �������� ������� �� %d$",
                        h_info[h][h_owner], h_info[h][h_user_id], h, h_info[h][h_mysql_id], h_info[h][h_value]/2);

                playerid = GetPlayerUserID(h_info[h][h_user_id]);
                if(playerid != INVALID_PLAYER_ID)
                {
                    ClearOwnerHouse(playerid, h);
                    if(h_info[h][h_paydays_received] == -1) SendInfo(playerid, "� ��� ������� ��� ��-�� �������������� �������.");
                    else SendInfo(playerid, "� ��� ������� ��� ��-�� �� ������ ������.");
                    SendInfo(playerid, "�������� �������� �� ��� ��������� �� ���������� ����.");
                    OnServerInfoForMoney[3] += h_info[h][h_value]/2;
                    p_info[playerid][bank] += h_info[h][h_value]/2;
                    MysqlUpdatePlayerInt(playerid, "bank", p_info[playerid][bank]);

                    p_info[playerid][spawn] = SPAWN_DEFAULT;
                }
                else
                {
                    STRING_GLOBAL[0] = EOS;
                    if(h_info[h][h_paydays_received] == -1) f(STRING_GLOBAL, ""W"� ��� ������� ��� "I"�%d "W"��-�� �������������� �������.\n"W"��� ���������� �� ��� "I"%d$.", h, h_info[h][h_value]/2);
                    else f(STRING_GLOBAL, ""W"� ��� ������� ��� "I"�%d "W"��-�� �� ������ ������ .\n"W"��� ���������� �� ��� "I"%d$.", h, h_info[h][h_value]/2);
                    AddNotify(h_info[h][h_user_id], STRING_GLOBAL);
                    OnServerInfoForMoney[3] += h_info[h][h_value]/2;

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `spawn` = 0, `bank` = `bank` + %d WHERE `id` = %d",
                    h_info[h][h_value]/2, h_info[h][h_user_id]);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                }

                h_info[h][h_user_id] = INVALID_MYSQL_ID;
                h_info[h][h_lock] =
                h_info[h][h_garage_lock] =
                h_info[h][h_attic_lock] =
                h_info[h][h_underground_lock] = 1;
                h_info[h][h_paydays_received] = 0;
                strmid(h_info[h][h_owner], "The State", 0, strlen("The State"), MAX_PLAYER_NAME);

                new family_idx = GetFamilyIDFromHouseID(h);
                if(family_idx != -1)
                {
                    DeleteFamilyVehicle(family_idx);
                    FamilyData[family_idx][fHouseID] = INVALID_HOUSE_ID;
                    h_info[h][h_family_id] = -1;

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `family` SET `house_id` = -1 WHERE `id` = %d",
                        FamilyData[family_idx][fMysqlID]);
                    mysql_tquery (con_bd, STRING_GLOBAL);

                    SendFamilyMessage(family_idx, "��� ����� ������ ��-�� �� ������.");
                }

                h_info[h][h_int] =
                h_info[h][h_improve][SUBSIDY] =
                h_info[h][h_improve][RENTERS] =
                h_info[h][h_improve][BASEMENT] =
                h_info[h][h_improve][UNDERGROUND] = 0;
                h_info[h][h_family_id] = -1;

                for(new i = 0; i < 28; i++) h_info[h][h_garden_items][i] = 0;
                h_info[h][h_panel_items] = 0;
                for(new i = 1; i <= totalgarden; i++)
                {
                    if(GardenInfo[i][gHouseIDx] != h) continue;
                    DestroyGarden(i);
                }
                for(new i = 1; i <= totalpanel; i++)
                {
                    if(PanelHouseInfo[i][PanelHouseIDx] != h) continue;
                    DestroyPanel(i);
                }
                for(new i = 1; i <= totalvideocards; i++)
                {
                    if(VideoCardsInfo[i][vcHouseIDx] != h) continue;
                    DestroyVideoCards(i);
                }
                for(new i = 1; i <= totalundergroundbots; i++)
                {
                    if(UndergroundBotsInfo[i][ubHouseIDx] != h) continue;
                    DestroyUndergroundBots(i);
                }
            }

            for(new i; i <= h_info[h][h_squar]; i++)
            {
                if( h_info[h][h_r_days][i] > 0) h_info[h][h_r_days][i]--;
                if(h_info[h][h_r_days][i] <= 0 && h_info[h][h_r_user_id][i] != INVALID_MYSQL_ID)
                {
                    playerid = GetPlayerUserID(h_info[h][h_r_user_id][i]);
                    if(playerid != INVALID_PLAYER_ID)
                    {
                        p_info[playerid][key_h_rent] = -1;
                        SendInfo(playerid, "� ��� �������� �� ���� ��-�� �� ������ ������.");

                        p_info[playerid][spawn] = SPAWN_DEFAULT;

                        p_info[playerid][h_r_settings][R_GARAGE] =
                        p_info[playerid][h_r_settings][R_BASEMENT] =
                        p_info[playerid][h_r_settings][R_UNDERGROUND] = 0;

                        MysqlUpdatePlayerStr(playerid, "h_r_settings", "0|0|0");
                    }
                    else
                    {
                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, ""W"��� �������� �� ���� "I"�%d "W"��-�� �� ������ ������.", h);
                        AddNotify(h_info[h][h_r_user_id][i], STRING_GLOBAL);

                        STRING_GLOBAL[0] = EOS;
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `spawn` = 0, `h_r_settings` = '0|0|0|0' WHERE `id` = %d",
                        h_info[h][h_r_user_id][i]);
                        mysql_tquery(con_bd, STRING_GLOBAL);
                    }
                    h_info[h][h_r_user_id][i] = INVALID_MYSQL_ID;
                }
            }
            update_house(h);
            save_house(h);
        }
        h_info[h][h_robbery] = 0;
        h_info[h][h_robbery_count] = 10;
    }
}

CheckBizz()
{
    new bool:check_bizz = false,
        playerid;

    for(new b = 0; b < totalbizz; b++)
    {
        if(b_info[b][b_mysql_id] == INVALID_MYSQL_ID) continue;
        if(b_info[b][_tip] == B_OIL_RIG)
        {
            if(b_info[b][b_oil] < MAX_BIZ_OIL)
            {
                b_info[b][b_oil] += RandomEx(MIN_OIL_PRODUCTION, MAX_OIL_PRODUCTION);
                if(b_info[b][b_oil] > MAX_BIZ_OIL) b_info[b][b_oil] = MAX_BIZ_OIL;
                update_bizz(b, 1);
            }
        }
        if(b_info[b][b_mafia] == MAFIA_RM)
        {
            SetFractionWarehouse(MAFIA_RM, fwMoney, gBankMafia[BANK_RM][b]);
            gBankMafia[BANK_RM][b] = 0;
        }
        if(b_info[b][b_mafia] == MAFIA_LCN)
        {
            SetFractionWarehouse(MAFIA_LCN, fwMoney, gBankMafia[BANK_LCN][b]);
            gBankMafia[BANK_LCN][b] = 0;
        }
        if(b_info[b][b_mafia] == MAFIA_YAKUDZA)
        {
            SetFractionWarehouse(MAFIA_YAKUDZA, fwMoney, gBankMafia[BANK_YAKUZA][b]);
            gBankMafia[BANK_YAKUZA][b] = 0;
        }
        if(b_info[b][b_mafia] == BIKER)
        {
            SetFractionWarehouse(BIKER, fwMoney, gBankMafia[BANK_BIKER][b]);
            gBankMafia[BANK_BIKER][b] = 0;
        }
        if(b_info[b][b_mafia] == MAFIA_IRAN)
        {
            SetFractionWarehouse(MAFIA_IRAN, fwMoney, gBankMafia[BANK_IRAN][b]);
            gBankMafia[BANK_IRAN][b] = 0;
        }

        if(b_info[b][b_user_id] != INVALID_MYSQL_ID && b_info[b][b_owned_at]+2629743 < timestamp)
        {
            if(b_info[b][b_paydays_received] >= 5)
            {
                b_info[b][b_owned_at] = timestamp;
                b_info[b][b_paydays_received] = 0;
            }
            else
            {
                if(ServerInfo[OnlineBizzSystem])
                {
                    b_info[b][b_paydays_received] = -1;
                    if(15 <= timestamp_hour <= 22)
                        b_info[b][b_rent] = 0;
                }
                else
                {
                    printf("[TOWB]: bizz_id: %d", b);
                    b_info[b][b_owned_at] = timestamp;
                    b_info[b][b_paydays_received] = 0;
                }
            }
        }

        if(b_info[b][b_auction_bet] > 0)
        {
            if(b_info[b][b_auction_user_id] != INVALID_MYSQL_ID)
            {
                if(b_info[b][b_auction_time] > 0) b_info[b][b_auction_time]--;
                check_bizz = false;
                if(b_info[b][b_auction_time] <= 0)
                { //������ ���������� �������� ������
                    playerid = GetPlayerUserID(b_info[b][b_auction_user_id]);
                    if(playerid != INVALID_PLAYER_ID)
                    {
                        if(GetFreeSlotBizz(playerid) == ALL_BUSY_SLOT_BIZZ) {
                            SendError(playerid, "� ��� ��� ���������� ����� ��� �������.");
                            SendInfo(playerid, "��� ���������� %d$ � ������. ������.", (b_info[b][b_auction_bet]/100)*90);
                            p_info[playerid][bank] += (b_info[b][b_auction_bet]/100)*90;
                            MysqlUpdatePlayerInt(playerid, "bank",  p_info[playerid][bank]);
                            check_bizz = true;
                        }
                        SetFreeSlotBizz(playerid, b);

                        strmid(b_info[b][_owner], get_name(playerid), 0, strlen(get_name(playerid)), MAX_PLAYER_NAME);

                        SendInfo(playerid, "�� �������� �� �������� \"%s\". ������: %d$.", b_info[b][_name], b, b_info[b][b_auction_bet]);
                        //lastlog(BUY_BIZZ_GOS,"������� ������� ��������", b_info[b][b_mysql_id], playerid, playerid, -b_info[b][b_auction_bet]);
                        // [logs] ����������� ��������� ������ �������
                        // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) ����� ����� ������� ������ <%s - %s>(%d)[%d] �� %d$
                        Log(LOG_player, INFO, "%s[%d](%s %s) ����� ����� ������� ������ <%s - %s>(%d)[%d] �� %d$",
                            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                            b_info[b][_name], bizz_type_name[b_info[b][_tip]], b, b_info[b][b_mysql_id], b_info[b][b_auction_bet]);
                    }
                    else
                    {
                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `b_mysql_id` FROM `biz` WHERE `b_user_id` = %d LIMIT 1",
                        b_info[b][b_auction_user_id]);
                        new Cache:result = mysql_query(con_bd, STRING_GLOBAL);

                        if(cache_num_rows() != 0)
                        {
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank` = `bank` + %d WHERE `id` = %d",
                            (b_info[b][b_auction_bet]/100)*90, b_info[b][b_auction_user_id]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                            check_bizz = true;
                        }
                        else
                        {
                            STRING_GLOBAL[0] = EOS;
                            f(STRING_GLOBAL, ""W"�� ��������� ������ "I"�%d "W"�� ��������.", b);
                            AddNotify(b_info[b][b_auction_user_id], STRING_GLOBAL);

                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name` FROM `accounts` WHERE `id` = %d LIMIT 1", b_info[b][b_auction_user_id]);
                            mysql_tquery(con_bd, STRING_GLOBAL, "set_new_owner", "ii", b, 1);

                            //lastlog(FLY_BIZZ_PLAYER,"������� ������� �������� [offline]", b_info[b][b_mysql_id], -1, -1, -b_info[b][b_auction_bet], b_info[b][_owner]);
                        }
                        cache_delete(result);
                    }
                    if(check_bizz == true)
                    {
                        b_info[b][b_auction_bet] /= 2;
                        b_info[b][b_auction_user_id] = INVALID_MYSQL_ID;
                        save_bizz(b);
                        continue;
                    }
                    if(b_info[b][b_user_id] != INVALID_MYSQL_ID)
                    {
                        playerid = GetPlayerUserID(b_info[b][b_user_id]);
                        if(playerid != INVALID_PLAYER_ID)
                        {
                            Log(LOG_player, INFO, "%s[%d](%s %s)[%d$] ������� %d$ �� ������ � �������� ������� %s[%d] | #Auction",
                                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                                p_info[playerid][bank], b_info[b][b_auction_bet]-(b_info[b][b_auction_bet]/10), b_info[b][_name], b_info[b][b_mysql_id]);

                            SendInfo(playerid, "��� ���������� %d$ � ������. ������.", (b_info[b][b_auction_bet]/100)*90);
                            p_info[playerid][bank] += (b_info[b][b_auction_bet]/100)*90;
                            MysqlUpdatePlayerInt(playerid, "bank",  p_info[playerid][bank]);

                            ClearOwnerBizz(playerid, b);
                        }
                        else
                        {
                            Log(LOG_player, INFO, "NickName[%d](Offline) ������� %d$ �� ������ � �������� ������� [%d] | #Auction",
                                b_info[b][b_user_id], (b_info[b][b_auction_bet]/100)*90, b_info[b][b_mysql_id]);

                            STRING_GLOBAL[0] = EOS;
                            f(STRING_GLOBAL, ""W"�� ������� ������ "I"�%d "W"�� ��������, ��� �����: "I"%d$.", b, (b_info[b][b_auction_bet]/100)*90);
                            AddNotify(b_info[b][b_user_id], STRING_GLOBAL);

                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank` = `bank` + %d WHERE `id` = %d",
                            b_info[b][b_auction_bet]-(b_info[b][b_auction_bet]/10), b_info[b][b_user_id]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                        }
                    }
                    b_info[b][b_owned_at] = timestamp;
                    b_info[b][b_paydays_received] = 0;
                    b_info[b][b_user_id] = b_info[b][b_auction_user_id];
                    b_info[b][b_rent] = 24;

                    OnServerInfoForMoney[36] += b_info[b][b_auction_bet];

                    b_info[b][b_auction_bet] = 0;
                    b_info[b][b_auction_user_id] = INVALID_MYSQL_ID;
                    update_bizz(b);
                    save_bizz(b);
                }
            }
        }
        else
        {
            if(b_info[b][b_rent] > 0) b_info[b][b_rent]--;
            if(b_info[b][b_rent] <= 0 && b_info[b][b_user_id] != INVALID_MYSQL_ID)
            {
                SendMesAll(COLOR_LIGHTRED, "��������! "W"������ %d (%d$) ��� ������ ��������. �������: %s.", b, b_info[b][_price], b_info[b][b_paydays_received] == -1 ? "�������������� ������� ���������" : "�������� �������");

                Log(LOG_player, INFO, "%s[%d](Offline) ������ <%s - %s>(%d)[%d] ��� ������ �������� ��-�� %s �� %d$",
                        b_info[b][_owner], b_info[b][b_user_id],
                        b_info[b][_name], bizz_type_name[b_info[b][_tip]], b, b_info[b][b_mysql_id], 
                        b_info[b][b_paydays_received] == -1 ? "�������������� ������� ���������" : "�������� �������", b_info[b][_price]);

                playerid = GetPlayerUserID(b_info[b][b_user_id]);
                if(playerid != INVALID_PLAYER_ID)
                {
                    ClearOwnerBizz(playerid, b);
                    SendInfo(playerid, "� ��� ������� ������ ��-�� %s.", b_info[b][b_paydays_received] == -1 ? "�������������� �������" : "�� ������ ������");
                    SendInfo(playerid, "�������� �������� �� ������ ��������� �� ���������� ����.");
                    OnServerInfoForMoney[5] += (b_info[b][_price]/2) + b_info[b][_bank];
                    p_info[playerid][bank] += (b_info[b][_price]/2) + b_info[b][_bank];
                    MysqlUpdatePlayerInt(playerid, "bank", p_info[playerid][bank]);

                    switch(b_info[b][_tip])
                    {
                        case B_TAXI:
                        {
                            p_info[playerid][taxi_rank] = 0;
                            p_info[playerid][taxi_idx] = 0;
                            p_info[playerid][taxi_percent] = 0;
                            p_info[playerid][taxi_salary] = 0;
                            p_info[playerid][taxi_salary_all] = 0;
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `taxi` = 0, `taxi_rank` = 0, `taxi_idx` = 0, `taxi_percent` = 0, `taxi_salary` = 0, `taxi_salary_all` = 0 WHERE `id` = %d",
                            p_info[playerid][ID]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                        }
                        case B_TRUCKER:
                        {
                            p_info[playerid][tc_rank] = 0;
                            p_info[playerid][tc_idx] = 0;
                            p_info[playerid][tc_percent] = 0;
                            p_info[playerid][tc_salary] = 0;
                            p_info[playerid][tc_salary_all] = 0;
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `tc` = 0, `tc_rank` = 0, `tc_idx` = 0, `tc_percent` = 0, `tc_salary` = 0, `tc_salary_all` = 0 WHERE `id` = %d",
                            p_info[playerid][ID]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                        }
                    }
                }
                else
                {
                    STRING_GLOBAL[0] = EOS;
                    if(b_info[b][b_paydays_received] == -1) f(STRING_GLOBAL, ""W"� ��� ������� ������ "I"�%d "W"��-�� �������������� �������.", b);
                    else f(STRING_GLOBAL, ""W"� ��� ������� ������ "I"�%d "W"��-�� �� ������ ������.", b);
                    AddNotify(b_info[b][b_user_id], STRING_GLOBAL);
                    OnServerInfoForMoney[5] += (b_info[b][_price] / 2) + b_info[b][_bank];

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank` = `bank` + %d WHERE `id` = %d",
                    (b_info[b][_price] / 2) + b_info[b][_bank], b_info[b][b_user_id]);
                    mysql_tquery(con_bd, STRING_GLOBAL);

                    switch(b_info[b][_tip])
                    {
                        case B_TAXI:
                        {
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `taxi` = 0, `taxi_rank` = 0, `taxi_idx` = 0, `taxi_percent` = 0, `taxi_salary` = 0, `taxi_salary_all` = 0 WHERE `id` = %d",
                            b_info[b][b_user_id]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                        }
                        case B_TRUCKER:
                        {
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `tc` = 0, `tc_rank` = 0, `tc_idx` = 0, `tc_percent` = 0, `tc_salary` = 0, `tc_salary_all` = 0 WHERE `id` = %d",
                            b_info[b][b_user_id]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                        }
                    }
                }
                b_info[b][b_owned_at] =
                b_info[b][b_paydays_received] = 0;
                b_info[b][b_user_id] = INVALID_MYSQL_ID;
                b_info[b][b_rent] = 0;
                b_info[b][b_order] = 0;
                b_info[b][b_order_player_id] = INVALID_PLAYER_ID;
                strmid(b_info[b][_owner], "State", 0, strlen("State"), 255);
                save_bizz(b);
                update_bizz(b);
            }
        }
    }
}

CheckVehicle()
{
    foreach(new v: Vehicle)
    {
        CheckVehicleInsurance(v);

        if(veh_info[v][v_bonus] != 0)
        {
            if(veh_info[v][v_bonus] < timestamp)
            {
                veh_info[v][v_bonus] = 0;

                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `vehicle` WHERE `v_mysql_id` = %d",
                    veh_info[v][v_mysql_id]);
                mysql_tquery(con_bd, STRING_GLOBAL);

                ClearInventoryItems(veh_info[v][v_mysql_id], INVENTORY_OWNER_TYPE_VEHICLE);

                new playerid = GetPlayerUserID(veh_info[v][v_owner_id]);
                if(playerid != INVALID_PLAYER_ID)
                {
                    if(p_info[playerid][active_vehicle_id] == v) p_info[playerid][active_vehicle_id] = 0;
                    SendInfo(playerid, "����� ������������� ������������� �������� �����������.");
                    Log(LOG_player, INFO, "%s[%d](%s %s) ������ �������� �/� <%s>(%d)[%d]",
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                        GetVehicleName(v), veh_info[v][v_model], veh_info[v][v_mysql_id]);
                }
                else
                {
                    AddNotify(veh_info[v][v_owner_id], "����� ������������� ��������� ������������� �������� �����������.");
                    Log(LOG_player, INFO, "Offline[%d](127.0.0.1 127.0.0.1) ������ �������� �/� <%s>(%d)[%d]",
                        veh_info[v][v_owner_id], GetVehicleName(v), veh_info[v][v_model], veh_info[v][v_mysql_id]);
                }
                veh_info[v][v_lock] = 0;
                DestroyVehicleVEx(v);
            }
            else SaveVehicle(v);
        }
    }
}

CheckHotel()
{
    new playerid;
    for(new i = totalbizz-1; i != -1; i--)
    {
        if(b_info[i][b_mysql_id] == INVALID_MYSQL_ID) continue;
        //_tip
        new biz_id = b_info[i][b_mysql_id];
        for(new idx = 0; idx < MAX_HOTEL_ROOMS; idx++)
        {
            if(hotel_rooms_info[biz_id][idx][hr_rent] > 0) hotel_rooms_info[biz_id][idx][hr_rent]--;
            if(hotel_rooms_info[biz_id][idx][hr_rent] <= 0 && hotel_rooms_info[biz_id][idx][hr_user_id] != INVALID_MYSQL_ID)
            {
                //lastlog(FLY_HOTEL_PLAYER, "��������� �� ����� ��������, �� ������!", -1, -1, -1, -1, hotel_rooms_info[biz_id][idx][hr_owner]);
                // [logs] ����������� ��������� ������ �������
                Log(LOG_player, INFO, "%s[%d](Offline) ��� ������� �������� ��-�� �������� ������� �� ������ %d ����� %d",
                    hotel_rooms_info[biz_id][idx][hr_owner], hotel_rooms_info[biz_id][idx][hr_user_id],
                    idx, biz_id);

                playerid = GetPlayerUserID(hotel_rooms_info[biz_id][idx][hr_user_id]);
                if(playerid != INVALID_PLAYER_ID)
                {
                    p_info[playerid][key_hotel] = -1;
                    p_info[playerid][key_hotel_room] = -1;
                    SendInfo(playerid, "��� �������� �� ����� ��-�� �� ������ ������.");

                    p_info[playerid][spawn] = SPAWN_DEFAULT;
                }
                else
                {
                    AddNotify(hotel_rooms_info[biz_id][idx][hr_user_id], "��� �������� �� ����� ��-�� �� ������ ������.");

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `spawn` = 0 WHERE `id` = %d",
                    hotel_rooms_info[biz_id][idx][hr_user_id]);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                }

                strmid(hotel_rooms_info[biz_id][idx][hr_owner], "None", 0, strlen("None"), MAX_PLAYER_NAME);
                hotel_rooms_info[biz_id][idx][hr_user_id] = 0;
                hotel_rooms_info[biz_id][idx][hr_rent] = 24;

                DestroyDynamicPickup(hotel_rooms_info[biz_id][idx][hr_pickup]);
                hotel_rooms_info[biz_id][idx][hr_pickup] = CreateDynamicPickup(((hotel_rooms_info[biz_id][idx][hr_user_id] == 0) ? 1273 : 1272), 23, hotel_rooms_pos[idx][0], hotel_rooms_pos[idx][1], hotel_rooms_pos[idx][2], b_info[biz_id][_world]);
                UpdatePickupInfo(hotel_rooms_info[biz_id][idx][hr_pickup], TYPE_BUSINESS, PICKUP_SUBTYPE_BUSINESS_HOTEL, biz_id);

                save_hotel_rooms(biz_id, idx);
            }
        }
    }
}

forward set_new_owner(id, type);
public set_new_owner(id, type)
{
    new rows, nickname[MAX_PLAYER_NAME];
    cache_get_row_count(rows);
    if(!rows) return 1;
    cache_get_value_name(0, "name", nickname, MAX_PLAYER_NAME);
    if(type == 0)
    {
        strmid(h_info[id][h_owner], nickname, 0, strlen(nickname), MAX_PLAYER_NAME);
        // [logs] ����������� ��������� ������ �������
        // Jeffrey_Collinz[2](Offline) ����� �� �������� ��� (%d)[%d] �� %d$
        Log(LOG_player, INFO, "%s[%d](Offline) ����� �� �������� ��� (%d)[%d] �� %d$",
            nickname, h_info[id][h_auction_user_id], id, h_info[id][h_mysql_id], h_info[id][h_auction_bet]);
    }
    else
    {
        strmid(b_info[id][_owner], nickname, 0, strlen(nickname), MAX_PLAYER_NAME);
        // Jeffrey_Collinz[2](Offline) ����� �� �������� ������ <%s - %s>(%d)[%d] �� %d$
        Log(LOG_player, INFO, "%s[%d](Offline) ����� �� �������� ������ <%s - %s>(%d)[%d] �� %d$",
            nickname, b_info[id][b_auction_user_id], b_info[id][_name], bizz_type_name[b_info[id][_tip]],
            id, b_info[id][b_mysql_id], b_info[id][b_auction_bet]);
    }
    return 1;
}

forward OnPlayerSelectLogs(playerid, TYPE_LOG);
public  OnPlayerSelectLogs(playerid, TYPE_LOG)
{
    new rows;
    cache_get_row_count(rows);
    if(!rows) return SendError(playerid, "������ �� �������.");

    if(rows)
    {
        new CountLog = 0,
            PlayerName[MAX_PLAYER_NAME],
            NickTarget[MAX_PLAYER_NAME],
            TimeName[MAX_PLAYER_NAME + 6],
            ReasonName[MAX_PLAYER_NAME * 3];

        STRING_GLOBAL[0] = EOS;
        STRING_GLOBAL = "���������� �� �������:\n\n";
        for(new i; i != rows; i++)
        {
            cache_get_value_name(i, "ADMIN", NickTarget, MAX_PLAYER_NAME);
            cache_get_value_name(i, "PLAYER", PlayerName, MAX_PLAYER_NAME);
            cache_get_value_name(i, "REASON", ReasonName, MAX_PLAYER_NAME * 3);
            cache_get_value_name(i, "DATA", TimeName, MAX_PLAYER_NAME + 6);

            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d] "W"[%s] %s %s %s. �������: %s\n", STRING_GLOBAL, CountLog + 1, TimeName, NameTypeHistoryPunishment[TYPE_LOG-1], NickTarget, PlayerName, ReasonName);
            CountLog++;
        }

        if(CountLog == 0) return SendError(playerid, "������ �� �������.");
        ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_LIST, ""I"������", STRING_GLOBAL, "�������", "");
    }
    return 1;
}

GetRangDuel(playerid)
{
    new duelid = p_temp[playerid][DuelID];
    if(duelid == INVALID_PLAYER_ID) return DUEL_RANK_NONE;
    if(DuelData[duelid][dCommand1][0] == playerid && DuelData[duelid][dCommand2][0] != playerid)
        return DUEL_RANK_OWNER_1;
    if(DuelData[duelid][dCommand1][0] != playerid && DuelData[duelid][dCommand2][0] == playerid)
        return DUEL_RANK_OWNER_2;
    for(new i; i < 10; i++)
    {
        if(DuelData[duelid][dCommand1][i] == playerid) return DUEL_RANK_MEMBER_1;
        if(DuelData[duelid][dCommand2][i] == playerid) return DUEL_RANK_MEMBER_2;
    }
    return DUEL_RANK_NONE;
}

OnServerShowDialogDuelMenu(playerid)
{
    if(playerid == INVALID_PLAYER_ID) return 1;
    if(p_info[playerid][level] < 2) return SendError(playerid, "� ��� ��� 2-��� ������.");

    new rang_duel = GetRangDuel(playerid),
        duel_id = p_temp[playerid][DuelID],
        duel_name_map[][] = {"���������", "Snow", "Inferno", "Desert", "Wahehouse"};

    if(rang_duel == DUEL_RANK_NONE)
        return ShowPlayerDialog(playerid, D_DUEL_PLAYER, DIALOG_STYLE_INPUT, ""I"�����", ""W"�� ������ ������� �����? ���� ��, ������� "I"ID "W"����������:", "��", "������");

    if(rang_duel == DUEL_RANK_MEMBER_1 || rang_duel == DUEL_RANK_MEMBER_2)
    {
        ShowPlayerDialog(playerid, D_DUEL_CANCEL, DIALOG_STYLE_MSGBOX, ""I"�����", "�� ������ �������� �����?", "��", "������");
        return SendError(playerid, "�� ���������������� ��� ���� �� ���������� �������.");
    }
    if(rang_duel == DUEL_RANK_OWNER_1)
    {
        if(duel_id == INVALID_PLAYER_ID) return 1;
        if(DuelData[duel_id][dCommand2][0] == INVALID_PLAYER_ID) return 1;
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL),
        ""I"[1]"W" �������� ������\t"I"%d\n\
        "I"[1]"W" ������� ������\t"I"%s\n\
        "I"[2]"W" ���������� �������\t"I"%d\n\
        "I"[3]"W" �����\t"I"%s\n\
        "I"[4]"W" �������� ����������\t \n\
        "I"[5]"W" ���������� ������ �����\t"I"%s\n\
        "I"[6]"W" ������� �����\t \n\
        "I"[7]"W" ����� �����\t"I"%s",
        DuelData[duel_id][dBank],
        WEAPON_Name[DuelData[duel_id][dGun]],
        DuelData[duel_id][dRound],
        duel_name_map[DuelData[duel_id][dMap]],
        get_name(DuelData[duel_id][dCommand2][0]),
        DuelData[duel_id][dFamilyStatus] == 0 ? "[-]" : "[+]");
        ShowPlayerDialog(playerid, D_DUEL_MENU, DIALOG_STYLE_TABLIST, ""I"���� �����", STRING_GLOBAL, "�������", "������");
    }
    if(rang_duel == DUEL_RANK_OWNER_2)
    {
        if(duel_id == INVALID_PLAYER_ID) return 1;
        if(DuelData[duel_id][dCommand1][0] == INVALID_PLAYER_ID) return 1;
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL),
        ""I"[1]"W" �������� ������\t"I"%d\n\
        "I"[1]"W" ������� ������\t"I"%s\n\
        "I"[2]"W" ���������� �������\t"I"%d\n\
        "I"[3]"W" �����\t"I"%s\n\
        "I"[4]"W" �������� ����������\t \n\
        "I"[5]"W" ���������� ������ �����\t"I"%s\n\
        "I"[6]"W" ������� �����\t \n\
        "I"[7]"W" ����� �����\t"I"%s",
        DuelData[duel_id][dBank],
        WEAPON_Name[DuelData[duel_id][dGun]],
        DuelData[duel_id][dRound],
        duel_name_map[DuelData[duel_id][dMap]],
        get_name(DuelData[duel_id][dCommand1][0]),
        DuelData[duel_id][dFamilyStatus] == 0 ? "[-]" : "[+]");
        ShowPlayerDialog(playerid, D_DUEL_MENU, DIALOG_STYLE_LIST, ""I"���� �����", STRING_GLOBAL, "�������", "������");
    }
    return 1;
}

/////////////////////////////////////////////////////////////////////////////
CMD:boot(playerid, params[])
{
    if(IsTDVisible(playerid) != -1) return 1;
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT)
        return 1;

    new Float:CarPos[3];
    foreach(new v: PlayerVehiclesStream[playerid])
    {
        if(GetVehicleData(GetVehicleModelEx(v), E_VD_TYPE) !=  VEHICLE_STATE_CAR)
            continue;
        //if(veh_info[v][v_mysql_id] == 0 && veh_info[v][v_family_id] == -1)
        //    continue;
        if(GetSlotVehicleMarket(veh_info[v][v_mysql_id]) != -1) continue;
        if(!IsPlayerOwnerVehicle(playerid, v) &&
            veh_info[v][v_used_key_ID] != p_info[playerid][ID]) continue;
        GetCoordBootVehicle(v, CarPos[0],CarPos[1],CarPos[2]);
        if(!IsPlayerInRangeOfPoint(playerid,2.5,CarPos[0],CarPos[1],CarPos[2]))
            continue;

        /*
        if(veh_info[v][v_inventory_use] != INVALID_PLAYER_ID)
            return SendError(playerid, "� ���������� ��� ���������������.");
        veh_info[v][v_inventory_use] = playerid;
        */

        SetPVarInt(playerid, #VEHICLEID_BOOT, v);
        ShowTextDrawForPlayer(playerid, TD_ID_INVENTORY_OTHER);
        Interface_Show(playerid, EQUIPMENT_INVENTORY_BOOT);
        break;
    }
    return 1;
}
alias:boot("invcar", "invveh", "invvehicle");

GetCoordBootVehicle(vehicleid, &Float:x, &Float:y, &Float:z) // ������� ��� ���������� ��������� ���������
{
    new Float:angle,Float:distance;
    GetVehicleModelInfo(GetVehicleModelEx(vehicleid), 1, x, distance, z);
    distance = distance/2 + 0.1;
    GetVehiclePos(vehicleid, x, y, z);
    GetVehicleZAngle(vehicleid, angle);
    x += (distance * floatsin(-angle+180, degrees));
    y += (distance * floatcos(-angle+180, degrees));
    return 1;
}

