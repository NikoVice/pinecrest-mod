            if(strval(inputtext) < 0 || strval(inputtext) > 999999) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_PASSWORD, DIALOG_STYLE_INPUT, ""I"������", ""W"������� ������ �� 0 �� 999999:", "�����", "������"), SendError(playerid, "������ ������ ���� �� ����� 0 � �� ����� 999999.");
            player_lobby_settings[playerid][6] = strval(inputtext);
            ShowLobbyCreate(playerid);
            return 1;
