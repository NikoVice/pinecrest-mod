            {
                SendInfo(i, "Время на ограбление АЗС вышло, уходите!");
            }
        }
        if(p_temp[i][Work_ID] == MECHANIC_WORK)
        {
            if(p_temp[i][mechanic_idx] == 0 && p_temp[i][mechanic_timer] > 0)
            {
                p_temp[i][mechanic_timer]--;
                if(p_temp[i][mechanic_timer] == 0)
                {
                    if(player_state == PLAYER_STATE_DRIVER && p_temp[i][rented_veh] != INVALID_VEHICLE_ID)
                    {
                        if(veh_info[p_temp[i][rented_veh]][v_npoId] == JOB_MECHANIC || veh_info[p_temp[i][rented_veh]][v_temp_job] == JOB_MECHANIC)
                        {
                            if(IsPlayerRentedVehicle(i, GetPlayerVehicleID(i))) CreateMechanic(i);
                        }
                    }
                    else p_temp[i][mechanic_timer] = 30;
                }
            }
            else if(p_temp[i][mechanic_idx] > 0 && p_temp[i][mechanic_timer] > 0)
            {
                p_temp[i][mechanic_timer]--;
                if(p_temp[i][mechanic_timer] == 0)
                {
                    SendMes(i, COLOR_DARKORANGE, "Вы не успели закрыть заказ. Ожидайте нового вызова.");
                    DestroyMechanic(i);
                    p_temp[i][mechanic_idx] = 0;
                    p_temp[i][mechanic_timer] = RandomEx(30, 60);
                    DisablePlayerRaceCheckpoint(i);
                }
            }
            if(p_temp[i][mechanic_idx] > 0 && GetPlayerState(i) == PLAYER_STATE_ONFOOT && GetPlayerWeapon(i) == 42)
            {
                new idx = p_temp[i][mechanic_idx] - 1;
                if(IsPlayerInRangeOfPoint(i, 5.0, MechanicsBots[idx][mVehiclePos][0], MechanicsBots[idx][mVehiclePos][1], MechanicsBots[idx][mVehiclePos][2]))
                {
                    new slot = WEAPON_Slot[GetPlayerWeapon(i)];
                    GetPlayerWeaponData(i, 9, p_info[i][Weapon][slot], p_info[i][Ammo][slot]);
                    if(p_info[i][Ammo][slot] < p_temp[i][mechanic_ammo])
                    {
                        if(AntiCheatWarningTime[i][0] > timestamp) SendError(i, "Вы не можете доставлять заказы так часто, подождите.");
                        else
                        {
                            p_temp[i][mechanic_exting_count]++;
                            p_temp[i][mechanic_ammo] = p_info[i][Ammo][slot];
                        }
                    }
                    if(p_temp[i][mechanic_ammo] < 500)
                    {
                        f_GivePlayerWeapon(i, 42, 9999 - p_temp[i][mechanic_ammo]);
                        p_temp[i][mechanic_ammo] = 9999;
                    }
                    if(p_temp[i][mechanic_exting_count] == 5)
                    {
                        p_temp[i][mechanic_exting_count] = 0;
                        SendMes(i, COLOR_BLUE, "Вы ликвидировали источник возгорания.");
                        new salary = p_temp[i][mechanic_salary], reason_money = GetPlayerMoneySkill(i, salary, 11);

                        new vehicleid = p_temp[i][rented_veh], vehicle_salary;
                        if(vehicleid != INVALID_VEHICLE_ID && veh_info[vehicleid][v_temp_job] == JOB_MECHANIC)
                        {
                            vehicle_salary = (reason_money / 100) * 20;
                            reason_money += vehicle_salary;
                        }

                        if(CheckPlayerMaxSalarySkill(i, 11, reason_money))
                        {
                            SetPlayerMoney(i, reason_money, false, "зарплата автомеханик");
                            OnServerInfoForMoney[17] += reason_money;
                            SendMes(i, COLOR_LYELLOW, "К Вашей зарплате добавлено: {"#cLIME"}%d$.", reason_money);
                            if(vehicle_salary) SendMes(i, COLOR_LIME, "За работу на личном транспортном средстве к заработной плате добавлено: {"#cLYELLOW"}%d$.", vehicle_salary);

                            p_info[i][job_skill_salary][11] += reason_money;
                        }
                        else SendError(i, "За последний час игры было заработано максимальное количество денежных средств.");

                        if(GetPlayerGiveCasket(100, 5) != -1) GivePlayerCasket(i, -1);
                        UpdatePlayerWorkSkill(i, 11);
                        DestroyMechanic(i);
                        p_temp[i][mechanic_idx] = 0;
                        p_temp[i][mechanic_timer] = RandomEx(30, 60);
                        SendMes(i, COLOR_SEA_WAVE, "Ожидайте новый вызов.");

                        CheckPlayerMission(i, START_MECHANIC);
                        CheckPlayerMission(i, DAILY_MECHANIC);
                        CheckPlayerMission(i, ACHIEVEMENT_MECHANIC);

                        CheckPlayerFreelance(i, FREELANCE_MECHANIC);
                        CheckPlayerBattlePass(i, BATTLEPASS_MECHANIC);

                        UpdateFamilyLevel(i);
                        UpdateFamilyContract(i, CONTRACT_FAMILY_ID_MECHANIC); // Контракты: Механик
                    }
                }
            }
        }
        if(p_temp[i][Work_ID] == TAXI_WORK)
        {
            if(p_temp[i][taxi_bots_idx] == 0 && p_temp[i][taxi_bots_timer] > 0)
            {
                p_temp[i][taxi_bots_timer]--;
                if(p_temp[i][taxi_bots_timer] == 0)
                {
                    if(player_state == PLAYER_STATE_DRIVER && p_temp[i][rented_veh] != INVALID_VEHICLE_ID)
                    {
                        if(veh_info[p_temp[i][rented_veh]][v_npoId] == JOB_TC_TAXI)
                        {
                            if(IsPlayerRentedVehicle(i, GetPlayerVehicleID(i))) CreateTaxi(i);
                        }
                    }
                    else p_temp[i][taxi_bots_timer] = 30;
                }
            }
            else
            {
                p_temp[i][taxi_bots_timer]--;
                if(p_temp[i][taxi_bots_timer] == 0)
                {
                    SendMes(i, COLOR_DARKORANGE, "Вы не успели закрыть заказ. Ожидайте нового вызова.");
                    DestroyTaxi(i);
                    p_temp[i][taxi_bots_idx] = 0;
                    p_temp[i][taxi_bots_timer] = RandomEx(30, 60);
                    DisablePlayerRaceCheckpoint(i);
                }
            }
        }
        if(p_temp[i][Work_ID] == FIREMAN_WORK)
        {
            if(p_temp[i][FireStatus] == 0 && p_temp[i][FireTimer] > 0)
            {
                p_temp[i][FireTimer]--;
                if(p_temp[i][FireTimer] == 0)
                {
                    if(player_state == PLAYER_STATE_DRIVER && p_temp[i][rented_veh] != INVALID_VEHICLE_ID)
                    {
                        if(veh_info[p_temp[i][rented_veh]][v_npoId] == JOB_FIREMAN || veh_info[p_temp[i][rented_veh]][v_temp_job] == JOB_FIREMAN)
                        {
                            if(IsPlayerRentedVehicle(i, GetPlayerVehicleID(i))) CreateFire(i);
                        }
                    }
                    else p_temp[i][FireTimer] = 30;
                }
            }
            else if(p_temp[i][FireStatus] > 0 && p_temp[i][FireTimer] > 0)
            {
                p_temp[i][FireTimer]--;
                if(p_temp[i][FireTimer] == 0)
                {
                    SendMes(i, COLOR_DARKORANGE, "Вы не успели потушить пожар. Ожидайте нового вызова.");
                    DestroyFire(i);
                    p_temp[i][FireStatus] = 0;
                    p_temp[i][FireTimer] = 60 + random(60);
                }
            }
            if(p_temp[i][FireStatus] > 0 && player_state == PLAYER_STATE_ONFOOT && GetPlayerWeapon(i) == 42)
            {
                new idx = p_temp[i][FireStatus] - 1;
                for(new x = 0; x < 5; x++)
                {
                    if(FireInfo[idx][fObject][x] == -1) continue;
                    if(IsPlayerInRangeOfPoint(i, 2.5, FireInfo[idx][fPos][x * 3 + 0], FireInfo[idx][fPos][x * 3 + 1], FireInfo[idx][fPos][x * 3 + 2]))
                    {
                        if(p_temp[i][FireExting] != x)
                        {
                            p_temp[i][FireExting] = x;
                            p_temp[i][FireExtingCount] = 0;
                            continue;
                        }
                        new slot = WEAPON_Slot[GetPlayerWeapon(i)];
                        GetPlayerWeaponData(i, 9, p_info[i][Weapon][slot], p_info[i][Ammo][slot]);
                        if(p_info[i][Ammo][slot] < p_temp[i][FireAmmo])
                        {
                            p_temp[i][FireExtingCount]++;
                            p_temp[i][FireAmmo] = p_info[i][Ammo][slot];
                        }
                        if(p_temp[i][FireAmmo] < 500)
                        {
                            f_GivePlayerWeapon(i, 42, 9999 - p_temp[i][FireAmmo]);
                            p_temp[i][FireAmmo] = 9999;
                        }
                        if(p_temp[i][FireExtingCount] == 5)
                        {
                            p_temp[i][FireExtingCount] = 0;
                            if(FireInfo[idx][fObject][x] != -1) DestroyDynamicObject(FireInfo[idx][fObject][x]);
                            FireInfo[idx][fObject][x] = -1;
                            SendMes(i, COLOR_BLUE, "Вы потушили один из источников возгорания.");
                            new reason_money = GetPlayerMoneySkill(i, 850, 14);

                            new vehicleid = p_temp[i][rented_veh], vehicle_salary;
                            if(vehicleid != INVALID_VEHICLE_ID && veh_info[vehicleid][v_temp_job] == JOB_FIREMAN)
                            {
                                vehicle_salary = (reason_money / 100) * 20;
                                reason_money += vehicle_salary;
                            }

                            if(CheckPlayerMaxSalarySkill(i, 14, reason_money))
                            {
                                SetPlayerMoney(i, reason_money, false, "зарплата пожарника");
                                OnServerInfoForMoney[17] += reason_money;
                                SendMes(i, COLOR_LYELLOW, "К Вашей зарплате добавлено: {"#cLIME"}%d$.", reason_money);
                                if(vehicle_salary) SendMes(i, COLOR_LIME, "За работу на личном транспортном средстве к заработной плате добавлено: {"#cLYELLOW"}%d$.", vehicle_salary);

                                p_info[i][job_skill_salary][14] += reason_money;
                            }
                            else SendError(i, "За последний час игры было заработано максимальное количество денежных средств.");
                            if(GetPlayerGiveCasket(200, 5) != -1) GivePlayerCasket(i, -1);
                            new checkfires;
                            for(new c = 0; c < 5; c++) if(FireInfo[idx][fObject][c] != -1) checkfires++;
                            if(checkfires == 0)
                            {
                                UpdatePlayerWorkSkill(i, 14);
                                FireInfo[idx][fStatus] = 0;
                                p_temp[i][FireStatus] = 0;
                                p_temp[i][FireTimer] = RandomEx(30, 60);
                                SendMes(i, COLOR_BLUE, "Пожар на одном из предприятий в районе "W"\"%s\"{"#cBLUE"} был потушен.", FireInfo[idx][fCity]);
                                SendMes(i, COLOR_SEA_WAVE, "Ожидайте новый вызов.");

                                CheckPlayerMission(i, START_FIREMAN);
                                CheckPlayerMission(i, DAILY_FIREMAN);
                                CheckPlayerMission(i, ACHIEVEMENT_FIREMAN);

                                CheckPlayerFreelance(i, FREELANCE_FIREMAN);
                                CheckPlayerBattlePass(i, BATTLEPASS_FIREMAN);

                                UpdateFamilyLevel(i);
                                UpdateFamilyContract(i, CONTRACT_FAMILY_ID_FIRE); // Контракты: Пожарный
                            }
                        }
                        break;
                    }
                }
            }
        }
        if(p_temp[i][Work_ID] == SPACE_WORK)
        {
            if(p_temp[i][SpaceIDx] == 0 && p_temp[i][SpaceTimer] > 0)
            {
                p_temp[i][SpaceTimer]--;
                if(p_temp[i][SpaceTimer] == 0) CreateSpaceFossils(i);
            }
            else if(p_temp[i][SpaceIDx] > 0 && p_temp[i][SpaceTimer] > 0)
            {
                p_temp[i][SpaceTimer]--;
                if(p_temp[i][SpaceTimer] == 0)
                {
                    SendMes(i, COLOR_DARKORANGE, "Вы не успели добыть ископаемые. Ожидайте нового вызова.");
                    DestroySpaceFossils(i);
                    p_temp[i][SpaceIDx] = 0;
                    p_temp[i][SpaceTimer] = 15 + random(15);
                    DisablePlayerCheckpoint(i);
                }
            }
        }
        if(p_temp[i][SpaceFlightStatus] == true)
        {
            if(p_temp[i][SpaceFlightCheck] != 0 && p_temp[i][SpaceFlightTimer] > 0)
            {
                p_temp[i][SpaceFlightTimer]--;
                new str[64];
                format(str, sizeof(str), "~w~TIME: ~y~%02d:%02d", p_temp[i][SpaceFlightTimer] / 60, p_temp[i][SpaceFlightTimer] - ((p_temp[i][SpaceFlightTimer] / 60) * 60));
                GameTextForPlayer(i, str, 1000, 3);
                if(p_temp[i][SpaceFlightTimer] == 0)
                {
                    if(p_temp[i][SpaceFlightCheck] == 1)
                    {
                        SetPlayerPos(i, 800.1113+random(2),1353.6876+random(2),1058.5195);
                        SetPlayerFacingAngle(i, 93.6355);
                        SetPlayerInterior(i, 1);
                        SetPlayerVirtualWorld(i, 1);
                        SetPlayerTime(i, 20, 0);
                        SetPlayerWeather(i, 45);
                        p_temp[i][BeingInSpace] = true;
                        SendAccess(i, "Вы прилетели в космос.");
                    }
                    else if(p_temp[i][SpaceFlightCheck] == 2)
                    {
                        SetPlayerPos(i, 1072.1250+random(2),1061.1973+random(2),10.2734);
                        SetPlayerFacingAngle(i, 128.4157);
                        SetPlayerInterior(i, 0);
                        SetPlayerVirtualWorld(i, 0);
                        SetPlayerTime(i, timestamp_hour, 0);
                        SetPlayerWeather(i, Default_Weather);
                        p_temp[i][BeingInSpace] = false;
                        SetPlayerSkinEx(i);
                        RemovePlayerSpaceCostume(i);
                        SendAccess(i, "Вы прилетели на землю.");
                    }
                    p_temp[i][SpaceFlightStatus] = false;
                    p_temp[i][SpaceFlightType] = 0;
                    p_temp[i][SpaceFlightCheck] = 0;
                    p_temp[i][SpaceFlightTimer] = 0;
                }
            }
        }
        if(gang(i) && player_state == PLAYER_STATE_ONFOOT && GetPlayerVirtualWorld(i) == 0 && GetPlayerWeapon(i) == 41)
        {
            new gid = p_temp[i][GraffitiID];
            if(gid != -1 && IsPlayerInDynamicArea(i, GraffitiInfo[gid][gArea]))
            {
                new fGun, fAmmo;
                GetPlayerWeaponData(i, 9, fGun, fAmmo);
                if(fAmmo < p_temp[i][GraffitiAmmo])
                {
                    p_temp[i][GraffitiExtingCount]++;
                    p_temp[i][GraffitiAmmo] = fAmmo;
                }
                if(p_temp[i][GraffitiExtingCount] >= 5)
                {
                    if(GraffitiInfo[gid][gMember] == p_info[i][member]) return SendError(i, "Ты перепутал граффити, это уже принадлежит твоим братьям.");
                    if(GraffitiInfo[gid][gTime] > timestamp) return SendError(i, "Краска совсем свежая, перекрасить пока не удастся.");

                    new member_idx[2];
                    member_idx[0] = GraffitiInfo[gid][gMember];
                    member_idx[1] = p_info[i][member];

                    SetGangGraffiti(member_idx[0], -1);
                    GraffitiInfo[gid][gMember] = member_idx[1];

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `graffiti` SET `member` = %d WHERE `id` = %d", member_idx[1], GraffitiInfo[gid][gID]);
                    mysql_tquery(con_bd, STRING_GLOBAL);

                    GraffitiInfo[gid][gTime] = timestamp + 900;
                    SetGangGraffiti(member_idx[1], 1);

                    UpdateInfoFractionWarehouse(member_idx[0]);
                    UpdateInfoFractionWarehouse(member_idx[1]);

                    SendFractionMessage(member_idx[0], 0x33CC66FF, "[F] Люди сообщают, что одно из Ваших граффити перекрасили конкуренты.");

                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] закрасил граффити, люди вынуждены уважать Вас.", get_name(i), i);
                    SendFractionMessage(member_idx[1], 0x33CC66FF, STRING_GLOBAL);

                    SendAccess(i, "Ты заработал уважение для себя и своей банды! Теперь Вы владеете %d граффити.", GetGangGraffiti(member_idx[1]));

                    new money = RandomEx(250, 500);
                    SendInfo(i, "В награду ты получаешь %d$.", money);
                    SetPlayerMoney(i, money, true, "закраска граффити");
                    OnServerInfoForMoney[27] += money;

                    CheckPlayerMission(i, GANG_PGRAFFITI);

                    if(GraffitiInfo[gid][gObject] != 0) DestroyDynamicObject(GraffitiInfo[gid][gObject]);
                    GraffitiInfo[gid][gObject] = CreateDynamicObject(GraffitiObject[GraffitiInfo[gid][gMember]-10], GraffitiInfo[gid][gX], GraffitiInfo[gid][gY], GraffitiInfo[gid][gZ], GraffitiInfo[gid][grX], GraffitiInfo[gid][grY], GraffitiInfo[gid][grZ]);

                    p_temp[i][GraffitiID] = -1;
                    p_temp[i][GraffitiExtingCount] = 0;
                    p_temp[i][GraffitiAmmo] = 0;
                }
            }
        }
        if(p_info[i][d_demolition] > 0 && player_state == PLAYER_STATE_ONFOOT)
        {
            if(random(2) == 1)
            {
                ApplyAnimation(i, "CRACK", "crckdeth1", 4.0, 0,0,0,0,0,1);
                ApplyAnimation(i, "CRACK", "crckdeth1", 4.0, 1,1,1,1,1,1);
            }
            else
            {
                ApplyAnimation(i, "CRACK", "crckdeth3", 4.0, 0,0,0,0,0,1);
                ApplyAnimation(i, "CRACK", "crckdeth3", 4.0, 1,1,1,1,1,1);
            }
        }
        if(timestamp_minute%25 == 0 && timestamp_second == 0) p_info[i][d_start_addiction] = 1;
        if(p_temp[i][DuelID] == INVALID_PLAYER_ID && RegisterPaintBall[i] != 2 && p_temp[i][cossack_robbers_register] != 2 && player_lobby_status[i] != true && p_info[i][d_start_addiction] == 1 && p_info[i][d_addiction] > 2000 && p_info[i][d_demolition] == 0 && p_info[i][DonateUpdate][3] == 0 && p_info[i][p_add_vip] == 0)
        {
            SendInfo(i, "У Вас началась ломка.");
            SendInfo(i, "Вам необходимо принять наркотик или вызвать медиков.");
            SendInfo(i, "Принять наркотик: /usedrugs");
            SendInfo(i, "Вызвать медиков: /call");
            p_info[i][d_demolition] = 1;
        }

        house_id = GetPlayerHouseID(i);
        if(house_id != INVALID_HOUSE_ID && p_temp[i][p_garage_use] == true && (1 <= h_info[house_id][h_squar] <= 5)) //лайф хак если тп куда-то из гаража
        {
            new h_class = h_info[house_id][h_squar]-2;
            if(!IsPlayerInRangeOfPoint(i, 50.0, g_info[h_class][g_pX], g_info[h_class][g_pY], g_info[h_class][g_pZ])) LoadUnPlayerCarsGarage(i, house_id);
        }

        CheckPlayerVehicleSpeed(i);
    }
    if(timestamp_minute == 00 && timestamp_second == 00) mysql_tquery(con_bd, "COMMIT;");

    if(timestamp_minute == 2 && timestamp_second == 30)
    {
        mysql_tquery(con_bd, "START TRANSACTION;");
        CheckHouse();
        CheckResourcesHouse();
        mysql_tquery(con_bd, "COMMIT;");
    }
    if(timestamp_minute == 5 && timestamp_second == 0)
    {
        mysql_tquery(con_bd, "START TRANSACTION;");
        CheckBizz();
        CheckHotel();
        mysql_tquery(con_bd, "COMMIT;");
    }
    if(timestamp_minute == 7 && timestamp_second == 30)
    {
        mysql_tquery(con_bd, "START TRANSACTION;");
        CheckVehicle();
        mysql_tquery(con_bd, "COMMIT;");
    }
    if(timestamp_minute == 10 && timestamp_second == 0)
    {
        mysql_tquery(con_bd, "START TRANSACTION;");
        CheckNetwork();
        CheckDrugDen();
        CheckDrugs();
        //CheckTreasures();
        mysql_tquery(con_bd, "COMMIT;");
    }

    if(timestamp_minute == 55 && timestamp_second == 0)
    {
        mysql_tquery(con_bd, "START TRANSACTION;");
        CheckVideoCards();
        if(timestamp_hour >= 8 && timestamp_hour <= 22)
        {
            CheckPanel();
            CheckUndergroundBots();
        }
        mysql_tquery(con_bd, "COMMIT;");
    }

    if(timestamp_hour == 20 && timestamp_minute == 30 && timestamp_second == 0)
        mysql_tquery(con_bd, "SELECT `id` FROM `accounts` WHERE `lotto` > '0'", "lotto_results");

    foreach(new v: Vehicle)
    {
        if(veh_info[v][v_timer_engine_off] > 0) veh_info[v][v_timer_engine_off] -= 1;
        if(GetVehicleData(GetVehicleModelEx(v), E_VD_TYPE) == VEHICLE_STATE_MOTO || GetVehicleData(GetVehicleModelEx(v), E_VD_TYPE) == VEHICLE_STATE_CAR)
        {
            if(veh_info[v][v_engine] == 1) {
                if(veh_info[v][v_owner_id] == 0) veh_info[v][v_fuel] -= 0.02;
                else {
                    if(veh_info[v][v_premium] == 0) veh_info[v][v_details][2] -= 0.001;
                    if(veh_info[v][v_details][2] < 0.0) veh_info[v][v_fuel] -= 0.1;
                    if(veh_info[v][v_details][2] < 10.0) veh_info[v][v_fuel] -= 0.08;
                    else if(veh_info[v][v_details][2] < 20.0) veh_info[v][v_fuel] -= 0.06;
                    else if(veh_info[v][v_details][2] < 30.0) veh_info[v][v_fuel] -= 0.04;
                    else veh_info[v][v_fuel] -= 0.02;
                }
                if(veh_info[v][v_fuel] < 0.0) {
                    veh_info[v][v_fuel] = 0.0;
                    SetVehicleParamsVEx(v, false, veh_info[v][v_light], alarm, veh_info[v][v_lock], bonnet, boot, objective);
                }
            }
        }
    }
    return 1;
}

public OnGameModeExit()
{
    for(new i = 1; i < MAX_FRACTIONS; i++) SaveFractionWarehouse(i);

    if(timers_unix != -1)
    {
        KillTimer(timers_unix);
        timers_unix = -1;
    }
    mysql_close();

    Log(LOG_system, INFO, "Остановка сервера [%i] с портом: %i", SRV_ID, SRV_PORT);

    DestroyLog(LOG_system);
    DestroyLog(LOG_player);
    DestroyLog(LOG_connect);
    DestroyLog(LOG_Incoming);
    DestroyLog(LOG_Outcoming);
    return 1;
}

public OnPlayerRequestClass(playerid, classid)
{
    SetPlayerTime(playerid, timestamp_hour, timestamp_minute);
    SetSpawnInfo(playerid, 255, 79, 2404.1870,1554.4166,43.8807, 1.0, -1, -1, -1, -1, -1, -1);
    if(GetPVarInt(playerid, #PLAYER_CONNECT)) 
    {
        TogglePlayerSpectating(playerid, true);
        TogglePlayerSpectating(playerid, false);
    }
    else SpawnPlayer(playerid);
    return 1;
}

CMD:log_packets_in(playerid, params[])
{
    if(p_info[playerid][admin] < 5) return 1;
    LOG_PACKETS_IN = !LOG_PACKETS_IN;
    SendAccess(playerid, "[log_packets_in]: %s", LOG_PACKETS_IN ? "ON" : "OFF");
    return 1;
}
CMD:log_packets_out(playerid, params[])
{
    if(p_info[playerid][admin] < 5) return 1;
    LOG_PACKETS_OUT = !LOG_PACKETS_OUT;
    SendAccess(playerid, "[log_packets_out]: %s", LOG_PACKETS_OUT ? "ON" : "OFF");
    return 1;
}

public OnIncomingConnection(playerid, ip_address[], port)
{
    p_temp[playerid][is_doss_attack] = false;
    format(p_temp[playerid][session_IP], 16, ip_address);
    p_temp[playerid][session_PORT] = port;
    if(!SRV_ID) printf("IP: %s | PORT: %d", ip_address, port);

    if(LOG_PACKETS_IN || LOG_PACKETS_OUT)
    {
        for(new i = MAX_SUSPICIOUS_IP-1; i != -1; i--)
        {
            if(strequals(p_temp[playerid][session_IP], suspiciousIp[i]))
            {
                p_temp[playerid][is_doss_attack] = true;
                Log(LOG_connect, INFO, "ID: <%d> | IP: %s | PORT: <%d>", playerid, p_temp[playerid][session_IP], port);
                break;
            }
        }
    }
    return 1;
}


public OnPlayerConnect(playerid)
{
    GetPlayerName(playerid, get_name(playerid), MAX_PLAYER_NAME);

    new fixnick = strfind(get_name(playerid), "[", true);
    if(fixnick > 2)
    {
        strdel(get_name(playerid), fixnick, strlen(get_name(playerid)));
        SetPlayerName(playerid, get_name(playerid));
    }

    if(strfind(get_name(playerid), "_BACKUP", true) != -1 ||
        strfind(get_name(playerid), "[PC]", true) != -1 ||
        strfind(get_name(playerid), "[VIP]", true) != -1 ||
        strfind(get_name(playerid), "theasmgirl", true) != -1)
    {
        SendError(playerid, "Вы не можете авторизоваться с этим никнеймом.");
        SendInfo(playerid, "Измените его в настройках лаунчера.");
        Kick(playerid);
        return 1;
    }
    SetPVarInt(playerid, #PLAYER_CONNECT, true);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `table_ban` WHERE `Name_Player` = '%e' OR `IP` = '%e' LIMIT 1",
        get_name(playerid), p_temp[playerid][session_IP]);
    mysql_pquery(con_bd, STRING_GLOBAL, "CheckAccountBanCallback", "dd", playerid, p_temp[playerid][session_PORT]);

    SetPlayerValuesToDefault(playerid);
    // ВАШ КОД НИЖЕ:
    count_player++;
    if(count_player > max_online)
        max_online = count_player;

    SendCheckHash(playerid, "vantagebadges",        "samp", CLIENT_VERSION_052021);
    SendCheckHash(playerid, "buga_grille3a_diff",   "samp", CLIENT_VERSION_112022);
    SendCheckHash(playerid, "vlg_crom_gradaziya",   "samp", CLIENT_VERSION_022023);

    SendCheckHash(playerid, "bmydzvs",              "samp", CLIENT_VERSION_20022023);

    Logotype_SetOnline();

    for(new i = TOTALGZ; i != 0; i--)
    {
        GangZoneShowForPlayer(playerid, GangZone_Info[i][gID], (GangZone_Info[i][g_Fraction] != 15) ? (fraction_color[GangZone_Info[i][g_Fraction]]) : (0xFFFFFF65));
    }
    if(biz_war_gangzone != -1)
        GangZoneShowForPlayer(playerid, biz_war_gangzone, 0xB2B2B2AA);

    GangZoneShowForPlayer(playerid, ZoneArmy, 0xF5DEB3AA);

    GangZoneShowForPlayer(playerid, MARKET_ZONE, 0xFF6347AA);

    #if OFF_HUD_PC == 0
    ShowTextDrawForPlayer(playerid, TD_ID_LOGO);
    #endif
    ShowFamilyZone(playerid);

    if(p_temp[playerid][no_valid_client] == true)
    {
        ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Старая версия клиента", ""W"\
        У Вас старая версия клиента, Вы не можете войти на сервер.\n\n\
        Вам необходимо обновить клиент, подробнее: "I""VK_URL"\n\n\
        "W"You need to UPDATE the client. Download from: "I""SITE_URL"","Закрыть","");
        Kick(playerid);
        return 0;
    }
    // ~~~~~ [ Шлагбаун ФБР ] ~~~~~ //
    RemoveBuildingForPlayer(playerid, 968, -2436.8125, 495.4688, 29.6797, 0.25);

    // ~~~~~ [ Мэрия LS park ] ~~~~~ //
    RemoveBuildingForPlayer(playerid, 4057, 1479.554, -1693.140, 19.578, 0.250);
    RemoveBuildingForPlayer(playerid, 4210, 1479.562, -1631.453, 12.078, 0.250);
