stock area_DestroyDynamicArea(areaid)
{
    gAreaInfo[areaid][area_type] = AREA_SUBTYPE_INVALID_ID;
    gAreaInfo[areaid][area_subtype] = AREA_SUBTYPE_INVALID_ID;
    gAreaInfo[areaid][area_object_id] = AREA_SUBTYPE_INVALID_ID;
    gAreaInfo[areaid][area_idx] = AREA_SUBTYPE_INVALID_ID;
    return DestroyDynamicArea(areaid);
}

