            ShowPlayerDialog(playerid, D_BUS_START_LIST, DIALOG_STYLE_LIST, ""I"Маршрут", ""I"[1]"W" Внутригородской ЛС\n"I"[2]"W" Внутригородской СФ\n"I"[3]"W" Внутригородской ЛВ\n"I"[4]"W" Автовокзал ЛС << >> Автошкола СФ\n"I"[5]"W" Автовокзал ЛС << >> Автовокзал ЛВ", "Далее", "Отмена");
