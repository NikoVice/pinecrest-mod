            if(strval(inputtext) < 0 || strval(inputtext) > 999999) return ShowPlayerDialog(playerid, D_LOBBY_CREATED_LIST_PASSWORD, DIALOG_STYLE_INPUT, ""I"Пароль от лобби", ""W"Введите пароль от лобби:", "Далее", "Отмена"), SendError(playerid, "Пароль должен быть не менее 0 и не более 999999.");
            new idx = GetPVarInt(playerid, "LobbyIDx");
            if(strval(inputtext) != LobbyInfo[idx][LobbyPassword]) return ShowPlayerDialog(playerid, D_LOBBY_CREATED_LIST_PASSWORD, DIALOG_STYLE_INPUT, ""I"Пароль от лобби", ""W"Введите пароль от лобби:", "Далее", "Отмена"), SendError(playerid, "Вы ввели неверный пароль.");
            DeletePVar(playerid, "LobbyIDx");
