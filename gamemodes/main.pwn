                                    ShowPlayerDialog(playerid, D_INSTALL_PREMIUM_ACC, DIALOG_STYLE_MSGBOX, ""I"Premium �� ���������", STRING_GLOBAL, "��", "���");
                                    SetPVarInt(playerid, "INSTALL_PREMIUM_ACC:idx", listitem+1);
                                }
                            }
                            return 1;
                        }
                        case LIST_ID_PLAYER_SKINS:
                        {
                            if(!(0 <= listitem < 25))  return SendError(playerid, "��������� �� ��������� ������. AC-1811");
                            new idx_dialog_skin = GetPVarInt(playerid, "SKINS_LIST:ID");
                            DeletePVar(playerid, "SKINS_LIST:ID");
                            listitem = p_temp[playerid][p_listitem][listitem];
