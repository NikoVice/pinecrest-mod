        {
            new idx = gAreaInfo[areaid][area_object_id];
            switch(gAreaInfo[areaid][area_subtype])
            {
                case AREA_SUBTYPE_PANEL:
                {
                    if(p_temp[playerid][Work_ID] == PANEL_WORK)
                    {
                        if(player_state != PLAYER_STATE_ONFOOT) return SendError(playerid, "Ремонт солнечных панелей осуществляется без транспортного средства.");
                        if(PanelHouseInfo[idx][PanelHouseBreaking] == 0) return SendError(playerid, "Данная солнечная панель исправна.");
                        if(PanelHouseInfo[idx][PanelHouseRepair] == 0) return SendError(playerid, "Владелец данной солнечной панели не оформлял заказ на её ремонт.");
                        if(PanelHouseInfo[idx][PanelHouseRepairPlayerID] != playerid) return SendError(playerid, "Вы не выполняете заказ на ремонт данной солнечной панели.");
                        if(AntiCheatWarningTime[playerid][0] > timestamp) return SendError(playerid, "Вы не можете выполнять заказы так часто, подождите.");
                        if(GetInventoryAmount(playerid, 701) == 0) return SendError(playerid, "У Вас нет инструментов.");
                        GivePlayerInventory(playerid, 701, -1);
                        ShowTextDrawForPlayer(playerid, TD_ID_PANEL);
                    }
                }
                case AREA_SUBTYPE_PANEL_LIST:
                {
                    if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != PANEL_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
                    if(p_temp[playerid][Work_ID] != PANEL_WORK) return SendError(playerid, "Вы не начали рабочий день.");
                    if(player_state != PLAYER_STATE_DRIVER) return SendError(playerid, "Вы должны находиться в транспортном средстве.");
                    new vehicleid = GetPlayerVehicleID(playerid);
                    if(p_temp[playerid][rented_veh] != vehicleid) return SendError(playerid, "Данное транспортное средство не является Вашим арендованным транспортным средством.");
                    if((veh_info[vehicleid][v_npoType] != NPO_JOB || veh_info[vehicleid][v_npoId] != JOB_PANEL) && veh_info[vehicleid][v_temp_job] != JOB_PANEL) return SendError(playerid, "У Вас нет арендованного рабочего транспортного средства.");
                    if(p_temp[playerid][PanelIDx] != -1) return SendError(playerid, "У Вас уже есть заказ.");
                    ShowHousePanel(playerid, PANEL_TYPE_LIST);
                }
            }
            return 1;
        }
        case TYPE_GREEN_HOUSES:
        {
            if(player_state != PLAYER_STATE_ONFOOT) return 1;
            new idx = gAreaInfo[areaid][area_object_id];
            switch(gAreaInfo[areaid][area_subtype])
            {
                case AREA_SUBTYPE_GH_FLOWERS:
                {
                    if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != GREEN_HOUSES_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
                    if(p_temp[playerid][Work_ID] != GREEN_HOUSES_WORK) return SendError(playerid, "Вы не начали рабочий день.");
                    if(p_temp[playerid][GreenHousesCheck] == 1) return SendError(playerid, "У Вас уже есть цветы, отнесите их на склад.");
                    if(FlowersGreenHousesInfo[idx][fPlayerID] != INVALID_PLAYER_ID) return SendError(playerid, "Данное место занято.");
                    if(FlowersGreenHousesInfo[idx][fRespawn] == 0) return SendError(playerid, "Данные цветы еще не выросли.");
                    FlowersGreenHousesInfo[idx][fPlayerID] = playerid;
                    UpdateFlowers(idx);
                    p_temp[playerid][GreenHousesIDx] = idx;
                    p_temp[playerid][GreenHousesTimer] = 10;
                    Fix_TogglePlayerControllable(playerid, false);
                    ClearAnimations(playerid);
                    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 1, 1, 1, 0);
                }
                case AREA_SUBTYPE_GH_WAREHOUSE:
                {
                    if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != GREEN_HOUSES_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
                    if(p_temp[playerid][Work_ID] != GREEN_HOUSES_WORK) return SendError(playerid, "Вы не начали рабочий день.");
                    if(p_temp[playerid][GreenHousesCheck] == 0) return SendError(playerid, "У Вас нет цветов.");
                    if(IsPlayerAttachedObjectSlotUsed(playerid, 0)) RemovePlayerAttachedObject(playerid, 0);
                    if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
                    DisablePlayerRaceCheckpoint(playerid);
                    p_temp[playerid][GreenHousesCheck] = 0;
                    SendMes(playerid, COLOR_BLUE, "Вы перенесли цветы на склад.");
                    new reason_money = GetPlayerMoneySkill(playerid, 156, 19);
                    if(CheckPlayerMaxSalarySkill(playerid, 19, reason_money))
                    {
                        SetPlayerMoney(playerid, reason_money, true, "зарплата тепличный комплекс");
                        OnServerInfoForMoney[17] += reason_money;
                        p_temp[playerid][GreenHousesSalary] += reason_money;
                        SendMes(playerid, COLOR_LYELLOW, "К Вашей зарплате добавлено: {"#cLIME"}%d$.{"#cLYELLOW"} Заработано всего: {"#cLIME"}%d$.", reason_money, p_temp[playerid][GreenHousesSalary]);

                        p_info[playerid][job_skill_salary][19] += reason_money;
                    }
                    else SendError(playerid, "За последний час игры было заработано максимальное количество денежных средств.");

                    if(GetPlayerGiveCasket(200, 5) != -1) GivePlayerCasket(playerid, 720);
                    ClearAnimations(playerid);
                    ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                    //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);

                    UpdatePlayerWorkSkill(playerid, 19);

                    CheckPlayerMission(playerid, START_GHOUSES);
                    CheckPlayerMission(playerid, DAILY_GHOUSES);
                    CheckPlayerMission(playerid, ACHIEVEMENT_GHOUSES);

                    CheckPlayerFreelance(playerid, FREELANCE_GHOUSES);
                    CheckPlayerBattlePass(playerid, BATTLEPASS_GHOUSES);

                    UpdateFamilyLevel(playerid);
                    UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_GHOUSES); // Контракты: Тепличный комплекс

                    if(random(10) == 5)
                    {
                        new idx;
                        switch(random(241))
                        {
                            case 0 .. 5: idx = 703;
                            case 6 .. 15: idx = 702;
                            case 16 .. 30: idx = 704;
                            case 31 .. 60: idx = 706;
                            case 61 .. 120: idx = 705;
                            default: idx = 707;
                        }
                        if(!GivePlayerInventory(playerid, idx)) return 1;
                        SendInfo(playerid, "На складе найден \"%s\".", ItemsInfo[idx][iName]);
                    }
                    #if EASTER_STATUS == 1
                        if(p_info[playerid][event_quest_id] == 6 && random(2) == 1)
                            ShowEasterQuest_Check(playerid);
                    #endif
                    CheckPlayerBot(playerid, 5);
                }
            }
        }
        case TYPE_CONTAINERS:
        {
            if(player_state != PLAYER_STATE_ONFOOT) return 1;
            if(p_info[playerid][p_settings][INTERFACE]) ShowTextDrawForPlayer(playerid, TD_ID_PRESS_ALT);
            else GameTextForPlayer(playerid, "~n~~n~~g~PRESS ~b~ALT", 2500, 6);
            p_temp[playerid][container_id] = gAreaInfo[areaid][area_object_id];
        }
        case TYPE_GIFT:
        {
            #if GIFT_STATUS == 1
                if(player_state == PLAYER_STATE_DRIVER) return SendError(playerid, "Вы должны быть без транспортного средства.");
                new idx = gAreaInfo[areaid][area_object_id];
                OnPlayerOpenGift(playerid, idx);
            #endif
            return 1;
        }
        case TYPE_ICE_RINK:
        {
            if(player_state != PLAYER_STATE_ONFOOT) return 1;
            #if NEWYEAR_STATUS == 1
