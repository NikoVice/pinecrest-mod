                ShowPlayerDialog(playerid, D_CREATE_BIZZ, DIALOG_STYLE_INPUT, ""I"Создание бизнеса", ""W"Введите через запятую: (Тип бизнеса),(Цена бизнеса)\n\nНапример: "I"[ 1,50000 (1 Тип, 50000 - цена) ]","Создать", "Назад");
            }
            return 1;
        }
        case 17:
        {
                if(!response)
                    return 1;
                if(totalhouses >= MAX_HOUSE)
                    return SendError(playerid, "Увеличьте MAX_HOUSE");
                new
                    params[4],
                    string[144];

                if(sscanf(inputtext, "p<,>ii", params[0], params[1]))
                    return SendError(playerid, "Вы ничего не ввели."), ShowPlayerDialog(playerid, 17, DIALOG_STYLE_INPUT, ""I"Создание дома", ""W"Введите через запятую: (Тип дома),(Цена)\nТип домов: 1 тип - 15кв.м | 2 тип - 36кв.м | 3 тип - 72кв.м | 4 тип - 120кв.м\n\n"I"[ Например: 1,50000 | где - (1 Тип, 50000 - цена) ]","Создать", "Назад");

                new
                    Float:Pos[6];

                GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
