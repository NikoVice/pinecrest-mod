                        GivePlayerInventory(playerid, 640, -1);
                        if(random(4) == 0)
                        {
                            if(GivePlayerInventory(playerid, 639))
                                SendAccess(playerid, "Вы приготовили бургер.");
                        }
                        else SendError(playerid, "У Вас не получилось приготовить бургер, мясо подгорело.");
                    }
                    else SendError(playerid, "Вы должны находиться рядом со своим костром.");
                }
            }
            return 1;
        }
