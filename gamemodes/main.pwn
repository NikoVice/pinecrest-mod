        }
        case D_CHANGE_CIVIL_COINS_LIST:
        {
            if(!response) return ShowChangeCivilCoins(playerid);
            new idx = listitem;
            if(ChangeCivilCoins[idx][ChangeCivilCoinsPrice] > GetInventoryAmount(playerid, 641)) return SendError(playerid, "У Вас нет столько гражданских монет.");
            switch(ChangeCivilCoins[idx][ChangeCivilCoinsType])
            {
                case TYPE_CHANGE_SKIN, TYPE_CHANGE_ROULETTE, TYPE_CHANGE_ACCESSORIES, TYPE_CHANGE_INVENTORY:
                {
                    if(!GivePlayerInventory(playerid, ChangeCivilCoins[idx][ChangeCivilCoinsIDx], .reason = "обмен гражданских монет"))
                        return 1;

                    GivePlayerInventory(playerid, 641, -ChangeCivilCoins[idx][ChangeCivilCoinsPrice]);
                }
                case TYPE_CHANGE_COSTUME:
                {
                    new costume_idx = ChangeCivilCoins[idx][ChangeCivilCoinsIDx];
                    if(p_info[playerid][costume][costume_idx] == 1) return SendError(playerid, "У Вас уже есть костюм \"%s\".", CostumeName[costume_idx]);
                    GivePlayerCostume(playerid, costume_idx);

                    GivePlayerInventory(playerid, 641, -ChangeCivilCoins[idx][ChangeCivilCoinsPrice]);
                }
                case TYPE_CHANGE_VEHICLE: 
                {
                    SetPlayerItem(playerid, 13, p_info[playerid][ID], TYPE_GIVE_ITEM_VEHICLE, ChangeCivilCoins[listitem][ChangeCivilCoinsIDx]);
                    
                    GivePlayerInventory(playerid, 641, -ChangeCivilCoins[idx][ChangeCivilCoinsPrice]);
                }
                case TYPE_CHANGE_VIP:
                {
                    new vip_type, vip_days;
                    if(1 <= ChangeCivilCoins[idx][ChangeCivilCoinsIDx] <= 3) 
                    {
                        vip_type = ChangeCivilCoins[idx][ChangeCivilCoinsIDx]-1;
                        vip_days = 1;
                    }
                    if(4 <= ChangeCivilCoins[idx][ChangeCivilCoinsIDx] <= 6) 
                    {
                        vip_type = ChangeCivilCoins[idx][ChangeCivilCoinsIDx]-4;
                        vip_days = 7;
                    }
                    SetPlayerItem(playerid, 13, p_info[playerid][ID], TYPE_GIVE_ITEM_VIP, vip_type, vip_days);
                    GivePlayerInventory(playerid, 641, -ChangeCivilCoins[idx][ChangeCivilCoinsPrice]);
                }
            }
            SendAccess(playerid, "Вы обменяли %d гражданских монет на %s.", ChangeCivilCoins[idx][ChangeCivilCoinsPrice], GetChangeCivilCoinsName(ChangeCivilCoins[idx][ChangeCivilCoinsType], ChangeCivilCoins[idx][ChangeCivilCoinsIDx]));

            Log(LOG_player, INFO, "%s[%d](%s %s) обменял %d гражданских монет на %s | #ChangeCivilCoins",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", ChangeCivilCoins[idx][ChangeCivilCoinsPrice], GetChangeCivilCoinsName(ChangeCivilCoins[idx][ChangeCivilCoinsType], ChangeCivilCoins[idx][ChangeCivilCoinsIDx]));
            return 1;
        }
        case D_TUNE_DEFAULT_CANCEL:
        {
            if(!response)
            {
                if(!p_temp[playerid][TextDrawServiceTune])
                {
                    HideTextDrawForPlayer(playerid, TD_ID_SHOP);
                    ShowDialogTuneDefault(playerid);
                }
                return 1;
            }
            new vehicleid = GetPlayerVehicleID(playerid);
            if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || p_temp[playerid][p_listitem][0] != vehicleid)
                return Service_Error(playerid, "ID транспорта не совпадает с первоначальным, воспользуйтесь услугами автосервиса повторно.");

            for(new i; i < 13; i++) RemoveVehicleComponent(vehicleid, GetVehicleComponentInSlot(vehicleid, i));
            RemoveVehicleComponent(vehicleid, GetVehicleComponentInSlot(vehicleid, CARMODTYPE_WHEELS));
            ChangeVehiclePaintjob(vehicleid, 3);

            for (new i; i < v_all-1; i++) if(veh_info[vehicleid][v_tune][i] != 0 ) VEx_AddVehicleComponent (vehicleid, veh_info[vehicleid][v_tune][i]);
            if(veh_info[vehicleid][v_tune][v_paintjob] != 0) ChangeVehiclePaintjob(vehicleid, veh_info[vehicleid][v_tune][v_paintjob]-1);

            if(p_temp[playerid][TextDrawServiceTune]) Service_Exit(playerid);
            else
            {
                HideTextDrawForPlayer(playerid, TD_ID_SHOP);
                ShowDialogTuneDefault(playerid);
            }
            p_temp[playerid][p_listitem][0] =
            p_temp[playerid][p_listitem][1] =
            p_temp[playerid][p_listitem][5] = -1;

            p_temp[playerid][shop_id] = 0;
            p_temp[playerid][tune_default] = false;
            return 1;
        }
        case D_TUNE_DEFAULT_BUY:
        {
            if(!response) return 1;
            new vehicleid = GetPlayerVehicleID(playerid), tune_id = p_temp[playerid][p_listitem][1];
            if(p_temp[playerid][p_listitem][0] != vehicleid)
                return Service_Error(playerid, "ID транспорта не совпадает с первоначальным, воспользуйтесь услугами автосервиса повторно.");
            new select_id = p_temp[playerid][shop_id];
            if(tune_id != v_paintjob && veh_info[vehicleid][v_tune][tune_id] == p_temp[playerid][e_tListComponents][select_id])
            {
                if(!p_temp[playerid][TextDrawServiceTune])
                {
                    HideTextDrawForPlayer(playerid, TD_ID_SHOP);
                    ShowDialogTuneDefault(playerid);
                }
                return SendError(playerid, "Данный компонент уже имеется на этом транспортном средстве.");
            }

            new till = Service_GetTill(playerid);
            if(till == -1) return Service_Error(playerid, "Не найден ID автосервиса, воспользуйтесь услугами автосервиса повторно.");

            new price_tune = GetPriceTuneElement(tune_id, select_id) * till;
            if(p_info[playerid][cash] < price_tune)
            {
                if(!p_temp[playerid][TextDrawServiceTune])
                {
                    HideTextDrawForPlayer(playerid, TD_ID_SHOP);
                    ShowDialogTuneDefault(playerid);
                }
                SendError(playerid, "У Вас не достаточно денег.");
                return 1;
            }

            if(tune_id == v_paintjob)
            {
                if(veh_info[vehicleid][v_tune][tune_id] == select_id+1)
                {
                    if(!p_temp[playerid][TextDrawServiceTune])
                    {
                        HideTextDrawForPlayer(playerid, TD_ID_SHOP);
                        ShowDialogTuneDefault(playerid);
                    }
                    SendError(playerid, "Данный компонент уже имеется на этом транспортном средстве.");
                    return 1;
                }
                veh_info[vehicleid][v_tune][tune_id] = select_id+1;
                ChangeVehiclePaintjob(vehicleid, select_id);
            }
            else
            {
                veh_info[vehicleid][v_tune][tune_id] = p_temp[playerid][e_tListComponents][select_id];
                VEx_AddVehicleComponent(vehicleid, veh_info[vehicleid][v_tune][tune_id]);
                if(tune_id == v_sideskirt || tune_id == v_vents) VEx_AddVehicleComponent(vehicleid, veh_info[vehicleid][v_tune][tune_id]);
            }
            Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] купил элемент обычного тюнинга на <%s>(%d)[%d] за %d$",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id], price_tune);

            BuyPlayerService(playerid, price_tune);

            PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);
            SaveVehicleTuning(vehicleid);

            if(p_temp[playerid][TextDrawServiceTune]) Interface_Show(playerid, SERVICE_TUNE_EXTERNAL);
            else
            {
                HideTextDrawForPlayer(playerid, TD_ID_SHOP);
                ShowDialogTuneDefault(playerid);
            }

            p_temp[playerid][p_listitem][0] =
            p_temp[playerid][p_listitem][1] =
            p_temp[playerid][p_listitem][5] = -1;
            p_temp[playerid][shop_id] = 0;
            p_temp[playerid][tune_default] = false;
            return 1;
        }
        case D_BINDER_SHOW:
        {
            if(!response || listitem >= 24) return 1;
            switch(listitem)
            {
                case 0:
                {
                    p_temp[playerid][BinderList]++;
                    return ShowBinderList(playerid);
                }
                case 1:
                {
                    if(p_temp[playerid][BinderList]) p_temp[playerid][BinderList]--;
                    return ShowBinderList(playerid);
                }
                case 2:
                {
                    ShowPlayerDialog(playerid, D_BINDER_ADD_COMMAND2, DIALOG_STYLE_INPUT, ""I"Биндер", ""W"Введите команду, которая будет использоваться для бинда:", "Далее", "Отмена");
                    return 1;
                }
                case 3: return ShowBinderList(playerid);
            }
            new text[8][144], id = p_temp[playerid][BufferBinderID][listitem - 4];
            sscanf(arrayBinderTEXT[playerid][id], "p<>>a<s[144]>[8]", text);
            STRING_GLOBAL[0] = EOS;
            for(new i; i < 8; i++) f(STRING_GLOBAL, "%s"I"%s\n", STRING_GLOBAL, text[i]);
            p_temp[playerid][p_listitem_int] = (listitem - 4);
            f(STRING_GLOBAL, ""I"[1]"W" Изменить команду\n"I"[2]"W" Изменить текст\n"I"[3]"W" %s\n"I"[4]"W" Удалить\nКоманда: "I"%s"W"\nТекст: "I"%s"W"", p_info[playerid][BinderStatus][id] ? ("{"#cLIGHTRED"}Выключить") : ("{"#cGREEN"}Включить"), arrayBinderCMD[playerid][id], STRING_GLOBAL);
            return ShowPlayerDialog(playerid, D_BINDER_MENU, DIALOG_STYLE_LIST, ""I"Биндер", STRING_GLOBAL, "Далее", "Отмена");
        }
        case D_BINDER_MENU:
        {
            if(!response) return ShowBinderList(playerid);
            switch(listitem)
            {
                case 0: return ShowPlayerDialog(playerid, D_BINDER_ADD_COMMAND, DIALOG_STYLE_INPUT, ""I"Биндер", ""W"Введите команду, которая будет использоваться для бинда:", "Принять", "Назад");
                case 1: return ShowPlayerDialog(playerid, D_BINDER_ADD_TEXT, DIALOG_STYLE_INPUT, ""I"Биндер", ""W"Введите текст, который будет выводится при отправке команды:", "Принять", "Назад");
                case 2:
                {
                    new id = p_temp[playerid][BufferBinderID][p_temp[playerid][p_listitem_int]];
                    p_info[playerid][BinderStatus][id] = !p_info[playerid][BinderStatus][id];

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `binder` SET `enb` = %d WHERE `id` = %d AND `user_id` = %d LIMIT 1",
                    p_info[playerid][BinderStatus][id], id, p_info[playerid][ID]);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                }
                case 3:
                {
                    new idx = p_temp[playerid][BufferBinderID][p_temp[playerid][p_listitem_int]];
                    arrayBinderCMD[playerid][idx] = "";
                    arrayBinderTEXT[playerid][idx] = "";

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `binder` WHERE `id` = %d AND `user_id` = %d LIMIT 1",
                    idx, p_info[playerid][ID]);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                }
            }
            return ShowBinderList(playerid);
        }
        case D_BINDER_ADD_COMMAND:
        {
            if(!response) return ShowBinderList(playerid);
            if(!(1 <= strlen(inputtext) <= 30) || !strcmp(inputtext, "/bind")) return ShowPlayerDialog(playerid, 7241, DIALOG_STYLE_INPUT, ""I"Биндер", ""W"Введите команду, которая будет использоваться для бинда:", "Принять", "Назад");

            new id = p_temp[playerid][BufferBinderID][p_temp[playerid][p_listitem_int]];
            format(arrayBinderCMD[playerid][id], 32, inputtext);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `binder` SET `cmd` = '%e' WHERE `id` = %d AND `user_id` = %d LIMIT 1", inputtext, id, p_info[playerid][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            return ShowBinderList(playerid);
        }
        case D_BINDER_ADD_TEXT:
        {
            if(!response) return ShowBinderList(playerid);
            if(!(1 <= strlen(inputtext) <= 128)) return ShowPlayerDialog(playerid, D_BINDER_ADD_TEXT, DIALOG_STYLE_INPUT, ""I"Биндер", ""W"Введите текст, который будет выводится при отправке команды:", "Принять", "Назад");
            if(strfind(inputtext, "returnmarket", true) != -1)
            {
                SendError(playerid, "Эту команду не возможно добавить в биндер.");
                return ShowPlayerDialog(playerid, D_BINDER_ADD_TEXT, DIALOG_STYLE_INPUT, ""I"Биндер", ""W"Введите текст, который будет выводится при отправке команды:", "Принять", "Назад");
            }

            new id = p_temp[playerid][BufferBinderID][p_temp[playerid][p_listitem_int]];
            format(arrayBinderTEXT[playerid][id], 128, inputtext);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `binder` SET `text` = '%e' WHERE `id` = %d AND `user_id` = %d LIMIT 1",
            inputtext, id, p_info[playerid][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            return ShowBinderList(playerid);
        }
        case D_BINDER_ADD_COMMAND2:
        {
            if(!response) return ShowBinderList(playerid);
            if(!(1 <= strlen(inputtext) <= 30) || !strcmp(inputtext, "/bind")) return ShowPlayerDialog(playerid, D_BINDER_ADD_COMMAND2, DIALOG_STYLE_INPUT, ""I"Биндер", ""W"Введите команду, которая будет использоваться для бинда:", "Принять", "Назад");
            format(p_temp[playerid][BufferCMDCreate], 32, inputtext);
            return ShowPlayerDialog(playerid, D_BINDER_ADD_COMMAND3, DIALOG_STYLE_INPUT, ""I"Биндер", ""W"Введите текст, который будет выводится при отправке команды:\n(Через символ '>' можно испьзовать несколько команд)", "Принять", "Назад");
        }
        case D_BINDER_ADD_COMMAND3:
        {
            if(!response) return ShowBinderList(playerid);
            if(!(1 <= strlen(inputtext) <= 128)) return ShowPlayerDialog(playerid, D_BINDER_ADD_COMMAND3, DIALOG_STYLE_INPUT, ""I"Биндер", ""W"Введите текст, который будет выводится при отправке команды:\n(Через символ '>' можно испьзовать несколько команд)", "Принять", "Назад");

            new id = -1;
            for(new i; i < MAX_BINDER; i++) if(!arrayBinderCMD[playerid][i][0]) { id = i; break; }
            if(id == -1)
            {
                ShowBinderList(playerid);
                return SendError(playerid, "Больше создать нельзя.");
            }
            p_info[playerid][BinderStatus][id] = 1;
            format(arrayBinderCMD[playerid][id], 32, p_temp[playerid][BufferCMDCreate]);
            format(arrayBinderTEXT[playerid][id], 128, inputtext);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `binder` (`id`, `user_id`, `enb`, `cmd`, `text`) VALUES (%d, %d, '1', '%e', '%e')",
            id, p_info[playerid][ID], p_temp[playerid][BufferCMDCreate], inputtext);
            mysql_tquery(con_bd, STRING_GLOBAL);

            return ShowBinderList(playerid);
        }
        
        case D_ANIM_LIST:
        {
            if( !response ) return 1;
            p_temp[playerid][p_listitem_int] = listitem;
            ShowTypeAnimation(playerid, listitem);
            return 1;
        }
        case D_ANIM_SELECT:
        {
            if(!response)
                return 1;
            new type = p_temp[playerid][p_listitem_int];
            p_temp[playerid][p_listitem_int] = -1;
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "pc_cmd_%s", anim_list[type][listitem][anim_cmd]);
            CallRemoteFunction(STRING_GLOBAL, "i", playerid);
            return 1;
        }
        case D_RECON_BAN:
        {
            if(!response) return 1;
            new count_time,Reason[144];
            if(sscanf(inputtext, "p<,>is[144]", count_time, Reason))
                return ShowPlayerDialog(playerid,D_RECON_BAN, DIALOG_STYLE_INPUT, ""I"BAN", ""W"Используйте: "I"количество дней, причину(через запятую)","Далее","Отмена");
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL,"%d %d %s", pSpectateId[playerid], count_time,Reason);
            callcmd::ban(playerid, STRING_GLOBAL);
        }
        case D_RECON_WARN:
        {
            if(!response) return 1;
            new count_time,Reason[144];
            if(sscanf(inputtext, "p<,>is[144]", count_time, Reason))
                return ShowPlayerDialog(playerid,D_RECON_WARN,DIALOG_STYLE_INPUT, ""I"WARN",""W"Используйте: "I"количество дней, причину(через запятую)","Далее","Отмена");
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d %s", pSpectateId[playerid], count_time,Reason);
            callcmd::warn(playerid, STRING_GLOBAL);
        }
        case D_RECON_JAIL:
        {
            if(!response) return 1;
            new count_time,Reason[144];
            if(sscanf(inputtext, "p<,>is[144]", count_time, Reason))
                return ShowPlayerDialog(playerid,D_RECON_JAIL, DIALOG_STYLE_INPUT, ""I"JAIL", ""W"Используйте: "I"количество минут, причину(через запятую)","Далее","Отмена");
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL,"%d %d %s", pSpectateId[playerid], count_time,Reason);
            callcmd::jail(playerid, STRING_GLOBAL);
        }
        case D_RECON_MUTE:
        {
            if(!response) return 1;
            new count_time,Reason[144];
            if(sscanf(inputtext, "p<,>is[144]", count_time, Reason))
                return ShowPlayerDialog(playerid,D_RECON_MUTE, DIALOG_STYLE_INPUT, ""I"MUTE", ""W"Используйте: "I"количество минут, причину(через запятую)","Далее","Отмена");
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL,"%d %d %s", pSpectateId[playerid], count_time,Reason);
            callcmd::mute(playerid, STRING_GLOBAL);
        }
        case D_RECON_KICK:
        {
            if(!response) return 1;
            new Reason[144];
            if(sscanf(inputtext, "s[144]", Reason))
                return ShowPlayerDialog(playerid, D_RECON_KICK, DIALOG_STYLE_INPUT, ""I"KICK", ""W"Используйте: "I"причину(через запятую)","Далее","Отмена");
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d %s", pSpectateId[playerid], Reason);
            callcmd::kick(playerid, STRING_GLOBAL);
        }
        case D_OFFER_PLAYER_LIST:
        {
            if(!response) return 1;
            new offer_id = GetPlayerOfferID(playerid, listitem);
            if(offer_id == INVALID_PLAYER_ID)
                return SendError(playerid, "У Вас нет предложения в этом слоте.");
            if(OfferInfo[playerid][timer_offer][listitem] < timestamp)
            {
                ClearOwnerOffer(playerid, offer_id);
                return SendError(playerid, "Время предложения вышло.");
            }
            p_temp[playerid][offer_active_id] = listitem;
            new price = OfferInfo[playerid][price_offer][listitem], count[2];
            count[0] = OfferInfo[playerid][count_one_offer][listitem],
            count[1] = OfferInfo[playerid][count_two_offer][listitem];

            STRING_GLOBAL[0] = EOS;
            switch(OfferInfo[playerid][id_offer][listitem])
            {
                case OFFER_ID_START_SPARRING:
                {
                    f(STRING_GLOBAL, ""I"%s "W"предлагает Вам начать бой, ставка %d$.", get_name(offer_id), SparringData[p_temp[playerid][SparringID]][sBet]);
                    ShowPlayerDialog(playerid, D_OFFER_TARGET, DIALOG_STYLE_MSGBOX, ""I"Бой", STRING_GLOBAL,"Да","Нет");
                }
                case OFFER_ID_SPARRING:
                {
                    f(STRING_GLOBAL, ""I"%s "W"предлагает Вам провести бой.", get_name(offer_id));
                    ShowPlayerDialog(playerid, D_OFFER_TARGET, DIALOG_STYLE_MSGBOX, ""I"Бой", STRING_GLOBAL,"Да","Нет");
                }
                case OFFER_ID_VEHICLE_REFILL:
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""I"%s "W"предлагает Вам заправить Ваш автомобиль на %d литров за "I"%s.", get_name(offer_id), count[0], ConvertNumber(price));
                    ShowPlayerDialog(playerid, D_OFFER_TARGET, DIALOG_STYLE_MSGBOX, ""I"Ремонт транспорта", STRING_GLOBAL, "Да", "Нет");
                }
                case OFFER_ID_VEHICLE_REPAIR:
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""I"%s "W"предлагает Вам починить Ваш автомобиль за "I"%s.", get_name(offer_id), ConvertNumber(price));
                    ShowPlayerDialog(playerid, D_OFFER_TARGET, DIALOG_STYLE_MSGBOX, ""I"Ремонт транспорта", STRING_GLOBAL, "Да", "Нет");
                }
                case OFFER_ID_SELL_SIM_PHONE:
                {
                    p_temp[playerid][offer_code] = random(899999) + 100000;
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
                    "W"%s [%d] {"#cLIGHTRED"}предлагает Вам приобрести его номер телефона "W"\"%d\"{"#cLIGHTRED"} за "W"%s.\n\n\
                    Для подтверждения необходимо ввести код: {"#cLIGHTRED"}%d", get_name(offer_id), offer_id, p_info[offer_id][phone_number], ConvertNumber(price), p_temp[playerid][offer_code]);
                    ShowPlayerDialog(playerid, D_OFFER_TARGET, DIALOG_STYLE_INPUT, "{"#cLIGHTRED"}Покупка номера телефона", STRING_GLOBAL, "Да", "Нет");
                }
                case OFFER_ID_CHANGE_SIM_PHONE:
                {
                    p_temp[playerid][offer_code] = random(899999) + 100000;
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
                    "W"%s [%d] {"#cLIGHTRED"}предлагает Вам обменять Ваш номер телефона "W"\"%d\"{"#cLIGHTRED"} на "W"\"%d\"{"#cLIGHTRED"} с доплатой от Вас "W"%s.\n\n\
                    Для подтверждения необходимо ввести код: {"#cLIGHTRED"}%d", get_name(offer_id), offer_id, p_info[playerid][phone_number], p_info[offer_id][phone_number], ConvertNumber(price), p_temp[playerid][offer_code]);
                    ShowPlayerDialog(playerid, D_OFFER_TARGET, DIALOG_STYLE_INPUT, "{"#cLIGHTRED"}Обмен номером телефона", STRING_GLOBAL, "Да", "Нет");
                }
                case OFFER_ID_HI:
                {
                    f(STRING_GLOBAL, ""I"%s "W"предлагает Вам пожать руку.", get_name(offer_id));
                    ShowPlayerDialog(playerid, D_OFFER_TARGET, DIALOG_STYLE_MSGBOX, ""I"Пожать руку", STRING_GLOBAL,"Да","Нет");
                }
                case OFFER_ID_CAR_PASS:
                {
                    f(STRING_GLOBAL, ""I"%s "W"предлагает Вам показать тех. паспорт.", get_name(offer_id));
                    ShowPlayerDialog(playerid, D_OFFER_TARGET, DIALOG_STYLE_MSGBOX, ""I"Тех. паспорт", STRING_GLOBAL,"Да","Нет");
                }
                case OFFER_ID_TRADE:
                {
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""I"%s "W"предлагает Вам провести обмен(трейд).", get_name(offer_id));
                    ShowPlayerDialog(playerid, D_OFFER_TARGET, DIALOG_STYLE_MSGBOX, ""I"Предложение обмена", STRING_GLOBAL, "Да", "Нет");
                }
                case OFFER_ID_SELL_VEH_NUMBER:
                {
                    new offer_vehicle = p_temp[offer_id][p_listitem][40];
                    if(!IsPlayerOwnerVehicle(offer_id, offer_vehicle))
                        return SendError(playerid, "Произошла не известная ошибка:  PV-1708-2 | Сообщите на форум!");
                    f(STRING_GLOBAL, ""I"%s "W"предлагает Вам купить номер т/с\n "I"%s "W"за "I"%s", get_name(offer_id), veh_info[offer_vehicle][v_number], ConvertNumber(price));
                    ShowPlayerDialog(playerid, D_OFFER_TARGET, DIALOG_STYLE_MSGBOX, ""I"Продажа номеров Т/С", STRING_GLOBAL, "Да","Нет");
                }
                case OFFER_ID_CHANGE_VEH_NUMBER:
                {
                    new player_vehicle = p_temp[offer_id][p_listitem][41],
                        offer_vehicle = p_temp[offer_id][p_listitem][40];
                    if(!IsPlayerOwnerVehicle(offer_id, offer_vehicle))
                        return SendError(playerid, "Произошла не известная ошибка:  PV-1708-0 | Сообщите на форум!");
                    if(!IsPlayerOwnerVehicle(playerid, player_vehicle))
                        return SendError(playerid, "Произошла не известная ошибка:  PV-1708-1 | Сообщите на форум!");
                    f(STRING_GLOBAL, ""I"%s "W"предлагает обменять Ваш номер т/с\n        "I"%s "W"на "I"%s\n"W"с доплатой от Вас "I"%s", get_name(offer_id), veh_info[player_vehicle][v_number], veh_info[offer_vehicle][v_number], ConvertNumber(price));
                    ShowPlayerDialog(playerid, D_OFFER_TARGET, DIALOG_STYLE_MSGBOX, ""I"Обмен номерами Т/С", STRING_GLOBAL, "Да","Нет");
                }
                case OFFER_ID_SHOW_CERTIFICATE:
                {
                    f(STRING_GLOBAL, ""I"%s "W"хочет показать Вам удостоверение. Посмотреть удостоверение?", get_name(offer_id), ConvertNumber(price));
                    ShowPlayerDialog(playerid, D_OFFER_TARGET, DIALOG_STYLE_MSGBOX, ""I"Удостоверение", STRING_GLOBAL, "Да", "Нет");
                }
                case OFFER_ID_MED_INSURANCE:
                {
                    f(STRING_GLOBAL, ""I"%s "W"предлагаем Вам купить мед. страхование за 10 000$. Вы согласны?",get_name(offer_id));
