                    ShowVideoCards(playerid, VIDEO_CARDS_TYPE_CONTROL, idx);
                }
                case 1: ShowVideoCards(playerid, VIDEO_CARDS_TYPE_BITCOIN, idx);
                case 2: ShowVideoCards(playerid, VIDEO_CARDS_TYPE_TAX, idx);
                case 3: ShowVideoCards(playerid, VIDEO_CARDS_TYPE_POWER_STATION, idx);
                case 4:
                {
                    if(VideoCardsInfo[idx][vcCoolant] == 100.0) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_CONTROL, idx), SendError(playerid, "����������� �������� �� ���������� ����� ������������ ��������.");
                    if(!GetInventoryAmount(playerid, 709)) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_CONTROL, idx), SendError(playerid, "� ��� ��� ����������� ��������.");

                    GivePlayerInventory(playerid, 709, -1);

                    VideoCardsInfo[idx][vcCoolant] += 50.0;
                    if(VideoCardsInfo[idx][vcCoolant] > 100.0) VideoCardsInfo[idx][vcCoolant] = 100.0;

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `videocards` SET `coolant` = '%f' WHERE `id` = %d",
                    VideoCardsInfo[idx][vcCoolant], VideoCardsInfo[idx][vcMySQLIDx]);
