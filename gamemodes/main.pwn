            new car_id = CreateVehicleVEx(NPO_ROBBERY_HOUSE, NPO_NONE, MODEL_ROBBERY_VEHICLE, 2305.7805+random(1),-1217.6602+random(1),23.8791,0.6089, 1, 1, 86400);

