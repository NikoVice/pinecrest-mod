CMD:startmp(playerid, params[])
{
    if(p_info[playerid][admin] < 2 && p_info[playerid][youtube_adm] < 3) return 1;
    if(sscanf(params, "is[144]", params[0], params[1])) return SendInfo(playerid, "Используйте: /startmp [кол-во игроков] [название мероприятия]");
    if(AidPlayers > 0) return SendError(playerid, "В данный момент уже есть сбор игроков на мероприятие.");
    if(params[0] < 1 || params[0] > 100) return SendError(playerid, "Кол-во игроков должно быть не менее 1 и не более 100.");
    if(strlen(params[1]) < 3) return SendError(playerid, "Название должно быть не менее 3 символов.");
    AidPlayers = params[0];
    MP_PARAMS[1] = GetPlayerInterior(playerid);
    MP_PARAMS[0] = GetPlayerVirtualWorld(playerid);
    GetPlayerPos(playerid,MP_POS[0],MP_POS[1],MP_POS[2]);

    SendMesAll(0xFFD700FF, "Администратор %s [%d] объявил мероприятие \"%s\".", get_name(playerid), playerid, params[1]);
    SendMesAll(0xFFD700FF, "Максимальное количество игроков: %d.", params[0]);
    SendMesAll(0xFFD700FF, "Введите /gomp, Чтобы принять участие в мероприятии.");

    SendInfo(playerid, "Завершить сбор игроков на мероприятие: /stopmp");
    return 1;
}
CMD:stopmp(playerid, params[])
{
    if(p_info[playerid][admin] < 2 && p_info[playerid][youtube_adm] < 3) return 1;
    if(!AidPlayers) return SendError(playerid, "В данный момент нет сбора игроков на мероприятие.");
    MP_PARAMS[0] = 0;
    MP_PARAMS[1] = 0;
    AidPlayers = 0;
    MP_POS[0] =
    MP_POS[1] =
    MP_POS[2] = 0.0;
    SendMesAll(0xFFD700FF, "Администратор %s [%d] завершил сбор игроков на мероприятие.", get_name(playerid), playerid);
    return 1;
}
CMD:gomp(playerid, params[])
{
    if(p_temp[playerid][h_buy_int] != -1)
        return SendError(playerid, "Вы в режиме смены интерьера. Выйдите из него, чтобы покинуть здание.");
    if(p_temp[playerid][h_repair_txtid] != -1)
        return SendError(playerid, "Вы в режиме ремонта. Выйдите из него, чтобы покинуть здание.");
    if(AidPlayers == 0) return SendError(playerid, "В данный момент нет сбора игроков на мероприятие.");
    if(p_info[playerid][jail] != 0 || p_info[playerid][jail_time] != 0) return SendError(playerid, "Нельзя телепортироваться из тюрьмы.");
    if(p_temp[playerid][BeingInSpace] == true || p_temp[playerid][SpaceFlightStatus] == true) return SendError(playerid, "Нельзя телепортироваться из космоса.");
    if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Вы находитесь в транспортном средстве.");
    if(p_temp[playerid][tTied]) return SendError(playerid, "Вы связаны.");
    if(GetPVarInt(playerid, "PlayerCuffed") == 1) return SendError(playerid, "Вы в наручниках.");

    if(RegisterRace[playerid] == 2) return SendError(playerid, "Во время гонок запрещено телепортироваться на мероприятие.");
    if(RegisterDerby[playerid] == 2) return SendError(playerid, "Во время дерби запрещено телепортироваться на мероприятие.");
    if(RegisterPaintBall[playerid] == 2) return SendError(playerid, "Во время пейнтбола запрещено телепортироваться на мероприятие.");
    if(p_temp[playerid][cossack_robbers_register] == 2) return SendError(playerid, "Во время Казаков-разбойников запрещено телепортироваться на мероприятие.");
    if(player_lobby_status[playerid] == true) return SendError(playerid, "Находясь в лобби запрещено телепортироваться на мероприятие.");
    if(GetPVarInt(playerid, "UseGOMP") > timestamp) return SendError(playerid, "Вы не можете так часто пользоваться данной командой.");
    SetPVarInt(playerid, "UseGOMP", timestamp+30);
    SetPlayerPos(playerid,MP_POS[0]+random(5),MP_POS[1]+random(5),MP_POS[2]+0.1);
    SetPlayerVirtualWorld(playerid, MP_PARAMS[0]);
    SetPlayerInterior(playerid, MP_PARAMS[1]);
    SetCameraBehindPlayer(playerid);
    SendAccess(playerid, "Вы были телепортированы на мероприятие, ожидайте указаний администрации.");
    if(AidPlayers == 1)
    {
        SendMesAll(0xFFD700FF, "Телепорт на мероприятие завершен.");

        MP_PARAMS[0] = 0;
        MP_PARAMS[1] = 0;
        MP_POS[0] =
        MP_POS[1] =
        MP_POS[2] = 0.0;
    }
    AidPlayers--;
    if(AidPlayers <= 0) AidPlayers = 0;
    return 1;
}

CMD:eject(playerid, params[])
{
    if(0 == IsPlayerInAnyVehicle(playerid))
        return SendError(playerid, "Вы должны находиться в транспортном средстве.");

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return SendError(playerid, "Вы должны находиться за рулем транспортного средства.");

    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "Используйте: /eject [id игрока]");

    if(params[0] == INVALID_PLAYER_ID || params[0] == playerid)
        return SendError(playerid, "Игрок не найден.");

    if(0 == IsPlayerInVehicle(params[0], GetPlayerVehicleID(playerid)))
        return SendError(playerid, "Игрок не находится в Вашем транспортном средстве.");

    SendAccess(playerid, "Вы выбросили %s [%d] из транспортного средства.", get_name(params[0]), params[0]);

    RemovePlayerFromVehicle(params[0]);
    Fix_TogglePlayerControllable(params[0], 1);

    if(GetPVarType(params[0], "PlayerCuffed") == PLAYER_VARTYPE_INT)
    {
        SendInfo(params[0], "%s [%d] выбросил Вас из транспортного средства и при падении наручники сломались.", get_name(playerid), playerid);

        SetPlayerSpecialAction(params[0], SPECIAL_ACTION_NONE);
        DeletePVar(params[0], "PlayerCuffed");
    }
    else SendInfo(params[0], "%s [%d] выбросил Вас из транспортного средства.", get_name(playerid), playerid);

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "Дверь машины закрыта.");
        MeAction(playerid, "открыв дверь автомобиля ухватился за человека...");
        MeAction(playerid, "затем вытолкнул его из автомобиля закрыв за собой дверь");
    }
    return 1;
}
CMD:ceject(playerid, params[])
{
    if(!IsPlayerFractionPolice(playerid))
        return SendError(playerid, "Вы не можете пользоваться этой командой.");

    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "Используйте: /ceject [id игрока]");

    if(params[0] == INVALID_PLAYER_ID || params[0] == playerid)
        return SendError(playerid, "Игрок не найден.");

    new
        player_state = GetPlayerState(playerid);

    if(player_state == PLAYER_STATE_WASTED || GetPlayerState(params[0]) == PLAYER_STATE_WASTED)
        return 1;

    if(player_state != PLAYER_STATE_ONFOOT)
        return SendError(playerid, "Вы должны находиться на ногах, чтобы выполнить данное действие.");

    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок слишком далеко от Вас.");

    if(0 == IsPlayerInAnyVehicle(params[0]))
        return SendError(playerid, "Игрок не в траспортном средстве.");

    new
        string[60 - 4 + MAX_PLAYER_NAME*2];

    format(string, sizeof(string), "{B17FC8}Полицейский %s вытащил %s из транспортного средства.", get_name(playerid), get_name(params[0]));
    SendDistanceChat(playerid, 20.0, string);

    GameTextForPlayer(params[0], "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~EJECTED", 3000, 3);
    RemovePlayerFromVehicle(params[0]);

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "Дверь машины закрыта.");
        MeAction(playerid, "открыв дверь автомобиля ухватился за нарушителя...");
        MeAction(playerid, "...затем вытолкнул его из автомобиля закрыв за собой дверь");
    }
    return 1;
}

//alias:shout("s");
CMD:s(playerid, params[])
{
    if(p_info[playerid][mute] > 0)
    {
        SendError(playerid, "У Вас блокировка чата.");
        return 0;
    }
    else if(isnull(params) || strlen(params) > 100) return SendInfo(playerid, "Используйте: /s [текст]");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s [%d] крикнул: %s", get_name(playerid),playerid,params);
    ProxDetector(30.0, playerid, STRING_GLOBAL, COLOR_GREEN, COLOR_GREEN, COLOR_GREEN, COLOR_GREEN, COLOR_GREEN);
    SetPlayerChatBubble(playerid, STRING_GLOBAL, COLOR_GREEN, 60.0, 10000);
    if(GetPlayerStatusUseAnim(playerid))
    {
        ApplyAnimationFix(playerid, "ON_LOOKERS", "shout_01", 4.1);
        p_temp[playerid][ClearAnimFix] = 1;
        p_temp[playerid][ClearAnimTimerFix] = timestamp + 5;
    }
    return 1;
}

CMD:time(playerid, params[])
{
    sscanf(params, "i", params[0]);
    if(params[0] < 0 || params[0] > 1) return SendError(playerid, "Тип должен быть не менее 0 и не более 1.");
    if(params[0] == 1 && GetPVarInt(playerid, "PlayerCuffed") == 1) return SendError(playerid, "Вы в наручниках, используйте: /time");
    if(p_info[playerid][mute] > 0) SendInfo(playerid, "До окончания блокировки чата: %s.", ConvertTime(p_info[playerid][mute]));
    if(p_info[playerid][jail_time] > 0) SendInfo(playerid, "До окончания тюремного срока: %s.", ConvertTime(p_info[playerid][jail_time]));
    if(p_info[playerid][rmute] > 0) SendInfo(playerid, "До окончания блокировки репорта: %s.", ConvertTime(p_info[playerid][rmute]));
    if(p_info[playerid][family_mute] > 0)
    {
        if(GetPlayerFamilyID(playerid) == -1) p_info[playerid][family_mute] = 0;
        else SendInfo(playerid, "До окончания блокировки чата семьи: %s.", ConvertTime(p_info[playerid][family_mute]));
    }

    new tdate[32], time[32];
    new year, month, day;
    getdate(year, month, day);
    new month_name[12][12] = {"Января", "Февраля", "Марта", "Апреля", "Мая", "Июня", "Июля", "Августа", "Сентября", "Октября", "Ноября", "Декабря"};
    format(tdate, sizeof(tdate), "%d %s %d г", day, month_name[month-1], year);
    if(timestamp_minute < 10) format(time, sizeof(time), "%d:0%d", timestamp_hour, timestamp_minute);
    else format(time, sizeof(time), "%d:%d", timestamp_hour, timestamp_minute);
    new day_name[7][12] = {"Четверг", "Пятница", "Суббота", "Воскресенье", "Понедельник", "Вторник", "Среда"};

    #if ACTION_100_HOUR == 1
        SendMes(playerid, COLOR_DARKORANGE, "[АКЦИЯ ЗА 100 ЧАСОВ ИГРЫ]: Выдается "W"Silver VIP на 14 дней и Nissan 370Z (RealCars). {FF6600}Отыграно: %s.", ConvertTime(p_info[playerid][gift_promocode_time]));
    #endif

    if(params[0] == 1)
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
        Сегодняшняя дата: {"#cGREEN"}%s"W"\n\
        День недели: {"#cGREEN"}%s"W"\n\
        Текущее время: {"#cBLUE"}%s"W"\n\n\
        Время в игре за час: {"#cGREEN"}%d мин"W"\n\
        Время в игре за сегодня: {"#cYELLOW"}%s"W"\n\
        Время в игре за вчера: {"#cYELLOW"}%s"W"\n\n\
        AFK за сегодня: "I"%s"W"\n\
        AFK за вчера: "I"%s"W"\n\n\
        Отыграно всего: {"#cLIGHTRED"}%s"W"\n\n\
        До получения бесплатной рулетки: {"#cGREEN"}%s",
        tdate, day_name[getDayEx()], time,
        p_info[playerid][p_time_payday]/60,
        ConvertTime(p_info[playerid][p_time_today]),
        ConvertTime(p_info[playerid][p_time_yesterday]),
        ConvertTime(p_info[playerid][p_afk_today]),
        ConvertTime(p_info[playerid][p_afk_yesterday]),
        ConvertTime(p_info[playerid][p_game_time]),
        ConvertTime(GetPlayerRouletteTime(playerid) - p_info[playerid][free_roulette_time]));
        ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Время", STRING_GLOBAL, "ОК", "");
    }
    else SendInfo(playerid, "Для подробной информации используйте: /time 1");

    new string[144];
    format(string, sizeof(string), "~y~%d:%02d ~n~~b~%02d-%d-%d", timestamp_hour, timestamp_minute, day, month, year);
    GameTextForPlayer(playerid, string, 5000, 1);
    MeAction(playerid, "взглянул(а) на часы.");

    if(GetPlayerStatusUseAnim(playerid))
    {
        ApplyAnimation(playerid,"COP_AMBIENT","Coplook_watch", 4.0, 0, 1, 1, 1, 1);
        p_temp[playerid][ClearAnimFix] = 1;
        p_temp[playerid][ClearAnimTimerFix] = timestamp + 5;
    }
    return 1;
}

CMD:alogin(playerid, params[])
{
    if(p_info[playerid][admin] < 1)
        return true;

    if(admin_acces[playerid] == true)
        return SendError(playerid, "Вы уже авторизованы как администратор.");

    ShowPlayerDialog(playerid, D_ALOGIN, DIALOG_STYLE_INPUT, ""I"Авторизация", ""W"Введите пароль от учетной записи администратора:\n\n{"#cLIGHTRED"}Обратите внимание! При вводе неверного пароля Вы будете отключены от сервера.", "Далее", "Отмена");
    return 1;
}

CMD:getip(playerid, params[])
{
    if(p_info[playerid][admin] < 3 && p_temp[playerid][premiumgamer] != PREMIUM_GAME) return 1;
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /getip [id игрока]");
    if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не найден.");
    if(p_info[playerid][admin] < p_info[params[0]][admin]) return 1;
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Никнейм: %s | Рег. IP: %s | Послед. IP: %s", get_name(params[0]), p_info[params[0]][regIP], p_temp[params[0]][session_IP]);
    SendInfo(playerid, STRING_GLOBAL);
    return 1;
}

CMD:slap(playerid, params[])
{
    if(p_info[playerid][admin] < 1 && p_info[playerid][youtube_adm] < 2 && p_temp[playerid][premiumgamer] != PREMIUM_GAME)
        return 1;

    if(p_info[playerid][helper] == 1) return SendError(playerid, "Команда недоступна для хелперов.");


    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "Используйте: /slap [id игрока]");

    if(params[0] == INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок не найден.");

    if(p_info[playerid][admin] < p_info[params[0]][admin])
        return 1;

    if(GetPVarInt(params[0],"BoneStol_ID")) return SendError(playerid, "Игрок за столом.");

    new
        Float:slx,
        Float:sly,
        Float:slz;

    GetPlayerPos(params[0], slx, sly, slz);
    SetPlayerPos(params[0], slx, sly, slz + 3.0);

    // PlayerPlaySound(params[0], 1130, slx, sly, slz + 5);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] подбросил %s [%d].", get_name(playerid), playerid, get_name(params[0]), params[0]);
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

    SendAccess(playerid, "Вы подбросили %s [%d].", get_name(params[0]), params[0]);
    SendInfo(params[0], "Администратор %s [%d] подбросил Вас.", get_name(playerid), playerid);

    WriteAdminLog(TYPE_LOG_SLAP, playerid, get_name(params[0]), params[0]);
    return 1;
}

CMD:explodeme(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10)
        return 1;

    new
        Float:x,
        Float:y,
        Float:z;

    GetPlayerPos(playerid, x, y, z);
    Fix_TogglePlayerControllable(playerid, 0);

    CreateExplosion(x, y, z, 7, 10.0);
    CreateExplosion(x, y+4.0, z, 7, 10.0);
    CreateExplosion(x, y-4.0, z, 7, 10.0);
    CreateExplosion(x+4.0, y, z, 7, 10.0);
    CreateExplosion(x-4.0, y, z, 7, 10.0);

    Fix_TogglePlayerControllable(playerid, 1);
    return 1;
}

CMD:sethp(playerid, params[])
{
    if(p_info[playerid][admin] < 3 && p_info[playerid][youtube_adm] < 1)
        return 1;

    new target, Float:health_count;
    if(sscanf(params, "uf", target, health_count)) return SendInfo(playerid, "Используйте: /sethp [id игрока] [кол-во здоровья]");

    if(target == INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок не найден.");

    if(!(0.0 <= health_count <= 100.0))
        return SendError(playerid, "Кол-во здоровья не может быть менее 0.0 и не более 100.0.");

    if(p_info[playerid][admin] < p_info[target][admin])
        return 1;

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] изменил здоровье %s [%d] на %.2f.", get_name(playerid), playerid, get_name(target), target, health_count);
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

    SendAccess(playerid, "Вы изменили %s [%d] здоровье на %.2f.", get_name(target), target, health_count);
    SendInfo(target, "Администратор %s [%d] изменил Вам здоровье на %.2f.", get_name(playerid), playerid, health_count);

    p_info[target][pHealth] = health_count;
    SetPlayerHealth(target, health_count);
    p_info[target][satiety] =
    p_info[target][thirst] = 100.0;

    new str[12];
    format(str, sizeof(str), "%.2f", health_count);
    Log(LOG_player, INFO, "%s[%d](%s %s) выдал %s HP игроку %s[%d](%s %s) | #AdminLogs",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", str,
        get_name(target), p_info[target][ID], p_temp[target][session_IP], IsPlayerMobile(target) ? "Mobile": "PC");
    return 1;
}

CMD:spawn(playerid, params[])
{
    if(p_info[playerid][admin] < 1 && p_info[playerid][youtube_adm] < 3)
        return 1;

    if(p_info[playerid][helper] == 1) {
        if(GetPVarInt(playerid, "BoneStol_ID")) return SendError(playerid, "Данный игрок в казино за столом, действие невозможно.");


        if(GetPlayerVehicleID(playerid) != 0)
        {
            new Float:P_pos[3];
            GetPlayerPos(playerid, P_pos[0],  P_pos[1],  P_pos[2]);
            SetPlayerPos(playerid, P_pos[0],  P_pos[1],  P_pos[2]+1.5);
        }
        ClearAnimations(playerid, true);
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[H] %s [%d] отправил на место появления самого себя.", get_name(playerid), playerid);
        SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

        SendAccess(playerid, "Вы отправились на место появления.");
        SpawnPlayer(playerid);

        Log(LOG_player, INFO, "%s[%d](%s %s) заспавнил %s[%d](%s %s) | #AdminLogs",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC");

    }
    else {
        if(sscanf(params, "i", params[0])) return SendInfo(playerid, "Используйте: /spawn [id игрока]");

        if(params[0] == INVALID_PLAYER_ID)
            return SendError(playerid, "Игрок не найден.");

        if(p_info[playerid][admin] < p_info[params[0]][admin])
            return 1;

        if(GetPVarInt(params[0], "BoneStol_ID")) return SendError(playerid, "Данный игрок в казино за столом, действие невозможно.");

        if(GetPlayerVehicleID(params[0]) != 0)
        {
            new Float:P_pos[3];
            GetPlayerPos(params[0], P_pos[0],  P_pos[1],  P_pos[2]);
            SetPlayerPos(params[0], P_pos[0],  P_pos[1],  P_pos[2]+1.5);
        }
        ClearAnimations(params[0], true);
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] отправил на место появления %s [%d].", get_name(playerid), playerid, get_name(params[0]), params[0]);
        SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

        SendAccess(playerid, "Вы отправили %s [%d] на место появления.", get_name(params[0]), params[0]);
        SendInfo(params[0], "Администратор %s [%d] отправил Вас на место появления.", get_name(playerid), playerid);
        SpawnPlayer(params[0]);

        Log(LOG_player, INFO, "%s[%d](%s %s) заспавнил %s[%d](%s %s) | #AdminLogs",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
            get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC");
   
    }
    return 1;
}

CMD:number(playerid, params[])
{
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /number [id игрока]");
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
    if(p_info[params[0]][phone_number] == 0) SendInfo(playerid, "Владелец: %s. Нет SIM карты.", get_name(params[0]));
    else SendInfo(playerid, "Владелец: %s. Телефон: %d.", get_name(params[0]), p_info[params[0]][phone_number]);
    return 1;
}

CMD:id(playerid, params[])
{
    new
        target = INVALID_PLAYER_ID;

    sscanf(params, "i", target);
    if(IsPlayerConnected(target) && target != INVALID_PLAYER_ID)
    {
        new
            string[25 - 6 + MAX_PLAYER_NAME + 5 + 9]; // 9 = 8 + 1 (с запасом, на всякий случай).

        if(p_info[target][p_afkTime] > 2)
            format(string, sizeof(string), "* Игрок: %s [%d] [AFK: %s]", get_name(target), target, ConvertTime(p_info[target][p_afkTime] - 2, 1));
        else
            format(string, sizeof(string), "* Игрок: %s [%d]", get_name(target), target);

        return SendMes(playerid, COLOR_GRAY, string);
    }
    else
    {
        if(isnull(params))
            return SendInfo(playerid, "Используйте: /id [id игрока или часть никнейма]");

        new
            string[29 - 8 + 3 + MAX_PLAYER_NAME + 5 + 9], // 9 = 8 + 1 (с запасом, на всякий случай).
            count = 0;

        foreach(new i: Player)
        {
            if(count >= 5) break;
            if(strfind(get_name(i), params, true) != -1)
            {
                if(p_info[i][p_afkTime] > 2)
                    format(string, sizeof(string), "* %d. Игрок: %s [%d] [AFK: %s]", ++count, get_name(i), i, ConvertTime(p_info[i][p_afkTime] - 2, 1));
                else
                    format(string, sizeof(string), "* %d. Игрок: %s [%d]", ++count, get_name(i), i);

                SendMes(playerid, COLOR_GRAY, string);
            }
        }

        if(count == 0)
            return SendError(playerid, "На сервере нет игроков по данным поиска.");
    }
    return 1;
}


CMD:clist(playerid, params[])
{
    if(GetPlayerStatusCapture(playerid)) return SendError(playerid, "Изменять цвет во время захватов территорий и бизнесов запрещено.");
    if(p_info[playerid][member] <= 0 && p_info[playerid][admin] <= 0) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(isnull(params))
    {
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL,""I"[0]"W" Выключить цвет\n"I"[1]"W" Зеленый\n"I"[2]"W" Светло зеленый\n"I"[3]"W" Ярко зеленый\n"I"[4]"W" Бирюзовый\n"I"[5]"W" Желто-зеленый\n"I"[6]"W" Темно-зеленый\n"I"[7]"W" Серо-зеленый\n"I"[8]"W" Красный\n"I"[9]"W" Ярко-красный\n"I"[10]"W" Оранжевый\n"I"[11]"W" Коричневый\n"I"[12]"W" Темно-красный\n"I"[13]"W" Cеро-красный\n"I"[14]"W" Желто-оранжевый\n"I"[15]"W" Малиновый\n"I"[16]"W" Розовый\n"I"[17]"W" Синий\n"I"[18]"W" Голубой\n"I"[19]"W" Синяя сталь\n"I"[20]"W" Сине-зеленый\n"I"[21]"W" Темно-синий\n"I"[22]"W" Фиолетовый\n"I"[23]"W" Индиго\n"I"[24]"W" Серо-синий\n"I"[25]"W" Желтый\n"I"[26]"W" Кукурузный\n"I"[27]"W" Золотой\n"I"[28]"W" Черный");
        return ShowPlayerDialog(playerid,D_CLIST,DIALOG_STYLE_LIST, ""I"Цвет",STRING_GLOBAL,"Выбрать","Отмена");
    }
    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "Используйте: /clist [id цвета]");
    switch(params[0]+1)
    {
        case 0: SetPlayerColor(playerid,0xFFFFFF20);
