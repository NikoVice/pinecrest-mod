                    if(p_info[playerid][p_vip]) strcat(STRING_GLOBAL, "/v - VIP чат\n");
                    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Общие команды", STRING_GLOBAL, "Отмена", "");
                }
                case 1:
                {
                    switch(p_info[playerid][member])
