                return SendError(playerid, "�� ������ ������������ �������� ��� �������.");
            }
            ShowPlayerDialog(playerid, D_TUNE_DEFAULT_ACT, DIALOG_STYLE_LIST, ""I"��������", ""I"[1]"W" ������� ������� �������\n"I"[2]"W" ������ ����� �������", "�����", "������");
            return 1;
