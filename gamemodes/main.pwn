                    // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) продал бизнес <%s - %s>(%d)[%d] в гос за %d$
                    Log(LOG_player, INFO, "%s[%d](%s %s) продал бизнес <%s - %s>(%d)[%d] в гос за %d$",
