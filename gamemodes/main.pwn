public OnPlayerEditDynamicObject(playerid, objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz)
{
    if(!FD(playerid) || p_info[playerid][admin] < 10) return 0;
    if(GetPVarInt(playerid, #edit_cctv))
        CCTV_OnPlayerEditDynamicObject(playerid, objectid, response, x, y, z, rx, ry, rz);

    BJ_OnPlayerEditDynObject(playerid, objectid, response, x, y, z, rx, ry, rz);

    if(response == EDIT_RESPONSE_FINAL)
    {// player clicked on sav�
        if(p_temp[playerid][p_listitem_int] == STATUS_ANTIDM_OBJECT)
        {
            AntiDMInfo[count_antidm][dmInfoX] = x;
            AntiDMInfo[count_antidm][dmInfoY] = y;
            AntiDMInfo[count_antidm][dmInfoZ] = z;
            AntiDMInfo[count_antidm][dmInfoRZ] = rz;
            CreateDMZ(playerid);
        }
        if(GetPVarInt(playerid, "modelid"))
        {
            printf("CreateDynamicObject(%d, %f, %f, %f, %f, %f, %f, -1, -1, -1, 100.0, 100.0);", GetPVarInt(playerid, "modelid"), x,y,z, rx, ry, rz);
        }
        if(p_temp[playerid][p_listitem][10] == objectid)
        {
            p_temp[playerid][p_listitem][10] = -1;
            new houseId = p_temp[playerid][p_listitem][11];

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `house` SET `h_gate_pos` = '%f|%f|%f|%f' WHERE `h_mysql_id` = %d",
                x, y, z, rz, h_info[houseId][h_mysql_id]);
            SendAdminMessage(COLOR_RED, STRING_GLOBAL);

            //if(SRV_ID == 0) WriteLog("zhouse", STRING_GLOBAL);
            h_info[houseId][h_gate_pos][0] = x;
            h_info[houseId][h_gate_pos][1] = y;
            h_info[houseId][h_gate_pos][2] = z;
            h_info[houseId][h_gate_pos][3] = rz;

            h_info[houseId][h_gate] = CreateDynamicObject(19912, h_info[houseId][h_gate_pos][0], h_info[houseId][h_gate_pos][1], h_info[houseId][h_gate_pos][2], 0.0, 0.0, h_info[houseId][h_gate_pos][3], -1, -1, -1, 120.0, 120.0);
            save_house(houseId);
            update_house(houseId);

            gate_house_idx[totalgatehouse] = houseId;
            totalgatehouse++;

            SendAccess(playerid, "�� ���������� ������ ��� ���� %d!", houseId);
        }
    }
    else if(response == EDIT_RESPONSE_CANCEL){// player cancelled (ESC)
        if(p_temp[playerid][p_listitem_int] == objectid)
        {
            p_temp[playerid][p_listitem_int] =
            p_temp[playerid][p_listitem][0] =
            p_temp[playerid][p_listitem][1] = -1;
        }
        if(p_temp[playerid][p_listitem][10] == objectid)
            p_temp[playerid][p_listitem][10] = -1;
        DestroyDynamicObject(objectid);
    }
    else if(response == EDIT_RESPONSE_UPDATE){// player moved the object (edition did not stop at all)
        SetDynamicObjectPos(objectid, x, y, z);
        SetDynamicObjectRot(objectid, rx, ry, rz);
    }
    return 1;
}
