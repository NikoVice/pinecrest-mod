            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `v_model`, `v_mysql_id`, `v_twinturbo`, `v_premium`, `v_bonus`, `v_sell_block`, `v_number` FROM `vehicle` WHERE `v_owner_id` = %d",
            p_info[playerid][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL, "OnPlayerCarMarketVehicleList", "ii", playerid, listitem);
            return 1;
        }
        case D_CAR_MARKET_VEHICLE:
        {
            new vehicle_model = p_temp[playerid][p_listitem][listitem];
            p_temp[playerid][p_listitem][listitem] = -1;
            if(!response) return DeletePVar(playerid, "CarMarket:idx");
            if(listitem >= p_temp[playerid][loadcar_max]) return SendError(playerid, "В данном слоте ничего нет."), DeletePVar(playerid, "CarMarket:idx");
            else
            {
                if(listitem == -1) return SendError(playerid, "Что-то пошло не так, попробуйте заново или обновите версию клиента."), DeletePVar(playerid, "CarMarket:idx");
                if(p_temp[playerid][p_listitem_cars][listitem] == -1) return ShowPlayerDialog(playerid, D_CAR_MARKET_LIST, DIALOG_STYLE_LIST, ""I"Тип транспортного средства", ""I"[1]"W" Велик\n"I"[2]"W" Мото\n"I"[3]"W" Автомобиль", "Далее", "Отмена"), DeletePVar(playerid, "CarMarket:idx");
                new index_list = p_temp[playerid][p_listitem_cars][listitem],
                    vehicleid = GetPlayerVehicleMySQLID(playerid, index_list, E_PLAYER_VEHICLES_VALUE:E_VEHICLIE_ID);
                p_temp[playerid][p_listitem_cars][listitem] = -1;

                if(vehicleid == -1)
                {
                    if(GetFreeSlotVehicle(playerid) == ALL_BUSY_SLOT_VEHICLE)
                    {
                        SendError(playerid, "У Вас уже есть загруженные транспортные средства.");
                        SendInfo(playerid, "Используйте /cars чтобы выгрузить их из сервера.");
                        DeletePVar(playerid, "CarMarket:idx");
                        return 1;
                    }

                    ShowPlayerCarMarketDialog(playerid, vehicle_model, index_list);
                    return 1;
                }

                if(index_list == veh_info[vehicleid][v_mysql_id])
                {
                    SendError(playerid, "Данное транспортное средство уже загружено.");
                    SendInfo(playerid, "Используйте /cars чтобы выгрузить его с сервера.");
                    DeletePVar(playerid, "CarMarket:idx");
                    return 1;
                }
            }
            return 1;
        }
        case D_CAR_MARKET_BET:
        {
            new input_price,
                idx = GetPVarInt(playerid, "CarMarket:idx"),
                vehicle_model = GetPVarInt(playerid, "CarMarket:vehicle_model"),
                index_list = GetPVarInt(playerid, "CarMarket:mysql_idx");

            DeletePVar(playerid, "CarMarket:idx");
            DeletePVar(playerid, "CarMarket:vehicle_model");
            DeletePVar(playerid, "CarMarket:mysql_idx");

            if(!response) return 1;

            if(!IsTextNums(inputtext, _, _)) 
            {
                ShowPlayerCarMarketDialog(playerid, vehicle_model, index_list);
                return SendError(playerid, "Вы не можете вводить точки, запятые и пробелы.");
            }
            if(sscanf(inputtext, "i", input_price)) 
            {
                ShowPlayerCarMarketDialog(playerid, vehicle_model, index_list);
                return SendError(playerid, "Вы ничего не ввели.");
            }

            new price = GetVehicleData(vehicle_model, E_VD_PRICE);
            if(input_price < price / 2 || input_price > price * 3)
            {
                ShowPlayerCarMarketDialog(playerid, vehicle_model, index_list);
                return SendError(playerid, "Стоимость должна быть от %d$ до %d$.", price / 2, price * 3);
            }

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `vehicle` WHERE `v_mysql_id` = %d AND `v_owner_id` = %d LIMIT 1",
            index_list, p_info[playerid][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL, "OnPlayerLoadVehicleCarMarket", "iii", playerid, idx, input_price);
            return 1;
        }
        case D_CAR_MARKET_UNBET:
        {
            if(!response) return 1;
            if(!IsPlayerInDynamicArea(playerid, VEHICLE_MARKET_CUBE)) return SendError(playerid, "Вы должны быть на территории авторынка.");
            new idx = p_temp[playerid][market_vehicle_id];
            if(idx == -1) return SendError(playerid, "Произошла ошибка, не определено парковочное место, попробуйте ещё раз.");
            new vehicleid = CarMarketInfo[idx][cmVehicleIDx];
            if(!IsPlayerOwnerVehicle(playerid, vehicleid)) return SendError(playerid, "Данное транспортное средство не принадлежит Вам.");
            CarMarketVehicleDestroy(playerid, vehicleid);
            return 1;
        }
        case D_CAR_MARKET_BUY:
        {
            if(!response) return 1;
            if(!IsPlayerInDynamicArea(playerid, VEHICLE_MARKET_CUBE)) return SendError(playerid, "Вы должны быть на территории авторынка.");

            new pos_id = p_temp[playerid][market_vehicle_id];
            if(pos_id == -1) return 1;

            new vehicleid = CarMarketInfo[pos_id][cmVehicleIDx];
            if(vehicleid == INVALID_VEHICLE_ID) return 1;

            new vehicle_model = GetVehicleModelEx(vehicleid), price = CarMarketInfo[pos_id][cmPrice],
                rows = GetPlayerCountCars(p_info[playerid][ID], GetVehicleData(vehicle_model, E_VD_TYPE)),
                count_limit = GetPlayerLimiteCars(playerid, GetVehicleData(vehicle_model, E_VD_TYPE));

            if(rows >= count_limit)
                return SendError(playerid, "У Вас превышен лимит на данный класс транспортного средства.");

            if(vehicle_model == 508 && GetPlayerCheckTreiler(p_info[playerid][ID]))
                return SendError(playerid, "У Вас уже есть трейлер.");

            if(p_info[playerid][cash] < price)
                return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            new owner_id = GetPlayerUserID(veh_info[vehicleid][v_owner_id]);
            if(owner_id == INVALID_PLAYER_ID)
            {
                CarMarketVehicleClear(pos_id);
                return SendError(playerid, "Владелец не в сети");
            }
            SetPlayerMoney(playerid, -price, true, "купил т/с на авторынке");

            switch(random(5))
            {
                case 0: veh_info[vehicleid][v_pos][0] = 1764.5479, veh_info[vehicleid][v_pos][1] = -1810.0615, veh_info[vehicleid][v_pos][2] = 13.3006, veh_info[vehicleid][v_pos][3] = 90.0000;
                case 1: veh_info[vehicleid][v_pos][0] = 1764.5479, veh_info[vehicleid][v_pos][1] = -1805.0815, veh_info[vehicleid][v_pos][2] = 13.3006, veh_info[vehicleid][v_pos][3] = 90.0000;
                case 2: veh_info[vehicleid][v_pos][0] = 1764.5479, veh_info[vehicleid][v_pos][1] = -1800.0614, veh_info[vehicleid][v_pos][2] = 13.3006, veh_info[vehicleid][v_pos][3] = 90.0000;
                case 3: veh_info[vehicleid][v_pos][0] = 1764.5479, veh_info[vehicleid][v_pos][1] = -1795.0615, veh_info[vehicleid][v_pos][2] = 13.3006, veh_info[vehicleid][v_pos][3] = 90.0000;
                default: veh_info[vehicleid][v_pos][0] = 1764.5479, veh_info[vehicleid][v_pos][1] = -1790.0215, veh_info[vehicleid][v_pos][2] = 13.3006, veh_info[vehicleid][v_pos][3] = 90.0000;
            }

            veh_info[vehicleid][v_int] =
            veh_info[vehicleid][v_virt] = 0;

            SendAccess(owner_id, "Вы продали транспортное средство "I"\"%s\". "W"На банковский счет зачислено: "I"%d$.", GetVehicleName(vehicleid), price);
            p_info[owner_id][bank] += price;
            MysqlUpdatePlayerInt(owner_id, "bank", p_info[owner_id][bank]);

            veh_info[vehicleid][v_owner_id] = p_info[playerid][ID];
            SaveVehicle(vehicleid);
            DestroyVehicleVEx(vehicleid);

            SendInfo(playerid, "Поздравляем, Вы стали владельцем транспортного средства.");
            SendInfo(playerid, "Используйте /cars чтобы загрузить его на сервер.");

            Log(LOG_player, INFO, "%s[%d](%s %s) купил <%s>(%d)[%d] у %s[%d](%s %s) на авторынке за %d$",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id],
                get_name(owner_id), p_info[owner_id][ID], p_temp[owner_id][session_IP], IsPlayerMobile(owner_id) ? "Mobile": "PC",
                price);

            Log(LOG_player, INFO, "%s[%d](%s %s) продал <%s>(%d)[%d] игроку %s[%d](%s %s) на авторынке за %d$",
                get_name(owner_id), p_info[owner_id][ID], p_temp[owner_id][session_IP], IsPlayerMobile(owner_id) ? "Mobile": "PC",
                GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id],
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                price);

            CarMarketVehicleClear(pos_id);
            return 1;
        }
        case D_FRACTION_LEAVE:
        {
            if(!response) return 1;
            if(p_info[playerid][Update][0] == 0 && p_info[playerid][p_vip] < 2 && p_info[playerid][admin] < 1) return SendError(playerid, "У Вас нет улучшения \"Решительности\" или \"VIP Silver\" или \"VIP GOLD\".");
            if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Вы находитесь в транспортном средстве.");
            if(p_info[playerid][member] <= 0) return SendError(playerid, "Вы не состоите во фракции.");
            if(p_info[playerid][leader] > 0 && p_info[playerid][admin] < 1) return SendError(playerid, "Вы лидер фракции.");

            SendAccess(playerid, "Вы покинули \"%s\" по собственному желанию.", GetFractionName(p_info[playerid][member]));

            if(GetPlayerStatusCapture(playerid))
                HideTextDrawForPlayer(playerid, TD_ID_CAPTURE);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `log_fraction` (`PlayerID`, `Member`, `Rang`, `Type`, `Reason`) VALUES (%d, %d, %d, '1', 'Ушел по С/Ж')",
            p_info[playerid][ID], p_info[playerid][member], p_info[playerid][rang]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            Iter_Remove(gFactionPlayers[p_info[playerid][member]], playerid);
            p_info[playerid][member] = 0;
            p_info[playerid][leader] = 0;
            p_info[playerid][rang] = 0;
            p_info[playerid][fskin] = 0;
            Iter_Add(gFactionPlayers[p_info[playerid][member]], playerid);
            if(GetPlayerHouseID(playerid) != INVALID_HOUSE_ID) p_info[playerid][spawn] = SPAWN_HOUSE;
            else p_info[playerid][spawn] = 0;
            p_info[playerid][fwork] = false;
            SetPlayerSkinEx(playerid);
            SetPlayerColor(playerid, fraction_color[0]);
            if(GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_PD || GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_FBI)
                p_temp[playerid][StatusOnDuty] = 0;
            save_player(playerid);

            f_ResetPlayerWeapons(playerid);

            /*
            p_info[playerid][ftop_gkills_week] = 
            p_info[playerid][ftop_gdeaths_week] = 0;
            p_info[playerid][ftop_gdamagegive_week] = 
            p_info[playerid][ftop_gdamagetake_week] = 0;
            
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `ftop_gkills_week` = 0, `ftop_gdeaths_week`  = 0, `ftop_gdamagegive_week` = 0.0, `ftop_gdamagetake_week` = 0.0 WHERE `id` = %d", p_info[playerid][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL);
            */
            return 1;
        }
        case D_FRACTION_DATA_MENU:
        {
            if(!response) return 1;
            if(p_info[playerid][admin] < 7) return 1;
            new fraction_id = p_temp[playerid][p_listitem_int];
            STRING_GLOBAL[0] = EOS;
            switch(listitem)
            {
                case 0:
                {
                    f(STRING_GLOBAL, ""W"Введите новое название для "I"%s", GetFractionName(fraction_id));
                    ShowPlayerDialog(playerid, D_FRACTION_SET_NAME, DIALOG_STYLE_INPUT, "Название фракции", STRING_GLOBAL, "Ввести", "Отмена");
                }
                case 1,2: return 1;
                case 3: SetFractionSpawnPos(playerid, fraction_id);
                case 4: SetFractionDressingPos(playerid, fraction_id);
                case 5: SetFractionWarehousePos(playerid, fraction_id);
                case 6, 8: return 1; //ничего
                case 7: SetFractionUnloadingPos(playerid, fraction_id);
                case 9: ShowFractionSkins(playerid, fraction_id, F_WOMAN_SKIN); //женские скины
                case 10: ShowFractionSkins(playerid, fraction_id, F_MAN_SKIN); // мужские скины
                case 11:
                {
                    for(new i; i < MAX_FRACTIONS_RANGS; i++)
                        f(STRING_GLOBAL, "%s"I"[%d]"W" %s\t%d$\n", STRING_GLOBAL, i+1, GetFractionRangName(fraction_id, i+1), FractionsData[fraction_id][fPay][i]);
                    ShowPlayerDialog(playerid, D_FRACTION_LIST_PAYS, DIALOG_STYLE_TABLIST, ""I"Зарплаты фракции", STRING_GLOBAL, "Выбрать","Назад");
                }
                case 12:
                {
                    for(new i; i < MAX_FRACTIONS_RANGS; i++)
                        f(STRING_GLOBAL, "%s"I"[%d]"W" %s\n", STRING_GLOBAL, i+1, GetFractionRangName(fraction_id, i+1));
                    f(STRING_GLOBAL, "%s"I"[%d]"W" Вернуть стандартные названия", STRING_GLOBAL, MAX_FRACTIONS_RANGS+1);
                    ShowPlayerDialog(playerid, D_FRACTION_LIST_NAME_RANGS, DIALOG_STYLE_LIST, ""I"Названия рангов", STRING_GLOBAL, "Выбрать","Назад");
                }
                case 13:
                {
                    f(STRING_GLOBAL,
                        "- Деньги\t%d$\n\
                        - %s\t%d шт.\n\
                        - Материалы: %d шт.\n\
                        - Патроны: %d шт.\n\
                        - Канистры: %d шт.\n\
                        - Рем.комплекты: %d шт.\n\
                        - Аптечки: %d шт.\n\
                        - Маски: %d шт.",
                        GetFractionWarehouse(fraction_id, fwMoney),
                        FractionsData[fraction_id][fType] == FACTION_TYPE_CRIMINAL ? "Наркотики" : "Медикаменты",
                        GetFractionWarehouse(fraction_id, fwDrugs),
                        GetFractionWarehouse(fraction_id, fwMate),
                        GetFractionWarehouse(fraction_id, fwPatron),
                        GetFractionWarehouse(fraction_id, fwFuel),
                        GetFractionWarehouse(fraction_id, fwRemp),
                        GetFractionWarehouse(fraction_id, fwHeal),
                        GetFractionWarehouse(fraction_id, fwMask));
                    ShowPlayerDialog(playerid, D_FRACTION_WAREHOUSE_INFO, DIALOG_STYLE_LIST, ""I"Склад", STRING_GLOBAL, "Выбрать","Назад");
                }
                case 14:
                {
                    f(STRING_GLOBAL, "\
                        Склад: %s\n\
                        Двери: %s\n\
                        Раздевалка: %s",
                        GetFractionSettings(fraction_id, fWareHouseStatus) ? "Открыт" : "Закрыт",
                        GetFractionSettings(fraction_id, fDoorStatus) ? "Открыты" : "Закрыты",
                        GetFractionSettings(fraction_id, fDressingStatus) ? "Открыта" : "Закрыта");
                    ShowPlayerDialog(playerid, D_FRACTION_SETTINGS_LIST, DIALOG_STYLE_LIST, ""I"Настройки", STRING_GLOBAL, "Выбрать","Назад");
                }
                case 15: 
                    ShowPlayerDialog(playerid, D_FRACTION_VEHICLE_MENU, DIALOG_STYLE_LIST, ""I"Настройки", "Установить место спавна Т/С\nИзменить модель Т/С", "Выбрать","Назад");
                    //
            }
            return 1;
        }
        case D_FRACTION_VEHICLE_MENU:
        {
            if(!response) return 1;
            if(p_info[playerid][admin] < 7) return 1;
            new fraction_id = p_temp[playerid][p_listitem_int];
            switch(listitem)
            {
                case 0: SetFractionVehSpawnPos(playerid, fraction_id);
                case 1:
                {
                    STRING_GLOBAL = "#\tМодель/Ранг\tВсего\n";
                    for(new i; i < MAX_FRACTIONS_VEHICLES; i++)
                    {
                        if(i > 0 && FractionsData[fraction_id][fVehModelsID][i-1] == 0) break;
                        if(FractionsData[fraction_id][fVehModelsID][i] == 0) f(STRING_GLOBAL, "%s- Пусто [Добавить]\n", STRING_GLOBAL);
                        else f(STRING_GLOBAL, "%s"I"[%d]"W"\t%s(%d)\t%d/%d\n", STRING_GLOBAL, i+1,
                            GetVehicleName(INVALID_VEHICLE_ID, FractionsData[fraction_id][fVehModelsID][i]), 
                            FractionsData[fraction_id][fVehAccessRank][i], FractionsData[fraction_id][fVehModelMaxCount][i]);
                    }
                    STRING_MIN[0] = EOS;
                    f(STRING_MIN, ""W"Автомобили фракции: "I"%s", FractionsData[fraction_id][fName]);
                    ShowPlayerDialog(playerid, D_FRACTION_VEHICLE_CHANGE, DIALOG_STYLE_TABLIST_HEADERS, STRING_MIN, STRING_GLOBAL, "Выбрать", "Отмена");
                }
            }
            return 1;
        }
        case D_FRACTION_VEHICLE_CHANGE:
        {
            if(!response) return 1;
            if(p_info[playerid][admin] < 7) return 1;
            new fraction_id = p_temp[playerid][p_listitem_int];
            SetPVarInt(playerid, #FRACTION_VEH_LISTITEM, listitem);
            STRING_MIN[0] = EOS;
            f(STRING_MIN, ""W"Автомобили фракции: "I"%s", FractionsData[fraction_id][fName]);
            ShowPlayerDialog(playerid, D_FRACTION_VEHICLE_VALUE, DIALOG_STYLE_INPUT, STRING_MIN, ""W"Введите: ID model, rang(1-10), количество (1-10)", "Выбрать", "Отмена");
            return 1;
        }
        case D_FRACTION_VEHICLE_VALUE:
        {
            listitem = GetPVarInt(playerid, #FRACTION_VEH_LISTITEM);
            if(!response) return 1;
            if(p_info[playerid][admin] < 7) return 1;
            new fraction_id = p_temp[playerid][p_listitem_int],
                modelid, rangid, count;
            if(sscanf(inputtext, "p<,>iii", modelid, rangid, count)) return SendError(playerid, "Что-то не так, попробуйте еще раз.");
            if(modelid < 400 && modelid != 0) return SendError(playerid, "Что-то не так, попробуйте еще раз.");
            if(!(1 <= rangid <= MAX_FRACTIONS_RANGS)) return SendError(playerid, "Что-то не так, попробуйте еще раз.");
            if(!(1 <= count <= 10)) return SendError(playerid, "Что-то не так, попробуйте еще раз.");
            new idx = GetSlotFractionVehicle(fraction_id, modelid);
            if(idx != -1 && idx != listitem)
                return SendError(playerid, "Данная модель уже есть в автопарке фракции под другим слотом #%d.", idx+1);
            if(FractionsData[fraction_id][fVehModelUseCount][listitem] != 0)
                return SendError(playerid, "Кто-то использует модель в этом слоте.");

            FractionsData[fraction_id][fVehModelsID][listitem] = modelid;
            FractionsData[fraction_id][fVehAccessRank][listitem] = rangid;
            FractionsData[fraction_id][fVehModelMaxCount][listitem] = count;
            FractionsData[fraction_id][fVehModelUseCount][listitem] = 0;

            SaveFractionVehParkings(fraction_id);
            return 1;
        }
        case D_FRACTION_SETTINGS_LIST:
        {
            if(!response) return 1;
            if(p_info[playerid][admin] < 7) return 1;
            new fraction_id = p_temp[playerid][p_listitem_int];
            SetFractionSettings(fraction_id, listitem, !GetFractionSettings(fraction_id, listitem));
            SendAccess(playerid, "Вы %s %s фракции.", GetFractionSettings(fraction_id, listitem) ? "открыли" : "закрыли", listitem  == fWareHouseStatus ? "склад" : listitem == fDoorStatus ? "дверь " : "раздевалку");
            return 1;
        }
        case D_FRACTION_SET_WAREHOUSE:
        {
            if(!response) return 1;
            if(p_info[playerid][admin] < 7) return 1;
            new newvalue;
            if(sscanf(inputtext, "i", newvalue)) return SetFractionWarehouseValue(playerid);
            new fraction_id = p_temp[playerid][p_listitem_int],
                list_id = p_temp[playerid][p_listitem][31];

            SetFractionWarehouse(fraction_id, list_id, newvalue);
            SendAccess(playerid, "Вы изменили значение для данного параметра склада.");
            return 1;
        }
        case D_FRACTION_WAREHOUSE_INFO:
        {
            if(!response) return 1;
            if(p_info[playerid][admin] < 7) return 1;
            p_temp[playerid][p_listitem][31] = listitem;
            SetFractionWarehouseValue(playerid);
            return 1;
        }
        case D_FRACTION_SET_NAME_RANG:
        {
            if(!response) return 1;
            if(p_info[playerid][admin] < 7) return 1;
            new newrang[32];
            if(!(3 <= strlen(inputtext) <= 22) ||
                sscanf(inputtext, "s[24]", newrang)) return SetFractionNameRangs(playerid);

            new fraction_id = p_temp[playerid][p_listitem_int],
                list_id = p_temp[playerid][p_listitem][31];

            SendAccess(playerid, "Вы сменили ранг %s(%d) на %s", GetFractionRangName(fraction_id, list_id+1), list_id+1, newrang);

            format(FractionsData_NameRang[fraction_id][list_id], 24, newrang);

            SaveFractionNameRang(fraction_id);

            p_temp[playerid][p_listitem][31] = -1;
            return 1;
        }
        case D_FRACTION_LIST_NAME_RANGS:
        {
            if(!response) return 1;
            if(p_info[playerid][admin] < 7) return 1;
            if(!(1 <= p_temp[playerid][p_listitem_int] < MAX_FRACTIONS)) return SendError(playerid, "Не найден ид фракции, ошибка.");
            if(listitem == MAX_FRACTIONS_RANGS)
            {
                new fraction_id = p_temp[playerid][p_listitem_int];
                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `rang_name_default` FROM `fractions_data` WHERE `id` = %d", fraction_id);
                mysql_tquery(con_bd, STRING_GLOBAL, "SetFractionRangDefault", "i", fraction_id);

                SendAccess(playerid, "Ранги для %s возвращены на стандартные.", GetFractionName(fraction_id));
            }
            else
            {
                p_temp[playerid][p_listitem][31] = listitem;
                SetFractionNameRangs(playerid);
            }
            return 1;
        }
        case D_FRACTION_LIST_PAYS:
        {
            if(!response) return 1;
            if(p_info[playerid][admin] < 7) return 1;
            p_temp[playerid][p_listitem][31] = listitem;
            SetFractionPays(playerid);
            return 1;
        }
        case D_FRACTION_SET_PAY:
        {
            if(!response) return 1;
            if(p_info[playerid][admin] < 7) return 1;
            new newpay;
            if(sscanf(inputtext, "i", newpay)) return SetFractionPays(playerid);
            new fraction_id = p_temp[playerid][p_listitem_int],
                list_id = p_temp[playerid][p_listitem][31];

            SendAccess(playerid, "Вы сменили зарплату %s(%d) с %d$ на %d$", GetFractionRangName(fraction_id, list_id+1), list_id+1, FractionsData[fraction_id][fPay][list_id], newpay);

            FractionsData[fraction_id][fPay][list_id] = newpay;

            SaveFractionPay(fraction_id);

            p_temp[playerid][p_listitem][31] = -1;
            return 1;
        }
        case D_FRACTION_SET_SKIN:
        {
            if(!response) return 1;
            if(p_info[playerid][admin] < 7) return 1;
            new skin_id;
            if(sscanf(inputtext, "i", skin_id))
                return ShowDialogFractionSkins(playerid);

            new fraction_id = p_temp[playerid][p_listitem][30],
                list_id = p_temp[playerid][p_listitem][32],
                sex_id = p_temp[playerid][p_listitem][31];

            SendAccess(playerid, "Вы сменили скин %d на %d", sex_id == F_MAN_SKIN ? FractionsData[fraction_id][fManSkin][list_id] : FractionsData[fraction_id][fWomanSkin][list_id], skin_id);

            if(sex_id == F_MAN_SKIN) FractionsData[fraction_id][fManSkin][list_id] = skin_id;
            else FractionsData[fraction_id][fWomanSkin][list_id] = skin_id;

            SaveFractionSkins(fraction_id, sex_id);

            p_temp[playerid][p_listitem][30] =
            p_temp[playerid][p_listitem][32] =
            p_temp[playerid][p_listitem][31] = -1;
            return 1;
        }
        case D_FRACTION_SET_NAME:
        {
            if(!response) return 1;
            if(p_info[playerid][admin] < 7) return 1;
            new fraction_id = p_temp[playerid][p_listitem_int];

            SendAccess(playerid, "Вы сменили название фракции %s на %s", FractionsData[fraction_id][fName], inputtext);
            format(FractionsData[fraction_id][fName], 36, "%s", inputtext);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `fractions_data` SET `name` = '%s' WHERE `id` = %d",
                FractionsData[fraction_id][fName], fraction_id);
            mysql_tquery(con_bd, STRING_GLOBAL);
            return 1;
        }
        case D_AIR_BALLOON_MENU:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0: callcmd::createairballoon(playerid, "/0");
                case 1: callcmd::destroyairballoon(playerid, "/0");
                case 2:
                {
                    ShowPlayerDialog(playerid, D_AIR_BALLOON_MENU_BACK, DIALOG_STYLE_MSGBOX, ""I"Информация", ""W"\
                        Для полета на "I"воздушном шаре"W" Вам необходимо:\n\n\
                        \t"I"—"W" Находиться на территории одного из аэропортов;\n\
                        \t"I"—"W" Наличие уникального аксессуара \"Воздушный шар\";\n\
                        \t"I"—"W" Наличие 2 ед. металла и 2 ед. дерева;\n\n\
                        Если Вы покинете шар - он автоматически удалится.", "ОК", "");
                }
            }
            return 1;
        }
        case D_AIR_BALLOON_MENU_BACK: return callcmd::airballoon(playerid, "/0");
        case D_WANTED_MENU:
        {
            if(!response) return 1;
            if(!listitem) ShowPlayerList(playerid, LIST_ID_WANTED_ONLINE);
            else ShowPlayerList(playerid, LIST_ID_WANTED_OFFLINE);
            return 1;
        }
        case D_FRACTION_MENU:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0:
                {
                    if(p_info[playerid][rang] < 7) return SendError(playerid, "У вас нет доступа.");
                    STRING_GLOBAL = ""I"[#] "W"Действите\t"I"[#] "W"Ранг доступа \n\
                        "I"[1] "W"Принять\t"I"[9+]\n\
                        "I"[2] "W"Уволить\t"I"[8+]\n\
                        "I"[3] "W"Уволить "E"(offline)\t"I"[9+]\n\
                        "I"[4] "W"Сменить ранг\t"I"[9+]\n\
                        "I"[5] "W"Выдать выговор\t"I"[9+]\n\
                        "I"[6] "W"Снять выговор\t"I"[9+]\n\
                        "I"[7] "W"Сменить форму\t"I"[9+]\n\
                        "I"[8] "W"Черный список\t"I"[9+]\n\
                        "I"[9] "W"Автопарк\t"I"[9+]\n";

                    if(mafia(playerid) || gang(playerid) || biker(playerid)) strcat(STRING_GLOBAL, ""I"[10]"W" Закрыть/открыть склад\t"I"[9+]\n");
                    if(gang(playerid) != 0) strcat(STRING_GLOBAL, ""I"[11]"W" Закрыть/открыть входную дверь\t"I"[9+]\n");
                    //if(gang(playerid) != 0 && DrugDenInfo[ddOwner] == p_info[playerid][member]) strcat(STRING_GLOBAL, ""I"[12]"W" Стоимость наркотиков\t"I"[10+]");
                    if(GetFactionType(p_info[playerid][member]) == FACTION_TYPE_SNN)
                    {
                        strcat(STRING_GLOBAL, ""I"[10]"W" Панель СМИ\t"I"[10+]\n");
                        strcat(STRING_GLOBAL, ""I"[11]"W" Настройка оплаты\t"I"[10+]\n");
                        strcat(STRING_GLOBAL, ""I"[12]"W" Закрыть/открыть входную дверь\t"I"[9+]\n");
                    }
                    ShowPlayerDialog(playerid, D_LEADER_MENU, DIALOG_STYLE_TABLIST_HEADERS, "Меню управления", STRING_GLOBAL, "Выбор", "Отмена");
                }
                case 1: callcmd::members(playerid, "/0");
                case 2: ShowPlayerList(playerid, LIST_ID_FRACTION_ALL_MEMBERS);
                case 3: callcmd::myfstats(playerid, "/0");
                case 4: callcmd::leave(playerid, "/0");
            }
            return 1;
        }
        case D_LEADER_MENU:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0:
                {
                    if(p_info[playerid][rang] < 9) return SendError(playerid, "У Вас нет доступа.");
                    ShowPlayerDialog(playerid, D_FRACTION_INVITE, DIALOG_STYLE_INPUT, ""I"Принять в фракцию", ""W"Введите ID игрока в поле ниже:", "Выбрать", "Закрыть");
                }
                case 1:
                {
                    if(p_info[playerid][rang] < 8) return SendError(playerid, "У Вас нет доступа.");
                    ShowPlayerDialog(playerid, D_FRACTION_UNINVITE, DIALOG_STYLE_INPUT, ""I"Уволить из фракции", ""W"Введите ID игрока в поле ниже:", "Выбрать", "Закрыть");
                }
                case 2:
                {
                    if(p_info[playerid][rang] < 9) return SendError(playerid, "У Вас нет доступа.");
                    ShowPlayerDialog(playerid, D_FRACTION_UNINVITE_OFFLINE, DIALOG_STYLE_INPUT, ""I"Панель лидера: Увольнение", ""W"Для увольнения члена Вашей организации введите его имя в поле ниже:", "Уволить", "Закрыть");
                }
                case 3:
                {
                    if(p_info[playerid][rang] < 9) return SendError(playerid, "У Вас нет доступа.");
                    ShowPlayerDialog(playerid, D_FRACTION_CHANGERANG, DIALOG_STYLE_INPUT, ""I"Сменить ранг", ""W"Введите ID игрока, новый ранг(через запятую)", "Выбрать", "Закрыть");
                }
                case 4:
                {
                    if(p_info[playerid][rang] < 9) return SendError(playerid, "У Вас нет доступа.");
                    return ShowPlayerDialog(playerid, D_FRACTION_WARN, DIALOG_STYLE_INPUT, ""I"Выдать выговор", ""W"Используйте: "I"ID игрока, причину(через запятую)","Далее","Отмена");
                }
                case 5:
                {
                    if(p_info[playerid][rang] < 9) return SendError(playerid, "У Вас нет доступа.");
                    ShowPlayerDialog(playerid, D_FRACTION_UNWARN, DIALOG_STYLE_INPUT, ""I"Снять выговор", ""W"Используйте: "I"ID игрока, причину(через запятую)","Далее","Отмена");
                }
                case 6:
                {
                    if(p_info[playerid][rang] < 9) return SendError(playerid, "У Вас нет доступа.");
                    ShowPlayerDialog(playerid, D_FRACTION_CHANGESKIN, DIALOG_STYLE_INPUT, ""I"Сменить скин", ""W"Введите ID игрока в поле ниже:", "Выбрать", "Закрыть");
                }
                case 7: return callcmd::blacklist(playerid, "/0");
                case 8:
                {
                    if(p_info[playerid][rang] < 9) return SendError(playerid, "У Вас нет доступа.");
                    callcmd::fcars(playerid, "/0");
                }
                case 9:
                {
                    if(p_info[playerid][rang] < 10) return SendError(playerid, "У Вас нет доступа.");
                    switch(p_info[playerid][leader])
                    {
                        case RADIO_LS, RADIO_SF, RADIO_LV:
                        {
                            ShowPlayerDialog(playerid, D_NEWS_MENU, DIALOG_STYLE_LIST, ""I"Панель",
                             ""I"[1]"W" Установить стоимость 1 секунды в эфире\n"I"[2]"W" Установить стоимость 1 сообщения", "Далее", "Отмена");
                            return 1;
                        }
                        case MAFIA_RM..VAGOS, MAFIA_IRAN:
                        {
                            callcmd::storage(playerid, "/0");
                            return 1;
                        }
                    }
                }
                case 10:
                {
                    callcmd::fdoor(playerid, "/0");
                }
                case 11:
                {
                    if(p_info[playerid][rang] < 10) return SendError(playerid, "У Вас нет доступа.");
                    switch(p_info[playerid][leader])
                    {
                        case RADIO_LS, RADIO_SF, RADIO_LV:
                        {
                            callcmd::fdoor(playerid, "/0");
                        }
                    }
                }
            }
            return 1;
        }
        case D_FRACTION_GIVERANG:
        {
            new targetid = GetPVarInt(playerid, #GIVE_RANK_ID);
            if(!response)
                return 1;
            f(STRING_GLOBAL, "%d %d", targetid, listitem+1);
            callcmd::rang(playerid, STRING_GLOBAL);
            return 1;
        }
        case D_FRACTION_CHANGERANG:
        {
            if(!response) return 1;
            if(!strlen(inputtext)) return SendError(playerid, "Вы ничего не ввели.");
            new targetid, newrang;
            if(sscanf(inputtext, "p<,>ii", targetid, newrang))
                return ShowPlayerDialog(playerid, D_FRACTION_CHANGERANG, DIALOG_STYLE_INPUT, ""I"Сменить ранг", ""W"Введите ID игрока, новый ранг(через запятую)", "Выбрать", "Закрыть");
            f(STRING_GLOBAL, "%d %d", targetid, newrang);
            callcmd::rang(playerid, STRING_GLOBAL);
            return 1;
        }
        case D_FRACTION_UNWARN:
        {
            if(!response) return 1;
            if(!strlen(inputtext)) return SendError(playerid, "Вы ничего не ввели.");
            new targetid, reason[144];
            if(sscanf(inputtext, "p<,>is[144]", targetid, reason))
                return ShowPlayerDialog(playerid, D_FRACTION_UNWARN, DIALOG_STYLE_INPUT, ""I"Снять выговор", ""W"Используйте: "I"ID игрока, причину(через запятую)","Далее","Отмена");
            f(STRING_GLOBAL, "%d %s", targetid, reason);
            callcmd::funwarn(playerid, STRING_GLOBAL);
            return 1;
        }
        case D_FRACTION_WARN:
        {
            if(!response) return 1;
            if(!strlen(inputtext)) return SendError(playerid, "Вы ничего не ввели.");
            new targetid, reason[144];
            if(sscanf(inputtext, "p<,>is[144]", targetid, reason))
                return ShowPlayerDialog(playerid, D_FRACTION_WARN, DIALOG_STYLE_INPUT, ""I"Выдать выговор", ""W"Используйте: "I"ID игрока, причину(через запятую)","Далее","Отмена");
            f(STRING_GLOBAL, "%d %s", targetid, reason);
            callcmd::fwarn(playerid, STRING_GLOBAL);
            return 1;
        }
        case D_FRACTION_CHANGESKIN:
        {
            if(!response) return 1;
            if(!strlen(inputtext)) return SendError(playerid, "Вы ничего не ввели.");
            new targetid = strval(inputtext);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d", targetid);
            callcmd::changeskin(playerid, STRING_GLOBAL);
            return 1;
        }
        case D_FRACTION_INVITE:
        {
            if(!response) return 1;
            if(!strlen(inputtext)) return SendError(playerid, "Вы ничего не ввели.");
            new targetid = strval(inputtext);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d", targetid);
            callcmd::invite(playerid, STRING_GLOBAL);
            return 1;
        }
        case D_FRACTION_UNINVITE:
        {
            if(!response) return 1;
            if(!strlen(inputtext)) return SendError(playerid, "Вы ничего не ввели.");
            new targetid = strval(inputtext);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d", targetid);
            callcmd::uninvite(playerid, STRING_GLOBAL);
            return 1;
        }
        case D_PLAYER_MENU_TD_PAY:
        {
            if(!response) return 1;
            new targetid = p_temp[playerid][p_listitem][p_temp[playerid][p_listitem_int]];
            if(!IsPlayerConnected(targetid)) return SendError(playerid, "Игрок не в сети.");
            if(!strlen(inputtext)) return SendError(playerid, "Вы ничего не ввели.");
            new value = strval(inputtext);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d %d", targetid, value);
            callcmd::pay(playerid, STRING_GLOBAL);
            return 1;
        }
        case D_TOPWAR:
        {
            if(!response) return 1;
            if(TopList[listitem][WarType] == CAPTURE_ID_NONE) return 1;
            if(TopList[listitem][WarType] == CAPTURE_ID_FAMILY)
            {
                f(STRING_GLOBAL, "Ник\tУбийств\tСмертей\tНанесено/Получено урона\n- %s:\t-\t-\t-\n", FamilyData[TopList[listitem][WarID][0]][fName]);
                STRING_MIN[0] = EOS;
                f(STRING_MIN, "- %s:\t-\t-\t-\n", FamilyData[TopList[listitem][WarID][1]][fName]);
            }
            else
            {
                f(STRING_GLOBAL, "Ник\tУбийств\tСмертей\tНанесено/Получено урона\n- %s:\t-\t-\t-\n", GetFractionName(TopList[listitem][WarID][0]));
                STRING_MIN[0] = EOS;
                f(STRING_MIN, "- %s:\t-\t-\t-\n", GetFractionName(TopList[listitem][WarID][1]));
            }
            new count;
            for(new i; i < MAX_PLAYER_TOP; i++)
            {
                if(TopList[listitem][KillsOne][i] != -1) f(STRING_GLOBAL, "%s"W"[%d]"I" %s\t"W"%d\t%d\t%0.1f/%0.1f\n", STRING_GLOBAL, i+1,
                    TopListNickOne[listitem][i], TopList[listitem][KillsOne][i], TopList[listitem][DeathsOne][i], TopList[listitem][GiveDamageOne][i], TopList[listitem][TakeDamageOne][i]), count++;

                if(TopList[listitem][KillsTwo][i] != -1) f(STRING_MIN, "%s"W"[%d]"I" %s\t"W"%d\t%d\t%0.1f/%0.1f\n", STRING_MIN, i+1,
                    TopListNickTwo[listitem][i], TopList[listitem][KillsTwo][i], TopList[listitem][DeathsTwo][i], TopList[listitem][GiveDamageTwo][i], TopList[listitem][TakeDamageTwo][i]), count++;
            }
            strcat(STRING_GLOBAL, STRING_MIN);
            if(!count)
                return SendError(playerid, "Статистика недоступна.");

            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, "Подробности ТОП", STRING_GLOBAL, "OK", "Закрыть");
        }
        case D_ANTIDM_MENU:
        {
            if(!response) return true;
            switch(listitem)
            {
                case 0: ShowPlayerDialog(playerid, D_ANTIDM_CREATE_TYPE, DIALOG_STYLE_LIST, ""I"Добавить ZZ",""I"[1]"W" Круг\n"I"[2]"W" Квадрат","Выбрать","Закрыть");
                case 1:
                {
                    for(new i = count_antidm; i != -1; i--)
                    {
                        if(IsPlayerInDynamicArea(playerid, AntiDMInfo[i][dmArea]))
                        {
                            DestroyDynamicObject(AntiDMInfo[i][dmObject]);
                            AntiDMInfo[i][dmObject] = INVALID_OBJECT_ID;
                            DestroyDynamicArea(AntiDMInfo[i][dmArea]);
                            DestroyDynamic3DTextLabel(AntiDMInfo[i][dm3DLabel]);

                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `antidm_info` WHERE `id` = %d", AntiDMInfo[i][dmMysqlID]);
                            mysql_tquery(con_bd, STRING_GLOBAL);

                            SendAccess(playerid, "Анти ДМ зона успешно удалена.");
                            break;
                        }
                    }
                }

                case 2:
                {
                    for(new i = count_antidm; i != -1; i--)
                    {
                        if(IsPlayerInDynamicArea(playerid, AntiDMInfo[i][dmArea]))
                        {
                            STRING_GLOBAL[0] = EOS;
                            for(new d = 0; d < MAX_FRACTIONS; d++) f(STRING_GLOBAL, "%s"I"[%d]"W" %s [%s]\n",STRING_GLOBAL, d+1, GetFractionName(d),(AntiDMInfo[i][dmFlag][d] ? ("V") : ("X")));
                            ShowPlayerDialog(playerid, D_ANTIDM_SETTING, DIALOG_STYLE_LIST, ""I"DM ZONE SETTING", STRING_GLOBAL, "Выбрать", "Закрыть");
                            p_temp[playerid][p_listitem_int] = i;
                            break;
                        }
                    }
                }

            }
            return true;
        }
        case D_ANTIDM_SETTING:
        {
            new idx = p_temp[playerid][p_listitem_int];
            if(!response || idx < 0) return 1;
            AntiDMInfo[idx][dmFlag][listitem] = !AntiDMInfo[idx][dmFlag][listitem];

            STRING_GLOBAL[0] = EOS;
            for(new i; i < MAX_FRACTIONS; i++)
                f(STRING_GLOBAL, "%s%i%s", STRING_GLOBAL, AntiDMInfo[idx][dmFlag][i], i == MAX_FRACTIONS-1 ? "":"|");
            f(STRING_GLOBAL, "UPDATE `antidm_info` SET `flags` = '%s' WHERE `id` = %d", STRING_GLOBAL, AntiDMInfo[idx][dmMysqlID]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            for(new i; i < MAX_FRACTIONS; i++) f(STRING_GLOBAL, "%s"I"[%d]"W" %s [%s]\n",STRING_GLOBAL, i+1, GetFractionName(i),(AntiDMInfo[idx][dmFlag][i] ? ("V") : ("X")));
            ShowPlayerDialog(playerid, D_ANTIDM_SETTING, DIALOG_STYLE_LIST, ""I"DM ZONE SETTING", STRING_GLOBAL, "Выбрать", "Закрыть");

            SendInfo(playerid, "%s теперь %s драться в этой зоне", GetFractionName(listitem), AntiDMInfo[idx][dmFlag][listitem] ? "могут" : "не могут");

            STRING_GLOBAL[0] = EOS;
            new count;
            for(new i; i < MAX_FRACTIONS; i++)
            {
                if(AntiDMInfo[idx][dmFlag][i] == 1)
                {
                    f(STRING_GLOBAL,"%s"W"[%d]"I" %s\n", STRING_GLOBAL, count+1, GetFractionName(i));
                    count++;
                }
            }
            if(!count) strcat(STRING_GLOBAL,"[ Зеленая зона ]\nЗдесь запрещено драться");
            else f(STRING_GLOBAL, "[ Зеленая зона ]\nЗдесь разрешено драться только:\n%s", STRING_GLOBAL);
            UpdateDynamic3DTextLabelText(AntiDMInfo[idx][dm3DLabel], COLOR_MAIN, STRING_GLOBAL);
            return true;
        }
        case D_ANTIDM_CREATE_TYPE:
        {
            if(!response) return 1;
            if(count_antidm >= MAX_ANTI_DM_ZONE) return SendError(playerid, "Создано максимальное количество ANTI-DM зон.");
            p_temp[playerid][p_listitem][0] = listitem;
            if(!listitem)
            {
                AntiDMInfo[count_antidm][dmType] = 0;
                ShowPlayerDialog(playerid, D_ANTIDM_CREATE_RADIUS, DIALOG_STYLE_INPUT, ""I"Радиус ZZ", "Введите радиус действия ЗЗ", "Ввести", "Отмена");
            }
            else
            {
                AntiDMInfo[count_antidm][dmType] = 1;
                p_temp[playerid][p_listitem_int] = STATUS_ANTIDM_POS1;
                SendInfo(playerid, "Введите /dmpos на одном угле и под 45 градусов в другом(!!!)");
            }
            return 1;
        }
        case D_ANTIDM_CREATE_RADIUS:
        {
            if(!response) return 1;
            if(AntiDMZone(playerid) == 1) return SendError(playerid, "Здесь уже установлена Анти ДМ зона.");
            if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_ANTIDM_CREATE_RADIUS, DIALOG_STYLE_INPUT, ""I"Радиус ZZ", "Введите радиус действия ЗЗ", "Ввести", "Отмена");
            new radius = strval(inputtext);
            if(!( 1 <= radius <= 350))
            {
                SendError(playerid, "Радиус должен быть не меньше 1 и не больше 350.");
                return ShowPlayerDialog(playerid, D_ANTIDM_CREATE_RADIUS, DIALOG_STYLE_INPUT, ""I"Радиус ZZ", "Введите радиус действия ЗЗ", "Ввести", "Отмена");
            }
            new Float:pPos_x, Float:pPos_y, Float:pPos_z;
            GetPlayerPos(playerid, pPos_x, pPos_y, pPos_z);
            new object_anti_dm = CreateDynamicObject(19973, pPos_x+(random(1)), pPos_y+random(1), pPos_z-1.2, 0.0, 0.0, 0.0);
            EditDynamicObject(playerid, object_anti_dm);
            p_temp[playerid][p_listitem_int] = STATUS_ANTIDM_OBJECT;
            AntiDMInfo[count_antidm][dmRadius] = radius;
            return 1;
        }
        case D_MDC_RECORD_LIST:
        {
            if(!response) return 1;
            STRING_GLOBAL[0] = EOS;
            if(listitem == 0 && p_temp[playerid][list_type])
            {
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `criminalrecords` WHERE `userid`= %i AND `id` > %i LIMIT %i", GetPVarInt(playerid, #MDC_ID), p_temp[playerid][p_listitem][0], MAX_TICKETS);
                mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayersRecords", "ii", playerid, 1);
                p_temp[playerid][list_type]--;
                return 1;
            }
            else if((listitem == MAX_TICKETS + 1 && p_temp[playerid][list_type]) || (listitem == MAX_TICKETS && !p_temp[playerid][list_type]))
            {
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `criminalrecords` WHERE `userid`= %i AND `id` < %i ORDER BY `id` DESC LIMIT %i", GetPVarInt(playerid, #MDC_ID), p_temp[playerid][p_listitem][MAX_TICKETS-1], MAX_TICKETS);
                mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayersRecords", "ii", playerid, 0);
                p_temp[playerid][list_type]++;
                return 1;
            }
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT *, (SELECT `name` FROM `accounts` WHERE id =criminalrecords.userid) as ownername FROM `criminalrecords` WHERE `userid`=%i AND `id`=%i LIMIT 1",
                GetPVarInt(playerid, #MDC_ID),
                (!p_temp[playerid][list_type])?(p_temp[playerid][p_listitem][listitem]):(p_temp[playerid][p_listitem][listitem-1]));
            mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayerRecord", "i", playerid);
            return 1;
        }
        case D_VEHICLE_FINES:
        {
            if(!response) return 1;
            new vehicleid;
            if(IsPlayerFractionPolice(playerid) && p_info[playerid][fwork] == true && GetPVarInt(playerid, #ticketsuse))
                vehicleid = GetPVarInt(playerid, #tickets_show);
            else
            {
                if(!IsPlayerInAnyVehicle(playerid))
                    return SendError(playerid, "Вы не в транспорте.");
                vehicleid = GetPlayerVehicleID(playerid);
                if(!IsPlayerOwnerVehicle(playerid, vehicleid))
                    return SendError(playerid, "Вы не владелец этого транспорта.");
            }

            STRING_GLOBAL[0] = EOS;
            if(listitem == 0 && p_temp[playerid][list_type])
            {
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `tickets` WHERE `vehicle`=%i AND `paid` = 0 AND `id` > %i LIMIT %i", veh_info[vehicleid][v_mysql_id], p_temp[playerid][p_listitem][0], MAX_TICKETS);
                mysql_tquery(con_bd, STRING_GLOBAL, "ShowCarsTickets", "ii", playerid, 1);
                p_temp[playerid][list_type]--;
                return 1;
            }

            else if((listitem == MAX_TICKETS + 1 && p_temp[playerid][list_type]) || (listitem == MAX_TICKETS && !p_temp[playerid][list_type]))
            {
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `tickets` WHERE `vehicle`=%i AND `paid` = 0 AND `id` < %i ORDER BY `id` DESC LIMIT %i", veh_info[vehicleid][v_mysql_id], p_temp[playerid][p_listitem][MAX_TICKETS-1], MAX_TICKETS);
                mysql_tquery(con_bd, STRING_GLOBAL, "ShowCarsTickets", "ii", playerid, 0);
                p_temp[playerid][list_type]++;
                return 1;
            }

            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `tickets` WHERE `vehicle`=%i AND `id`= %i LIMIT 1",
                veh_info[vehicleid][v_mysql_id],
                (!p_temp[playerid][list_type]) ? (p_temp[playerid][p_listitem][listitem]):(p_temp[playerid][p_listitem][listitem-1]));
            mysql_tquery(con_bd, STRING_GLOBAL, "ShowCarTicket", "i", playerid);

            return 1;
        }
        case D_VEHICLE_FINES_TAKE:
        {
            if(!response)
            {
                if(IsPlayerFractionPolice(playerid) && p_info[playerid][fwork] == true && GetPVarInt(playerid, #ticketsuse))
                    return callcmd::checkvfines(playerid, "/0");
                else return callcmd::vtickets(playerid, "/0");
            }
            new vehicleid = GetPlayerVehicleID(playerid);
            if(vehicleid == 0) return SendError(playerid, "Игрок не в транспорте.");
            if(!IsPlayerOwnerVehicle(playerid, vehicleid)) return SendError(playerid, "Вы не являетесь владельцем данного транспортного средства.");

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `tickets` SET `userid`=%i,`vehicle`=0 WHERE `id`=%i", p_info[playerid][ID], p_temp[playerid][p_listitem_int]);
            mysql_tquery(con_bd, STRING_GLOBAL, "VehicleFineTook", "i", playerid);

            for(new i = 0; i < MAX_TICKETS; i++) p_temp[playerid][p_listitem][i] = 0;
            return 1;
        }
        case D_PLAYER_FINES:
        {
            if(!response) return p_temp[playerid][ATM_STATUS] = false;

            new userid;
            if(IsPlayerFractionPolice(playerid) && p_info[playerid][fwork] == true && GetPVarInt(playerid, #ticketsuse))
                userid = GetPVarInt(playerid, #tickets_show);
            else userid = p_info[playerid][ID];

            STRING_GLOBAL[0] = EOS;
            if(listitem == 0 && p_temp[playerid][list_type])
            {
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `tickets` WHERE `userid`=%i AND `paid` = 0 AND `id` > %i LIMIT %i", userid, p_temp[playerid][p_listitem][0], MAX_TICKETS);
                mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayersTickets", "ii", playerid, 1);
                p_temp[playerid][list_type]--;
                return 1;
            }
            else if((listitem == MAX_TICKETS + 1 && p_temp[playerid][list_type]) || (listitem == MAX_TICKETS && !p_temp[playerid][list_type]))
            {
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `tickets` WHERE `userid`=%i AND `paid` = 0 AND `id` < %i ORDER BY `id` DESC LIMIT %i", userid, p_temp[playerid][p_listitem][MAX_TICKETS-1], MAX_TICKETS);
                mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayersTickets", "ii", playerid, 0);
                p_temp[playerid][list_type]++;
                return 1;
            }
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT *, (SELECT `name` FROM `accounts` WHERE id = tickets.userid) as ownername FROM `tickets` WHERE `userid`=%i AND `id`=%i LIMIT 1",
                userid,
                (!p_temp[playerid][list_type])?(p_temp[playerid][p_listitem][listitem]):(p_temp[playerid][p_listitem][listitem-1]));
            mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayerTicket", "i", playerid);
            return 1;
        }
        case D_PLAYER_FINES_PAY:
        {
            if(!response)
            {
                p_temp[playerid][ATM_STATUS] = false;
                if(IsPlayerFractionPolice(playerid) && p_info[playerid][fwork] == true && GetPVarInt(playerid, #ticketsuse))
                    return callcmd::checkfines(playerid, "/0");
                else return callcmd::tickets(playerid, "/0");
            }
            if(p_temp[playerid][ATM_STATUS] != true) return 1;
            //if(!Bank_Nearest(playerid)) return SendError(playerid, "Для оплаты штрафа Вы должны находиться в банке.");
            if(p_info[playerid][cash] < p_temp[playerid][p_listitem][0])
                return SendError(playerid, "У Вас нет столько денег для оплаты штрафа, требуется %d$. Используйте /donate", p_temp[playerid][p_listitem][0]);

            SendAccess(playerid, "Вы оплатили штраф суммой $%i.", p_temp[playerid][p_listitem][0]);
            SendInfo(playerid, "У Вас ещё остались неоплаченные штрафы - %i.", CountPlayerTickets(playerid)-1);
            SetPlayerMoney(playerid, -p_temp[playerid][p_listitem][0], true, "Оплатил штраф");

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `tickets` SET `paid` = 1 WHERE `id` = %i", p_temp[playerid][p_listitem_int]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            p_temp[playerid][ATM_STATUS] = false;
            return 1;
        }
        ///////////////////////
        case D_DIALOG_LIST_TYPE:
        {
            if(p_temp[playerid][list_type] == LIST_ID_GHETTO_PC) return 1;
            if(!response)
            {
                for(new i; i < 25; i ++) p_temp[playerid][p_listitem][i] = -1;
                switch(p_temp[playerid][list_type])
                {
                    case LIST_ID_FAMILY_BLACKLIST: callcmd::fblacklist(playerid, "/0");
                    case LIST_ID_FAMILY_OFFLINE_MEMBERS: callcmd::family(playerid, "/0");
                    case LIST_ID_PROMOCODE: ShowDialogPromocode(playerid, PROMOCODE_CONTROL);
                    case LIST_ID_DONATE_HISTORY: callcmd::donate(playerid, "/0");
                    case LIST_ID_MARKET_SELL_ITEMS, LIST_ID_MARKET_BUY_INV, LIST_ID_MARKET_BUY_ACC, LIST_ID_MARKET_BUY_SKIN:
                    {
                        if(p_temp[playerid][market_arend] != -1) ShowPlayerControlMarket(playerid);
                    }
                    case LIST_ID_HOT_DEALS_SMALL_SIZED: ShowPlayerDonate(playerid, DONATE_TYPE_MENU);
                }
                return 1;
            }
            switch(listitem)
            {
                case 0:
                {
                    new page_id = p_temp[playerid][list_page]-1;
                    if(page_id == 0) SendError(playerid, "Вы находитесь на первой странице.");
                    else p_temp[playerid][list_page] = page_id;
                    UpdatePlayerList(playerid);
                }
                case 1:
                {
                    p_temp[playerid][list_page]++;
                    UpdatePlayerList(playerid);
                }
                default:
                {
                    listitem -= 2;
                    switch(p_temp[playerid][list_type])
                    {
                        case LIST_ID_SERVER_FORUM:
                        {
                            if(!(0 <= listitem < 25))  return SendError(playerid, "Произошла не известная ошибка. AC-0503");
                            if(listitem == -1) return 1;
                            new newsID = p_temp[playerid][p_listitem][listitem];
                            if(newsID <= 0) return SendError(playerid, "ID новости не определен.");
                            new IsView = p_temp[playerid][p_listitem][LIST_OFFSET_MAX+listitem];
                            p_temp[playerid][p_listitem_int] = listitem;
                            if(IsView == -1)
                            {
                                STRING_GLOBAL[0] = EOS;
                                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `server_forum_stats` (`userid`, `newsid`, `rating`) VALUES (%d, %d, '0')",
                                    p_info[playerid][ID], newsID);
                                mysql_tquery(con_bd, STRING_GLOBAL, "OnUpdateSFNewsCallback", "iii", playerid, p_info[playerid][ID], newsID);
                            }
                            else OnLoadSFNews(playerid, newsID);
                            return 1;
                        }
                        case LIST_ID_HOT_DEALS_SMALL_SIZED:
                        {
                            if(!(0 <= listitem < 25))  return SendError(playerid, "Произошла не известная ошибка. AC-0502");
                            PlayerDonateBuy(playerid, listitem);
                            return 1;
                        }
                        case LIST_ID_MARKET_BUY_INV, LIST_ID_MARKET_BUY_ACC, LIST_ID_MARKET_BUY_SKIN:
                        {
                            if(p_temp[playerid][market_arend] == -1) return SendError(playerid, "Вы не являетесь арендатором какой либо палатки.");
                            if(!(0 <= listitem < 25)) return SendError(playerid, "Произошла не известная ошибка. AC-1811");
                            if(listitem == -1) return 1;
                            new itemID = p_temp[playerid][p_listitem][listitem];
                            if(itemID <= 0) return SendError(playerid, "Предмет не определен.");
                            new i = GetIDMarketBuyItem(playerid, itemID);
                            new free_amout = GetInventoryFreeItems(playerid, itemID);
                            if(i == -1)
                            {
                                //if(GetIDMarketSellItems(playerid, itemID))
                                //    return SendError(playerid, "Данный товар стоит на продаже.");
                                if(!free_amout) return SendError(playerid, "В инвентаре нет места.");
                                SetPVarInt(playerid, #SELECT_SLOT_ID, itemID);
                                ShowDialogMarketItemsBuyAdd(playerid, itemID);
                            }
                            else
                            {
                                SetPVarInt(playerid, #SELECT_SLOT_ID, i);
                                ShowDialogMarketItemsBuyTake(playerid, i);
                            }
                            return 1;
                        }
                        case LIST_ID_ARA_SELL_ITEMS:
                        {
                            if(!(0 <= listitem < 25))  return SendError(playerid, "Произошла не известная ошибка. AC-1811");
                            new i = p_temp[playerid][p_listitem][listitem];
                            if(i == -1) return 1;
                            if(InventoryPlayer[playerid][i][inv_status_use])
                                return SendError(playerid, "Данный предмет используется.");
                            
                            SetPVarInt(playerid, #SELECT_SLOT_ID, i+1);
                            ShowDialogAraSellItems(playerid, i);
                            return 1;
                        }
                        case LIST_ID_MARKET_SELL_ITEMS:
                        {
                            if(p_temp[playerid][market_arend] == -1) return SendError(playerid, "Вы не являетесь арендатором какой либо палатки.");
                            if(!(0 <= listitem < 25))  return SendError(playerid, "Произошла не известная ошибка. AC-1811");
                            new i = p_temp[playerid][p_listitem][listitem];
                            if(i == -1) return 1;
                            if(InventoryPlayer[playerid][i][inv_status_use])
                                return SendError(playerid, "Данный предмет используется.");
                            
                            SetPVarInt(playerid, #SELECT_SLOT_ID, i);
                            if(InventoryPlayer[playerid][i][inv_market_sell_price] == 0) ShowDialogMarketItemsSellAdd(playerid, i);
                            else ShowDialogMarketItemsSellTake(playerid, i);
                            return 1;
                        }
                        case LIST_ID_PLAYER_ACCESSORIES:
                        {
                            if(!(0 <= listitem < 25))  return SendError(playerid, "Произошла не известная ошибка. AC-1811");
                            new idx_dialog_acc = GetPVarInt(playerid, "ACCESSORIES_LIST:ID");
                            DeletePVar(playerid, "ACCESSORIES_LIST:ID");
                            listitem = p_temp[playerid][p_listitem][listitem];
                            new itemID = InventoryPlayer[playerid][listitem][inv_item_id],
                                statusUse = InventoryPlayer[playerid][listitem][inv_status_use];
                            switch(idx_dialog_acc)
                            {
                                case ACCESSORIES_ID_EDITOR:
                                {
                                    if(!response) return callcmd::editor(playerid, "/0");
                                    if(!statusUse) return AccessoriesPlayerList(playerid, ACCESSORIES_ID_EDITOR), SendError(playerid, "Данный аксессуар не используется.");
                                    ShowPlayerDialog(playerid, D_EDITOR_LIST, DIALOG_STYLE_LIST, ""I"Действие", ""I"[1]"W" Восстановить стандартные позиции\n"I"[2]"W" Редактировать позиции", "Далее", "Отмена");
                                    SetPVarInt(playerid, "EDITOR:idx", listitem+1);
                                }
                                case ACCESSORIES_ID_REPAIR:
                                {
                                    if(!response) return ShowPlayerDialog(playerid, D_RA, DIALOG_STYLE_LIST, ""I"Мастерская одежды", ""I"[1]"W" Отремонтировать аксессуар\n"I"[2]"W" Изменить цвет аксессуара\n"I"[3]"W" Помощь по мастерской", "Далее", "Отмена");
                                    if(statusUse) return AccessoriesPlayerList(playerid, ACCESSORIES_ID_REPAIR), SendError(playerid, "Данный аксессуар используется.");
                                    if(InventoryPlayer[playerid][listitem][inv_acc_wear] > 99.8) return AccessoriesPlayerList(playerid, ACCESSORIES_ID_REPAIR), SendError(playerid, "Данный аксессуар еще нет необходимости ремонтировать.");
                                    new biz_id = GetPVarInt(playerid, "bID"), till = b_info[biz_id][_till];
                                    STRING_GLOBAL[0] = EOS;
                                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы действительно хотите отремонтировать аксессуар \"%s\" за %d$?", ItemsInfo[itemID][iName], GetPriceRepairAccessories(itemID, InventoryPlayer[playerid][listitem][inv_acc_wear]) * till);
                                    ShowPlayerDialog(playerid, D_RA_REPAIR, DIALOG_STYLE_MSGBOX, ""I"Ремонт аксессуара", STRING_GLOBAL, "Да", "Нет");
                                    SetPVarInt(playerid, "RA:idx", listitem);
                                }
                                case ACCESSORIES_ID_MATERIAL_COLOR:
                                {
                                    if(!response) return ShowPlayerDialog(playerid, D_RA, DIALOG_STYLE_LIST, ""I"Мастерская одежды", ""I"[1]"W" Отремонтировать аксессуар\n"I"[2]"W" Изменить цвет аксессуара\n"I"[3]"W" Помощь по мастерской", "Далее", "Отмена");
                                    if(statusUse) return AccessoriesPlayerList(playerid, ACCESSORIES_ID_MATERIAL_COLOR), SendError(playerid, "Данный аксессуар используется.");
                                    new biz_id = GetPVarInt(playerid, "bID"), till = b_info[biz_id][_till];
                                    STRING_GLOBAL[0] = EOS;
                                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы действительно хотите изменить цвет аксессуара \"%s\" за %d$?", ItemsInfo[itemID][iName], ItemsInfo[itemID][iPrice] / 4 * till);
                                    ShowPlayerDialog(playerid, D_RA_MC, DIALOG_STYLE_MSGBOX, ""I"Изменить цвет аксессуара", STRING_GLOBAL, "Да", "Нет");
                                    SetPVarInt(playerid, "RA:idx", listitem);
                                }
                                case ACCESSORIES_ID_PREMIUM:
                                {
                                    if(!response) return 1;
                                    if(!statusUse) return AccessoriesPlayerList(playerid, ACCESSORIES_ID_PREMIUM), SendError(playerid, "Данный аксессуар не используется.");
                                    STRING_GLOBAL[0] = EOS;
                                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы действительно хотите установить \"Premium\" на \"%s\"?", ItemsInfo[itemID][iName]);
                                    ShowPlayerDialog(playerid, D_INSTALL_PREMIUM_ACC, DIALOG_STYLE_MSGBOX, ""I"Premium на аксессуар", STRING_GLOBAL, "Да", "Нет");
                                    SetPVarInt(playerid, "INSTALL_PREMIUM_ACC:idx", listitem+1);
                                }
                            }
                            return 1;
                        }
                        case LIST_ID_PLAYER_SKINS:
                        {
                            if(!(0 <= listitem < 25))  return SendError(playerid, "Произошла не известная ошибка. AC-1811");
                            new idx_dialog_skin = GetPVarInt(playerid, "SKINS_LIST:ID");
                            DeletePVar(playerid, "SKINS_LIST:ID");
                            listitem = p_temp[playerid][p_listitem][listitem];
                            new itemID = InventoryPlayer[playerid][listitem][inv_item_id],
                                statusUse = InventoryPlayer[playerid][listitem][inv_status_use];
                            switch(idx_dialog_skin)
                            {
                                case SKINS_ID_REPAIR:
                                {
                                    if(!response) return ShowPlayerDialog(playerid, D_WASH, DIALOG_STYLE_LIST, ""I"Прачечная", ""I"[1]"W" Постирать одежду\n"I"[2]"W" Помощь по прачечной", "Далее", "Отмена");
                                    if(statusUse) return SkinsPlayerList(playerid, SKINS_ID_REPAIR), SendError(playerid, "Данный скин используется.");
                                    if(InventoryPlayer[playerid][listitem][inv_skin_wear] > 99.8) return SkinsPlayerList(playerid, SKINS_ID_REPAIR), SendError(playerid, "Данный скин еще нет необходимости стирать.");
                                    new biz_id = GetPVarInt(playerid, "bID"), till = b_info[biz_id][_till];
                                    STRING_GLOBAL[0] = EOS;
                                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы действительно хотите постирать одежду \"%s\" за %d$?", ItemsInfo[itemID][iName], GetPriceWashSkins(InventoryPlayer[playerid][listitem][inv_skin_wear]) * till);
                                    ShowPlayerDialog(playerid, D_WASH_REPAIR, DIALOG_STYLE_MSGBOX, ""I"Стирка одежды", STRING_GLOBAL, "Да", "Нет");
                                    SetPVarInt(playerid, "WASH:idx", listitem);
                                }
                                case SKINS_ID_PREMIUM:
                                {
                                    if(!response) return 1;
                                    if(!statusUse) return SkinsPlayerList(playerid, SKINS_ID_REPAIR), SendError(playerid, "Данный скин не используется.");
                                    STRING_GLOBAL[0] = EOS;
                                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы действительно хотите установить \"Premium\" на \"%s\"?", ItemsInfo[itemID][iName]);
                                    ShowPlayerDialog(playerid, D_INSTALL_PREMIUM_SKIN, DIALOG_STYLE_MSGBOX, ""I"Premium на скин", STRING_GLOBAL, "Да", "Нет");
                                    SetPVarInt(playerid, "INSTALL_PREMIUM_SKIN:idx", listitem+1);
                                }
                            }
                            return 1;
                        }
                        case LIST_ID_VEHICLE_NOTES:
                        {
                            new idx = p_temp[playerid][p_listitem_int]-1;
                            if(idx <= -1)
                            {
                                new count = CountVehicleNotesID(GetPVarInt(playerid, #MDC_ID));
                                if(count >= 30) ShowPlayerDialog(playerid, D_MDC_VEHICLE_NOTE, DIALOG_STYLE_MSGBOX, ""I"MDC - Добавление записи о ТС", "{B4B5B7}ДОБАВЛЕНИЕ ЗАПИСИ О ТС\n\nВНИМАНИЕ!\nВсе заметки заняты!", "Закрыть", "");
                                else ShowPlayerDialog(playerid, D_MDC_ADD_NOTE, DIALOG_STYLE_INPUT, ""I"MDC - Добавление записи о ТС", "{B4B5B7}ДОБАВЛЕНИЕ ЗАПИСИ О ТС\n\nВведите текст заметки:", "Ввод", "Назад");
                                return 1;
                            }
                            else {
                                STRING_GLOBAL[0] = EOS;
                                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT *, (SELECT `name` FROM `accounts` WHERE id = (SELECT `v_owner_id` FROM `vehicle` WHERE `v_mysql_id` = vehicle_note.vehicle_id)) as ownername, (SELECT `name` FROM `accounts` WHERE id = vehicle_note.officer_id) AS officername FROM `vehicle_note` WHERE `id` = %d LIMIT 1",
                                    p_temp[playerid][p_listitem][idx]);
                                mysql_tquery(con_bd, STRING_GLOBAL, "MDC_VEHICLE_NOTE_INFO", "i", playerid);
                            }
                            return 1;
                        }
                        case LIST_ID_FAMILY_OFFLINE_MEMBERS:
                        {
                            new family_idx = GetPlayerFamilyID(playerid);
                            if(family_idx != -1 && GetFamilyRang(playerid) >= FamilyData[family_idx][fSettingRang][F_SET_RANG])
                            {
                                p_temp[playerid][p_listitem_int] = listitem;
                                ShowPlayerDialog(playerid, D_FAMILY_MEMBER_MENU, DIALOG_STYLE_LIST, ""I"Меню", ""I"[1]"W" Информация об игроке\n"I"[2]"W" Выгнать из семьи\n"I"[3]"W" Выдать предупреждение\n"I"[4]"W" Сменить ранг", "Выбрать", "Назад" );
                            }
                            return 1;
                        }
                        case LIST_ID_TC_OFFLINE_MEMBERS:
                        {
                            p_temp[playerid][p_listitem_int] = listitem;
                            ShowPlayerDialog(playerid, D_TC_MEMBERS, DIALOG_STYLE_LIST, ""I"Управление игроком", "\
                                "I"[1]"W" Информация об игроке\n\
                                "I"[2]"W" Уволить\n\
                                "I"[3]"W" Изменить ранг", "Далее", "Отмена");
                            return 1;
                        }
                        case LIST_ID_FRACTION_ALL_MEMBERS:
                        {
                            if(p_info[playerid][rang] >= 9)
                            {
                                p_temp[playerid][p_listitem_int] = listitem;
                                ShowPlayerDialog(playerid, D_FRACTION_MEMBER_MENU, DIALOG_STYLE_LIST, ""I"Меню", ""I"[1]"W" Информация об игроке\n"I"[2]"W" Уволить из фракции\n"I"[3]"W" Выдать предупреждение\n"I"[4]"W" Сменить ранг", "Выбрать", "Назад" );
                            }
                            return 1;
                        }
                        case LIST_ID_GIVE_ITEMS:
                        {
                            p_temp[playerid][p_listitem_int] = listitem;
                            ShowPlayerDialog(playerid, D_GIVE_ITEM_MENU, DIALOG_STYLE_LIST, ""I"Действие", ""I"[1]"W" Забрать\n"I"[2]"W" Продать\n"I"[3]"W" Удалить", "Далее", "Отмена");
                        }
                        default: UpdatePlayerList(playerid);
                    }
                }
            }
            return 1;
        }
        case D_FRACTION_MEMBER_INFO: return ShowPlayerDialog(playerid, D_FRACTION_MEMBER_MENU, DIALOG_STYLE_LIST, ""I"Меню", ""I"[1]"W" Информация об игроке\n"I"[2]"W" Уволить из фракции\n"I"[3]"W" Выдать предупреждение\n"I"[4]"W" Сменить ранг", "Выбрать", "Назад" );
        case D_FRACTION_MEMBER_MENU:
        {
            if(!response) return UpdatePlayerList(playerid);
            new list_id = p_temp[playerid][p_listitem_int];
            if(!(0 <= list_id < 25)) return SendError(playerid, "Неизвестная ошибка: BUG-F002! Попробуйте еще раз.");
            new player_mysql_id = p_temp[playerid][p_listitem][list_id];
            if(player_mysql_id <= INVALID_MYSQL_ID) return SendError(playerid, "Неизвестная ошибка: BUG-F003! Попробуйте еще раз.");

            if(GetPlayerUserID(player_mysql_id) != INVALID_PLAYER_ID) return SendError(playerid, "Игрок в игре.");
            switch(listitem)
            {
                case 0:
                {
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name`, `rang`, `fwarn`, `lastenter` FROM `accounts` WHERE `id` = %d LIMIT 1", player_mysql_id);
                    mysql_tquery(con_bd, STRING_GLOBAL, "FractionMemberInfo", "i", playerid);
                }
                case 1:
                {
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id`, `member`, `rang` FROM `accounts` WHERE `id` = %d LIMIT 1", player_mysql_id);
                    mysql_tquery(con_bd, STRING_GLOBAL, "leave_offline", "i", playerid);
                }
                case 2:
                {
                    new Cache: result, rang_id, member_name[MAX_PLAYER_NAME], warns;
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name`, `rang`, `fwarn` FROM `accounts` WHERE `id` = %d LIMIT 1", player_mysql_id);
                    result = mysql_query(con_bd, STRING_GLOBAL);
                    if(cache_num_rows() != 0)
                    {
                        cache_get_value_name(0, "name", member_name);
                        cache_get_value_name_int(0, "rang", rang_id);
                        cache_get_value_name_int(0, "fwarn", warns);

                        if(rang_id >= p_info[playerid][rang])
                            return SendError(playerid, "У Вас недостаточный ранг.");

                        if(++warns >= 3)
                        {
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id`, `member`, `rang` FROM `accounts` WHERE `id` = %d LIMIT 1", player_mysql_id);
                            mysql_tquery(con_bd, STRING_GLOBAL, "leave_offline", "i", playerid);
                        }
                        else
                        {
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `fwarn` = %d WHERE `id` = %d LIMIT 1", warns, player_mysql_id);
                            mysql_tquery(con_bd, STRING_GLOBAL);

                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s[%d] выдал %s предупреждения в оффлайне.", get_name(playerid), playerid, member_name);
                            SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
                        }
                    }
                    else SendError(playerid, "Ничего не найдено.");
                    cache_delete(result);
                }
                case 3:
                {
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name`, `rang`, `sex` FROM `accounts` WHERE `id` = %d", player_mysql_id);
                    mysql_tquery(con_bd, STRING_GLOBAL, "FractionPlayerChangeRang", "ii", playerid, player_mysql_id);
                }
            }
            return 1;
        }
        case D_FRACTION_OFF_CHANGE_RANG:
        {
            if(!response) return DeletePVar(playerid, "change_rang_sex");
            new player_mysql_id = p_temp[playerid][p_listitem_int], sex_id = GetPVarInt(playerid, "change_rang_sex");
            DeletePVar(playerid, "change_rang_sex");
            if(player_mysql_id <= INVALID_MYSQL_ID) return SendError(playerid, "Неизвестная ошибка: BUG-F004! Попробуйте еще раз.");
            if(GetPlayerUserID(player_mysql_id) != INVALID_PLAYER_ID) return SendError(playerid, "Игрок в игре.");
            if(!(1 <= listitem+1 <= p_info[playerid][rang]-1)) return 1;

            SendAccess(playerid, "Вы изменили ранг на %s.", GetFractionRangName(p_info[playerid][member], listitem+1));

            new skin_idx = sex_id == 2 ? FractionsData[p_info[playerid][member]][fManSkin][listitem] : FractionsData[p_info[playerid][member]][fWomanSkin][listitem];

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `rang` = %d, `fskin` = %d WHERE `id` = %d LIMIT 1", listitem+1, skin_idx, player_mysql_id);
            mysql_tquery(con_bd, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s[%d] поменял ранг %s на %s(%d) в оффлайне.",
                get_name(playerid), playerid, p_temp[playerid][p_listitem], GetFractionRangName(p_info[playerid][member], listitem+1), listitem+1);
            SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);

            Log(LOG_player, INFO, "%s[%d](%s %s) поменял ранг %s[%d] на %d ранг в %s | #Fraction",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
            p_temp[playerid][p_listitem], player_mysql_id, GetFractionRangName(p_info[playerid][member], listitem+1), listitem+1);

            UpdatePlayerList(playerid);
            p_temp[playerid][p_listitem] = EOS;
            p_temp[playerid][p_listitem_int] = -1;
            return 1;
        }
        case D_STYLE_WALK:
        {
            if(!response) return 1;
            if(listitem == sizeof(name_walk_style))
            {
                ShowPlayerDialog(playerid, D_STYLE_WALK_INFO, DIALOG_STYLE_MSGBOX, ""I"Управление",
                    ""W"Что активировать Вам нужно:\n\
                    "I"С ПК: "W"Нажать АLT(удерживая) и A/W/S/D(или другие клавиши отвечающие за управление)\n\
                    "I"С телефона: "W"Начать движение легкое движение(не на всю 'силу' джостика) и кнопку 'удара' или 'спринта'", "Понял", "");
                return 1;
            }
            p_info[playerid][p_settings][WALK_STYLE_ID] = listitem;
            UpdatePlayerSetting(playerid);
            SendAccess(playerid, "Вы изменили свой стиль походки на %s.", name_walk_style[listitem]);
            SendInfo(playerid, "Включить или выключить походку: /walk.");
