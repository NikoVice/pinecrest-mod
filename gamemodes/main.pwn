////////////////////////////////////////
Fix_TogglePlayerControllable(playerid, status)
{
    p_info[playerid][pfreeze] = status;
    TogglePlayerControllable(playerid, p_info[playerid][pfreeze]);
    return 1;
}
#if defined _ALS_TogglePlayerControllable //new anti-cheat
    #undef TogglePlayerControllable
#else
    #define _ALS_TogglePlayerControllable
#endif
#define TogglePlayerControllable Fix_TogglePlayerControllable


