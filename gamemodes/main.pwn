    }

    p_info[playerid][p_countUseCheat]++;
    if(p_info[playerid][p_countUseCheat] < AntiCheat[code][acMaxWarns])
    {
        if(code == 12)
        {
            new Float:health_;
            AntiCheatGetHealth(playerid, health_);
            SetPlayerHealth(playerid, health_);
            return 1;
        }

        if(code == 13)
        {
            new Float:armour;
            AntiCheatGetArmour(playerid, armour);
            SetPlayerArmour(playerid, armour);
