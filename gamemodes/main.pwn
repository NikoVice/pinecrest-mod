                else SendInfo(playerid, "Вы отказались от авторизации администратора.");
                return Kick(playerid);
            }

            if(p_info[playerid][admin] > 0 && p_info[playerid][admin] < 5)
            {
                STRING_GLOBAL[0] = EOS;
                if(p_info[playerid][helper]) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[H] %s [%d] авторизовался как помощник.", get_name(playerid), playerid);
                else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] авторизовался как администратор %d уровня.", get_name(playerid), playerid, p_info[playerid][admin]);
                SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);
            }
            if(p_info[playerid][youtube_adm] > 0 && p_info[playerid][admin] == 0)
            {
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] авторизовался как ютубер %d уровня.", get_name(playerid), playerid, p_info[playerid][admin]);
                SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);
            }
            admin_acces[playerid] = true;
            if(p_info[playerid][helper]) { 
                Iter_Add(gHelpers, playerid);
                Iter_Add(gAdmins, playerid);
            }
            else Iter_Add(gAdmins, playerid);
