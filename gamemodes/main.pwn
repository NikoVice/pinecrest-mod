                    SendAccess(playerid, "Вы %s отображения всех элементов.", listitem == 7 ? "включили" : "выключили");
                    UpdatePlayerSetting(playerid);
                }
                case 8:
                {
                    p_info[playerid][p_settings][ELEMENT_CHAT_OUTTIME] ^= 1;
                    SetTimeoutChatDissappearTime(playerid, p_info[playerid][p_settings][ELEMENT_CHAT_OUTTIME], p_info[playerid][p_settings][ELEMENT_CHAT_OUTTIME]);
                    SendAccess(playerid, "Вы %s затухание чата.", p_info[playerid][p_settings][ELEMENT_CHAT_OUTTIME] == 1 ? "включили" : "выключили");
                    UpdatePlayerSetting(playerid);
                }
            }
            return 1;
        }
