                {
                    for(new i; i < 10; i++)
                    {
                        if(DuelData[duelid][dCommand1][i] != INVALID_PLAYER_ID && GetPlayerState(DuelData[duelid][dCommand1][i]) == PLAYER_STATE_ONFOOT)
                        {
                            p_temp[playerid][dSpectateId] = DuelData[duelid][dCommand1][i];
