CMD:blind( playerid )
{
    if(!GetPVarInt(playerid, "Player:Blinded"))
    {
        TextDrawShowForPlayer(playerid, TD_BlindBackground);
        SetPVarInt(playerid, "Player:Blinded", true);
    }
    else
    {
        TextDrawHideForPlayer(playerid, TD_BlindBackground);
        SetPVarInt(playerid, "Player:Blinded", 0);
        GameTextForPlayer(playerid, "Unblind", 2000, 5);
    }
    return 1;
}

CMD:fj(playerid, params[])
{
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "� ��� ����.");
    if(p_info[playerid][mute] > 0)
    {
        SendError(playerid, "� ��� ���������� ����.");
        return 0;
    }
    if(p_info[playerid][p_settings][CHAT_JOB] == 0) return SendError(playerid, "� ��� �������� ������� ���.");
    if(p_temp[playerid][JobChatFix] > timestamp) return SendError(playerid, "���������� ��������� � ������� ��� ����� ��� � 30 ������.");
    if(p_info[playerid][job] < JOB_BUS) return SendError(playerid, "�� ����� �� ���������.");
    if(!(1 <= strlen(params) <= 80)) return SendError(playerid, "����� ��������� ������ ������ ���� �� ����� 1 � �� ����� 80 ��������.");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);

    p_temp[playerid][JobChatFix] = timestamp + 30;

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[������� ���] %s[%d]: %s", get_name(playerid), playerid, params);

    foreach(new i : Player)
    {
        if(p_info[playerid][job] == p_info[i][job] && p_info[i][p_settings][0] == 1)
        {
            SendMes(i, 0xFFFF00FF, STRING_GLOBAL);
        }
    }
    return 1;
}


CMD:fjb(playerid, params[])
{
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "� ��� ����.");
    if(p_info[playerid][mute] > 0)
    {
        SendError(playerid, "� ��� ���������� ����.");
        return 0;
    }
    if(p_info[playerid][p_settings][CHAT_JOB] == 0) return SendError(playerid, "� ��� �������� ������� ���.");
    if(p_temp[playerid][JobChatFix] > timestamp) return SendError(playerid, "���������� ��������� � ������� ��� ����� ��� � 30 ������.");
    if(p_info[playerid][job] < JOB_BUS) return SendError(playerid, "�� ����� �� ���������.");
    if(!(1 <= strlen(params) <= 80)) return SendError(playerid, "����� ��������� ������ ������ ���� �� ����� 1 � �� ����� 80 ��������.");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);

    p_temp[playerid][JobChatFix] = timestamp + 30;

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "(( [������� ���] %s: %s ))", get_name(playerid), params);

    foreach(new i : Player)
    {
        if(p_info[playerid][job] == p_info[i][job] && p_info[i][p_settings][0] == 1)
        {
            SendMes(i, 0xFFFF00FF, STRING_GLOBAL);
        }
    }
    return 1;
}
CMD:try(playerid, params[])
{
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "� ��� ����.");
    if(p_info[playerid][mute] > 0)
    {
        SendError(playerid, "� ��� ���������� ����.");
        return 0;
    }
    if(GetPVarInt(playerid,"BoneStol_ID")) return 1;
    new string[128], success[2][22] = { " {1CEF00}| ������", " {FF0000}| �� ������" };
    if(isnull(params)) return SendInfo(playerid, "�����������: /try [�����]");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);
    format(string, sizeof(string), "%s [%d] %s", get_name(playerid), playerid, params);
    strcat(string, success[random(2)]);
    return ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFEE, 0xDD90FFDD, 0xDD90FFCC, 0xDD90FFBB);
}
CMD:n(playerid, params[])
{
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "� ��� ����.");
    if(p_info[playerid][mute] > 0)
    {
        SendError(playerid, "� ��� ���������� ����.");
        return 0;
    }
    new string[128];
    if(isnull(params)) return SendInfo(playerid, "�����������: /n [�����]");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);
    format(string, sizeof(string), "(( %s [%d]: %s ))", get_name(playerid), playerid, params);
    ProxDetector(30.0, playerid, string, 0xC8C8C8C8, 0xC8C8C8C8, 0xC8C8C8C8, 0xC8C8C8C8, 0xC8C8C8C8);
    return 1;
}
