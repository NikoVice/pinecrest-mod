CMD:changesex(playerid, params[])
{
    if(!IsPlayerFractionMedic(playerid) || p_info[playerid][rang] < 7) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "�����������: /changesex [id ������] [���������]");
    if(params[1] < 5000 || params[1] > 10000) return SendError(playerid, "��������� ������ ���� �� ����� 5000$ � �� ����� 10000$.");
    if(params[0] == INVALID_PLAYER_ID ||  params[0] == playerid) return SendError(playerid, "����� �� ������.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "����� ������� ������ �� ���.");

    SendAccess(playerid, "�� ���������� %s [%d] �������� ��� �� %d$.", get_name(params[0]), params[0], params[1]);
    SendInfo(params[0], "%s [%d] ��������� ��� �������� ��� �� %d$.", get_name(playerid), playerid, params[1]);

    SetFreeSlotOffer(params[0], playerid, OFFER_ID_SET_SEX, params[1]);
    return 1;
}

CMD:jail(playerid, params[])
{
    if(p_info[playerid][admin] < 1)
        return 1;

    if(p_info[playerid][helper] == 1) return SendError(playerid, "������� /mute ���������� ��� ��������.");

    new target, minutes, reason[144];
    if(sscanf(params, "uis[144]", target, minutes, reason)) return SendInfo(playerid, "�����������: /jail [id ������] [���-�� �����] [�������]");

    if(target == INVALID_PLAYER_ID || target == playerid)
        return SendError(playerid, "����� �� ������.");

    if(p_info[target][admin] >= p_info[playerid][admin]) return 1;
    if(!FD(playerid) && FD(target)) return 1;

    if(!(0 <= minutes <= 300))
        return SendError(playerid, "���-�� ����� ��������� ���������� �� ����� ���� ����� 0 � ����� 300.");

    if(!(1 <= strlen(reason) <= 32))
        return SendError(playerid, "���-�� �������� � ������� �� ����� ���� ����� 1 � �� ����� 32.");

    if(AdvertisingCheck(reason)) return AdvertisingPunishment(playerid, reason, 0);
    if(IsAAdminAttack(playerid, 3)) return 1;

    PlayerPlaySound(target, 17004, 0.0, 0.0, 0.0);
    ResetPlayerWeapons(target);
    p_info[target][wanted] = 0;

    if(minutes == 0)
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "������������� %s [%d] �������� %s [%d] �� ������.", get_name(playerid), playerid, get_name(target), target);
        SendAdminMessageForServer(COLOR_LIGHTRED, STRING_GLOBAL);

        SendAccess(playerid, "�� ��������� %s [%d] �� ������.", get_name(target), target);
        SendInfo(target, "������������� %s [%d] �������� ��� �� ������.", get_name(playerid), playerid);

        p_info[target][jail_time] = minutes;
        p_info[target][jail] = 0;

        SpawnPlayer(target);
        save_player(target);
        WriteAdminLog(TYPE_LOG_UNJAIL, playerid, get_name(target), target, reason);
    }
    else
    {
        if(RegisterRace[target])
        {
            RegisterRace[target] = 0;
            for(new i; i < MAX_RACE_PLAYERS; i++)
            {
                if(RacePlayers[i] == target)
                {
                    RacePlayers[i] = INVALID_PLAYER_ID;
                    if(RaceVehicles[i] != INVALID_VEHICLE_ID) DestroyVehicleVEx(RaceVehicles[i]);
                    RaceVehicles[i] = INVALID_VEHICLE_ID;
                }
            }
        }
        if(RegisterDerby[target])
        {
            RegisterDerby[target] = 0;
            for(new i; i < MAX_DERBY_PLAYERS; i++)
            {
                if(DerbyPlayers[i] == target)
                {
                    DerbyPlayers[i] = INVALID_PLAYER_ID;
                    if(DerbyVehicles[i] != INVALID_VEHICLE_ID) DestroyVehicleVEx(DerbyVehicles[i]);
                    DerbyVehicles[i] = INVALID_VEHICLE_ID;
                }
            }
        }
        if(RegisterPaintBall[target])
        {
            if(PaintBallLeaderID == target)
            {
                PaintBallLeaderID = INVALID_PLAYER_ID, PaintBallLeaderKills = 0;
            }
            RegisterPaintBall[target] = 0;
            PaintBallWeaponID[target] = 0;
            for(new i; i < MAX_PAINTBALL_PLAYERS; i++)
            {
                if(PaintBallPlayers[i] == target)
                {
                    PaintBallPlayers[i] = INVALID_PLAYER_ID;
                    break;
                }
            }
        }
        if(p_temp[target][cossack_robbers_register])
        {
            new team = p_temp[playerid][cossack_robbers_team];
            if(CossackRobbersLeaders[team] == playerid)
            {
                CossackRobbersLeaders[team] = INVALID_PLAYER_ID, CossackRobbersLeadersKills[team] = 0;
            }
            p_temp[target][cossack_robbers_register] = 0;
            p_temp[target][cossack_robbers_team] = 0;
            p_temp[target][cossack_robbers_kills] = 0;
            p_temp[target][cossack_robbers_deaths] = 0;
            p_temp[target][cossack_robbers_give] = 0.0;
            p_temp[target][cossack_robbers_take] = 0.0;
            for(new i = 0, x = 0; i < MAX_COSSACK_ROBBERS_TEAM; i++)
            {
                for(x = 0; x < MAX_COSSACK_ROBBERS_PLAYERS; x++)
                {
                    if(CossackRobbersPlayers[i][x] == target)
                    {
                        CossackRobbersPlayers[i][x] = INVALID_PLAYER_ID;
                        break;
                    }
                }
            }
        }
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "������������� %s [%d] ������� %s [%d] � ������ �� %d %s. �������: %s", get_name(playerid), playerid, get_name(target), target, minutes, Declension_ReturnWord(minutes, "������", "������", "�����"), reason);
        SendAdminMessageForServer(COLOR_LIGHTRED, STRING_GLOBAL);

        WriteAdminLog(TYPE_LOG_JAIL, playerid, get_name(target), target, reason);

        switch(p_info[target][p_vip])
        {
            case 1: p_info[target][jail_time] += ((minutes * 60) / 100) * 90;
            case 2: p_info[target][jail_time] += ((minutes * 60) / 100) * 80;
            case 3: p_info[target][jail_time] += ((minutes * 60) / 100) * 70;
            default: p_info[target][jail_time] += minutes*60;
        }
        p_info[target][jail] = 6;

        save_player(target);

        SpawnPlayer(target);
        GameTextForPlayer(target, "~r~PRISON", 10000, 0);

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "������������� %s [%d] ������� ��� � ������ �� %d %s. �������: %s", get_name(playerid), playerid, minutes, Declension_ReturnWord(minutes, "������", "������", "�����"), reason);
        SendInfo(target, STRING_GLOBAL);

        SendInfo(target, "���������� � �����: /time");

        DeletePVar(target,"PlayerCuffed");
        SetPlayerCuffed(target, false);
        Fix_TogglePlayerControllable(target, 1);

        p_info[target][wanted] = 0;
        SetPlayerWantedLevel(target, 0);
    }

    a_info[playerid][a_jail] = 1;
    MysqlUpdateAdminInt(playerid, "a_jail", a_info[playerid][a_jail]);
    return 1;
}


CMD:ajail(playerid, params[])
{
    if(p_info[playerid][admin] < 1)
        return 1;

    new count;
    STRING_GLOBAL[0] = EOS;
    foreach(new i: Player)
    {
        if(count >= 30) break;
        if(p_info[i][jail_time] > 0 && p_info[i][jail] == 6)
        {
            f(STRING_GLOBAL, "%s"I"[%d]"W" %s (%s)\n", STRING_GLOBAL, count+1, get_name(i), ConvertTime(p_info[i][jail_time]));
            count++;
        }
    }
    if(!strlen(STRING_GLOBAL)) return SendInfo(playerid, "� ��������� ������ ���.");
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, "��������:", STRING_GLOBAL, "����", "");
    return 1;
}

