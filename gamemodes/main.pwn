////////////////////////////////////
IsValidRPNickName(const true_name[])
{
    if(!(3 <= strlen(true_name) <= 20)) return false;

    static i, __, bs;
    if (('A' <= true_name[0] <= 'Z' && ('a' <= true_name[1] <= 'z')))
    {
        for (i = 1, __ = 0, bs = 0;;)
        {
            switch (true_name[++i])
            {
                case 'a'..'z':
                    continue;
                case '_':
                    if (__++, 'A' <= true_name[++i] <= 'Z' && 'a' <= true_name[++i] <= 'z')
                        continue;
                    else if ('A' <= true_name[i-1] <= 'Z' && 'A' <= true_name[i] <= 'Z' && 'a' <= true_name[++i] <= 'z')
                    {
                        bs++;
                        continue;
                    }
                    else
                        break;
                case '\0':
                    return (i >= 4 && __ == 1);
                default:
                {
                    if(__ == 1 && bs == 0 && 'A' <= true_name[i] <= 'Z')
                    {
                        bs++;
                        continue;
                    }
                    return false;
                }
            }
        }
    }
    return false;
}

#define get_name(%0) p_info[%0][name]

new mes_str[256];

#define SendMes(%1,%2,%3) format(mes_str, sizeof(mes_str), %3), SendClientMessage(%1, %2, mes_str)
#define SendMesAll(%1,%2) format(mes_str, sizeof(mes_str), %2), SendClientMessageToAll(%1, mes_str)

