            if(!IsPlayerInDynamicArea(playerid, VEHICLE_MARKET_CUBE)) return SendError(playerid, "�� ������ ���� �� ���������� ���������.");

            new pos_id = p_temp[playerid][market_vehicle_id];
            if(pos_id == -1) return 1;

            new vehicleid = CarMarketInfo[pos_id][cmVehicleIDx];
            if(vehicleid == INVALID_VEHICLE_ID) return 1;

            new vehicle_model = GetVehicleModelEx(vehicleid), price = CarMarketInfo[pos_id][cmPrice],
                rows = GetPlayerCountCars(p_info[playerid][ID], GetVehicleData(vehicle_model, E_VD_TYPE)),
                count_limit = GetPlayerLimiteCars(playerid, GetVehicleData(vehicle_model, E_VD_TYPE));

            if(rows >= count_limit)
                return SendError(playerid, "� ��� �������� ����� �� ������ ����� ������������� ��������.");

            if(vehicle_model == 508 && GetPlayerCheckTreiler(p_info[playerid][ID]))
                return SendError(playerid, "� ��� ��� ���� �������.");

            if(p_info[playerid][cash] < price)
                return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");

            new owner_id = GetPlayerUserID(veh_info[vehicleid][v_owner_id]);
            if(owner_id == INVALID_PLAYER_ID)
            {
                CarMarketVehicleClear(pos_id);
                return SendError(playerid, "�������� �� � ����");
            }
            SetPlayerMoney(playerid, -price, true, "����� �/� �� ���������");

            switch(random(5))
            {
                case 0: veh_info[vehicleid][v_pos][0] = 1764.5479, veh_info[vehicleid][v_pos][1] = -1810.0615, veh_info[vehicleid][v_pos][2] = 13.3006, veh_info[vehicleid][v_pos][3] = 90.0000;
                case 1: veh_info[vehicleid][v_pos][0] = 1764.5479, veh_info[vehicleid][v_pos][1] = -1805.0815, veh_info[vehicleid][v_pos][2] = 13.3006, veh_info[vehicleid][v_pos][3] = 90.0000;
                case 2: veh_info[vehicleid][v_pos][0] = 1764.5479, veh_info[vehicleid][v_pos][1] = -1800.0614, veh_info[vehicleid][v_pos][2] = 13.3006, veh_info[vehicleid][v_pos][3] = 90.0000;
                case 3: veh_info[vehicleid][v_pos][0] = 1764.5479, veh_info[vehicleid][v_pos][1] = -1795.0615, veh_info[vehicleid][v_pos][2] = 13.3006, veh_info[vehicleid][v_pos][3] = 90.0000;
                default: veh_info[vehicleid][v_pos][0] = 1764.5479, veh_info[vehicleid][v_pos][1] = -1790.0215, veh_info[vehicleid][v_pos][2] = 13.3006, veh_info[vehicleid][v_pos][3] = 90.0000;
            }

            veh_info[vehicleid][v_int] =
            veh_info[vehicleid][v_virt] = 0;

            SendAccess(owner_id, "�� ������� ������������ �������� "I"\"%s\". "W"�� ���������� ���� ���������: "I"%d$.", GetVehicleName(vehicleid), price);
            p_info[owner_id][bank] += price;
            MysqlUpdatePlayerInt(owner_id, "bank", p_info[owner_id][bank]);

            veh_info[vehicleid][v_owner_id] = p_info[playerid][ID];
            SaveVehicle(vehicleid);
            DestroyVehicleVEx(vehicleid);

            SendInfo(playerid, "�����������, �� ����� ���������� ������������� ��������.");
            SendInfo(playerid, "����������� /cars ����� ��������� ��� �� ������.");

            Log(LOG_player, INFO, "%s[%d](%s %s) ����� <%s>(%d)[%d] � %s[%d](%s %s) �� ��������� �� %d$",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id],
                get_name(owner_id), p_info[owner_id][ID], p_temp[owner_id][session_IP], IsPlayerMobile(owner_id) ? "Mobile": "PC",
                price);

            Log(LOG_player, INFO, "%s[%d](%s %s) ������ <%s>(%d)[%d] ������ %s[%d](%s %s) �� ��������� �� %d$",
                get_name(owner_id), p_info[owner_id][ID], p_temp[owner_id][session_IP], IsPlayerMobile(owner_id) ? "Mobile": "PC",
                GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id],
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                price);

            CarMarketVehicleClear(pos_id);
            return 1;
        }
        case D_FRACTION_LEAVE:
        {
            if(!response) return 1;
            if(p_info[playerid][Update][0] == 0 && p_info[playerid][p_vip] < 2 && p_info[playerid][admin] < 1) return SendError(playerid, "� ��� ��� ��������� \"�������������\" ��� \"VIP Silver\" ��� \"VIP GOLD\".");
            if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "�� ���������� � ������������ ��������.");
            if(p_info[playerid][member] <= 0) return SendError(playerid, "�� �� �������� �� �������.");
            if(p_info[playerid][leader] > 0 && p_info[playerid][admin] < 1) return SendError(playerid, "�� ����� �������.");

            SendAccess(playerid, "�� �������� \"%s\" �� ������������ �������.", GetFractionName(p_info[playerid][member]));

