                }
                case 5: ShowDialogBillboard(playerid, biz_id, BB_LIST_FONT_COLOR, idx);
                case 6: ShowDialogBillboard(playerid, biz_id, BB_LIST_BACK_COLOR, idx);
                case 7: ShowDialogBillboard(playerid, biz_id, BB_LIST_TEXT_ALIGMENT, idx);
                case 8: ShowDialogBillboard(playerid, biz_id, BB_LIST_RENT_DAYS, idx);
                case 9: ShowDialogBillboard(playerid, biz_id, BB_LIST_CANCEL_RENT, idx);
                case 10: ShowDialogBillboard(playerid, biz_id, BB_LIST_HELP, idx);
                case 11: ShowDialogBillboard(playerid, biz_id, BB_LIST_DEMO, idx);
            }
            return 1;
        }
        case D_BILLBOARD_TEXT:
        {
            new biz_id = GetPVarInt(playerid, "bID"), idx = GetPVarInt(playerid, "BILLBOARD:idx");
            if(!response) return ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);
            if(!strlen(inputtext)) return ShowDialogBillboard(playerid, biz_id, BB_LIST_TEXT, idx), SendError(playerid, "Вы ничего не ввели.");
            if(strlen(inputtext) > 100) return ShowDialogBillboard(playerid, biz_id, BB_LIST_TEXT, idx), SendError(playerid, "Длина текста не может превышать 100 символов.");
            format(BillboardInfo[idx][bbText], 128, inputtext);
            MysqlUpdateBillboardStr(idx, "text", BillboardInfo[idx][bbText]);
            SetBillboardText(idx);
            SendAccess(playerid, "Вы изменили текст на билборде.");
            ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);

            Log(LOG_player, INFO, "%s[%d](%s %s) изменил текст билборда(%d): %s.",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                idx, BillboardInfo[idx][bbText]);
            return 1;
        }
        case D_BILLBOARD_MATERIAL_SIZE:
        {
            new biz_id = GetPVarInt(playerid, "bID"), idx = GetPVarInt(playerid, "BILLBOARD:idx");
            if(!response) return ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);
            BillboardInfo[idx][bbMaterialSize] = 10 * (listitem + 1);
            MysqlUpdateBillboardInt(idx, "materialsize", BillboardInfo[idx][bbMaterialSize]);
            SetBillboardText(idx);
            SendAccess(playerid, "Вы изменили размер шрифта на билборде.");
            ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);
            return 1;
        }
        case D_BILLBOARD_FONT_FACE:
        {
            new biz_id = GetPVarInt(playerid, "bID"), idx = GetPVarInt(playerid, "BILLBOARD:idx");
            if(!response) return ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);
            BillboardInfo[idx][bbFontFace] = listitem;
            MysqlUpdateBillboardInt(idx, "fontface", BillboardInfo[idx][bbFontFace]);
            SetBillboardText(idx);
            SendAccess(playerid, "Вы изменили шрифт текста на билборде.");
            ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);
            return 1;
        }
        case D_BILLBOARD_FONT_SIZE:
        {
            new biz_id = GetPVarInt(playerid, "bID"), idx = GetPVarInt(playerid, "BILLBOARD:idx");
            if(!response) return ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);
            if(strval(inputtext) < 1 || strval(inputtext) > 255) return ShowDialogBillboard(playerid, biz_id, BB_LIST_FONT_SIZE, idx), SendError(playerid, "Размер текста не может быть менее 1 и более 255.");
            BillboardInfo[idx][bbFontSize] = strval(inputtext);
            MysqlUpdateBillboardInt(idx, "fontsize", BillboardInfo[idx][bbFontSize]);
            SetBillboardText(idx);
            SendAccess(playerid, "Вы изменили размер текста на билборде.");
            ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);
            return 1;
        }
        case D_BILLBOARD_FONT_COLOR:
        {
            new biz_id = GetPVarInt(playerid, "bID"), idx = GetPVarInt(playerid, "BILLBOARD:idx");
            if(!response) return ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);
            BillboardInfo[idx][bbFontColor] = listitem;
            MysqlUpdateBillboardInt(idx, "fontcolor", BillboardInfo[idx][bbFontColor]);
            SetBillboardText(idx);
            SendAccess(playerid, "Вы изменили цвет текста на билборде.");
            ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);
            return 1;
        }
        case D_BILLBOARD_BACK_COLOR:
        {
            new biz_id = GetPVarInt(playerid, "bID"), idx = GetPVarInt(playerid, "BILLBOARD:idx");
            if(!response) return ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);
            BillboardInfo[idx][bbBackColor] = listitem;
            MysqlUpdateBillboardInt(idx, "backcolor", BillboardInfo[idx][bbBackColor]);
            SetBillboardText(idx);
            SendAccess(playerid, "Вы изменили цвет фона на билборде.");
            ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);
