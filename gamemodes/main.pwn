                    new year, month, day;
                    getdate(year, month, day);
                    if(listitem == 0 && (month != 12 && month != 1 && month != 2)) return SendError(playerid, "Покупка новогодней елки доступна только в декабре, январе и феврале.");

                    switch(type)
                    {
                        case 1:
