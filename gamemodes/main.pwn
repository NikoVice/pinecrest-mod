            ShowPlayerDialog(playerid, D_PICK_CANDIDATE_ADD, DIALOG_STYLE_INPUT, ""I"��������", ""W"������� ��� ���������:", "�����", "������");
            SetPVarInt(playerid, "NumberPick", listitem);
            return 1;
        }
        case D_PICK_CANDIDATE_ADD:
        {
            if(!response) { DeletePVar(playerid, "NumberPick"); return 1; }
            new c = GetPVarInt(playerid, "NumberPick");
            if(!strlen(inputtext) || strlen(inputtext) < 4 || strlen(inputtext) > 24) return ShowPlayerDialog(playerid, D_PICK_CANDIDATE_ADD, DIALOG_STYLE_INPUT, ""I"��������", ""W"������� ��� ���������:", "�����", "������");
            if(sscanf(inputtext, "s[64]", PickName[c])) return ShowPlayerDialog(playerid, D_PICK_CANDIDATE_ADD, DIALOG_STYLE_INPUT, ""I"��������", ""W"������� ��� ���������:", "�����", "������");
