            {
                Fix_TogglePlayerControllable(playerid, 1);
                SetPlayerPos(playerid, b_info[biz_id][b_menu][0], b_info[biz_id][b_menu][1], b_info[biz_id][b_menu][2]);
                SetPlayerInterior(playerid, b_info[biz_id][_int]);
                SetPlayerVirtualWorld(playerid, b_info[biz_id][_world]);
                SetCameraBehindPlayer(playerid);
                DeletePVar(playerid, "BILLBOARD:idx");
                return 1;
            }
            new fix_listitem;
            if(sscanf(inputtext, "i", fix_listitem)) return ShowDialogBillboard(playerid, biz_id, BB_LIST_RENT, idx), SendError(playerid, "�� ������ �� �����.");
            if(fix_listitem < 1 || fix_listitem > 7) return ShowDialogBillboard(playerid, biz_id, BB_LIST_RENT, idx), SendError(playerid, "���������� ���� ������ ���� �� ����� 1 � �� ����� 7.");
            new till = b_info[biz_id][_till], price = (BILLBOARD_PRICE_RENT * till) * fix_listitem;
            if(p_info[playerid][cash] < price) return ShowDialogBillboard(playerid, biz_id, BB_LIST_RENT, idx), SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");

            OnServerInfoForMoney[10] += price;
            SetPlayerMoney(playerid, -price, true, "������ ��������");

            new prod = price / 10;

            if(b_info[biz_id][_prod] >= prod)
            {
                b_info[biz_id][_prod] -= prod;
                b_info[biz_id][_bank] += (price / 100) * 90;
                AddMafiaBank(biz_id, price/10);

                biz_finka[biz_id] += (price / 100) * 90;
                UpdateIntForFinanceBiz(biz_id, (price / 100) * 90);
            }

            BillboardInfo[idx][bbPlayerID] = p_info[playerid][ID];
            BillboardInfo[idx][bbDays] = fix_listitem;

            STRING_GLOBAL[0] = EOS;
