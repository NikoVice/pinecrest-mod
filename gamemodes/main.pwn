            {
                case 0:
                {
                    if(VideoCardsInfo[idx][vcStatus] == 0)
                    {
                        if(VideoCardsInfo[idx][vcBitcoin] >= MAX_VIDEO_CARDS_BITCOIN) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_CONTROL, idx), SendError(playerid, "�� ���������� ������������ ���������� Bitcoin, �������� ��.");
