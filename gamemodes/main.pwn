            if(!response) return ShowWarPlaneContent(playerid, idx), WarPlaneUseItems[playerid] = -1;
            if(strlen(inputtext) == 0) return SendError(playerid, "Вы ничего не ввели."), ShowWarPlaneContent(playerid, idx), WarPlaneUseItems[playerid] = -1;
