    {
        f(STRING_GLOBAL, "%s\n"I"[2]"W" ���������� � ����\n"I"[3]"W" ����������� �� �����\n%s\n%s",
            !GetPVarInt(playerid, "Ether") ? ("{63BD4E}[1] ����� � ����") : ("{F04245}[1] ����� �� �����"),
