                    if(player_lobby_settings[playerid][5] < 0 || player_lobby_settings[playerid][5] > 2) return ShowLobbyCreate(playerid), SendError(playerid, "���������� �� ����� ���� ����� 1 � ����� 3.");
                    if(player_lobby_settings[playerid][6] < 0 || player_lobby_settings[playerid][6] > 999999) return ShowLobbyCreate(playerid), SendError(playerid, "������ �� ����� ���� ����� 0 � ����� 999999.");
                    CreateLobby(playerid, player_lobby_settings[playerid][0] + 1, player_lobby_settings[playerid][1], player_lobby_settings[playerid][2], player_lobby_settings[playerid][3], player_lobby_settings[playerid][4], player_lobby_settings[playerid][5], player_lobby_settings[playerid][6]);
