            new max_btc = MAX_PLAYER_BITCOIN - p_info[playerid][bitcoin];
            if(fix_listitem < 1 || fix_listitem > max_btc) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_BANK_BUY), SendError(playerid, "Количество Bitcoin не может быть менее 1 и более %d.", max_btc);
            if(curs_btc == 0) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_BANK_BUY), SendError(playerid, "В данный момент банк не продает Bitcoin, приходите позднее.");
            new price = fix_listitem * curs_btc;
