            if(!(0 <= frac_id < MAX_FRACTIONS) || !(0 <= skin_id <= 9)) return SendError(playerid, "������� ID ������� � ID �����.");
            if(frac_id == 0)
            {
                p_temp[playerid][SpyStatus] = 0;
