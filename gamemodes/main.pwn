        case D_TC_MEMBERS:
        {
            if(!response) return UpdatePlayerList(playerid);
            new biz_id = p_temp[playerid][p_tc_id], type = b_info[biz_id][_tip], list_id = p_temp[playerid][p_listitem_int];
            if(!(0 <= list_id < 25)) return SendError(playerid, "Неизвестная ошибка: BUG-F002! Попробуйте еще раз.");
            new player_mysql_id = p_temp[playerid][p_listitem][list_id];
            if(player_mysql_id <= INVALID_MYSQL_ID) return SendError(playerid, "Неизвестная ошибка: BUG-F003! Попробуйте еще раз.");

            if(GetPlayerUserID(player_mysql_id) != INVALID_PLAYER_ID) return SendError(playerid, "Игрок в игре.");
            switch(listitem)
            {
                case 0:
                {
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name`, `taxi_rank`, `taxi_salary`, `taxi_salary_all`, `tc_rank`, `tc_salary`, `tc_salary_all`, `lastenter` FROM `accounts` WHERE `id` = %d", player_mysql_id);
                    mysql_tquery(con_bd, STRING_GLOBAL, "OnPlayerSelectTransportCompany", "iii", playerid, 1, type - B_TAXI);
                }
                case 1:
                {
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name`, `%e` FROM `accounts` WHERE `id` = %d", type == B_TAXI ? "taxi_rank" : "tc_rank", player_mysql_id);
                    mysql_tquery(con_bd, STRING_GLOBAL, "OnPlayerSelectTransportCompany", "iiisi", playerid, 2, type - B_TAXI, "", player_mysql_id);
                }
                case 2:
                {
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name`, `%e` FROM `accounts` WHERE `id` = %d", type == B_TAXI ? "taxi_rank" : "tc_rank", player_mysql_id);
                    mysql_tquery(con_bd, STRING_GLOBAL, "OnPlayerSelectTransportCompany", "iiisi", playerid, 3, type - B_TAXI, "", player_mysql_id);
                }
            }
        }
        case D_TC_MEMBERS_INFO:
        {
            ShowPlayerDialog(playerid, D_TC_MEMBERS, DIALOG_STYLE_LIST, ""I"Управление игроком", "\
            "I"[1]"W" Информация об игроке\n\
            "I"[2]"W" Уволить\n\
            "I"[3]"W" Изменить ранг", "Далее", "Отмена");
            return 1;
        }
        case D_TC_PERCENT:
        {
            if(!response) return ShowDialogBiz(playerid, TC_OWNER_MENU);
            new biz_id = p_temp[playerid][p_tc_id], percent = strval(inputtext);
            if(percent < 10 || percent > 30) return ShowDialogBiz(playerid, TC_PERCENT), SendError(playerid, "Процент не может быть менее 10 и более 30.");
            b_info[biz_id][_percent] = percent;
            save_bizz(biz_id);
            SendAccess(playerid, "Вы изменили процент взимаемый с работников на %d.", percent);
            switch(b_info[biz_id][_tip])
            {
                case B_TAXI:
                {
                    foreach(new i:Player)
                    {
                        if(p_info[i][taxi_idx] != biz_id) continue;
                        p_info[i][taxi_percent] = b_info[biz_id][_percent];
                        MysqlUpdatePlayerInt(i, "taxi_percent", p_info[i][taxi_percent]);
                    }
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `taxi_percent` = %d WHERE `taxi_idx` = %d",
                    b_info[biz_id][_percent], b_info[biz_id][b_mysql_id]);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                }
                case B_TRUCKER:
                {
                    foreach(new i:Player)
                    {
                        if(p_info[i][tc_idx] != biz_id) continue;
                        p_info[i][tc_percent] = b_info[biz_id][_percent];
                        MysqlUpdatePlayerInt(i, "tc_percent", p_info[i][tc_percent]);
                    }
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `tc_percent` = %d WHERE `tc_idx` = %d",
                    b_info[biz_id][_percent], b_info[biz_id][b_mysql_id]);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                }
            }
            return 1;
        }
        case D_TC_FARE:
        {
            if(!response) return ShowDialogBiz(playerid, TC_OWNER_MENU);
            new biz_id = p_temp[playerid][p_tc_id], temp_tc_fare_type, temp_tc_fare_price;
            if(sscanf(inputtext, "p<,>dd", temp_tc_fare_type, temp_tc_fare_price)) return ShowDialogBiz(playerid, TC_FARE), SendError(playerid, "Вы ничего не ввели.");
            if(temp_tc_fare_type < 1 || temp_tc_fare_type > 4) return ShowDialogBiz(playerid, TC_FARE), SendError(playerid, "Тип не может быть менее 1 и более 4.");
            new min_tc_fare[4] = {100, 125, 100, 250}, max_tc_fare[4] = {200, 250, 200, 500};
            if(temp_tc_fare_price < min_tc_fare[temp_tc_fare_type - 1] || temp_tc_fare_price > max_tc_fare[temp_tc_fare_type - 1]) return ShowDialogBiz(playerid, TC_FARE), SendError(playerid, "Стоимость не может быть менее %d и более %d.", min_tc_fare[temp_tc_fare_type - 1], max_tc_fare[temp_tc_fare_type - 1]);
            b_info[biz_id][b_fare][temp_tc_fare_type - 1] = temp_tc_fare_price;
            save_bizz(biz_id);
            SendAccess(playerid, "Вы изменили тариф класса \"%s\" на %d$.", TransportCompanyFareName[temp_tc_fare_type - 1], temp_tc_fare_price);
            return 1;
        }
        case D_TC_VEHICLE_TAXI:
        {
            if(!response)
            {
                DeletePVar(playerid, "ARENDA:FIX");
                return RemovePlayerFromVehicle(playerid);
            }
            DeletePVar(playerid, "ARENDA:FIX");

            if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Вы должны находиться в транспортном средстве.");

            new vehicleid = GetPlayerVehicleID(playerid), biz_id = p_info[playerid][taxi_idx];

            p_temp[playerid][rented_veh] = vehicleid;
            veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];

            SendAccess(playerid, "Вы начали рабочий день.");

            SendInfo(playerid, "Принять вызов: /to");
            SendInfo(playerid, "Завершить рабочий день: /unrent");
            SetPVarInt(playerid, "@passanger", 0);

            veh_info[vehicleid][v_cost_taxi] = GetBizFare(biz_id, vehicleid);
            veh_info[vehicleid][v_job] = JOB_TC_TAXI;

            if(veh_info[vehicleid][v_text] == INVALID_3DTEXT_ID)
            {
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Такси\n<< Проезд: "W"%d$"I" >>", veh_info[vehicleid][v_cost_taxi]);
                veh_info[vehicleid][v_text] = Create3DTextLabel(STRING_GLOBAL, COLOR_MAIN, 0.0, 0.0, 0.0, 10.0, 0, 1);
                Attach3DTextLabelToVehicle(veh_info[vehicleid][v_text], vehicleid, 0.0, 0.0, 1.5);
            }
            else
            {
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Такси\n<< Проезд: "W"%d$"I" >>", veh_info[vehicleid][v_cost_taxi]);
                Update3DTextLabelText(veh_info[vehicleid][v_text], COLOR_MAIN, STRING_GLOBAL);
            }

            StartPlayerJob(playerid, TAXI_WORK);
            return 1;
        }
