            }
            if(!duel_command[0] || !duel_command[1])
            {
                if(!duel_command[0]) DuelData[duelid][dGameCommand2Kill] += 1;
                if(!duel_command[1]) DuelData[duelid][dGameCommand1Kill] += 1;
                DuelData[duelid][dGameRound] += 1;

                for(new i; i < 10; i++)
                {
                    if(DuelData[duelid][dCommand1][i] != INVALID_PLAYER_ID)
                    {
                        if(GetPlayerState(DuelData[duelid][dCommand1][i]) == PLAYER_STATE_SPECTATING)
                        {
