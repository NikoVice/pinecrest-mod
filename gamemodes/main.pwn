        case D_RA_MC:
        {
            if(!response) return ShowPlayerDialog(playerid, D_RA, DIALOG_STYLE_LIST, ""I"Мастерская одежды", ""I"[1]"W" Отремонтировать аксессуар\n"I"[2]"W" Изменить цвет аксессуара\n"I"[3]"W" Помощь по мастерской", "Далее", "Отмена"), DeletePVar(playerid, "RA:idx");
            STRING_GLOBAL[0] = EOS;
            for(new i; i < sizeof(AccessoriesColorInfo); i++)
            {
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{%06x} %s\n", STRING_GLOBAL, i == 0 ? 0xFFFFFF : AccessoriesColorInfo[i][acColorRBG] & 0xFFFFFF, AccessoriesColorInfo[i][acName]);
            }
            ShowPlayerDialog(playerid, D_RA_MC_1, DIALOG_STYLE_LIST, ""I"Цвет #1", STRING_GLOBAL, "Далее", "Отмена");
            return 1;
        }
        case D_RA_MC_1:
        {
            if(!response) return ShowPlayerDialog(playerid, D_RA, DIALOG_STYLE_LIST, ""I"Мастерская одежды", ""I"[1]"W" Отремонтировать аксессуар\n"I"[2]"W" Изменить цвет аксессуара\n"I"[3]"W" Помощь по мастерской", "Далее", "Отмена"), DeletePVar(playerid, "RA:idx");

            new temp_idx;
            if(listitem > 0)
            {
                temp_idx = 701+listitem;
                if(GetInventoryAmount(playerid, temp_idx) < ACCESSORIES_COLOR)
                {
                    SendError(playerid, "У Вас слишком мало %s. Для покраски необходимо еще: %d ед.", ItemsInfo[temp_idx][iName], ACCESSORIES_COLOR - GetInventoryAmount(playerid, temp_idx));
                    STRING_GLOBAL[0] = EOS;
                    for(new i; i < sizeof(AccessoriesColorInfo); i++)
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{%06x} %s\n", STRING_GLOBAL, i == 0 ? 0xFFFFFF : AccessoriesColorInfo[i][acColorRBG] & 0xFFFFFF, AccessoriesColorInfo[i][acName]);
                    return ShowPlayerDialog(playerid, D_RA_MC_1, DIALOG_STYLE_LIST, ""I"Цвет #1", STRING_GLOBAL, "Далее", "Отмена");
                }
            }

            SetPVarInt(playerid, "RA:materialcolor", listitem);

            STRING_GLOBAL[0] = EOS;
            for(new i; i < sizeof(AccessoriesColorInfo); i++)
            {
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{%06x} %s\n", STRING_GLOBAL, i == 0 ? 0xFFFFFF : AccessoriesColorInfo[i][acColorRBG] & 0xFFFFFF, AccessoriesColorInfo[i][acName]);
            }
            ShowPlayerDialog(playerid, D_RA_MC_2, DIALOG_STYLE_LIST, ""I"Цвет #2", STRING_GLOBAL, "Далее", "Отмена");
            return 1;
        }
        case D_RA_MC_2:
        {
            if(!response) return ShowPlayerDialog(playerid, D_RA, DIALOG_STYLE_LIST, ""I"Мастерская одежды", ""I"[1]"W" Отремонтировать аксессуар\n"I"[2]"W" Изменить цвет аксессуара\n"I"[3]"W" Помощь по мастерской", "Далее", "Отмена"), DeletePVar(playerid, "RA:idx"), DeletePVar(playerid, "RA:materialcolor");

            new biz_id = GetPVarInt(playerid, "bID"),
                till = b_info[biz_id][_till],
                slot_id = GetPVarInt(playerid, "RA:idx"),
                materialcolor = GetPVarInt(playerid, "RA:materialcolor"),
                itemID = InventoryPlayer[playerid][slot_id][inv_item_id],
                price = ItemsInfo[itemID][iPrice]/4*till;
            DeletePVar(playerid, "RA:idx");
            DeletePVar(playerid, "RA:materialcolor");

            if(!(0 <= listitem <= sizeof(AccessoriesColorInfo))) return 1;
            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            new temp_idx;
            if(listitem > 0)
            {
                temp_idx = 701+listitem;
                if(GetInventoryAmount(playerid, temp_idx) < ACCESSORIES_COLOR)
                {
                    SendError(playerid, "У Вас слишком мало %s. Для покраски необходимо еще: %d ед.",ItemsInfo[temp_idx][iName], ACCESSORIES_COLOR - GetInventoryAmount(playerid, temp_idx));
                    STRING_GLOBAL[0] = EOS;
                    for(new i; i < sizeof(AccessoriesColorInfo); i++)
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{%06x} %s\n", STRING_GLOBAL, i == 0 ? 0xFFFFFF : AccessoriesColorInfo[i][acColorRBG] & 0xFFFFFF, AccessoriesColorInfo[i][acName]);
                    return ShowPlayerDialog(playerid, D_RA_MC_2, DIALOG_STYLE_LIST, ""I"Цвет #2", STRING_GLOBAL, "Далее", "Отмена");
                }
            }
            InventoryPlayer[playerid][slot_id][inv_acc_mt][0] = materialcolor;
            InventoryPlayer[playerid][slot_id][inv_acc_mt][1] = listitem;

            if(listitem > 0)
            {
                temp_idx = 701 + materialcolor;
                GivePlayerInventory(playerid, temp_idx, -ACCESSORIES_COLOR);

                temp_idx = 701 + listitem;
                GivePlayerInventory(playerid, temp_idx, -ACCESSORIES_COLOR);
            }

            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `inventory` SET `acc_mt1` = %d, `acc_mt2` = %d WHERE `mysql_id` = %d", materialcolor, listitem, InventoryPlayer[playerid][slot_id][inv_mysql_id]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            SendAccess(playerid, "Вы изменили цвет аксессуара \"%s\" за %d$.", ItemsInfo[itemID][iName], price);
            if(b_info[biz_id][_prod] >= (price / 10) / 100)
            {
                b_info[biz_id][_prod] -= (price / 10) / 100;
                b_info[biz_id][_bank] += (price / 10) - (price / 100);
                AddMafiaBank(biz_id, price / 100);

                biz_finka[biz_id] += (price / 10) - (price / 100);
                UpdateIntForFinanceBiz(biz_id, (price / 10) - (price / 100));
            }
            SetPlayerMoney(playerid, -price, true, "изменение цвета аксессуара <%s>", ItemsInfo[itemID][iName]);
            return 1;
        }
