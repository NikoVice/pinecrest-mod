this::VoiceChat()
{
    // // VoiceChat_StartPushInfo();
    new Float:pos_px, Float:pos_py, Float:pos_pz;
    foreach(new i: Player)
    {
        if(!p_info[i][loggedIn]) continue;
        GetPlayerPos(i, pos_px, pos_py, pos_pz);
        // VoiceChat_PushInfo(i, pos_px, pos_py, pos_pz, GetPlayerVirtualWorld(i), false);
    }
    // VVoiceChat_EndPushInfo();
}

