                    OnServerInfoForMoney[17] += reason_money;

                    p_info[playerid][job_skill_salary][16] += reason_money;
                }
                else SendError(playerid, "За последний час игры было заработано максимальное количество денежных средств.");

                p_temp[playerid][pPressed]++;
                new idx = p_temp[playerid][pPressed];
                if(Tram[idx][tramStop] == 1) SetPlayerRaceCheckpoint(playerid, 1, Tram[idx][tramPosX], Tram[idx][tramPosY], Tram[idx][tramPosZ]-1.5, 0, 0, 0, 3.0), p_temp[playerid][TramStop] = true;
                else SetPlayerRaceCheckpoint(playerid, 0, Tram[idx][tramPosX], Tram[idx][tramPosY], Tram[idx][tramPosZ]-1.5, Tram[idx+1][tramPosX], Tram[idx+1][tramPosY], Tram[idx+1][tramPosZ]-1.5, 3.0);
            }
        }
    }
    if(p_temp[playerid][Work_ID] == FIREMAN_WORK && p_temp[playerid][FireStatus])
    {
        if(AntiCheatWarningTime[playerid][0] > timestamp) return SendError(playerid, "Вы не можете доставлять заказы так часто, подождите.");

        SendMes(playerid, COLOR_BLUE, "Вы прибыли на место пожара.");
        SendMes(playerid, COLOR_SEA_WAVE, "Вам необходимо потушить 5 возгораний.");
        DisablePlayerRaceCheckpoint(playerid);
        return 1;
    }
    if(p_temp[playerid][Work_ID] == TAXI_WORK && p_temp[playerid][taxi_bots_idx])
    {
        if(AntiCheatWarningTime[playerid][0] > timestamp)
        {
            SendError(playerid, "Вы не можете доставлять заказы так часто, подождите.");
            new idx = p_temp[playerid][taxi_bots_gps_idx];
            if(idx == 0)
            {
                new index = p_temp[playerid][taxi_bots_idx] - 1;
                SetPlayerRaceCheckpoint(playerid, 1, TaxiBots[index][tActorPos][0], TaxiBots[index][tActorPos][1], TaxiBots[index][tActorPos][2], 0, 0, 0, 5);
            }
            else
            {
                idx--;
                SetPlayerRaceCheckpoint(playerid, 1, frac_info[idx][gps_x], frac_info[idx][gps_y], frac_info[idx][gps_z], 0, 0, 0, 5);
            }
            return 1;
        }

        SendMes(playerid, COLOR_BLUE, "Вы прибыли на место вызова.");
        DisablePlayerRaceCheckpoint(playerid);
        if(p_temp[playerid][taxi_bots_gps_idx] == 0) CheckTaxi(playerid);
        else
        {
            new salary = p_temp[playerid][taxi_bots_salary], reason_money = GetPlayerMoneySkill(playerid, GetBizPercent(playerid, TYPE_TC_TAXI, salary), 8);

            if(CheckPlayerMaxSalarySkill(playerid, 8, reason_money))
            {
                SetPlayerMoney(playerid, reason_money, false, "");
                OnServerInfoForMoney[17] += reason_money;

                p_info[playerid][job_skill_salary][17] += reason_money;

                TransferBizMoney(playerid, TYPE_TC_TAXI, p_temp[playerid][fix_bug_biz_tc_salary]);

                SendMes(playerid, COLOR_BLUE, "Вы выполнили заказ и заработали %d$.", reason_money);
            }
            else SendError(playerid, "За последний час игры было заработано максимальное количество денежных средств.");

            UpdatePlayerWorkSkill(playerid, 8);

            CheckPlayerMission(playerid, START_TAXI);
            CheckPlayerMission(playerid, DAILY_TAXI);
            CheckPlayerMission(playerid, ACHIEVEMENT_TAXI);

            CheckPlayerFreelance(playerid, FREELANCE_TAXI);
            CheckPlayerBattlePass(playerid, BATTLEPASS_TAXI);

            UpdateFamilyLevel(playerid);
            UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_TAXI); // Контракты: Водитель такси

            DestroyTaxi(playerid);
            p_temp[playerid][taxi_bots_idx] = 0;
            p_temp[playerid][taxi_bots_timer] = RandomEx(30, 60);

            if(GetPlayerGiveCasket(100, 5) != -1) GivePlayerCasket(playerid, -1);
        }
        return 1;
    }
    if(p_temp[playerid][Work_ID] == MECHANIC_WORK && p_temp[playerid][mechanic_idx])
    {
        if(AntiCheatWarningTime[playerid][0] > timestamp)
        {
            SendError(playerid, "Вы не можете доставлять заказы так часто, подождите.");
            new index = p_temp[playerid][mechanic_idx] - 1;
            SetPlayerRaceCheckpoint(playerid, 1, MechanicsBots[index][mVehiclePos][0], MechanicsBots[index][mVehiclePos][1], MechanicsBots[index][mVehiclePos][2], 0, 0, 0, 5);
            return 1;
        }

        SendMes(playerid, COLOR_BLUE, "Вы прибыли на место вызова.");
        SendMes(playerid, COLOR_SEA_WAVE, "Вам необходимо охладить огнегасником транспортное средство.");
        DisablePlayerRaceCheckpoint(playerid);
        return 1;
    }
    if(p_temp[playerid][Work_ID] == RAILWAY_WORK)
    {
        switch(p_temp[playerid][RailwayType])
        {
            case 1:
            {
                if(p_temp[playerid][RailwayCheck] == 0)
                {
                    if(GetPlayerState(playerid) == PLAYER_STATE_PASSENGER || GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
                    {
                        if(random(2) == 0) SetPlayerRaceCheckpoint(playerid, 1, 2460.1770, -2584.1350, 13.6744, 0.0, 0.0, 0.0, 2.5);
                        else SetPlayerRaceCheckpoint(playerid, 1, 2460.1689, -2614.2964, 13.6822, 0.0, 0.0, 0.0, 2.5);
                        return 1;
                    }
                    if(AntiCheatWarningTime[playerid][0] > timestamp)
                    {
                        SendError(playerid, "Вы не можете доставлять заказы так часто, подождите.");
                        if(random(2) == 0) SetPlayerRaceCheckpoint(playerid, 1, 2460.1770, -2584.1350, 13.6744, 0.0, 0.0, 0.0, 2.5);
                        else SetPlayerRaceCheckpoint(playerid, 1, 2460.1689, -2614.2964, 13.6822, 0.0, 0.0, 0.0, 2.5);
                        return 1;
                    }

                    DisablePlayerRaceCheckpoint(playerid);

                    p_temp[playerid][RailwayCheck] ^= 1;

                    new idx = random(2);
                    p_temp[playerid][RailwayIDx] = idx;

                    if(idx == 0) SetPlayerAttachedObject(playerid, 1, 19433, 1, 0.067998, 0.627999, -0.050000, 0.000000, 6.499962, 3.199962, 0.528000, 0.487000, 0.434999);
                    else SetPlayerAttachedObject(playerid, 1, 19843, 1, 0.038999, 0.525999, 0.027999, -173.600036, 86.099967, -92.800033, 0.643000, 0.700000, 1.000000);

                    SendMes(playerid, COLOR_SEA_WAVE, "Вы взяли %s, отнесите %s на склад.", idx == 0 ? "древесину" : "металл", idx == 0 ? "её" : "его");

                    if(random(2) == 0) SetPlayerRaceCheckpoint(playerid, 1, 2432.4314, -2601.3684, 13.6858, 0.0, 0.0, 0.0, 5.0);
                    else SetPlayerRaceCheckpoint(playerid, 1, 2432.4373, -2618.0481, 13.6858, 0.0, 0.0, 0.0, 5.0);

                    ClearAnimations(playerid);
                    ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 1, 0, 0, 1, 1);

                    AntiCheatWarningTime[playerid][0] = timestamp + 4;
                }
                else
                {
                    if(GetPlayerState(playerid) == PLAYER_STATE_PASSENGER || GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
                    {
                        if(random(2) == 0) SetPlayerRaceCheckpoint(playerid, 1, 2432.4314, -2601.3684, 13.6858, 0.0, 0.0, 0.0, 5.0);
                        else SetPlayerRaceCheckpoint(playerid, 1, 2432.4373, -2618.0481, 13.6858, 0.0, 0.0, 0.0, 5.0);
                        return 1;
                    }
                    if(AntiCheatWarningTime[playerid][0] > timestamp)
                    {
                        SendError(playerid, "Вы не можете доставлять заказы так часто, подождите.");
                        if(random(2) == 0) SetPlayerRaceCheckpoint(playerid, 1, 2432.4314, -2601.3684, 13.6858, 0.0, 0.0, 0.0, 5.0);
                        else SetPlayerRaceCheckpoint(playerid, 1, 2432.4373, -2618.0481, 13.6858, 0.0, 0.0, 0.0, 5.0);
                        return 1;
                    }

                    p_temp[playerid][RailwayCheck] ^= 1;
                    if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
                    DisablePlayerRaceCheckpoint(playerid);
                    p_temp[playerid][RailwayCount][p_temp[playerid][RailwayIDx]]++;
                    SendMes(playerid, COLOR_LYELLOW, "Вы перенесли {"#cLIME"}%d{"#cLYELLOW"} древесины и {"#cLIME"}%d{"#cLYELLOW"} металла.", p_temp[playerid][RailwayCount][0], p_temp[playerid][RailwayCount][1]);

                    new reason_money = GetPlayerMoneySkill(playerid, 100, 0);

                    if(CheckPlayerMaxSalarySkill(playerid, 0, reason_money))
                    {
                        SetPlayerMoney(playerid, reason_money, true, "зарплата жд завод");
                        OnServerInfoForMoney[17] += reason_money;
                        p_temp[playerid][RailwaySalary] += reason_money;
