CMD:rob(playerid, params[])
{
    if(mafia(playerid) == 0) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(p_info[playerid][rang] < 5) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /rob [id игрока]");
    if(AntiDMZone(playerid)) return SendError(playerid, "Вы не можете грабить \"Зеленой зоне\".");
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
    if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");
    if(!p_temp[params[0]][tTied]) return SendError(playerid, "Игрок не связан.");
    if(!p_temp[params[0]][tGag]) return SendError(playerid, "У игрока нет кляпа.");
    if(p_temp[playerid][tTied]) return SendError(playerid, "Вы связаны.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(p_info[params[0]][p_afkTime] > 2) return SendError(playerid, "Данный игрок в AFK.");
    if(p_info[params[0]][level] < 5) return SendError(playerid, "У игрока нет 5-ого уровня.");
    if(mafia(params[0]) == 1) return SendError(playerid, "Вы не можете совершить ограбление члена мафии.");
    if(p_info[playerid][commit_a_robbery]) return SendError(playerid, "Вы не можете совершить ограбление еще %d час(-а/-ов).", p_info[playerid][commit_a_robbery]);
    if(p_info[params[0]][robbed]) return SendError(playerid, "Вы не можете ограбить данного игрока еще %d час(-а/-ов).", p_info[params[0]][robbed]);

    switch(random(100))
    {
        case 0..19:
        {
            p_info[playerid][commit_a_robbery] = 2;
            p_info[params[0]][robbed] = 4;

            if(p_info[params[0]][cash] > 1000)
            {
                new Float:rob_percent;
                switch(p_info[params[0]][level])
                {
                    case 5..10: rob_percent = 0.02;
                    case 11..20: rob_percent = 0.04;
                    case 21..30: rob_percent = 0.06;
                    case 31..40: rob_percent = 0.08;
                    default: rob_percent = 0.10;
                }

                new money = floatround(p_info[params[0]][cash] * rob_percent, floatround_ceil);

                if(money > 100000) money = 100000;

                new newmoney = (money / 2) / 5;

                OnServerInfoForMoney[38] += money / 2;

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] ограбил %s [%d] на %d$. Из них потеряно: %d$. На счет мафии зачислено: %d$.", get_name(playerid), playerid, get_name(params[0]), params[0], money, money / 2, newmoney);
                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);

                SetFractionWarehouse(p_info[playerid][member], fwMoney, newmoney);

                SendAccess(playerid, "Вы ограбили %s на %d$, %d$ из них было потеряно, а %d$ было отправлено на счет мафии.", get_name(params[0]), money, money / 2, newmoney);
                SendInfo(params[0], "Вас ограбил(-а) %s на %d$.", get_name(playerid), money);

                SetPlayerMoney(playerid, (money / 2) - newmoney, true, "ограбил /rob %s[%d](%s %s)[%d$]", get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC", p_info[params[0]][cash]);
                SetPlayerMoney(params[0], -money, true, "был ограблен /rob %s[%d](%s %s)[%d$]", get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash]);
            }
            else
            {
                SendInfo(playerid, "Вы ограбили %s, но ничего не нашли.", get_name(params[0]));
                SendInfo(params[0], "Вас ограбил(-а) %s, но ничего не наш(-ел/-ла).", get_name(playerid));
            }
            new string[128];
            format(string, sizeof(string), "%s ограбил(-а) %s", get_name(playerid), get_name(params[0]));
            SendStreamMessage(30.0, playerid, string, 0xE75480FF);

            p_info[playerid][wanted] += 2;
            if(p_info[playerid][wanted] > 6) p_info[playerid][wanted] = 6;
            SetPlayerWantedLevel(playerid, p_info[playerid][wanted]);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] ограбил(-а) игрока.", get_name(playerid), playerid);
            SendFractionMessage(POLICE_LS, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(POLICE_SF, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(POLICE_LV, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(FBI_TEAM, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);
        }
        default:
        {
            p_info[playerid][commit_a_robbery] = 2;
            p_info[params[0]][robbed] = 4;

            SendInfo(playerid, "У Вас не получилось совершить ограбление, Вы объявлены в розыск.");
            SendInfo(params[0], "%s попытался Вас ограбить.", get_name(playerid));

            p_info[playerid][wanted] = 6;
            SetPlayerWantedLevel(playerid, p_info[playerid][wanted]);

            /*STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] попытал(-ся/-ась) ограбить игрока.", get_name(playerid), playerid);
            SendFractionMessage(POLICE_LS, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(POLICE_SF, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(POLICE_LV, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(FBI_TEAM, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);*/
        }
    }
    return 1;
}

f_GivePlayerWeapon(playerid, weaponid, ammo, bool:give_save = true)
{
    new slot = WEAPON_Slot[weaponid];
    p_info[playerid][Weapon][slot] = weaponid;
    if(give_save == true) p_info[playerid][Ammo][slot] += ammo;
    ResetPlayerWeapons(playerid);
    for(new i; i < MAX_WEAPONS; i++) GivePlayerWeapon(playerid, p_info[playerid][Weapon][i], p_info[playerid][Ammo][i]);
    SetPlayerArmedWeapon(playerid, 0);
}

f_ResetPlayerWeapons(playerid)
{
    for (new i; i < MAX_WEAPONS; i++) {
        p_info[playerid][Weapon][i] =
        p_info[playerid][Ammo][i] = 0;
    }
    ResetPlayerWeapons(playerid);
}

