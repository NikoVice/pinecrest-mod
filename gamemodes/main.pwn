                            else
                            {
                                EtherCall[2] = false;
                                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] выключил прием звонков.", get_name(playerid), playerid);
                                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
                            }
                        }
                    }
                }
                case 4:
                {
                    if(!GetPVarInt(playerid, "Ether")) return SendError(playerid, "Вы должны находиться в прямом эфире.");
                    switch(p_info[playerid][member])
                    {
                        case RADIO_LS:
                        {
                            if(EtherSms[0] == false)
                            {
                                EtherSms[0] = true;
                                STRING_GLOBAL[0] = EOS;
                                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] включил прием SMS.", get_name(playerid), playerid);
                                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
                            }
                            else
                            {
                                EtherSms[0] = false;
                                STRING_GLOBAL[0] = EOS;
                                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] выключил прием SMS.", get_name(playerid), playerid);
                                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
                            }
                        }
                        case RADIO_SF:
                        {
                            if(EtherSms[1] == false)
                            {
                                EtherSms[1] = true;
                                STRING_GLOBAL[0] = EOS;
                                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] включил прием SMS.", get_name(playerid), playerid);
                                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
                            }
                            else
                            {
                                EtherSms[1] = false;
                                STRING_GLOBAL[0] = EOS;
                                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] выключил прием SMS.", get_name(playerid), playerid);
                                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
                            }
                        }
                        case RADIO_LV:
                        {
                            if(EtherSms[2] == false)
                            {
                                EtherSms[2] = true;
                                STRING_GLOBAL[0] = EOS;
                                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] включил прием SMS.", get_name(playerid), playerid);
                                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
                            }
                            else
                            {
                                EtherSms[2] = false;
                                STRING_GLOBAL[0] = EOS;
                                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] выключил прием SMS.", get_name(playerid), playerid);
                                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
                            }
                        }
                    }
                }
            }
        }
        case D_NEWS_INVITE:
        {
            if(!response) return 1;
            new targetid;
            if(sscanf(inputtext, "u", targetid)) return ShowPlayerDialog(playerid,D_NEWS_INVITE, 1, "Эфир", ""W"Введите ID или имя игрока:", "Принять", "Отмена");
            if(targetid == playerid) return SendError(playerid, "Вы ввели свой ID.");
            if(targetid == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не в игре.");
            if(IsPlayerInAnyVehicle(playerid) && !IsPlayerInVehicle(targetid, GetPlayerVehicleID(playerid)) || !IsPlayerInAnyVehicle(playerid) && !IsPlayerStream(10.0, playerid, targetid)) return SendError(playerid, "Игрок должен быть с Вами в транспортном средстве.");
            if(GetPVarInt(targetid, "EtherLive")) return SendError(playerid, "Игрок уже в эфире.");
            if(p_info[playerid][member] == RADIO_LV && p_info[targetid][news] != RADIO_LV) return SendError(playerid, "Игрок не подключен к \"Радиостанции Las Venturas\".");
            if(p_info[playerid][member] == RADIO_SF && p_info[targetid][news] != RADIO_SF) return SendError(playerid, "Игрок не подключен к \"Радиостанции San Fierro\".");
            if(p_info[playerid][member] == RADIO_LS && p_info[targetid][news] != RADIO_LS) return SendError(playerid, "Игрок не подключен к \"Радиостанции Los Los\".");
            SetPVarInt(targetid, "EtherLive", p_info[playerid][member]);
            SendAccess(playerid, "Вы подключили %s к эфиру.", get_name(targetid));
            SendInfo(targetid, "%s подключил Вас к эфиру.", get_name(playerid));
        }
        case D_NEWS_UNINVITE:
        {
            if(!response) return 1;
            new targetid;
            if(sscanf(inputtext, "u", targetid)) return ShowPlayerDialog(playerid, D_NEWS_UNINVITE, 1, "Эфир", ""W"Введите ID или имя игрока:", "Принять", "Отмена");
            if(targetid == playerid) return SendError(playerid, "Вы ввели свой ID.");
            if(targetid == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не в игре.");
            if(IsPlayerInAnyVehicle(playerid) && !IsPlayerInVehicle(targetid, GetPlayerVehicleID(playerid)) || !IsPlayerInAnyVehicle(playerid) && !IsPlayerStream(10.0, playerid, targetid)) return SendError(playerid, "Игрок должен быть с Вами в транспортном средстве.");
            if(GetPVarInt(targetid, "EtherLive") != p_info[playerid][member]) return SendError(playerid, "Игрок не в прямом эфире.");
            DeletePVar(targetid, "EtherLive");
            SendAccess(playerid, "Вы отключили %s из эфира.", get_name(targetid));
            SendInfo(targetid, "%s отключил Вас из эфира.", get_name(playerid));
        }
        case D_NEWS_RADIO:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0:
                {
                    SendAccess(playerid, "Вы включили \"Радиостанцию Los Santos\".");
                    p_info[playerid][news] = RADIO_LS;
                    if(GetPVarInt(playerid, "EtherLive") == RADIO_LS || GetPVarInt(playerid, "Ether") == RADIO_LS || GetPVarInt(playerid, "EtherCalled") == RADIO_LS)
                    {
                        DeletePVar(playerid, "EtherLive");
                        DeletePVar(playerid, "Ether");
                        DeletePVar(playerid, "EtherCalled");
                        SendInfo(playerid, "Вы вышли из прямого эфира.");
                    }
                }
                case 1:
                {
                    SendAccess(playerid, "Вы включили \"Радиостанцию San Fierro\".");
                    p_info[playerid][news] = RADIO_SF;
                    if(GetPVarInt(playerid, "EtherLive") == RADIO_SF || GetPVarInt(playerid, "Ether") == RADIO_SF || GetPVarInt(playerid, "EtherCalled") == RADIO_SF)
                    {
                        DeletePVar(playerid, "EtherLive");
                        DeletePVar(playerid, "Ether");
                        DeletePVar(playerid, "EtherCalled");
                        SendInfo(playerid, "Вы вышли из прямого эфира.");
                    }
                }
                case 2:
                {
                    SendAccess(playerid, "Вы включили \"Радиостанцию Las Venturas\".");
                    p_info[playerid][news] = RADIO_LV;
                    if(GetPVarInt(playerid, "EtherLive") == RADIO_LV || GetPVarInt(playerid, "Ether") == RADIO_LV || GetPVarInt(playerid, "EtherCalled") == RADIO_LV)
                    {
                        DeletePVar(playerid, "EtherLive");
                        DeletePVar(playerid, "Ether");
                        DeletePVar(playerid, "EtherCalled");
                        SendInfo(playerid, "Вы вышли из прямого эфира.");
                    }
                }
                case 3:
                {
                    SendAccess(playerid, "Вы выключили радиостанцию.");
                    p_info[playerid][news] = 0;
                    if(GetPVarInt(playerid, "EtherLive"))
                    {
                        DeletePVar(playerid, "EtherLive");
                        SendInfo(playerid, "Вы вышли из прямого эфира.");
                    }
                }
                default: return ShowPlayerDialog(playerid, D_NEWS_RADIO, DIALOG_STYLE_LIST, ""I"Радиостанция", ""I"[1]"W" LS News\n"I"[2]"W" SF News\n"I"[3]"W" LV News\n"I"[4]"W" Выключить", "Далее", "Отмена");
            }
            MysqlUpdatePlayerInt(playerid, "news", p_info[playerid][news]);
            return 1;
        }
        case D_NEWS_MENU:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0: ShowPlayerDialog(playerid, D_NEWS_SET_CALL, DIALOG_STYLE_INPUT, ""I"Стоимость 1 секунды эфира", ""W"Введите стоимость 1 секунды в эфире:\n\n{"#cLIGHTRED"}Обратите внимание! Стоимость должна быть не менее 1$ и не более 10$.", "Далее", "Отмена");
                case 1: ShowPlayerDialog(playerid, D_NEWS_SET_SMS, DIALOG_STYLE_INPUT, ""I"Стоимость 1 сообщения", ""W"Введите стоимость 1 сообщения:\n\n{"#cLIGHTRED"}Обратите внимание! Стоимость должна быть не менее 10$ и не более 25$.", "Далее", "Отмена");
            }
        }
        case D_NEWS_SET_CALL:
        {
            if(!response) return 1;
            new price;
            if(sscanf(inputtext, "i", price)) return ShowPlayerDialog(playerid, D_NEWS_SET_CALL, DIALOG_STYLE_INPUT, ""I"Стоимость 1 секунды эфира", ""W"Введите стоимость 1 секунды в эфире:\n\n{"#cLIGHTRED"}Обратите внимание! Стоимость должна быть не менее 1$ и не более 10$.", "Далее", "Отмена");
            if(price < 1 || price > 10) return ShowPlayerDialog(playerid, D_NEWS_SET_CALL, DIALOG_STYLE_INPUT, ""I"Стоимость 1 секунды эфира", ""W"Введите стоимость 1 секунды в эфире:\n\n{"#cLIGHTRED"}Обратите внимание! Стоимость должна быть не менее 1$ и не более 10$.", "Далее", "Отмена");
            switch(p_info[playerid][member])
            {
                case RADIO_LS:
                {
                    CallPrice[0] = price;
                    SendAccess(playerid, "Вы изменили стоимость 1 секунды в эфире на %d$.", price);
                    new string[24];
                    format(string, sizeof(string),"%i, %i", SmsPrice[0], CallPrice[0]);
                    MysqlUpdateOtherStr("newsprice", string);
                }
                case RADIO_SF:
                {
                    CallPrice[1] = price;
                    SendAccess(playerid, "Вы изменили стоимость 1 секунды в эфире на %d$.", price);
                    new string[24];
                    format(string, sizeof(string),"%i, %i", SmsPrice[1], CallPrice[1]);
                    MysqlUpdateOtherStr("newspricesf", string);
                }
                case RADIO_LV:
                {
                    CallPrice[2] = price;
                    SendAccess(playerid, "Вы изменили стоимость 1 секунды в эфире на %d$.", price);
                    new string[24];
                    format(string, sizeof(string),"%i, %i", SmsPrice[2], CallPrice[2]);
                    MysqlUpdateOtherStr("newspricelv", string);
                }
            }
        }
        case D_NEWS_SET_SMS:
        {
            if(!response) return 1;
            new price;
            if(sscanf(inputtext, "i", price)) return ShowPlayerDialog(playerid, D_NEWS_SET_SMS, DIALOG_STYLE_INPUT, ""I"Стоимость 1 сообщения", ""W"Введите стоимость 1 сообщения:\n\n{"#cLIGHTRED"}Обратите внимание! Стоимость должна быть не менее 10$ и не более 25$.", "Далее", "Отмена");
            if(price < 10 || price > 25) return ShowPlayerDialog(playerid, D_NEWS_SET_SMS, DIALOG_STYLE_INPUT, ""I"Стоимость 1 сообщения", ""W"Введите стоимость 1 сообщения:\n\n{"#cLIGHTRED"}Обратите внимание! Стоимость должна быть не менее 10$ и не более 25$.", "Далее", "Отмена");

            switch(p_info[playerid][member])
            {
                case RADIO_LS:
                {
                    SmsPrice[0] = price;
                    SendAccess(playerid, "Вы изменили стоимость 1 сообщения на %d$.", price);
                    new string[24];
                    format(string, sizeof(string),"%i, %i", SmsPrice[0], CallPrice[0]);
                    MysqlUpdateOtherStr("newsprice", string);
                }
                case RADIO_SF:
                {
                    SmsPrice[1] = price;
                    SendAccess(playerid, "Вы изменили стоимость 1 сообщения на %d$.", price);
                    new string[24];
                    format(string, sizeof(string),"%i, %i", SmsPrice[1], CallPrice[1]);
                    MysqlUpdateOtherStr("newspricesf", string);
                }
                case RADIO_LV:
                {
                    SmsPrice[2] = price;
                    SendAccess(playerid, "Вы изменили стоимость 1 сообщения на %d$.", price);
                    new string[24];
                    format(string, sizeof(string),"%i, %i", SmsPrice[2], CallPrice[2]);
                    MysqlUpdateOtherStr("newspricelv", string);
                }
            }
        }
        case D_TUNE_MENU_MAIN: //главная страница в СТО
        {
            if(!response) return Service_Exit(playerid);
            if(!IsPlayerInAnyVehicle(playerid)) return Service_Error(playerid, "Вы должны находиться в транспортном средстве.");
            new vehicleid = GetPlayerVehicleID(playerid);
            if(!IsPlayerOwnerVehicle(playerid, vehicleid) && veh_info[vehicleid][v_family_id] == -1) return Service_Error(playerid, "Пользоваться услугами автомастерской можно на личном и семейном транспортном средстве.");
            switch(listitem)
            {
                case 0:
                {
                    new till = Service_GetTill(playerid);
                    if(till == -1) return Service_Error(playerid, "Не найден ID автосервиса, воспользуйтесь услугами автосервиса повторно.");
                    p_temp[playerid][paint_veh_go] = 0;
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Стоимость изменения цвета: $%d.\n\nВыберите цвет через запятую:\n\nПример: 1, 0\n\n", 5000 * till);
                    for(new i; i < 127; i++)
                    {
                        if(i%20 == 0) strcat(STRING_GLOBAL,"\n");
                        format(STRING_GLOBAL, sizeof STRING_GLOBAL, "%s{%06x} %d ", STRING_GLOBAL, VehicleColoursTableRGBA[i] >>> 8, i);
                    }
                    ShowPlayerDialog(playerid,D_CHANGE_VEHICLE_COLOR,DIALOG_STYLE_INPUT, ""I"Изменить цвет транспортного средства",STRING_GLOBAL,"Далее", "Отмена");
                }
                case 1:
                {
                    if(!IsPlayerOwnerVehicle(playerid, vehicleid) && veh_info[vehicleid][v_family_id] == -1) return Service_Error(playerid, "Пользоваться услугами автомастерской можно на личном и семейном транспортном средстве.");
                    if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_CAR) return Service_Error(playerid, "Пользоваться услугами автомастерской можно только на автомобилях.");
                    ShowDialogTuneDefault(playerid);
                }
                case 2: ShowDialogTuneOther(playerid);
                case 3:
                {
                    STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;
                    for(new i, j = sizeof(info_details); i < j; i++)
                    {
                        format(STRING_MIN, sizeof(STRING_MIN), "%s\n", info_details[i]);
                        strcat(STRING_GLOBAL, STRING_MIN);
                    }
                    ShowPlayerDialog(playerid, D_TUNE_INFO_DETAILS, DIALOG_STYLE_MSGBOX, ""I"Информация о деталях", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 4: 
                {
                    ShowDialogTuneObject(playerid);
                    //return SendError(playerid, "Раздел на переработке");//
                }
            }
            return 1;
        }
        case D_TUNE_OTHER:
        {
            if(!response) return ShowDialogTuneMain(playerid);
            if(!IsPlayerInAnyVehicle(playerid)) return Service_Error(playerid, "Вы должны находиться в транспортном средстве.");
            new vehicleid = GetPlayerVehicleID(playerid);

            new till = Service_GetTill(playerid);
            if(till == -1) return Service_Error(playerid, "Не найден ID автосервиса, воспользуйтесь услугами автосервиса повторно.");

            STRING_GLOBAL[0] = EOS;
            if(listitem < 4)
            {
                if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_CAR && GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_MOTO)
                    return Service_Error(playerid, "Пользоваться услугами автомастерской можно только на автомобилях и мотоциклах.");
                if(veh_info[vehicleid][v_twinturbo_data][listitem] >= 3) 
                {
                    if(p_temp[playerid][TextDrawServiceTune] != true) ShowDialogTuneOther(playerid);
                    else Interface_Show(playerid, SERVICE_TUNE_COMPONENTS);
                    return SendError(playerid, "Вы не можете улучшить выбранный компонент более 3-х раз.");
                }
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W" Вы желаете обновить %s до %d из 3 этап(-а/-ов) за %d$?", name_twinturbo[listitem], veh_info[vehicleid][v_twinturbo_data][listitem]+1, GetTuningOtherPrice(playerid, vehicleid, listitem) * till);
            }
            else
            {
                if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_CAR && GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_MOTO)
                    return Service_Error(playerid, "Пользоваться услугами автомастерской можно только на автомобилях и мотоциклах.");
                if(veh_info[vehicleid][v_details][listitem-4] == 100.0) 
                {
                    if(p_temp[playerid][TextDrawServiceTune] != true) ShowDialogTuneOther(playerid);
                    else Interface_Show(playerid, SERVICE_TUNE_COMPONENTS);
                    return SendError(playerid, "Вы не можете заменить выбранный компонент если его состояние максимальное.");
                }
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы желаете заменить %s за %d$?", name_details[listitem-4], ((GetTuningOtherPrice(playerid, vehicleid, listitem) / 100) * floatround(100.0 - veh_info[vehicleid][v_details][listitem-4])) * till);
            }
            p_temp[playerid][p_listitem_int] = listitem;
            ShowPlayerDialog(playerid, D_TUNE_OTHER_BUY, DIALOG_STYLE_MSGBOX, ""I"Дополнительные компоненты", STRING_GLOBAL, "Далее", "Отмена");
            return 1;
        }
        case D_TUNE_OTHER_BUY:
        {
            if(!response)
            {
                if(p_temp[playerid][TextDrawServiceTune] != true) ShowDialogTuneOther(playerid);
                return 1;
            }
            if(!IsPlayerInAnyVehicle(playerid))
                return Service_Error(playerid, "Вы должны находиться в транспортном средстве.");
            new vehicleid = GetPlayerVehicleID(playerid);

            listitem = p_temp[playerid][p_listitem_int];
            p_temp[playerid][p_listitem_int] = -1;

            new till = Service_GetTill(playerid);
            if(till == -1) return Service_Error(playerid, "Не найден ID автосервиса, воспользуйтесь услугами автосервиса повторно.");

            if(listitem < 4)
            {
                if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_CAR && GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_MOTO)
                    return Service_Error(playerid, "Пользоваться услугами автомастерской можно только на автомобилях и мотоциклах.");
                if(veh_info[vehicleid][v_twinturbo_data][listitem] >= 3) 
                {
                    if(p_temp[playerid][TextDrawServiceTune] != true) ShowDialogTuneOther(playerid);
                    else Interface_Show(playerid, SERVICE_TUNE_COMPONENTS);
                    return SendError(playerid, "Вы не можете улучшить выбранный компонент более 3-х раз.");
                }
                new price = GetTuningOtherPrice(playerid, vehicleid, listitem) * till;
                if(p_info[playerid][cash] < price)
                {
                    if(p_temp[playerid][TextDrawServiceTune] != true) ShowDialogTuneOther(playerid);
                    else Interface_Show(playerid, SERVICE_TUNE_COMPONENTS);
                    return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                }

                veh_info[vehicleid][v_twinturbo] = 1;
                veh_info[vehicleid][v_twinturbo_data][listitem]++;
                SaveVehicleTuning(vehicleid);
                SendAccess(playerid, "Вы обновили %s до %d из 3 этап(-а/-ов) за %d$.", name_twinturbo[listitem], veh_info[vehicleid][v_twinturbo_data][listitem], price);

                Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] купил <%s-%d/3> на <%s>(%d)[%d] за %d$",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                name_twinturbo[listitem],veh_info[vehicleid][v_twinturbo_data][listitem], GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id], price);

                BuyPlayerService(playerid, price);
                OnServerInfoForMoney[24] += price;
            }
            else
            {
                if(veh_info[vehicleid][v_details][listitem-4] == 100.0)
                {
                    if(p_temp[playerid][TextDrawServiceTune] != true) ShowDialogTuneOther(playerid);
                    else Interface_Show(playerid, SERVICE_TUNE_COMPONENTS);
                    return SendError(playerid, "Вы не можете заменить выбранный компонент если его состояние максимальное.");
                }
                new price = ((GetTuningOtherPrice(playerid, vehicleid, listitem) / 100) * floatround(100.0 - veh_info[vehicleid][v_details][listitem-4])) * till;
                if(p_info[playerid][cash] < price)
                {
                    if(p_temp[playerid][TextDrawServiceTune] != true) ShowDialogTuneOther(playerid);
                    else Interface_Show(playerid, SERVICE_TUNE_COMPONENTS);
                    return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                }
                veh_info[vehicleid][v_details][listitem-4] = 100.0;
                SaveVehicleDetails(vehicleid);
                SendAccess(playerid, "Вы заменили %s за %d$.", name_details[listitem-4], price);

                Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] заменил %s на <%s>(%d)[%d] за %d$",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                name_details[listitem-4], GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id], price);

                BuyPlayerService(playerid, price);
                OnServerInfoForMoney[24] += price;
            }
            if(p_temp[playerid][TextDrawServiceTune] != true) ShowDialogTuneOther(playerid);
            else Interface_Show(playerid, SERVICE_TUNE_COMPONENTS);
            return 1;
        }
        case D_TUNE_INFO_DETAILS:
        {
            ShowDialogTuneMain(playerid);
            return 1;
        }
        case D_TUNE_DEFAULT_MENU:
        {
            if(!response) return ShowDialogTuneMain(playerid);
            if(!IsPlayerInAnyVehicle(playerid)) return Service_Error(playerid, "Вы должны находиться в транспортном средстве.");
            STRING_GLOBAL[0] = EOS;
            new vehicleid = GetPlayerVehicleID(playerid),
                getmodel = GetVehicleModelEx(vehicleid);
            if(!IsPlayerOwnerVehicle(playerid, vehicleid) && veh_info[vehicleid][v_family_id] == -1) return Service_Error(playerid, "Пользоваться услугами автомастерской можно только на личном транспортном средстве.");
            if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_CAR) return Service_Error(playerid, "Пользоваться услугами автомастерской можно только на автомобилях.");

            p_temp[playerid][p_listitem][0] = vehicleid;
            p_temp[playerid][tune_default] = true;

            switch(listitem)
            {
                case 0:
                {
                    switch(getmodel)
                    {//Покрасочная работа MAX: 3
                        case 534, 535, 536, 558, 559, 561, 560, 562, 565, 567, 575, 576:
                        {
                            p_temp[playerid][p_listitem][1] = v_paintjob;
                            p_temp[playerid][p_listitem][5] = 3;
                            SetCameraForPlayer(playerid, CAMERA_ID_FRONT);
                        }
                        default:
                        {
                            SendError(playerid, "На данное транспортное средство нет покрасочных работ.");
                            if(p_temp[playerid][TextDrawServiceTune]) Interface_Show(playerid, SERVICE_TUNE_EXTERNAL);
                            else ShowDialogTuneDefault(playerid);
                            return 1;
                        }
                    }
                }
                case 1: {
                    p_temp[playerid][p_listitem][1] = v_nitro;
                    p_temp[playerid][p_listitem][5] = GetMaxCountComponentTune(playerid, CARMODTYPE_NITRO, getmodel);
                    SetCameraForPlayer(playerid, CAMERA_ID_BACK);
                }
                case 2:
                {
                    p_temp[playerid][p_listitem][1] = v_wheels;
                    p_temp[playerid][p_listitem][5] = GetMaxCountComponentTune(playerid, CARMODTYPE_WHEELS, getmodel);
                    SetCameraForPlayer(playerid, CAMERA_ID_SIDE_LEFT_FRONT);
                }
                case 3:
                {
                    p_temp[playerid][p_listitem][1] = v_spoiler;
                    p_temp[playerid][p_listitem][5] = GetMaxCountComponentTune(playerid, CARMODTYPE_SPOILER, getmodel);
                    SetCameraForPlayer(playerid, CAMERA_ID_BACK);
                }
                case 4:
                {
                    p_temp[playerid][p_listitem][1] = v_front_bumper;
                    p_temp[playerid][p_listitem][5] = GetMaxCountComponentTune(playerid, CARMODTYPE_FRONT_BUMPER, getmodel);
                    SetCameraForPlayer(playerid, CAMERA_ID_FRONT);
                }
                case 5:
                {
                    p_temp[playerid][p_listitem][1] = v_pear_bumper;
                    p_temp[playerid][p_listitem][5] = GetMaxCountComponentTune(playerid, CARMODTYPE_REAR_BUMPER, getmodel);
                    SetCameraForPlayer(playerid, CAMERA_ID_BACK);
                }
                case 6:
                {
                    if(!IsSupprtsVehicleHydraulics(getmodel))
                    {
                        SendError(playerid, "На данное транспортное средство нет поддержки гидравлики.");
                        if(p_temp[playerid][TextDrawServiceTune]) Interface_Show(playerid, SERVICE_TUNE_EXTERNAL);
                        else ShowDialogTuneDefault(playerid);
                        return 1;
                    }
                    p_temp[playerid][p_listitem][1] = v_hydraulics;
                    if(veh_info[vehicleid][v_tune][v_hydraulics] != 0) ShowPlayerDialog(playerid, D_TUNE_DEFAULT_ACT, DIALOG_STYLE_MSGBOX, ""I"Гидравлика", ""W"Вы желаете снять с транспортного средства гидравлику?", "Далее", "Отмена");
                    else
                    {
                        new till = Service_GetTill(playerid);
                        if(till == -1) return Service_Error(playerid, "Не найден ID автосервиса, воспользуйтесь услугами автосервиса повторно.");

                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы желаете установить на транспортное средство гидравлику?\n\nСтоимость: %d$.", 200000 * till);
                        ShowPlayerDialog(playerid, D_TUNE_DEFAULT_ACT, DIALOG_STYLE_MSGBOX, ""I"Гидравлика", STRING_GLOBAL, "Далее", "Отмена");
                    }
                    return 1;
                }
                case 7:
                {
                    p_temp[playerid][p_listitem][1] = v_hoods;
                    p_temp[playerid][p_listitem][5] = GetMaxCountComponentTune(playerid, CARMODTYPE_HOOD, getmodel);
                    SetCameraForPlayer(playerid, CAMERA_ID_BACK);
                }
                case 8:
                {
                    p_temp[playerid][p_listitem][1] = v_vents;
                    p_temp[playerid][p_listitem][5] = GetMaxCountComponentTune(playerid, CARMODTYPE_VENT_RIGHT, getmodel);
                    SetCameraForPlayer(playerid, CAMERA_ID_FRONT);
                }
                case 9:
                {
                    p_temp[playerid][p_listitem][1] = v_lamps;
                    p_temp[playerid][p_listitem][5] = GetMaxCountComponentTune(playerid, CARMODTYPE_LAMPS, getmodel);
                    SetCameraForPlayer(playerid, CAMERA_ID_FRONT);
                }
                case 10:
                {
                    p_temp[playerid][p_listitem][1] = v_exhausts;
                    p_temp[playerid][p_listitem][5] = GetMaxCountComponentTune(playerid, CARMODTYPE_EXHAUST, getmodel);
                    SetCameraForPlayer(playerid, CAMERA_ID_BACK);
                }
                case 11:
                {
                    p_temp[playerid][p_listitem][1] = v_roofs;
                    p_temp[playerid][p_listitem][5] = GetMaxCountComponentTune(playerid, CARMODTYPE_ROOF, getmodel);
                    SetCameraForPlayer(playerid, CAMERA_ID_FRONT);
                }
                case 12:
                {
                    p_temp[playerid][p_listitem][1] = v_sideskirt;
                    p_temp[playerid][p_listitem][5] = GetMaxCountComponentTune(playerid, CARMODTYPE_SIDESKIRT, getmodel);
                    SetCameraForPlayer(playerid, CAMERA_ID_SIDE_LEFT_FRONT);
                }
            }
            if(p_temp[playerid][p_listitem][5] == -1)
            {
                if(p_temp[playerid][TextDrawServiceTune]) Interface_Show(playerid, SERVICE_TUNE_EXTERNAL);
                else ShowDialogTuneDefault(playerid);
                return SendError(playerid, "На данное транспортное средство нет деталей.");
            }
            ShowPlayerDialog(playerid, D_TUNE_DEFAULT_ACT, DIALOG_STYLE_LIST, ""I"Действие", ""I"[1]"W" Удалить текущий элемент\n"I"[2]"W" Купить новый элемент", "Далее", "Отмена");
            return 1;
        }
        case D_TUNE_DEFAULT_ACT:
        {
            if(!response)
            {
                if(p_temp[playerid][TextDrawServiceTune] != true) ShowDialogTuneDefault(playerid);
                return 1;
            }
            if(!IsPlayerInAnyVehicle(playerid) || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
                return Service_Error(playerid, "Вы должны находиться в транспортном средстве.");
            new vehicleid = GetPlayerVehicleID(playerid);
            new tune_id = p_temp[playerid][p_listitem][1], count_component = p_temp[playerid][p_listitem][5];
            if(p_temp[playerid][p_listitem][0] != vehicleid)
                return Service_Error(playerid, "ID транспорта не совпадает с первоначальным, воспользуйтесь услугами автосервиса повторно.");
            if(tune_id == v_hydraulics)
            {
                if(veh_info[vehicleid][v_tune][tune_id] == 1087)
                {
                    SendAccess(playerid, "Данный компонент снят с Вашего транспортного средства.");
                    veh_info[vehicleid][v_tune][tune_id] = 0;
                    RemoveVehicleComponent(vehicleid, veh_info[vehicleid][v_tune][tune_id]);

                    Log(LOG_player, INFO, "%s[%d](%s %s) удалил элемент обычного(гидравлику) тюнинга с <%s>(%d)[%d] | #Tuning",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id]);
                }
                else
                {
                    new till = Service_GetTill(playerid);
                    if(till == -1) return Service_Error(playerid, "Не найден ID автосервиса, воспользуйтесь услугами автосервиса повторно.");

                    new price = 200000 * till;
                    if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate"), ShowDialogTuneDefault(playerid);
                    Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] купил обычный элемент тюнинга на <%s>(%d)[%d] за %d$",
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                        GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id], price);

                    BuyPlayerService(playerid, price);
                    PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
                    SendAccess(playerid, "Вы установили данный компонент.");
                    veh_info[vehicleid][v_tune][tune_id] = 1087;
                    VEx_AddVehicleComponent(vehicleid, veh_info[vehicleid][v_tune][tune_id]);
                }
                SaveVehicleTuning(vehicleid);

                switch(p_temp[playerid][p_listitem][1])
                {
                    case v_exhausts: SetCameraForPlayer(playerid, CAMERA_ID_BACK);
                    case v_wheels: SetCameraForPlayer(playerid, CAMERA_ID_SIDE_LEFT_FRONT);
                    case v_nitro: SetCameraForPlayer(playerid, CAMERA_ID_BACK);
                    case v_pear_bumper: SetCameraForPlayer(playerid, CAMERA_ID_BACK);
                    case v_lamps: SetCameraForPlayer(playerid, CAMERA_ID_FRONT);
                    case v_paintjob: SetCameraForPlayer(playerid, CAMERA_ID_FRONT);
                    case v_spoiler: SetCameraForPlayer(playerid, CAMERA_ID_BACK);
                    case v_hoods: SetCameraForPlayer(playerid, CAMERA_ID_BACK);
                    case v_roofs: SetCameraForPlayer(playerid, CAMERA_ID_FRONT);
                    case v_front_bumper: SetCameraForPlayer(playerid, CAMERA_ID_FRONT);
                    case v_vents: SetCameraForPlayer(playerid, CAMERA_ID_FRONT);
                    case v_sideskirt: SetCameraForPlayer(playerid, CAMERA_ID_SIDE_LEFT_FRONT);
                }

                if(p_temp[playerid][TextDrawServiceTune]) Interface_Show(playerid, SERVICE_TUNE_EXTERNAL);
                else ShowDialogTuneDefault(playerid);
                return 1;
            }
            if(!listitem)
            {
                if(veh_info[vehicleid][v_tune][tune_id] == 0)
                {
                    SendError(playerid, "Данный компонент не установлен.");
                    if(p_temp[playerid][TextDrawServiceTune]) Interface_Show(playerid, SERVICE_TUNE_EXTERNAL);
                    else ShowDialogTuneDefault(playerid);
                    return 1;
                }
                veh_info[vehicleid][v_tune][tune_id] = 0;
                if(tune_id == v_paintjob) ChangeVehiclePaintjob(vehicleid, 3);
                else RemoveVehicleComponent(vehicleid, veh_info[vehicleid][v_tune][tune_id]);
                SendAccess(playerid, "Данный компонент снят с Вашего транспортного средства.");
                SaveVehicleTuning(vehicleid);
                if(p_temp[playerid][TextDrawServiceTune]) Interface_Show(playerid, SERVICE_TUNE_EXTERNAL);
                else ShowDialogTuneDefault(playerid);

                Log(LOG_player, INFO, "%s[%d](%s %s) удалил элемент обычного тюнинга с <%s>(%d)[%d] | #Tuning",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    GetVehicleName(vehicleid), veh_info[vehicleid][v_model], veh_info[vehicleid][v_mysql_id]);
                return 1;
            }
            if(count_component == -1)
            {
                SendError(playerid, "На данное транспортное средство нет деталей.");
                if(p_temp[playerid][TextDrawServiceTune]) Interface_Show(playerid, SERVICE_TUNE_EXTERNAL);
                else ShowDialogTuneDefault(playerid);
                return 1;
            }
            new till = Service_GetTill(playerid);
            if(till == -1) return Service_Error(playerid, "Не найден ID автосервиса, воспользуйтесь услугами автосервиса повторно.");

            if(tune_id == v_nitro) p_temp[playerid][shop_id] = 1;
            else p_temp[playerid][shop_id] = 0;

            if(p_temp[playerid][TextDrawServiceTune])
                Interface_Show(playerid, SERVICE_TUNE_EXTERNAL_VIEW);
            else
            {
                p_temp[playerid][shop_id] = 0;
                STRING_GLOBAL[0] = EOS;
                f(STRING_GLOBAL, "%d$", GetPriceTuneElement(tune_id, p_temp[playerid][shop_id]) * till);
                ShowTextDrawForPlayer(playerid, TD_ID_SHOP);
                PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], STRING_GLOBAL);
            }
            if(tune_id == v_paintjob) ChangeVehiclePaintjob(vehicleid, p_temp[playerid][shop_id]);
            else
            {
                VEx_AddVehicleComponent(vehicleid, p_temp[playerid][e_tListComponents][p_temp[playerid][shop_id]]);
                if(tune_id == v_sideskirt || tune_id == v_vents) VEx_AddVehicleComponent(vehicleid, p_temp[playerid][e_tListComponents][p_temp[playerid][shop_id]]);
            }
            return 1;
        }
        case D_CHANGE_VEHICLE_COLOR:
        {
            if(!response)
            {
                if(p_temp[playerid][paint_veh_go] == 0) return ShowDialogTuneMain(playerid);
                p_temp[playerid][paint_veh_go] = 0;
                return 1;
            }
            if(!IsPlayerInAnyVehicle(playerid)) return Service_Error(playerid, "Вы должны находиться в транспортном средстве.");
            new vehicleid = GetPlayerVehicleID(playerid), v_color1, v_color2;
            if(sscanf(inputtext, "p<,>ii", v_color1, v_color2))
            {
                if(p_temp[playerid][paint_veh_go] == 0) ShowDialogTuneMain(playerid);
                return SendError(playerid, "Цвет нужно вводить через запятую, первый - основной, второй дополнительный(если автомобиль поддерживает).");
            }
            if(!(0 <= v_color1 <= 126) || !(0 <= v_color2 <= 126))
            {
                if(p_temp[playerid][paint_veh_go] == 0) ShowDialogTuneMain(playerid);
                return SendError(playerid, "Цвет может быть не менее 0 и не более 126.");
            }
            if(p_temp[playerid][paint_veh_go] == 0)
            {
                new till = Service_GetTill(playerid);
                if(till == -1) return Service_Error(playerid, "Не найден ID автосервиса, воспользуйтесь услугами автосервиса повторно.");

                new price = 5000 * till;

                if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate"), ShowDialogTuneMain(playerid);
                SendAccess(playerid, "Вы перекрасили транспортное средство в СТО.");

                Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] купил перекраску на <%s>(%d)[%d] за %d$",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                    GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id], price);

                BuyPlayerService(playerid, price);
                ShowDialogTuneMain(playerid);
            }
            else
            {
                if(p_info[playerid][paintball] <= 0) return SendError(playerid, "У Вас нет баллончика с краской.");
                SendAccess(playerid, "Вы перекрасили транспортное средство с помощью балончика с краской.");

                p_temp[playerid][paint_veh_go] = 0;
                p_info[playerid][paintball] = 0;

                MeAction(playerid, "перекрасил(-а) транспортное средство балончиком");
                save_player(playerid);
            }
            veh_info[vehicleid][v_color][0] = v_color1;
            veh_info[vehicleid][v_color][1] = v_color2;
            ChangeVehicleColor(vehicleid, v_color1, v_color2);

            SaveVehicle(vehicleid);
            RepairVehicle(vehicleid);
            return 1;
        }
        case D_APANEL:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0: return ShowPlayerDialog(playerid, D_APANEL_DONATE, DIALOG_STYLE_INPUT, ""I"Стоимость игровой валюты", ""W"Введите кол-во игровой валюты за 1 Pinecrest Money:", "Далее", "Отмена");
                case 1: return ShowPlayerDialog(playerid, D_APANEL_EXPERIAN, DIALOG_STYLE_INPUT, ""I"Кол-во игрового опыта", ""W"Введите кол-во игрового опыта в PayDay:", "Далее", "Отмена");
                case 2: return ShowCheatList(playerid, D_AC_PANEL);
                case 3: return ShowSetAndLogsPanel(playerid);
                case 4: return ShowPlayerDialog(playerid, D_APANEL_SALARY, DIALOG_STYLE_INPUT, ""I"Зарплата", ""W"Введите параметр зарплаты:", "Далее", "Отмена");
                case 5: return ShowPlayerDialog(playerid, D_APANEL_DONATE_FM, DIALOG_STYLE_INPUT, ""I"Курс FM", ""W"Введите курс FM:", "Далее", "Отмена");
                case 6:
                {
                    mysql_tquery(con_bd, "START TRANSACTION;");
                    foreach(new i: Player)
                    {
                        if(!p_info[i][loggedIn]) continue;
                        p_info[i][p_time_payday] = 1200;
                        PayDay(i);
                    }
                    mysql_tquery(con_bd, "COMMIT;");

                }
                case 7: ShowDialogServerInfo(playerid);
                default: return ShowApanelDialog(playerid);
            }
        }
        case D_APANEL_SERVER_SETTINGS:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0:
                {
                    if(!FD(playerid) && p_info[playerid][admin] < 7)
                        return 1;

                    ServerInfo[MailerStatus] = !ServerInfo[MailerStatus];
                    MysqlUpdateOtherInt("MailerStatus", ServerInfo[MailerStatus]);

                    if(!ServerInfo[MailerStatus] && ServerInfo[RegistrationMail])
                    {
                        ServerInfo[RegistrationMail] = 0;
                        MysqlUpdateOtherInt("RegistrationMail", ServerInfo[RegistrationMail]);
                    }
                    SendInfo(playerid, "Вы %s работу почтового ящика.", (!ServerInfo[MailerStatus]) ? ("отключили") : ("включили"));
                }
                case 1:
                {
                    ShowPlayerDialog(playerid, D_AP_SS_EMAIL, DIALOG_STYLE_LIST, ""I"Регистрация через E-Mail", "\
                        "I"[1] {"#cRED"}Отключить\n\
                        "I"[2] {"#cGREEN"}Включить\n\
                        "I"[3] {"#cBLUE"}Только PC\n\
                        "I"[4] {"#cBLUE"}Только Mobile", "Далее", "Отмена");
                }
                case 2:
                {
                    ShowPlayerDialog(playerid, D_AP_SS_REGISTRATION, DIALOG_STYLE_LIST, ""I"Регистрация на сервере", "\
                        "I"[1] {"#cRED"}Отключить\n\
                        "I"[2] {"#cGREEN"}Включить\n\
                        "I"[3] {"#cBLUE"}Только PC\n\
                        "I"[4] {"#cBLUE"}Только Mobile", "Далее", "Отмена");
                }
                case 3:
                {
                    if(!FD(playerid) && p_info[playerid][admin] < 7)
                        return 1;

                    ServerInfo[BlockInvalidClient] = !ServerInfo[BlockInvalidClient];
                    MysqlUpdateOtherInt("BlockInvalidClient", ServerInfo[BlockInvalidClient]);

                    SendInfo(playerid, "Вы %s блокировку не валидных клиентов.", (!ServerInfo[BlockInvalidClient] ) ? ("отключили") : ("включили"));
                }
                case 4:
                {
                    if(!FD(playerid) || p_info[playerid][admin] < 7)
                        return 1;

                    ServerInfo[RouletteSystem] = !ServerInfo[RouletteSystem];
                    MysqlUpdateOtherInt("RouletteSystem", ServerInfo[RouletteSystem]);

                    SendInfo(playerid, "Вы %s систему рулеток.", (!ServerInfo[RouletteSystem]) ? ("отключили") : ("включили"));
                }
                case 5:
                {
                    if(!FD(playerid) || p_info[playerid][admin] < 7)
                        return 1;

                    ServerInfo[CaseSystem] = !ServerInfo[CaseSystem];
                    MysqlUpdateOtherInt("CaseSystem", ServerInfo[CaseSystem]);

                    SendInfo(playerid, "Вы %s систему кейсов.", (!ServerInfo[CaseSystem]) ? ("отключили") : ("включили"));
                }
                case 6:
                {
                    if(!FD(playerid) && p_info[playerid][admin] < 7)
                        return 1;
                    ServerInfo[RealCarsStatus] = !ServerInfo[RealCarsStatus];
                    MysqlUpdateOtherInt("RealCarsStatus", ServerInfo[RealCarsStatus]);

                    SendInfo(playerid, "Вы %s отображение Real Cars.", (!ServerInfo[RealCarsStatus]) ? ("отключили") : ("включили"));
                }
                case 7:
                {
                    if(!FD(playerid) && p_info[playerid][admin] < 7)
                        return 1;

                    ServerInfo[RealSkinsStatus] = !ServerInfo[RealSkinsStatus];
                    MysqlUpdateOtherInt("RealSkinsStatus", ServerInfo[RealSkinsStatus]);

                    SendInfo(playerid, "Вы %s отображение Real Skins.", (!ServerInfo[RealSkinsStatus]) ? ("отключили") : ("включили"));
                }
                case 8:
                {
                    if(p_info[playerid][admin] < 4)
                        return 1;
                    ServerInfo[AntiDMSystem] = !ServerInfo[AntiDMSystem];
                    MysqlUpdateOtherInt("AntiDMSystem", ServerInfo[AntiDMSystem]);

                    SendInfo(playerid, "Вы %s систему ANTI DM с блоком урона до 5 уровня.", (!ServerInfo[AntiDMSystem]) ? ("отключили") : ("включили"));
                }
                case 9:
                {
                    if(p_info[playerid][admin] < 4)
                        return 1;
                    ServerInfo[FreezeOnDM] = !ServerInfo[FreezeOnDM];
                    MysqlUpdateOtherInt("FreezeOnDM", ServerInfo[FreezeOnDM]);

                    SendInfo(playerid, "Вы %s систему ANTI DM с заморозкой игрока.", (!ServerInfo[FreezeOnDM]) ? ("отключили") : ("включили"));

                }
                case 10:
                {
                    if(!FD(playerid) && p_info[playerid][admin] < 7)
                        return 1;

                    ServerInfo[TrashSystem] = !ServerInfo[TrashSystem];
                    MysqlUpdateOtherInt("TrashSystem", ServerInfo[TrashSystem]);

                    SendInfo(playerid, "Вы %s систему мусорок.", (!ServerInfo[TrashSystem]) ? ("отключили") : ("включили"));
                }
                case 11:
                {
                    if(!FD(playerid) && p_info[playerid][admin] < 7)
                        return 1;

                    ServerInfo[VKSecurity] = !ServerInfo[VKSecurity];
                    MysqlUpdateOtherInt("VKSecurity", ServerInfo[VKSecurity]);

                    SendInfo(playerid, "Вы %s систему VK Security.", (!ServerInfo[VKSecurity]) ? ("отключили") : ("включили"));
                }
                case 12:
                {
                    if(!FD(playerid) && p_info[playerid][admin] < 7)
                        return 1;

                    ServerInfo[TGSecurity] = !ServerInfo[TGSecurity];
                    MysqlUpdateOtherInt("TGSecurity", ServerInfo[TGSecurity]);

                    SendInfo(playerid, "Вы %s систему TG Security.", (!ServerInfo[TGSecurity]) ? ("отключили") : ("включили"));
                }
                case 13:
                {
                    if(!FD(playerid))
                        return 1;
                    ShowPlayerDialog(playerid, D_AP_SS_SECURITY_BOT_URL, DIALOG_STYLE_INPUT, ""I"SECURITY BOT URL", ""W"Введите новое значение:\n\nБЕЗ http://", "Далее", "Отмена");
                }
