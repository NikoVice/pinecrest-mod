                    произошло, его необходимо {"#cGREEN"}ремонтировать"W" в мастерской.\n\n\
                    Помимо ремонта, в мастерской можно {"#cYELLOW"}изменить цвет"W" аксессуара.", "Закрыть", "");
                }
            }
            return 1;
        }
        case D_RA_REPAIR:
        {
            if(!response) return ShowPlayerDialog(playerid, D_RA, DIALOG_STYLE_LIST, ""I"Мастерская одежды", ""I"[1]"W" Отремонтировать аксессуар\n"I"[2]"W" Изменить цвет аксессуара\n"I"[3]"W" Помощь по мастерской", "Далее", "Отмена"), DeletePVar(playerid, "RA:idx");
            new biz_id = GetPVarInt(playerid, "bID"),
                till = b_info[biz_id][_till],
