                        if(UndergroundBotsInfo[idx][ubLubricant] < 50.0) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx), SendError(playerid, "Для начала работы необходимо смазать станок.");
                        if(UndergroundBotsInfo[idx][ubSatiety] < 50.0) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx), SendError(playerid, "Для начала работы необходимо покормить рабочего.");
                        if(UndergroundBotsInfo[idx][ubMaterials] < 50.0) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx), SendError(playerid, "Для начала работы необходимо выдать материалы.");
