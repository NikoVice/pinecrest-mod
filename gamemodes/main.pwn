CheckPlayerVehicleSpeed(playerid)
{
    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && PRESS_UP[playerid] == 1 && p_temp[playerid][twinturbo_on] == 1)
    {
        if(GetPlayerPing(playerid) < 300)
        {
            new vehicleid = GetPlayerVehicleID(playerid);
            if(veh_info[vehicleid][v_engine] == 1 && veh_info[vehicleid][v_twinturbo_data][tt_suspension] == 0 && veh_info[vehicleid][v_twinturbo_data][tt_transmission] == 0 && veh_info[vehicleid][v_twinturbo_data][tt_turbocharging] == 0 && veh_info[vehicleid][v_twinturbo_data][tt_engine] == 0) return 1;
            new vehiclespeed = GetVehicleSpeed(vehicleid), vehiclemaxspeed = GetVehicleMaxSpeed(vehicleid);
            if(vehiclespeed > 0.0 && vehiclespeed > GetVehicleSpeed(vehicleid) * 0.9 && vehiclespeed < vehiclemaxspeed)
            {
                if(MaxSpeedUpdate[playerid] < 2) MaxSpeedUpdate[playerid]++;
                if(MaxSpeedUpdate[playerid] == 2)
                {
                    SetVehicleSpeed(vehicleid, vehiclespeed * 1.1);
                }
            }
            else if(MaxSpeedUpdate[playerid] > 0) MaxSpeedUpdate[playerid] = 0;
        }
        else
        {
            OnPlayerUpdateVehicleInfo(playerid, SPEEDO_TWINTURBO);
            p_temp[playerid][twinturbo_on] = 0;
            SendInfo(playerid, "� ��� ������� ping, TwinTurbo ��������.");
        }
    }
    return 1;
}

GetVehicleMaxSpeed(vehicleid)
{
    new vehicleupgrade = veh_info[vehicleid][v_twinturbo_data][tt_suspension] + veh_info[vehicleid][v_twinturbo_data][tt_transmission] + veh_info[vehicleid][v_twinturbo_data][tt_turbocharging] + veh_info[vehicleid][v_twinturbo_data][tt_engine];

    new Float:vehiclemaxspeed = GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_SPEED) * (1.0 + (vehicleupgrade * 0.1));
    if(vehiclemaxspeed == 0) vehiclemaxspeed = GetVehicleSpeed(vehicleid);
    else if(vehiclemaxspeed > 270.0) vehiclemaxspeed = 270.0;

    return floatround(vehiclemaxspeed);
}


