                    if(iValue == 16 || iValue >= 35 && iValue <= 40 || iValue >= 44 && iValue <= 46) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"��������", ""W"������� ID ������ �� 0 �� 46:", "�����", "������"), SendError(playerid, "�� ����� ����������� ID ������.");
                }
