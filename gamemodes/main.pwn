        case D_BILLBOARD_TEXT_ALIGMENT:
        {
            new biz_id = GetPVarInt(playerid, "bID"), idx = GetPVarInt(playerid, "BILLBOARD:idx");
            if(!response) return ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);
            BillboardInfo[idx][bbTextAligment] = listitem;
            MysqlUpdateBillboardInt(idx, "textaligment", BillboardInfo[idx][bbTextAligment]);
            SetBillboardText(idx);
            SendAccess(playerid, "Вы изменили выравнивание текста на билборде.");
            ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);
            return 1;
        }
        case D_BILLBOARD_RENT_DAYS:
        {
            new biz_id = GetPVarInt(playerid, "bID"), idx = GetPVarInt(playerid, "BILLBOARD:idx");
            if(!response) return ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);
            new fix_listitem;
            if(sscanf(inputtext, "i", fix_listitem)) return ShowDialogBillboard(playerid, biz_id, BB_LIST_RENT_DAYS, idx), SendError(playerid, "Вы ничего не ввели.");
            if(fix_listitem < 1 || fix_listitem > 7) return ShowDialogBillboard(playerid, biz_id, BB_LIST_RENT_DAYS, idx), SendError(playerid, "Количество дней должно быть не менее 1 и не более 7.");
            if(BillboardInfo[idx][bbDays] + fix_listitem > 7) return ShowDialogBillboard(playerid, biz_id, BB_LIST_RENT_DAYS, idx), SendError(playerid, "Вы можете оплатить на %d дн.", 7 - BillboardInfo[idx][bbDays]);
            new till = b_info[biz_id][_till], price = (BILLBOARD_PRICE_RENT * till) * fix_listitem;
            if(p_info[playerid][cash] < price) return ShowDialogBillboard(playerid, biz_id, BB_LIST_RENT_DAYS, idx), SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            OnServerInfoForMoney[10] += price;
            SetPlayerMoney(playerid, -price, true, "продление аренды билборда");

            if(b_info[biz_id][_prod] >= price / 100)
            {
                b_info[biz_id][_prod] -= price / 100;
                b_info[biz_id][_bank] += (price / 100) * 90;
                AddMafiaBank(biz_id, price/10);

                biz_finka[biz_id] += (price / 100) * 90;
                UpdateIntForFinanceBiz(biz_id, (price / 100) * 90);
            }

            BillboardInfo[idx][bbDays] += fix_listitem;
            MysqlUpdateBillboardInt(idx, "days", BillboardInfo[idx][bbDays]);

            SendAccess(playerid, "Вы продлили срок аренды билборда на %d дн.", fix_listitem);
            SendInfo(playerid, "Общий срок аренды билборда %d дн.", BillboardInfo[idx][bbDays]);

            ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);
            return 1;
        }
