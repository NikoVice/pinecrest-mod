                new i = GetPVarInt(playerid, "LoadBreak")-1, listitem = GetPVarInt(playerid, "LoadBreakListitem"), idx = GetPVarInt(playerid, "BreakObject");
                //if(idx == 2899) return SendError(playerid, "����������� ��������� ����� �������� �� ��������.");
                DestroyObject(BreakObject[playerid][i]);
