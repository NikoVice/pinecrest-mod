                ShowPlayerDialog(playerid, D_DUEL_ROUND, DIALOG_STYLE_INPUT, ""I"Раунды", ""W"Введите количество раундов для дуэли:\nКоличество раундов не может быть менее 1 и более 10.", "Принять", "Отмена");
