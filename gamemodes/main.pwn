    Fix_TogglePlayerControllable(playerid, true);
    SetPlayerDrunkLevel(playerid, 0);
    f(STRING_GLOBAL, ""I"\
    Койка: "W"#%d"I"\n\n\
    Используйте "W"/hospital"I" или "W"\"ALT\""I" чтобы занять её", bed_id+1);
    UpdateDynamic3DTextLabelText(HospitalBedInfo[bed_id][hb_Text][hb_id], 0xFFFFFFFF, STRING_GLOBAL );
    return 1;
}

