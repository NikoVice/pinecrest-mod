public OnGameModeInit()
{
    timestamp = gettime(timestamp_hour, timestamp_minute, timestamp_second)+10800; // обновляем timestamp и timestamp_hour, timestamp_minute, timestamp_second
    new syncunix = timestamp; // syncunix равна timestamp

    syncunix -= timestamp_minute*60; // в syncunix обнуляем минуты
    syncunix -= timestamp_second; // в syncunix обнуляем минуты

    unix_hour = syncunix+3600; // добавляем в unix_h - час чтобы Timer_Unix сработал кореектно в 00 минут
    unix_5_min = syncunix+300;
    unix_10_min = syncunix+600;
    unix_min = syncunix+60; // добавляем в unix_m - минуту чтобы Timer_Unix сработал кореектно в 00 секунд
    unix_sec = syncunix;
    unix_three_sec = syncunix+3;

    timers_unix = SetTimer("Timer_Unix", 500, true); // 250 ms
