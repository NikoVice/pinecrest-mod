CMD:helpers(playerid, params[])
{
    if(p_info[playerid][admin] < 1 && p_info[playerid][p_vip] == 0) return 1;
    if(!Iter_Count(gHelpers)) return SendError(playerid, "���������� ��� � ����.");
    STRING_GLOBAL = ""W"[#] �������\t"W"�������\t"W" \t"W" \n";
    new count;
    foreach(new i: gHelpers)
    {
        if(p_info[i][helper] == 0) continue;
        if(pSpectateId[i] == INVALID_PLAYER_ID)
        {
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d] "W"%s[%d]\t%d\t%s\t \n", STRING_GLOBAL, count+1, get_name(i), i, p_info[i][admin], p_info[i][p_afkTime] < 2 ? " " : "AFK");
        }
        else
        {
            if(p_info[playerid][admin] < 1)
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d] "W"%s[%d]\t%d\t%s\t \n", STRING_GLOBAL, count+1, get_name(i), i, p_info[i][admin], p_info[i][p_afkTime] < 2 ? " " : "AFK");
            else
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d] "W"%s[%d]\t%d\t%s\t/re %d\n", STRING_GLOBAL, count+1, get_name(i), i, p_info[i][admin], p_info[i][p_afkTime] < 2 ? " " : "AFK", pSpectateId[i]);
        }
        count++;
    }
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, ""I"��������� ������", STRING_GLOBAL, "OK", "");
    return 1;
}

CMD:admins(playerid, params[])
{
    if(p_info[playerid][admin] < 1 && p_info[playerid][p_vip] == 0) return 1;
    if(!Iter_Count(gAdmins)) return SendError(playerid, "��������������� ��� � ����.");
    STRING_GLOBAL = ""W"[#] �������\t"W"�������\t"W" \t"W" \n";
    new count;
    foreach(new i: gAdmins)
    {
        if(p_info[i][helper] == 1) continue;
        if(p_info[i][admin] >= 7) continue;
        if(pSpectateId[i] == INVALID_PLAYER_ID)
        {
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d] "W"%s[%d]\t%d\t%s\t \n", STRING_GLOBAL, count+1, get_name(i), i, p_info[i][admin], p_info[i][p_afkTime] < 2 ? " " : "AFK");
        }
        else
        {
            if(p_info[playerid][admin] < 1)
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d] "W"%s[%d]\t%d\t%s\t \n", STRING_GLOBAL, count+1, get_name(i), i, p_info[i][admin], p_info[i][p_afkTime] < 2 ? " " : "AFK");
            else
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d] "W"%s[%d]\t%d\t%s\t/re %d\n", STRING_GLOBAL, count+1, get_name(i), i, p_info[i][admin], p_info[i][p_afkTime] < 2 ? " " : "AFK", pSpectateId[i]);
        }
        count++;
    }
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, ""I"�������������� ������", STRING_GLOBAL, "OK", "");
    return 1;
}
