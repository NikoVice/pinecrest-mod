        CreateWarehouseInfo();

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Наркопритон\nПод контролем: "W"%s", GetFractionName(DrugDenInfo[ddOwner]));
        DrugDenInfo[ddText] = CreateDynamic3DTextLabel(STRING_GLOBAL, COLOR_MAIN, 2167.1733,-1670.0703,15.0789, 20.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, streamer_TESTLOL);
        CreateDynamicPickup(1239, 23, 2167.1733,-1670.0703,15.0789);

        DrugDenInfo[ddSell] = 100000;
        SaveDrugDen(TYPE_DRUGDEN_SAVE_WAREHOUSE);

        for(new i = 0; i < 3; i++) CreateFarm(TYPE_FARM_WAREHOUSE, i);
    }
    UpdateHostname();
    return true;
}

forward mail_player(playerid);
public mail_player(playerid)
{
    if(cache_num_rows() > 0)
    {
        p_info[playerid][mail][0] = EOS;
        SendError(playerid, "Указанный электронный адрес уже привязан к другому аккаунту.");
        ShowPlayerDialog(playerid, D_EMAIL_REG, DIALOG_STYLE_INPUT, ""I"E-Mail", ""W"\
            Чтобы предотвратить потерю Вашего аккаунта, мы хотим\n\
            защитить его с помощью привязки к электронной почте.\n\
            Это поможет не допустить попытку взлома или утери данных\n\
            аккаунта.\n\n\
            "I"Вводите настоящую, ее надо будет подтвердить, подходит только Google/Yandex.", "Далее", "Отмена");
        return 1;
    }
    new bool:iSendMail = false, isPlayerMobile = IsPlayerMobile(playerid);
    if(ServerInfo[MailerStatus] == 1)
    {
        switch(ServerInfo[RegistrationMail])
        {
            case 1: iSendMail = true;
            case 2: if(!isPlayerMobile) iSendMail = true;
            case 3: if(isPlayerMobile) iSendMail = true;
            default: iSendMail = false;
        }
    }

    if(!iSendMail || p_temp[playerid][premiumgamer] == PREMIUM_GAME)
    {
        ShowPlayerDialog(playerid, D_SELECT_REFERAL, DIALOG_STYLE_INPUT, ""I"Реферальная система", ""W"\
        Если на сервер Вас пригласил друг или знакомый человек, Вы оба\n\
        сможете получить бонус с помощью "I"реферальной системы."W"\n\n\
        Введите никнейм пригласившего Вас игрока в поле ниже:", "Далее", "Пропустить");
    }
    else
    {
        SendCodeMail(playerid, p_info[playerid][mail]);
        ShowPlayerDialog(playerid, D_EMAIL_VALID, DIALOG_STYLE_INPUT, ""I"E-mail", ""W"Введите код высланный Вам на Email адрес:", "Дальше", "Отмена");
    }
    return 1;
}
forward WarningErrorFiles(playerid);
public WarningErrorFiles(playerid)
{
    if(IsPlayerMobile(playerid) && GetPlayerGameVersion(playerid) < CLIENT_VERSION_022023)
    {
        SendError(playerid, "У Вас что-то с файлами игры или клинетом, новые модели транспортных средств не отображаются.");
        SendInfo(playerid, "Рекомендуем обновить или переустановить игру до последней версии в лаунчере.");
    }
    return 1;
}

forward CheckAccountBanCallback(playerid, session_port);
public CheckAccountBanCallback(playerid, session_port)
{
    if(p_temp[playerid][session_PORT] != session_port) return 1;

    new rows;
    cache_get_row_count(rows);
    if(rows)
    {
        new ADMIN_ISSUING_BAN[24], NAME_PLAYER[24], IP_PLAYER[16], BAN_DATA[32], UNBAN_DATA, REASON_FOR_THE_BAN[50];
        cache_get_value_name(0, "Name_Admin",     ADMIN_ISSUING_BAN, 24);
        cache_get_value_name(0, "Name_Player",    NAME_PLAYER, 24);
        cache_get_value_name(0, "IP",             IP_PLAYER, 16);
        cache_get_value_name(0, "Ban_Data",       BAN_DATA, 32);
        cache_get_value_name(0, "Ban_Reason",     REASON_FOR_THE_BAN, 50);
        cache_get_value_name_int(0, "Unban_Data", UNBAN_DATA);

        new date_ban[6];
        gmtime(UNBAN_DATA,date_ban[0],date_ban[1],date_ban[2],date_ban[3],date_ban[4],date_ban[5]);
        STRING_GLOBAL[0] = EOS;
        if(strlen(NAME_PLAYER))
        {
            if(UNBAN_DATA > timestamp)
            {
                f(STRING_GLOBAL, ""W"Аккаунт: {"#cLIGHTRED"}%s\n\
                "W"Дата блокировки: {"#cLIGHTRED"}%s\n\
                "W"Администратор: {"#cLIGHTRED"}%s\n\
                "W"Причина: {"#cLIGHTRED"}%s\n\
                "W"Дата разблокировки: {"#cLIGHTRED"}%02d/%02d/%02d %02d:%02d:%02d\n\n\
                Форум поддержки: {"#cLIGHTRED"}"FORUM_URL"\n"W"Форум > Жалобы > {"#cLIGHTRED"}Жалобы на администрацию",
                NAME_PLAYER,BAN_DATA, ADMIN_ISSUING_BAN, REASON_FOR_THE_BAN,
                date_ban[2],date_ban[1],date_ban[0],date_ban[3],date_ban[4],date_ban[5]);

                ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Аккаунт заблокирован", STRING_GLOBAL,"Закрыть","");
                Kick(playerid);
                return 1;
            }
            else
            {
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `table_ban` WHERE `Name_Player` = '%e'", NAME_PLAYER);
                mysql_pquery(con_bd, STRING_GLOBAL);
            }
        }
        if(strlen(IP_PLAYER))
        {
            if(UNBAN_DATA > timestamp)
            {
                f(STRING_GLOBAL, ""W"IP: {"#cLIGHTRED"}%s\n\
                "W"Администратор: {"#cLIGHTRED"}%s\n\
                "W"Причина: {"#cLIGHTRED"}%s\n\
                "W"Дата разблокировки: {"#cLIGHTRED"}%02d/%02d/%02d %02d:%02d:%02d\n\n\
                Форум поддержки: {"#cLIGHTRED"}"FORUM_URL"\n"W"Форум > Жалобы > {"#cLIGHTRED"}Жалобы на администрацию",
                IP_PLAYER, ADMIN_ISSUING_BAN, REASON_FOR_THE_BAN,
                date_ban[2],date_ban[1],date_ban[0],date_ban[3],date_ban[4],date_ban[5]);

                ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Аккаунт заблокирован", STRING_GLOBAL,"Закрыть","");
                Kick(playerid);
                return 1;
            }
            else
            {
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `table_ban` WHERE `IP` = '%e'", IP_PLAYER);
                mysql_pquery(con_bd, STRING_GLOBAL);
            }
        }
    }
    return 1;
}

GetPlayerHotel(playerid)
{
    new count = 0;
    for(new i; i < totalbizz; i++)
    {
        if(b_info[i][b_mysql_id] == INVALID_MYSQL_ID) continue;
        for(new idx = 0; idx < MAX_HOTEL_ROOMS; idx++)
        {
            if(b_info[i][b_mysql_id] == hotel_rooms_info[b_info[i][b_mysql_id]][idx][hr_hotel_id])
            {
                if(hotel_rooms_info[b_info[i][b_mysql_id]][idx][hr_user_id] == p_info[playerid][ID])
                {
                    if(hotel_rooms_info[b_info[i][b_mysql_id]][idx][hr_rent] < 5) SendInfo(playerid, "Аренда номера в отеле закончится менее чем через 5 часов.");
                    count++;
                    p_info[playerid][key_hotel] = hotel_rooms_info[b_info[i][b_mysql_id]][idx][hr_hotel_id];
                    p_info[playerid][key_hotel_room] = hotel_rooms_info[b_info[i][b_mysql_id]][idx][hr_room_id];
                    return i;
                }
            }
        }
    }
    if(count <= 0) p_info[playerid][key_hotel] = -1, p_info[playerid][key_hotel_room] = -1;
    return -1;
}

this::EndRegistretionPlayer(playerid)
{
    p_info[playerid][ID] = cache_insert_id();

    SetPVarInt(playerid, #registered_now, true);
    LoadPlayerAccount(playerid);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[+REG] На сервере зарегистрирован новый игрок: %s[%d]", get_name(playerid), playerid);
    SendAdminMessage(0xD99B69FF, STRING_GLOBAL);
    return true;
}

forward UpdateSpectatingStatus(spectatorid, spectedid);
public UpdateSpectatingStatus(spectatorid, spectedid)
{
    if(pSpectateId[spectatorid] == spectedid)
    {
        new spectedid_state = GetPlayerState(spectedid);
        if(spectedid_state == PLAYER_STATE_WASTED)
            return GameTextForPlayer(spectatorid, "~r~Target wasted!", 5000, 3);

        if(spectedid_state == PLAYER_STATE_SPECTATING)
        {
            callcmd::reconoff(spectatorid, "/0");
            return GameTextForPlayer(spectatorid, "~r~Target in spectating mode!", 5000, 3);
        }

        if(!IsPlayerConnected(spectedid))
        {
            callcmd::reconoff(spectatorid, "/0");
            return GameTextForPlayer(spectatorid, "~r~Target disconnected!", 5000, 3);
        }
        TogglePlayerSpectating(spectatorid, 1);

        SetPlayerVirtualWorld(spectatorid, GetPlayerVirtualWorld(spectedid));
        SetPlayerInterior(spectatorid, GetPlayerInterior(spectedid));

        if(IsPlayerInAnyVehicle(spectedid))
            PlayerSpectateVehicle(spectatorid, GetPlayerVehicleID(spectedid), SPECTATE_MODE_NORMAL);
        else
            PlayerSpectatePlayer(spectatorid, spectedid, SPECTATE_MODE_NORMAL);
    }
    return 1;
}

UpdateSpectatingTargetInfo(playerid)
{
    new target = pSpectateId[playerid];
    if(target == INVALID_PLAYER_ID || !IsPlayerConnected(target))
        return UpdateSpectatingStatus(playerid, target);

    new targetIp[16 + 1];
    GetPlayerIp(target, targetIp, 16);

    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "%s(%d)", get_name(target), target);
    PlayerTextDrawSetString(playerid, PTD_Recon[playerid][0], STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "%d", p_info[target][level]);
    PlayerTextDrawSetString(playerid, PTD_Recon[playerid][1], STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "%d", GetPlayerPing(target));
    PlayerTextDrawSetString(playerid, PTD_Recon[playerid][2], STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    new Float:p_health, Float:p_armour;
    GetPlayerArmour(target, p_armour);
    GetPlayerHealth(target, p_health);
    f(STRING_GLOBAL, "%.2f/%.2f", p_health, p_armour);
    PlayerTextDrawSetString(playerid, PTD_Recon[playerid][3], STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    new weapon, ammo;
    GetPlayerWeaponData(playerid, WEAPON_Slot[GetPlayerWeapon(target)], weapon, ammo);
    f(STRING_GLOBAL, "%s(%d)", WEAPON_Name[weapon], ammo);
    PlayerTextDrawSetString(playerid, PTD_Recon[playerid][4],STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    new vehicleid = GetPlayerVehicleID(target);
    f(STRING_GLOBAL, "%d", vehicleid != 0 ? GetVehicleSpeed(vehicleid) : -1);// AntiCheatGetSpeed(playerid));
    if(vehicleid != 0 && GetVehicleModelEx(vehicleid) >= 400)
    {
        new Float:v_health;
        GetVehicleHealth(vehicleid, v_health);
        f(STRING_GLOBAL, "%s(%s/HP: %.0f)%s", STRING_GLOBAL, GetVehicleName(vehicleid), v_health/10.0, p_temp[target][twinturbo_on] == 1 ? "~r~[TT]" : "");
    }
    PlayerTextDrawSetString(playerid, PTD_Recon[playerid][5],STRING_GLOBAL);

    PlayerTextDrawSetString(playerid, PTD_Recon[playerid][6], "/getip");
    PlayerTextDrawSetString(playerid, PTD_Recon[playerid][7], "/getip");
    /*
    PlayerTextDrawSetString(playerid, PTD_Recon[playerid][6], p_info[target][regIP]);
    PlayerTextDrawSetString(playerid, PTD_Recon[playerid][7], targetIp);
    */

    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "%d", p_info[target][warn]);
    PlayerTextDrawSetString(playerid, PTD_Recon[playerid][8], STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "%d", p_info[target][cash]);
    PlayerTextDrawSetString(playerid, PTD_Recon[playerid][9], STRING_GLOBAL);
    return 1;
}

dialog_reg(playerid, regandlog)
{
    STRING_GLOBAL[0] = EOS;
    switch(regandlog)
    {
        case 1:
        {
            if(SRV_ID == 0)
            {
                if(CHECK_TESTERS == true && !FD(playerid) && !CheckTesters(playerid))
                {
                    SendInfo(playerid, "Вам запрещена авторизация на сервере.");
                    Kick(playerid);
                    return 1;
                }
                //if(FD(playerid)) return LoadPlayerAccount(playerid);
            }
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
            Приветствуем Вас на сервере "I"%02d"W" проекта "I""SERVER"!"W"\n\n\
            Чтобы погрузиться в увлекательный мир приключений,\n\
            Вам нужно всего лишь авторизоваться.\n\n\
            Аккаунт "I"%s"W" зарегистрирован на сервере,\n\
            для авторизации введите пароль:", SRV_ID, get_name(playerid));
            ShowPlayerDialog(playerid, D_LOGIN, DIALOG_STYLE_PASSWORD, ""I"Авторизация", STRING_GLOBAL, "Далее", "Отмена");
            p_temp[playerid][LoginFix] = 1;
            p_temp[playerid][LoginTimerFix] = timestamp + SECONDS_TO_LOGIN;
        }
        case 2:
        {
            if(SRV_ID == 0 && CHECK_TESTERS == true)
            {
                if(!FD(playerid) && !CheckTesters(playerid))
                {
                    SendInfo(playerid, "Вам запрещена регистрация на сервере.");
                    Kick(playerid);
                    return 1;
                }
            }

            //if(SRV_ID != 0) SetTimerEx("OnCheckDevice", 3000, false, "i", playerid);

            /*if(!IsValidRPNickName(get_name(playerid)))
            {
                SendInfo(playerid, "Вы были отключены от сервера.");
                SendInfo(playerid, "У Вас Non-RP ник. Пример RP ника: Ivan_Ivanov");
                if(IsPlayerMobile(playerid)) SendInfo(playerid, "Выйдите из игры, измените ник в настройках лаунчера и зайдите снова.");
                else SendInfo(playerid, "Выйдите из игры, измените ник в окне SA-MP и зайдите снова.");
                Kick(playerid);
                return 1;
            }*/

            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
            Приветствуем Вас на сервере "I"%02d"W" проекта "I""SERVER"!"W"\n\n\
            Чтобы погрузиться в увлекательный мир приключений,\n\
            Вам нужно всего лишь зарегистрироваться.\n\n\
            Аккаунт "I"%s"W" еще не зарегистрирован на сервере,\n\
            для регистрации придумайте пароль:", SRV_ID, get_name(playerid));
            ShowPlayerDialog(playerid, 1, DIALOG_STYLE_INPUT, ""I"Регистрация", STRING_GLOBAL, "Далее", "Отмена");
        }
    }
    return 1;
}
