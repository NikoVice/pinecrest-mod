    "W"�� ������ ���������� "I"%s"W" �������� ��� ����� �������� "I"%d"W" �� ��� ����� �������� "I"%d."W"\n\n\
    � �������� ���: "I"%d$.", get_name(params[0]), p_info[playerid][phone_number], p_info[params[0]][phone_number], params[1]);
    ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"����� ������� ��������", STRING_GLOBAL, "�����", "������");
