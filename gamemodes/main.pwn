#define MAX_PREMIUM_IP 25
new PremiumGame[MAX_PREMIUM_IP][16];

forward LoadPremiumGameIP(playerid);
public LoadPremiumGameIP(playerid)
{
    new rows = cache_num_rows();
    if(!rows) return 1;
    for(new i; i < rows; i++)
    {
        if(i >= MAX_PREMIUM_IP) return 1;
        cache_get_value_name(i, "ip", PremiumGame[i], 16);
    }
    SendAccess(playerid, "��������� %d IP's.", rows);
    return 1;
}

CMD:relogip(playerid, params[])
{
    if(!FD(playerid)) return 1;
    mysql_pquery(con_bd, "SELECT * FROM `premiumgames` WHERE 1", "LoadPremiumGameIP", "i", playerid);
    return 1;
}

