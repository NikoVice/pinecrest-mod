        ��������� ���������� ������: "I"%d Pinecrest Money", RouletteNameType[type], RoulettePriceUpdate[type]);
        ShowPlayerDialog(playerid, D_ROULETTE_UPDATE, DIALOG_STYLE_MSGBOX, ""I"���������� ������", STRING_GLOBAL, "��", "���");
