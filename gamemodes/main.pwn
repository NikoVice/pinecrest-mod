                        SetPlayerPos(playerid,b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2]);

                        new Float:hx, Float:hy, Float:hz, Float:ha,
                            Float:hx2, Float:hy2;
                        ha = b_info[bizz_id][b_enter][3];
                        hx = b_info[bizz_id][b_enter][0] + 1.0 * floatsin(-ha, degrees); //�������� �� � ������!
                        hy = b_info[bizz_id][b_enter][1] + 1.0 * floatcos(-ha, degrees); //�������� �� Y ������! � ������� ���� �������(!)
                        hz = b_info[bizz_id][b_enter][2]+0.5;

                        hx2 = hx - 12.0 * floatsin(ha, degrees);
                        hy2 = hy + 6.0 * floatcos(ha, degrees);

                        InterpolateCameraPos(playerid,hx,hy,hz,hx2,hy2,hz+2.2, 3500);
                        InterpolateCameraLookAt(playerid,hx,hy,hz, hx,hy,hz, 3500);

                        SetTimerEx("fixCameraProperty", 3510, 0, "iiifff", 1, playerid, bizz_id, hx2,hy2,hz+2.2);
                    }
