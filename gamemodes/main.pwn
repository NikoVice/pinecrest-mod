GetCoordBonnetVehicle(vehicleid, &Float:x, &Float:y, &Float:z)
{
    new Float:angle, Float:distance;
    GetVehicleModelInfo(GetVehicleModelEx(vehicleid), 1, x, distance, z);
    distance = distance/2 + 0.1;
    GetVehiclePos(vehicleid, x, y, z);
    GetVehicleZAngle(vehicleid, angle);
    x += (distance * floatsin(-angle, degrees));
    y += (distance * floatcos(-angle, degrees));
    return 1;
}
CMD:v(playerid, params[])
{
    if(p_info[playerid][p_vip] == 0 && p_info[playerid][admin] < 2) return 1;
    if(p_info[playerid][mute] > 0) return SendError(playerid, "У Вас блокировка чата.");
    if(p_info[playerid][p_settings][CHAT_VIP] == 0) return SendError(playerid, "У Вас отключен VIP чат.");
    if(p_temp[playerid][VipFix] > timestamp) return SendError(playerid, "Вы сможете написать в VIP чат через %d сек.", p_temp[playerid][VipFix] - timestamp);
    if(isnull(params) || strlen(params) > 144) return SendInfo(playerid, "Используйте: /v [текст]");

    foreach(new i : Player)
    {
        if((p_info[i][p_vip] > 0 || p_info[i][admin] > 0) && p_info[playerid][admin] != 15 && p_info[i][p_settings][3] == 1)
        {
            SendMes(i, COLOR_LYELLOW, "[VIP]%s%s {"#cLYELLOW"}%s [%d]: %s", p_info[playerid][admin] > 0 ? " {"#cLIGHTRED"}[A]" : "", p_info[playerid][p_add_vip] == 1 ? " {"#cLIGHTRED"}[ADD]" : "", get_name(playerid), playerid, params);
        }
    }
    new max_time = 30;
    if(p_info[playerid][p_vip] == 3 && p_info[playerid][p_add_vip] == 1) max_time = max_time / 2;
    p_temp[playerid][VipFix] = timestamp + max_time;
    return 1;
}


forward OnLoadMemoryTopKilled(playerid, FRAC_ID);
public OnLoadMemoryTopKilled(playerid, FRAC_ID)
{
    new rows;
    cache_get_row_count(rows);
    if(rows == 0) return SendError(playerid, "Ничего не найдено.");

    new PlayerKill,
        str_frac[32],
        PlayerName[24];

    STRING_GLOBAL[0] = EOS;
    format(str_frac, sizeof(str_frac), ""I"ТОП %s", GetFractionName(FRAC_ID));
    for(new i; i < rows; i ++)
    {
        cache_get_value_name(i, "name", PlayerName, MAX_PLAYER_NAME);
        cache_get_value_name_int(i, "CaptKill", PlayerKill);

        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{FFFF00}%s\t\t"W"Убийств: {00FF00}%d\n", STRING_GLOBAL, PlayerName, PlayerKill);
    }
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, str_frac, STRING_GLOBAL, "Принять", "Отмена");
    return 1;
}

CheckPlayerVehicleSpeed(playerid)
{
    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && PRESS_UP[playerid] == 1 && p_temp[playerid][twinturbo_on] == 1)
    {
        if(GetPlayerPing(playerid) < 300)
        {
            new vehicleid = GetPlayerVehicleID(playerid);
            if(veh_info[vehicleid][v_engine] == 1 && veh_info[vehicleid][v_twinturbo_data][tt_suspension] == 0 && veh_info[vehicleid][v_twinturbo_data][tt_transmission] == 0 && veh_info[vehicleid][v_twinturbo_data][tt_turbocharging] == 0 && veh_info[vehicleid][v_twinturbo_data][tt_engine] == 0) return 1;
            new vehiclespeed = GetVehicleSpeed(vehicleid), vehiclemaxspeed = GetVehicleMaxSpeed(vehicleid);
            if(vehiclespeed > 0.0 && vehiclespeed > GetVehicleSpeed(vehicleid) * 0.9 && vehiclespeed < vehiclemaxspeed)
            {
                if(MaxSpeedUpdate[playerid] < 2) MaxSpeedUpdate[playerid]++;
                if(MaxSpeedUpdate[playerid] == 2)
                {
                    SetVehicleSpeed(vehicleid, vehiclespeed * 1.1);
                }
            }
            else if(MaxSpeedUpdate[playerid] > 0) MaxSpeedUpdate[playerid] = 0;
        }
        else
        {
            OnPlayerUpdateVehicleInfo(playerid, SPEEDO_TWINTURBO);
            p_temp[playerid][twinturbo_on] = 0;
            SendInfo(playerid, "У вас большой ping, TwinTurbo отключен.");
        }
    }
    return 1;
}

GetVehicleMaxSpeed(vehicleid)
{
    new vehicleupgrade = veh_info[vehicleid][v_twinturbo_data][tt_suspension] + veh_info[vehicleid][v_twinturbo_data][tt_transmission] + veh_info[vehicleid][v_twinturbo_data][tt_turbocharging] + veh_info[vehicleid][v_twinturbo_data][tt_engine];

    new Float:vehiclemaxspeed = GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_SPEED) * (1.0 + (vehicleupgrade * 0.1));
    if(vehiclemaxspeed == 0) vehiclemaxspeed = GetVehicleSpeed(vehicleid);
    else if(vehiclemaxspeed > 270.0) vehiclemaxspeed = 270.0;

    return floatround(vehiclemaxspeed);
}


CMD:news(playerid, params[])
{
    if((p_info[playerid][member] != RADIO_LS && p_info[playerid][member] != RADIO_SF && p_info[playerid][member] != RADIO_LV && p_info[playerid][member] != MAYOR_LS) || p_info[playerid][fwork] != true) return SendError(playerid, "Вы не начали рабочий день.");
    if(p_info[playerid][member] == MAYOR_LS && p_info[playerid][rang] != 5) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    new carid = GetPlayerVehicleID(playerid);
    STRING_GLOBAL[0] = EOS;
    if((IsValidVehicle(carid) && veh_info[carid][v_npoType] == NPO_FACTION && veh_info[carid][v_npoId] == RADIO_LS) || IsPlayerInRangeOfPoint(playerid, 100.0, 1229.8328,2073.8599,1009.4809) && GetPlayerVirtualWorld(playerid) == 1 ||
        (IsValidVehicle(carid) && veh_info[carid][v_npoType] == NPO_FACTION && veh_info[carid][v_npoId] == RADIO_SF) || IsPlayerInRangeOfPoint(playerid, 100.0, 1229.8328,2073.8599,1009.4809) && GetPlayerVirtualWorld(playerid) == 2 ||
        (IsValidVehicle(carid) && veh_info[carid][v_npoType] == NPO_FACTION && veh_info[carid][v_npoId] == RADIO_LV) || IsPlayerInRangeOfPoint(playerid, 100.0, 1229.8328,2073.8599,1009.4809) && GetPlayerVirtualWorld(playerid) == 3 )
    {
        f(STRING_GLOBAL, "%s\n"I"[2]"W" Пригласить в эфир\n"I"[3]"W" Выпроводить из эфира\n%s\n%s",
            !GetPVarInt(playerid, "Ether") ? ("{63BD4E}[1] Войти в эфир") : ("{F04245}[1] Выйти из эфира"),
            !EtherCall[0] ? ("{63BD4E}[4] Включить прием звонков в эфир") : ("{F04245}[4] Выключить прием звонков в эфир"),
            !EtherSms[0] ? ("{63BD4E}[5] Включить прием смс в эфир") : ("{F04245}[5] Выключить прием смс в эфир"));
        ShowPlayerDialog(playerid, D_NEWS_PANEL, DIALOG_STYLE_LIST, ""I"СМИ Панель", STRING_GLOBAL, "Принять", "Отмена");
        return 1;
    }
    else SendError(playerid, "Вы должны находиться в специализированном транспортном средстве или офисе.");
    return 1;
}

CMD:rstats(playerid, params[])
{
    if(p_info[playerid][member] != RADIO_LS && p_info[playerid][member] != RADIO_SF && p_info[playerid][member] != RADIO_LV) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(p_info[playerid][rang] < 9)
    {
        ShowFinancStatDialog(playerid, playerid);
        return 1;
    }
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /rstats [id игрока]");
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не найден.");
    if(IsPlayerConnected(params[0]) == 0) return SendError(playerid, "Игрок не найден.");
    if(distance(playerid, params[0]) > 3.0 || GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING) return SendError(playerid, "Игрок далеко от Вас.");

    ShowFinancStatDialog(playerid, params[0]);
    return 1;
}

ShowFinancStatDialog(playerid, targetid)
{
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `edit_advertise` WHERE `user_id` = %d LIMIT 1",
        p_info[playerid][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL, "FinancStatsSNN", "ii", playerid, targetid);
    return 1;
}

forward FinancStatsSNN(playerid, targetid);
public FinancStatsSNN(playerid, targetid)
{
    if(!cache_num_rows())
        return 0;

    static const
    month_names[12][9] =
    {
        "января", "февраля", "марта", "апреля", "мая", "июня",
        "июля", "августа", "сентября", "октября", "ноября", "декабря"
    },
    month_days[12] =
    {
        31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31
    };

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Статистика сотрудника СМИ: %s\n", get_name(playerid));
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%s\n", STRING_GLOBAL, GetFractionName(p_info[playerid][member]));
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%sДолжность: %s [%d]\n\n\n", STRING_GLOBAL, GetPlayerFractionRangName(playerid), p_info[playerid][rang]);

    new year, month, day, total_buff;
    getdate(year, month, day);

    if(day >= 7)
    {
        for(new i, buff; i < 7; i++)
        {
            cache_get_value_index_int(0, i+1, buff);
            total_buff += buff;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}%02d %s %04d:\t\t{00FF00}%d\n", STRING_GLOBAL, day-7+i + 1, month_names[month-1], year, buff);
        }
    }
    else
    {
        if(month != 1) month-=1;
        else
        {
            month = 12;
            year-=1;
        }

        new i,
            d = month_days[month-1] + day-7 + 1,
            last_iter = month_days[month-1]+1,
            buff;

        for(; d < last_iter; i++, d++)
        {
            cache_get_value_index_int(0, i+1, buff);
            total_buff += buff;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}%02d %s %04d:\t\t{00FF00}%d\n", STRING_GLOBAL, d, month_names[month-1], year, buff);
        }

        if(month == 12)
        {
            year++;
            month = 1;
        }
        else month++;
        d = 1;
        last_iter = day;
        for(; d <= last_iter; i++, d++)
        {
            cache_get_value_index_int(0, i+1, buff);
            total_buff += buff;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}%02d %s %04d:\t\t{00FF00}%d\n", STRING_GLOBAL, d, month_names[month-1], year, buff);
        }
    }
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s\nВсего отредактировано: %d", STRING_GLOBAL, total_buff);
    ShowPlayerDialog(targetid, 0, DIALOG_STYLE_MSGBOX, ""I"Статистика", STRING_GLOBAL, "Ок", "");
    return 1;
}

forward OnMemoryCheckPlayerID(playerid);
public OnMemoryCheckPlayerID(playerid)
{
    new string;
    cache_get_row_count(string);

    if(string == 0)
    {
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `edit_advertise` (`user_id`, `day_7`) VALUES (%d, '1')",
        p_info[playerid][ID]);
        mysql_tquery(con_bd, STRING_GLOBAL);
    }
    if(string != 0)
    {
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `edit_advertise` SET `day_7` = `day_7` + '1' WHERE `user_id` = %d",
        p_info[playerid][ID]);
        mysql_tquery(con_bd, STRING_GLOBAL);
    }
    return 1;
}
CMD:object(playerid, params[])
{
    if(SRV_ID && (!FD(playerid) || p_info[playerid][admin] < 10)) return 1;
    ShowPlayerDialog(playerid, D_OBJECTS,DIALOG_STYLE_LIST, ""I"Редактор",""I"[1]"W" Создать объект\n"I"[2]"W" Редактировать объекты","Выбрать","Отмена");
    return 1;
}
public OnPlayerSelectDynamicObject(playerid, objectid, modelid, Float:x, Float:y, Float:z)
{
    if(!FD(playerid) || p_info[playerid][admin] < 10) return 0;
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, 128, "ID объекта: %d\nКоординаты объекта: %f,%f,%f", modelid,x,y,z);
    ShowPlayerDialog(playerid, D_OBJECTS_ADD_SELECT, DIALOG_STYLE_MSGBOX, ""I"Редактор", STRING_GLOBAL ,"Изменить", "Удалить");
    SetPVarInt(playerid, "SelectedObject", objectid);
    SetPVarInt(playerid, "modelid", modelid);
    return 1;
}
public OnPlayerEditDynamicObject(playerid, objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz)
{
    if(!FD(playerid) || p_info[playerid][admin] < 10) return 0;
    if(GetPVarInt(playerid, #edit_cctv))
        CCTV_OnPlayerEditDynamicObject(playerid, objectid, response, x, y, z, rx, ry, rz);

    BJ_OnPlayerEditDynObject(playerid, objectid, response, x, y, z, rx, ry, rz);

    if(response == EDIT_RESPONSE_FINAL)
    {// player clicked on savе
        if(p_temp[playerid][p_listitem_int] == STATUS_ANTIDM_OBJECT)
        {
            AntiDMInfo[count_antidm][dmInfoX] = x;
            AntiDMInfo[count_antidm][dmInfoY] = y;
            AntiDMInfo[count_antidm][dmInfoZ] = z;
            AntiDMInfo[count_antidm][dmInfoRZ] = rz;
            CreateDMZ(playerid);
        }
        if(GetPVarInt(playerid, "modelid"))
        {
            printf("CreateDynamicObject(%d, %f, %f, %f, %f, %f, %f, -1, -1, -1, 100.0, 100.0);", GetPVarInt(playerid, "modelid"), x,y,z, rx, ry, rz);
        }
        if(p_temp[playerid][p_listitem][10] == objectid)
        {
            p_temp[playerid][p_listitem][10] = -1;
            new houseId = p_temp[playerid][p_listitem][11];

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `house` SET `h_gate_pos` = '%f|%f|%f|%f' WHERE `h_mysql_id` = %d",
                x, y, z, rz, h_info[houseId][h_mysql_id]);
            SendAdminMessage(COLOR_RED, STRING_GLOBAL);

            //if(SRV_ID == 0) WriteLog("zhouse", STRING_GLOBAL);
            h_info[houseId][h_gate_pos][0] = x;
            h_info[houseId][h_gate_pos][1] = y;
            h_info[houseId][h_gate_pos][2] = z;
            h_info[houseId][h_gate_pos][3] = rz;

            h_info[houseId][h_gate] = CreateDynamicObject(19912, h_info[houseId][h_gate_pos][0], h_info[houseId][h_gate_pos][1], h_info[houseId][h_gate_pos][2], 0.0, 0.0, h_info[houseId][h_gate_pos][3], -1, -1, -1, 120.0, 120.0);
            save_house(houseId);
            update_house(houseId);

            gate_house_idx[totalgatehouse] = houseId;
            totalgatehouse++;

            SendAccess(playerid, "Вы установили ворота для дома %d!", houseId);
        }
    }
    else if(response == EDIT_RESPONSE_CANCEL){// player cancelled (ESC)
        if(p_temp[playerid][p_listitem_int] == objectid)
        {
            p_temp[playerid][p_listitem_int] =
            p_temp[playerid][p_listitem][0] =
            p_temp[playerid][p_listitem][1] = -1;
        }
        if(p_temp[playerid][p_listitem][10] == objectid)
            p_temp[playerid][p_listitem][10] = -1;
        DestroyDynamicObject(objectid);
    }
    else if(response == EDIT_RESPONSE_UPDATE){// player moved the object (edition did not stop at all)
        SetDynamicObjectPos(objectid, x, y, z);
        SetDynamicObjectRot(objectid, rx, ry, rz);
    }
    return 1;
}
