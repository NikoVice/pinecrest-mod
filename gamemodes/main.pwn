            if(!response)
                return 1;

            if(p_info[playerid][level] < 2)
                return SendError(playerid, "У Вас нет 2-ого уровня.");
            new biz_id = GetPVarInt(playerid, "bID"),
                till = b_info[biz_id][_till];
            if(p_info[playerid][Lic][LIC_WEAPON] != 1)
                return SendError(playerid, "У Вас нет лицензии на \"%s\".", name_license[LIC_WEAPON]);

            if(!(0 <= listitem <= sizeof(shopWEAPON)-1) || !strlen(inputtext))
                return 1;

            new count = strval(inputtext);
            if(!(1 <= count <= 10)) return SendError(playerid, "За раз можно купить не меньше 1 и не больше 10 обойм.");

            new price = shopWEAPON[listitem][g_Price] * till * count;

            if(p_info[playerid][cash] < price)
                return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            if(b_info[biz_id][_prod] >= ((price) - (price / 10)) / 100)
            {
                b_info[biz_id][_prod] -= ((price) - (price / 10)) / 100;
                b_info[biz_id][_bank] += (price) - (price / 10);
                AddMafiaBank(biz_id, price / 10);

                biz_finka[biz_id] += (price) - (price / 10);
                UpdateIntForFinanceBiz(biz_id, (price) - (price / 10));
