            if(strval(inputtext) < 1000 || strval(inputtext) > 100000) return ShowWarehouseInfo(playerid), SendError(playerid, "Кол-во патронов и материалов должно быть не менее 1000 и не более 100000.");
            if(p_info[playerid][member] == 0) return SendError(playerid, "Вы не состоите во фракции.");
            if(GetFactionType(p_info[playerid][member]) != FACTION_TYPE_GOS) return SendError(playerid, "Вы не состоите в гос. фракции.");
            if(p_info[playerid][rang] < 9) return SendError(playerid, "Создание гос. контрактов на поставку патронов и материалов доступно лидерам и заместителям.");
            new idx = p_info[playerid][member];
            if(CheckCreatedWarehouseID(idx) != -1) return ShowWarehouseInfo(playerid), SendError(playerid, "Для Вашей организации уже создан гос. контракт на поставку патронов и материалов.");
            if(GetFreeWarehouseID() == -1) return SendError(playerid, "В данный момент нет свободных мест под гос. контракты.");
            CreateWarehouse(playerid, idx, strval(inputtext), strval(inputtext));
            return 1;
        }
