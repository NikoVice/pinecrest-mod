            {
                case 0: ShowDialogBillboard(playerid, biz_id, BB_LIST_TEXT, idx);
                case 1: ShowDialogBillboard(playerid, biz_id, BB_LIST_MATERIAL_SIZE, idx);
                case 2: ShowDialogBillboard(playerid, biz_id, BB_LIST_FONT_FACE, idx);
                case 3: ShowDialogBillboard(playerid, biz_id, BB_LIST_FONT_SIZE, idx);
                case 4:
                {
                    BillboardInfo[idx][bbFontBold] ^= 1;
                    SendAccess(playerid, "Вы %s юирный шрифт.", BillboardInfo[idx][bbFontBold] == 0 ? "выключили" : "включили");
                    SetBillboardText(idx);
