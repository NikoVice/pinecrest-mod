                    MaskMail(p_info[playerid][mail], hide_mail);
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
                        "I"[1]"W" E-Mail\t%s%s\n\
                        "I"[2]"W" Изменить пароль\t \n\
                        "I"[3]"W" Google Authenticator \t"I"%s\n\
                        "I"[4]"W" ВКонтакте \t"I"%s\n\
                        "I"[5]"W" Telegram \t"I"%s\n\
                        "I"[6]"W" Изменить ник \t"I"%s",
                        !IsMailConfirmed(playerid) ? "{"#cLIGHTRED"}" : "{33CC66}", hide_mail,
