}

LeaveFromGym(playerid, death = 0)
{
    DeletePVar(playerid, "GymTrainingStyde");
    SendAccess(playerid, "Вы закончили тренировку.");
    if(death == 0)
        SetPlayerSkinEx(playerid);
    p_temp[playerid][GymBoxClick] = 0;
    p_temp[playerid][GymBoxClickTime] = 0;
    if(p_info[playerid][pstyle][0]) SetPlayerFightingStyle(playerid, p_info[playerid][pstyle][0]);
    else SetPlayerFightingStyle(playerid, 4);
    return 1;
}
