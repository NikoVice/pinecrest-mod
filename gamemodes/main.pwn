                    return 1;
                }
            }
            else if(ItemsInfo[item_id][iType] == TYPE_ITEMS_SKINS)
            {
                if(sscanf(inputtext, "p<,>iii", iWear, price, premium))
                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
                    return 1;
                }
                if(!(0 <= iWear <= 100))
                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
                    SendError(playerid, "������� ������ ������ ���� �� 0 �� 100.");
                    return 1;
