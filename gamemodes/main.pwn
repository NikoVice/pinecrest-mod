                            CarMarketInfo[pos_id][cmPrice]);
                        ShowPlayerDialog(playerid, D_CAR_MARKET_BUY, DIALOG_STYLE_MSGBOX, ""I"�����: ���������", STRING_GLOBAL, "�������", "������");
                    }
                }
                return 1;
            }
            if(GetPVarInt(playerid, "LoadBreak") != 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
            {
