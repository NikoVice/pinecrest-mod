                    strcat(STRING_GLOBAL, "/myskill - навыки\n");
                    strcat(STRING_GLOBAL, "/inv - инвентарь\n");
                    strcat(STRING_GLOBAL, "/acc - аксессуары\n");
                    strcat(STRING_GLOBAL, "/costume - костюмы\n");
                    strcat(STRING_GLOBAL, "/bp - Battle Pass\n");
                    strcat(STRING_GLOBAL, "/trade ID - предложить обмен\n");
                    strcat(STRING_GLOBAL, "/sellsim или /changesim ID - предложить продажу(обмен) сим карты\n");
                    strcat(STRING_GLOBAL, "/music - музыкальный проигрыватель\n");
                    strcat(STRING_GLOBAL, "/play - наушники\n");
                    strcat(STRING_GLOBAL, "/leaders - список лидеров\n");
                    strcat(STRING_GLOBAL, "/zams - список заместителей\n");
