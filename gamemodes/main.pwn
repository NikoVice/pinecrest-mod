        case D_TOPWAR:
        {
            if(!response) return 1;
            if(TopList[listitem][WarType] == CAPTURE_ID_NONE) return 1;
            if(TopList[listitem][WarType] == CAPTURE_ID_FAMILY)
            {
                f(STRING_GLOBAL, "���\t�������\t�������\t��������/�������� �����\n- %s:\t-\t-\t-\n", FamilyData[TopList[listitem][WarID][0]][fName]);
                STRING_MIN[0] = EOS;
                f(STRING_MIN, "- %s:\t-\t-\t-\n", FamilyData[TopList[listitem][WarID][1]][fName]);
            }
            else
            {
                f(STRING_GLOBAL, "���\t�������\t�������\t��������/�������� �����\n- %s:\t-\t-\t-\n", GetFractionName(TopList[listitem][WarID][0]));
                STRING_MIN[0] = EOS;
                f(STRING_MIN, "- %s:\t-\t-\t-\n", GetFractionName(TopList[listitem][WarID][1]));
            }
            new count;
            for(new i; i < MAX_PLAYER_TOP; i++)
            {
                if(TopList[listitem][KillsOne][i] != -1) f(STRING_GLOBAL, "%s"W"[%d]"I" %s\t"W"%d\t%d\t%0.1f/%0.1f\n", STRING_GLOBAL, i+1,
                    TopListNickOne[listitem][i], TopList[listitem][KillsOne][i], TopList[listitem][DeathsOne][i], TopList[listitem][GiveDamageOne][i], TopList[listitem][TakeDamageOne][i]), count++;

                if(TopList[listitem][KillsTwo][i] != -1) f(STRING_MIN, "%s"W"[%d]"I" %s\t"W"%d\t%d\t%0.1f/%0.1f\n", STRING_MIN, i+1,
                    TopListNickTwo[listitem][i], TopList[listitem][KillsTwo][i], TopList[listitem][DeathsTwo][i], TopList[listitem][GiveDamageTwo][i], TopList[listitem][TakeDamageTwo][i]), count++;
            }
            strcat(STRING_GLOBAL, STRING_MIN);
            if(!count)
                return SendError(playerid, "���������� ����������.");

            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, "����������� ���", STRING_GLOBAL, "OK", "�������");
        }
        case D_ANTIDM_MENU:
        {
            if(!response) return true;
            switch(listitem)
            {
                case 0: ShowPlayerDialog(playerid, D_ANTIDM_CREATE_TYPE, DIALOG_STYLE_LIST, ""I"�������� ZZ",""I"[1]"W" ����\n"I"[2]"W" �������","�������","�������");
                case 1:
                {
                    for(new i = count_antidm; i != -1; i--)
                    {
                        if(IsPlayerInDynamicArea(playerid, AntiDMInfo[i][dmArea]))
                        {
                            DestroyDynamicObject(AntiDMInfo[i][dmObject]);
                            AntiDMInfo[i][dmObject] = INVALID_OBJECT_ID;
                            DestroyDynamicArea(AntiDMInfo[i][dmArea]);
                            DestroyDynamic3DTextLabel(AntiDMInfo[i][dm3DLabel]);

                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `antidm_info` WHERE `id` = %d", AntiDMInfo[i][dmMysqlID]);
                            mysql_tquery(con_bd, STRING_GLOBAL);

                            SendAccess(playerid, "���� �� ���� ������� �������.");
                            break;
                        }
                    }
                }

                case 2:
                {
                    for(new i = count_antidm; i != -1; i--)
                    {
                        if(IsPlayerInDynamicArea(playerid, AntiDMInfo[i][dmArea]))
                        {
                            STRING_GLOBAL[0] = EOS;
                            for(new d = 0; d < MAX_FRACTIONS; d++) f(STRING_GLOBAL, "%s"I"[%d]"W" %s [%s]\n",STRING_GLOBAL, d+1, GetFractionName(d),(AntiDMInfo[i][dmFlag][d] ? ("V") : ("X")));
                            ShowPlayerDialog(playerid, D_ANTIDM_SETTING, DIALOG_STYLE_LIST, ""I"DM ZONE SETTING", STRING_GLOBAL, "�������", "�������");
                            p_temp[playerid][p_listitem_int] = i;
                            break;
                        }
                    }
                }

            }
            return true;
        }
        case D_ANTIDM_SETTING:
        {
            new idx = p_temp[playerid][p_listitem_int];
            if(!response || idx < 0) return 1;
            AntiDMInfo[idx][dmFlag][listitem] = !AntiDMInfo[idx][dmFlag][listitem];

            STRING_GLOBAL[0] = EOS;
            for(new i; i < MAX_FRACTIONS; i++)
                f(STRING_GLOBAL, "%s%i%s", STRING_GLOBAL, AntiDMInfo[idx][dmFlag][i], i == MAX_FRACTIONS-1 ? "":"|");
            f(STRING_GLOBAL, "UPDATE `antidm_info` SET `flags` = '%s' WHERE `id` = %d", STRING_GLOBAL, AntiDMInfo[idx][dmMysqlID]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            for(new i; i < MAX_FRACTIONS; i++) f(STRING_GLOBAL, "%s"I"[%d]"W" %s [%s]\n",STRING_GLOBAL, i+1, GetFractionName(i),(AntiDMInfo[idx][dmFlag][i] ? ("V") : ("X")));
            ShowPlayerDialog(playerid, D_ANTIDM_SETTING, DIALOG_STYLE_LIST, ""I"DM ZONE SETTING", STRING_GLOBAL, "�������", "�������");

            SendInfo(playerid, "%s ������ %s ������� � ���� ����", GetFractionName(listitem), AntiDMInfo[idx][dmFlag][listitem] ? "�����" : "�� �����");

            STRING_GLOBAL[0] = EOS;
            new count;
            for(new i; i < MAX_FRACTIONS; i++)
            {
                if(AntiDMInfo[idx][dmFlag][i] == 1)
                {
                    f(STRING_GLOBAL,"%s"W"[%d]"I" %s\n", STRING_GLOBAL, count+1, GetFractionName(i));
                    count++;
                }
            }
            if(!count) strcat(STRING_GLOBAL,"[ ������� ���� ]\n����� ��������� �������");
            else f(STRING_GLOBAL, "[ ������� ���� ]\n����� ��������� ������� ������:\n%s", STRING_GLOBAL);
            UpdateDynamic3DTextLabelText(AntiDMInfo[idx][dm3DLabel], COLOR_MAIN, STRING_GLOBAL);
            return true;
        }
        case D_ANTIDM_CREATE_TYPE:
        {
            if(!response) return 1;
            if(count_antidm >= MAX_ANTI_DM_ZONE) return SendError(playerid, "������� ������������ ���������� ANTI-DM ���.");
            p_temp[playerid][p_listitem][0] = listitem;
            if(!listitem)
            {
                AntiDMInfo[count_antidm][dmType] = 0;
                ShowPlayerDialog(playerid, D_ANTIDM_CREATE_RADIUS, DIALOG_STYLE_INPUT, ""I"������ ZZ", "������� ������ �������� ��", "������", "������");
            }
            else
            {
                AntiDMInfo[count_antidm][dmType] = 1;
                p_temp[playerid][p_listitem_int] = STATUS_ANTIDM_POS1;
                SendInfo(playerid, "������� /dmpos �� ����� ���� � ��� 45 �������� � ������(!!!)");
            }
            return 1;
        }
        case D_ANTIDM_CREATE_RADIUS:
        {
            if(!response) return 1;
            if(AntiDMZone(playerid) == 1) return SendError(playerid, "����� ��� ����������� ���� �� ����.");
            if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_ANTIDM_CREATE_RADIUS, DIALOG_STYLE_INPUT, ""I"������ ZZ", "������� ������ �������� ��", "������", "������");
            new radius = strval(inputtext);
            if(!( 1 <= radius <= 350))
            {
                SendError(playerid, "������ ������ ���� �� ������ 1 � �� ������ 350.");
                return ShowPlayerDialog(playerid, D_ANTIDM_CREATE_RADIUS, DIALOG_STYLE_INPUT, ""I"������ ZZ", "������� ������ �������� ��", "������", "������");
            }
            new Float:pPos_x, Float:pPos_y, Float:pPos_z;
            GetPlayerPos(playerid, pPos_x, pPos_y, pPos_z);
            new object_anti_dm = CreateDynamicObject(19973, pPos_x+(random(1)), pPos_y+random(1), pPos_z-1.2, 0.0, 0.0, 0.0);
            EditDynamicObject(playerid, object_anti_dm);
            p_temp[playerid][p_listitem_int] = STATUS_ANTIDM_OBJECT;
            AntiDMInfo[count_antidm][dmRadius] = radius;
            return 1;
        }
        case D_MDC_RECORD_LIST:
        {
            if(!response) return 1;
            STRING_GLOBAL[0] = EOS;
            if(listitem == 0 && p_temp[playerid][list_type])
            {
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `criminalrecords` WHERE `userid`= %i AND `id` > %i LIMIT %i", GetPVarInt(playerid, #MDC_ID), p_temp[playerid][p_listitem][0], MAX_TICKETS);
                mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayersRecords", "ii", playerid, 1);
                p_temp[playerid][list_type]--;
                return 1;
            }
            else if((listitem == MAX_TICKETS + 1 && p_temp[playerid][list_type]) || (listitem == MAX_TICKETS && !p_temp[playerid][list_type]))
            {
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `criminalrecords` WHERE `userid`= %i AND `id` < %i ORDER BY `id` DESC LIMIT %i", GetPVarInt(playerid, #MDC_ID), p_temp[playerid][p_listitem][MAX_TICKETS-1], MAX_TICKETS);
                mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayersRecords", "ii", playerid, 0);
                p_temp[playerid][list_type]++;
                return 1;
            }
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT *, (SELECT `name` FROM `accounts` WHERE id =criminalrecords.userid) as ownername FROM `criminalrecords` WHERE `userid`=%i AND `id`=%i LIMIT 1",
                GetPVarInt(playerid, #MDC_ID),
                (!p_temp[playerid][list_type])?(p_temp[playerid][p_listitem][listitem]):(p_temp[playerid][p_listitem][listitem-1]));
            mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayerRecord", "i", playerid);
            return 1;
        }
        case D_VEHICLE_FINES:
        {
            if(!response) return 1;
            new vehicleid;
            if(IsPlayerFractionPolice(playerid) && p_info[playerid][fwork] == true && GetPVarInt(playerid, #ticketsuse))
                vehicleid = GetPVarInt(playerid, #tickets_show);
            else
            {
                if(!IsPlayerInAnyVehicle(playerid))
                    return SendError(playerid, "�� �� � ����������.");
                vehicleid = GetPlayerVehicleID(playerid);
                if(!IsPlayerOwnerVehicle(playerid, vehicleid))
                    return SendError(playerid, "�� �� �������� ����� ����������.");
            }

            STRING_GLOBAL[0] = EOS;
            if(listitem == 0 && p_temp[playerid][list_type])
            {
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `tickets` WHERE `vehicle`=%i AND `paid` = 0 AND `id` > %i LIMIT %i", veh_info[vehicleid][v_mysql_id], p_temp[playerid][p_listitem][0], MAX_TICKETS);
                mysql_tquery(con_bd, STRING_GLOBAL, "ShowCarsTickets", "ii", playerid, 1);
                p_temp[playerid][list_type]--;
                return 1;
            }

            else if((listitem == MAX_TICKETS + 1 && p_temp[playerid][list_type]) || (listitem == MAX_TICKETS && !p_temp[playerid][list_type]))
            {
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `tickets` WHERE `vehicle`=%i AND `paid` = 0 AND `id` < %i ORDER BY `id` DESC LIMIT %i", veh_info[vehicleid][v_mysql_id], p_temp[playerid][p_listitem][MAX_TICKETS-1], MAX_TICKETS);
                mysql_tquery(con_bd, STRING_GLOBAL, "ShowCarsTickets", "ii", playerid, 0);
                p_temp[playerid][list_type]++;
                return 1;
            }

            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `tickets` WHERE `vehicle`=%i AND `id`= %i LIMIT 1",
                veh_info[vehicleid][v_mysql_id],
                (!p_temp[playerid][list_type]) ? (p_temp[playerid][p_listitem][listitem]):(p_temp[playerid][p_listitem][listitem-1]));
            mysql_tquery(con_bd, STRING_GLOBAL, "ShowCarTicket", "i", playerid);

            return 1;
        }
        case D_VEHICLE_FINES_TAKE:
        {
            if(!response)
            {
                if(IsPlayerFractionPolice(playerid) && p_info[playerid][fwork] == true && GetPVarInt(playerid, #ticketsuse))
                    return callcmd::checkvfines(playerid, "/0");
                else return callcmd::vtickets(playerid, "/0");
            }
            new vehicleid = GetPlayerVehicleID(playerid);
            if(vehicleid == 0) return SendError(playerid, "����� �� � ����������.");
            if(!IsPlayerOwnerVehicle(playerid, vehicleid)) return SendError(playerid, "�� �� ��������� ���������� ������� ������������� ��������.");

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `tickets` SET `userid`=%i,`vehicle`=0 WHERE `id`=%i", p_info[playerid][ID], p_temp[playerid][p_listitem_int]);
            mysql_tquery(con_bd, STRING_GLOBAL, "VehicleFineTook", "i", playerid);

            for(new i = 0; i < MAX_TICKETS; i++) p_temp[playerid][p_listitem][i] = 0;
            return 1;
        }
        case D_PLAYER_FINES:
        {
            if(!response) return p_temp[playerid][ATM_STATUS] = false;

            new userid;
            if(IsPlayerFractionPolice(playerid) && p_info[playerid][fwork] == true && GetPVarInt(playerid, #ticketsuse))
                userid = GetPVarInt(playerid, #tickets_show);
            else userid = p_info[playerid][ID];

            STRING_GLOBAL[0] = EOS;
            if(listitem == 0 && p_temp[playerid][list_type])
            {
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `tickets` WHERE `userid`=%i AND `paid` = 0 AND `id` > %i LIMIT %i", userid, p_temp[playerid][p_listitem][0], MAX_TICKETS);
                mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayersTickets", "ii", playerid, 1);
                p_temp[playerid][list_type]--;
                return 1;
            }
            else if((listitem == MAX_TICKETS + 1 && p_temp[playerid][list_type]) || (listitem == MAX_TICKETS && !p_temp[playerid][list_type]))
            {
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `tickets` WHERE `userid`=%i AND `paid` = 0 AND `id` < %i ORDER BY `id` DESC LIMIT %i", userid, p_temp[playerid][p_listitem][MAX_TICKETS-1], MAX_TICKETS);
                mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayersTickets", "ii", playerid, 0);
                p_temp[playerid][list_type]++;
                return 1;
            }
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT *, (SELECT `name` FROM `accounts` WHERE id = tickets.userid) as ownername FROM `tickets` WHERE `userid`=%i AND `id`=%i LIMIT 1",
                userid,
                (!p_temp[playerid][list_type])?(p_temp[playerid][p_listitem][listitem]):(p_temp[playerid][p_listitem][listitem-1]));
            mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayerTicket", "i", playerid);
            return 1;
        }
        case D_PLAYER_FINES_PAY:
        {
            if(!response)
            {
                p_temp[playerid][ATM_STATUS] = false;
                if(IsPlayerFractionPolice(playerid) && p_info[playerid][fwork] == true && GetPVarInt(playerid, #ticketsuse))
                    return callcmd::checkfines(playerid, "/0");
                else return callcmd::tickets(playerid, "/0");
            }
            if(p_temp[playerid][ATM_STATUS] != true) return 1;
            //if(!Bank_Nearest(playerid)) return SendError(playerid, "��� ������ ������ �� ������ ���������� � �����.");
            if(p_info[playerid][cash] < p_temp[playerid][p_listitem][0])
                return SendError(playerid, "� ��� ��� ������� ����� ��� ������ ������, ��������� %d$. ����������� /donate", p_temp[playerid][p_listitem][0]);

            SendAccess(playerid, "�� �������� ����� ������ $%i.", p_temp[playerid][p_listitem][0]);
            SendInfo(playerid, "� ��� ��� �������� ������������ ������ - %i.", CountPlayerTickets(playerid)-1);
            SetPlayerMoney(playerid, -p_temp[playerid][p_listitem][0], true, "������� �����");

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `tickets` SET `paid` = 1 WHERE `id` = %i", p_temp[playerid][p_listitem_int]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            p_temp[playerid][ATM_STATUS] = false;
            return 1;
        }
        ///////////////////////
        case D_DIALOG_LIST_TYPE:
        {
            if(p_temp[playerid][list_type] == LIST_ID_GHETTO_PC) return 1;
            if(!response)
            {
                for(new i; i < 25; i ++) p_temp[playerid][p_listitem][i] = -1;
                switch(p_temp[playerid][list_type])
                {
                    case LIST_ID_FAMILY_BLACKLIST: callcmd::fblacklist(playerid, "/0");
                    case LIST_ID_FAMILY_OFFLINE_MEMBERS: callcmd::family(playerid, "/0");
                    case LIST_ID_PROMOCODE: ShowDialogPromocode(playerid, PROMOCODE_CONTROL);
                    case LIST_ID_DONATE_HISTORY: callcmd::donate(playerid, "/0");
                    case LIST_ID_MARKET_SELL_ITEMS, LIST_ID_MARKET_BUY_INV, LIST_ID_MARKET_BUY_ACC, LIST_ID_MARKET_BUY_SKIN:
                    {
                        if(p_temp[playerid][market_arend] != -1) ShowPlayerControlMarket(playerid);
                    }
                    case LIST_ID_HOT_DEALS_SMALL_SIZED: ShowPlayerDonate(playerid, DONATE_TYPE_MENU);
                }
                return 1;
            }
            switch(listitem)
            {
                case 0:
                {
                    new page_id = p_temp[playerid][list_page]-1;
                    if(page_id == 0) SendError(playerid, "�� ���������� �� ������ ��������.");
                    else p_temp[playerid][list_page] = page_id;
                    UpdatePlayerList(playerid);
                }
                case 1:
                {
                    p_temp[playerid][list_page]++;
                    UpdatePlayerList(playerid);
                }
                default:
                {
                    listitem -= 2;
                    switch(p_temp[playerid][list_type])
                    {
                        case LIST_ID_SERVER_FORUM:
                        {
                            if(!(0 <= listitem < 25))  return SendError(playerid, "��������� �� ��������� ������. AC-0503");
                            if(listitem == -1) return 1;
                            new newsID = p_temp[playerid][p_listitem][listitem];
                            if(newsID <= 0) return SendError(playerid, "ID ������� �� ���������.");
                            new IsView = p_temp[playerid][p_listitem][LIST_OFFSET_MAX+listitem];
                            p_temp[playerid][p_listitem_int] = listitem;
                            if(IsView == -1)
                            {
                                STRING_GLOBAL[0] = EOS;
                                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `server_forum_stats` (`userid`, `newsid`, `rating`) VALUES (%d, %d, '0')",
                                    p_info[playerid][ID], newsID);
                                mysql_tquery(con_bd, STRING_GLOBAL, "OnUpdateSFNewsCallback", "iii", playerid, p_info[playerid][ID], newsID);
                            }
                            else OnLoadSFNews(playerid, newsID);
                            return 1;
                        }
                        case LIST_ID_HOT_DEALS_SMALL_SIZED:
                        {
                            if(!(0 <= listitem < 25))  return SendError(playerid, "��������� �� ��������� ������. AC-0502");
                            PlayerDonateBuy(playerid, listitem);
                            return 1;
                        }
                        case LIST_ID_MARKET_BUY_INV, LIST_ID_MARKET_BUY_ACC, LIST_ID_MARKET_BUY_SKIN:
                        {
                            if(p_temp[playerid][market_arend] == -1) return SendError(playerid, "�� �� ��������� ����������� ����� ���� �������.");
                            if(!(0 <= listitem < 25)) return SendError(playerid, "��������� �� ��������� ������. AC-1811");
                            if(listitem == -1) return 1;
                            new itemID = p_temp[playerid][p_listitem][listitem];
                            if(itemID <= 0) return SendError(playerid, "������� �� ���������.");
                            new i = GetIDMarketBuyItem(playerid, itemID);
