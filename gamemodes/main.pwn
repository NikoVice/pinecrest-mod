GetSurnameNick(playerid)
{
    new surname[MAX_PLAYER_NAME];
    strcat(surname, get_name(playerid));

    strdel(surname, 1, strfind(surname, "_"));
    strins(surname, ".", 1);
    return surname;
}

public OnUnoccupiedVehicleUpdate(vehicleid, playerid, passenger_seat, Float:new_x, Float:new_y, Float:new_z, Float:vel_x, Float:vel_y, Float:vel_z)
{
    if(IsValidVehicle(vehicleid))
    {
        if(veh_info[vehicleid][v_npoType] == NPO_CAR_FACTORY && veh_info[vehicleid][v_npoId] == JOB_CAR_FACTORY) return 0;
    }
    return 1;
}

GetVehicleName(vehicleid, model_id = 212)
{
    new vehicleName[36];
    if(vehicleid == INVALID_VEHICLE_ID)
    {
        if(model_id <= 611)
        {
            if(model_id >= 400) model_id -= 400;
            strunpack(vehicleName, gVehicleNames[model_id]);
        }
        else
        {
            new custom_id = GetSlotVehicleModelSync(model_id);
            if(custom_id == -1) strunpack(vehicleName, gVehicleNames[212]);
            else strunpack(vehicleName, customVehModels[custom_id][ModelName]);
        }
    }
    else
    {
        model_id = GetVehicleModelEx(vehicleid);
        if(400 < model_id) strunpack(vehicleName, gVehicleNames[212]);
        if(400 <= model_id <= 611) strunpack(vehicleName, gVehicleNames[model_id-400]);
        if(model_id > 611)
        {
            new custom_id = GetSlotVehicleModelSync(model_id);
            if(custom_id == -1) strunpack(vehicleName, gVehicleNames[212]);
            else strunpack(vehicleName, customVehModels[custom_id][ModelName]);
        }
    }
    return vehicleName;
}

GetVehicleData(vidx, E_VEHICLE_INFO:typeID)
{
    if(vidx <= 611)
    {
        if(vidx >= 400) vidx -= 400;
    }
    else
    {
        new custom_id = GetSlotVehicleModelSync(vidx);
        if(custom_id == -1) return -1;
        vidx = 212+custom_id;
    }
    switch(typeID)
    {
        case E_VD_ID:
            return gVehicleData[vidx][E_VD_ID];
        case E_VD_PRICE:
            return gVehicleData[vidx][E_VD_PRICE];
        case E_VD_MAX_SPEED:
            return gVehicleData[vidx][E_VD_MAX_SPEED];
        case E_VD_MAX_FUEL:
            return gVehicleData[vidx][E_VD_MAX_FUEL];
        case E_VD_CLASS:
            return gVehicleData[vidx][E_VD_CLASS];
        case E_VD_TYPE:
            return gVehicleData[vidx][E_VD_TYPE];
    }
    return -1;
}

GetVehicleModelEx(vehicleid)
{
    if(vehicleid == INVALID_VEHICLE_ID || !(1 <= vehicleid < MAX_VEHICLES) || veh_info[vehicleid][v_model] == 0) return 400;
    return veh_info[vehicleid][v_model];
}


//CMD: VEHICLE CUSTOM TUNE
cmd:shadow(playerid, params[])
{
    if(SRV_ID) return 1;
    new texture_name[64];
    if(sscanf(params, "iiiiis", params[0], params[1], params[2], params[3], params[4], texture_name)) return SendInfo(playerid, "�����������: /shadow value1 value2 value3");
    SetVehicleShadowParams(GetPlayerVehicleID(playerid), params[0], params[1], params[2], params[3], params[4], texture_name);
    SendAccess(playerid, "sizeX %d sizeY %d r:%d g:%d b:%d texture: %s", params[0], params[1], params[2], params[3], params[4], texture_name);
    return 1;
}

cmd:neon(playerid)
{
    if(SRV_ID) return 1;
    SetVehicleShadowParams(GetPlayerVehicleID(playerid), 6, 7, 255, 255, 10, "coronastar");
    return 1;
}

CMD:toner(playerid, params[])
{
    if(SRV_ID) return 1;
    new slot2;
    if(sscanf(params, "i",slot2)) return SendInfo(playerid, "�����������: /toner 1-20");
    new vehicleidD = GetPlayerVehicleID(playerid);
    SetVehicleToner(vehicleidD, slot2);
    SendAccess(playerid, "�� ���������� ��������� ID: %d",slot2);
    return 1;
}

cmd:setvv(playerid, params[0])
{
    if(SRV_ID) return 1;
    if(sscanf(params, "ii", params[0], params[1])) return SendInfo(playerid, "�����������: /setvv value1 value2");
    SetPlayerVirtualWorld(playerid, params[0]);
    SetPlayerInterior(playerid, params[1]);
    return 1;
}

forward GetTicketsInfo_Callback(playerid);
public GetTicketsInfo_Callback(playerid)
{
    new bool:is_null;
    cache_is_value_index_null(0, 0, is_null);
    if(is_null)
        return SendError(playerid, "� ��� ��� �� ���������� ������� � ���� ������.");

    cache_get_value_index_int(0, 0, p_temp[playerid][p_listitem][45]);
    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, ""I"[1]"W" �������� ��� ������: %d$.\n"I"[2]"W" ���� ������: ���������..", p_temp[playerid][p_listitem][45]);
    ShowPlayerDialog(playerid, D_PLAYER_FINES_MENU, DIALOG_STYLE_LIST, ""I"������", STRING_GLOBAL, "��������", "������");
    return 1;
}

CMD:tdtest(playerid, params[])
{
    if(SRV_ID) return 1;
    new Text:td_create;

    td_create = TextDrawCreate(40.0, 200.0, " ");
    TextDrawFont(td_create, TEXT_DRAW_FONT_MODEL_PREVIEW);
    TextDrawColor(td_create, -1);
    TextDrawBackgroundColor(td_create, 0x131313FF);
    TextDrawTextSize(td_create, 50.0, 50.0);
    TextDrawSetPreviewModel(td_create, strval(params));
    TextDrawSetPreviewRot(td_create, -16.0, 0.0, -45.0, 1.0);
    TextDrawSetSelectable(td_create, true);

    TextDrawShowForPlayer(playerid, td_create);
    return 1;
}

cmd:realcars(playerid, params[])
{
    if(SRV_ID) return 1;
    new Float:x = 412.7909,
        Float:y = 2510.6228,
        Float:z = 16.6844,
        Float:rz = 180.0;

    for(new i; i < MAX_VEH_MODELS_REPLACE; i++)
    {
        //if( customVehModels[i][CustomID] == 4544) continue;
        x = x - 4.0 * floatsin(rz-90.0, degrees);
        y = y + 4.0 * floatcos(rz-90.0, degrees);

        new car = CreateVehicleVEx(NPO_NONE, NPO_NONE, customVehModels[i][CustomID], x, y, z, rz, 1, 1, 600);
        LinkVehicleToInterior(car, 0);
        veh_info[car][v_admin] = 1;
        veh_info[car][v_lock] = 0;
        veh_info[car][v_fuel] = 40;

        /*f(STRING_GLOBAL, "ID: %d | SAMP_ID: %d\n%s", customVehModels[i][CustomID], customVehModels[i][ModelID], customVehModels[i][ModelName]);
        CreateDynamic3DTextLabel(STRING_GLOBAL, -1, x, y, z+1.0, 20.0);*/
    }
    //foreach(new i: Player) p_temp[i][mobile_hash] = 1;
    //callcmd::magic(playerid, "/0");
    return 1;
}

cmd:magic(playerid, params[])
{
    if(SRV_ID) return 1;
    new Float:x = 412.7909,
        Float:y = 2510.6228,
        Float:z = 16.6844,
        Float:rz = 180.0, Float:x2, Float:y2;

    x += 8.0 * floatsin(-rz, degrees); //�������� �� � ������!
    y += 8.0 * floatcos(-rz, degrees); //�������� �� Y ������! � ������� ���� �������(!)
    z += 0.5;

    x2 = x;
    y2 = y;

    x2 -= (4.0*MAX_VEH_MODELS_REPLACE) * floatsin(-rz-90, degrees);
    y2 += (4.0*MAX_VEH_MODELS_REPLACE) * floatcos(-rz-90, degrees);
    InterpolateCameraPos(playerid,x,y,z,x2,y2,z, 43000);

    x2 -= 8.0 * floatsin(-rz, degrees); //�������� �� � ������!
    y2 -= 8.0 * floatcos(-rz, degrees); //�������� �� Y ������! � ������� ���� �������(!)
    InterpolateCameraLookAt(playerid,x,y,z, x2,y2,z, 43000);
    return 1;
}

