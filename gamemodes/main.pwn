Interface_WarningActual(playerid)
{
    SendInfo(playerid, "Если у Вас что-то не отображается, введите /interface для ознакомления.");
}
CMD:interface(playerid, params[])
{
    if(p_info[playerid][p_settings][INTERFACE])
    {
        if(p_temp[playerid][TextDrawCase]) return HideTextDrawForPlayer(playerid, TD_ID_CASE);
        if(p_temp[playerid][TextDrawPhone]) return HideTextDrawForPlayer(playerid, TD_ID_PHONE);
        if(p_temp[playerid][TextDrawRoulette]) return HideTextDrawForPlayer(playerid, TD_ID_ROULETTE);
        if(p_temp[playerid][TextDrawPlayerMenu]) return HideTextDrawForPlayer(playerid, TD_ID_PLAYER_MENU);
        if(p_temp[playerid][TextDrawServiceTune]) return  HideTextDrawForPlayer(playerid, TD_ID_SERVICE_TUNE);
        if(p_temp[playerid][TextDrawTrade])
        {
            HideTextDrawForPlayer(playerid, TD_ID_TRADE);
            return callcmd::stopex(playerid, "/0");
        }
    }
    if(IsPlayerMobile(playerid))
    {
        if(GetPlayerGameVersion(playerid) < CLIENT_VERSION_052021)
            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Информация", ""W"\
                У Вас {"#cLIGHTRED"}старая версия клиента,"W" для отображения новых интерфейсов необходимо\n\
                {"#cLIGHTRED"}обновить клиент"W" до последенй версии.\n\n\
                Для обновления клиента, воспользуйтесь последней версией лаунчера и нажмите\n\
                {"#cGREEN"}\"Переустановить игру\".", "ОК", "");
        else ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Информация", ""W"\
                Для корректного отображениях новых интерфейсов необходимо {"#cLIGHTRED"}обновить клиент"W" до\n\
                последней версии.\n\n\
                Для обновления клиента, воспользуйтесь последней версией лаунчера и нажмите\n\
                {"#cGREEN"}\"Обновить клиент\".", "ОК", "");
    }
    else ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Информация", ""W"\
            Для корректного отображения новых интерфейсов необходимо {"#cLIGHTRED"}скачать дополнительный\n\
            файл."W"\n\n\
            Чтобы скачать файл, необходимо перейти по ссылке: {"#cGREEN"}pinecrest-rp.com/pc"W"\n\n\
            После скачивания файла, {"#cLIGHTRED"}запустите его от имени администратора"W" и следуйте подсказкам\n\
            на экране.", "ОК", "");
    return 1;
}
GetSurnameNick(playerid)
{
    new surname[MAX_PLAYER_NAME];
    strcat(surname, get_name(playerid));

    strdel(surname, 1, strfind(surname, "_"));
    strins(surname, ".", 1);
    return surname;
}

public OnUnoccupiedVehicleUpdate(vehicleid, playerid, passenger_seat, Float:new_x, Float:new_y, Float:new_z, Float:vel_x, Float:vel_y, Float:vel_z)
{
    if(IsValidVehicle(vehicleid))
    {
        if(veh_info[vehicleid][v_npoType] == NPO_CAR_FACTORY && veh_info[vehicleid][v_npoId] == JOB_CAR_FACTORY) return 0;
    }
    return 1;
}

GetVehicleName(vehicleid, model_id = 212)
{
    new vehicleName[36];
    if(vehicleid == INVALID_VEHICLE_ID)
    {
        if(model_id <= 611)
        {
            if(model_id >= 400) model_id -= 400;
            strunpack(vehicleName, gVehicleNames[model_id]);
        }
        else
        {
            new custom_id = GetSlotVehicleModelSync(model_id);
            if(custom_id == -1) strunpack(vehicleName, gVehicleNames[212]);
            else strunpack(vehicleName, customVehModels[custom_id][ModelName]);
        }
    }
    else
    {
        model_id = GetVehicleModelEx(vehicleid);
        if(400 < model_id) strunpack(vehicleName, gVehicleNames[212]);
        if(400 <= model_id <= 611) strunpack(vehicleName, gVehicleNames[model_id-400]);
        if(model_id > 611)
        {
            new custom_id = GetSlotVehicleModelSync(model_id);
            if(custom_id == -1) strunpack(vehicleName, gVehicleNames[212]);
            else strunpack(vehicleName, customVehModels[custom_id][ModelName]);
        }
    }
    return vehicleName;
}

GetVehicleData(vidx, E_VEHICLE_INFO:typeID)
{
    if(vidx <= 611)
    {
        if(vidx >= 400) vidx -= 400;
    }
    else
    {
        new custom_id = GetSlotVehicleModelSync(vidx);
        if(custom_id == -1) return -1;
        vidx = 212+custom_id;
    }
    switch(typeID)
    {
        case E_VD_ID:
            return gVehicleData[vidx][E_VD_ID];
        case E_VD_PRICE:
            return gVehicleData[vidx][E_VD_PRICE];
        case E_VD_MAX_SPEED:
            return gVehicleData[vidx][E_VD_MAX_SPEED];
        case E_VD_MAX_FUEL:
            return gVehicleData[vidx][E_VD_MAX_FUEL];
        case E_VD_CLASS:
            return gVehicleData[vidx][E_VD_CLASS];
        case E_VD_TYPE:
            return gVehicleData[vidx][E_VD_TYPE];
    }
    return -1;
}

GetVehicleModelEx(vehicleid)
{
    if(vehicleid == INVALID_VEHICLE_ID || !(1 <= vehicleid < MAX_VEHICLES) || veh_info[vehicleid][v_model] == 0) return 400;
    return veh_info[vehicleid][v_model];
}


