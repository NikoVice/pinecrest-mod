            inputtext);
            mysql_tquery(con_bd, STRING_GLOBAL, "DeletePromo", "is", playerid, inputtext);
        }
        case D_PROMO_CREATE:
        {
            if(!response)
            {
                ShowPlayerDialog(playerid,D_PROMO,DIALOG_STYLE_LIST, ""I"Меню","\
                "I"[1]"W" Создать промокод \n\
                "I"[2]"W" Действующие промокоды \n\
                "I"[3]"W" Активированные промокоды \n\
                "I"[4]"W" Заблокированные промокоды \n\
                "I"[5]"W" Заблокировать промокод \n\
                "I"[6]"W" Удалить промокод", "Далее", "Выход");
                return 1;
            }
            STRING_GLOBAL[0] = EOS;
            if(strlen(inputtext) < 3 || strlen(inputtext) > 12) return ShowPlayerDialog(playerid,D_PROMO_CREATE,DIALOG_STYLE_INPUT, ""I"Создание промокода | Шаг: 1",""W"Вам необходимо придумать промокод\nДлина промокода должна быть от 3 до 12 символов, состоящая из цифр и букв латинского алфавита\n\nВведите промокод в строчку ниже:","Далее","Назад");

            format(p_temp[playerid][PROMO],24, "%s", inputtext);

            strcat(STRING_GLOBAL,""W"Теперь необходимо ввести тип приза, количество выигрыша, количество активаций\n\n{4AA9CF}Типы:\n");
            strcat(STRING_GLOBAL,""W"1. Опыт (EXP)\n");
            strcat(STRING_GLOBAL,"2. Игровая валюта\n");
            strcat(STRING_GLOBAL,"3. Pinecrest Money\n");
            strcat(STRING_GLOBAL,"4. Транспортное средство\n\n");
            strcat(STRING_GLOBAL,"Если указан тип '1', то в качестве количества приза - количество EXP\n");
            strcat(STRING_GLOBAL,"Если указаны типы '2' и '3', то соответственно указываете количество игровой валюты, и FM для выигрыша.\n");
            strcat(STRING_GLOBAL,"Если указан тип '4', то соответственно указываете ID транспортного средства.\n\n");
            strcat(STRING_GLOBAL,"{F6F7D8}Указывать все значения нужно через запятую!\n");
            strcat(STRING_GLOBAL,"Пример: 1,30,10\n");
            strcat(STRING_GLOBAL,"Где 1 - тип приза(Опыт), 3 - количество ЕХР, 10 - число доступных активаций промокода");
            ShowPlayerDialog(playerid,D_PROMO_CREATE_2,DIALOG_STYLE_INPUT, ""I"Создание промокода | Шаг: 2",STRING_GLOBAL,"Далее","Назад");
        }
        case D_PROMO_CREATE_2:
        {
            STRING_GLOBAL[0] = EOS;
            if(!response)
            {
                ShowPlayerDialog(playerid,D_PROMO,DIALOG_STYLE_LIST, ""I"Меню","\
                "I"[1]"W" Создать промокод \n\
                "I"[2]"W" Действующие промокоды \n\
                "I"[3]"W" Активированные промокоды \n\
