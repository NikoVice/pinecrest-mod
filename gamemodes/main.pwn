            DeletePVar(playerid, "RA:idx");
            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate.");
            if(InventoryPlayer[playerid][slot_id][inv_acc_wear] >= 100.0) return SendError(playerid, "Аксессуар не нуждается в ремонте.");

            InventoryPlayer[playerid][slot_id][inv_acc_wear] = 100.0;

            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `inventory` SET `acc_wear` = 100.0 WHERE `mysql_id` = %d", InventoryPlayer[playerid][slot_id][inv_mysql_id]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            SendAccess(playerid, "Вы отремонтировали аксессуар \"%s\" за %d$.", ItemsInfo[itemID][iName], price);
            if(b_info[biz_id][_prod] >= (price/5)/100)
            {
                b_info[biz_id][_prod] -= (price/5)/100;
                b_info[biz_id][_bank] += (price/5)-(price/100);
                AddMafiaBank(biz_id, price/100);

                biz_finka[biz_id] += (price/5)-(price/100);
                UpdateIntForFinanceBiz(biz_id, (price/5)-(price/100));
