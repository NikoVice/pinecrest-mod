                */
                // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) авторизовался как администратор 10 уровня
                Log(LOG_player, INFO, "%s[%d](%s %s) авторизовался как администратор %d уровня",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][admin]);

                if(p_info[playerid][admin] >= 5) callcmd::dutydm(playerid, "/0");

                ShowWarningPanelAC(playerid);

                if(ServerInfo[VKSecurity] && !IsVKConfirmed(playerid))
                    SendInfo(playerid, "У Вас не установлена защита ВКонтакте!");

                if(ServerInfo[TGSecurity] && !IsTGConfirmed(playerid))
                    SendInfo(playerid, "У Вас не установлена защита Telegram!");
            }
            else {
                SendInfo(playerid, "Вы авторизовались как ютубер %d уровня.", p_info[playerid][youtube_adm]);

                // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) авторизовался как администратор 10 уровня
                Log(LOG_player, INFO, "%s[%d](%s %s) авторизовался как ютубер-админ %d уровня",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][youtube_adm]);
            }
