                            if(player_lobby_settings[playerid][3] == 0 || player_lobby_settings[playerid][3] == 74) return ShowLobbyCreate(playerid), SendError(playerid, "�� ����� ����������� ID �����.");
                        }
                    }
                    new max_value = 2;
