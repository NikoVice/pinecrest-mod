                    if(GetHouseVideoCards(h) >= GetMaxHouseVideoCards(h)) return SendError(playerid, "В подвале нет места для новой видеокарты.");

                    totalvideocards++;
                    VideoCardsInfo[totalvideocards][vcStatus] = 0;
                    VideoCardsInfo[totalvideocards][vcLevel] = 1;
                    VideoCardsInfo[totalvideocards][vcCoolant] = 0;
                    VideoCardsInfo[totalvideocards][vcTax] = 0;
                    VideoCardsInfo[totalvideocards][vcBitcoin] = 0.0;
                    VideoCardsInfo[totalvideocards][vcHouseIDx] = h;
                    new biz_idx[] = {100, 101, 102};
                    VideoCardsInfo[totalvideocards][vcBizIDx] = biz_idx[random(3)];

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `videocards` (`house`, `biz`) VALUES (%d, %d)",
                    VideoCardsInfo[totalvideocards][vcHouseIDx], VideoCardsInfo[totalvideocards][vcBizIDx]);
                    mysql_tquery(con_bd, STRING_GLOBAL, "create_videocards", "i", totalvideocards);

                    if(b_info[bizid][_prod] >= ((price / 100) * 20) / 100)
                    {
                        b_info[bizid][_prod] -= ((price / 100) * 20) / 100;
                        b_info[bizid][_bank] += ((price / 100) * 20) - ((price / 100) * 2);
                        AddMafiaBank(bizid, (price / 100) * 2);

                        biz_finka[bizid] += ((price / 100) * 20) - ((price / 100) * 2);
                        UpdateIntForFinanceBiz(bizid, ((price / 100) * 20) - ((price / 100) * 2));
                    }

                    vc_warehouse--;
                    if(vc_warehouse < 0) vc_warehouse = 0;
                    MysqlUpdateOtherInt("vc_warehouse", vc_warehouse);

                    OnServerInfoForMoney[10] += price;
                    SetPlayerMoney(playerid, -price, true, "покупка в магазине видеокарт");

                    SendAccess(playerid, "Вы приобрели видеокарту за %d$.", price);
                    SendInfo(playerid, "Для управления видеокартами отправляйтесь в подвал дома.");
                }
