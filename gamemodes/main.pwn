IsPlayerNearDice(playerid)
{
    for(new i; i < sizeof(BoneCoor); i++)
    {
        if(IsPlayerInRangeOfPoint(playerid, 2.5, BoneCoor[i][0], BoneCoor[i][1], BoneCoor[i][2])) return i;
    }
    return -1;
}

SetMoney(playerid, money, visible_3dtext, reason[])
{
    if(playerid == INVALID_PLAYER_ID) return 1;
    if(strlen(reason) != 0 && money != 0)
    {
        // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) <��������> [���� ��������]
        Log(LOG_player, INFO, "%s[%d](%s %s)[%d$] %s | %d$ | #SetPlayerMoney",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
            reason, money);
        if(money > 1000000)
        {
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "[WARNING] [���������] %s[%d] %s.", get_name(playerid), playerid, reason);
            SendAdminMessage(COLOR_RED, STRING_GLOBAL);
        }
    }
    p_info[playerid][cash] += money;
    MysqlUpdatePlayerInt(playerid, "money", p_info[playerid][cash]);

    if(p_info[playerid][cash] < 0)
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s[%d] ������� ������ � ����� ����� %s (!!!)",  get_name(playerid), playerid, reason);
        SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `table_ban` (`Name_Admin`, `Name_Player`, `Ban_Data`, `Unban_Data`, `Ban_Reason`) VALUES ('System', '%e', NOW(), %d, '������ ����� � ����� ����� %e')",
            get_name(playerid), timestamp + (30 * 86400), reason);
        mysql_tquery(con_bd, STRING_GLOBAL);

        Kick(playerid);
    }

    if(p_info[playerid][cash] > 1000000 && p_info[playerid][level] < 3)
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[WARNING] [TWINK-MONEY] %s [%d] LEVEL: %d | MONEY: %d.", get_name(playerid), playerid, p_info[playerid][level], p_info[playerid][cash]);
        SendAdminMessage(COLOR_RED, STRING_GLOBAL);
    }

    /*if(p_info[playerid][cash] > 100000 && p_info[playerid][level] >= 5)
    {
        SendInfo(playerid, "� ��� ������� ���������� �������� ������� �� �����.");
        SendInfo(playerid, "����� ����� ����� ��� ��������.");
        SendInfo(playerid, "����� �� �������� ������� ���������� �������� �������, ���������� �� �� ���������� ����.");
    }*/

    if(visible_3dtext == 1){
        new string[55];
        if(money > 0)
        {
            format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~g~+%d$", money);
            PlayerPlaySound(playerid, 1083, 0.0, 0.0, 0.0);
        }
        else
        {
            format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~r~%d$", money);
            PlayerPlaySound(playerid, 1085 , 0.0, 0.0, 0.0);
        }
        GameTextForPlayer(playerid, string, 1000, 3);
    }

    ResetPlayerMoney(playerid);
    GivePlayerMoney(playerid, p_info[playerid][cash]);
    return 1;
}

PlayStream(playerid, url[], Float:posX = 0.0, Float:posY = 0.0, Float:posZ = 0.0, Float:distance = 100.0, usepos = 0)
{
    if(p_info[playerid][p_settings][STATUS_BOOMBOX] == 1) return 1;
    if(GetPVarInt(playerid, "UseMusic")) return 1;
    if(GetPVarInt(playerid, "UseMusicVehicle")) return 1;
    if(GetPVarType(playerid, "pAudioStream")) StopAudioStreamForPlayer(playerid);
    else SetPVarInt(playerid, "pAudioStream", 1);
    PlayAudioStreamForPlayer(playerid, url, posX, posY, posZ, distance, usepos);
    return 1;
}

StopStream(playerid)
{
    DeletePVar(playerid, "pAudioStream");
    StopAudioStreamForPlayer(playerid);
}

PickUpBoombox(playerid)
{
    foreach(new i:Player)
    {
        if(IsPlayerInDynamicArea(i, p_temp[playerid][music_area]))
        {
            StopStream(i);
        }
    }

    if(p_temp[playerid][music_object] != INVALID_OBJECT_ID) DestroyDynamicObject(p_temp[playerid][music_object]);
    if(p_temp[playerid][music_label] != INVALID_3DTEXT_ID) DestroyDynamic3DTextLabel(p_temp[playerid][music_label]);
    if(p_temp[playerid][music_area] != -1) DestroyDynamicArea(p_temp[playerid][music_area]);
    p_temp[playerid][music_area] = -1;
    p_temp[playerid][music_label] = INVALID_3DTEXT_ID;
    p_temp[playerid][music_object] = INVALID_OBJECT_ID;
    DeletePVar(playerid, "BBStation");
    return 1;
}

CMD:music(playerid, params[])
{
    ShowPlayerDialog(playerid, D_BOOMBOX, DIALOG_STYLE_LIST, ""I"����������� �������������", ""I"[1]"W" ���������\n"I"[2]"W" ��������\n"I"[3]"W" �������", "�����", "������");
    return 1;
}

CMD:dmusic(playerid, params[])
{
    if(p_info[playerid][admin] < 3) return 1;
    foreach(new i: Player)
    {
        if(!p_info[i][loggedIn]) continue;
        if(p_temp[i][music_area] == -1) continue;
        if(IsPlayerInDynamicArea(i, p_temp[playerid][music_area]))
        {
            PickUpBoombox(i);
            break;
        }
    }
    return 1;
}

CMD:radio(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "�� ������ ���������� � ������������ ��������.");
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "�� ������ ���������� �� ����� ��������.");
    if(GetVehicleData(GetVehicleModelEx(GetPlayerVehicleID(playerid)), E_VD_TYPE) == VEHICLE_STATE_VELO_MOPED) return SendError(playerid, "� ������ ������������ �������� ��� �����.");
    ShowPlayerRadio(playerid, RADIO_TYPE_CAR);
    return 1;
}

CMD:play(playerid, params[])
{
    ShowPlayerRadio(playerid, RADIO_TYPE_AIR_PODS);
    return 1;
}

GivePlayerPropertyPayDay(playerid)
{
    new property_id;
    for(new i; i < p_info[playerid][house_slots]; i++)
    {
        property_id = GetPlayerHouseID(playerid, i);
        if(property_id != INVALID_HOUSE_ID && property_id != p_info[playerid][key_h_rent])
            h_info[property_id][h_paydays_received]++;
    }
    for(new i; i < p_info[playerid][bizz_slots]; i++)
    {
        property_id = GetPlayerBizzID(playerid, i);
        if(property_id != INVALID_BIZZ_ID)
            b_info[property_id][b_paydays_received]++;
    }
}

UpdateIntForFinanceBiz(BIZZID, VALUE)
{
    new bizz_info_string[128];
    mysql_format(con_bd, bizz_info_string, sizeof(bizz_info_string), "UPDATE `bizz_finka` SET `day_7` = `day_7` + %d WHERE `bizz_id` = %d", VALUE, BIZZID);
    mysql_tquery(con_bd, bizz_info_string, "", "");
    return 1;
}

ShowPlayerStatsForBizzPay(playerid, bizid)
{
    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "SELECT * FROM `bizz_finka` WHERE `bizz_id` = %d LIMIT 1", bizid);
    mysql_tquery(con_bd, STRING_GLOBAL, "OnLoadStatsBizz", "iii", playerid, bizid, 0);
    return 1;
}

forward OnLoadStatsBizz(playerid, bizz_id, type);
public OnLoadStatsBizz(playerid, bizz_id, type)
{
    STRING_GLOBAL[0] = EOS;
    if(type)
    {
        f(STRING_GLOBAL, ""W"\
            ����� �������: %d\n\
            �������� �������: %s\n\
            ��� �������: %s\n\
            ��������� �������: %d$\n\n", bizz_id, b_info[bizz_id][_name], bizz_type_name[b_info[bizz_id][_tip]], b_info[bizz_id][_price]);
    }

    if(cache_num_rows())
    {
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{FFA500}���������� ������� �� ��������� 7 ����:\n\n", STRING_GLOBAL);

        static const
            month_names[12][9] =
            {
                "������", "�������", "�����", "������", "���", "����",
                "����", "�������", "��������", "�������", "������", "�������"
            },
            month_days[12] ={31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};

        new year, month, day, total_buff;
        getdate(year, month, day);

        if(day >= 7)
        {
            for(new i, buff; i < 7; i++)
            {
                cache_get_value_index_int(0, i+1, buff);
                total_buff += buff;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}%02d %s %04d\t\t{00FF00}%d$\n", STRING_GLOBAL, day-7+i + 1, month_names[month-1], year, buff);
            }
        }
        else
        {
            if(month != 1) month -= 1;
            else
            {
                month = 12;
                year-=1;
            }

            new i = 0,
                d = month_days[month-1] + day-7 + 1,
                last_iter = month_days[month-1]+1,
                buff;

            for(; d < last_iter; i++, d++)
            {
                cache_get_value_index_int(0, i+1, buff);
                total_buff += buff;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}%02d %s %04d\t\t{00FF00}%d$\n", STRING_GLOBAL, d, month_names[month-1], year, buff);//6+2+sizeof(month_names[])-1+4+11
            }

            if(month == 12)
            {
                year++;
                month = 1;
            }
            else month++;
            d = 1;
            last_iter = day;
            for(; d <= last_iter; i++, d++)
            {
                cache_get_value_index_int(0, i+1, buff);
                total_buff += buff;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}%02d %s %04d\t\t{00FF00}%d$\n", STRING_GLOBAL, d, month_names[month-1], year, buff);//6+2+sizeof(month_names[])-1+4+11
            }
        }
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s\n�����: %d$", STRING_GLOBAL, total_buff);
    }
    else strcat(STRING_GLOBAL, "���������� ���.");
    if(!type) ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"���������� ������� �� ������", STRING_GLOBAL, "�������", "");
    else ShowPlayerDialog(playerid, D_EXCHANGE_PREVIEW_INFO, DIALOG_STYLE_MSGBOX, ""I"������", STRING_GLOBAL, "�����", "");
    return 1;
}

ConvertNumber(input_value)
{
    new string_value[64], billions, millions, thousand, units;
    string_value = "ERROR INPUT VALUE";
    if(input_value < -1_999_999_999 || input_value > 1_999_999_999) return string_value;
    if(input_value >= 1_000_000_000)  billions = input_value/1_000_000_000;
    if(input_value >= 1_000_000)      millions = (input_value-billions*1_000_000_000)/1_000_000;
    if(input_value >= 1_000)          thousand = (input_value-(billions*1_000_000_000)-(millions*1_000_000))/1_000;
    units = (input_value-(billions*1_000_000_000)-(millions*1_000_000)-(thousand*1_000));
    if(billions > 0) f(string_value, "%d ���� %d ��� %d ���. %d$ (%d)", billions, millions, thousand, units, input_value);
    else if(millions > 0) f(string_value, "%d ��� %d ���. %d$ (%d$)", millions, thousand, units, input_value);
    else if(thousand > 0) f(string_value, "%d ���. %d$ (%d$)", thousand, units, input_value);
    else f(string_value, "%d$", units);
    return string_value;
}

