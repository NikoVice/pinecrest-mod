            }
            if(IsPlayerInDynamicArea(playerid, rob_house_area[0])) // Вадим;
            {
                if(GetPlayerFamilyID(playerid) == -1 && !gang(playerid) && !mafia(playerid) && !biker(playerid)) return SendError(playerid, "Вы не состоите в семье или нелегальной организации.");
                if(gos(playerid)) return SendError(playerid, "Вы не закончили рабочий день.");
                if(p_info[playerid][level] < 20) return SendError(playerid, "Участвовать в ограблениях можно с 20-ого уровня.");
                ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_1);
                return 1;
            }
            if(IsPlayerInDynamicArea(playerid, rob_house_area[1])) // Владимир;
            {
                if(GetPlayerFamilyID(playerid) == -1 && !gang(playerid) && !mafia(playerid) && !biker(playerid)) return SendError(playerid, "Вы не состоите в семье или нелегальной организации.");
                if(gos(playerid)) return SendError(playerid, "Вы не закончили рабочий день.");
                ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_2);
                return 1;
            }
            if(IsPlayerInDynamicArea(playerid, resources_area[0])) // Шахта;
            {
                p_temp[playerid][change_res_type] = RESOURCES_TYPE_MINE;
                ShowChangeResourcesDialog(playerid, TYPE_CHANGE_RESOURCES_HELP, RESOURCES_TYPE_MINE);
                return 1;
            }
            if(IsPlayerInDynamicArea(playerid, resources_area[1])) // Лесопилка;
            {
                p_temp[playerid][change_res_type] = RESOURCES_TYPE_FARM;
                ShowChangeResourcesDialog(playerid, TYPE_CHANGE_RESOURCES_HELP, RESOURCES_TYPE_FARM);
                return 1;
            }
            if(p_temp[playerid][res_use_idx] != -1 && p_temp[playerid][res_use_type] != -1)
            {
                new res_idx = p_temp[playerid][res_use_idx], type = p_temp[playerid][res_use_type];
                switch(type)
                {
                    case RESOURCES_TYPE_MINE:
                    {
                        if(IsPlayerInDynamicArea(playerid, MineResourcesInfo[res_idx][mArea]))
                        {
                            new job_idx = p_info[playerid][job_block];
                            if(job_idx) return SendError(playerid, "Вам запрещено добывать ресурсы еще %s.", ConvertTime(job_idx));
                            if(p_temp[playerid][res_extraction_timer]) return SendMes(playerid, COLOR_DARKORANGE, "Вы уже добываете ресурсы.");
                            p_temp[playerid][res_extraction_timer] = CheckResourcesShovel(playerid) == -1 ? 20 : 10;
                            ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.100000, 1, 1, 1, 1, 0);
                            return 1;
                        } 
                        else
                        {
                            p_temp[playerid][res_use_idx] = 
                            p_temp[playerid][res_use_type] = -1;
                        }
                    }
                    case RESOURCES_TYPE_FARM:
                    {
                        if(IsPlayerInDynamicArea(playerid, FarmResourcesInfo[res_idx][fArea]))
                        {
                            new job_idx = p_info[playerid][job_block];
                            if(job_idx) return SendError(playerid, "Вам запрещено добывать ресурсы еще %s.", ConvertTime(job_idx));
                            if(p_temp[playerid][res_extraction_timer]) return SendMes(playerid, COLOR_DARKORANGE, "Вы уже добываете ресурсы.");
                            p_temp[playerid][res_extraction_timer] = CheckResourcesShovel(playerid) == -1 ? 20 : 10;
                            ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.100000, 1, 1, 1, 1, 0);
                            return 1;
                        } 
                        else
                        {
                            p_temp[playerid][res_use_idx] = 
                            p_temp[playerid][res_use_type] = -1;
                        }
                    }
                    case RESOURCES_TYPE_H_COTTON, RESOURCES_TYPE_H_LINEN:
                    {
                        if(IsPlayerInDynamicArea(playerid, ResourcesHouseInfo[res_idx][rhArea]))
                        {
                            if(ResourcesHouseInfo[res_idx][rhTime] != 6) return SendError(playerid, "Собрать хлопок можно будет через %d час(-а/-ов).", 6 - ResourcesHouseInfo[res_idx][rhTime]);
                            if(p_temp[playerid][res_extraction_timer]) return SendMes(playerid, COLOR_DARKORANGE, "Вы уже добываете ресурсы.");
                            p_temp[playerid][res_extraction_timer] = CheckResourcesShovel(playerid) == -1 ? 20 : 10;
                            ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.100000, 1, 1, 1, 1, 0);
                            return 1;
                        }
                        else
                        {
                            p_temp[playerid][res_use_idx] = 
                            p_temp[playerid][res_use_type] = -1;
                        }
                    }
                }
                return 1;
            }
            if(p_temp[playerid][farm_use_idx] != -1 && p_temp[playerid][farm_use_type] != -1)
            {
                new farm_idx = p_temp[playerid][farm_use_idx], type = p_temp[playerid][farm_use_type];
                switch(type)
                {
                    case TYPE_FARM_TREE:
                    {
                        if(IsPlayerInDynamicArea(playerid, FarmTreeInfo[farm_idx][ftArea]))
                        {
                            if(p_temp[playerid][farm_extraction_timer]) return SendMes(playerid, COLOR_DARKORANGE, "Вы уже собираете апельсины.");
                            if(GetFarmCount(TYPE_FARM_TREE, farm_idx) == 0) return SendError(playerid, "На дереве больше нет апельсинов, отправляйтесь к другому дереву и продолжайте сбор.");
                            if(p_temp[playerid][FarmCheck] == MAX_FARM_TREE_ORANGE)
                            {
                                SetPlayerGPS(playerid, FarmWarehousePos[0][0], FarmWarehousePos[0][1], FarmWarehousePos[0][2], 5.0);
                                SendMes(playerid, COLOR_SEA_WAVE, "Вы собрали достаточное количество апельсинов, отнесите их на склад.");
                                SendMes(playerid, COLOR_BLUE, "Место обозначено на GPS навигаторе.");
                                return 1;
                            }
                            p_temp[playerid][farm_extraction_timer] = 5;
                            ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.100000, 1, 1, 1, 1, 0);
                            return 1;
                        } else p_temp[playerid][farm_use_idx] = -1, p_temp[playerid][farm_use_type] = -1;
                    }
                    case TYPE_FARM_MILKER:
                    {
                        if(IsPlayerInDynamicArea(playerid, FarmMilkerInfo[farm_idx][fmArea]))
                        {
                            if(p_temp[playerid][farm_extraction_timer]) return SendMes(playerid, COLOR_DARKORANGE, "Вы уже занимаетесь доением коровы.");
                            if(p_temp[playerid][FarmCheck])
                            {
                                SetPlayerGPS(playerid, FarmWarehousePos[1][0], FarmWarehousePos[1][1], FarmWarehousePos[1][2], 5.0);
                                SendMes(playerid, COLOR_SEA_WAVE, "Вы надоили полное ведро молока, отнесите его на склад.");
                                SendMes(playerid, COLOR_BLUE, "Место обозначено на GPS навигаторе.");
                                return 1;
                            }
                            p_temp[playerid][farm_extraction_timer] = 10;
                            ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.100000, 1, 1, 1, 1, 0);
                            return 1;
                        } else p_temp[playerid][farm_use_idx] = -1, p_temp[playerid][farm_use_type] = -1;
                    }
                }
                return 1;
            }
            if(p_temp[playerid][Work_ID] == ROADMAN_WORK)
            {
                if(p_temp[playerid][roadman_use_idx] != -1)
                {
                    new aidx = p_temp[playerid][roadman_use_idx];
                    if(IsPlayerInDynamicArea(playerid, RoadCrashAreasIDx[aidx]))
                    {
                        new vehicleid = p_temp[playerid][rented_veh];
                        if(veh_info[vehicleid][v_roadman_count] == MAX_ROADCRASH_VEHICLE_TRASH) return SendError(playerid, "В транспортном средстве нет места под еще один мешок с мусором.");
                        if(p_temp[playerid][roadman_extraction_timer]) return SendMes(playerid, COLOR_DARKORANGE, "Вы уже собираете мусор.");
                        p_temp[playerid][roadman_extraction_timer] = 10;
                        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.100000, 1, 1, 1, 1, 0);
                        return 1;
                    } else p_temp[playerid][roadman_use_idx] = -1;
                }
                else
                {
                    if(IsPlayerInRangeOfPoint(playerid, 2.5, RoadTrashCoords[0][0], RoadTrashCoords[0][1], RoadTrashCoords[0][2]) ||
                        IsPlayerInRangeOfPoint(playerid, 2.5, RoadTrashCoords[1][0], RoadTrashCoords[1][1], RoadTrashCoords[1][2]) ||
                        IsPlayerInRangeOfPoint(playerid, 2.5, RoadTrashCoords[2][0], RoadTrashCoords[2][1], RoadTrashCoords[2][2]))
                    {
                        new vehicleid = p_temp[playerid][rented_veh];
                        if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "У Вас нет арендованного рабочего транспортного средства.");
                        if(veh_info[vehicleid][v_npoType] != NPO_JOB || veh_info[vehicleid][v_npoId] != JOB_ROADMAN) return SendError(playerid, "У Вас нет арендованного рабочего транспортного средства.");
                        if(!p_temp[playerid][roadman_check]) return SendError(playerid, "У Вас нет мешка с мусором.");

                        p_temp[playerid][roadman_check] = 0;

                        ClearAnimations(playerid);
                        ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);

                        SendMes(playerid, COLOR_BLUE, "Вы выгрузили мешок с мусором, отправляйтесь %s.", veh_info[vehicleid][v_roadman_count] == 0 ? "к месту дорожных работ" : "за новым");

                        new reason_money = GetPlayerMoneySkill(playerid, 858, 12);

                        if(CheckPlayerMaxSalarySkill(playerid, 12, reason_money))
                        {
                            SetPlayerMoney(playerid, reason_money, true, "зарплата ремонт дороги");
                            OnServerInfoForMoney[17] += reason_money;
                            SendMes(playerid, COLOR_LYELLOW, "К Вашей зарплате добавлено: {"#cLIME"}%d$.", reason_money);

                            p_info[playerid][job_skill_salary][12] += reason_money;
                        }
                        else SendError(playerid, "За последний час игры было заработано максимальное количество денежных средств.");

                        if(GetPlayerGiveCasket(200, 5) != -1) GivePlayerCasket(playerid, -1);

                        UpdatePlayerWorkSkill(playerid, 12);

                        CheckPlayerMission(playerid, START_ROADMAN);
                        CheckPlayerMission(playerid, DAILY_ROADMAN);
                        CheckPlayerMission(playerid, ACHIEVEMENT_ROADMAN);

                        CheckPlayerFreelance(playerid, FREELANCE_ROADMAN);
                        CheckPlayerBattlePass(playerid, BATTLEPASS_ROADMAN);

                        UpdateFamilyLevel(playerid);
                        UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_ROADMAN); // Контракты: Ремонтник дорог
                    }
                }
            }
            if(IsPlayerInDynamicArea(playerid, underground_area)) // Ара;
            {
                ShowUndergroundBots(playerid, UNDERGROUND_TYPE_NPC);
                return 1;
            }

            if(1 <= GetPlayerVirtualWorld(playerid) <= 3) callcmd::hospital(playerid, "/0");

            if(HookahAreaStatus[playerid] == true)
            {
                if(HookahSmokeTimer[playerid] > 0) return SendError(playerid, "Вы не можете так часто курить кальян, попробуйте через %d сек.", HookahSmokeTimer[playerid]);
                ApplyAnimation(playerid,"SMOKING","M_smk_drag",4.1,0,0,0,0,0,1);
                HookahSmokeTimer[playerid] = 3;
                if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
                SetPlayerAttachedObject(playerid, 1, 18675, 2, 0.280000, 0.331999, -1.600999, -3.399998, -5.599997, -0.699999, 0.645000, 0.666000, 1.000000);
                return 1;
            }
            if(p_info[playerid][cigarette_status][0] == 1)
            {
                ApplyAnimation(playerid, "SMOKING", "M_smk_drag", 4.1, 0, 0, 0, 0, 0, 1);
                SetPlayerChatBubble(playerid, "+ 5 HP", COLOR_MAIN, 20.0, 10000);
                GameTextForPlayer(playerid, "~b~+ 5 hp", 1000, 1);
                SendInfo(playerid, "Здоровье пополнено на 5.");
                p_info[playerid][pHealth] += 5.0;
                SetPlayerHealth(playerid, p_info[playerid][pHealth]);
                if(p_info[playerid][pHealth] > 100.0)
                {
                    p_info[playerid][pHealth] = 100.0;
                    SetPlayerHealth(playerid, 100.0);
                }
                p_info[playerid][cigarette_status][1]++;
                if(p_info[playerid][cigarette_status][1] >= 5)
                {
                    if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
                    for(new i = 0; i < 2; i++) p_info[playerid][cigarette_status][i] = 0;
                    SendAccess(playerid, "Вы докурили сигарету.");
                }
                return 1;
            }

            new pos_id = p_temp[playerid][market_vehicle_id];
            if(IsPlayerInDynamicArea(playerid, VEHICLE_MARKET_CUBE) && 0 <= pos_id < MAX_CAR_MARKET)
            {
                if(CarMarketInfo[pos_id][cmVehicleIDx] != INVALID_VEHICLE_ID)
                {
                    vehicleid = CarMarketInfo[pos_id][cmVehicleIDx];
                    if(CarMarketInfo[pos_id][cmPrice] > 0)
                    {
                        SetVehiclePos(vehicleid, CarMarketInfo[pos_id][cmPos][0], CarMarketInfo[pos_id][cmPos][1], CarMarketInfo[pos_id][cmPos][2]);
                        SetVehicleZAngle(vehicleid, CarMarketInfo[pos_id][cmPos][3]);

                        if(IsPlayerOwnerVehicle(playerid, vehicleid))
                            return ShowPlayerDialog(playerid, D_CAR_MARKET_UNBET, DIALOG_STYLE_MSGBOX, ""I"Забрать транспортное средство", ""W"Вы действительно хотите забрать транспортное средство с авторынка?\n\n\
                                    {"#cLIGHTRED"}Обратите внимание! Денежные средства за аренду места не возвращаются.", "Да", "Нет");

                        new vehicleupgrade = veh_info[vehicleid][v_twinturbo_data][tt_suspension] + veh_info[vehicleid][v_twinturbo_data][tt_transmission] + veh_info[vehicleid][v_twinturbo_data][tt_turbocharging] + veh_info[vehicleid][v_twinturbo_data][tt_engine];
                        new Float:vehiclemaxspeed = GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_SPEED) * (1.0 + (vehicleupgrade * 0.1));
                        if(vehiclemaxspeed > 270.0) vehiclemaxspeed = 270.0;

                        new insurance_info[64];
                        if(veh_info[vehicleid][v_insurance] == 0) insurance_info = "{"#cLIGHTRED"}Нет"W"";
                        else format(insurance_info, sizeof(insurance_info), "{"#cGREEN"}Есть"W" [%d час(-а/-ов)]", veh_info[vehicleid][v_insurance_time]);

                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, ""W"\
                            Технический паспорт:\n\n\
                            Модель: %s\n\
                            Номерной знак: %s\n\
                            Страховка: %s", GetVehicleName(vehicleid), veh_info[vehicleid][v_number], insurance_info);
                        f(STRING_GLOBAL, "%s\n\n"W"\
                            Технические характеристики:\n\n\
                            Подвеска: %d из 3\n\
                            Трансмиссия: %d из 3\n\
                            Турбонаддув: %d из 3\n\
                            Двигатель: %d из 3\n\n\
                            Состояние стартера: %.1f\n\
                            Состояние аккумулятора: %.1f\n\
                            Состояние топливной системы: %.1f\n\
                            Состояние сцепления: %.1f\n\
                            Состояние двигателя: %.1f\n\n\
                            Макс. скорость: %d KM/H\n\
                            Макс. скорость с тюнингом: %d KM/H\n\
                            Премиум: %s\n\n\
                            Стоимость: %d$\n\n\
                            Вы действительно хотите приобрести данное транспортное средство?", STRING_GLOBAL,
                            veh_info[vehicleid][v_twinturbo_data][tt_suspension],veh_info[vehicleid][v_twinturbo_data][tt_transmission],
                            veh_info[vehicleid][v_twinturbo_data][tt_turbocharging],veh_info[vehicleid][v_twinturbo_data][tt_engine],
                            veh_info[vehicleid][v_details][0], veh_info[vehicleid][v_details][1], veh_info[vehicleid][v_details][2],
                            veh_info[vehicleid][v_details][3], veh_info[vehicleid][v_details][4],
                            floatround(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_SPEED)),
                            floatround(vehiclemaxspeed), (veh_info[vehicleid][v_premium] == 1) ? ("{"#cGREEN"}Есть"W"") : ("{"#cLIGHTRED"}Нет"W""),
                            CarMarketInfo[pos_id][cmPrice]);
                        ShowPlayerDialog(playerid, D_CAR_MARKET_BUY, DIALOG_STYLE_MSGBOX, ""I"Рынок: Транспорт", STRING_GLOBAL, "Выбрать", "Отмена");
                    }
                }
                return 1;
            }
            if(GetPVarInt(playerid, "LoadBreak") != 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
            {
                if(GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0) return SendError(playerid, "Данную функцию нельзя использовать в интерьере.");
                new i = GetPVarInt(playerid, "LoadBreak")-1, listitem = GetPVarInt(playerid, "LoadBreakListitem"), idx = GetPVarInt(playerid, "BreakObject");
                //if(idx == 2899) return SendError(playerid, "Возможность установки шипов временно не доступна.");
                DestroyObject(BreakObject[playerid][i]);
                DeletePVar(playerid, "LoadBreak");
                DeletePVar(playerid, "LoadBreakListitem");
                DeletePVar(playerid, "BreakObject");
                new Float:PlPos[4];
                GetPlayerPos(playerid, PlPos[0], PlPos[1], PlPos[2]);
                GetPlayerFacingAngle(playerid, PlPos[3]);
                BreakObject[playerid][i] = CreateDynamicObject(idx, PlPos[0]+floatcos(PlPos[3]+90, degrees), PlPos[1]+floatsin(PlPos[3]+90, degrees), PlPos[2] - BreakListCoord[listitem], 0, 0, PlPos[3]+90, -1, -1, -1, 120.00, 120.00);
                if(idx == 2899)
                {
                    BreakAreas[playerid][i] = CreateDynamicSphere(PlPos[0]+floatcos(PlPos[3]+90, degrees), PlPos[1]+floatsin(PlPos[3]+90, degrees), PlPos[2] - BreakListCoord[listitem], 3.4, -1, -1, -1);
                    UpdateAreaInfo(BreakAreas[playerid][i], TYPE_SPIKES, AREA_SUBTYPE_INVALID_ID, i);
                }
                else BreakAreas[playerid][i] = 0;
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s [%d]", get_name(playerid), playerid);
                Break3DText[playerid][i] = Create3DTextLabel(STRING_GLOBAL, COLOR_MAIN, PlPos[0]+floatcos(PlPos[3]+90, degrees), PlPos[1]+floatsin(PlPos[3]+90, degrees), PlPos[2]+1.0, 10.0, 0);
                SendAccess(playerid, "Вы установили объект %s.", BreakListName[listitem]);
                return 1;
            }
            if(GetPVarInt(playerid, "LoadGarden") != 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
            {
                CreateGarden(playerid);
                return 1;
            }
            if(GetPVarInt(playerid, "LoadPanel") != 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
            {
                CreatePanel(playerid);
                return 1;
            }
            if(GetPVarInt(playerid, "LoadResourcesHouse") != 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
            {
                CreateResourcesHouse(playerid);
                return 1;
            }
        }

        if(playerState == PLAYER_STATE_SPECTATING && p_info[playerid][admin] > 0 &&
            pSpectateId[playerid] != INVALID_PLAYER_ID && pSpectatorId[pSpectateId[playerid]] != INVALID_PLAYER_ID)
        {
            if(p_temp[playerid][TextDrawReconUse] == true) HideTextDrawForPlayer(playerid, TD_ID_RECON_PANEL);
            else ShowTextDrawForPlayer(playerid, TD_ID_RECON_PANEL);
        }

        if(p_temp[playerid][Work_ID] == LABORATORY_WORK && playerState == PLAYER_STATE_ONFOOT)
        {
            if(IsPlayerFractionMedic(playerid))
            {
                new areas[2];
                GetPlayerDynamicAreas(playerid, areas, sizeof(areas));
                if(areas[0] >= laboratory_areas[0] && areas[0] <= laboratory_areas[1])
                {
                    if(p_temp[playerid][LaboratoryTimer]) return SendError(playerid, "Вы уже изготавливаете медикаменты.");
                    if(p_temp[playerid][LaboratoryCheck] != 0) return SendError(playerid, "У Вас уже есть медикаменты, отнести их на склад.");
                    Fix_TogglePlayerControllable(playerid, false);
                    ClearAnimations(playerid);
                    ApplyAnimation(playerid, "CAR_CHAT", "CAR_Sc4_BL", 4.0, 1, 1, 1, 0, 6000, 0);
                    p_temp[playerid][LaboratoryTimer] = 5;
                }
            }
        }
        if(p_temp[playerid][Work_ID] == SPACE_WORK && playerState == PLAYER_STATE_ONFOOT)
        {
            new idx = p_temp[playerid][SpaceIDx] - 1;
            if(idx < 0) return 1;
            if(IsPlayerInRangeOfPoint(playerid, 5.0, SpaceFossilsInfo[idx][sfPos][0], SpaceFossilsInfo[idx][sfPos][1], SpaceFossilsInfo[idx][sfPos][2]))
            {
                if(p_temp[playerid][SpaceProgress] < 100) p_temp[playerid][SpaceProgress] += 10;
                if(p_temp[playerid][SpaceProgress] == 100)
                {
                    ClearAnimations(playerid);

                    new amount = RandomEx(1, 3);

                    SendMes(playerid, COLOR_LYELLOW, "Вы добыли {"#cLIME"}%d{"#cLYELLOW"} ископаемых.", amount);

                    new reason_money = GetPlayerMoneySkill(playerid, 336 * amount, 4);

                    if(CheckPlayerMaxSalarySkill(playerid, 4, reason_money))
                    {
                        SetPlayerMoney(playerid, reason_money, true, "зарплата космонавт");
                        OnServerInfoForMoney[16] += reason_money;
                        p_temp[playerid][SpaceSalary] += reason_money;
                        SendMes(playerid, COLOR_LYELLOW, "К Вашей зарплате добавлено: {"#cLIME"}%d$.{"#cLYELLOW"} Заработано всего: {"#cLIME"}%d$.", reason_money, p_temp[playerid][SpaceSalary]);
                        p_temp[playerid][SpaceCount] += amount;

                        p_info[playerid][job_skill_salary][4] += reason_money;
                    }
                    else SendError(playerid, "За последний час игры было заработано максимальное количество денежных средств.");

                    if(GetPlayerGiveCasket(200, 5) != -1) GivePlayerCasket(playerid, 720);

                    UpdatePlayerWorkSkill(playerid, 4);

                    DestroySpaceFossils(playerid);
                    p_temp[playerid][SpaceIDx] = 0;
                    p_temp[playerid][SpaceTimer] = 15 + random(15);

                    p_temp[playerid][SpaceProgress] = 0;

                    CheckPlayerMission(playerid, START_SPACE);
                    CheckPlayerMission(playerid, DAILY_SPACE);
                    CheckPlayerMission(playerid, ACHIEVEMENT_SPACE);

                    CheckPlayerFreelance(playerid, FREELANCE_SPACE);
                    CheckPlayerBattlePass(playerid, BATTLEPASS_SPACE);

                    UpdateFamilyLevel(playerid);
                    UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_SPACE); // Контракты: Космонавт

                    STRING_GLOBAL[0] = EOS;
                    if(p_info[playerid][p_settings][INTERFACE])
                    {
                        f(STRING_GLOBAL, "%d", p_temp[playerid][SpaceCount]);
                        PlayerTextDrawSetString(playerid, PTD_NewSalary[playerid][2], STRING_GLOBAL);
                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, "%d$", p_temp[playerid][SpaceSalary]);
                        PlayerTextDrawSetString(playerid, PTD_NewSalary[playerid][1], STRING_GLOBAL);
                    }
                    else
                    {
                        f(STRING_GLOBAL, "Progress: %d", p_temp[playerid][SpaceCount]);
                        PlayerTextDrawSetString(playerid, PTD_Salary[playerid][5], STRING_GLOBAL);
                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, "%d$", p_temp[playerid][SpaceSalary]);
                        PlayerTextDrawSetString(playerid, PTD_Salary[playerid][6], STRING_GLOBAL);
                    }

                    CheckPlayerBot(playerid, 5);
                    return 1;
                }
                if(p_temp[playerid][SpaceProgress] < 100)
                {
                    new string[128];
                    ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop",4.0,0,0,0,0,0,1);
                    format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~READY TO: ~w~%d%", p_temp[playerid][SpaceProgress]);
                    GameTextForPlayer(playerid, string, 1000, 3);
                }
            }
        }
        if(GetPlayerVirtualWorld(playerid) == 1)
        {
            if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return 1;
            new dice_id = IsPlayerNearDice(playerid);
            if(dice_id != -1)
            {
                if(dice_id < MAX_DURAK_TABLES)
                    Durak_JoinTable(playerid, dice_id+1);
                else
                {
                    if(GetPVarInt(playerid,"BoneStol_ID")) return SendError(playerid, "Вы уже зарегистрированы на другом столе.");
                    if(GetPVarInt(playerid,"CasinoRang") && DiceInfo[dice_id][dice_gamer][5] != INVALID_PLAYER_ID) 
                        return SendError(playerid, "За столом уже есть крупье.");
                    if(GetPVarInt(playerid,"CasinoRang"))
                    {
                        DiceInfo[dice_id][dice_gamer][5] = playerid;
                        ShowTextDrawForPlayer(playerid, TD_ID_DICE);
                        SetPVarInt(playerid,"BoneStol_ID", dice_id+1);
                        UpdateBone(dice_id);
                    }
                    else
                    {
                        for(new i = 4; i != -1; i--) {
                            if(DiceInfo[dice_id][dice_gamer][i] == INVALID_PLAYER_ID &&
                                DiceInfo[dice_id][dice_playerID][i] == INVALID_MYSQL_ID)
                            {
                                DiceInfo[dice_id][dice_gamer][i] = playerid;
                                DiceInfo[dice_id][dice_playerID][i] = p_info[playerid][ID];
                                DiceInfo[dice_id][dice_set][i] = 0;

                                ShowTextDrawForPlayer(playerid, TD_ID_DICE);
                                SetPVarInt(playerid,"BoneStol_ID", dice_id+1);
                                UpdateBone(dice_id);
                                return 1;
                            }
                        }
                        return SendError(playerid, "За столом нет свободных мест.");
                    }
                }
                return 1;
            }
            if(p_temp[playerid][slot_machine_use] == -1)
            {
                new Float: minDistance = 3.0, selectSM = -1;
                for(new i = 0; i < totalsmachines; i++)
                {
                    new Float: distance = GetPlayerDistanceFromPoint(playerid, SlotMachine[i][sm_Pos][0], SlotMachine[i][sm_Pos][1], SlotMachine[i][sm_Pos][2]);
                    if(distance < minDistance && distance < 1.2)
                    {
                        minDistance = distance;
                        selectSM = i;
                    }
                }
                if(selectSM != -1)
                {
                    new i = selectSM;
                    if(SlotMachine[i][sm_userID] != -1) return SendError(playerid, "Данный игровой автомат уже кем-то используется.");
                    p_temp[playerid][SlotMachineTextDraw] = true;
                    p_temp[playerid][slot_machine_use] = i;
                    SlotMachine[i][sm_userID] = playerid;
                    SlotMachine[i][sm_bet] = 1000;
                    SlotMachine[i][sm_looser] = 0;
                    new Float:Angle = SlotMachine[i][sm_Pos][3] - 180.0;
                    SetPlayerCameraPos(playerid, SlotMachine[i][sm_Pos][0] + (0.8 * floatsin(-Angle, degrees)), SlotMachine[i][sm_Pos][1] + (0.8 * floatcos(-Angle, degrees)), SlotMachine[i][sm_Pos][2] + 0.1);
                    SetPlayerCameraLookAt(playerid, SlotMachine[i][sm_Pos][0], SlotMachine[i][sm_Pos][1], SlotMachine[i][sm_Pos][2]);
                    new Float:Pos[3];
                    GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
                    SetPlayerPos(playerid, SlotMachine[i][sm_Pos][0] + (0.9 * floatsin(-Angle, degrees)), SlotMachine[i][sm_Pos][1] + (0.9 * floatcos(-Angle, degrees)), Pos[2]);
                    new str[128];
                    format(str, sizeof(str), "~w~BALANCE: ~g~$%d.~n~~w~RATE: ~y~$%d.", p_info[playerid][cash], SlotMachine[i][sm_bet]);
                    SlotMScoreTD[playerid] = CreatePlayerTextDraw(playerid, 225.000000, 106.000000, str);
                    PlayerTextDrawBackgroundColor(playerid, SlotMScoreTD[playerid], 255);
                    PlayerTextDrawFont(playerid, SlotMScoreTD[playerid], 1);
                    PlayerTextDrawLetterSize(playerid, SlotMScoreTD[playerid], 0.419999, 1.399999);
                    PlayerTextDrawColor(playerid, SlotMScoreTD[playerid], -1);
                    PlayerTextDrawSetOutline(playerid, SlotMScoreTD[playerid], 0);
                    PlayerTextDrawSetProportional(playerid, SlotMScoreTD[playerid], 1);
                    PlayerTextDrawSetShadow(playerid, SlotMScoreTD[playerid], 1);
                    PlayerTextDrawShow(playerid, SlotMScoreTD[playerid]);
                    for(new f; f < 5; f++) TextDrawShowForPlayer(playerid, SlotMachineTD[f]);
                    SelectTextDraw(playerid, 0x007FFFFF);
                }
                return 1;
            }
        }
    }
    /*if(PRESSED(KEY_CROUCH) || PRESSED(KEY_CTRL_BACK)) // H (KEY_CROUCH - без транспортного средства | KEY_CTRL_BACK - в транспортном средстве)
    {
        //callcmd::open(playerid, "/0");
    }*/
    if(PRESSED(KEY_YES)) // Y (работает независимо от транспортного средства)
    {
        if(p_info[playerid][pfreeze] == 0 || p_temp[playerid][death_status] == 1) return SendError(playerid, "Вы заморожены, данное действие невозможно.");
        if(p_temp[playerid][dice_targetid] != INVALID_PLAYER_ID) return callcmd::ydice(playerid, "/0");
        #if EASTER_STATUS == 1
            if(p_temp[playerid][aggs_targetid] != INVALID_PLAYER_ID) return callcmd::yeggs(playerid, "/0");
        #endif
        if(FishStart[playerid] == true && FishTimer[playerid] != 0)
        {
            if(FishPress[playerid] == 1)
            {
                FishPressCount[playerid]++;
                if(FishPressCount[playerid] == 5) StopFish(playerid, TYPE_FISH_CAUGHT);
                else ShowFish(playerid);
            } else StopFish(playerid, TYPE_FISH_DESTROY_COIL);
            return 1;
        }
        if(p_temp[playerid][Work_ID] == CAR_FACTORY_WORK)
        {
            if(CarFactoryIDx[playerid] != -1 && CarFactoryType[playerid] != -1)
            {
                new i = CarFactoryIDx[playerid], idx = CarFactoryType[playerid];
                if(CarFactory[i][cfPlayerID][idx] == playerid && CarFactory[i][cfType] - 1 == idx)
                {
                    if(CarFactoryCarParts[playerid] != -1)
                    {
                        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
                        if(IsPlayerAttachedObjectSlotUsed(playerid, 2)) RemovePlayerAttachedObject(playerid, 2);
                        CarFactoryCarParts[playerid] = -1;
                    }
                    if(CarFactory[i][cfPress] == 0 && CarFactory[i][cfProgress] < 100)
                    {
                        switch(idx)
                        {
                            case 0:
                            {
                                SetPlayerFacingAngle(playerid, -90.0);
                                ApplyAnimation(playerid, "CAR", "Fixn_Car_Loop", 4.1, 1, 0, 0, 1, 1);
                            }
                            case 1:
                            {
                                SetPlayerFacingAngle(playerid, 90.0);
                                ApplyAnimation(playerid, "CAR_CHAT", "CAR_Sc4_BL", 4.1, 1, 0, 0, 1, 1);
                            }
                            case 2:
                            {
                                SetPlayerFacingAngle(playerid, 90.0);
                                ApplyAnimation(playerid, "CAR_CHAT", "car_talkm_loop", 4.1, 1, 0, 0, 1, 1);
                            }
                            case 3:
                            {
                                SetPlayerFacingAngle(playerid, 90.0);
                                ApplyAnimation(playerid, "GRAFFITI", "graffiti_Chkout", 4.1, 1, 0, 0, 1, 1);
                            }
                            case 4:
                            {
                                SetPlayerFacingAngle(playerid, 90.0);
                                ApplyAnimation(playerid, "GHANDS", "gsign3LH", 4.1, 1, 0, 0, 1, 1);
                            }
                        }
                        CarFactory[i][cfPress] = random(2);
                        CarFactory[i][cfProgress] += 5;
                        if(CarFactory[i][cfProgress] == 100)
                        {
                            new salary[5] = {142, 142, 142, 47, 98},
                                new_salary = salary[CarFactory[i][cfType] - 1],
                                reason_money = GetPlayerMoneySkill(playerid, new_salary, 1);

                            if(CheckPlayerMaxSalarySkill(playerid, 1, reason_money))
                            {
                                SetPlayerMoney(playerid, reason_money, true, "зарплата автомобильный завод");
                                OnServerInfoForMoney[16] += reason_money;
                                CarFactorySalary[playerid] += reason_money;

                                p_info[playerid][job_skill_salary][1] += reason_money;
                            }
                            else SendError(playerid, "За последний час игры было заработано максимальное количество денежных средств.");

                            if(GetPlayerGiveCasket(200, 5) != -1) GivePlayerCasket(playerid, 720);

                            UpdatePlayerWorkSkill(playerid, 1);

                            CheckPlayerMission(playerid, START_CAR);
                            CheckPlayerMission(playerid, DAILY_CAR);
                            CheckPlayerMission(playerid, ACHIEVEMENT_CAR);

                            CheckPlayerFreelance(playerid, FREELANCE_CAR);
                            CheckPlayerBattlePass(playerid, BATTLEPASS_CAR);

                            CarFactory[i][cfType] = 0;
                            CarFactory[i][cfProgress] = 0;
                            UpdateCarFactory(i);
                            ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 0, 1);

                            UpdateFamilyLevel(playerid);
                            UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_CAR_FACTORY); // Контракты: Автомобильный завод
                        }
                        else
                        {
                            p_temp[playerid][ClearAnimFix] = 1;
                            p_temp[playerid][ClearAnimTimerFix] = timestamp + 2;
                        }
                    }
                    else if(CarFactory[i][cfPress] == 1 && CarFactory[i][cfProgress] >= 5)
                    {
                        CarFactory[i][cfPress] = random(2);
                        CarFactory[i][cfProgress] -= 5;
                        if(CarFactory[i][cfProgress] < 0) CarFactory[i][cfProgress] = 0;
                    }
                    UpdatePlayerCarFactory(playerid);
                }
                return 1;
            }
        }
        if(IsTDVisible(playerid) != -1) return 1;
        if(p_info[playerid][p_settings][INTERFACE]) ShowTextDrawForPlayer(playerid, TD_ID_PLAYER_MENU);
        else callcmd::inventory(playerid, "/0");
        return 1;
    }
    if(PRESSED(KEY_NO)) // N (работает независимо от транспортного средства)
    {
        if(p_info[playerid][pfreeze] == 0 || p_temp[playerid][death_status] == 1) return SendError(playerid, "Вы заморожены, данное действие невозможно.");
        if(p_temp[playerid][dice_targetid] != INVALID_PLAYER_ID) return callcmd::ndice(playerid, "/0");
        #if EASTER_STATUS == 1
            if(p_temp[playerid][aggs_targetid] != INVALID_PLAYER_ID) return callcmd::neggs(playerid, "/0");
        #endif
        if(FishStart[playerid] == true && FishTimer[playerid] != 0)
        {
            if(FishPress[playerid] == 2)
            {
                FishPressCount[playerid]++;
                if(FishPressCount[playerid] == 5) StopFish(playerid, TYPE_FISH_CAUGHT);
                else ShowFish(playerid);
            } else StopFish(playerid, TYPE_FISH_DESTROY_COIL);
            return 1;
        }
        if(p_temp[playerid][Work_ID] == CAR_FACTORY_WORK)
        {
            if(CarFactoryIDx[playerid] != -1 && CarFactoryType[playerid] != -1)
            {
                new i = CarFactoryIDx[playerid], idx = CarFactoryType[playerid];
                if(CarFactory[i][cfPlayerID][idx] == playerid && CarFactory[i][cfType] - 1 == idx)
                {
                    if(CarFactoryCarParts[playerid] != -1)
                    {
                        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
                        if(IsPlayerAttachedObjectSlotUsed(playerid, 2)) RemovePlayerAttachedObject(playerid, 2);
                        CarFactoryCarParts[playerid] = -1;
                    }
                    if(CarFactory[i][cfPress] == 1 && CarFactory[i][cfProgress] < 100)
                    {
                        switch(idx)
                        {
                            case 0:
                            {
                                SetPlayerFacingAngle(playerid, -90.0);
                                ApplyAnimation(playerid, "CAR", "Fixn_Car_Loop", 4.1, 1, 0, 0, 1, 1);
                            }
                            case 1:
                            {
                                SetPlayerFacingAngle(playerid, 90.0);
                                ApplyAnimation(playerid, "CAR_CHAT", "CAR_Sc4_BL", 4.1, 1, 0, 0, 1, 1);
                            }
                            case 2:
                            {
                                SetPlayerFacingAngle(playerid, 90.0);
                                ApplyAnimation(playerid, "CAR_CHAT", "car_talkm_loop", 4.1, 1, 0, 0, 1, 1);
                            }
                            case 3:
                            {
                                SetPlayerFacingAngle(playerid, 90.0);
                                ApplyAnimation(playerid, "GRAFFITI", "graffiti_Chkout", 4.1, 1, 0, 0, 1, 1);
                            }
                            case 4:
                            {
                                SetPlayerFacingAngle(playerid, 90.0);
                                ApplyAnimation(playerid, "GHANDS", "gsign3LH", 4.1, 1, 0, 0, 1, 1);
                            }
                        }
                        CarFactory[i][cfPress] = random(2);
                        CarFactory[i][cfProgress] += 5;
                        if(CarFactory[i][cfProgress] == 100)
                        {
                            new salary[5] = {142, 142, 142, 47, 98},
                                new_salary = salary[CarFactory[i][cfType] - 1],
                                reason_money = GetPlayerMoneySkill(playerid, new_salary, 1);

                            if(CheckPlayerMaxSalarySkill(playerid, 1, reason_money))
                            {
                                SetPlayerMoney(playerid, reason_money, true, "зарплата автомобильный завод");
                                OnServerInfoForMoney[16] += reason_money;
                                CarFactorySalary[playerid] += reason_money;

                                p_info[playerid][job_skill_salary][1] += reason_money;
                            }
                            else SendError(playerid, "За последний час игры было заработано максимальное количество денежных средств.");

                            if(GetPlayerGiveCasket(200, 5) != -1) GivePlayerCasket(playerid, 720);

                            UpdatePlayerWorkSkill(playerid, 1);

                            CheckPlayerMission(playerid, START_CAR);
                            CheckPlayerMission(playerid, DAILY_CAR);
                            CheckPlayerMission(playerid, ACHIEVEMENT_CAR);

                            CheckPlayerFreelance(playerid, FREELANCE_CAR);
                            CheckPlayerBattlePass(playerid, BATTLEPASS_CAR);

                            CarFactory[i][cfType] = 0;
                            CarFactory[i][cfProgress] = 0;
                            UpdateCarFactory(i);
                            ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 0, 1);

                            UpdateFamilyLevel(playerid);
                            UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_CAR_FACTORY); // Контракты: Автомобильный завод
                        }
                        else
                        {
                            p_temp[playerid][ClearAnimFix] = 1;
                            p_temp[playerid][ClearAnimTimerFix] = timestamp + 2;
                        }
                    }
                    else if(CarFactory[i][cfPress] == 0 && CarFactory[i][cfProgress] >= 5)
                    {
                        CarFactory[i][cfPress] = random(2);
                        CarFactory[i][cfProgress] -= 5;
                        if(CarFactory[i][cfProgress] < 0) CarFactory[i][cfProgress] = 0;
                    }
                    UpdatePlayerCarFactory(playerid);
                }
                return 1;
            }
        }
        return callcmd::menu(playerid, "/0");
    }
    /*if(PRESSED(KEY_ANALOG_DOWN)) // NUM 2 (работает только в транспортном средство)
    {
        if(playerState == PLAYER_STATE_DRIVER) callcmd::carmenu(playerid, "/0");
    }
    if(PRESSED(KEY_ANALOG_LEFT)) // NUM 4 (работает независимо от транспортного средства)
    {
        callcmd::lock(playerid, "/0");
    }
    if(PRESSED(KEY_ANALOG_RIGHT)) // NUM 6 (работает независимо от транспортного средства)
    {
        callcmd::menu(playerid, "/0");
    }
    if(PRESSED(KEY_ANALOG_UP)) // NUM 8 (работает только в транспортном средстве)
    {
        //if(playerState == PLAYER_STATE_DRIVER) callcmd::job(playerid, "/0");
    }*/

    if(PRESSED(KEY_CROUCH))
    {
        if(playerState == PLAYER_STATE_DRIVER || playerState == PLAYER_STATE_ONFOOT) SearchBarrier(playerid);
    }

    if(newkeys & 8 && PRESS_UP[playerid] == 0) PRESS_UP[playerid] = 1;
    if(oldkeys & 8 && newkeys & 8 != 8 && PRESS_UP[playerid] == 1) PRESS_UP[playerid] = 0;

    if(newkeys & KEY_SPRINT && newkeys & KEY_JUMP && playerState != PLAYER_STATE_DRIVER &&
        (p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != THEFT_CAR_WORK && p_temp[playerid][Work_ID] != OIL_WORK) ||
        IsPlayerInRangeOfPoint(playerid, 200.0, 2019.0717,1017.8992,1996.8750) || IsPlayerInRangeOfPoint(playerid, 200.0, 2233.9033,1714.6859,2012.3828))
    {
        ClearAnimations(playerid);
        ApplyAnimation(playerid,"FAT","IDLE_tired", 4.0, 0, 0, 0, 0, 1);
    }

    if((newkeys & KEY_HANDBRAKE && newkeys & KEY_SECONDARY_ATTACK || newkeys & KEY_SECONDARY_ATTACK || newkeys & KEY_FIRE) && GetPlayerWeapon(playerid) == 0)
    {
        if(GetPVarInt(playerid, "GymTrainingStyde"))
        {
            if(IsPlayerInRangeOfPoint(playerid, 1.0, 768.7989,14.3716,1000.7011) || IsPlayerInRangeOfPoint(playerid, 1.0, 771.0737,14.2702,1000.7011) || IsPlayerInRangeOfPoint(playerid, 1.0, 769.4302,-3.2094,1000.7011) || IsPlayerInRangeOfPoint(playerid, 1.0, 767.1779,-3.4302,1000.7011))
            {
                if(p_info[playerid][style_styde] && p_temp[playerid][GymBoxClickTime] <= timestamp)
                {
                    if(p_temp[playerid][GymBoxClick] >= 10)
                    {
                        if(p_info[playerid][style_progress] < 100)
                        {
                            p_info[playerid][style_progress] += 1;
                            p_temp[playerid][GymBoxClick] = 0;
                            new str[64];
                            format(str, sizeof(str), "~g~PROGRESS STYLE: ~w~%d/100", p_info[playerid][style_progress]);
                            GameTextForPlayer(playerid, str, 2000, 6);

                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `style_styde` = %d, `style_progress` = %d WHERE `id` = %d",
                            p_info[playerid][style_styde], p_info[playerid][style_progress], p_info[playerid][ID]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                        }
                        else
                        {
                            if(p_info[playerid][style_styde] == 1) p_info[playerid][pstyle][1] = 1;
                            else if(p_info[playerid][style_styde] == 2) p_info[playerid][pstyle][2] = 1;
                            else if(p_info[playerid][style_styde] == 3) p_info[playerid][pstyle][3] = 1;
                            SendAccess(playerid, "Вы изучили новый стиль боя.");
                            p_info[playerid][style_styde] = 0;
                            p_info[playerid][style_progress] = 0;

                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `Style` = '%i|%i|%i|%i', `style_styde` = %d, `style_progress` = %d WHERE `id` = %d",
                            p_info[playerid][pstyle][0], p_info[playerid][pstyle][1], p_info[playerid][pstyle][2], p_info[playerid][pstyle][3],
                            p_info[playerid][style_styde], p_info[playerid][style_progress], p_info[playerid][ID]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                        }
                    }
                    else
                    {
                        p_temp[playerid][GymBoxClick]++;
                        new str[64];
                        format(str, sizeof(str), "~g~PROGRESS: ~w~%d/10", p_temp[playerid][GymBoxClick]);
                        GameTextForPlayer(playerid, str, 2000, 6);
                    }
                    p_temp[playerid][GymBoxClickTime] = timestamp+1;
                }
            }
        }
    }

    if(playerState == PLAYER_STATE_DRIVER)
    {
        if(PRESSED(KEY_CROUCH)) callcmd::hgate(playerid, "/0");
        if(veh_info[vehicleid][v_twinturbo] == 1 && veh_info[vehicleid][v_engine] == 1)
        {
            if(p_temp[playerid][twinturbo_on] == 1)
            {
                if(PRESSED(KEY_JUMP) || PRESSED(40)) p_temp[playerid][twinturbo_break] = 1; // активация усиленных торомозов
                if(RELEASED(KEY_JUMP) || RELEASED(40)) p_temp[playerid][twinturbo_break] = 0; // деактивация
            }
            if(PRESSED(KEY_CROUCH)) callcmd::tt(playerid, "/0"); //де/активация твин турбо
        }
    }

    if(playerState == PLAYER_STATE_ONFOOT)
    {
        if(PRESSED(KEY_SPRINT))
        {
            if(p_temp[playerid][Work_ID] == THEFT_CAR_WORK && TheftCarIDx[playerid] != -1)
            {
                new idx = TheftCarIDx[playerid], Float:pos_v_x, Float:pos_v_y, Float:pos_v_z;
                GetVehiclePos(TheftCarVehicle[idx][tcvVehicle], pos_v_x, pos_v_y, pos_v_z);
                if(PlayerToPoint(5.0, playerid, pos_v_x, pos_v_y, pos_v_z) && TheftCarTimer[playerid] == 0)
                {
                    if(veh_info[TheftCarVehicle[idx][tcvVehicle]][v_lock] == 0) return SendError(playerid, "Транспортное средство открыто.");
                    if(AntiCheatWarningTime[playerid][0] > timestamp) return SendError(playerid, "Вы не можете взламывать транспортные средства так часто, подождите.");
                    ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 1, 1, 1, 1, 0);
                    TheftCarTimer[playerid] = SetTimerEx("OnPlayerTheftCarTimer", 20000, 0, "ii", playerid, TheftCarVehicle[idx][tcvVehicle]);
                    SendMes(playerid, COLOR_BLUE, "Вы начали взламывать замок транспортного средства.");
                    Fix_TogglePlayerControllable(playerid, false);
                    return 1;
                }
            }
        }
    }
    if((newkeys & KEY_SPRINT) && GetPVarInt(playerid, "ANIM")) SetPlayerSpecialAction(playerid, 0), ClearAnimations(playerid), DeletePVar(playerid, "ANIM");
    return 1;
}
public OnPlayerUpdate(playerid)
{
    if(p_info[playerid][loggedIn] != 1) return 0;
    new weapon_player = GetPlayerWeapon(playerid);
    if(weapon_player && p_info[playerid][p_settings][PACIFIST_MODE])
    {
        SetPlayerArmedWeapon(playerid, 0);
    }
    if(IsPlayerInAnyVehicle(playerid) && weapon_player == 24) SetPlayerArmedWeapon(playerid, 0);
    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && (weapon_player == WEAPON_DEAGLE ||
        weapon_player == WEAPON_SHOTGSPA || weapon_player == WEAPON_SAWEDOFF ||
        weapon_player == WEAPON_MINIGUN || weapon_player == WEAPON_MP5)) SetPlayerArmedWeapon(playerid, 0);
    if(weapon_player >= 35 && weapon_player <= 38 || weapon_player == 44 || weapon_player == 45 || weapon_player == 16)
    {
        SendInfo(playerid, "Подозрение в использовании чит програм [0002]");
        f_ResetPlayerWeapons(playerid);
        Kick(playerid);
    }
    p_info[playerid][p_afkTick]++;
    if(GetPVarInt(playerid,"PlayerCuffed") == 1 && !GetPVarInt(playerid,"Conv") && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ClearAnimations(playerid);
    if(!p_info[playerid][admin] && !p_info[playerid][youtube_adm] && GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_USEJETPACK)
    {
        SendInfo(playerid, "Подозрение в использовании чит програм [0001]");
        Kick(playerid);
    }

    if(noclipdata[playerid][cameramode] == CAMERA_MODE_FLY)
    {
        new keys, ud, lr;
        GetPlayerKeys(playerid,keys,ud,lr);

        if(noclipdata[playerid][nmode] && (GetTickCount() - noclipdata[playerid][lastmove] > 100))
        {
            MoveCamera(playerid);
        }
        if(noclipdata[playerid][udold] != ud || noclipdata[playerid][lrold] != lr)
        {
            if((noclipdata[playerid][udold] != 0 || noclipdata[playerid][lrold] != 0) && ud == 0 && lr == 0)
            {
                StopPlayerObject(playerid, noclipdata[playerid][flyobject]);
                noclipdata[playerid][nmode]      = 0;
                noclipdata[playerid][accelmul]  = 0.0;
            }
            else
            {
                noclipdata[playerid][nmode] = GetMoveDirectionFromKeys(ud, lr);
                MoveCamera(playerid);
            }
        }
        noclipdata[playerid][udold] = ud; noclipdata[playerid][lrold] = lr;
        return 0;
    }
    return 1;
}


GetVehicleSpeed(vehicleid)
{
    new Float:x, Float:y, Float:z;
    GetVehicleVelocity(vehicleid, x, y, z);
    return floatround(floatsqroot(x*x+y*y+z*z)*100);
}

SetVehicleSpeed(vehicleid, Float:speed)
{
    new Float:x1, Float:y1, Float:z1, Float:x2, Float:y2, Float:z2, Float:a;
    GetVehicleVelocity(vehicleid, x1, y1, z1);
    GetVehiclePos(vehicleid, x2, y2, z2);
    GetVehicleZAngle(vehicleid, a); a = 360 - a;
    x1 = (floatsin(a, degrees) * (speed/100) + floatcos(a, degrees) * 0 + x2) - x2;
    y1 = (floatcos(a, degrees) * (speed/100) + floatsin(a, degrees) * 0 + y2) - y2;
    return SetVehicleVelocity(vehicleid, x1, y1, z1);
}

public OnPlayerEnterDynamicCP(playerid, checkpointid)
{
    new area_data[2];
    Streamer_GetArrayData(STREAMER_TYPE_CP, checkpointid, E_STREAMER_EXTRA_ID, area_data);
    switch(area_data[0])
    {
        case TYPE_ID_FRAC:
        {
            new idx = area_data[1];
            if(FractionsData[idx][fWarehouseCP] == checkpointid)
            {
                new string[144];
                switch(idx)
                {
                    case POLICE_LS, POLICE_SF, POLICE_LV, FBI_TEAM, POLICE_RC, PRISON:
                    {
                        if(p_info[playerid][member] != idx) return 1;
                        f(string,  ""I"Склад %s", GetFractionName(idx));
                        ShowPlayerDialog(playerid, 84, DIALOG_STYLE_TABLIST, string,""I"[1]"W" Боеприпасы\n"I"[2]"W" Деньги\t[Взять|Положить] ", "Выбрать", "Закрыть");
                    }
                    case NATIONAL_GUARD:
                    {
                        if(gang(playerid) || mafia(playerid) || biker(playerid))
                        {
                            new str[44], str_patr[22],str_mat[22];

                            if(GetFractionWarehouse(NATIONAL_GUARD, fwMate) > 0 && GivePlayerInventory(playerid, 627, 1))
                            {
                                SetFractionWarehouse(NATIONAL_GUARD, fwMate, -1);
                                SetPVarInt(playerid, "mat",1);
                                f(str_mat, "materials: %d/%d",GetInventoryAmount(playerid, 627));
                            }
                            if(GetFractionWarehouse(NATIONAL_GUARD, fwPatron) > 2 && GivePlayerInventory(playerid, 628, 2))
                            {
                                SetFractionWarehouse(NATIONAL_GUARD, fwPatron, -2);
                                f(str_patr, "~b~patrons: %d", GetInventoryAmount(playerid, 628));
                            }
                            f(str, "%s~n~%s",str_mat,str_patr);
                            GameTextForPlayer(playerid, str, 1000, 3);
                            return 1;
                        }
                        if(p_info[playerid][member] != idx) return 1;
                        ShowPlayerDialog(playerid, 84, DIALOG_STYLE_TABLIST, ""I"Склад Армии",""I"[1]"W" Боеприпасы\n[2]"W" Деньги\t[Взять|Положить] ", "Выбрать", "Закрыть");
                    }
                    case RADIO_LS, RADIO_SF, RADIO_LV: {
                        if(p_info[playerid][member] != idx) return 1;
                        ShowPlayerDialog(playerid, 85, DIALOG_STYLE_TABLIST, ""I"Склад SNN",""I"[1]"W" Деньги\t[Взять|Положить] ", "Выбрать", "Закрыть");
                    }
                    case MAFIA_RM..VAGOS, BIKER, MAFIA_IRAN:
                    {
                        if(p_info[playerid][member] != idx) return 1;
                        f(string,  ""I"Общак %s", GetFractionName(idx));
                        switch(p_info[playerid][member])
                        {
                            case GROOVE..VAGOS, BIKER, MAFIA_IRAN: ShowPlayerDialog(playerid, 103, DIALOG_STYLE_TABLIST, string,""I"[1]"W" Материалы\t[Взять|Положить]\n"I"[2]"W" Патроны\t[Взять|Положить]\n"I"[3]"W" Наркотики\t[Взять|Положить]\n"I"[4]"W" Деньги\t[Взять|Положить]\n"I"[5]"W" Канистры\t[Взять|Положить]\n"I"[6]"W" Рем. комплекты\t[Взять|Положить]\n"I"[7]"W" Аптечки\t[Взять|Положить]\n"I"[8]"W" Маски\t[Взять|Положить] ", "Выбрать", "Закрыть");
                            default: ShowPlayerDialog(playerid, 103, DIALOG_STYLE_TABLIST, string,""I"[1]"W" Материалы\t[Взять|Положить]\n"I"[2]"W" Патроны\t[Взять|Положить]\n"I"[3]"W" Наркотики\t[Взять|Положить]\n"I"[4]"W" Деньги\t[Взять|Положить]\n"I"[5]"W" Канистры\t[Взять|Положить]\n"I"[6]"W" Рем. комплекты\t[Взять|Положить]\n"I"[7]"W" Аптечки\t[Взять|Положить]\n"I"[8]"W" Маски\t[Взять|Положить] ", "Выбрать", "Закрыть");
                        }
                    }
                    case MEDIC_LS, MEDIC_SF, MEDIC_LV:
                    {
                        if(p_info[playerid][member] != idx) return 1;
                        f(string,  ""I"Склад %s", GetFractionName(idx));
                        ShowPlayerDialog(playerid, 85, DIALOG_STYLE_TABLIST, string, ""I"[1]"W" Деньги\t[Взять|Положить] ", "Выбрать", "Закрыть");
                    }
                    case MAYOR_LS:
                    {
                        if(p_info[playerid][member] != idx) return 1;
                        f(string,  ""I"Склад %s", GetFractionName(idx));
                        ShowPlayerDialog(playerid, 84, DIALOG_STYLE_TABLIST, string,""I"[1]"W" Боекомплект\n"I"[2]"W" Деньги\t[Взять|Положить]\n"I"[3]"W" Перевод денежных средств на счет гос. организации", "Выбрать", "Закрыть");
                    }
                    case LICENSE:
                    {
                        if(p_info[playerid][member] != idx) return 1;
                        f(string,  ""I"Склад %s", GetFractionName(idx));
                        ShowPlayerDialog(playerid, 85, DIALOG_STYLE_TABLIST, string,""I"[1]"W" Деньги\t[Взять|Положить] ", "Выбрать", "Закрыть");
                    }
                    default: return 1;
                }
                return 1;
            }
        }
        case TYPE_ID_AIRDROP:
        {
            new idx = area_data[1];
            if(AirDropInfo[idx][AirDropCheckpoint] == checkpointid)
            {
                if(!mafia(playerid) && !gang(playerid) && !biker(playerid)) return SendError(playerid, "Вы не состоите в нелегальной организации.");
                AirDropUse[playerid] = idx;
                ShowAirDropContent(playerid, idx);
                return 1;
            }
        }
        case TYPE_ID_WARPLANE:
        {
            new idx = area_data[1];
            if(WarPlaneInfo[idx][WarPlaneCheckpoint] == checkpointid)
            {
                if(!mafia(playerid) && !gang(playerid) && !biker(playerid)) return SendError(playerid, "Вы не состоите в нелегальной организации.");
                WarPlaneUse[playerid] = idx;
                ShowWarPlaneContent(playerid, idx);
                return 1;
            }
        }
        case TYPE_ID_TRASH_BOX:
        {
            new idx = area_data[1];
            if(TrashBoxInfo[idx][tbCheckpoint] == checkpointid)
            {
                p_temp[playerid][trash_box_use] = idx;
                ShowTrashBoxContent(playerid, idx);
                return 1;
            }
            return 1;
        }
    }
    return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    //SendDebug(playerid, "dialogid: %d response: %d listitem: %d", dialogid, response, listitem);
    //SendDebug(playerid, "inputtext: %s", inputtext);
    if(playerDialogID[playerid] != dialogid)
        return 1;

    playerDialogID[playerid] = -1;

    if(strfind(inputtext, "`",true) !=-1 ||
        strfind(inputtext, "accounts",true) !=-1 ||
        strfind(inputtext, "delete",true) !=-1 ||
        strfind(inputtext, "update",true) !=-1) return SendError(playerid, "Вы используете запрещенные символы.") & 1;

    for(new i = strlen(inputtext)-1; i != -1; i--)
    {
        if(inputtext[i] == '%' || (dialogid != D_BILLBOARD_TEXT && inputtext[i] == '{')) inputtext[i] = '#';
    }
    PlayerPlaySound(playerid, 1149, 0.0, 0.0, 0.0);

    editproperty_OnDialogResponse(playerid, dialogid, response, listitem, inputtext);
    family_OnDialogResponse(playerid, dialogid, response, listitem, inputtext);
    mdc_OnDialogResponse(playerid, dialogid, response, listitem, inputtext);

    if(equipment_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
    if(Sparring_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;

    switch(dialogid)
    {
        case D_GHETTOWAR:
        {
            if(!response) return 1;
            new id = -1;
            if(IsPlayerInDynamicArea(playerid, ghetto_bots[0])) 
                id = BALLAS;
            else if(IsPlayerInDynamicArea(playerid, ghetto_bots[1])) 
                id = RIFA;
            if(id == -1) 
                return SendError(playerid, "Вы слишком далеко от бота для вступления в банду.");
            f(STRING_GLOBAL, ""W"Вы действительно желаете вступить в "I"%s ?", GetFractionName(id));
            ShowPlayerDialog(playerid, D_GHETTOWAR_INVITE, DIALOG_STYLE_MSGBOX, "Авто-вступление в фракцию", STRING_GLOBAL, "Вступить", "Отмена");
            SetPVarInt(playerid, #GANG_ID, id);
            return 1;
        }
        case D_GHETTOWAR_INVITE:
        {
            new id = GetPVarInt(playerid, #GANG_ID);
            DeletePVar(playerid, #GANG_ID);
            if(!response)
                return 1;
            if(p_info[playerid][level] < 2) 
                return SendError(playerid, "На 1 уровне нельзя вступить в банду.");
            if(p_info[playerid][member] == id)
                return SendError(playerid, "Вы уже находитесь в этой банде.");
            Iter_Remove(gFactionPlayers[p_info[playerid][member]], playerid);

            p_info[playerid][leader] =
            p_info[playerid][fwarn] =
            p_info[playerid][billet_exp] = 0;

            p_info[playerid][member] = id;
            Iter_Add(gFactionPlayers[p_info[playerid][member]], playerid);
            p_info[playerid][rang] = 7;

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `log_fraction` (`PlayerID`, `Member`, `Rang`, `Type`) VALUES (%d, %d, %d, '0')",
            p_info[playerid][ID], p_info[playerid][member], p_info[playerid][rang]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            p_info[playerid][spawn] = SPAWN_FRACTION;

            SendAccess(playerid, "Вы вступили в \"%s\".", GetFractionName(p_info[playerid][member]));
            if(p_info[playerid][job] != 0)
            {
                Iter_Remove(gJobPlayers[p_info[playerid][job]], playerid);
                p_info[playerid][job] = 0;
            }

            SetPlayerFractionSkin(playerid);
            if(GetFactionType(p_info[playerid][member]) != FACTION_TYPE_CRIMINAL)
            {
                p_info[playerid][fwork] = false;
                SetPlayerSkinEx(playerid);
            }

            if(GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_PD || GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_FBI)
                p_temp[playerid][StatusOnDuty] = 0;

            SetPlayerColor(playerid, fraction_color[p_info[playerid][member]]);

            save_player(playerid);

            CheckPlayerMission(playerid, START_FRACTION);

            if(gang(playerid))
            {
                /*
                p_info[playerid][ftop_gkills_week] = 
                p_info[playerid][ftop_gdeaths_week] = 0;
                p_info[playerid][ftop_gdamagegive_week] = 
                p_info[playerid][ftop_gdamagetake_week] = 0;
                
                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `ftop_gkills_week` = 0, `ftop_gdeaths_week`  = 0, `ftop_gdamagegive_week` = 0.0, `ftop_gdamagetake_week` = 0.0 WHERE `id` = %d", p_info[playerid][ID]);
                mysql_tquery(con_bd, STRING_GLOBAL);
                */

                if(Capture_Info[0][gGangZoneID] != INVALID_CRIMINAL_ZONE_ID || Capture_Info[1][gGangZoneID] != INVALID_CRIMINAL_ZONE_ID)
                {
                    if((Capture_Info[0][gFaction][0] == p_info[playerid][member] || Capture_Info[0][gFaction][1] == p_info[playerid][member]) ||
                        (Capture_Info[1][gFaction][0] == p_info[playerid][member] || Capture_Info[1][gFaction][1] == p_info[playerid][member]))
                    {
                        ShowTextDrawForPlayer(playerid, TD_ID_CAPTURE);
                        CaptureInfoUpdate(playerid, CAPTURE_ID_GANG);
                    }
                }
            }

            Log(LOG_player, INFO, "%s[%d](%s %s) вступил в фракцию %s | #Fraction",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                GetFractionName(p_info[playerid][member]));
            return 1;
        }
        case D_GANGINFO:
        {
            if(!response) return 1;
            if(!(0 <= listitem <= 5)) return 1;
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT COUNT(member) AS total FROM accounts WHERE `member` = %d", GROOVE+listitem);
            mysql_tquery(con_bd, STRING_GLOBAL, "GangInfoCallback", "ii", playerid, GROOVE+listitem);
            return 1;
        }
        case D_ARA_SELL_ITEM: // Слив предметов Аре
        {
            new slot_id = GetPVarInt(playerid, #SELECT_SLOT_ID)-1;
            DeletePVar(playerid, #SELECT_SLOT_ID);
            if(slot_id == -1 || !response)
                return 1;

            new count = 1,
                item_id = InventoryPlayer[playerid][slot_id][inv_item_id],
                item_type = ItemsInfo[item_id][iType];

            if(item_type == TYPE_ITEMS_NONE || slot_id >= p_info[playerid][inv_slots])
                return SendError(playerid, "Данный предмет продать нельзя.");

            if(item_type == TYPE_ITEMS_INVENTORY)
            {
                if(!strlen(inputtext)) return SendError(playerid, "Вы ничего не ввели.");
                count = strval(inputtext);
            }
            if(count > GetInventoryAmount(playerid, item_id))
                return SendError(playerid, "У Вас не достаточно кол-ва предмета в инвентаре.");

            new price_item = ItemsInfo[item_id][iStateCost]*count;

            if(price_item <= 0) return SendError(playerid, "Цена не определена.");

            new Float:wear = item_type == TYPE_ITEMS_ACCESSORIES ? InventoryPlayer[playerid][slot_id][inv_acc_wear] : InventoryPlayer[playerid][slot_id][inv_skin_wear],
                mc1 = InventoryPlayer[playerid][slot_id][inv_acc_mt][0],
                mc2 = InventoryPlayer[playerid][slot_id][inv_acc_mt][1];

            if(item_type == TYPE_ITEMS_INVENTORY)
            {
                if(!GivePlayerInventory(playerid, item_id, -count))
                    return 1;
            }
            else DropPlayerEquipment(playerid, slot_id);

            new tax = GetTaxCount(playerid, price_item, TAX_MARKET_SELL);

            SendAccess(playerid, "Вы продали \"%s\" %d ед. за %d$. Налог: %d$.", ItemsInfo[item_id][iName], count, price_item, tax);
            SetPlayerMoney(playerid, price_item-tax, true, "");

            if(item_type == TYPE_ITEMS_INVENTORY || item_type == TYPE_ITEMS_SKINS || item_type == TYPE_ITEMS_VEHICLE_TUNE)
            {
                Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] продал через рынок(скупщик) товар <%s> %d ед. за %d$. Налог %d$ | #MARKET",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                    ItemsInfo[item_id][iName], count, price_item, tax);
            }
            else if(item_type == TYPE_ITEMS_ACCESSORIES)
            {
                Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] продал через рынок(скупщик) <%s> [%.1f] (%s/%s) за %d$. Налог %d$ | #MARKET",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                    ItemsInfo[item_id][iName], wear, AccessoriesColorInfo[mc1][acName], AccessoriesColorInfo[mc2][acName], price_item, tax);
            }
            ShowPlayerList(playerid, LIST_ID_ARA_SELL_ITEMS);
            return 1;
        }

        case D_FRACTION_FREEZE:
        {
            if(!response) return 1;
            if(p_info[playerid][admin] < 4) return 1;
            if(!(0 <= listitem < MAX_FRACTIONS)) return 1;
            new fraction_id = p_temp[playerid][p_listitem][listitem];
            if(GetFactionType(fraction_id) != FACTION_TYPE_CRIMINAL)
                return SendError(playerid, "Данная фракция не относится к криминальным структурам.");

            SetFractionSettings(fraction_id, fFreezeCapture, GetFractionSettings(fraction_id, fFreezeCapture) > 1 ? 0 : 2);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] %s %s.", get_name(playerid), playerid, GetFractionSettings(fraction_id, fFreezeCapture) > 1 ? "заморозил" : "разморозил", GetFractionName(fraction_id));
            SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

            Log(LOG_player, INFO, "%s[%d](%s %s) %s %s | #AdminLogs",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", GetFractionSettings(fraction_id, fFreezeCapture) > 1 ? "заморозил" : "разморозил", GetFractionName(fraction_id));
            return 1;
        }
        case D_SF_TEXT_NEWS:
        {
            if(!response)
                return callcmd::snews(playerid);
            if(p_info[playerid][level] < 3)
                return callcmd::snews(playerid), SendError(playerid, "Голосовать можно с 3 уровня");
            new id = p_temp[playerid][p_listitem_int],
                iRating = p_temp[playerid][p_listitem][LIST_OFFSET_MAX+id];
            if(1 <= iRating <= 5)
                return callcmd::snews(playerid), SendError(playerid, "Вы уже проголосовали за новость.");
            
            ShowPlayerDialog(playerid, D_SF_NEWS_RATING, DIALOG_STYLE_LIST, "Оценка новости",  ""I"[1] "W"Очень плохо\n"I"[2] "W"Плохо\n"I"[3] "W"Нормально\n"I"[4] "W"Хорошо\n"I"[5] "W"Очень хорошо", "Оценить", "Закрыть");
            return 1;
        }

        case D_SF_NEWS_RATING:
        {
            if(!response)
