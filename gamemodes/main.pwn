                }
                case 2:
                {
                    if(p_info[playerid][cash] < 250000) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                    if(p_info[playerid][Update][3] == 1) return SendError(playerid, "У Вас уже имеется данное улучшение.");

                    SetPlayerMoney(playerid, -250000, true,"купил улучшение <Планшет>");
