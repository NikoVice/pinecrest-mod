MysqlUpdateOtherStr(field[], data[])
{
    new string[256];
    mysql_format(con_bd, string, sizeof(string), "UPDATE `other` SET `%s` = '%s'",
    field, data);
    mysql_tquery(con_bd, string, "", "");
}

MysqlUpdateOtherInt(field[], data)
{
    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `other` SET `%s` = %d",
    field, data);
    mysql_tquery(con_bd, STRING_GLOBAL);
}

