                {
                    SendError(playerid, "Достигнуто максимального значения - %d дома.", MAX_HOUSE_PLAYER);
                    return ShowPlayerDonate(playerid, DONATE_TYPE_MENU);
                }
                new price, count_house = p_info[playerid][house_slots];
                if(count_house <= 0) count_house = 1;
                price = 1500 * count_house;
                p_temp[playerid][p_listitem_int] = price;
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                Вы желаете приобрести дополнительный слот для {"#cGREEN"}\"Дома\"?"W"\n\n\
                Стоимость: "I"%d Pinecrest Money"W"\n\n\
                Доп. слотов на данный момент: {"#cLIGHTRED"}%d"W"\n\
                Стоимость след. доп. слота: {"#cLIGHTRED"}%d"W" Pinecrest Money", price, count_house-1, price+1500);
                ShowPlayerDialog(playerid, D_BUY_HOUSE_SLOTS, DIALOG_STYLE_MSGBOX, ""I"Слоты для домов", STRING_GLOBAL, "Далее", "Отмена");
            }
            else
            {
                new old_id = p_info[playerid][active_house_id];
                p_info[playerid][active_house_id] = listitem;
                new house_id = GetPlayerHouseID(playerid);
                if(house_id == INVALID_HOUSE_ID || p_info[playerid][key_h_rent] != INVALID_HOUSE_ID)
                {
                    p_info[playerid][active_house_id] = old_id;
                    return SendError(playerid, "У Вас нет дома в этом слоте.");
                }
                if(h_info[house_id][h_paydays_received] == -1)
                {
                    SendError(playerid, "Действия над домом заблокированы.");
                    return SendInfo(playerid, "Имущество будет продано в 8 вечера в гос по причине недостаточного Вашего онлайна.");
                }
                switch(p_temp[playerid][p_listitem_int])
                {
                    case HOUSE_ID_SELECT:
                        SendAccess(playerid, "Вы выбрали дом: "I"%d "W"(Слот: %d)", h_info[house_id][h_mysql_id], listitem+1);
                    case HOUSE_ID_GPS:
                    {
                        new Float:distance = GetPlayerDistanceFromPoint(playerid, h_info[house_id][h_enter][0], h_info[house_id][h_enter][1], h_info[house_id][h_enter][2]);
                        if(p_temp[playerid][TaxiGPS] == true)
                        {
                            if(GetPlayerTaxiDriver(playerid) == INVALID_PLAYER_ID) return SendError(playerid, "В такси нет водителя.");

                            new driverid = GetPlayerTaxiDriver(playerid);
                            p_temp[playerid][TaxiGPS] = false;
                            SetPlayerGPS(driverid, h_info[house_id][h_enter][0], h_info[house_id][h_enter][1], h_info[house_id][h_enter][2],5.0);

                            SendInfo(driverid, "%s обозначил место назначения. Расстояние: %.0f метров.", get_name(playerid), distance);
                            return 1;
                        }
                        if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                        SetPlayerGPS(playerid, h_info[house_id][h_enter][0], h_info[house_id][h_enter][1], h_info[house_id][h_enter][2],5.0);
                        SendInfo(playerid, "\"Дом\" отмечен на GPS навигаторе. Расстояние: %.0f метров.", distance);
                    }
                    case HOUSE_ID_RENT:
                    {
                        new h_sub = h_info[house_id][h_improve][SUBSIDY] == 1 ? 2 : 1;
                        new h_a_price_sub = h_info[house_id][h_squar]*2500/h_sub;
                        new list_percent[3] = {90, 80, 70}, vip_idx = p_info[playerid][p_vip];
                        if(vip_idx) h_a_price_sub = ((h_a_price_sub / 100) * list_percent[vip_idx - 1]);
                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                        Чтобы "I"оплатить"W" дом, введите количество дней:\n\n\
                        Дом оплачен на "I"%d"W" дн(-я/-ей) ["I"%d"W" ча(-а/-ов)].\n\n\
                        Стоимость оплаты в день: "I"$%d.", h_info[house_id][h_rent]/24, h_info[house_id][h_rent], h_a_price_sub);
                        ShowPlayerDialog(playerid, D_HOUSE_RENT, DIALOG_STYLE_INPUT, ""I"Оплатить дом", STRING_GLOBAL, "Далее", "Отмена");
                    }
                    case HOUSE_ID_MENU:
                    {
                        if(p_temp[playerid][h_buy_int] != -1 ||
                            p_temp[playerid][h_repair_txtid] != -1 ||
                            IsValidTimer(h_info[house_id][h_mapping_timer])) return SendError(playerid, "Вы не можете пользоваться этой командой.");

                        if(IsPlayerInRangeOfPoint(playerid, 2.0, h_info[house_id][h_enter][0], h_info[house_id][h_enter][1], h_info[house_id][h_enter][2]) || house_id+50 == GetPlayerVirtualWorld(playerid))
                        {
                            if(h_info[house_id][h_auction_bet] != 0)
                            {
                                STRING_GLOBAL[0] = EOS;
                                f(STRING_GLOBAL, ""W"\
                                Для управления домом необходимо снять его с аукциона.\n\n\
                                Чтобы снять дом с аукциона, Вам необходимо заплатить %d$.\n\n\
                                Вы хотите снять дом с аукциона?", (h_info[house_id][h_auction_bet]/100)*2);
                                ShowPlayerDialog(playerid, D_AUCTION_HOUSE_CANCEL, DIALOG_STYLE_MSGBOX, ""I"Аукцион домов", STRING_GLOBAL, "Далее", "Отмена");
                                return 1;
                            }
                            new city = GetCityName(h_info[house_id][h_enter][0], h_info[house_id][h_enter][1]),
                                area = GetZonaName(h_info[house_id][h_enter][0], h_info[house_id][h_enter][1]);
                            STRING_GLOBAL[0] = EOS;
                            f(STRING_GLOBAL, ""W"Статистика дома \t№%d\n\n"W"Класс:\t\t\t"I"%s\n"W"Город:\t\t\t"I"%s\n"W"Район:\t\t\t"I"%s\n"W"Cтоимость:\t\t"I"%d$\n"W"Статус дверей дома:\t"I"%s\n", house_id, house_class[h_info[house_id][h_squar]-1],
                            gSAZonesCity[city][SAZONE_NAME],gSAZones[area][SAZONE_NAME],h_info[house_id][h_value],(h_info[house_id][h_lock] == 0)?("Открыты"):("Закрыты"));

                            if(h_info[house_id][h_squar] > 1)
                                f(STRING_GLOBAL, "%s"W"Статус дверей гаража:\t"I"%s\n\n", STRING_GLOBAL, (h_info[house_id][h_garage_lock] == 0)? ("Открыты"):("Закрыты"));
                            else
                                strcat(STRING_GLOBAL, "\n\n");

                            f(STRING_GLOBAL, "%s"W"Дом оплачен - \t"I"%d/30 дней (%d часов)\n\n{"#cLIGHTRED"}Для управления домом нажмите 'Меню' или 'Закрыть' для закрытия панели",STRING_GLOBAL,h_info[house_id][h_rent]/24, h_info[house_id][h_rent]);
                            ShowPlayerDialog(playerid, D_HOUSE_INFO, DIALOG_STYLE_MSGBOX, ""I"Cтатистика дома", STRING_GLOBAL, "Меню", "Закрыть");
                        }
                        else SendError(playerid, "Вы слишком далеко от дома.");
                    }
                    case HOUSE_ID_SPAWN:
                    {
                        p_info[playerid][spawn_house_id] = listitem;
                        SendAccess(playerid, "Вы выбрали для появления в игре дом №%d", house_id);
                    }
                    case HOUSE_ID_FAMILY:
                    {
                        new family_idx = GetPlayerFamilyID(playerid);
                        if(family_idx == -1) return 1;
                        if(p_info[playerid][cash] < 200_000) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                        if(GetInventoryAmount(playerid, 645) < 40)
                            return SendError(playerid, "У Вас нет столько семейных монет.");
                        GivePlayerInventory(playerid, 645, -40);
                        SetPlayerMoney(playerid, -200_000, true, "привязка дома к объединению");

                        h_info[house_id][h_family_id] = FamilyData[family_idx][fMysqlID]; //Привязываем к дому << >> ИД БД семьи
                        FamilyData[family_idx][fHouseID] = h_info[house_id][h_mysql_id]; // Привязываем к семьи << >> ИД игры ДОМА

                        SendAccess(playerid, "Вы сделали дом семейным.");

                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s[%d] привязал к семье дом: №%d.", get_name(playerid), playerid, h_info[house_id][h_mysql_id]);
                        SendFamilyMessage(family_idx, STRING_GLOBAL);

                        update_house(house_id);
                        save_house(house_id);

                        new targetid;
                        for(new i; i <= h_info[house_id][h_squar]; i++)
                        {
                            if(h_info[house_id][h_r_user_id][i] != INVALID_MYSQL_ID)
                            {
                                targetid = GetPlayerUserID(h_info[house_id][h_r_user_id][i]);
                                house_rent_leave(house_id, i);
                                if(targetid != INVALID_PLAYER_ID) SendInfo(targetid, "Владелец дома сделал его семейным, Вы выселены.");
                            }
                        }

                        STRING_GLOBAL[0] = EOS;
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `spawn` = 0 WHERE `spawn` = '3' AND `family_id` = %d",
                            FamilyData[family_idx][fMysqlID]);
                        mysql_tquery (con_bd, STRING_GLOBAL);

                        STRING_GLOBAL[0] = EOS;
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `family` SET `house_id` = %d WHERE `id` = %d",
                            FamilyData[family_idx][fHouseID], FamilyData[family_idx][fMysqlID]);
                        mysql_tquery (con_bd, STRING_GLOBAL);

                        UpdateFamilyType(family_idx);
                    }
                    case HOUSE_ID_GARDEN_CENTER:
                    {
                        new h = GetPlayerHouseID(playerid);
                        if(h == INVALID_HOUSE_ID) return SendError(playerid, "У Вас нет дома.");
                        new bizid = GetPVarInt(playerid, "bID"), till = b_info[bizid][_till];
                        STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;
                        for(new idx = 0; idx < sizeof(GardenCenter); idx++)
                        {
                            format(STRING_MIN, sizeof(STRING_MIN), ""I"[%d]"W" %s (%d$)\n", idx + 1, GardenCenter[idx][GardenCenterName], GardenCenter[idx][GardenCenterPrice] * till);
                            strcat(STRING_GLOBAL, STRING_MIN);
                        }
                        p_temp[playerid][p_listitem][40] = B_GARDEN_CENTER;
                        ShowPlayerDialog(playerid, D_BUY_MAGAZ, DIALOG_STYLE_LIST, ""I"Покупка", STRING_GLOBAL, "Купить","Отмена");
                        SetPVarInt(playerid, "GardenCenter:type", 1);
                        return 1;
                    }
                    case HOUSE_ID_GARDEN:
                    {
                        if(!IsPlayerInRangeOfPoint(playerid, 25.0, h_info[house_id][h_enter][0], h_info[house_id][h_enter][1], h_info[house_id][h_enter][2])) return SendError(playerid, "Вы слишком далеко от дома.");
                        ShowPlayerDialog(playerid, D_GARDEN_HOUSE, DIALOG_STYLE_LIST, ""I"Управление садом", ""I"[1]"W" Установить объект\n"I"[2]"W" Удалить объект", "Далее", "Отмена");
                    }
                    case HOUSE_ID_PANEL_STORE:
                    {
                        new h = GetPlayerHouseID(playerid);
                        if(h == INVALID_HOUSE_ID) return SendError(playerid, "У Вас нет дома.");

                        new bizid = GetPVarInt(playerid, "bID"), till = b_info[bizid][_till], price = 150000 * till;

                        if(panel_warehouse <= 0) return SendError(playerid, "На складе нет солнечных панелей, они пополняются каждый час.");

                        if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

                        h_info[h][h_panel_items]++;
                        save_house(h);

                        if(b_info[bizid][_prod] >= ((price / 100) * 20) / 100)
                        {
                            b_info[bizid][_prod] -= ((price / 100) * 20) / 100;
                            b_info[bizid][_bank] += ((price / 100) * 20) - ((price / 100) * 2);
                            AddMafiaBank(bizid, (price / 100) * 2);

                            biz_finka[bizid] += ((price / 100) * 20) - ((price / 100) * 2);
                            UpdateIntForFinanceBiz(bizid, ((price / 100) * 20) - ((price / 100) * 2));
                        }

                        panel_warehouse--;
                        if(panel_warehouse < 0) panel_warehouse = 0;
                        MysqlUpdateOtherInt("panel_warehouse", panel_warehouse);

                        OnServerInfoForMoney[10] += price;
                        SetPlayerMoney(playerid, -price, true, "покупка в магазине солнечных панелей");

                        SendAccess(playerid, "Вы приобрели солнечную панель за %d$.", price);
                        SendInfo(playerid, "Используйте /panel чтобы установить её на территории дома.");
                    }
                    case HOUSE_ID_PANEL:
                    {
                        if(!IsPlayerInRangeOfPoint(playerid, 25.0, h_info[house_id][h_enter][0], h_info[house_id][h_enter][1], h_info[house_id][h_enter][2])) return SendError(playerid, "Вы слишком далеко от дома.");
                        ShowPlayerDialog(playerid, D_PANEL, DIALOG_STYLE_LIST, ""I"Управление панелями", ""I"[1]"W" Установить панель\n"I"[2]"W" Удалить панель\n"I"[3]"W" Управление панелью\n"I"[4]"W" Информация о панелях", "Далее", "Отмена");
                    }
                    case HOUSE_ID_CARD_STORE:
                    {
                        new h = GetPlayerHouseID(playerid);
                        if(h == INVALID_HOUSE_ID) return SendError(playerid, "У Вас нет дома.");
                        new bizid = GetPVarInt(playerid, "bID"), till = b_info[bizid][_till];
                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, ""W"\
                        Вы хотите приобрести видеокарту для майнинга криптовалюты?\n\n\
                        Стоимость: "I"%d$"W"\n\n\
                        На складе: "I"%d шт."W"\n\n\
                        Завоз новых видеокарт на склад происходит каждый час.", 200000 * till, vc_warehouse);
                        p_temp[playerid][p_listitem][40] = B_CARD_STORE;
                        ShowPlayerDialog(playerid, D_BUY_MAGAZ, DIALOG_STYLE_MSGBOX, ""I"Покупка", STRING_GLOBAL, "Купить","Отмена");
                    }
                    case HOUSE_ID_UNDERGROUND_BOTS:
                    {
                        new h = GetPlayerHouseID(playerid);
                        if(h == INVALID_HOUSE_ID) return SendError(playerid, "У Вас нет дома.");
                        new bizid = GetPVarInt(playerid, "bID"), till = b_info[bizid][_till];
                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, ""W"\
                        Вы хотите арендовать рабочего для работы в подпольном помещении?\n\n\
                        Стоимость: "I"%d$"W"\n\n\
                        Свободных рабочих: "I"%d шт."W"\n\n\
                        Свободные рабочии появляются каждый час.", 300000 * till, undergroundbots_warehouse);
                        p_temp[playerid][p_listitem][40] = B_FREELANCE;
                        ShowPlayerDialog(playerid, D_BUY_MAGAZ, DIALOG_STYLE_MSGBOX, ""I"Аренда", STRING_GLOBAL, "Купить","Отмена");
                    }
                    case HOUSE_ID_RESOURCES:
                    {
                        new h = GetPlayerHouseID(playerid);
                        if(h == INVALID_HOUSE_ID) 
                        {
                            DeletePVar(playerid, "LoadResourcesHouseIDx");
                            return SendError(playerid, "У Вас нет дома.");
                        }
                        if(!IsPlayerInRangeOfPoint(playerid, 25.0, h_info[h][h_enter][0], h_info[h][h_enter][1], h_info[h][h_enter][2])) 
                        {
                            DeletePVar(playerid, "LoadResourcesHouseIDx");
                            return SendError(playerid, "Вы слишком далеко от дома.");
                        }
                        if(GetResourecesHouse(h) >= GetMaxResourcesHouse(h)) 
                        {
                            DeletePVar(playerid, "LoadResourcesHouseIDx");
                            return SendError(playerid, "На территории сада нет свободного места под грядку.");
                        }
                        totalresourceshouse++;
                        SendInfo(playerid, "С помощью кнопки ALT установите грядку в желаемом месте.");
                        ResourcesHouseInfo[totalresourceshouse][rhObject][1] = CreateObject(ItemsInfo[GetPVarInt(playerid, "LoadResourcesHouseIDx")][iModel], 0, 0, 0, 0, 0, 0);
                        AttachObjectToPlayer(ResourcesHouseInfo[totalresourceshouse][rhObject][1], playerid, 0, 1, - 0.8, 0, 0, 90);
                        SetPVarInt(playerid, "LoadResourcesHouse", totalresourceshouse + 1);
                    }
                    case HOUSE_ID_RESOURCES_BACK:
                    {
                        new h = GetPlayerHouseID(playerid);
                        if(h == INVALID_HOUSE_ID) return SendError(playerid, "У Вас нет дома.");
                        if(!IsPlayerInRangeOfPoint(playerid, 25.0, h_info[h][h_enter][0], h_info[h][h_enter][1], h_info[h][h_enter][2])) return SendError(playerid, "Вы слишком далеко от дома.");
                        for(new i = 0; i < 100; i++) p_temp[playerid][p_listitem][i] = -1;
                        STRING_GLOBAL = "[#] Дом\tТип\tID (написан возле грядки)\tОсталось дней\n", STRING_MIN[0] = EOS;
                        new count = 0;
                        for(new i = 1; i <= totalresourceshouse; i++)
                        {
                            if(ResourcesHouseInfo[i][rhHouseIDx] != h) continue;
                            f(STRING_MIN, ""I"[%d]"W" %d\t%s\t%d\t%d\n", count + 1, ResourcesHouseInfo[i][rhHouseIDx], ResourcesHouseInfo[i][rhObject][0] == 19473 ? "Хлопок" : "Лен", ResourcesHouseInfo[i][rhIDx], ResourcesHouseInfo[i][rhDay]);
                            strcat(STRING_GLOBAL, STRING_MIN);
                            p_temp[playerid][p_listitem][count] = i;
                            count++;
                        }
                        if(!count) return SendError(playerid, "На территории сада нет грядок хлопка и льна.");
                        ShowPlayerDialog(playerid, D_RES_HOUSE_BACK, DIALOG_STYLE_TABLIST_HEADERS, ""I"Забрать семена", STRING_GLOBAL, "Далее", "Отмена");
                    }
                }
                p_temp[playerid][p_listitem_int] = -1;
            }
            return 1;
        }
        /*case D_SELL_BIZZ_PLAYER:
        {
            if(!response) return 1;
