GetPick(playerid)
{
    new total = 0;
    STRING_GLOBAL[0] = EOS;
    for(new i; i < 7; i++)
    {
        if(strcmp(PickName[i], "None", false))
        {
            f(STRING_GLOBAL, "%s[%d] %s (Голосов: %d)\n", STRING_GLOBAL, i+1, PickName[i], PickVote[i]);
            total++;
        }
    }
    if(total == 0) f(STRING_GLOBAL, "Кандидатов нет.");
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Выборы", STRING_GLOBAL, "Отмена", "");
    return 1;
}
ResetPick()
{
    foreach(new i: Player)
    {
        if(!p_info[i][loggedIn]) continue;
        p_info[i][pick] = 0;
    }

    mysql_tquery(con_bd,"UPDATE `accounts` SET `pick` = 0 WHERE `pick` = 1", "");
    mysql_tquery(con_bd,"UPDATE `mayor` SET `pick` = 0", "");

    Pick = false;
    PickDate = 0;
    return 1;
}
forward load_mayor();
public load_mayor()
{
    new str[256], time = GetTickCount();
    if(cache_num_rows())
    {
        f_mysql_fetch_row_format(0, str, cache_num_fields());
        sscanf(str, "p<|>is[256]is[144]",
        Pick,
        PickNames,
        PickDate,
        PickVotes);
        sscanf(PickNames, "p<,>s[32]s[32]s[32]s[32]s[32]s[32]s[32]", PickName[0], PickName[1], PickName[2], PickName[3], PickName[4], PickName[5], PickName[6]);
        sscanf(PickVotes, "p<,>a<i>[7]", PickVote);
    }
    printf("Данные правительства загружены за %d мс", GetTickCount()-time);
    return 1;
}
