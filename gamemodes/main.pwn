forward load_graffiti();
public load_graffiti()
{
    new str[256], time = GetTickCount(), rows = cache_num_rows();
    if(rows)
    {
        for(new i; i < rows; i++)
        {
            f_mysql_fetch_row_format(i, str, cache_num_fields());
            sscanf(str, "p<|>iiffffff",
            GraffitiInfo[i][gID],
            GraffitiInfo[i][gMember],
            GraffitiInfo[i][gX],
            GraffitiInfo[i][gY],
            GraffitiInfo[i][gZ],
            GraffitiInfo[i][grX],
            GraffitiInfo[i][grY],
            GraffitiInfo[i][grZ]);
            totalgraffiti++;
            if(GraffitiInfo[i][gMember]) 
            {
                GraffitiInfo[i][gObject] = CreateDynamicObject(GraffitiObject[GraffitiInfo[i][gMember]-10], GraffitiInfo[i][gX], GraffitiInfo[i][gY], GraffitiInfo[i][gZ], GraffitiInfo[i][grX], GraffitiInfo[i][grY], GraffitiInfo[i][grZ]);
                SetGangGraffiti(GraffitiInfo[i][gMember], 1);
            }
            else GraffitiInfo[i][gObject] = CreateDynamicObject(18660, GraffitiInfo[i][gX], GraffitiInfo[i][gY], GraffitiInfo[i][gZ], GraffitiInfo[i][grX], GraffitiInfo[i][grY], GraffitiInfo[i][grZ]);

            GraffitiInfo[i][gObject] = CreateDynamicObject(18660, GraffitiInfo[i][gX], GraffitiInfo[i][gY], GraffitiInfo[i][gZ], GraffitiInfo[i][grX], GraffitiInfo[i][grY], GraffitiInfo[i][grZ]);

            GraffitiInfo[i][gArea] = CreateDynamicSphere(GraffitiInfo[i][gX], GraffitiInfo[i][gY], GraffitiInfo[i][gZ], 3.5);
            UpdateAreaInfo(GraffitiInfo[i][gArea], TYPE_GRAFFITI, AREA_SUBTYPE_INVALID_ID, i);
        }
    }
    for(new i = GROOVE; i <= VAGOS; i++) UpdateInfoFractionWarehouse(i);
    printf("Данные граффити загружены за %d мс", GetTickCount()-time);
    return 1;
}

