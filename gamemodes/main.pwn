forward leader_offline(playerid);
public leader_offline(playerid)
{
    new rows, named[MAX_PLAYER_NAME], leader_id, last_enter[16];
    cache_get_row_count(rows);
    if(!rows) return SendError(playerid, "Ничего не найдено.");

    STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;
    strcat(STRING_GLOBAL, "[#] Никнейм\tФракция\tПоследний вход\n");
    for(new i; i < rows; i++)
    {
        cache_get_value_name(i, "name", named, 24);
        cache_get_value_name_int(i, "leader", leader_id);
        cache_get_value_name(i, "lastenter", last_enter, 16);
        format(STRING_MIN, sizeof(STRING_MIN), ""I"[%d]"W" %s\t%s\t%s\n", i+1, named, GetFractionName(leader_id), last_enter);
        strcat(STRING_GLOBAL, STRING_MIN);
    }
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, ""I"Список лидеров", STRING_GLOBAL, "Отмена", "");
    return 1;
}

UpdatePlayerWorkSkill(playerid, work_id)
{
    if(p_info[playerid][job_skill][work_id] != SkillData[work_id][sMax])
    {
        new count = 1;

        if(p_info[playerid][p_vip])
        {
            if(p_info[playerid][p_vip] == 3 && p_info[playerid][p_add_vip] == 1) count = 4;
            else
            {
                switch(p_info[playerid][p_vip])
                {
                    case 1: count = 1;
                    case 2: count = 2;
                    case 3: count = 3;
                }
            }
        }

        p_info[playerid][job_skill_count][work_id] += count;
        if(p_info[playerid][job_skill_count][work_id] > SkillData[work_id][sCount])
        {
            p_info[playerid][job_skill_count][work_id] = 0;
            if(p_info[playerid][job_skill][work_id] != SkillData[work_id][sMax]) p_info[playerid][job_skill][work_id]++;
            if(p_info[playerid][job_skill][work_id] == SkillData[work_id][sMax])
            {
                if(work_id == 6 && p_info[playerid][block_theft_car_acc] == 1) {}
                else SetPlayerItem(playerid, 3, p_info[playerid][ID], TYPE_GIVE_ITEM_ACCESSORIES, SkillData[work_id][sAccessories]);
                if(work_id == 6 && p_info[playerid][block_theft_car_acc] == 0)
                {
                    p_info[playerid][block_theft_car_acc] = 1;
                    MysqlUpdatePlayerInt(playerid, "block_theft_car_acc", p_info[playerid][block_theft_car_acc]);
                }
            }
            SendAccess(playerid, "Ваш навык на \"%s\" повышен до %d уровня.", SkillData[work_id][sName], p_info[playerid][job_skill][work_id]);
        }
        SavePlayerWorkSkill(playerid);
    }
}

SavePlayerWorkSkill(playerid)
{
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d",
    p_info[playerid][job_skill][0], p_info[playerid][job_skill][1], p_info[playerid][job_skill][2],
    p_info[playerid][job_skill][3], p_info[playerid][job_skill][4], p_info[playerid][job_skill][5],
    p_info[playerid][job_skill][6], p_info[playerid][job_skill][7], p_info[playerid][job_skill][8],
    p_info[playerid][job_skill][9], p_info[playerid][job_skill][10], p_info[playerid][job_skill][11],
    p_info[playerid][job_skill][12], p_info[playerid][job_skill][13], p_info[playerid][job_skill][14],
    p_info[playerid][job_skill][15], p_info[playerid][job_skill][16], p_info[playerid][job_skill][17],
    p_info[playerid][job_skill][18], p_info[playerid][job_skill][19], p_info[playerid][job_skill][20],
    p_info[playerid][job_skill][21], p_info[playerid][job_skill][22]);
    MysqlUpdatePlayerStr(playerid, "job_skill_new", STRING_GLOBAL);
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d",
    p_info[playerid][job_skill_count][0], p_info[playerid][job_skill_count][1], p_info[playerid][job_skill_count][2],
    p_info[playerid][job_skill_count][3], p_info[playerid][job_skill_count][4], p_info[playerid][job_skill_count][5],
    p_info[playerid][job_skill_count][6], p_info[playerid][job_skill_count][7], p_info[playerid][job_skill_count][8],
    p_info[playerid][job_skill_count][9], p_info[playerid][job_skill_count][10], p_info[playerid][job_skill_count][11],
    p_info[playerid][job_skill_count][12], p_info[playerid][job_skill_count][13], p_info[playerid][job_skill_count][14],
    p_info[playerid][job_skill_count][15], p_info[playerid][job_skill_count][16], p_info[playerid][job_skill_count][17],
    p_info[playerid][job_skill_count][18], p_info[playerid][job_skill_count][19], p_info[playerid][job_skill_count][20],
    p_info[playerid][job_skill_count][21], p_info[playerid][job_skill_count][22]);
    MysqlUpdatePlayerStr(playerid, "job_skill_count_new", STRING_GLOBAL);
}

