        sscanf(string, "p<,>ii", SmsPrice[0], CallPrice[0]);

        cache_get_value_name(0, "newspricesf", string, 144); // news
        sscanf(string, "p<,>ii", SmsPrice[1], CallPrice[1]);

        cache_get_value_name_int(0, "Donate",ServerInfo[Donate]);
        cache_get_value_name_int(0, "DonationMultiplier", ServerInfo[DonationMultiplier]);
        if(ServerInfo[DonationMultiplier] <= 0) ServerInfo[DonationMultiplier] = 1;

