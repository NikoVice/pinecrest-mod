                SendError(playerid, "Никнейм не может быть более 24 символов.");
                return 1;
            }
            if(strequals(get_name(playerid), inputtext))
            {
                ShowPlayerDialog(playerid, D_SELECT_REFERAL, DIALOG_STYLE_INPUT, ""I"Реферальная система", ""W"\
                Если на сервер Вас пригласил друг или знакомый человек, Вы оба\n\
                сможете получить бонус с помощью "I"реферальной системы."W"\n\n\
                Введите никнейм пригласившего Вас игрока в поле ниже:", "Далее", "Пропустить");
                SendError(playerid, "Вы ввели свой никнейм.");
                return 1;
            }
            for(new i = strlen(inputtext)-1; i != -1; i--)
            {
                switch(inputtext[i])
                {
                    case '0'..'9', '_','a'..'z', 'A'..'Z': continue;
                    default:
                    {
                        ShowPlayerDialog(playerid, D_SELECT_REFERAL, DIALOG_STYLE_INPUT, ""I"Реферальная система", ""W"\
                        Если на сервер Вас пригласил друг или знакомый человек, Вы оба\n\
                        сможете получить бонус с помощью "I"реферальной системы."W"\n\n\
                        Введите никнейм пригласившего Вас игрока в поле ниже:", "Далее", "Пропустить");
                        SendError(playerid, "Вы ввели запрещенный символы (исп. a-z, A-Z, 0-9).");
                        return 1;
                    }
                }
            }

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id` FROM `accounts` WHERE `name` = '%s' LIMIT 1",
            nickname);
            new Cache:result = mysql_query(con_bd, STRING_GLOBAL);

