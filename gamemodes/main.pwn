        case D_TUNE_DEFAULT_ACT:
        {
            if(!response)
            {
                if(p_temp[playerid][TextDrawServiceTune] != true) ShowDialogTuneDefault(playerid);
                return 1;
            }
            if(!IsPlayerInAnyVehicle(playerid) || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
                return Service_Error(playerid, "�� ������ ���������� � ������������ ��������.");
            new vehicleid = GetPlayerVehicleID(playerid);
            new tune_id = p_temp[playerid][p_listitem][1], count_component = p_temp[playerid][p_listitem][5];
            if(p_temp[playerid][p_listitem][0] != vehicleid)
                return Service_Error(playerid, "ID ���������� �� ��������� � ��������������, �������������� �������� ����������� ��������.");
            if(tune_id == v_hydraulics)
            {
                if(veh_info[vehicleid][v_tune][tune_id] == 1087)
                {
                    SendAccess(playerid, "������ ��������� ���� � ������ ������������� ��������.");
                    veh_info[vehicleid][v_tune][tune_id] = 0;
                    RemoveVehicleComponent(vehicleid, veh_info[vehicleid][v_tune][tune_id]);

                    Log(LOG_player, INFO, "%s[%d](%s %s) ������ ������� ��������(����������) ������� � <%s>(%d)[%d] | #Tuning",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id]);
                }
                else
                {
                    new till = Service_GetTill(playerid);
                    if(till == -1) return Service_Error(playerid, "�� ������ ID �����������, �������������� �������� ����������� ��������.");

                    new price = 200000 * till;
                    if(p_info[playerid][cash] < price) return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate"), ShowDialogTuneDefault(playerid);
                    Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] ����� ������� ������� ������� �� <%s>(%d)[%d] �� %d$",
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                        GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id], price);

                    BuyPlayerService(playerid, price);
                    PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
                    SendAccess(playerid, "�� ���������� ������ ���������.");
                    veh_info[vehicleid][v_tune][tune_id] = 1087;
                    VEx_AddVehicleComponent(vehicleid, veh_info[vehicleid][v_tune][tune_id]);
                }
                SaveVehicleTuning(vehicleid);

                switch(p_temp[playerid][p_listitem][1])
                {
                    case v_exhausts: SetCameraForPlayer(playerid, CAMERA_ID_BACK);
                    case v_wheels: SetCameraForPlayer(playerid, CAMERA_ID_SIDE_LEFT_FRONT);
                    case v_nitro: SetCameraForPlayer(playerid, CAMERA_ID_BACK);
                    case v_pear_bumper: SetCameraForPlayer(playerid, CAMERA_ID_BACK);
                    case v_lamps: SetCameraForPlayer(playerid, CAMERA_ID_FRONT);
                    case v_paintjob: SetCameraForPlayer(playerid, CAMERA_ID_FRONT);
                    case v_spoiler: SetCameraForPlayer(playerid, CAMERA_ID_BACK);
                    case v_hoods: SetCameraForPlayer(playerid, CAMERA_ID_BACK);
                    case v_roofs: SetCameraForPlayer(playerid, CAMERA_ID_FRONT);
                    case v_front_bumper: SetCameraForPlayer(playerid, CAMERA_ID_FRONT);
                    case v_vents: SetCameraForPlayer(playerid, CAMERA_ID_FRONT);
                    case v_sideskirt: SetCameraForPlayer(playerid, CAMERA_ID_SIDE_LEFT_FRONT);
                }

                if(p_temp[playerid][TextDrawServiceTune]) Interface_Show(playerid, SERVICE_TUNE_EXTERNAL);
                else ShowDialogTuneDefault(playerid);
                return 1;
            }
            if(!listitem)
            {
                if(veh_info[vehicleid][v_tune][tune_id] == 0)
                {
                    SendError(playerid, "������ ��������� �� ����������.");
                    if(p_temp[playerid][TextDrawServiceTune]) Interface_Show(playerid, SERVICE_TUNE_EXTERNAL);
                    else ShowDialogTuneDefault(playerid);
                    return 1;
                }
                veh_info[vehicleid][v_tune][tune_id] = 0;
                if(tune_id == v_paintjob) ChangeVehiclePaintjob(vehicleid, 3);
                else RemoveVehicleComponent(vehicleid, veh_info[vehicleid][v_tune][tune_id]);
                SendAccess(playerid, "������ ��������� ���� � ������ ������������� ��������.");
                SaveVehicleTuning(vehicleid);
                if(p_temp[playerid][TextDrawServiceTune]) Interface_Show(playerid, SERVICE_TUNE_EXTERNAL);
                else ShowDialogTuneDefault(playerid);

                Log(LOG_player, INFO, "%s[%d](%s %s) ������ ������� �������� ������� � <%s>(%d)[%d] | #Tuning",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    GetVehicleName(vehicleid), veh_info[vehicleid][v_model], veh_info[vehicleid][v_mysql_id]);
                return 1;
            }
            if(count_component == -1)
            {
                SendError(playerid, "�� ������ ������������ �������� ��� �������.");
                if(p_temp[playerid][TextDrawServiceTune]) Interface_Show(playerid, SERVICE_TUNE_EXTERNAL);
                else ShowDialogTuneDefault(playerid);
                return 1;
            }
            new till = Service_GetTill(playerid);
            if(till == -1) return Service_Error(playerid, "�� ������ ID �����������, �������������� �������� ����������� ��������.");

            if(tune_id == v_nitro) p_temp[playerid][shop_id] = 1;
            else p_temp[playerid][shop_id] = 0;

            if(p_temp[playerid][TextDrawServiceTune])
                Interface_Show(playerid, SERVICE_TUNE_EXTERNAL_VIEW);
            else
            {
                p_temp[playerid][shop_id] = 0;
                STRING_GLOBAL[0] = EOS;
                f(STRING_GLOBAL, "%d$", GetPriceTuneElement(tune_id, p_temp[playerid][shop_id]) * till);
                ShowTextDrawForPlayer(playerid, TD_ID_SHOP);
                PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], STRING_GLOBAL);
            }
            if(tune_id == v_paintjob) ChangeVehiclePaintjob(vehicleid, p_temp[playerid][shop_id]);
            else
            {
                VEx_AddVehicleComponent(vehicleid, p_temp[playerid][e_tListComponents][p_temp[playerid][shop_id]]);
                if(tune_id == v_sideskirt || tune_id == v_vents) VEx_AddVehicleComponent(vehicleid, p_temp[playerid][e_tListComponents][p_temp[playerid][shop_id]]);
            }
            return 1;
        }
        case D_CHANGE_VEHICLE_COLOR:
        {
            if(!response)
            {
                if(p_temp[playerid][paint_veh_go] == 0) return ShowDialogTuneMain(playerid);
                p_temp[playerid][paint_veh_go] = 0;
                return 1;
            }
            if(!IsPlayerInAnyVehicle(playerid)) return Service_Error(playerid, "�� ������ ���������� � ������������ ��������.");
            new vehicleid = GetPlayerVehicleID(playerid), v_color1, v_color2;
            if(sscanf(inputtext, "p<,>ii", v_color1, v_color2))
            {
                if(p_temp[playerid][paint_veh_go] == 0) ShowDialogTuneMain(playerid);
                return SendError(playerid, "���� ����� ������� ����� �������, ������ - ��������, ������ ��������������(���� ���������� ������������).");
            }
            if(!(0 <= v_color1 <= 126) || !(0 <= v_color2 <= 126))
            {
                if(p_temp[playerid][paint_veh_go] == 0) ShowDialogTuneMain(playerid);
                return SendError(playerid, "���� ����� ���� �� ����� 0 � �� ����� 126.");
            }
            if(p_temp[playerid][paint_veh_go] == 0)
            {
                new till = Service_GetTill(playerid);
                if(till == -1) return Service_Error(playerid, "�� ������ ID �����������, �������������� �������� ����������� ��������.");

                new price = 5000 * till;

                if(p_info[playerid][cash] < price) return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate"), ShowDialogTuneMain(playerid);
                SendAccess(playerid, "�� ����������� ������������ �������� � ���.");

                Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] ����� ���������� �� <%s>(%d)[%d] �� %d$",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                    GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id], price);

                BuyPlayerService(playerid, price);
                ShowDialogTuneMain(playerid);
            }
            else
            {
                if(p_info[playerid][paintball] <= 0) return SendError(playerid, "� ��� ��� ���������� � �������.");
                SendAccess(playerid, "�� ����������� ������������ �������� � ������� ��������� � �������.");

                p_temp[playerid][paint_veh_go] = 0;
                p_info[playerid][paintball] = 0;

                MeAction(playerid, "����������(-�) ������������ �������� ����������");
                save_player(playerid);
            }
            veh_info[vehicleid][v_color][0] = v_color1;
            veh_info[vehicleid][v_color][1] = v_color2;
            ChangeVehicleColor(vehicleid, v_color1, v_color2);

            SaveVehicle(vehicleid);
            RepairVehicle(vehicleid);
            return 1;
        }
        case D_APANEL:
