forward fixCameraProperty(type, playerid, typeId, Float:hx2, Float:hy2, Float:hz);
public fixCameraProperty(type, playerid, typeId, Float:hx2, Float:hy2, Float:hz)
{
    switch(type)
    {
        case 0:
        {
            new cost_house = h_info[typeId][h_value], list_percent[3] = {95, 90, 85}, vip_idx = p_info[playerid][p_vip];
            if(vip_idx) cost_house = ((h_info[typeId][h_value] / 100) * list_percent[vip_idx - 1]);

            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, ""W"\
                Номер дома: %d\n\
                Класс дома: %s\n\
                Стоимость дома: %d$", typeId, house_class[h_info[typeId][h_squar]-1], cost_house);
            ShowPlayerDialog(playerid, D_REALTOR_HOUSE_INFO, DIALOG_STYLE_MSGBOX, ""I"Дом", STRING_GLOBAL, "GPS", "Отмена");
        }
        case 1:
        {
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, ""W"\
                Номер бизнеса: %d\n\
                Название бизнеса: %s\n\
                Тип бизнеса: %s\n\
                Стоимость бизнеса: %d$", typeId, b_info[typeId][_name], bizz_type_name[b_info[typeId][_tip]], b_info[typeId][_price]);
            ShowPlayerDialog(playerid, D_REALTOR_BIZZ_INFO, DIALOG_STYLE_MSGBOX, ""I"Бизнес", STRING_GLOBAL, "GPS", "Отмена");
        }
        case 2:
        {
            new cost_house = h_info[typeId][h_value], list_percent[3] = {95, 90, 85}, vip_idx = p_info[playerid][p_vip];
            if(vip_idx) cost_house = ((h_info[typeId][h_value] / 100) * list_percent[vip_idx - 1]);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, ""W"\
                Номер дома: %d\n\
                Класс дома: %s\n\
                Стоимость дома: %d$\n\n", typeId, house_class[h_info[typeId][h_squar]-1], cost_house);
            f(STRING_GLOBAL, "%s\
                "I"[1]"W" Субсидия: %s\n\
                "I"[2]"W" Подселение: %s\n\
                "I"[3]"W" Подвал: %s\n\
                "I"[4]"W" Подпольное помещение: %s\n\n", STRING_GLOBAL,
                h_info[typeId][h_improve][SUBSIDY] == 1 ?  ("{008000}Есть"):("{FF0000}Нет"), h_info[typeId][h_improve][RENTERS] == 1 ?  ("{008000}Есть"):("{FF0000}Нет"),
                h_info[typeId][h_improve][BASEMENT] == 1 ?  ("{008000}Есть"):("{FF0000}Нет"), h_info[typeId][h_improve][UNDERGROUND] == 1 ?  ("{008000}Есть"):("{FF0000}Нет"));

            new count[3];

            for(new i = 1; i <= totalpanel; i++)
            {
                if(PanelHouseInfo[i][PanelHouseIDx] != typeId) continue;
                f(STRING_GLOBAL, "%s"I"[%d]"W" Солнечная панель (%d дн.)\n", STRING_GLOBAL, count[2] + 1, PanelHouseInfo[i][PanelHouseDay]);
                count[0]++;
            }
            if(count[0] != 0) strcat(STRING_GLOBAL, "\n\n");
            for(new i = 1, str_count; i <= totalvideocards; i++)
            {
                if(VideoCardsInfo[i][vcHouseIDx] != typeId) continue;
                f(STRING_GLOBAL, "%s"I"[%d]"W" Видеокарта (%d ур.)%s", STRING_GLOBAL, count[1] + 1, VideoCardsInfo[i][vcLevel], str_count == 2 ? "\n" : "\t");
                count[1]++;
                str_count++;
                if(str_count == 3) str_count = 0;
            }
            if(count[1] != 0) strcat(STRING_GLOBAL, "\n\n");
            for(new i = 1, str_count; i <= totalundergroundbots; i++)
            {
                if(UndergroundBotsInfo[i][ubHouseIDx] != typeId) continue;
                f(STRING_GLOBAL, "%s"I"[%d]"W" Рабочий (%s)%s", STRING_GLOBAL, count[2] + 1, UndergroundBotsName[UndergroundBotsInfo[i][ubEducation] - 1], str_count == 2 ? "\n" : "\t");
                count[2]++;
                str_count++;
                if(str_count == 3) str_count = 0;
            }
            ShowPlayerDialog(playerid, D_EXCHANGE_PREVIEW_INFO, DIALOG_STYLE_MSGBOX, ""I"Дом", STRING_GLOBAL, "Назад", "");
        }
        case 3:
        {
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "SELECT * FROM `bizz_finka` WHERE `bizz_id` = %d LIMIT 1", b_info[typeId][b_mysql_id]);
            mysql_tquery(con_bd, STRING_GLOBAL, "OnLoadStatsBizz", "iii", playerid, typeId, 1); 
        }
    }
    return 1;
}


forward FractionMemberInfo(playerid);
public FractionMemberInfo(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(rows)
    {
        new member_name[MAX_PLAYER_NAME], rang_id, fwarns, getlastenter[20];
        cache_get_value_name(0, "name", member_name);
        cache_get_value_name_int(0, "rang", rang_id);
        cache_get_value_name_int(0, "fwarn", fwarns);
        cache_get_value_name(0, "lastenter", getlastenter);

        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL, ""W"Имя: "I"%s\n"W"Ранг: "I"%s(%d)\n"W"Предупреждения: "I"%d\n\n"W"Последний вход: "I"%s",
            member_name, GetFractionRangName(p_info[playerid][member], rang_id), rang_id, fwarns, getlastenter);
        ShowPlayerDialog(playerid, D_FRACTION_MEMBER_INFO, DIALOG_STYLE_MSGBOX, ""I"Информация об игроке", STRING_GLOBAL, "Назад", "" );
    }
    if(!rows) UpdatePlayerList(playerid);
    return 1;
}

ShowBankDeposit(playerid)
{
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
    Банковский вклад — сумма денег, переданная лицом кредитному учреждению с целью получить доход\n\
    в виде процентов, образующихся в ходе финансовых операций с вкладом каждый час с 08:00 до 22:00.\n\n\
    Процентная ставка: "I"%f."W"\n\n\
    Состояние банковского вклада: "I"$%d."W"\n\
    Максимальное состояние банковского вклада: "I"$%d."W"\n\n\
    Дополнительная информация:\n\n\
    \t— Снимать деньги с банковского вклада можно не менее чем через 5 часов с момента послденего пополнения.\n\n\
    Чтобы {"#cLIGHTRED"}снять"W" или {"#cGREEN"}положить"W" деньги, введите количество:", deposit_percent, p_info[playerid][bank_deposit], max_deposit);
    ShowPlayerDialog(playerid, D_BANK_DEPOSIT, DIALOG_STYLE_INPUT, ""I"Банковский вклад", STRING_GLOBAL, "Положить", "Снять");
    return 1;
}

IsPlayerNearDice(playerid)
{
    for(new i; i < sizeof(BoneCoor); i++)
    {
        if(IsPlayerInRangeOfPoint(playerid, 2.5, BoneCoor[i][0], BoneCoor[i][1], BoneCoor[i][2])) return i;
    }
    return -1;
}

SetMoney(playerid, money, visible_3dtext, reason[])
{
    if(playerid == INVALID_PLAYER_ID) return 1;
    if(strlen(reason) != 0 && money != 0)
    {
        // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) <действие> [цена действия]
        Log(LOG_player, INFO, "%s[%d](%s %s)[%d$] %s | %d$ | #SetPlayerMoney",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
            reason, money);
        if(money > 1000000)
        {
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "[WARNING] [ПРОВЕРИТЬ] %s[%d] %s.", get_name(playerid), playerid, reason);
            SendAdminMessage(COLOR_RED, STRING_GLOBAL);
        }
    }
    p_info[playerid][cash] += money;
    MysqlUpdatePlayerInt(playerid, "money", p_info[playerid][cash]);

    if(p_info[playerid][cash] < 0)
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s[%d] ЗАБАГАЛ ДЕНЬГИ В МИНУС ЧЕРЕЗ %s (!!!)",  get_name(playerid), playerid, reason);
        SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `table_ban` (`Name_Admin`, `Name_Player`, `Ban_Data`, `Unban_Data`, `Ban_Reason`) VALUES ('System', '%e', NOW(), %d, 'Багоюз денег в минус через %e')",
            get_name(playerid), timestamp + (30 * 86400), reason);
        mysql_tquery(con_bd, STRING_GLOBAL);

        Kick(playerid);
    }

    if(p_info[playerid][cash] > 1000000 && p_info[playerid][level] < 3)
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[WARNING] [TWINK-MONEY] %s [%d] LEVEL: %d | MONEY: %d.", get_name(playerid), playerid, p_info[playerid][level], p_info[playerid][cash]);
        SendAdminMessage(COLOR_RED, STRING_GLOBAL);
    }

    /*if(p_info[playerid][cash] > 100000 && p_info[playerid][level] >= 5)
    {
        SendInfo(playerid, "У Вас большое количество денежных средств на руках.");
        SendInfo(playerid, "Члены мафии могут Вас ограбить.");
        SendInfo(playerid, "Чтобы не потерять большое количество денежных средств, переведите их на банковский счет.");
    }*/

    if(visible_3dtext == 1){
        new string[55];
        if(money > 0)
        {
            format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~g~+%d$", money);
            PlayerPlaySound(playerid, 1083, 0.0, 0.0, 0.0);
        }
        else
        {
            format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~r~%d$", money);
            PlayerPlaySound(playerid, 1085 , 0.0, 0.0, 0.0);
        }
        GameTextForPlayer(playerid, string, 1000, 3);
    }

    ResetPlayerMoney(playerid);
    GivePlayerMoney(playerid, p_info[playerid][cash]);
    return 1;
}

PlayStream(playerid, url[], Float:posX = 0.0, Float:posY = 0.0, Float:posZ = 0.0, Float:distance = 100.0, usepos = 0)
{
    if(p_info[playerid][p_settings][STATUS_BOOMBOX] == 1) return 1;
    if(GetPVarInt(playerid, "UseMusic")) return 1;
    if(GetPVarInt(playerid, "UseMusicVehicle")) return 1;
    if(GetPVarType(playerid, "pAudioStream")) StopAudioStreamForPlayer(playerid);
    else SetPVarInt(playerid, "pAudioStream", 1);
    PlayAudioStreamForPlayer(playerid, url, posX, posY, posZ, distance, usepos);
    return 1;
}

StopStream(playerid)
{
    DeletePVar(playerid, "pAudioStream");
    StopAudioStreamForPlayer(playerid);
}

PickUpBoombox(playerid)
{
    foreach(new i:Player)
    {
        if(IsPlayerInDynamicArea(i, p_temp[playerid][music_area]))
        {
            StopStream(i);
        }
    }

    if(p_temp[playerid][music_object] != INVALID_OBJECT_ID) DestroyDynamicObject(p_temp[playerid][music_object]);
    if(p_temp[playerid][music_label] != INVALID_3DTEXT_ID) DestroyDynamic3DTextLabel(p_temp[playerid][music_label]);
    if(p_temp[playerid][music_area] != -1) DestroyDynamicArea(p_temp[playerid][music_area]);
    p_temp[playerid][music_area] = -1;
    p_temp[playerid][music_label] = INVALID_3DTEXT_ID;
    p_temp[playerid][music_object] = INVALID_OBJECT_ID;
    DeletePVar(playerid, "BBStation");
    return 1;
}

CMD:music(playerid, params[])
{
    ShowPlayerDialog(playerid, D_BOOMBOX, DIALOG_STYLE_LIST, ""I"Музыкальный проигрыватель", ""I"[1]"W" Поставить\n"I"[2]"W" Включить\n"I"[3]"W" Забрать", "Далее", "Отмена");
    return 1;
}

CMD:dmusic(playerid, params[])
{
    if(p_info[playerid][admin] < 3) return 1;
    foreach(new i: Player)
    {
        if(!p_info[i][loggedIn]) continue;
        if(p_temp[i][music_area] == -1) continue;
        if(IsPlayerInDynamicArea(i, p_temp[playerid][music_area]))
        {
            PickUpBoombox(i);
            break;
        }
    }
    return 1;
}

CMD:radio(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Вы должны находиться в транспортном средстве.");
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "Вы должны находиться на месте водителя.");
    if(GetVehicleData(GetVehicleModelEx(GetPlayerVehicleID(playerid)), E_VD_TYPE) == VEHICLE_STATE_VELO_MOPED) return SendError(playerid, "В данном транспортном средстве нет радио.");
    ShowPlayerRadio(playerid, RADIO_TYPE_CAR);
    return 1;
}

