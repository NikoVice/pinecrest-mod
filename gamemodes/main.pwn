        � �������� ���� �� ������������� � � �������� ����������, ��������� ������� ����� �������� �� �������\n\
        ����������� ��������, � � �������� ���������� ������, � ������ ������� �� ��������� ����� ����� �� ����.\n\n\
        �� ���� ������������ ���� �������� ������ ����� ����� � ������� "I"\"������ �� ����\""W" ("I"/mn > [4] ������ ��\n\
        ����"W") ��� ���������� � ������������� ("I"/ask"W" | "I"/report"W"). ������ �����!", p_info[playerid][name]);
        ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"� ���� ������?", STRING_GLOBAL, "��", "");
        return 1;
    }
    if(pickupid == CREATE_FIMILY)
    {
        p_temp[playerid][TickPickup] = GetTickCount()+7500;
        if(GetPlayerFamilyID(playerid) != -1)
        return SendError(playerid, "�� ��� �������� � �����.");

        if(family_count >= MAX_FAMILY-1)
            return SendError(playerid, "���������� ����� ��������� ������.");

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof STRING_GLOBAL, "\
            "W"�������� ����� �����: "I"500 Pinecrest Money\n\
            "W"����� �����: {FF9900}%d\n\
            "W"������� �������� �����:\n\n\
            {AFAFAF}���������� �������� ���������� �������� �� 3 �� 20", family_count);

        ShowPlayerDialog(playerid, D_FAMILY_CREATE, DIALOG_STYLE_INPUT, ""I"�������� �����", STRING_GLOBAL, "�������", "�����");
        return 1;
    }
    else if(pickupid == job_invite)
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK) return SendError(playerid, "�� �� ��������� ������� ���� �� ������� ������.");
        STRING_GLOBAL[0] = EOS;

        f(STRING_GLOBAL, "\
            "I"[1]"W" ��������� ����� (%d �������)\n\
            "I"[2]"W" �������� �������� (%d �������)\n\
            "I"[3]"W" ����������� (%d �������)\n\
            "I"[4]"W" ���������� (%d �������)\n\
            "I"[5]"W" ��������� ����� (%d �������)\n\
            "I"[6]"W" �������� ������ (%d �������)\n\
            "I"[7]"W" �������� ������� (%d �������)\n\
            "I"[8]"W" �������� (%d �������)\n\
            "I"[9]"W" ����� (%d �������)\n\
            "I"[10]"W" ��������� ������� (%d �������)\n\
            "I"[11]"W" �������� (%d �������)\n\
            "I"[12]"W" �������� (%d �������)",
            level_pizzaboy, level_bus, level_mechanic,
            level_collector, level_roadman, level_train,
            level_tram, level_fireman, level_pilot,
            level_panel, level_electric, level_oil);
        ShowPlayerDialog(playerid, D_SELECT_JOB, DIALOG_STYLE_LIST, ""I"���������� �� ������",STRING_GLOBAL, "�����", "�������");
        return 1;
    }
    else if(pickupid == FamilyPickup[0]) // (����);
    {
        if(p_info[playerid][family_id] == -1 ||
            GetPlayerFamilyID(playerid) == -1) return SendError(playerid, "�� �� �������� � �����.");
        if(FamilyData[GetPlayerFamilyID(playerid)][fOffice] != 1) return SendError(playerid, "� ����� ����� ��� �����.");
        ShowPlayerDialog(playerid, D_FAMILY_ENTER, DIALOG_STYLE_LIST, ""I"���� �����?", ""I"[1]"W" ������\n"I"[2]"W" ��������� ��������", "�������", "������");
        return 1;
    }
    else if(pickupid == FamilyPickup[1]) // (�����);
    {
        ShowPlayerDialog(playerid, D_FAMILY_EXIT, DIALOG_STYLE_LIST, ""I"���� �����?", ""I"[1]"W" �� �����\n"I"[2]"W" ��������� ��������", "�������", "������");
        return 1;
    }
    else if(pickupid == FamilyPickup[2]) // (�����);
    {
        if(GetPlayerVirtualWorld(playerid) == p_temp[playerid][parking_id]+5000)
        {
            new park_id = p_temp[playerid][parking_id];
            p_temp[playerid][parking_id] = -1;
            SetPlayerPos(playerid, ParkData[park_id][p_enter][0], ParkData[park_id][p_enter][1], ParkData[park_id][p_enter][2]); //�����
            SetPlayerFacingAngle(playerid, ParkData[park_id][p_enter][3]);
            SetPlayerInterior(playerid, 0);
            SetPlayerVirtualWorld(playerid, 0);
        }
        else if(GetPlayerVirtualWorld(playerid) == 5500)
        {
            SetPlayerPos(playerid, 1087.2070,-1375.6184,13.5087);
            SetPlayerFacingAngle(playerid, 270.0000);
            SetPlayerInterior(playerid, 0);
            SetPlayerVirtualWorld(playerid, 0);
        }
        else ShowPlayerDialog(playerid, D_FAMILY_GARAGE, DIALOG_STYLE_LIST, ""I"���� �����?", ""I"[1]"W" ������\n"I"[2]"W" �� �����", "�������", "������");
        return 1;
    }
    else if(pickupid == FamilyPickup[3]) // (���������);
    {
        ShowFamilyContracts(playerid);
        return 1;
    }
    if(pickupid >= PickPickup[0] && pickupid <= PickPickup[5])
    {
        if(Pick == false) return SendError(playerid, "� ����� ��� �������.");
        if(p_info[playerid][level] < 3) return SendError(playerid, "��������� ������� � ������� ����� � 3-��� ������.");
        if(p_info[playerid][pick] > 0) return SendError(playerid, "�� ��� ���������� �� ���� �������.");
        new total = 0;
        STRING_GLOBAL[0] = EOS;
        for(new i; i < 7; i++)
        {
            if(strcmp(PickName[i], "None", false))
            {
                f(STRING_GLOBAL, "%s"I"[%d]"W" %s\n", STRING_GLOBAL, i+1, PickName[i]);
                total++;
            }
        }
        if(total == 0) strcat(STRING_GLOBAL, "���������� ���."), ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"������", STRING_GLOBAL, "������", "");
        else ShowPlayerDialog(playerid, D_PICK, DIALOG_STYLE_LIST, ""I"������", STRING_GLOBAL, "�����", "������");
        return 1;
    }
    if(pickupid == WarehousePickup[0])
    {
        if(army(playerid) || gang(playerid) || mafia(playerid) || biker(playerid))
        {
            if(p_temp[playerid][LoadCount] != 0) return SendError(playerid, "� ��� ��� ���� ���� � ��������� � �����������, �������� ��� � ������������ ��������.");

            if(GetFractionWarehouse(NATIONAL_GUARD, fwMate) < 500) return SendError(playerid, "�� ������ ��� ������� ����������.");
            if(GetFractionWarehouse(NATIONAL_GUARD, fwPatron) < 500) return SendError(playerid, "�� ������ ��� ������� ��������.");

            SetPlayerAttachedObject(playerid, 1, 2358, 6, 0.0, 0.10, -0.2, -110.0, 0.0, 78.0, 1.000000, 1.000000, 1.000000);
            ClearAnimations(playerid);
            ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 1, 0, 0, 1, 1);
            //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);

            SetFractionWarehouse(NATIONAL_GUARD, fwMate, -500);
            SetFractionWarehouse(NATIONAL_GUARD, fwPatron, -500);

            UpdateWarehouseInfo(0);

            p_temp[playerid][LoadCount] = 1;

            SendAccess(playerid, "�� ����� ���� � ��������� � �����������, �������� ��� � ������������ ��������.");
            SendInfo(playerid, "����� ��������� ����, ������� /end");
        }
        else SendError(playerid, "�� �� ������ ������������ ������ �������.");
        return 1;
    }
    if(pickupid == WarehousePickup[1])
    {
        if(p_info[playerid][member] == 0) return SendError(playerid, "�� �� �������� �� �������.");
        if(GetFactionType(p_info[playerid][member]) != FACTION_TYPE_GOS) return SendError(playerid, "�� �� �������� � ���. �������.");
        if(p_info[playerid][rang] < 9) return SendError(playerid, "�������� ���. ���������� �� �������� �������� � ���������� �������� ������� � ������������.");
        if(army(playerid)) return SendError(playerid, "��� ����� ����������� ���������� ���. ���������.");
        ShowWarehouseInfo(playerid);
        return 1;
    }
    if(pickupid == WarehousePickup[2])
    {
        if(IsPlayerFractionMedic(playerid))
        {
            if(p_temp[playerid][LoadCount] != 0) SendError(playerid, "� ��� ��� ���� ����� � �������������.");
            else
            {
                if(WarehouseMedicines < 500) return SendError(playerid, "�� ������ ��� ������� ������������.");

                SetPlayerAttachedObject(playerid, 1, 1279, 6, 0.0, 0.10, -0.2, -110.0, 0.0, 78.0, 1.000000, 1.000000, 1.000000);
                ClearAnimations(playerid);
                ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 1, 0, 0, 1, 1);
                //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);

                WarehouseMedicines -= 500;
                MysqlUpdateOtherInt("warehouse_medicines", WarehouseMedicines);

                UpdateWarehouseInfo(1);

                p_temp[playerid][LoadCount] = 1;

                SendAccess(playerid, "�� ����� ����� � �������������, �������� ��� � ������������ ��������.");
                SendInfo(playerid, "����� ��������� �����, ������� /end");
            }
        }
        else SendError(playerid, "�� �� ������ ������������ ������ �������.");
        return 1;
    }
    return 1;
}

public OnPlayerPickUpPickup(playerid, pickupid)
{
    if(p_info[playerid][loggedIn] != 1) return 0;
    //SendDebug(playerid, "event Pickup id %d | old: %d | dynamic: %d", pickupid, p_temp[playerid][OldPickupID], p_temp[playerid][EventPickupID]);

    if(p_temp[playerid][OldPickupID] == pickupid) return 1;
    p_temp[playerid][OldPickupID] = pickupid;
    if(p_temp[playerid][EventPickupID] != -1) return 1;
    if(GetTickCount() - p_temp[playerid][TickPickup] < 15000)
        return 1;
    p_temp[playerid][TickPickup] = GetTickCount();
    GetPlayerPos(playerid, p_temp[playerid][PickupPosX], p_temp[playerid][PickupPosY], p_temp[playerid][PickupPosZ]);

    if(pickupid == pickup_drugden[2])
    {
        ShowDrugDenMenu(playerid, TYPE_DRUGDEN_MAIN);
        return 1;
    }

    if(pickupid == pickup_drugden[3])
    {
        ShowDrugDenMenu(playerid, TYPE_DRUGDEN_STREET);
        return 1;
    }

    if(pickupid == pickup_fish)
    {
        ShowFishMenu(playerid, MENU_FISH_MAIN);
        return 1;
    }

    if(pickupid == pickup_hunting)
    {
        ShowDialogHunting(playerid, HUNTING_MENU);
        return 1;
    }

    if(pickupid == pickup_change_civil_coins)
    {
        ShowChangeCivilCoins(playerid);
        return 1;
    }

    if(pickupid >= pickup_mission[0] && pickupid <= pickup_mission[3])
    {
        ShowPlayerMission(playerid, MISSION_TYPE_START_TASK, 0);
        return 1;
    }

    if(pickupid == pickup_top)
    {
        ShowPlayerDialog(playerid, D_TOP, DIALOG_STYLE_LIST, ""I"���", "\
        "I"[1]"W" �������\n\
        "I"[2]"W" �����������", "�����", "������");
        return 1;
    }

    if(pickupid == pickup_lvpd[0])
    {
        if(gos(playerid))
        {
            SetPlayerPos(playerid, 2343.3806,2458.1057,14.9688);
            SetPlayerFacingAngle(playerid, 180.0000);
        }
        return 1;
    }
    if(pickupid == pickup_lvpd[1])
    {
        if(gos(playerid))
        {
            SetPlayerPos(playerid, 2277.8828,2460.1050,38.6837);
            SetPlayerFacingAngle(playerid, 0.0000);
        }
        return 1;
    }

    if(pickupid == pickup_lva[0])
    {
        if(gos(playerid) || p_info[playerid][member] == NATIONAL_GUARD && p_info[playerid][fwork] == false)
        {
            SetPlayerPos(playerid, 99.4711, 1920.8563, 18.2364);
            SetPlayerFacingAngle(playerid, 270.0000);
        }
        return 1;
    }
    if(pickupid == pickup_lva[1])
    {
        if(gos(playerid) || p_info[playerid][member] == NATIONAL_GUARD && p_info[playerid][fwork] == false)
        {
            SetPlayerPos(playerid, 92.2584, 1920.8887, 18.0054);
            SetPlayerFacingAngle(playerid, 90.0000);
        }
        return 1;
    }

    if(pickupid == rs_pickup[0]) // Real Skin (����);
    {
        SetPlayerInterior(playerid, 15);
        SetPlayerVirtualWorld(playerid, 2023);
        SetPlayerPos(playerid, 207.6525,-108.8663,1005.1328);
        SetPlayerFacingAngle(playerid, 0.0);
        SetCameraBehindPlayer(playerid);
        return 1;
    }
    else if(pickupid == rs_pickup[1]) // Real Skin (�����);
    {
        SetPlayerSkinEx(playerid);
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        SetPlayerPos(playerid, 479.9583,-1534.1165,19.6490);
        SetPlayerFacingAngle(playerid, 290.0);
        SetCameraBehindPlayer(playerid);
    }

    if(pickupid == drug_work)
    {
        if(!gang(playerid) && !mafia(playerid) && !biker(playerid)) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
        if(p_temp[playerid][Work_ID] == DRUG_WORK) return EndPlayerJob(playerid);
        StartPlayerJob(playerid, DRUG_WORK);
    }
    if(pickupid == tram_pickup)
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != TRAM_WORK) return SendError(playerid, "�� �� ��������� ������� ���� �� ������� ������.");
        if(p_info[playerid][job] != JOB_TRAM) return SendError(playerid, "�� �� ��������� ��������� �������.");
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"�� ������� %s ������� ����?", p_temp[playerid][Work_ID] != TRAM_WORK ? ("{"#cGREEN"}������"W"") : ("{"#cLIGHTRED"}���������"W""));
        ShowPlayerDialog(playerid, D_DUTY_TRAM, DIALOG_STYLE_MSGBOX, ""I"�������� �������", STRING_GLOBAL, "�����", "������");
        return 1;
    }
    if(pickupid == laboratory_pickup[0]) // ����������� (����);
    {
        if(GetFactionType(p_info[playerid][member]) != FACTION_TYPE_GOS && p_temp[playerid][keys_door] != MEDIC_LS && p_temp[playerid][keys_door] != MEDIC_SF && p_temp[playerid][keys_door] != MEDIC_LV && p_info[playerid][member] != FBI_TEAM)
            return SendError(playerid, "� ��� ��� ������ �� ���� ������.");
        SetPlayerInterior(playerid, 1);
        SetPlayerVirtualWorld(playerid, 1);
        SetPlayerPos(playerid, 2714.7585,746.2165,1024.4215);
        SetPlayerFacingAngle(playerid, 177.0842);
        SetCameraBehindPlayer(playerid);
    }
    else if(pickupid == laboratory_pickup[1]) // ����������� (�����);
    {
        if(p_temp[playerid][Work_ID] == LABORATORY_WORK) return SendError(playerid, "�� �� ��������� ������� ����.");
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        SetPlayerPos(playerid, 1350.3611,349.1705,20.2478);
        SetPlayerFacingAngle(playerid, 67.0670);
        SetCameraBehindPlayer(playerid);
        return 1;
    }
    else if(pickupid == laboratory_pickup[2]) // ����������� (����������);
    {
        if(!IsPlayerFractionMedic(playerid)) return SendError(playerid, "�� �� �������� � �������� ��, �� � ��.");
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != LABORATORY_WORK) return SendError(playerid, "�� �� ��������� ������� ���� �� ������� ������.");
        STRING_MIN[0] = EOS;
        format(STRING_MIN, sizeof(STRING_MIN), ""W"�� ������� %s ������� ����?", (p_temp[playerid][Work_ID] != LABORATORY_WORK) ? ("{"#cGREEN"}������"W"") : ("{"#cLIGHTRED"}���������"W""));
        ShowPlayerDialog(playerid, D_DUTY_LABORATORY, DIALOG_STYLE_MSGBOX, ""I"�����������", STRING_MIN, "�����", "������");
    }
    else if(pickupid == laboratory_pickup[3]) // ����������� (�����);
    {
        if(!IsPlayerFractionMedic(playerid)) return SendError(playerid, "�� �� �������� � �������� ��, �� � ��.");
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != LABORATORY_WORK) return SendError(playerid, "�� �� ��������� ������� ���� �� ������� ������.");
        if(p_temp[playerid][Work_ID] != LABORATORY_WORK) return SendError(playerid, "�� �� ������ ������� ����.");

        if(p_temp[playerid][LaboratoryCheck] == 0) return SendError(playerid, "�� �� ���������� �����������.");

        new amount = p_temp[playerid][LaboratoryCheck], salary = amount / 2;

        SetPlayerMoney(playerid, salary, true, "�������� � �����������");
        OnServerInfoForMoney[16] += salary;

        p_temp[playerid][LaboratorySalary] += salary;
        SendMes(playerid, COLOR_LYELLOW, "� ����� �������� ���������: {"#cLIME"}%d$.{"#cLYELLOW"} ���������� �����: {"#cLIME"}%d$.", salary, p_temp[playerid][LaboratorySalary]);
        p_temp[playerid][LaboratoryCount] += p_temp[playerid][LaboratoryCheck];
        p_temp[playerid][LaboratoryCheck] = 0;

        ClearAnimations(playerid);
        ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);

        STRING_GLOBAL[0] = EOS;
        if(p_info[playerid][p_settings][INTERFACE])
        {
            f(STRING_GLOBAL, "%d", p_temp[playerid][LaboratoryCount]);
            PlayerTextDrawSetString(playerid, PTD_NewSalary[playerid][2], STRING_GLOBAL);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d$", p_temp[playerid][LaboratorySalary]);
            PlayerTextDrawSetString(playerid, PTD_NewSalary[playerid][1], STRING_GLOBAL);
        }
        else
        {
            f(STRING_GLOBAL, "Progress: %d", p_temp[playerid][LaboratoryCount]);
            PlayerTextDrawSetString(playerid, PTD_Salary[playerid][5], STRING_GLOBAL);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d$", p_temp[playerid][LaboratorySalary]);
            PlayerTextDrawSetString(playerid, PTD_Salary[playerid][6], STRING_GLOBAL);
        }

        UpdateFamilyLevel(playerid);

        WarehouseMedicines += amount;

        UpdateWarehouseInfo(1);
    }
    if(pickupid == pickup_collector) // ���������� (����������);
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != COLLECTOR_WORK) return SendError(playerid, "�� �� ��������� ������� ���� �� ������� ������.");
        if(p_info[playerid][job] != JOB_COLLECTOR) return SendError(playerid, "�� �� ��������� ������������.");
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"�� ������� %s ������� ����?", p_temp[playerid][Work_ID] != COLLECTOR_WORK ? ("{"#cGREEN"}������"W"") : ("{"#cLIGHTRED"}���������"W""));
        ShowPlayerDialog(playerid, D_DUTY_COLLECTOR, DIALOG_STYLE_MSGBOX, ""I"����������", STRING_GLOBAL, "�����", "������");
    }
    if(pickupid == pickup_electric) // �������� (����������);
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != ELECTRIC_WORK) return SendError(playerid, "�� �� ��������� ������� ���� �� ������� ������.");
        if(p_info[playerid][job] != JOB_ELECTRIC) return SendError(playerid, "�� �� ��������� ����������.");
        if(p_temp[playerid][Work_ID] == ELECTRIC_WORK) ShowPlayerDialog(playerid, D_DUTY_ELECTRIC, DIALOG_STYLE_MSGBOX, ""I"��������", ""W"�� ������� {"#cLIGHTRED"}���������"W" ������� ����?", "�����", "������");
        else ShowPlayerDialog(playerid, D_DUTY_ELECTRIC, DIALOG_STYLE_LIST, ""I"��������", ""I"[1]"W" ������ ���\n"I"[2]"W" ���������� ���", "�����", "������");
    }
    if(pickupid == pickup_oil) // �������� (����������);
