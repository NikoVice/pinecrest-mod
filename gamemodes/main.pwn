            if(!(100_000 <= number <= 999_999)) return ShowPlayerDialog(playerid, D_DONATE_BUY_NUMBER, DIALOG_STYLE_INPUT, ""I"Номер телефона", ""W"Введите номер телефона от "I"3"W" до "I"6"W" цифр:\n\n{"#cLIGHTRED"}Обратите внимание! От количества одинаковых цифр зависит стоимость номера телефона.", "Далее", "Отмена"), SendError(playerid, "Длина номера телефона должна быть от 3 до 6 цифр.");

            if(PhoneBuyNumber == true) return ShowPlayerDialog(playerid,44,1,""I"Изменить номер телефона",""W"Введите новый номер телефона:\n\n{"#cLIGHTRED"}Обратите внимание! Номер телефона должен состоять из 6 цифр.","Далее","Отмена"), SendError(playerid, "На данный момент кто-то приобретает номер телефона, попробуйте позднее.");
            PhoneBuyNumber = true;

            SetPVarInt(playerid, "NumberPhone", number);
