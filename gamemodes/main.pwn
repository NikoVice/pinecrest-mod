            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            if(p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID)
            {
                veh_info[p_temp[playerid][rented_veh]][v_rented_ID] = INVALID_MYSQL_ID;
                DestroyVehicleVEx(p_temp[playerid][rented_veh]);
                p_temp[playerid][rented_veh] = INVALID_VEHICLE_ID;
            }

            new idx = random(sizeof(FishVehiclePos)), car_id = CreateVehicleVEx(NPO_TEMPCAR, NPO_NONE, 453, FishVehiclePos[idx][0], FishVehiclePos[idx][1], FishVehiclePos[idx][2], FishVehiclePos[idx][3], 1, 1, 120);

            veh_info[car_id][v_lock] = 1;
            veh_info[car_id][v_color] = 1;
            veh_info[car_id][v_model] = 453;
            veh_info[car_id][v_fuel] = GetVehicleData(GetVehicleModelEx(car_id), E_VD_MAX_FUEL);
            for(new i; i < 5; i++) veh_info[car_id][v_details][i] = 100.0;
            format(veh_info[car_id][v_number], 16, "NULL");
            veh_info[car_id][v_int] =
            veh_info[car_id][v_virt] =
            veh_info[car_id][v_insurance] =
            veh_info[car_id][v_insurance_time] = 0;
            veh_info[car_id][v_rented_ID] = p_info[playerid][ID];
            veh_info[car_id][v_used_key_ID] = playerid;

            p_temp[playerid][rented_veh] = car_id;
            PutPlayerInVehicle(playerid, car_id, 0);

            veh_info[car_id][v_engine] = 1;
            PlayerPlaySound(playerid, 31810, 0.0, 0.0, 0.0);

            MeAction(playerid, "завел(-а) двигатель");
            SetVehicleParamsVEx(car_id, veh_info[car_id][v_engine], veh_info[car_id][v_light], alarm, veh_info[car_id][v_lock], bonnet, boot, objective);

            OnServerInfoForMoney[18] += price;
            SetPlayerMoney(playerid, -price, true, "т/с: аренда <%s>(%d)", GetVehicleName(car_id), GetVehicleModelEx(car_id));

            SendMes(playerid, COLOR_LGREEN, "Вы арендовали транспортное средство {"#cLEMON"}\"%s\"{"#cGREEN"} за {"#cLEMON"}%d$.", GetVehicleName(car_id), 2500);
            SendMes(playerid, COLOR_BLUE, "Для отмены аренды транспортного средства: "W"/unrent");
            SendMes(playerid, COLOR_LIME, "Команды транспортных средств: {"#cLYELLOW"}/mm > [5] Команды сервера > [3] Команды транспорта");
            SendMes(playerid, COLOR_LIME, "Установить сети: {"#cLYELLOW"}/cnetwork{"#cLIME"} | Собрать сети: {"#cLYELLOW"}/dnetwork{"#cLIME"} | Найти сети: {"#cLYELLOW"}/snetwork");

            SetFractionWarehouse(MAYOR_LS, fwMoney, price);
            return 1;
        }
