        case D_GC:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0: HousePlayerList(playerid, HOUSE_ID_GARDEN_CENTER);
                case 1: BizzPlayerList(playerid, BIZZ_ID_GARDEN_CENTER);
                case 2:
                {
                    new bizid = GetPVarInt(playerid, "bID"), till = b_info[bizid][_till], price = GARDEN_SEEDS_PRICE * till;

                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "\
                    [#] Название\tКоличество на складе\tСтоимость\n\
                    "I"[1]"W" Семена хлопка\t%d\t%d$\n\
                    "I"[2]"W" Семена льна\t%d\t%d$", cotton_warehouse, price, linen_warehouse, price);
                    ShowPlayerDialog(playerid, D_GC_SEEDS, DIALOG_STYLE_TABLIST_HEADERS, ""I"Семена для сада", STRING_GLOBAL, "Далее", "Отмена");
                }
            }
            return 1;
        }
        case D_GC_SEEDS:
        {
            if(!response) return ShowPlayerDialog(playerid, D_GC, DIALOG_STYLE_TABLIST_HEADERS, ""I"Садовый центр", "[#] Название\tТип\n"I"[1]"W" Объекты для сада\tДом\n"I"[2]"W" Объекты для сада\tБизнес\n"I"[3]"W" Семена для сада\tДом", "Далее", "Отмена");

            new bizid = GetPVarInt(playerid, "bID"), till = b_info[bizid][_till], price = GARDEN_SEEDS_PRICE * till;

            if(listitem == 0 && cotton_warehouse <= 0) return SendError(playerid, "На складе нет семян хлопка, они пополняются каждый час.");
            if(listitem == 1 && linen_warehouse <= 0) return SendError(playerid, "На складе нет семян льна, они пополняются каждый час.");

            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            if(!GivePlayerInventory(playerid, listitem == 0 ? 735 : 736, 1)) return SendError(playerid, "В инвентаре нет столько места.");

            if(b_info[bizid][_prod] >= ((price / 100) * 25) / 100)
            {
                b_info[bizid][_prod] -= ((price / 100) * 25) / 100;
                b_info[bizid][_bank] += ((price / 100) * 25) - ((price / 100) * 2);
                AddMafiaBank(bizid, (price / 100) * 2);

                biz_finka[bizid] += ((price / 100) * 25) - ((price / 100) * 2);
                UpdateIntForFinanceBiz(bizid, ((price / 100) * 25) - ((price / 100) * 2));
            }

            switch(listitem)
            {
                case 0:
                {
                    cotton_warehouse--;
                    if(cotton_warehouse < 0) cotton_warehouse = 0;
                    MysqlUpdateOtherInt("cotton_warehouse", cotton_warehouse);
                }
                case 1:
                {
                    linen_warehouse--;
                    if(linen_warehouse < 0) linen_warehouse = 0;
                    MysqlUpdateOtherInt("linen_warehouse", linen_warehouse);
                }
            }

            OnServerInfoForMoney[10] += price;
            SetPlayerMoney(playerid, -price, true, "покупка в садовом центре");

            SendAccess(playerid, "Вы приобрели %s за %d$.", listitem == 0 ? "семена хлопка" : "семена льна", price);
            return 1;
        }
        case D_CREATE_BOX:
        {
            if(!response)
            {
                ClearPlayerCreateBoxInfo(playerid);
                SendAccess(playerid, "Вы отменили сохранение координат для сундука.");
                return 1;
            }
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `box_coords` (x, y, z, r) VALUES (%f, %f, %f, %f)",
            p_temp[playerid][CreateBoxCoords][0], p_temp[playerid][CreateBoxCoords][1], p_temp[playerid][CreateBoxCoords][2], p_temp[playerid][CreateBoxCoords][3]);
            mysql_tquery(con_bd, STRING_GLOBAL);
            ClearPlayerCreateBoxInfo(playerid);
            SendAccess(playerid, "Вы сохранили координаты для сундука.");
            return 1;
        }
        case D_CONTAINERS:
        {
            if(!response) return DeletePVar(playerid, "ContainersCreatedTime");
            new i = p_temp[playerid][container_id];
            if(!(0 <= i <= MAX_CONTAINERS-1)) return SendError(playerid, "ID контейнера не определено.");
            
            new time = GetPVarInt(playerid, "ContainersCreatedTime"),
                price = strval(inputtext);
            DeletePVar(playerid, "ContainersCreatedTime");

            if(ContainersInfo[i][cCreatedTime] != time) return SendError(playerid, "В данный момент нет возможности установить ставку. Причина: новый контейнер.");
            if(ContainersInfo[i][cStatus] == CONTAINERS_STATUS_EMPTY) return SendError(playerid, "В данный момент нет возможности установить ставку. Причина: контейнер не найден.");
            if(ContainersInfo[i][cStatus] == CONTAINERS_STATUS_PRIZE) return SendError(playerid, "В данный момент нет возможности установить ставку. Причина: аукцион контейнера завершен.");
            if(ContainersInfo[i][cType] == CONTAINERS_TYPE_NONE) return SendError(playerid, "В данный момент нет возможности установить ставку. Причина: не определен тип контейнера.");
            if(ContainersInfo[i][cBet] == 0 && price < ContainersInfo[i][cPrice]) return SendError(playerid, "Вы не можете установить ставку менее %d$.", ContainersInfo[i][cPrice]);
            if(ContainersInfo[i][cBet] != 0 && price < ContainersInfo[i][cBet]) return SendError(playerid, "Вы не можете установить ставку менее %d$.", ContainersInfo[i][cBet]);
            if(ContainersInfo[i][cBet] != 0 && price == ContainersInfo[i][cBet]) return SendError(playerid, "Вы не можете установить ставку %d$.", ContainersInfo[i][cBet]);
            new containers_bet = ContainersInfo[i][cBet] + (ContainersInfo[i][cBet] / 100) * 5;
            if(ContainersInfo[i][cBet] != 0 && price < containers_bet) return SendError(playerid, "Вы не можете установить менее %d$.", containers_bet);
            if(price > p_info[playerid][cash]) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            if(ContainersInfo[i][cPlayerID] != 0)
            {
                if(GetPlayerUserID(ContainersInfo[i][cPlayerID]) != INVALID_PLAYER_ID)
                {
                    new scdplayerid = GetPlayerUserID(ContainersInfo[i][cPlayerID]);
                    SetPlayerMoney(scdplayerid, ContainersInfo[i][cBet], true, "возврат ставки за контейнер");
                    SendInfo(scdplayerid, "Ваша ставка за контейнер была перебита, Вам возвращено: %d$.", ContainersInfo[i][cBet]);
                    Log(LOG_player, INFO, "%s[%d](%s %s) возвращена ставка %d$ за контейнер | #Containers",
                        get_name(scdplayerid), p_info[scdplayerid][ID], p_temp[scdplayerid][session_IP], IsPlayerMobile(scdplayerid) ? "Mobile": "PC",
                        ContainersInfo[i][cBet]);
                }
                else
                {
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `money` = `money` + %d WHERE `id` = %d",
                    ContainersInfo[i][cBet], ContainersInfo[i][cPlayerID]);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                    Log(LOG_player, INFO, "%s[%d](OFFLINE) возвращена ставка %d$ за контейнер | #Containers",
                        ContainersInfo[i][cPlayerName], ContainersInfo[i][cPlayerID], ContainersInfo[i][cBet]);
                }
            }

            SetPlayerMoney(playerid, -price, true, "ставка за контейнер");

            Log(LOG_player, INFO, "%s[%d](%s %s) поставил(-а) ставку %d$ на контейнер | #Containers",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                price);

            ContainersInfo[i][cStatus] = CONTAINERS_STATUS_AUCTION;
            ContainersInfo[i][cTime] = 180;
            ContainersInfo[i][cBet] = price;
            ContainersInfo[i][cPlayerID] = p_info[playerid][ID];
            strmid(ContainersInfo[i][cPlayerName], get_name(playerid), 0, strlen(get_name(playerid)), MAX_PLAYER_NAME);

            SendAccess(playerid, "Вы установили ставку в размере %d$ за контейнер #%d.", price, i+1);
            return 1;
        }
        case D_ATM_LIST:
        {
            if(!response) return 1;

            if(ATMInfo[listitem][aStatus] == 1) return SendError(playerid, "В данном банкомате не требуется пополнение денежных средств."), ShowPlayerATMList(playerid);
            if(ATMInfo[listitem][aPlayerID] != INVALID_PLAYER_ID) return SendError(playerid, "Данный банкомат уже пополняют денежными средствами."), ShowPlayerATMList(playerid);

            if(AntiCheatWarningTime[playerid][2] > timestamp) return SendError(playerid, "Вы не можете брать заказы так часто, подождите."), ShowPlayerATMList(playerid);
            new Float:distance = GetPlayerDistanceFromPoint(playerid, ATMInfo[listitem][aPos][0], ATMInfo[listitem][aPos][1], ATMInfo[listitem][aPos][2]),
                time = floatround(distance) / 500 * 30;
            AntiCheatWarningTime[playerid][0] = timestamp + time;
            AntiCheatWarningTime[playerid][1] = time;

            ATMInfo[listitem][aCount] = 0;
            ATMInfo[listitem][aPlayerID] = playerid;

            SendMes(playerid, COLOR_BLUE, "Вы начали выполнение задания по заполнению банкомата #%d.", listitem + 1);
            SendMes(playerid, COLOR_SEA_WAVE, "Вам необходимо загружать мешки с деньгами в багажник.");
            CancelPlayerGPS(playerid);
            SetPlayerCheckpoint(playerid, 1362.6382,-1658.9019,13.4751, 2.5);

            CollectorIDx[playerid] = listitem;

            for(new i = 0; i < 3; i++)
            {
                new scdplayerid = CollectorMembersParty[playerid][i];
                if(scdplayerid != INVALID_PLAYER_ID)
                {
                    if(IsPlayerConnected(scdplayerid))
                    {
                        AntiCheatWarningTime[scdplayerid][0] = timestamp + time;
                        AntiCheatWarningTime[scdplayerid][1] = time;

                        new vehicleid = p_temp[playerid][rented_veh];

                        CollectorIDx[scdplayerid] = listitem;
                        CollectorVehicleIDx[scdplayerid] = vehicleid;

                        SendMes(scdplayerid, COLOR_SEA_WAVE, "Вам необходимо загружать мешки с деньгами в багажник.");
                        CancelPlayerGPS(scdplayerid);
                        SetPlayerCheckpoint(scdplayerid, 1362.6382,-1658.9019,13.4751, 2.5);
                    }
                }
            }
            return 1;
        }
        case D_PROMOCODE_MENU:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0: ShowDialogPromocode(playerid, PROMOCODE_ACTIVATION);
                case 1: ShowDialogPromocode(playerid, PROMOCODE_CONTROL);
                case 2: ShowDialogPromocode(playerid, PROMOCODE_RATING);
            }
            return 1;
        }
        case D_PROMOCODE_ACTIVATION:
        {
            if(!response) return ShowDialogPromocode(playerid, PROMOCODE_MENU);
            if(!strlen(inputtext))
            {
                ShowDialogPromocode(playerid, PROMOCODE_ACTIVATION);
                return SendError(playerid, "Вы ничего не ввели.");
            }
            if(strlen(inputtext) < 1 || strlen(inputtext) > 14)
            {
                ShowDialogPromocode(playerid, PROMOCODE_ACTIVATION);
                return SendError(playerid, "Количество символов в промокоде не может быть менее 1 и более 14.");
            }
            for(new i = strlen(inputtext)-1; i != -1; i--)
            {
                switch(inputtext[i])
                {
                    case 'а'..'я', 'А'..'Я', ' ':
                    {
                        ShowDialogPromocode(playerid, PROMOCODE_ACTIVATION);
                        return SendError(playerid, "Промокод не может содержать в себе русские символы.");
                    }
                }
            }
            if(p_info[playerid][promocode_use]) return ShowDialogPromocode(playerid, PROMOCODE_MENU), SendError(playerid, "У Вас уже активирован промокод.");

            new count;
            for(new i = 0; i < 16; i++)
            {
                if(p_info[playerid][quest][i] == Mission[i][mProgress]) count++;
            }
            if(count < 5) return SendError(playerid, "Для активации промокода необходимо пройти не менее 5 начальных заданий. Подробнее: /mission");

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `promocode` WHERE `name` = '%e' LIMIT 1",
            inputtext);
            mysql_tquery(con_bd, STRING_GLOBAL, "OnPlayerSelectPromocode", "ddds", playerid, 3, -1, inputtext);
            return 1;
        }
        case D_PROMOCODE_CONTROL:
        {
            if(!response) return ShowDialogPromocode(playerid, PROMOCODE_MENU);
            switch(listitem)
            {
                case 0: ShowDialogPromocode(playerid, PROMOCODE_EDIT);
                case 1: ShowDialogPromocode(playerid, PROMOCODE_LEVEL);
                case 2: ShowPlayerList(playerid, LIST_ID_PROMOCODE);
                case 3: ShowDialogPromocode(playerid, PROMOCODE_BALANCE);
            }
            return 1;
        }
        case D_PROMOCODE_EDIT:
        {
            if(!response) return ShowDialogPromocode(playerid, PROMOCODE_CONTROL);
            if(strlen(inputtext) < 1 || strlen(inputtext) > 14)
            {
                ShowDialogPromocode(playerid, PROMOCODE_EDIT);
                return SendError(playerid, "Количество символов в промокоде не может быть менее 1 и более 14.");
            }
            for(new i = strlen(inputtext)-1; i != -1; i--)
            {
                switch(inputtext[i])
                {
                    case 'а'..'я', 'А'..'Я', ' ':
                    {
                        ShowDialogPromocode(playerid, PROMOCODE_EDIT);
                        return SendError(playerid, "Промокод не может содержать в себе русские символы.");
                    }
                }
            }
            new price;
            switch(strlen(inputtext))
            {
                case 0, 1: price = 2500;
                case 2, 3: price = 2000;
                case 4, 5: price = 1500;
                case 6, 7: price = 1000;
                default: price = 500;
            }
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `promocode` WHERE `name` = '%e' LIMIT 1",
            inputtext);
            mysql_tquery(con_bd, STRING_GLOBAL, "OnPlayerSelectPromocode", "ddds", playerid, 5, price, inputtext);
            return 1;
        }
        case D_PROMOCODE_LEVEL:
        {
            if(!response) return ShowDialogPromocode(playerid, PROMOCODE_CONTROL);
            new temp_level = PromocodeInfo[playerid][TYPE_PROMOCODE_LEVEL], activation = PromocodeInfo[playerid][TYPE_PROMOCODE_ACTIVATION];
            if(temp_level == MAX_PROMOCODE_LEVEL) return ShowDialogPromocode(playerid, PROMOCODE_LEVEL), SendError(playerid, "У Вашего промокода максимальный уровень.");
            if(activation < PromocodeSettings[temp_level][pActivation]) return ShowDialogPromocode(playerid, PROMOCODE_LEVEL), SendError(playerid, "У Вашего промокода нет такого количества активаций.");
            new price = PromocodeSettings[temp_level][pPrice];
            if(p_info[playerid][flinmoney] < price) return ShowDialogPromocode(playerid, PROMOCODE_LEVEL), SendError(playerid, "У Вас нет столько Pinecrest Money.");
            p_info[playerid][flinmoney] -= price;
            MysqlUpdatePlayerInt(playerid, "flinmoney", p_info[playerid][flinmoney]);

            PromocodeInfo[playerid][TYPE_PROMOCODE_LEVEL]++;

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `promocode` SET `level` = `level` + 1 WHERE `id` = %d",
            p_info[playerid][promocode_create]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            Log(LOG_player, INFO, "%s[%d](%s %s) повысил(-а) промокод %s до %d уровня за %d Pinecrest Money | #Promocode",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                PromocodeName[playerid], PromocodeInfo[playerid][TYPE_PROMOCODE_LEVEL], price);

            ShowDialogPromocode(playerid, PROMOCODE_UPDATE, price);
            return 1;
        }
        case D_PROMOCODE_BALANCE:
        {
            if(!response) return ShowDialogPromocode(playerid, PROMOCODE_CONTROL);
