        case D_TAKE_SELECT:
        {
            if(!response) return DeletePVar(playerid, "take:list");
            if(((!IsPlayerFractionPolice(playerid) && p_info[playerid][member] != PRISON) || p_info[playerid][rang] < 4) && p_info[playerid][admin] < 4)
                return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
            new fix_listitem;
            if(sscanf(inputtext, "i", fix_listitem)) return SendError(playerid, "�� ������ �� �����.");
            if(fix_listitem == INVALID_PLAYER_ID) return SendError(playerid, "����� �� ������.");
            if(fix_listitem == playerid) return SendError(playerid, "�� ����� ���� ID.");
            if(!IsPlayerStream(5.0, playerid, fix_listitem) || pSpectateId[fix_listitem] != INVALID_PLAYER_ID) return SendError(playerid, "����� ������� ������ �� ���.");
            new string[144];
            new idx = GetPVarInt(playerid, "take:list");
            DeletePVar(playerid, "take:list");
            switch(idx)
            {
                case 1 .. 5:
                {
                    if(p_info[fix_listitem][Lic][idx - 1] != 1) return SendError(playerid, "� ������ ��� �������� �� \"%s\".", name_license[idx - 1]);

                    p_info[fix_listitem][Lic][idx - 1] = 0;
                    p_info[fix_listitem][Lic_Warn][idx - 1] = 0;
                    p_info[fix_listitem][Lic_Time][idx - 1] = 0;
                    format(string, sizeof(string), "%s ������(�) � %s �������� �� \"%s\"", get_name(playerid), get_name(fix_listitem), name_license[idx - 1]);
                    OnPlayerUpdateLicData(fix_listitem);
                }
                case 6:
                {
                    if(GetInventoryAmount(fix_listitem, 627) == 0) return SendError(playerid, "� ������ ��� ����������.");

                    if(p_info[playerid][Update][2] == 1)
                    {
                        switch(random(5))
                        {
                            case 1, 2:
                            {
                                format(string, sizeof(string), "%s ������(�) � %s ���������", get_name(playerid) , get_name(fix_listitem));
                                GivePlayerInventory(fix_listitem, 627, -GetInventoryAmount(fix_listitem, 627));
                            }
                            default: return SendError(playerid, "�� ������ �� �����.");
                        }
                    }
                    format(string, sizeof(string), "%s ������(�) � %s ���������", get_name(playerid) , get_name(fix_listitem));
                    GivePlayerInventory(fix_listitem, 627, -GetInventoryAmount(fix_listitem, 627));
                }
                case 7:
                {
                    if(GetInventoryAmount(fix_listitem, 628) == 0) return SendError(playerid, "� ������ ��� ��������.");

                    if(p_info[playerid][Update][2] == 1)
                    {
                        switch(random(5))
                        {
                            case 1, 2:
                            {
                                format(string, sizeof(string), "%s ������(�) � %s �������", get_name(playerid) , get_name(fix_listitem));
                                GivePlayerInventory(fix_listitem, 628, -GetInventoryAmount(fix_listitem, 628));
                            }
                            default: return SendError(playerid, "�� ������ �� �����.");
                        }
                    }

                    format(string, sizeof(string), "%s ������(�) � %s �������", get_name(playerid) , get_name(fix_listitem));
                    GivePlayerInventory(fix_listitem, 628, -GetInventoryAmount(fix_listitem, 628));
                }
                case 8:
                {
                    if(GetInventoryAmount(fix_listitem, 629) == 0) return SendError(playerid, "� ������ ��� ����������.");

                    if(p_info[playerid][Update][2] == 1)
                    {
                        switch(random(5))
                        {
                            case 1, 2:
                            {
                                format(string, sizeof(string), "%s ������(�) � %s ���������", get_name(playerid), get_name(fix_listitem));
                                GivePlayerInventory(fix_listitem, 629, -GetInventoryAmount(fix_listitem, 629));
                            }
                            default: return SendError(playerid, "�� ������ �� �����.");
                        }
                    }

                    format(string, sizeof(string), "%s ������(�) � %s ���������", get_name(playerid) , get_name(fix_listitem));
                    GivePlayerInventory(fix_listitem, 629, -GetInventoryAmount(fix_listitem, 629));
                }
                case 9:
                {
                    new count = 0;
                    for(new i; i < MAX_WEAPONS; i++)
                    {
                        if(p_info[fix_listitem][Weapon][i] != 0) count++;
                    }

                    if(count == 0) return SendError(playerid, "� ������ ��� ������.");

                    format(string, sizeof(string), "%s ������(�) � %s ������", get_name(playerid), get_name(fix_listitem));
                    f_ResetPlayerWeapons(fix_listitem);
                }
            }
            ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);

            p_info[playerid][fracdata][7]++;
            SaveFracData(playerid);

            CheckPlayerMission(playerid, POLICE_TAKE);
            UpdateFamilyLevel(playerid);

            p_info[playerid][ftop_take]++;
            MysqlUpdatePlayerInt(playerid, "ftop_take", p_info[playerid][ftop_take]);
            return true;
        }
        case D_BUY_HEAL_ADDICT_PICKUP:
