            {
                p_temp[playerid][TramStopIDx] = p_temp[playerid][TramStopIDx] + 1;
                if(p_temp[playerid][TramStopIDx] >= 3) p_temp[playerid][TramStopIDx] = 0;
                if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Водитель трамвая\nСлед. остановка: "W"%s"I"\nПроезд бесплатный", TramStopName[p_temp[playerid][TramStopIDx]]);
                    Update3DTextLabelText(veh_info[vehicleid][v_text], COLOR_MAIN, STRING_GLOBAL);
                }
                p_temp[playerid][TramTimer] = 11;
                new str[128];
                format(str, sizeof(str), "Трамвай отъезжает через несколько секунд, след. остановка %s.", TramStopName[p_temp[playerid][TramStopIDx]]);
                ProxDetector(30.0, playerid, str, COLOR_GREEN, COLOR_GREEN, COLOR_GREEN, COLOR_GREEN, COLOR_GREEN);
                DisablePlayerRaceCheckpoint(playerid);
            }
            else if(p_temp[playerid][pPressed] == sizeof(Tram) - 1)
            {
                p_temp[playerid][pPressed] = 0;
                new idx = p_temp[playerid][pPressed];

                SendMes(playerid, COLOR_BLUE, "Вы завершили выполнение маршрута.");

                UpdatePlayerWorkSkill(playerid, 16);

                CheckPlayerMission(playerid, START_TRAM);
                CheckPlayerMission(playerid, DAILY_TRAM);
                CheckPlayerMission(playerid, ACHIEVEMENT_TRAM);

                CheckPlayerFreelance(playerid, FREELANCE_TRAM);
                CheckPlayerBattlePass(playerid, BATTLEPASS_TRAM);

                UpdateFamilyLevel(playerid);
                UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_TRAM); // Контракты: Водитель трамвая

                SetPlayerRaceCheckpoint(playerid, 0, Tram[idx][tramPosX], Tram[idx][tramPosY], Tram[idx][tramPosZ]-1.5, Tram[idx+1][tramPosX], Tram[idx+1][tramPosY], Tram[idx+1][tramPosZ]-1.5, 3.0);

                if(GetPlayerGiveCasket(100, 5) != -1) GivePlayerCasket(playerid, -1);
            }
            else if(p_temp[playerid][pPressed] == sizeof(Tram) - 2)
            {
                p_temp[playerid][pPressed]++;
                new idx = p_temp[playerid][pPressed];
                SetPlayerRaceCheckpoint(playerid, 1, Tram[idx][tramPosX], Tram[idx][tramPosY], Tram[idx][tramPosZ]-1.5, 0, 0, 0, 3.0);
            }
            else
            {
                new reason_money = GetPlayerMoneySkill(playerid, 121, 16);

                if(CheckPlayerMaxSalarySkill(playerid, 16, reason_money))
                {
