                    STRING_GLOBAL[0] = EOS;
                    for(new i; i <= 6; i++) f(STRING_GLOBAL, "%s"I"[%d]"W" %s\n", STRING_GLOBAL, i+1, PickName[i]);
                    ShowPlayerDialog(playerid, D_PICK_CANDIDATE, DIALOG_STYLE_LIST, ""I"���������", STRING_GLOBAL, "�����", "������");
                }
