        case D_MEH_CONTRACT:
        {
            if(!response) return 1;
            new litres;
            if(sscanf(inputtext, "i", litres)) return SendError(playerid, "�� ������ �� �����.");

            if((litres%2) > 0 || litres == 0) return SendError(playerid, "���-�� ������� ������ ���� ������ ����.");
            if(litres < 100 || litres > 1000) return SendError(playerid, "���-�� ������� ������ ���� �� ����� 100 � �� ����� 1000.");

            new idx = GetPVarInt(playerid,"bID");
            new price = BIZZ_FILL_PRICE * litres * b_info[idx][_till];

            if(p_info[playerid][cash] < price) return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");

            new mehname [32];
            GetPVarString(playerid,"MehName",mehname,32);

            if(b_info[idx][_prod] >= litres)
            {
                b_info[idx][_prod] -= litres;
                b_info[idx][_bank] += (price / 100) * 90;
                AddMafiaBank(idx, price/10);

                biz_finka[idx] += (price / 100) * 90;
                UpdateIntForFinanceBiz(idx, (price / 100) * 90);
            }

            OnServerInfoForMoney[10] += price;
            SetPlayerMoney(playerid, -price, true, "�������� ����������");
            SetPVarInt(playerid,"toplivo",GetPVarInt(playerid,"toplivo") + litres);
            return 1;
        }
