                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, "%d$", p_temp[playerid][ConstructionSalary]);
                        PlayerTextDrawSetString(playerid, PTD_NewSalary[playerid][1], STRING_GLOBAL);
                    }
                    else
                    {
                        f(STRING_GLOBAL, "Progress: %d", p_temp[playerid][ConstructionCount]);
                        PlayerTextDrawSetString(playerid, PTD_Salary[playerid][5], STRING_GLOBAL);
                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, "%d$", p_temp[playerid][ConstructionSalary]);
                        PlayerTextDrawSetString(playerid, PTD_Salary[playerid][6], STRING_GLOBAL);
                    }

                    new idx = random(sizeof(ConstructionWarehousePos));
                    SetPlayerRaceCheckpoint(playerid, 1, ConstructionWarehousePos[idx][0], ConstructionWarehousePos[idx][1], ConstructionWarehousePos[idx][2], 0.0, 0.0, 0.0, 2.5);

                    AntiCheatWarningTime[playerid][0] = timestamp + 3;

                    CheckPlayerBot(playerid, 10);
                }
                return 1;
            }
        }
    }
    return 1;
}

public OnPlayerLeaveRaceCheckpoint(playerid)
{
    if(p_info[playerid][loggedIn] != 1) return 0;
    return 1;
}

public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
    if(p_info[playerid][loggedIn] != 1) return 0;
    if(gPickupInfo[pickupid][pickup_type] != PICKUP_SUBTYPE_INVALID_ID &&
        gPickupInfo[pickupid][pickup_type] != TYPE_COSSACK_ROBBERS &&
        gPickupInfo[pickupid][pickup_type] != TYPE_VEHICLE)
    {
        new object_id = gPickupInfo[pickupid][pickup_object_id];
        if(gPickupInfo[pickupid][pickup_type] == TYPE_BUSINESS && gPickupInfo[pickupid][pickup_subtype] == PICKUP_SUBTYPE_BUSINESS_ENTER &&
            (b_info[object_id][_tip] == B_EAT || b_info[object_id][_tip] == B_CAR_SERVICE || b_info[object_id][_tip] == B_FUEL))
            SetPVarInt(playerid, "bID", gPickupInfo[pickupid][pickup_object_id]);

        if(p_temp[playerid][EventPickupID] != pickupid)
        {
            p_temp[playerid][EventPickupID] = pickupid;
            GetPlayerPos(playerid, p_temp[playerid][PickupPosX], p_temp[playerid][PickupPosY], p_temp[playerid][PickupPosZ]);
        }
        if(p_info[playerid][p_settings][INTERFACE]) ShowTextDrawForPlayer(playerid, TD_ID_PRESS_ALT);
        else GameTextForPlayer(playerid, "~n~~n~~g~PRESS ~b~ALT", 2500, 6);
        return 1;
    }

    if(GetTickCount() - p_temp[playerid][TickPickup] < 15000/*&& p_info[playerid][halloween_id] != 2*/)
        return 1;

    p_temp[playerid][EventPickupID] = pickupid;
    GetPlayerPos(playerid, p_temp[playerid][PickupPosX], p_temp[playerid][PickupPosY], p_temp[playerid][PickupPosZ]);

    p_temp[playerid][TickPickup] = GetTickCount();

    #if EVENT_HALLOWEEN == 1
    if(pickupid >= HalloweenQuest_FlowersPickups[0] && pickupid <= HalloweenQuest_FlowersPickups[MAX_HALLOWEEN_FLOWERS-1])
    {
        if(p_info[playerid][halloween_id] == 2 && p_info[playerid][halloween_progress] < 3)
        {
            ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 1, 1, 1, 0);
            p_temp[playerid][ClearAnimFix] = 1;
            p_temp[playerid][ClearAnimTimerFix] = timestamp + 3;
            new result = random(5);
            if(result <= 2)
            {
                p_info[playerid][halloween_progress]++;
                MysqlUpdatePlayerInt(playerid, "halloween_progress", p_info[playerid][halloween_progress]);
                SendAccess(playerid, "Отлично, букет сорван.");
            }
            else SendError(playerid, "К сожалению, букет сорвать не удалось.");
            HalloweenQuest_Check(playerid);
        }
        return 1;
    }
    #endif

    switch(gPickupInfo[pickupid][pickup_type])
    {
        case TYPE_COSSACK_ROBBERS:
        {
            if(p_temp[playerid][cossack_robbers_register] != 2) return SendError(playerid, "Вы не участвуете в Казаках-разбойниках.");
            switch(gPickupInfo[pickupid][pickup_subtype])
            {
                case PICKUP_SUBTYPE_COS_ROB_A:
                {
                    GameTextForPlayer(playerid, "~b~ARMOUR: +100", 2000, 6);
                    SetPlayerArmour(playerid, 100);
                    SetPlayerChatBubble(playerid, "Надел(-а) бронежилет", COLOR_MAIN, 20.0, 10000);
                }
                case PICKUP_SUBTYPE_COS_ROB_H:
                {
                    GameTextForPlayer(playerid, "~b~HEAL: +100", 2000, 6);
                    p_info[playerid][pHealth] = 100.0;
                    SetPlayerHealth(playerid, p_info[playerid][pHealth]);
                    SetPlayerChatBubble(playerid, "Вылечил(-ся/-ась)", COLOR_MAIN, 20.0, 10000);
                }
            }
            return 1;
        }
        case TYPE_VEHICLE:
        {
            new vehicleid = gPickupInfo[pickupid][pickup_object_id];
            if(pickupid == veh_info[vehicleid][v_pickup])
            {
                if((army(playerid) == 1 || mafia(playerid) == 1 || gang(playerid) == 1 || biker(playerid) == 1 || IsPlayerFractionMedic(playerid) == 1 || p_temp[playerid][Work_ID] == OIL_WORK || p_temp[playerid][Work_ID] == ROADMAN_WORK))
                {
                    if(veh_info[vehicleid][v_loading] == 1 && p_temp[playerid][Work_ID] == DRUG_WORK)
                    {
                        if(veh_info[vehicleid][v_npoId] != p_info[playerid][member]) return SendError(playerid, "Транспортное средство не принадлежит Вашей фракции.");
                        if(p_temp[playerid][WorkCountDrug] != 500) return SendError(playerid, "У Вас нет наркотиков.");
                        if(veh_info[vehicleid][v_drugs] >= MAX_VEHICLE_DRUGS) return SendError(playerid, "В транспортном средстве нет места.");

                        new countOfDrugs = p_temp[playerid][WorkCountDrug];

                        veh_info[vehicleid][v_drugs] += countOfDrugs;
                        ClearAnimations(playerid);
                        ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                        if(veh_info[vehicleid][v_drugs] > MAX_VEHICLE_DRUGS) veh_info[vehicleid][v_drugs] = MAX_VEHICLE_DRUGS;

                        if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                        {
                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
                            "W"Наркотики: "I"%d гр из %d гр",
                            veh_info[vehicleid][v_drugs], MAX_VEHICLE_DRUGS);
                            Update3DTextLabelText(veh_info[vehicleid][v_text], COLOR_MAIN, STRING_GLOBAL);
                        }

                        new random_check = random(sizeof(drug_position)-1);
                        p_temp[playerid][WorkCheckDrug] = random_check;
                        p_temp[playerid][WorkCountDrug] = 0;

                        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);

                        SetPlayerCheckpoint(playerid, drug_position[random_check][0], drug_position[random_check][1], drug_position[random_check][2], 2.0);
                        SendInfo(playerid, "Чтобы начать сбор наркотиков отправляйтесь на место отмеченное на GPS навигаторе.");

                        if(gang(playerid))
                        {
                            p_info[playerid][fracdata][19] += countOfDrugs;
                            SaveFracData(playerid);
                            CheckPlayerMission(playerid, GANG_LDRUGS, countOfDrugs);

                            p_info[playerid][ftop_gload_drugs] += countOfDrugs;
                            MysqlUpdatePlayerInt(playerid, "ftop_gload_drugs", p_info[playerid][ftop_gload_drugs]);
                        }
                        else if(mafia(playerid))
                        {
                            p_info[playerid][fracdata][24] += countOfDrugs;
                            SaveFracData(playerid);
                            CheckPlayerMission(playerid, MAFIA_LDRUGS, countOfDrugs);

                            p_info[playerid][ftop_mload_drugs] += countOfDrugs;
                            MysqlUpdatePlayerInt(playerid, "ftop_mload_drugs", p_info[playerid][ftop_mload_drugs]);
                        }
                        else if(biker(playerid))
                        {
                            p_info[playerid][fracdata][29] += countOfDrugs;
                            SaveFracData(playerid);
                            CheckPlayerMission(playerid, BIKER_LDRUGS, countOfDrugs);

                            p_info[playerid][ftop_bload_drugs] += countOfDrugs;
                            MysqlUpdatePlayerInt(playerid, "ftop_bload_drugs", p_info[playerid][ftop_bload_drugs]);
                        }

                        UpdateFamilyLevel(playerid);
                        return 1;
                    }
                    if(veh_info[vehicleid][v_loading] == 2)
                    {
                        if(veh_info[vehicleid][v_npoId] != p_info[playerid][member]) return SendError(playerid, "Транспортное средство не принадлежит Вашей фракции.");

                        if(p_temp[playerid][LoadCount] == 0) return SendError(playerid, "У Вас нет ящика с патронами и материалами.");

                        if(veh_info[vehicleid][v_patron] == MAX_VEHICLE_PATRON_MATERIALS || veh_info[vehicleid][v_materials] == MAX_VEHICLE_PATRON_MATERIALS)
                        {
                            SendError(playerid, "В транспортном средстве нет места.");

                            ClearAnimations(playerid);
                            ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                            //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                            if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);

                            SetFractionWarehouse(NATIONAL_GUARD, fwMate, 500);
                            SetFractionWarehouse(NATIONAL_GUARD, fwPatron, 500);

                            UpdateWarehouseInfo(0);

                            p_temp[playerid][LoadCount] = 0;
                            return 1;
                        }

                        veh_info[vehicleid][v_patron] += 500;
                        veh_info[vehicleid][v_materials] += 500;

                        if(gang(playerid))
                        {
                            p_info[playerid][fracdata][21] += 1000;
                            SaveFracData(playerid);
                            CheckPlayerMission(playerid, GANG_LMATERIALS, 1000);

                            p_info[playerid][ftop_gload_materials] += 1000;
                            MysqlUpdatePlayerInt(playerid, "ftop_gload_materials", p_info[playerid][ftop_gload_materials]);
                        }
                        else if(mafia(playerid))
                        {
                            p_info[playerid][fracdata][26] += 1000;
                            SaveFracData(playerid);
                            CheckPlayerMission(playerid, MAFIA_LMATERIALS, 1000);

                            p_info[playerid][ftop_mload_materials] += 1000;
                            MysqlUpdatePlayerInt(playerid, "ftop_mload_materials", p_info[playerid][ftop_mload_materials]);
                        }
                        else if(biker(playerid))
                        {
                            p_info[playerid][fracdata][31] += 1000;
                            SaveFracData(playerid);
                            CheckPlayerMission(playerid, BIKER_LMATERIALS, 1000);

                            p_info[playerid][ftop_bload_materials] += 1000;
                            MysqlUpdatePlayerInt(playerid, "ftop_bload_materials", p_info[playerid][ftop_bload_materials]);
                        }

                        if(veh_info[vehicleid][v_patron] > MAX_VEHICLE_PATRON_MATERIALS) veh_info[vehicleid][v_patron] = MAX_VEHICLE_PATRON_MATERIALS;
                        if(veh_info[vehicleid][v_materials] > MAX_VEHICLE_PATRON_MATERIALS) veh_info[vehicleid][v_materials] = MAX_VEHICLE_PATRON_MATERIALS;

                        if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                        {
                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Патроны: "W"%d из %d"I"\nМатериалы: "W"%d из %d", veh_info[vehicleid][v_patron], MAX_VEHICLE_PATRON_MATERIALS, veh_info[vehicleid][v_materials], MAX_VEHICLE_PATRON_MATERIALS);
                            Update3DTextLabelText(veh_info[vehicleid][v_text], COLOR_MAIN, STRING_GLOBAL);
                        }

                        p_temp[playerid][LoadCount] = 0;

                        ClearAnimations(playerid);
                        ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
                        return 1;
                    }
                    if(veh_info[vehicleid][v_loading] == 3)
                    {
                        if(veh_info[vehicleid][v_npoId] != p_info[playerid][member]) return SendError(playerid, "Транспортное средство не принадлежит Вашей фракции.");

                        if(p_temp[playerid][LoadCount] == 0) return SendError(playerid, "У Вас нет ящика с патронами и материалами.");

                        if(veh_info[vehicleid][v_patron] == MAX_VEHICLE_PATRON_MATERIALS || veh_info[vehicleid][v_materials] == MAX_VEHICLE_PATRON_MATERIALS)
                        {
                            SendError(playerid, "В транспортном средстве нет места.");

                            ClearAnimations(playerid);
                            ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                            //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                            if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);

                            SetFractionWarehouse(NATIONAL_GUARD, fwMate, 500);
                            SetFractionWarehouse(NATIONAL_GUARD, fwPatron, 500);

                            UpdateWarehouseInfo(0);

                            p_temp[playerid][LoadCount] = 0;
                            return 1;
                        }

                        veh_info[vehicleid][v_patron] += 500;
                        veh_info[vehicleid][v_materials] += 500;

                        p_info[playerid][fracdata][9] += 1000;
                        SaveFracData(playerid);
                        CheckPlayerMission(playerid, ARMY_LMATERIALS, 1000);

                        UpdateFamilyLevel(playerid);

                        p_info[playerid][ftop_aload_materials] += 1000;
                        MysqlUpdatePlayerInt(playerid, "ftop_aload_materials", p_info[playerid][ftop_aload_materials]);

                        if(veh_info[vehicleid][v_patron] > MAX_VEHICLE_PATRON_MATERIALS) veh_info[vehicleid][v_patron] = MAX_VEHICLE_PATRON_MATERIALS;
                        if(veh_info[vehicleid][v_materials] > MAX_VEHICLE_PATRON_MATERIALS) veh_info[vehicleid][v_materials] = MAX_VEHICLE_PATRON_MATERIALS;

                        if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                        {
                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Патроны: "W"%d из %d"I"\nМатериалы: "W"%d из %d", veh_info[vehicleid][v_patron], MAX_VEHICLE_PATRON_MATERIALS, veh_info[vehicleid][v_materials], MAX_VEHICLE_PATRON_MATERIALS);
                            Update3DTextLabelText(veh_info[vehicleid][v_text], COLOR_MAIN, STRING_GLOBAL);
                        }

                        p_temp[playerid][LoadCount] = 0;

                        ClearAnimations(playerid);
                        ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
                        return 1;
                    }
                    if(veh_info[vehicleid][v_loading] == 4)
                    {
                        if(veh_info[vehicleid][v_npoId] != p_info[playerid][member]) return SendError(playerid, "Транспортное средство не принадлежит Вашей фракции.");

                        if(p_temp[playerid][LoadCount] == 0) return SendError(playerid, "У Вас нет мешка с медикаментами.");

                        if(veh_info[vehicleid][v_medicines] == MAX_VEHICLE_MEDICINES)
                        {
                            SendError(playerid, "В транспортном средстве нет места.");

                            ClearAnimations(playerid);
                            ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                            //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                            if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);

                            WarehouseMedicines += 500;
                            MysqlUpdateOtherInt("warehouse_medicines", WarehouseMedicines);

                            UpdateWarehouseInfo(1);

                            p_temp[playerid][LoadCount] = 0;
                            return 1;
                        }

                        veh_info[vehicleid][v_medicines] += 500;

                        p_info[playerid][fracdata][15] += 500;
                        SaveFracData(playerid);
                        CheckPlayerMission(playerid, HOSPITAL_LMEDICINES, 500);

                        UpdateFamilyLevel(playerid);

                        p_info[playerid][ftop_hload_medicines]++;
                        MysqlUpdatePlayerInt(playerid, "ftop_hload_medicines", p_info[playerid][ftop_hload_medicines]);

                        if(veh_info[vehicleid][v_medicines] > MAX_VEHICLE_MEDICINES) veh_info[vehicleid][v_patron] = MAX_VEHICLE_MEDICINES;

                        if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                        {
                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Медикаменты: "W"%d из %d", veh_info[vehicleid][v_medicines], MAX_VEHICLE_MEDICINES);
                            Update3DTextLabelText(veh_info[vehicleid][v_text], COLOR_MAIN, STRING_GLOBAL);
                        }

                        p_temp[playerid][LoadCount] = 0;

                        ClearAnimations(playerid);
                        ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
                        return 1;
                    }
                    if(veh_info[vehicleid][v_loading] == 5 && p_temp[playerid][Work_ID] == OIL_WORK)
                    {
                        if(veh_info[vehicleid][v_loading_playerid] != playerid) return SendError(playerid, "Данное транспортное средство арендовано другим игроком.");
                        if(veh_info[vehicleid][v_npoId] != p_info[playerid][job] && veh_info[vehicleid][v_temp_job] != p_info[playerid][job]) return SendError(playerid, "Транспортное средство не принадлежит Вашей работе.");
                        if(p_temp[playerid][oil_check] != 1) return SendError(playerid, "У Вас нет бочки с нефтью.");
                        new vehicle_model = GetVehicleModelEx(vehicleid), max_vehicle_oil = GetVehicleMaxOil(vehicle_model);
                        if(veh_info[vehicleid][v_oil_count] >= max_vehicle_oil) return SendError(playerid, "В транспортном средстве нет места.");

                        p_temp[playerid][oil_check] = 0;

                        veh_info[vehicleid][v_oil_count]++;
                        if(veh_info[vehicleid][v_oil_count] > max_vehicle_oil) veh_info[vehicleid][v_oil_count] = max_vehicle_oil;

                        if(vehicle_model == 578)
                        {
                            new oil_idx = veh_info[vehicleid][v_oil_count] - 1;
                            if(p_temp[playerid][oil_object][oil_idx] != INVALID_OBJECT_ID) DestroyDynamicObject(p_temp[playerid][oil_object][oil_idx]);
                            p_temp[playerid][oil_object][oil_idx] = CreateDynamicObject(3632, 0, 0, 0, 0, 0, 0);
                            AttachDynamicObjectToVehicle(p_temp[playerid][oil_object][oil_idx], vehicleid, OilVehicleCoords[oil_idx][0], OilVehicleCoords[oil_idx][1], OilVehicleCoords[oil_idx][2], OilVehicleCoords[oil_idx][3], OilVehicleCoords[oil_idx][4], OilVehicleCoords[oil_idx][5]);
                        }

                        ClearAnimations(playerid);
                        ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);

                        if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                        {
                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
                            "W"Бочек: "I"%d из %d шт",
                            veh_info[vehicleid][v_oil_count], max_vehicle_oil);
                            Update3DTextLabelText(veh_info[vehicleid][v_text], COLOR_MAIN, STRING_GLOBAL);
                        }
                        AntiCheatWarningTime[playerid][0] = timestamp + 90;

                        SendMes(playerid, COLOR_BLUE, "Вы загрузили бочку, отправляйтесь %s.", veh_info[vehicleid][v_oil_count] == max_vehicle_oil ? "на нефтебазу для разгрузки" : "за новой");
                        SendMes(playerid, COLOR_LGREEN, "Загружено {"#cLEMON"}%d{"#cLGREEN"} из {"#cLEMON"}%d{"#cLGREEN"} бочек.", veh_info[vehicleid][v_oil_count], max_vehicle_oil);
                        return 1;
                    }
                    if(veh_info[vehicleid][v_loading] == 6 && p_temp[playerid][Work_ID] == OIL_WORK)
                    {
                        if(veh_info[vehicleid][v_loading_playerid] != playerid) return SendError(playerid, "Данное транспортное средство арендовано другим игроком.");
                        if(veh_info[vehicleid][v_npoId] != p_info[playerid][job] && veh_info[vehicleid][v_temp_job] != p_info[playerid][job]) return SendError(playerid, "Транспортное средство не принадлежит Вашей работе.");
                        if(p_temp[playerid][oil_check] != 0) return SendError(playerid, "У Вас уже есть бочка с нефтью.");
                        if(!veh_info[vehicleid][v_oil_count]) return SendError(playerid, "В транспортном средстве ничего нет.");

                        p_temp[playerid][oil_check] = 2;

                        new vehicle_model = GetVehicleModelEx(vehicleid);

                        if(vehicle_model == 578)
                        {
                            new oil_idx = veh_info[vehicleid][v_oil_count] - 1;
                            if(p_temp[playerid][oil_object][oil_idx] != INVALID_OBJECT_ID)
                            {
                                DestroyDynamicObject(p_temp[playerid][oil_object][oil_idx]);
                                p_temp[playerid][oil_object][oil_idx] = INVALID_OBJECT_ID;
                            }
                        }

                        veh_info[vehicleid][v_oil_count]--;
                        if(veh_info[vehicleid][v_oil_count] < 0) veh_info[vehicleid][v_oil_count] = 0;
                        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
                        SetPlayerAttachedObject(playerid, 1, 3632, 6, 0.079000, 0.189999, -0.242001, -14.999999, -11.399994, -0.699999, 0.564000, 0.710000, 0.635000);
                        ClearAnimations(playerid);
                        ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 1, 0, 0, 1, 1);
                        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);

                        new max_vehicle_oil = GetVehicleMaxOil(GetVehicleModelEx(vehicleid));
                        if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                        {
                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
                            "W"Бочек: "I"%d из %d шт",
                            veh_info[vehicleid][v_oil_count], max_vehicle_oil);
                            Update3DTextLabelText(veh_info[vehicleid][v_text], COLOR_MAIN, STRING_GLOBAL);
                        }

                        SendMes(playerid, COLOR_BLUE, "Вы взяли бочку, отнесите её на склад нефтебазы.");
                        SendMes(playerid, COLOR_LGREEN, "Осталось {"#cLEMON"}%d{"#cLGREEN"} из {"#cLEMON"}%d{"#cLGREEN"} бочек.", veh_info[vehicleid][v_oil_count], max_vehicle_oil);
                        return 1;
                    }
                    if(veh_info[vehicleid][v_loading] == 7 && p_temp[playerid][Work_ID] == ROADMAN_WORK)
                    {
                        if(veh_info[vehicleid][v_loading_playerid] != playerid) return SendError(playerid, "Данное транспортное средство арендовано другим игроком.");
                        if(veh_info[vehicleid][v_npoId] != p_info[playerid][job]) return SendError(playerid, "Транспортное средство не принадлежит Вашей работе.");
                        if(!p_temp[playerid][roadman_check]) return SendError(playerid, "У Вас нет мешка с мусором.");
                        if(veh_info[vehicleid][v_roadman_count] >= MAX_ROADCRASH_VEHICLE_TRASH) return SendError(playerid, "В транспортном средстве нет места.");

                        p_temp[playerid][roadman_check] = 0;

                        veh_info[vehicleid][v_roadman_count]++;
                        if(veh_info[vehicleid][v_roadman_count] > MAX_ROADCRASH_VEHICLE_TRASH) veh_info[vehicleid][v_roadman_count] = MAX_ROADCRASH_VEHICLE_TRASH;

                        new trash_idx = veh_info[vehicleid][v_roadman_count] - 1;
                        if(p_temp[playerid][roadman_object][trash_idx] != INVALID_OBJECT_ID) DestroyDynamicObject(p_temp[playerid][roadman_object][trash_idx]);
                        p_temp[playerid][roadman_object][trash_idx] = CreateDynamicObject(2060, 0, 0, 0, 0, 0, 0);
                        AttachDynamicObjectToVehicle(p_temp[playerid][roadman_object][trash_idx], vehicleid, RoadCrashVehicleTrashCoords[trash_idx][0], RoadCrashVehicleTrashCoords[trash_idx][1], RoadCrashVehicleTrashCoords[trash_idx][2], RoadCrashVehicleTrashCoords[trash_idx][3], RoadCrashVehicleTrashCoords[trash_idx][4], RoadCrashVehicleTrashCoords[trash_idx][5]);

                        ClearAnimations(playerid);
                        ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);

                        if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                        {
                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
                            "W"Мешков с мусором: "I"%d из %d шт",
                            veh_info[vehicleid][v_roadman_count], MAX_ROADCRASH_VEHICLE_TRASH);
                            Update3DTextLabelText(veh_info[vehicleid][v_text], COLOR_MAIN, STRING_GLOBAL);
                        }

                        SendMes(playerid, COLOR_BLUE, "Вы загрузили мешок с мусором, отправляйтесь %s.", veh_info[vehicleid][v_roadman_count] == MAX_ROADCRASH_VEHICLE_TRASH ? "на ближайшую свалку для разгрузки" : "за новым");
                        SendMes(playerid, COLOR_LGREEN, "Загружено {"#cLEMON"}%d{"#cLGREEN"} из {"#cLEMON"}%d{"#cLGREEN"} мешков с мусором.", veh_info[vehicleid][v_roadman_count], MAX_ROADCRASH_VEHICLE_TRASH);
                        return 1;
                    }
                    if(veh_info[vehicleid][v_loading] == 8 && p_temp[playerid][Work_ID] == ROADMAN_WORK)
                    {
                        if(veh_info[vehicleid][v_loading_playerid] != playerid) return SendError(playerid, "Данное транспортное средство арендовано другим игроком.");
                        if(veh_info[vehicleid][v_npoId] != p_info[playerid][job]) return SendError(playerid, "Транспортное средство не принадлежит Вашей работе.");
                        if(p_temp[playerid][roadman_check]) return SendError(playerid, "У Вас уже есть мешок с мусором.");
                        if(!veh_info[vehicleid][v_roadman_count]) return SendError(playerid, "В транспортном средстве ничего нет.");

                        p_temp[playerid][roadman_check] = 1;

                        new trash_idx = veh_info[vehicleid][v_roadman_count] - 1;
                        if(p_temp[playerid][roadman_object][trash_idx] != INVALID_OBJECT_ID)
                        {
                            DestroyDynamicObject(p_temp[playerid][roadman_object][trash_idx]);
                            p_temp[playerid][roadman_object][trash_idx] = INVALID_OBJECT_ID;
                        }

                        veh_info[vehicleid][v_roadman_count]--;
                        if(veh_info[vehicleid][v_roadman_count] < 0) veh_info[vehicleid][v_roadman_count] = 0;
                        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
                        SetPlayerAttachedObject(playerid, 1, 2060, 1, 0.11, 0.36, 0.0, 0.0, 90.0);
                        ClearAnimations(playerid);
                        ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 1, 0, 0, 1, 1);
                        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);

                        if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                        {
                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
                            "W"Мешков с мусором: "I"%d из %d шт",
                            veh_info[vehicleid][v_roadman_count], MAX_ROADCRASH_VEHICLE_TRASH);
                            Update3DTextLabelText(veh_info[vehicleid][v_text], COLOR_MAIN, STRING_GLOBAL);
                        }

                        SendMes(playerid, COLOR_BLUE, "Вы взяли мешок с мусором, отнесите его на склад свалки.");
                        SendMes(playerid, COLOR_LGREEN, "Осталось {"#cLEMON"}%d{"#cLGREEN"} из {"#cLEMON"}%d{"#cLGREEN"} мешков с мусором.", veh_info[vehicleid][v_roadman_count], MAX_ROADCRASH_VEHICLE_TRASH);
                        return 1;
                    }
                }
            }
            return 1;
        }
    }

    if(pickupid >= arend_scooter[0] && pickupid <= arend_scooter[8])
    {
        if(p_info[playerid][level] > 3) return SendError(playerid, "Аренда скутеров доступна только для игроков до 3-его уровня.");
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Стоимость аренды: %d$.", p_info[playerid][level] <= 3 ? 0 : 5000);
        ShowPlayerDialog(playerid, D_AREND_SCOOTER, DIALOG_STYLE_MSGBOX, ""I"Аренда скутера", STRING_GLOBAL, "Далее", "Отмена");
        return 1;
    }
    if(pickupid == RC_DoorPickup[0])
    {
        ShowPlayerDialog(playerid, D_REAL_CARS_ENTER, DIALOG_STYLE_LIST, ""I"Выберите этаж", ""I"[1]"W" Первый этаж\n"I"[2]"W" Второй этаж\n"I"[3]"W" Третий этаж\n"I"[4]"W" Четвертый этаж\n"I"[5]"W" Пятый этаж\n"I"[6]"W" Шестой этаж", "Далее", "Отмена");
        return 1;
    }
    else if(pickupid == RC_DoorPickup[1])
    {
        ShowPlayerDialog(playerid, D_REAL_CARS_EXIT, DIALOG_STYLE_LIST, ""I"Выберите этаж", ""I"[1]"W" Улица\n"I"[2]"W" Первый этаж\n"I"[3]"W" Второй этаж\n"I"[4]"W" Третий этаж\n"I"[5]"W" Четвертый этаж\n"I"[6]"W" Пятый этаж\n"I"[7]"W" Шестой этаж", "Далее", "Отмена");
        return 1;
    }
    if(pickupid == pickup_drugden[0])
    {
        if(!gang(playerid)) return SendError(playerid, "У Вас нет ключей от этих дверей.");
        SetPlayerPos(playerid, 1457.5853,-668.1521,1015.2104);
        SetPlayerFacingAngle(playerid, 91.2173);
        SetPlayerInterior(playerid, 1);
        SetPlayerVirtualWorld(playerid, 1);
        return 1;
    }
    else if(pickupid == pickup_drugden[1])
    {
        SetPlayerPos(playerid, 2167.2527,-1672.6479,15.0759);
        SetPlayerFacingAngle(playerid, 220.8916);
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        return 1;
    }
    else if(pickupid >= TheftCarPickup[0] && pickupid <= TheftCarPickup[3])
    {
        if(p_temp[playerid][Work_ID] != THEFT_CAR_WORK || TheftCarGPS[playerid] != false) return 1;
        if(IsPlayerRentedVehicle(playerid, p_temp[playerid][rented_veh]))
        {
            veh_info[p_temp[playerid][rented_veh]][v_rented_ID] = INVALID_MYSQL_ID;
            DestroyVehicleVEx(p_temp[playerid][rented_veh]);
            p_temp[playerid][rented_veh] = INVALID_VEHICLE_ID;
        }
        new Float:x,Float:y,Float:z;
        GetPlayerPos(playerid,x,y,z);
        SetPlayerArmedWeapon(playerid,0);
        new car_id = CreateVehicleVEx(NPO_TEMPCAR, NPO_NONE, 462, x+random(1),y+random(1),z, 0.0, 0, 0, 120);
        veh_info[car_id][v_lock] = 1;
        veh_info[car_id][v_color] = 1;
        veh_info[car_id][v_model] = 462;
        veh_info[car_id][v_fuel] = GetVehicleData(GetVehicleModelEx(car_id), E_VD_MAX_FUEL);
        for(new i; i < 5; i++) veh_info[car_id][v_details][i] = 100.0;
        format(veh_info[car_id][v_number], 16, "NULL");
        veh_info[car_id][v_int] =
        veh_info[car_id][v_virt] =
        veh_info[car_id][v_insurance] =
        veh_info[car_id][v_insurance_time] = 0;
        veh_info[car_id][v_used_key_ID] = playerid;

        p_temp[playerid][rented_veh] = car_id;
        veh_info[car_id][v_rented_ID] = p_info[playerid][ID];
        PutPlayerInVehicle(playerid, car_id, 0);

        veh_info[car_id][v_engine] = 1;
        PlayerPlaySound(playerid, 31810, 0.0, 0.0, 0.0);
        STRING_GLOBAL[0] = EOS;
        MeAction(playerid, "завел(-а) двигатель");
        SetVehicleParamsVEx(car_id, veh_info[car_id][v_engine], veh_info[car_id][v_light], alarm, veh_info[car_id][v_lock], bonnet, boot, objective);
        OnPlayerUpdateVehicleInfo(playerid, SPEEDO_ENGINE);
        return 1;
    }
    else if(pickupid == TheftCarPickup[4])
    {
        if(TheftCarIDx[playerid] != -1) return ShowPlayerDialog(playerid, D_THEFT_CAR, DIALOG_STYLE_MSGBOX, ""I"Автоугон", ""W"У Вас уже есть контракт, Вы хотите его отменить?", "Да", "Нет");
        //if(!mafia(playerid) && !gang(playerid) && !biker(playerid)) return SendError(playerid, "Вы не состоите в нелегальной организации.");
        if(p_temp[playerid][Work_ID] != THEFT_CAR_WORK) return ShowPlayerDialog(playerid, D_THEFT_CAR, DIALOG_STYLE_MSGBOX, ""I"Автоугон", ""W"Вы желаете начать рабочий день?", "Далее", "Отмена");
        ShowPlayerDialog(playerid, D_THEFT_CAR, DIALOG_STYLE_LIST, ""I"Класс автомобиля",""I"[1]"W" Nope\n"I"[2]"W" C\n"I"[3]"W" B\n"I"[4]"W" A\n"I"[5]"W" Завершить рабочий день", "Далее", "Отмена");
        return 1;
    }
    else if(pickupid == pickup_sparring) // Спарринги;
    {
        ShowSparrings(playerid);
