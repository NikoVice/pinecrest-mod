                price = GetPriceWashSkins(InventoryPlayer[playerid][slot_id][inv_skin_wear]) * till;
            DeletePVar(playerid, "WASH:idx");
            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate.");
            if(InventoryPlayer[playerid][slot_id][inv_skin_wear] >= 100.0) return SendError(playerid, "Одежда не нуждается в стирке.");

            InventoryPlayer[playerid][slot_id][inv_skin_wear] = 100.0;

            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `inventory` SET `skin_wear` = 100.0 WHERE `mysql_id` = %d", InventoryPlayer[playerid][slot_id][inv_mysql_id]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            SendAccess(playerid, "Вы постирали одежду \"%s\" за %d$.", ItemsInfo[itemID][iName], price);
            if(b_info[biz_id][_prod] >= price / 100)
            {
                b_info[biz_id][_prod] -= price / 100;
                b_info[biz_id][_bank] += price - (price / 10);
                AddMafiaBank(biz_id, price / 10);

                biz_finka[biz_id] += price - (price / 10);
                UpdateIntForFinanceBiz(biz_id, price - (price / 10));
