                    mysql_tquery(con_bd, STRING_GLOBAL, "leave_offline", "i", playerid);
                }
                case 2:
                {
                    new Cache: result, rang_id, member_name[MAX_PLAYER_NAME], warns;
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name`, `rang`, `fwarn` FROM `accounts` WHERE `id` = %d LIMIT 1", player_mysql_id);
                    result = mysql_query(con_bd, STRING_GLOBAL);
                    if(cache_num_rows() != 0)
                    {
                        cache_get_value_name(0, "name", member_name);
                        cache_get_value_name_int(0, "rang", rang_id);
                        cache_get_value_name_int(0, "fwarn", warns);

                        if(rang_id >= p_info[playerid][rang])
                            return SendError(playerid, "� ��� ������������� ����.");

                        if(++warns >= 3)
                        {
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id`, `member`, `rang` FROM `accounts` WHERE `id` = %d LIMIT 1", player_mysql_id);
                            mysql_tquery(con_bd, STRING_GLOBAL, "leave_offline", "i", playerid);
                        }
                        else
                        {
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `fwarn` = %d WHERE `id` = %d LIMIT 1", warns, player_mysql_id);
                            mysql_tquery(con_bd, STRING_GLOBAL);

                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s[%d] ����� %s �������������� � ��������.", get_name(playerid), playerid, member_name);
                            SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
                        }
                    }
                    else SendError(playerid, "������ �� �������.");
                    cache_delete(result);
                }
                case 3:
                {
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name`, `rang`, `sex` FROM `accounts` WHERE `id` = %d", player_mysql_id);
                    mysql_tquery(con_bd, STRING_GLOBAL, "FractionPlayerChangeRang", "ii", playerid, player_mysql_id);
                }
            }
            return 1;
        }
