ClearHospitalBed(playerid)
{
    new bed_id = p_temp[playerid][hospital_bed_id],
        hb_id = -1;
    for(new i; i < 3; i++)
    {
        if(HospitalBedInfo[bed_id][hb_Busy][i] == playerid)
        {
            hb_id = i;
            HospitalBedInfo[bed_id][hb_Busy][hb_id] = INVALID_PLAYER_ID;
            break;
        }
    }
    if(hb_id == -1) return 1;

    ClearAnimations(playerid);
    p_temp[playerid][hospital_bed_id] = -1;
    Fix_TogglePlayerControllable(playerid, true);
    SetPlayerDrunkLevel(playerid, 0);
    f(STRING_GLOBAL, ""I"\
    �����: "W"#%d"I"\n\n\
    ����������� "W"/hospital"I" ��� "W"\"ALT\""I" ����� ������ �", bed_id+1);
    UpdateDynamic3DTextLabelText(HospitalBedInfo[bed_id][hb_Text][hb_id], 0xFFFFFFFF, STRING_GLOBAL );
    return 1;
}

