            for(new i = strlen(inputtext)-1; i != -1; i--)
            {
                switch(inputtext[i])
                {
                    case '0'..'9', 'а'..'я', 'a'..'z', 'А'..'Я', 'A'..'Z': continue;
                    default: return ErrorDialogMessage(playerid, 2, 1);
                }
            }
            bcrypt_check(inputtext, p_info[playerid][password], "OnPasswordCheckAuth", "d", playerid);
            return 1;
        }
