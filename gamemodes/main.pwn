VEx_AddVehicleComponent(vehicleid, componentid)
{
    if(!IsVehicleUpgradeCompatible(GetVehicleModelEx(vehicleid), componentid)) return 0;
    AddVehicleComponent(vehicleid, componentid);
    return 1;
}
