            {
                idx = p_temp[playerid][p_listitem][i];
                iTax += VideoCardsInfo[idx][vcTax];
                if(VideoCardsInfo[idx][vcBizIDx] == 0) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]), SendError(playerid, "На данной видеокарте нет договора с электростанцией.");
            }
            if(p_info[playerid][cash] < iTax) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]), SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            if(iTax <= 0) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]), SendError(playerid, "Данные видеокарты ещё не обладают налогом.");

            for(new i = p_temp[playerid][p_listitem_int]-1; i != -1; i--)
            {
                idx = p_temp[playerid][p_listitem][i];

                VideoCardsInfo[idx][vcTax] = 0;
                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `videocards` SET `tax` = 0 WHERE `id` = %d", VideoCardsInfo[idx][vcMySQLIDx]);
                mysql_tquery(con_bd, STRING_GLOBAL);

                new biz_id = VideoCardsInfo[idx][vcBizIDx];
                if(b_info[biz_id][_prod] >= ((iTax / 100) * 20) / 100)
                {
                    b_info[biz_id][_prod] -= ((iTax / 100) * 20) / 100;
                    b_info[biz_id][_bank] += ((iTax / 100) * 20) - ((iTax / 100) * 2);
                    AddMafiaBank(biz_id, (iTax / 100) * 2);

                    biz_finka[biz_id] += ((iTax / 100) * 20) - ((iTax / 100) * 2);
                    UpdateIntForFinanceBiz(biz_id, ((iTax / 100) * 20) - ((iTax / 100) * 2));
                }
            }
            SendAccess(playerid, "Вы оплатили налог на электричество в размере %d$.", iTax);
            SetPlayerMoney(playerid, -iTax, true, "оплатил налог на видеокарты");
            ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]);
            return 1;
        }
