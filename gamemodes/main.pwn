        case D_GET_GUN:
        {
            if(!response) return 1;

            new id = p_info[playerid][member];

            if(GetFactionCategory(id) == FACTION_CATEGORY_PD || GetFactionCategory(id) == FACTION_CATEGORY_MAYOR) {
                if(!(0 <= listitem <= sizeof(pdWEAPON)))
                    return 1;
                if(listitem == sizeof(pdWEAPON)) {
                    SetPlayerArmour(playerid, 100.0);
                    SendAccess(playerid, "Вы взяли бронежилет.");
                    return 1;
                }
                if(pdWEAPON[listitem][g_Patr] > GetFractionWarehouse(id, fwPatron)) {
                    SendError(playerid, "На складе недостаточно патронов.");
                    return 1;
                }
                if(pdWEAPON[listitem][g_Matr] > GetFractionWarehouse(id, fwMate)) {
                    SendError(playerid, "На складе недостаточно материалов.");
                    return 1;
                }

                new weapon, ammo;
                GetPlayerWeaponData(playerid, WEAPON_Slot[pdWEAPON[listitem][g_Id]], weapon, ammo);
                switch(weapon)
                {
                    case WEAPON_NITESTICK:
                        if(ammo >= 1) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_TEARGAS:
                        if(ammo >= 5) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_COLT45, WEAPON_DEAGLE:
                        if(ammo >= 50) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_SHOTGUN:
                        if(ammo >= 30) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_M4, WEAPON_AK47:
                        if(ammo >= 300) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_UZI, WEAPON_MP5:
                        if(ammo >= 150) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                }
                f_GivePlayerWeapon(playerid, pdWEAPON[listitem][g_Id], pdWEAPON[listitem][g_Patr]);

                SetFractionWarehouse(id, fwMate, -pdWEAPON[listitem][g_Matr]);
                SetFractionWarehouse(id, fwPatron, -pdWEAPON[listitem][g_Patr]);
            }
            else if(GetFactionCategory(id) == FACTION_CATEGORY_FBI) {
                if(!(0 <= listitem <= sizeof(fbiWEAPON)))
                    return 1;
                if(listitem == sizeof(fbiWEAPON)) {
                    SetPlayerArmour(playerid, 100.0);
                    SendAccess(playerid, "Вы взяли бронежилет.");
                    return 1;
                }
                if(fbiWEAPON[listitem][g_Patr] > GetFractionWarehouse(id, fwPatron)) {
                    SendError(playerid, "На складе недостаточно патронов.");
                    return 1;
                }
                if(fbiWEAPON[listitem][g_Matr] > GetFractionWarehouse(id, fwMate)) {
                    SendError(playerid, "На складе недостаточно материалов.");
                    return 1;
                }

                new weapon, ammo;
                GetPlayerWeaponData(playerid, WEAPON_Slot[fbiWEAPON[listitem][g_Id]], weapon, ammo);
                switch(weapon)
                {
                    case WEAPON_NITESTICK:
                        if(ammo >= 1) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_TEARGAS:
                        if(ammo >= 5) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_COLT45, WEAPON_DEAGLE:
                        if(ammo >= 50) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_SHOTGUN:
                        if(ammo >= 30) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_M4, WEAPON_AK47:
                        if(ammo >= 300) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_UZI, WEAPON_MP5:
                        if(ammo >= 150) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                }

                f_GivePlayerWeapon(playerid, fbiWEAPON[listitem][g_Id], fbiWEAPON[listitem][g_Patr]);

                SetFractionWarehouse(id, fwMate, -fbiWEAPON[listitem][g_Matr]);
                SetFractionWarehouse(id, fwPatron, -fbiWEAPON[listitem][g_Patr]);
            }
            else if(GetFactionCategory(id) == FACTION_CATEGORY_ARMY) {
                if(!(0 <= listitem <= sizeof(armyWEAPON)))
                    return 1;
                if(listitem == sizeof(armyWEAPON)) {
                    SetPlayerArmour(playerid, 100.0);
                    SendAccess(playerid, "Вы взяли бронежилет.");
                    return 1;
                }
                if(armyWEAPON[listitem][g_Patr] > GetFractionWarehouse(id, fwPatron))
                    return SendError(playerid, "На складе недостаточно патронов.");

                if(armyWEAPON[listitem][g_Matr] > GetFractionWarehouse(id, fwMate))
                    return SendError(playerid, "На складе недостаточно материалов.");

                new weapon, ammo;
                GetPlayerWeaponData(playerid, WEAPON_Slot[armyWEAPON[listitem][g_Id]], weapon, ammo);
                switch(weapon)
                {
                    case WEAPON_NITESTICK:
                        if(ammo >= 1) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_TEARGAS:
                        if(ammo >= 5) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_COLT45, WEAPON_DEAGLE:
                        if(ammo >= 50) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_SHOTGUN:
                        if(ammo >= 30) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_M4, WEAPON_AK47:
                        if(ammo >= 300) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_UZI, WEAPON_MP5:
                        if(ammo >= 150) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                }
                f_GivePlayerWeapon(playerid, armyWEAPON[listitem][g_Id], armyWEAPON[listitem][g_Patr]);

                SetFractionWarehouse(id, fwMate, -armyWEAPON[listitem][g_Matr]);
                SetFractionWarehouse(id, fwPatron, -armyWEAPON[listitem][g_Patr]);
            }
            else if(GetFactionCategory(id) == FACTION_CATEGORY_PRISON) {
                if(!(0 <= listitem <= sizeof(prisonWEAPON)))
                    return 1;
                if(listitem == sizeof(prisonWEAPON)) {
                    SetPlayerArmour(playerid, 100.0);
                    SendAccess(playerid, "Вы взяли бронежилет.");
                    return 1;
                }
                if(prisonWEAPON[listitem][g_Patr] > GetFractionWarehouse(id, fwPatron))
                    return SendError(playerid, "На складе недостаточно патронов.");

                if(prisonWEAPON[listitem][g_Matr] > GetFractionWarehouse(id, fwMate))
                    return SendError(playerid, "На складе недостаточно материалов.");

                new weapon, ammo;
                GetPlayerWeaponData(playerid, WEAPON_Slot[prisonWEAPON[listitem][g_Id]], weapon, ammo);
                switch(weapon)
                {
                    case WEAPON_TEARGAS:
                        if(ammo >= 5) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_COLT45, WEAPON_DEAGLE:
                        if(ammo >= 50) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_SHOTGUN:
                        if(ammo >= 30) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_M4, WEAPON_AK47:
                        if(ammo >= 300) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    case WEAPON_UZI, WEAPON_MP5:
                        if(ammo >= 150) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                }
                f_GivePlayerWeapon(playerid, prisonWEAPON[listitem][g_Id], prisonWEAPON[listitem][g_Patr]);

                SetFractionWarehouse(id, fwMate, -prisonWEAPON[listitem][g_Matr]);
                SetFractionWarehouse(id, fwPatron, -prisonWEAPON[listitem][g_Patr]);
            }
            //GetPlayerWeaponData(playerid, i, weapons[i][0], weapons[i][1]);

            if(p_info[playerid][p_settings][ROLEPLAY] == 1)
            {
                DoAction(playerid, "Склад открыт.");
                MeAction(playerid, "осмотрев содержимое склада достал из него нужное оружие, после чего закрыл склад");
            }
            return 1;
        }
        case D_MAKE_GUN:
        {
            if(!response) return 1;
            p_temp[playerid][p_listitem_int] = -1;
            new gangzone = GetGangZoneID(playerid),
                familyzone = GetFamilyZoneID(playerid),
                family_idx = GetPlayerFamilyID(playerid);
            
            STRING_GLOBAL[0] = EOS;
            if(GetPlayerInterior(playerid) == FractionsData[p_info[playerid][member]][fBaseField][fInterior] || 
                GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_GANG && gangzone != INVALID_CRIMINAL_ZONE_ID && GangZone_Info[gangzone][g_Fraction] == p_info[playerid][member])
            {
                switch(GetFactionCategory(p_info[playerid][member]))
                {
                    case FACTION_CATEGORY_MAFIA:
                    {
                        if(!(0 <= listitem <= sizeof(mafiaWEAPON)-1))
                            return 1;

                        if(mafiaWEAPON[listitem][g_Matr] > GetInventoryAmount(playerid, 627))
                        {
                            SendError(playerid, "У Вас нет столько материалов.");
                            return 1;
                        }
                        new weapon, ammo;
                        GetPlayerWeaponData(playerid, WEAPON_Slot[mafiaWEAPON[listitem][g_Id]], weapon, ammo);
                        switch(weapon)
                        {
                            case WEAPON_TEARGAS:
                                if(ammo >= 5) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                            case WEAPON_COLT45, WEAPON_DEAGLE:
                                if(ammo >= 50) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                            case WEAPON_SHOTGUN:
                                if(ammo >= 30) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                            case WEAPON_M4, WEAPON_AK47:
                                if(ammo >= 300) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                            case WEAPON_UZI, WEAPON_MP5:
                                if(ammo >= 150) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                        }
                        p_temp[playerid][p_listitem_int] = listitem;
                    }
                    case FACTION_CATEGORY_GANG:
                    {
                        if(!(0 <= listitem <= sizeof(gangWEAPON)-1))
                            return 1;
                        if(gangWEAPON[listitem][g_Matr] > GetInventoryAmount(playerid, 627))
                        {
                            SendError(playerid, "У Вас нет столько материалов.");
                            return 1;
                        }
                        new weapon,
                            ammo;
                        GetPlayerWeaponData(playerid, WEAPON_Slot[gangWEAPON[listitem][g_Id]], weapon, ammo);
                        switch(weapon)
                        {
                            case WEAPON_TEARGAS:
                                if(ammo >= 5) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                            case WEAPON_COLT45, WEAPON_DEAGLE:
                                if(ammo >= 50) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                            case WEAPON_SHOTGUN:
                                if(ammo >= 30) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                            case WEAPON_M4, WEAPON_AK47:
                                if(ammo >= 300) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                            case WEAPON_UZI, WEAPON_MP5:
                                if(ammo >= 150) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                        }
                        p_temp[playerid][p_listitem_int] = listitem;
                    }
                    case FACTION_CATEGORY_BIKER:
                    {
                        if(!(0 <= listitem <= sizeof(bikerWEAPON)-1))
                            return 1;

                        if(bikerWEAPON[listitem][g_Matr] > GetInventoryAmount(playerid, 627))
                        {
                            SendError(playerid, "У Вас нет столько материалов.");
                            return 1;
                        }
                        new weapon,
                            ammo;
                        GetPlayerWeaponData(playerid, WEAPON_Slot[bikerWEAPON[listitem][g_Id]], weapon, ammo);
                        switch(weapon)
                        {
                            case WEAPON_TEARGAS:
                                if(ammo >= 5) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                            case WEAPON_COLT45, WEAPON_DEAGLE:
                                if(ammo >= 50) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                            case WEAPON_SHOTGUN:
                                if(ammo >= 30) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                            case WEAPON_M4, WEAPON_AK47:
                                if(ammo >= 300) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                            case WEAPON_UZI, WEAPON_MP5:
                                if(ammo >= 150) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                        }
                        p_temp[playerid][p_listitem_int] = listitem;
                    }
                }
            }
            if(family_idx != -1)
            {
                new fhouse_id = FamilyData[family_idx][fHouseID];
                if((familyzone != INVALID_CRIMINAL_ZONE_ID && FamilyZone_Info[familyzone][fFamilyOwner] == FamilyData[family_idx][fMysqlID]) || 
                    (fhouse_id != INVALID_HOUSE_ID && IsPlayerInRangeOfPoint(playerid, 50.0, h_info[fhouse_id][h_enter][0],h_info[fhouse_id][h_enter][1], h_info[fhouse_id][h_enter][2])) ||
                    (fhouse_id != INVALID_HOUSE_ID && GetPlayerVirtualWorld(playerid) == FamilyData[family_idx][fHouseID]+50))
                {
                    if(!(0 <= listitem <= sizeof(gangWEAPON)-1))
                        return 1;

                    if(gangWEAPON[listitem][g_Matr] > GetInventoryAmount(playerid, 627))
                    {
                        SendError(playerid, "У Вас нет столько материалов.");
                        return 1;
                    }
                    new weapon,
                        ammo;
                    GetPlayerWeaponData(playerid, WEAPON_Slot[gangWEAPON[listitem][g_Id]], weapon, ammo);
                    switch(weapon)
                    {
                        case WEAPON_TEARGAS:
                            if(ammo >= 5) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                        case WEAPON_COLT45, WEAPON_DEAGLE:
                            if(ammo >= 50) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                        case WEAPON_SHOTGUN:
                            if(ammo >= 30) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                        case WEAPON_M4, WEAPON_AK47:
                            if(ammo >= 300) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                        case WEAPON_UZI, WEAPON_MP5:
                            if(ammo >= 150) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    }
                    p_temp[playerid][p_listitem_int] = listitem+1000;
                }
            }
            if(p_temp[playerid][p_listitem_int] == -1) return 1;
            ShowPlayerDialog(playerid, D_MAKE_GUN_PATR, DIALOG_STYLE_INPUT, ""I"Патроны", ""W"Введите сколько сделать патронов?", "Ввести", "Отмена");
            return 1;
        }
        case D_MAKE_GUN_PATR:
        {
            if(!response) return 1;
            new fix_listitem = strval(inputtext);
            if(!(1 <= fix_listitem <= GetInventoryAmount(playerid, 628)))
            {
                ShowPlayerDialog(playerid, D_MAKE_GUN_PATR, DIALOG_STYLE_INPUT, ""I"Патроны", ""W"Введите сколько сделать патронов?", "Ввести", "Отмена");
                SendError(playerid, "У Вас нет столько патронов.");
                return 1;
            }

            new idx = p_temp[playerid][p_listitem_int],
                id = p_info[playerid][member];
            if(idx-1000 >= 0)
            {
                idx -= 1000;
                if(!GivePlayerInventory(playerid, 627, -gangWEAPON[idx][g_Matr]))
                    return SendError(playerid, "В инвентаре нет достаточно материалов.");
                f_GivePlayerWeapon(playerid, gangWEAPON[idx][g_Id], fix_listitem);
            }
            else
            {
                if(GetFactionCategory(id) == FACTION_CATEGORY_MAFIA)
                {
                    if(!GivePlayerInventory(playerid, 627, -mafiaWEAPON[idx][g_Matr]))
                        return SendError(playerid, "В инвентаре нет достаточно материалов.");
                    f_GivePlayerWeapon(playerid, mafiaWEAPON[idx][g_Id], fix_listitem);
                }
                else if(GetFactionCategory(id) == FACTION_CATEGORY_GANG)
                {
                    if(!GivePlayerInventory(playerid, 627, -gangWEAPON[idx][g_Matr]))
                        return SendError(playerid, "В инвентаре нет достаточно материалов.");
                    f_GivePlayerWeapon(playerid, gangWEAPON[idx][g_Id], fix_listitem);
                }
                else if(GetFactionCategory(id) == FACTION_CATEGORY_BIKER)
                {
                    if(!GivePlayerInventory(playerid, 627, -bikerWEAPON[idx][g_Matr]))
                        return SendError(playerid, "В инвентаре нет достаточно материалов.");
                    f_GivePlayerWeapon(playerid, bikerWEAPON[idx][g_Id], fix_listitem);
                }
            }
            p_temp[playerid][p_listitem_int] = -1;
            if(!GivePlayerInventory(playerid, 628, -fix_listitem))
                return SendError(playerid, "В инвентаре нет достаточно патронов.");
            callcmd::makegun(playerid);
            return 1;
        }
        case D_PICK:
        {
            if(!response) return 1;
            SendAccess(playerid, "Вы проголосовали за %s.", PickName[listitem]);
            PickVote[listitem]++;
            format(PickVotes, 128, "%d, %d, %d, %d, %d, %d, %d", PickVote[0], PickVote[1], PickVote[2], PickVote[3], PickVote[4], PickVote[5], PickVote[6]);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `mayor` SET `votes` = '%e'", PickVotes);
            mysql_tquery(con_bd, STRING_GLOBAL);

            p_info[playerid][pick] = 1;
            MysqlUpdatePlayerInt(playerid, "pick", p_info[playerid][pick]);
            return 1;
        }
        case D_PICK_SETTINGS:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0:
                {
                    if(Pick == true) return SendError(playerid, "В штате уже проходят выборы.");
                    SendMesAll(0xFFD700FF, "Внимание! "W"В штате начались выборы. Длительность: 12 часов.");
                    PickDate = timestamp+43200;
                    Pick = true;

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `mayor` SET `pick` = 1, `name` = 'None, None, None, None, None, None, None', `votes` = '0, 0, 0, 0, 0, 0, 0', `time` = %d",
                    PickDate);
                    mysql_tquery(con_bd, STRING_GLOBAL,  "", "");

                    for(new i; i < 7; i++) { strmid(PickName[i], "None", 0, strlen("None"), MAX_PLAYER_NAME); PickVote[i] = 0; }
                }
                case 1:
                {
                    if(Pick == false) return SendError(playerid, "В штате нет выборов.");
                    SendMesAll(0xFFD700FF, "Внимание! "W"Выборы отменены администрацией сервера.");
                    ResetPick();
                }
                case 2:
                {
                    if(Pick == false) return SendError(playerid, "В штате нет выборов.");
                    STRING_GLOBAL[0] = EOS;
                    for(new i; i <= 6; i++) f(STRING_GLOBAL, "%s"I"[%d]"W" %s\n", STRING_GLOBAL, i+1, PickName[i]);
                    ShowPlayerDialog(playerid, D_PICK_CANDIDATE, DIALOG_STYLE_LIST, ""I"Кандидаты", STRING_GLOBAL, "Далее", "Отмена");
                }
            }
            return 1;
        }
        case D_PICK_CANDIDATE:
        {
            if(!response) return 1;
            ShowPlayerDialog(playerid, D_PICK_CANDIDATE_ADD, DIALOG_STYLE_INPUT, ""I"Кандидат", ""W"Введите имя кандидата:", "Далее", "Отмена");
            SetPVarInt(playerid, "NumberPick", listitem);
            return 1;
        }
        case D_PICK_CANDIDATE_ADD:
        {
            if(!response) { DeletePVar(playerid, "NumberPick"); return 1; }
            new c = GetPVarInt(playerid, "NumberPick");
            if(!strlen(inputtext) || strlen(inputtext) < 4 || strlen(inputtext) > 24) return ShowPlayerDialog(playerid, D_PICK_CANDIDATE_ADD, DIALOG_STYLE_INPUT, ""I"Кандидат", ""W"Введите имя кандидата:", "Далее", "Отмена");
            if(sscanf(inputtext, "s[64]", PickName[c])) return ShowPlayerDialog(playerid, D_PICK_CANDIDATE_ADD, DIALOG_STYLE_INPUT, ""I"Кандидат", ""W"Введите имя кандидата:", "Далее", "Отмена");
            format(PickNames, 256, "%s, %s, %s, %s, %s, %s, %s", PickName[0], PickName[1], PickName[2], PickName[3], PickName[4], PickName[5], PickName[6]);
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `mayor` SET `name` = '%e'",
            PickNames);
            mysql_tquery(con_bd, STRING_GLOBAL);

            SendAccess(playerid, "Вы добавили %s в кандидаты.", PickName[c]);
            DeletePVar(playerid, "NumberPick");
            return 1;
        }
    }
    return 1;
}

forward MysqlCheckPhoneNumber(playerid);
public MysqlCheckPhoneNumber(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(rows) return SendError(playerid, "Данный номер телефона занят."), ShowPlayerDialog(playerid,44,1,""I"Изменить номер телефона",""W"Введите новый номер телефона:\n\n{"#cLIGHTRED"}Обратите внимание! Номер телефона должен состоять из 6 цифр.","Далее","Отмена"), DeletePVar(playerid, "NumberPhone"), PhoneBuyNumber = false;

    new number = GetPVarInt(playerid, "NumberPhone");
    DeletePVar(playerid, "NumberPhone");

    p_info[playerid][phone_number] = number;
    MysqlUpdatePlayerInt(playerid, "phone_number", p_info[playerid][phone_number]);

    SendAccess(playerid, "Вы приобрели номер телефона %d.", p_info[playerid][phone_number]);

    new bizid = GetPVarInt(playerid, "bID"), till = b_info[bizid][_till];

    new price = 1000 * till, prod = price / 100;
    if(b_info[bizid][_prod] >= prod)
    {
        b_info[bizid][_prod] -= prod;
        b_info[bizid][_bank] += (price / 100) * 90;
        AddMafiaBank(bizid, price/10);

        biz_finka[bizid] += (price / 100) * 90;
        UpdateIntForFinanceBiz(bizid, (price / 100) * 90);
    }
    OnServerInfoForMoney[10] += price;
    SetPlayerMoney(playerid, -price, true, "купил симкарту/номер телефона (%d)", p_info[playerid][phone_number]);

    PhoneBuyNumber = false;
    return 1;
}

forward MysqlCheckPhoneNumberDonate(playerid);
public MysqlCheckPhoneNumberDonate(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(rows) return ShowPlayerDialog(playerid, D_DONATE_BUY_NUMBER, DIALOG_STYLE_INPUT, ""I"Номер телефона", ""W"Введите номер телефона от "I"3"W" до "I"6"W" цифр:\n\n{"#cLIGHTRED"}Обратите внимание! От количества одинаковых цифр зависит стоимость номера телефона.", "Далее", "Отмена"), SendError(playerid, "Данный номер телефона занят.");
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы желаете приобрести номер "I"%d"W" стоимостью "I"%d Pinecrest Money?", GetPVarInt(playerid, "DonateNumberPhone"), GetPVarInt(playerid, "DonateNumberPhonePrice"));
    ShowPlayerDialog(playerid, D_DONATE_BUY_NUMBER_ACT, DIALOG_STYLE_MSGBOX, ""I"Номер телефона", STRING_GLOBAL, "Да", "Нет");
    return 1;
}

public OnDynamicObjectMoved(objectid)
{
    for(new i = 0; i < totalsmachines; i++)
    {
        for(new f = 1; f <= 3; f++)
        {
            if(objectid == SlotMachine[i][sm_Objects][f])
            {
                SlotMachine[i][sm_objStop]++;
                if(SlotMachine[i][sm_objStop] == 3 && SlotMachine[i][sm_userID] != -1)
                {
                    new playerid = SlotMachine[i][sm_userID], str[128];
                    if(SlotMachine[i][sm_comb] == 0)
                    {
                        SendInfo(playerid, "Вы проиграли: $%d.", SlotMachine[i][sm_bet]);
                        format(str, sizeof(str), "$%d", SlotMachine[i][sm_bet]);
                        SetPlayerChatBubble(playerid, str, COLOR_RED, 20.0, 10000);
                    }
                    else
                    {
                        new winMoney = SlotMachine[i][sm_bet] * SlotMachine[i][sm_comb];
                        SendInfo(playerid, "Вы выиграли: $%d.", winMoney);
                        format(str, sizeof(str), "$%d", winMoney);
                        SetPlayerChatBubble(playerid, str, COLOR_GREEN, 20.0, 10000);
                        PlayerPlaySound(playerid, 4201, 0.0, 0.0, 0.0);
                        SetPlayerMoney(playerid, winMoney, true, "выигрыш в игровом автомате");
                        format(str, sizeof(str), "~w~BALANCE: ~g~$%d.~n~~w~RATE: ~y~$%d.", p_info[playerid][cash], SlotMachine[i][sm_bet]);
                        PlayerTextDrawSetString(playerid, SlotMScoreTD[playerid], str);
                        PlayerTextDrawShow(playerid, SlotMScoreTD[playerid]);
                    }
                }
                return 1;
            }
        }
    }
    return 1;
}
public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
    if(p_temp[playerid][TextDrawPinCode] == true || p_temp[playerid][TextDrawCaptcha]) return Captcha_OnPlayerClickTextDraw(playerid, clickedid);
    if(p_info[playerid][loggedIn] != 1) return 0;
    if(p_info[playerid][exchangePartner] != INVALID_PLAYER_ID && p_temp[playerid][TextDrawTrade] == false && (
        p_temp[playerid][TextDrawShopUse] == true ||
        p_temp[playerid][TextDrawCasinoUse] == true ||
        p_temp[playerid][TextDrawInventory] == true ||
        p_temp[playerid][TextDrawCraft] == true ||
        p_temp[playerid][TextDrawBattlePass] == true ||
        p_temp[playerid][TextDrawDaily] == true ||
        p_temp[playerid][TextDrawMarket] == true ||
        p_temp[playerid][TextDrawRoulette] == true ||
        p_temp[playerid][TextDrawCase] == true ||
        p_temp[playerid][TextDrawPhone] == true ||
        p_temp[playerid][TextDrawCarFactory] == true ||
        p_temp[playerid][TextDrawEditor] == true ||
        p_temp[playerid][TextDrawFarm] == true ||
        p_temp[playerid][SlotMachineTextDraw] == true ||
        p_temp[playerid][TextDrawServiceTune] == true ||
        p_temp[playerid][TextDrawPlayerMenu] == true ||
        p_temp[playerid][TextDrawPanel] == true ||
        p_temp[playerid][TextDrawDonateInfo] == true ||
        p_temp[playerid][TextDrawBox] == true ||
        p_temp[playerid][TextDrawRobberyRobbing] == true ||
        p_info[playerid][durak_table] ||
        blackjackPlayerData[playerid][BJ_CurrentTableID] != -1)) return SendError(playerid, "У Вас не законченный трейд.");
    if(clickedid == Text:INVALID_TEXT_DRAW)
    {
        if(MdcInfo[playerid][mdcCreated] == 1) SelectTextDraw(playerid, 255);
        if(p_temp[playerid][TextDrawShopUse] == true) SelectTextDraw(playerid, -8708097);
        if(p_temp[playerid][TextDrawCasinoUse] == true) ShowPlayerDialog(playerid, D_DICE_EXIT, DIALOG_STYLE_MSGBOX, ""I"Выход", ""W"Если Вы сделали ставку и игра уже началась, то деньги Вам не вернутся!\nВы точно хотите покинуть стол?", "Да", "Нет");
        if(p_temp[playerid][TextDrawInventory] == true && p_temp[playerid][InterfaceID] == EQUIPMENT_INVENTORY_PLAYER)
            HideTextDrawForPlayer(playerid, TD_ID_INVENTORY_PLAYER);

        if(p_temp[playerid][TextDrawCraft] == true)
        {
            if(p_temp[playerid][craft_timer] > 0)
            {
                SendMes(playerid, COLOR_DARKORANGE, "[КРАФТ]: "W"Вы не можете закрыть крафт пока изготавливаете предмет.");
                SelectTextDraw(playerid, -4632577);
            }
            else HideTextDrawForPlayer(playerid, TD_ID_CRAFT);
        }

        if(p_temp[playerid][TextDrawBattlePass] == true)
        {
            if(BattlePassTime == 0) return 1;
            HideTextDrawForPlayer(playerid, TD_ID_BATTLEPASS);
        }

        if(p_temp[playerid][TextDrawDaily] == true) HideTextDrawForPlayer(playerid, TD_ID_DAILY);

        if(p_temp[playerid][TextDrawMarket] == true)
            HideTextDrawForPlayer(playerid, TD_ID_MARKET);

        if(p_temp[playerid][TextDrawInventory] == true &&
            (p_temp[playerid][InterfaceID] == EQUIPMENT_INVENTORY_BOOT ||
            p_temp[playerid][InterfaceID] == EQUIPMENT_INVENTORY_HOUSE ||
            p_temp[playerid][InterfaceID] == EQUIPMENT_INVENTORY_TRASHBOX ||
            p_temp[playerid][InterfaceID] == EQUIPMENT_INVENTORY_FAMILY))
            HideTextDrawForPlayer(playerid, TD_ID_INVENTORY_OTHER);

        if(p_temp[playerid][TextDrawRobberyRobbing] == true)
        {
            HideTextDrawForPlayer(playerid, TD_ID_ROBBING);
        }
        if(p_temp[playerid][TextDrawRoulette] == true) ShowPlayerDialog(playerid, D_ROULETTE_EXIT, DIALOG_STYLE_MSGBOX, ""I"Выход", ""W"Вы действительно желаете выйти из рулетки?\n\n{"#cLIGHTRED"}Обратите внимание! Если у Вас запущена рулетка, то она Вам не вернется.", "Да", "Нет");
        if(p_temp[playerid][TextDrawCase] == true) ShowPlayerDialog(playerid, D_CASE_EXIT, DIALOG_STYLE_MSGBOX, ""I"Выход", ""W"Вы действительно желаете выйти из открытия кейсов?\n\n{"#cLIGHTRED"}Обратите внимание! Если у Вас запущено открытие кейса, то он Вам не вернется.", "Да", "Нет");
        if(p_temp[playerid][TextDrawPhone] == true) ShowPlayerDialog(playerid, D_PHONE_EXIT, DIALOG_STYLE_MSGBOX, ""I"Выход", ""W"Вы действительно желаете закрыть телефон?", "Да", "Нет");
        if(p_temp[playerid][TextDrawEditor] == true)
        {
            ShowPlayerDialog(playerid, D_EDITOR_EXIT, DIALOG_STYLE_MSGBOX, ""I"Выход", "\
            "W"Вы хотите сохранить позиции для данного аксессуара?\n\n\
            "I"Информация:"W"\n\n\
            \t"I"—"W" При нажатии "I"\"Да\","W" весь прогресс редактирования будет сохранен, но в случае снятия\n\
            \tаксессуара, прогресс редактирования будет возвращен в исходное состояние.\n\
            \t"I"—"W" При нажатии "I"\"Нет\","W" весь прогресс редактирования будет возвращен в исходное состояние.", "Да", "Нет");
        }
        if(p_temp[playerid][TextDrawReconUse] == true) SelectTextDraw(playerid, -8708097);
        if(p_temp[playerid][TextDrawListUse] == true) SelectTextDraw(playerid, 0x00000090);
        if(p_temp[playerid][TextDrawServiceTune] || p_temp[playerid][TextDrawPlayerMenu] || p_temp[playerid][TextDrawTrade] ||
            p_temp[playerid][TextDrawEquipment] || p_temp[playerid][TextDrawPanel] || p_temp[playerid][TextDrawDonateInfo]) SelectTextDraw(playerid, 0xFFFFFF95);
        if(p_temp[playerid][SlotMachineTextDraw] == true) ShowPlayerDialog(playerid, D_SLOTMACHINE_EXIT, DIALOG_STYLE_MSGBOX, ""I"Выход", ""W"Если Вы сделали ставку и игра уже началась, то деньги Вам не вернутся!\nВы точно хотите покинуть стол?", "Да", "Нет");
        if(p_info[playerid][durak_table])
        {
            if(p_info[playerid][durak_ready]) SelectTextDraw(playerid, DURAK_BTN_HOVER_COLOR);
            else Durak_LeaveTable(playerid);
        }
        if(blackjackPlayerData[playerid][BJ_CurrentTableID] != -1)
        {
            if(blackjackPlayerData[playerid][BJ_SetBet][0] != 0) SelectTextDraw(playerid, 0xFF4500FF);
            else ExitPlayerFromBlackjackTable(playerid, blackjackPlayerData[playerid][BJ_CurrentTableID]);
        }
        if(p_temp[playerid][prison_escape] == 1 && p_info[playerid][jail] > 0 && p_temp[playerid][prison_escape_time] == 0) SelectTextDraw(playerid, -8708097);
        if(p_temp[playerid][TextDrawFarm] == true) SelectTextDraw(playerid, 0xFFFFFFFF);
        if(p_temp[playerid][TextDrawBox] == true) SelectTextDraw(playerid, -104911873);
        if(p_temp[playerid][TextDrawRobberyRobbing] == true) SelectTextDraw(playerid, -4632577);
        if(p_temp[playerid][TextDrawElectric] == true) SelectTextDraw(playerid, -4632577);
        if(p_temp[playerid][TextDrawRadio] == true) SelectTextDraw(playerid, -4632577);
        if(p_temp[playerid][TextDrawTHunterGame] == true) SelectTextDraw(playerid, -4632577);
        return 1;
    }
    if(p_temp[playerid][TextDrawServiceTune]) return Interface_OnClickTextDraw(playerid, clickedid);
    if(blackjackPlayerData[playerid][BJ_CurrentTableID] != -1) return BJ_OnPlayerClickTD(playerid, clickedid); 
    
    if(clickedid == TD_Recon[3])
    { //STATS
        if(pSpectateId[playerid] == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не в сети.");
        player_stats(playerid, pSpectateId[playerid]);
    }
    if(clickedid == TD_Recon[4]) //BAN
        ShowPlayerDialog(playerid,D_RECON_BAN,DIALOG_STYLE_INPUT, ""I"BAN",""W"Используйте: "I"количество дней, причина(через запятую)","Далее","Отмена");
    if(clickedid == TD_Recon[5]) //WARN
        ShowPlayerDialog(playerid,D_RECON_WARN,DIALOG_STYLE_INPUT, ""I"WARN",""W"Используйте: "I"причина","Далее","Отмена");
    if(clickedid == TD_Recon[6]) //JAIL
        ShowPlayerDialog(playerid,D_RECON_JAIL,DIALOG_STYLE_INPUT, ""I"JAIL",""W"Используйте: "I"количество минут, причину(через запятую)","Далее","Отмена");
    if(clickedid == TD_Recon[7]) //MUTE
        ShowPlayerDialog(playerid,D_RECON_MUTE,DIALOG_STYLE_INPUT, ""I"MUTE",""W"Используйте: "I"количество минут, причину(через запятую)","Далее","Отмена");
    if(clickedid == TD_Recon[8]) //KICK
        ShowPlayerDialog(playerid,D_RECON_KICK,DIALOG_STYLE_INPUT, ""I"KICK",""W"Используйте: "I"причину(через запятую)","Далее","Отмена");
    if(clickedid == TD_Recon[9])
    { //Un/Freeze
        if(pSpectateId[playerid] == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не в сети.");
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL, "%d", pSpectateId[playerid]);
        callcmd::freeze(playerid, STRING_GLOBAL);
    }
    if(clickedid == TD_Recon[10])
    { //Spawn Player
        if(pSpectateId[playerid] == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не в сети.");
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL, "%d", pSpectateId[playerid]);
        callcmd::spawn(playerid, STRING_GLOBAL);
    }
    if(clickedid == TD_Recon[11]) //hide menu
        HideTextDrawForPlayer(playerid, TD_ID_RECON_PANEL);
    if(clickedid == TD_Recon[12]) //EXIT
        callcmd::reconoff(playerid, "/0");
    if(clickedid == TD_Recon[23])
    { //NEXT >>
        if(p_temp[playerid][recon_antiflood] > timestamp) return SendError(playerid, "Переключать можно раз в 1 секунду.");
        p_temp[playerid][recon_antiflood] = timestamp+1;

        for(new next_id = pSpectateId[playerid]+1; next_id < MAX_PLAYERS; next_id++)
        {
            if(!IsPlayerConnected(next_id)) continue;
            if(!p_info[next_id][loggedIn] || next_id == playerid ||
                pSpectateId[next_id] != INVALID_PLAYER_ID || GetPlayerState(next_id) == PLAYER_STATE_SPECTATING) continue;
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d",  next_id);
            callcmd::recon(playerid, STRING_GLOBAL);
            return 1;
        }
        for(new next_id; next_id <= pSpectateId[playerid]; next_id++)
        {
            if(!IsPlayerConnected(next_id)) continue;
            if(!p_info[next_id][loggedIn] || next_id == playerid ||
                pSpectateId[next_id] != INVALID_PLAYER_ID || GetPlayerState(next_id) == PLAYER_STATE_SPECTATING) continue;
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d",  next_id);
            callcmd::recon(playerid, STRING_GLOBAL);
            return 1;
        }
    }
    if(clickedid == TD_Recon[24])
    { //<< BACK
        if(p_temp[playerid][recon_antiflood] > timestamp) return SendError(playerid, "Переключать можно раз в 1 секунд.");
        p_temp[playerid][recon_antiflood] = timestamp+1;

        for(new next_id = pSpectateId[playerid]-1; next_id >= 0; next_id--)
        {
            if(!IsPlayerConnected(next_id)) continue;
            if(!p_info[next_id][loggedIn] || next_id == playerid ||
                pSpectateId[next_id] != INVALID_PLAYER_ID || GetPlayerState(next_id) == PLAYER_STATE_SPECTATING) continue;
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d",  next_id);
            callcmd::recon(playerid, STRING_GLOBAL);
            return 1;
        }
        for(new next_id = MAX_PLAYERS-1; next_id >= pSpectateId[playerid]; next_id--)
        {
            if(!IsPlayerConnected(next_id)) continue;
            if(!p_info[next_id][loggedIn] || next_id == playerid ||
                pSpectateId[next_id] != INVALID_PLAYER_ID || GetPlayerState(next_id) == PLAYER_STATE_SPECTATING) continue;
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d", next_id);
            callcmd::recon(playerid, STRING_GLOBAL);
            return 1;
        }
    }
    if(clickedid == RouletteButton[0]) // BRONZE;
    {
        if(RouletteTimerIDx[playerid] != 0) return SendError(playerid, "Вы не можете изменить тип рулетки, в данный момент она запущена.");
        if(RouletteType[playerid] == 0) return SendError(playerid, "У Вас уже выбрана BRONZE рулетка.");
        RouletteType[playerid] = 0;
        for(new i = 0; i < 16; i++)
        {
            PlayerTextDrawHide(playerid, RouletteItems[playerid][i]);
            PlayerTextDrawHide(playerid, RouletteItemsCount[playerid][i]);
            ShowPlayerRouletteItems(playerid, RouletteType[playerid], i);
        }
        UpdatePlayerRouletteInfo(playerid);
        return 1;
    }
    else if(clickedid == RouletteButton[1]) // SILVER;
    {
        if(RouletteTimerIDx[playerid] != 0) return SendError(playerid, "Вы не можете изменить тип рулетки, в данный момент она запущена.");
        if(RouletteType[playerid] == 1) return SendError(playerid, "У Вас уже выбрана SILVER рулетка.");
        RouletteType[playerid] = 1;
        for(new i = 0; i < 16; i++)
        {
            PlayerTextDrawHide(playerid, RouletteItems[playerid][i]);
            PlayerTextDrawHide(playerid, RouletteItemsCount[playerid][i]);
            ShowPlayerRouletteItems(playerid, RouletteType[playerid], i);
        }
        UpdatePlayerRouletteInfo(playerid);
        return 1;
    }
    else if(clickedid == RouletteButton[2]) // GOLD;
    {
        if(RouletteTimerIDx[playerid] != 0) return SendError(playerid, "Вы не можете изменить тип рулетки, в данный момент она запущена.");
        if(RouletteType[playerid] == 2) return SendError(playerid, "У Вас уже выбрана GOLD рулетка.");
        RouletteType[playerid] = 2;
        for(new i = 0; i < 16; i++)
        {
            PlayerTextDrawHide(playerid, RouletteItems[playerid][i]);
            PlayerTextDrawHide(playerid, RouletteItemsCount[playerid][i]);
            ShowPlayerRouletteItems(playerid, RouletteType[playerid], i);
        }
        UpdatePlayerRouletteInfo(playerid);
        return 1;
    }
    else if(clickedid == RouletteButton[3]) // UPDATE;
    {
        if(RouletteTimerIDx[playerid] != 0) return SendError(playerid, "Вы не можете обновить призы в рулетке, в данный момент она запущена.");
        if(RouletteType[playerid] < 0 || RouletteType[playerid] > 2) return SendError(playerid, "Что-то пошло не так, попробуйте заново или обновите версию клиента."), HidePlayerRoulette(playerid);
        new type = RouletteType[playerid];
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
        Вы действительно желаете обновить призы в "I"%s"W" рулетке.\n\n\
        Стоимость обновления призов: "I"%d Pinecrest Money", RouletteNameType[type], RoulettePriceUpdate[type]);
        ShowPlayerDialog(playerid, D_ROULETTE_UPDATE, DIALOG_STYLE_MSGBOX, ""I"Обновление призов", STRING_GLOBAL, "Да", "Нет");
        return 1;
    }
    else if(clickedid == RouletteButton[4]) // START;
    {
        StartPlayerRoulette(playerid);
        return 1;
    }
    else if(clickedid == RouletteButton[5]) // EXIT;
    {
        ShowPlayerDialog(playerid, D_ROULETTE_EXIT, DIALOG_STYLE_MSGBOX, ""I"Выход", ""W"Вы действительно желаете выйти из рулетки?\n\n{"#cLIGHTRED"}Обратите внимание! Если у Вас запущена рулетка, то она Вам не вернется.", "Да", "Нет");
        return 1;
    }
    if(clickedid == CaseButton[0]) // BACK;
    {
        if(CaseTimerIDx[playerid] != 0) return SendError(playerid, "Вы не можете изменить тип кейсов, в данный момент запущено открытие кейсов.");
        if(CaseType[playerid] <= 0) return SendError(playerid, "Вы находитесь на первом типе кейсов.");
        CaseType[playerid]--;
        for(new i = 0; i < 16; i++)
        {
            PlayerTextDrawHide(playerid, CaseItems[playerid][i]);
            PlayerTextDrawHide(playerid, CaseItemsCount[playerid][i]);
            ShowPlayerCaseItems(playerid, CaseType[playerid], i);
        }
        UpdatePlayerCaseInfo(playerid);
        return 1;
    }
    else if(clickedid == CaseButton[1]) // NEXT;
    {
        if(CaseTimerIDx[playerid] != 0) return SendError(playerid, "Вы не можете изменить тип кейсов, в данный момент запущено открытие кейсов.");
        if(CaseType[playerid] >= MAX_CASE - 1) return SendError(playerid, "Вы находитесь на последнем типе кейсов.");
        CaseType[playerid]++;
        for(new i = 0; i < 16; i++)
        {
            PlayerTextDrawHide(playerid, CaseItems[playerid][i]);
            PlayerTextDrawHide(playerid, CaseItemsCount[playerid][i]);
            ShowPlayerCaseItems(playerid, CaseType[playerid], i);
        }
        UpdatePlayerCaseInfo(playerid);
        return 1;
    }
    else if(clickedid == CaseButton[2]) // BUY;
    {
        new type = CaseType[playerid];
        STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;
        format(STRING_MIN, sizeof(STRING_MIN), ""I"%s кейс", Case[type][CaseNameOne]);
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
        Введите желаемое кол-во %s кейсов для приобретения:\n\n\
        Стоимость 1 %s кейса: {"#cGREEN"}%d"W" Pinecrest Money", Case[type][CaseNameTwo], Case[type][CaseNameThree], Case[type][CasePrice]);
        ShowPlayerDialog(playerid, D_CASE_BUY, DIALOG_STYLE_INPUT, STRING_MIN, STRING_GLOBAL, "Далее", "Отмена");
        return 1;
    }
    else if(clickedid == CaseButton[3]) // START;
    {
        StartPlayerCase(playerid);
        return 1;
    }
    else if(clickedid == CaseButton[4]) // EXIT;
    {
        ShowPlayerDialog(playerid, D_CASE_EXIT, DIALOG_STYLE_MSGBOX, ""I"Выход", ""W"Вы действительно желаете выйти из открытия кейсов?\n\n{"#cLIGHTRED"}Обратите внимание! Если у Вас запущено открытие кейса, то он Вам не вернется.", "Да", "Нет");
        return 1;
    }
    // TD LIST System
    for(new i = 7; i < 17; i++)
    {
        if(clickedid == TD_ListPage[i])
        {
            OnDialogResponseTDList(playerid, i-7);
            break;
        }
    }
    if(clickedid == TD_ListPage[23]) //Button: <<
    {
        new page_id = p_temp[playerid][list_page]-1;
        if(page_id == 0) return SendError(playerid, "Вы находитесь на первой странице.");
        p_temp[playerid][list_page]--;
        UpdatePlayerListTD(playerid);
    }
    else if(clickedid == TD_ListPage[27]) //Button: >>
    {
        new page_id = p_temp[playerid][list_page]-1, list_id = p_temp[playerid][list_type], max_value = GetMaxCountTDList(playerid, list_id);
        if((page_id+1)*MAX_TD_LIST_CELL >= max_value) return SendError(playerid, "Вы находитесь на последней странице.");
        p_temp[playerid][list_page]++;
        UpdatePlayerListTD(playerid);
    }
    if(p_temp[playerid][slot_machine_use] != -1)
    {
        new i = p_temp[playerid][slot_machine_use];
        if(_:clickedid == 65535) SelectTextDraw(playerid, 0x007FFFFF);
        else if(clickedid == SlotMachineTD[1])
        {
            if(SlotMachine[i][sm_objStop] != 3) return SendError(playerid, "Подождите пока остановятся барабаны.");
            if(p_info[playerid][cash] < SlotMachine[i][sm_bet]) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            SetPlayerMoney(playerid, -SlotMachine[i][sm_bet], true, "поставил в игровом автомате");
            new str[128];
            format(str, sizeof(str), "~w~BALANCE: ~g~$%d.~n~~w~RATE: ~y~$%d.", p_info[playerid][cash], SlotMachine[i][sm_bet]);
            PlayerTextDrawSetString(playerid, SlotMScoreTD[playerid], str);
            PlayerTextDrawShow(playerid, SlotMScoreTD[playerid]);
            SlotMachine[i][sm_objStop] = 0;
            switch(random(1000))
            {
                case 130..140, 230..240, 330..340, 540..550:
                {
                    SlotMachine[i][sm_comb] = 2;
                    new rand = 1 + random(2);
                    for(new f = 1; f <= 3; f++) SpinReel(i, f, rand);
                }
                case 101..105, 501..505, 701..705, 801..805:
                {
                    SlotMachine[i][sm_comb] = 3;
                    new rand = 3 + random(2);
                    for(new f = 1; f <= 3; f++) SpinReel(i, f, rand);
                }
                case 28, 38, 88, 98, 528:
                {
                    SlotMachine[i][sm_comb] = 4;
                    for(new f = 1; f <= 3; f++) SpinReel(i, f, 5);
                }
                case 598, 628, 698, 728, 798:
                {
                    SlotMachine[i][sm_comb] = 4;
                    for(new f = 1; f <= 3; f++) SpinReel(i, f, 6);
                }
                case 93, 203, 213, 313, 403, 506, 513:
                {
                    SlotMachine[i][sm_comb] = 5;
                    for(new f = 1; f <= 3; f++) SpinReel(i, f, 7);
                }
                case 185, 290, 605, 815, 920:
                {
                    SlotMachine[i][sm_comb] = 10;
                    for(new f = 1; f <= 3; f++) SpinReel(i, f, 8);
                }
                default:
                {
                    switch (random(10))
                    {
                        case 3, 7:
                        {
                            SlotMachine[i][sm_comb] = 2;
                            for(new f = 1; f <= 3; f++) SpinReel(i, f, 0);
                            return 1;
                        }
                    }
                    new rand[3];
                    while(rand[0] == rand[1] && rand[1] == rand[2])
                    {
                        for(new f; f < 3; f++) rand[f] = random(9);
                    }
                    SlotMachine[i][sm_comb] = 0;
                    for(new f = 1; f <= 3; f++) SpinReel(i, f, rand[f - 1]);
                }
            }
            return 1;
        }
        else if(clickedid == SlotMachineTD[2]) return ExitSlotMachine(playerid);
        else if(clickedid == SlotMachineTD[3])
        {
            if(SlotMachine[i][sm_objStop] != 3) return SendError(playerid, "Подождите пока остановятся барабаны.");
            if(SlotMachine[i][sm_bet] <= 1000) return 1;
            SlotMachine[i][sm_bet] -= 1000;
            new str[128];
            format(str, sizeof(str), "~w~BALANCE: ~g~$%d.~n~~w~RATE: ~y~$%d.", p_info[playerid][cash], SlotMachine[i][sm_bet]);
            PlayerTextDrawSetString(playerid, SlotMScoreTD[playerid], str);
            PlayerTextDrawShow(playerid, SlotMScoreTD[playerid]);
            return 1;
        }
        else if(clickedid == SlotMachineTD[4])
        {
            if(SlotMachine[i][sm_objStop] != 3) return SendError(playerid, "Подождите пока остановятся барабаны.");
            if(SlotMachine[i][sm_bet] >= 1000000) return SendError(playerid, "Максимальная ставка $1000000.");
            SlotMachine[i][sm_bet] += 1000;
            new str[128];
            format(str, sizeof(str), "~w~BALANCE: ~g~$%d.~n~~w~RATE: ~y~$%d.", p_info[playerid][cash], SlotMachine[i][sm_bet]);
            PlayerTextDrawSetString(playerid, SlotMScoreTD[playerid], str);
            PlayerTextDrawShow(playerid, SlotMScoreTD[playerid]);
            return 1;
        }
    }
    return 1;
}

public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
    //SendDebug(playerid, "event PTD click");
    if(p_info[playerid][loggedIn] != 1) return 0;
    if(p_info[playerid][exchangePartner] != INVALID_PLAYER_ID && p_temp[playerid][TextDrawTrade] == false) return SendError(playerid, "У Вас не законченный трейд.");
    if(GetPVarInt(playerid, #CCTV_ID) > 0) CC_OnPlayerClickPlayerTextDraw(playerid, playertextid);
    if(IsPlayerUseMDC(playerid))
        return MDC_OnPlayerClickPlayerTextDraw(playerid, playertextid);
    if(playertextid == PTD_ListPage[playerid][20]) //Button: CANCEL
        return CancelButtonTDList(playerid);
    if(p_info[playerid][durak_table])
        return Durak_HandlePTDClick(playerid, playertextid);
    if(p_temp[playerid][TextDrawTHunterGame]) return THunter_OnClickPlayerTextDraw(playerid, playertextid);
    if(p_temp[playerid][TextDrawRobberyRobbing]) return Robbing_OnClickPlayerTextDraw(playerid, playertextid);
    if(p_temp[playerid][TextDrawCraft]) return Craft_OnClickPlayerTextDraw(playerid, playertextid);
    if(p_temp[playerid][TextDrawBattlePass]) return BP_OnClickPlayerTextDraw(playerid, playertextid);
    if(p_temp[playerid][TextDrawDaily]) return Daily_OnClickPlayerTextDraw(playerid, playertextid);
    if(p_temp[playerid][TextDrawElectric]) return Electric_OnClickPlayerTextDraw(playerid, playertextid);
    if(p_temp[playerid][TextDrawRadio]) return Radio_OnClickPlayerTextDraw(playerid, playertextid);
    if(p_info[playerid][p_settings][INTERFACE] &&
        (p_temp[playerid][TextDrawServiceTune] || p_temp[playerid][TextDrawPlayerMenu] ||
        p_temp[playerid][TextDrawInventory] ||
        p_temp[playerid][TextDrawRoulette] || p_temp[playerid][TextDrawCase] || p_temp[playerid][TextDrawPhone] ||
        p_temp[playerid][TextDrawTrade]))
        return Interface_OnClickPlayerTextDraw(playerid, playertextid);
    if(p_temp[playerid][TextDrawEquipment])
        return Interface_OnClickPlayerTextDraw(playerid, playertextid);
    if(blackjackPlayerData[playerid][BJ_CurrentTableID] != -1) 
        return BJ_OnPlayerClickPlayerTD(playerid, playertextid);

    if(playertextid == PTD_Shop[playerid][3]) return button_back(playerid);
    else if(playertextid == PTD_Shop[playerid][4]) return button_next(playerid);
    else if(playertextid == PTD_Shop[playerid][7]) return button_buy(playerid);
    else if(playertextid == PTD_Shop[playerid][8]) return button_cancelbuy(playerid);
    else if(playertextid == PTD_Dice[playerid][12])
    {
        new s = GetPVarInt(playerid,"BoneStol_ID")-1;
        if(s == -1) return 1;
        if(GetPVarInt(playerid,"CasinoRang"))
        {
            if(DiceInfo[s][bank] > 0) return SendError(playerid, "В данный момент нельзя изменять настройки стола, в банке есть денежные средства."), UpdateBone(s);
            ShowPlayerDialog(playerid, D_DICE_SET, DIALOG_STYLE_INPUT, "Установка ставки для игры:","Ставка должна быть не менее 1000$\nи не более 100000000$. Введите сумму ставки.","Далее","Отмена");
            return 1;
        }
        if(!DiceInfo[s][bet]) return SendError(playerid, "На столе нет ставки."), UpdateBone(s);
        if(p_info[playerid][cash] < DiceInfo[s][bet]) return SendError(playerid, "У Вас нет столько денег. Используйте /donate"), UpdateBone(s);
        if(DiceInfo[s][game_start] > 0) return SendError(playerid, "Игра уже запущена."), UpdateBone(s);
        for(new i = 4; i != -1; i--)
        {
            if(DiceInfo[s][dice_gamer][i] == playerid)
            {
                if(DiceInfo[s][dice_set][i])
                    return SendError(playerid, "Вы уже поставили ставку."), UpdateBone(s);
                DiceInfo[s][dice_set][i] = 1;
                break;
            }
        }
        SetPlayerMoney(playerid, -DiceInfo[s][bet], true, "ставил в казино");
        DiceInfo[s][bank] += DiceInfo[s][bet];
        UpdateBone(s);
        return 1;
    }
    else if(playertextid == PTD_Dice[playerid][13])
    {
        new s = GetPVarInt(playerid,"BoneStol_ID")-1;
        if(s == -1) return 1;
        if(GetPVarInt(playerid,"CasinoRang"))
        {
            if(DiceInfo[s][game_start] > 0) return SendError(playerid, "Игра уже запущена."), UpdateBone(s);
            new count;
            for(new i = 4; i != -1; i--) 
            {
                if(DiceInfo[s][dice_gamer][i] != INVALID_PLAYER_ID && DiceInfo[s][dice_set][i] == 1)
                    count++;
            }
            if(count < 2) return SendError(playerid, "Слишком мало игроков."), UpdateBone(s);
            DiceInfo[s][game_start] = 30;
            SetTimerEx("UpdateGameDice", 1000, false, "i", s);
        }
        else
        {
            new gamer_id, null;
            for(new i = 4; i != -1; i--)
            {
                gamer_id = DiceInfo[s][dice_gamer][i];
                if(gamer_id == playerid)
                {
                    if(!DiceInfo[s][dice_set][i]) 
                    {
                        SendError(playerid, "Вы не ставили ставку.");
                        continue;
                    }
                    if(DiceInfo[s][game_start] <= 0)
                    {
                        SendError(playerid, "Игра еще не началась.");
                        continue;
                    }
                    if(DiceInfo[s][dice_set][i] > 1) 
                    {
                        SendError(playerid, "Вы уже кидали кости.");
                        continue;
                    }
                    DiceInfo[s][dice_set][i] = random(10) + 2;
                }
                if(DiceInfo[s][dice_set][i] == 1) null++;
            }
            if(DiceInfo[s][game_start] > 0 && !null) DiceInfo[s][game_start] = 2;
        }
        UpdateBone(s);
        return 1;
    }
    else if(playertextid == PTD_Dice[playerid][14]) return ShowPlayerDialog(playerid, D_DICE_EXIT, DIALOG_STYLE_MSGBOX, ""I"Выход", ""W"Если Вы сделали ставку и игра уже началась, то деньги Вам не вернутся!\nВы точно хотите покинуть стол?", "Да", "Нет");
    else if(playertextid == PTD_MiniGames[playerid])
    {
        HideTextDrawForPlayer(playerid, TD_ID_MINI_GAMES);
        switch(p_temp[playerid][mini_games_type])
        {
            case 1:
            {
                switch(random(100))
                {
                    case 0..29:
                    {
                        SendInfo(playerid, "У Вас не получилось совершить побег, продолжайте.");
                        ShowTextDrawForPlayer(playerid, TD_ID_MINI_GAMES);
                    }
                    case 30..89:
                    {
                        SendInfo(playerid, "У Вас не получилось совершить побег, срок заключения увеличен на 5 минут.");
                        if(p_info[playerid][jail] != 5) SendInfo(playerid, "Вы были переведены в федеральную тюрьму.");
                        p_info[playerid][jail] = 5;
                        switch(p_info[playerid][p_vip])
                        {
                            case 1: p_info[playerid][jail_time] += ((5 * 60) / 100) * 90;
                            case 2: p_info[playerid][jail_time] += ((5 * 60) / 100) * 80;
                            case 3: p_info[playerid][jail_time] += ((5 * 60) / 100) * 70;
                            default: p_info[playerid][jail_time] += 5*60;
                        }
                        p_temp[playerid][prison_escape] =
                        p_temp[playerid][prison_escape_time] = 0;
                    }
                    case 90..100:
                    {
                        new idx = random(15),
                            Float:escape_pos[][] =
                            {
                                {2308.7800, -1217.9900, 23.8700},
                                {-1989.9000, 1117.8800, 54.4700},
                                {-1640.0566,-2240.6355,31.4766},
                                {870.2867,-25.2779,63.9615},
                                {154.2019,-1942.3723,3.7734},
                                {377.1042,-2052.6394,8.0156},
                                {1029.7124,-1437.4984,14.2454},
                                {726.7692,-1435.3933,14.2454},
                                {335.5566,-1341.1031,14.5078},
                                {-76.2300,-1555.9801,3.0034},
                                {-373.9689,-1427.7361,26.0316},
                                {-388.5044,-1150.2087,69.4382},
                                {-349.0255,-1051.8118,59.3166},
                                {-187.0412,-308.0168,2.2398},
                                {-546.8495,-186.9221,78.4063}
                            };
                        SetPlayerCheckpoint(playerid, escape_pos[idx][0], escape_pos[idx][1], escape_pos[idx][2], 2.5);
                        SendAccess(playerid, "У Вас получилось совершить побег, Вам необходимо добраться до отмеченного места за 5 минут.");

                        p_info[playerid][wanted] = 6;
                        SetPlayerWantedLevel(playerid, p_info[playerid][wanted]);

                        p_temp[playerid][prison_escape] = 2;
                        p_temp[playerid][prison_escape_time] = 300;

                        SetPlayerInterior(playerid, 0);
                        SetPlayerVirtualWorld(playerid, 0);
                        switch(p_info[playerid][jail])
                        {
                            case 1:
                            {
                                SetPlayerPos(playerid, 1547.1400,-1675.8500,13.9531);
                                SetPlayerFacingAngle(playerid, 90.0);
                            }
                            case 2:
                            {
                                SetPlayerPos(playerid, -1605.4330,712.3948,13.8672);
                                SetPlayerFacingAngle(playerid, 0.0);
                            }
                            case 3:
                            {
                                SetPlayerPos(playerid, 2336.9790,2456.6194,14.9688);
                                SetPlayerFacingAngle(playerid, 180.0);
                            }
                            case 4:
                            {
                                SetPlayerPos(playerid, 630.1443,-571.8186,16.3359);
                                SetPlayerFacingAngle(playerid, 268.2991);
                            }
                            case 5:
                            {
                                SetPlayerPos(playerid, 2414.2959,1123.7134,10.8203);
                                SetPlayerFacingAngle(playerid, 270.0);
                            }
                        }

                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] сбежал(-а) из тюрьмы.", get_name(playerid), playerid);
                        SendFractionMessage(POLICE_LS, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_SF, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_LV, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(PRISON, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(FBI_TEAM, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);
                    }
                }
            }
            case 2:
            {
                switch(random(100))
                {
                    case 0..29:
                    {
                        SendInfo(playerid, "У Вас не получилось ограбить магазин одежды, продолжайте.");
                        ShowTextDrawForPlayer(playerid, TD_ID_MINI_GAMES);
                    }
                    case 30..89:
                    {
                        SendAccess(playerid, "У Вас получилось ограбить магазин одежды, сработала сигнализация.");

                        p_info[playerid][wanted] = 6;
                        SetPlayerWantedLevel(playerid, p_info[playerid][wanted]);

                        /*
                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] попытал(-ся/-ась) ограбить магазин одежды.", get_name(playerid), playerid);
                        SendFractionMessage(POLICE_LS, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_SF, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_LV, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(FBI_TEAM, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);
                        */
                    }
                    case 90..100:
                    {
                        SendAccess(playerid, "У Вас получилось ограбить магазин одежды, Вам выдана форма военного.");

                        p_info[playerid][army_skin] = 1;
                        SendInfo(playerid, "Управление формой: /switchskin");
                        SendInfo(playerid, "Обратите внимание, после перезахода форма пропадет.");

                        p_info[playerid][wanted] += 2;
                        if(p_info[playerid][wanted] > 6) p_info[playerid][wanted] = 6;
                        SetPlayerWantedLevel(playerid, p_info[playerid][wanted]);

                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] ограбил(-а) магазин одежды.", get_name(playerid), playerid);
                        SendFractionMessage(POLICE_LS, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_SF, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_LV, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(FBI_TEAM, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);
                    }
                }
            }
        }
        return 1;
    }
    else if(playertextid == PhoneMain[playerid][37]) // Звонок;
    {
        if(p_temp[playerid][offphone] == true) return SendError(playerid, "У Вас выключен телефон, включите его.");
        if(!p_info[playerid][phone_number]) return SendError(playerid, "У Вас нет номера телефона.");
        ShowPlayerDialog(playerid, D_PHONE_CALL, DIALOG_STYLE_INPUT, ""I"Позвонить", ""W"\
        Введите номер гос. службы:\n\n\
        Полиция - "I"10"W"\n\
        Скорая помощь - "I"11"W"\n\
        Такси - "I"12"W"\n\
        Автомеханик - "I"13"W"\n\
        Радиоцентр [LS] - "I"14"W"\n\
        Радиоцентр [SF] - "I"15"W"\n\
        Радиоцентр [LV] - "I"16"W"\n\
        Мобильный банк - "I"17"W"\n\
        Баланс телефона - "I"18", "Далее", "Отмена");
        return 1;
    }
    else if(playertextid == PhoneMain[playerid][38]) // Сообщения;
    {
        if(p_temp[playerid][offphone] == true) return SendError(playerid, "У Вас выключен телефон, включите его.");
        if(!p_info[playerid][phone_number]) return SendError(playerid, "У Вас нет номера телефона.");
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT t.`NickPlayer`, t.`NickTarget`, t.`Text`, t.`Read`, t.`Time` FROM `phone_messages` AS t JOIN (SELECT `NickPlayer`, `Text`, max(`Time`) as `mtime` FROM `phone_messages` WHERE `NickTarget` = '%s' GROUP BY `NickPlayer`, `NickTarget`, `Text`, `Read`, `Time`) as t1 ON t.NickPlayer= t1.NickPlayer AND t.`Time` = t1.`mtime` ORDER BY t.`Time` DESC LIMIT 20",
        get_name(playerid));
        mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayerMessages", "d", playerid);
        return 1;
    }
    else if(playertextid == PhoneMain[playerid][39]) // Контакты;
    {
        if(p_temp[playerid][offphone] == true) return SendError(playerid, "У Вас выключен телефон, включите его.");
        if(!p_info[playerid][phone_number]) return SendError(playerid, "У Вас нет номера телефона.");
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `phone_contacts`.`NickTarget`, `phone_contacts`.`MissedCalls`, `accounts`.`phone_number`, `accounts`.`online`, `phone_contacts`.`BlackList` FROM `phone_contacts`, `accounts` WHERE `phone_contacts`.`NickPlayer` = '%s' AND `accounts`.`name` = `phone_contacts`.`NickTarget` ORDER BY `phone_contacts`.`BlackList` DESC LIMIT 20",
        get_name(playerid));
        mysql_tquery(con_bd, STRING_GLOBAL, "MysqlShowContacts", "d", playerid);
        return 1;
    }
    else if(playertextid == PhoneMain[playerid][40]) // Настройки;
    {
        STRING_MIN[0] = EOS;
        format(STRING_MIN, sizeof(STRING_MIN), "\
        "I"[1]"W" %s телефон\n\
        "I"[2]"W" Убрать телефон", p_temp[playerid][offphone] ? "{"#cGREEN"}Включить"W"" : "{"#cLIGHTRED"}Выключить"W"");
        ShowPlayerDialog(playerid, D_PHONE_SETTINGS, DIALOG_STYLE_LIST, ""I"Настройки", STRING_MIN, "Далее", "Отмена");
        return 1;
    }
    if(playertextid == Editor_PTD[playerid][84]) // x left
    {
        UpdatePlayerAttachedObject(playerid, TYPE_UPDATE_CAMERA_LEFT, TYPE_OFFSET_X);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][90]) // x right
    {
        UpdatePlayerAttachedObject(playerid, TYPE_UPDATE_CAMERA_RIGHT, TYPE_OFFSET_X);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][70]) // y left
    {
        UpdatePlayerAttachedObject(playerid, TYPE_UPDATE_CAMERA_LEFT, TYPE_OFFSET_Y);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][76]) // y right
    {
        UpdatePlayerAttachedObject(playerid, TYPE_UPDATE_CAMERA_RIGHT, TYPE_OFFSET_Y);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][98]) // z left
    {
        UpdatePlayerAttachedObject(playerid, TYPE_UPDATE_CAMERA_LEFT, TYPE_OFFSET_Z);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][104]) // z right
    {
        UpdatePlayerAttachedObject(playerid, TYPE_UPDATE_CAMERA_RIGHT, TYPE_OFFSET_Z);
    }
    else if(playertextid == Editor_PTD[playerid][49]) // rx left
    {
        UpdatePlayerAttachedObject(playerid, TYPE_UPDATE_CAMERA_LEFT, TYPE_ROT_X);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][55]) // rx right
    {
        UpdatePlayerAttachedObject(playerid, TYPE_UPDATE_CAMERA_RIGHT, TYPE_ROT_X);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][35]) // ry left
    {
        UpdatePlayerAttachedObject(playerid, TYPE_UPDATE_CAMERA_LEFT, TYPE_ROT_Y);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][41]) // ry right
    {
        UpdatePlayerAttachedObject(playerid, TYPE_UPDATE_CAMERA_RIGHT, TYPE_ROT_Y);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][21]) // rz left
    {
        UpdatePlayerAttachedObject(playerid, TYPE_UPDATE_CAMERA_LEFT, TYPE_ROT_Z);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][27]) // rz right
    {
        UpdatePlayerAttachedObject(playerid, TYPE_UPDATE_CAMERA_RIGHT, TYPE_ROT_Z);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][7]) // size left
    {
        UpdatePlayerAttachedObject(playerid, TYPE_UPDATE_CAMERA_LEFT, TYPE_SCALE);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][13]) // size right
    {
        UpdatePlayerAttachedObject(playerid, TYPE_UPDATE_CAMERA_RIGHT, TYPE_SCALE);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][62]) // exit
    {
        ShowPlayerDialog(playerid, D_EDITOR_EXIT, DIALOG_STYLE_MSGBOX, ""I"Выход", "\
        "W"Вы хотите сохранить позиции для данного аксессуара?\n\n\
        "I"Информация:"W"\n\n\
        \t"I"—"W" При нажатии "I"\"Да\","W" весь прогресс редактирования будет сохранен, но в случае снятия\n\
        \tаксессуара, прогресс редактирования будет возвращен в исходное состояние.\n\
        \t"I"—"W" При нажатии "I"\"Нет\","W" весь прогресс редактирования будет возвращен в исходное состояние.", "Да", "Нет");
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][116]) // step
    {
        ShowPlayerDialog(playerid, D_EDITOR_STEP, DIALOG_STYLE_INPUT, ""I"Изменить шаг", ""W"Введите желаемый шаг для изменения координат:\n\nПример: "I"0.02", "Далее", "Отмена");
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][121]) // camera left
    {
        new Float:camera_distance, Float:camera_posZ;
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
            camera_distance = 8.5;
            camera_posZ = 3.0;
        }
        else
        {
            camera_distance = 2.5;
            camera_posZ = 1.5;
        }
        SetCameraForPlayer(playerid, p_temp[playerid][camera_id], camera_distance, camera_posZ, true, TYPE_UPDATE_CAMERA_LEFT);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][126]) // camera right
    {
        new Float:camera_distance, Float:camera_posZ;
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
            camera_distance = 8.5;
            camera_posZ = 3.0;
        }
        else
        {
            camera_distance = 2.5;
            camera_posZ = 1.5;
        }
        SetCameraForPlayer(playerid, p_temp[playerid][camera_id], camera_distance, camera_posZ, true, TYPE_UPDATE_CAMERA_RIGHT);
        return 1;
    }
    for(new i = 4; i != -1; i--)
    {
        if(playertextid == BoxButton[playerid][i])
        {
            new idx = p_temp[playerid][BoxIDx];
            if(!IsPlayerInDynamicArea(playerid, BoxInfo[idx][boxArea])) return SendError(playerid, "Вы слишком далеко от сундука.");
            if(BoxInfo[idx][boxItems][i] == 0) return SendError(playerid, "В данном слоте ничего нет."), ClearBoxItems(playerid, idx, i);
            SetPlayerItem(playerid, 7, p_info[playerid][ID], BoxInfo[idx][boxItems][i], BoxInfo[idx][boxItemsCount][i], BoxInfo[idx][boxItemsIDx][i]);
            ClearBoxItems(playerid, idx, i);
        }
    }
    if(playertextid == BoxButton[playerid][5])
        HidePlayerBox(playerid);
    for(new i = 1; i < 17; i++)
    {
        if(playertextid == PTD_Panel[playerid][i])
        {
            if(p_temp[playerid][Work_ID] != PANEL_WORK) return HideTextDrawForPlayer(playerid, TD_ID_PANEL);
            p_temp[playerid][PanelButton][i - 1] = 1;
            PlayerTextDrawHide(playerid, PTD_Panel[playerid][i]);
            PlayerTextDrawColor(playerid, PTD_Panel[playerid][i], 1182971135);
            PlayerTextDrawSetSelectable(playerid, PTD_Panel[playerid][i], false);
            PlayerTextDrawShow(playerid, PTD_Panel[playerid][i]);
        }
    }
    if(playertextid == PTD_Panel[playerid][17])
    {
        if(p_temp[playerid][Work_ID] != PANEL_WORK) return HideTextDrawForPlayer(playerid, TD_ID_PANEL);
        new count = 0;
        for(new i = 0; i < 16; i++)
        {
            if(p_temp[playerid][PanelButton][i] == 1) count++;
        }
        if(count < 16) return SendError(playerid, "Вы не включили все преобразователи.");
        SendMes(playerid, COLOR_BLUE, "Вы включили все преобразователи.");
        new reason_money = GetPlayerMoneySkill(playerid, p_temp[playerid][PanelSalary], 18);

        if(CheckPlayerMaxSalarySkill(playerid, 18, reason_money))
        {
            SetPlayerMoney(playerid, reason_money, true, "зарплата ремонт солнечной панели");
            OnServerInfoForMoney[17] += reason_money;
            SendMes(playerid, COLOR_LYELLOW, "К Вашей зарплате добавлено: {"#cLIME"}%d$.", reason_money);

            p_info[playerid][job_skill_salary][18] += reason_money;
        }
        else SendError(playerid, "За последний час игры было заработано максимальное количество денежных средств.");

        if(GetPlayerGiveCasket(100, 5) != -1) GivePlayerCasket(playerid, -1);

        SendMes(playerid, COLOR_SEA_WAVE, "Отправляйтесь на место, отмеченное на GPS навигаторе и возьмите новый заказ.");
        SetPlayerGPS(playerid, 956.7352,-1449.2498,13.5149, 5.0);

        new Float:distance = GetPlayerDistanceFromPoint(playerid, 956.7352,-1449.2498,13.5149);

        new time = floatround(distance) / 500 * 30;
        AntiCheatWarningTime[playerid][0] = timestamp + time;
        AntiCheatWarningTime[playerid][1] = time;

        UpdatePlayerWorkSkill(playerid, 18);

        new idx = p_temp[playerid][PanelIDx];

        PanelHouseInfo[idx][PanelHouseBreaking] = 0;
        PanelHouseInfo[idx][PanelHouseBreakingPayDay] = 0;
        PanelHouseInfo[idx][PanelHouseRepair] = 0;
        PanelHouseInfo[idx][PanelHouseRepairPlayerID] = INVALID_PLAYER_ID;

        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `panel` SET `breaking` = 0, `breakingpayday` = 0, `repair` = 0 WHERE `id` = %d",
        PanelHouseInfo[idx][PanelHouseMySQLIDx]);
        mysql_tquery(con_bd, STRING_GLOBAL);

        UpdatePanel(idx);

        p_temp[playerid][PanelIDx] = -1;
        p_temp[playerid][PanelSalary] = 0;
        for(new i = 0; i < 16; i++) p_temp[playerid][PanelButton][i] = 0;

        CheckPlayerMission(playerid, START_PANEL);
        CheckPlayerMission(playerid, DAILY_PANEL);
        CheckPlayerMission(playerid, ACHIEVEMENT_PANEL);

        CheckPlayerFreelance(playerid, FREELANCE_PANEL);
        CheckPlayerBattlePass(playerid, BATTLEPASS_PANEL);

        UpdateFamilyLevel(playerid);
        UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_PANEL); // Контракты: Ремонтник панелей

        HideTextDrawForPlayer(playerid, TD_ID_PANEL);

        for(new i = 0; i < 2; i++)
        {
            if(p_temp[playerid][PanelObject][i] != INVALID_OBJECT_ID)
            {
                DestroyDynamicObject(p_temp[playerid][PanelObject][i]);
                p_temp[playerid][PanelObject][i] = INVALID_OBJECT_ID;
            }
        }
    }
    else if(playertextid == PTD_Panel[playerid][18])
    {
        if(p_temp[playerid][Work_ID] != PANEL_WORK) return HideTextDrawForPlayer(playerid, TD_ID_PANEL);
        for(new i = 0; i < 16; i++) p_temp[playerid][PanelButton][i] = 0;
        SendError(playerid, "Вы отказались от включения преобразователей.");
        HideTextDrawForPlayer(playerid, TD_ID_PANEL);
    }
    if(playertextid == PTD_DonateInfo[playerid][33])
    {
        callcmd::donate(playerid, "/0");
        HideTextDrawForPlayer(playerid, TD_ID_DONATE_INFO);
    }
    else if(playertextid == PTD_DonateInfo[playerid][34])
    {
        HideTextDrawForPlayer(playerid, TD_ID_DONATE_INFO);
    }
    return 1;
}
public OnVehicleRespray(playerid, vehicleid, color1, color2)
{
    if(!IsValidVehicle(vehicleid) || p_info[playerid][loggedIn] != 1) return 0;
    return 0;
}

