CMD:setvacancy(playerid, params[])
{
    //if(GetFactionType(p_info[playerid][member]) != FACTION_TYPE_GOS && GetFactionType(p_info[playerid][member]) != FACTION_TYPE_SNN) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(p_info[playerid][rang] < 9) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    ShowPlayerDialog(playerid, D_SET_VACANCY, DIALOG_STYLE_LIST, ""I"Вакансии", ""I"[1]"W" Изменить параметр собеседования\n"I"[2]"W" Изменить информацию о собеседовании\n"I"[3]"W" Изменить время собеседования", "Далее", "Отмена");
    return 1;
}

CMD:vacancy(playerid, params[])
{
    new total = 0, idx = 0;
    STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;
    for(new i = 1; i < MAX_FRACTIONS; i++)
    {
        if(Vacancy[i] == 0) continue;
        format(STRING_MIN, sizeof(STRING_MIN), ""I"[%d]"W" %s\n", idx + 1, GetFractionName(i));
        strcat(STRING_GLOBAL, STRING_MIN);
        total++;
        p_temp[playerid][p_listitem][idx] = i;
        idx++;
    }
    if(total == 0) return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Вакансии", ""W"На данный момент нет вакансий.", "Отмена", "");
    ShowPlayerDialog(playerid, D_VACANCY, DIALOG_STYLE_LIST, ""I"Вакансии", STRING_GLOBAL, "Далее", "Отмена");
    return 1;
}

GetPlayerTaxiDriver(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(!IsValidVehicle(vehicleid)) return 1;
    if(veh_info[vehicleid][v_npoType] == NPO_JOB && (veh_info[vehicleid][v_npoId] == JOB_TC_TAXI || veh_info[vehicleid][v_job] == JOB_TC_TAXI))
    {
        foreach(new driverid: Player)
        {
            if(GetPlayerVehicleSeat(driverid) == 0 && GetPlayerVehicleID(driverid) == vehicleid && (IsPlayerOwnerVehicle(driverid, vehicleid) || IsPlayerRentedVehicle(driverid, vehicleid)) && p_temp[driverid][Work_ID] == TAXI_WORK) return driverid;
        }
    }
    return INVALID_PLAYER_ID;
}

forward ShowPlayerMessages(playerid);
public ShowPlayerMessages(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(!rows) return SendError(playerid, "У Вас нет сообщений.");

    new NickPlayer[MAX_PLAYER_NAME],
        status_read, time, time_str[48], time_back;

    STRING_GLOBAL[0] = EOS;
    for(new i; i < rows; i++)
    {
        cache_get_value_name(i, "NickPlayer", NickPlayer, MAX_PLAYER_NAME);
        //cache_get_value_name(i, "NickTarget", NickTarget, MAX_PLAYER_NAME);
        //cache_get_value_name(i, 2, text, 256);
        cache_get_value_name_int(i, "Read", status_read);
        cache_get_value_name_int(i, "Time", time);


        /*if(strequals(NickTarget, get_name(playerid)) owner_mess = "{73B461}[Контакт]"W"";
        else owner_mess = "{85FC65}[Вы]"W"";*/

        time_back = timestamp-time;

        if(time_back>24*3600) f(time_str, "[{00FF00}%d"W" дней(я) назад]", floatround(time_back/(24*3600)));
        else if(time_back>3600) f(time_str, "[{00FF00}%d"W" час(ов) назад]", floatround(time_back/3600));
        else if(time_back>60) f(time_str, "[{00FF00}%d"W" минут(ы) назад]", floatround(time_back/60));
        else if(time_back>1) f(time_str, "[{00FF00}%d"W" секунд(ы) назад]", time_back);
        format(STRING_GLOBAL,sizeof(STRING_GLOBAL),"%s"I"[%d]"W" От: {00FF00}%s"W" \t%s.. %s%s\n", STRING_GLOBAL, i + 1, NickPlayer, time_str, status_read == 1 ?  "{2BC12D}[NEW]"W"" : "{9E8F91}[Прочитано]"W"");


        format(Phone_NickName[playerid][i], 24, "%s", NickPlayer);
    }
    ShowPlayerDialog(playerid, D_PHONE_MESSAGES, DIALOG_STYLE_LIST, ""I"Сообщения",STRING_GLOBAL,"Далее","Отмена");
    return 1;
}

forward ShowPlayerMessage(playerid);
public ShowPlayerMessage(playerid)
{
    new rows;
    cache_get_row_count(rows);
    STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;

    format(STRING_MIN, sizeof(STRING_MIN), ""I"%s", p_temp[playerid][Phone_NickTarget]);

    if(!rows)
        return ShowPlayerDialog(playerid, D_PHONE_MESSAGE, DIALOG_STYLE_INPUT, STRING_MIN,
            ""W"Сообщений нет.\n\n"W"Введите Ваше сообщение ниже в поле ввода:\nНапример: ривет! Как дела?\n\n\
            "I"Примичание! В переписке c игроком будет отображаться\nтолько "A"20 "I"последних сообщений", "Отправить","Отмена");
    else
    {
        new /*NickPlayer[MAX_PLAYER_NAME],*/ NickTarget[MAX_PLAYER_NAME],
            time, time_str[48], time_back, text_mess[256];

        for(new i; i < rows; i++)
        {
            cache_get_value_name(i, "NickTarget", NickTarget, MAX_PLAYER_NAME);
            cache_get_value_name(i, "Text", text_mess, 256);
            cache_get_value_name_int(i, "Time", time);
            time_back = timestamp-time;

            if(time_back>24*3600) f(time_str, "[{00FF00}%d"W" дней(я) назад]", floatround(time_back/(24*3600)));
            else if(time_back>3600) f(time_str, "[{00FF00}%d"W" час(ов) назад]", floatround(time_back/3600));
            else if(time_back>60) f(time_str, "[{00FF00}%d"W" минут(ы) назад]", floatround(time_back/60));
            else if(time_back>1) f(time_str, "[{00FF00}%d"W" секунд(ы) назад]", time_back);
            else if(time_back == 0) f(time_str,"[{00FF00}только что"W"]");

            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%s - %s%s\n", STRING_GLOBAL, time_str,
                strequals(NickTarget, get_name(playerid)) > 0 ? "{73B461}[Контакт]"W"" : "{85FC65}[Вы]"W"", text_mess);
        }
    }
    ShowPlayerDialog(playerid, D_PHONE_MESSAGE, DIALOG_STYLE_INPUT, STRING_MIN, STRING_GLOBAL, "ОК","Отмена");
    return 1;
}

forward MysqlShowContacts(playerid);
public MysqlShowContacts(playerid)
{
    new rows;
    cache_get_row_count(rows);

    new NickTarget[MAX_PLAYER_NAME], missed_calls,
        p_online, p_number, blacklist_status;
    STRING_GLOBAL = ""I"[1]"W" Добавить контакт\n"I"[2]"W" Вызов государственных служб\n";
    for(new i; i < rows; i++)
    {
        if(rows < sizeof(Phone_NickName))
        {
            cache_get_value_name(i, "NickTarget", NickTarget, MAX_PLAYER_NAME);
            cache_get_value_name_int(i, "phone_number", p_number);
            cache_get_value_name_int(i, "MissedCalls",missed_calls);
            cache_get_value_name_int(i, "online",p_online);
            cache_get_value_name_int(i, "BlackList", blacklist_status);

            f(STRING_GLOBAL, "%s"I"[%d]"W" %s %s%s, номер: %d, пропущенных: %d\n",
                STRING_GLOBAL, i + 1, NickTarget, p_online != 0 ? "[{41BE13}ON"W"]" : "[{00FF00}OFF"W"]", blacklist_status == 1 ? "[ЧС]" : "", p_number, missed_calls);

            format(Phone_NickName[playerid][i], 24, "%s", NickTarget);
        }
    }
    ShowPlayerDialog(playerid, D_PHONE_CONTACTS, DIALOG_STYLE_LIST, ""I"Контакты", STRING_GLOBAL,"Принять","Отмена");
    return 1;
}

forward MysqlAddContact(playerid, id);
public MysqlAddContact(playerid, id)
{
    new isacontact;
    cache_get_value_index_int(0, 0, isacontact);
    if(isacontact) return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Информация","Нельзя добавить данный контакт , так как он уже добавлен!","Принять","");
    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT COUNT(*) FROM `phone_contacts` WHERE `NickPlayer` = '%e'",
    get_name(playerid));
    mysql_tquery(con_bd, STRING_GLOBAL, "MysqlAddContactTwo", "dd", playerid, id);
    return 1;
}

forward MysqlAddContactTwo(playerid, id);
public MysqlAddContactTwo(playerid, id)
{
    new rows;
    cache_get_row_count(rows);

    if(rows > 25) return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Информация",""W"Память Вашей SIM-Карты заполнена!", "Принять", "");
    if(id == playerid) return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Информация",""W"Вы не можете добавить сами себя в контакты!", "Принять", "");

    if(!GetInventoryAmount(id, p_info[id][active_phone_id]))
    {
        ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Информация", ""W"\
        Вы не можете добавить в контакты данный номер, причин может быть несколько:\n\
        1. У игрока, владеющим данным номером нет телефона;\n\
        2. У игрока, владеющим данным номером не выбран активный телефон с помощью команды /phone;","Принять","");
        return 1;
    }

    if(p_info[id][phone_number] < 1) return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Информация", ""W"У этого человека нет номера телефона!","Принять","");

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `phone_contacts` (`NickPlayer`, `NickTarget`, `MissedCalls`, `BlackList`) VALUES ('%e', '%e', '0', '0')",
    get_name(playerid), get_name(id));
    mysql_tquery(con_bd, STRING_GLOBAL);

    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Информация",""W""W"Ваш контакт был успешно добавлен!","Принять","");

    SendInfo(id, "%s добавил Вас в контакты.", get_name(playerid));
    return 1;
}

forward MysqlAddMessage(playerid);
public MysqlAddMessage(playerid)
{
    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `phone_messages` WHERE (`NickPlayer` = '%e' AND `NickTarget` = '%e') OR (`NickTarget` = '%e' AND `NickPlayer` = '%e') ORDER BY `time` DESC LIMIT 0, 20",
    get_name(playerid), p_temp[playerid][Phone_NickTarget], get_name(playerid), p_temp[playerid][Phone_NickTarget]);
    mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayerMessage", "d", playerid);
    return 1;
}

forward MysqlCheckSMS(playerid, inputtext[]);
public MysqlCheckSMS(playerid, inputtext[])
{
    new rows;
    cache_get_row_count(rows);

    if(!rows) return SendError(playerid, "Ничего не найдено.");
    new black_list;
    cache_get_value_name_int(0, "BlackList", black_list);
    if(black_list == 1) return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Информация",""W"Вы в чёрном списке!","Закрыть","");

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `phone_messages` VALUES('%e', '%e', '%e', '1', %d)",
    get_name(playerid), p_temp[playerid][Phone_NickTarget], inputtext, timestamp);
    mysql_tquery(con_bd, STRING_GLOBAL, "MysqlAddMessage", "d", playerid);

    new id;
    sscanf(p_temp[playerid][Phone_NickTarget], "i", id);
    if(id != INVALID_PLAYER_ID && p_temp[id][offphone] != true)
    {
        SendInfo(id, "Вам пришло новое сообщение.");
        SetPlayerChatBubble(id, "Получил(-а) сообщение", COLOR_MAIN, 20.0, 10000);
    }

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd,STRING_GLOBAL, sizeof STRING_GLOBAL, "UPDATE `phone_messages` SET `Read` = 0 WHERE `NickTarget` = '%s' AND `NickPlayer` = '%s'",
    get_name(playerid), p_temp[playerid][Phone_NickTarget]);
    mysql_tquery(con_bd, STRING_GLOBAL);
    return 1;
}

forward MysqlChencheGroup(playerid);
public MysqlChencheGroup(playerid)
{
    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `phone_contacts`.`NickTarget`, `phone_contacts`.`MissedCalls`, `accounts`.`phone_number`, `accounts`.`online`, `phone_contacts`.`BlackList` FROM `phone_contacts`, `accounts` WHERE `phone_contacts`.`NickPlayer` = '%s' AND `accounts`.`name` = `phone_contacts`.`NickTarget` ORDER BY `phone_contacts`.`BlackList` DESC LIMIT 20",
        get_name(playerid));
    mysql_tquery(con_bd, STRING_GLOBAL, "MysqlShowContacts", "d", playerid);
    return 1;
}

forward MysqlCheckCall(playerid);
public MysqlCheckCall(playerid)
{
    new rows;
    cache_get_row_count(rows);

    if(rows)
    {
        new black_list;
        cache_get_value_name_int(0, "BlackList", black_list);
        if(black_list == 1) return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Информация",""W"Вы в чёрном списке!","Закрыть","");

        new id;
        sscanf(p_temp[playerid][Phone_NickTarget], "i", id);
        if(id == INVALID_PLAYER_ID)
            return SendError(playerid, "Игрок не в сети.");

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `phone_contacts` SET `MissedCalls` = 0 WHERE `NickPlayer` = '%e' AND `NickTarget` = '%e'",
        get_name(playerid), get_name(id));
        mysql_tquery(con_bd, STRING_GLOBAL);

        new number_calls[7];
        format(number_calls, 7, "%d", p_info[id][phone_number]);
        callcmd::call(playerid, number_calls);
        return 1;
    }
    else return SendError(playerid, "Ничего не найдено.");
}

forward OnPlayerPilotLoadVehicle(playerid);
public OnPlayerPilotLoadVehicle(playerid)
{
    if(!PilotTimer[playerid] || p_temp[playerid][Work_ID] != PILOT_WORK) return 1;
    p_temp[playerid][pPressed]++;
    new i = p_temp[playerid][pPressed], idx = GetPVarInt(playerid, "TypePilot") - 1;
    if(idx < 0 || idx > 5) idx = 0;
    SetPlayerRaceCheckpoint(playerid, 4, PilotRoute[idx][i][0], PilotRoute[idx][i][1], PilotRoute[idx][i][2], PilotRoute[idx][i][3], PilotRoute[idx][i][4], PilotRoute[idx][i][5], 15.0);
    SendMes(playerid, COLOR_SEA_WAVE, "Вам выдали разрешение на взлет, отправляйтесь.");
    KillTimer(PilotTimer[playerid]);
    Fix_TogglePlayerControllable(playerid, true);
    PilotTimer[playerid] = 0;
    return 1;
}

forward OnPlayerUnloadedVehiclePilot(playerid);
public OnPlayerUnloadedVehiclePilot(playerid)
{
    if(!PilotTimer[playerid] || p_temp[playerid][Work_ID] != PILOT_WORK) return 1;
    p_temp[playerid][pPressed] = 0;
    new i = p_temp[playerid][pPressed], idx = GetPVarInt(playerid, "TypePilot") - 1;
    if(idx < 0 || idx > 5) idx = 0;

    switch(idx)
    {
        case 0: idx = 2;
        case 1: idx = 4;
        case 2: idx = 0;
        case 3: idx = 5;
        case 4: idx = 1;
        case 5: idx = 3;
    }

    SetPVarInt(playerid, "TypePilot", idx + 1);

    SetPlayerRaceCheckpoint(playerid, 1, PilotRoute[idx][i][0], PilotRoute[idx][i][1], PilotRoute[idx][i][2], PilotRoute[idx][i][3], PilotRoute[idx][i][4], PilotRoute[idx][i][5], 15.0);

    new reason_money = GetPlayerMoneySkill(playerid, 3166, 17);

    new vehicleid = p_temp[playerid][rented_veh], vehicle_salary;
    if(vehicleid != INVALID_VEHICLE_ID && veh_info[vehicleid][v_temp_job] == JOB_PILOT)
    {
        vehicle_salary = (reason_money / 100) * 20;
        reason_money += vehicle_salary;
    }

    if(CheckPlayerMaxSalarySkill(playerid, 17, reason_money))
    {
        SetPlayerMoney(playerid, reason_money, false, "");
        OnServerInfoForMoney[17] += reason_money;
        SendMes(playerid, COLOR_LYELLOW, "К Вашей зарплате добавлено: {"#cLIME"}%d$.", reason_money);
        if(vehicle_salary) SendMes(playerid, COLOR_LIME, "За работу на личном транспортном средстве к заработной плате добавлено: {"#cLYELLOW"}%d$.", vehicle_salary);

        p_info[playerid][job_skill_salary][17] += reason_money;
    }
    else SendError(playerid, "За последний час игры было заработано максимальное количество денежных средств.");

    UpdatePlayerWorkSkill(playerid, 17);

    CheckPlayerMission(playerid, START_PILOT);
    CheckPlayerMission(playerid, DAILY_PILOT);
    CheckPlayerMission(playerid, ACHIEVEMENT_PILOT);

    CheckPlayerFreelance(playerid, FREELANCE_PILOT);
    CheckPlayerBattlePass(playerid, BATTLEPASS_PILOT);

    UpdateFamilyLevel(playerid);
    UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_PILOT); // Контракты: Пилот

    SendMes(playerid, COLOR_BLUE, "Вы отправляетесь на обратный круг.");
    KillTimer(PilotTimer[playerid]);
    Fix_TogglePlayerControllable(playerid, true);
    PilotTimer[playerid] = 0;
    return 1;
}

