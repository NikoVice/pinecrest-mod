                    case 9: MoveObject(MoveDoor[9],   2238.195070, 2450.482420, 10.72600-0.2, 0.06, 0.00000, -90.00000, 269.00000);
                    case 10: MoveObject(MoveDoor[10], -1572.20288, 658.8060900, 6.962200-0.2, 0.06, 0.00000, 90.000000, 90.00000);
                    case 11: MoveObject(MoveDoor[11], -1701.44482, 687.5681200, 24.83200-0.2, 0.06, 0.00000, -90.00000, 90.00000);
