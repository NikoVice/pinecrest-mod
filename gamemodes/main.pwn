            {
                ShowFishMenu(playerid, MENU_FISH_SELL_INPUT, idx);
                return SendError(playerid, "Количество \"%s\" должно быть не менее 1 ед. и не более %d ед.", ItemsInfo[type][iName], GetInventoryAmount(playerid, type));
            }
