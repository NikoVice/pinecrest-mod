                    totalundergroundbots++;
                    UndergroundBotsInfo[totalundergroundbots][ubStatus] = 0;
                    UndergroundBotsInfo[totalundergroundbots][ubEducation] = 1;
                    UndergroundBotsInfo[totalundergroundbots][ubAir] = 0.0;
                    UndergroundBotsInfo[totalundergroundbots][ubLubricant] = 0.0;
                    UndergroundBotsInfo[totalundergroundbots][ubSatiety] = 0.0;
                    UndergroundBotsInfo[totalundergroundbots][ubTax] = 0;
                    UndergroundBotsInfo[totalundergroundbots][ubSalary] = 0;
                    UndergroundBotsInfo[totalundergroundbots][ubItems] = 0;
                    UndergroundBotsInfo[totalundergroundbots][ubHouseIDx] = h;
                    new biz_idx[] = {100, 101, 102};
                    UndergroundBotsInfo[totalundergroundbots][ubBizIDx] = biz_idx[random(3)];
                    UndergroundBotsInfo[totalundergroundbots][ubActor] = -1;

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `underground` (`house`, `biz`) VALUES (%d, %d)",
                    UndergroundBotsInfo[totalundergroundbots][ubHouseIDx], UndergroundBotsInfo[totalundergroundbots][ubBizIDx]);
                    mysql_tquery(con_bd, STRING_GLOBAL, "create_undergroundbots", "i", totalundergroundbots);

                    if(b_info[bizid][_prod] >= ((price / 100) * 50) / 100)
                    {
                        b_info[bizid][_prod] -= ((price / 100) * 50) / 100;
                        b_info[bizid][_bank] += ((price / 100) * 50) - ((price / 100) * 2);
