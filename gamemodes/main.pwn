            SendMes(playerid, COLOR_SEA_WAVE, "Сядьте в свободный транспорт принадлежащий пожарной части и ожидайте вызова от диспетчера.");
            SendMes(playerid, COLOR_LIME, "Огнетушитель выдается при выходе из транспортного средства, а при входе отбирается.");
        }
        case TRAIN_WORK:
        {
            p_temp[playerid][TrainVehicleIDx] = vehicleid;
            p_temp[playerid][TrainTimer] = 0;
            p_temp[playerid][TrainStop] = false;
            p_temp[playerid][TrainSpeedWarning] = 0;

            new max_distance = 100000, sidx = -1, here_distance;
            for(new i = 0; i < sizeof(Train); i++)
            {
                here_distance = floatround(GetVehicleDistanceFromPoint(GetPlayerVehicleID(playerid), Train[i][trainPosX], Train[i][trainPosY], Train[i][trainPosZ]));
                if(here_distance < max_distance)
                {
                    sidx = i;
                    max_distance = here_distance;
                }
            }
            if(max_distance == -1 || sidx == -1) return 1;

            switch(sidx)
            {
                case 0 .. 4: p_temp[playerid][TrainStopIDx] = 0;
                case 5 .. 21: p_temp[playerid][TrainStopIDx] = 1;
                case 22 .. 39: p_temp[playerid][TrainStopIDx] = 2;
                case 40 .. 50: p_temp[playerid][TrainStopIDx] = 3;
                default: p_temp[playerid][TrainStopIDx] = 4;
            }

            if(veh_info[vehicleid][v_text] == INVALID_3DTEXT_ID)
            {
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Машинист поезда\nСлед. остановка: "W"%s"I"\nПроезд бесплатный", TrainStopName[p_temp[playerid][TrainStopIDx]]);
                veh_info[vehicleid][v_text] = Create3DTextLabel(STRING_GLOBAL, COLOR_MAIN, 0.0, 0.0, 0.0, 10.0, 0, 1);
                Attach3DTextLabelToVehicle(veh_info[vehicleid][v_text], vehicleid, 0.0, 0.0, 3.0);
            }

            p_temp[playerid][pPressed] = sidx;
            SetPlayerRaceCheckpoint(playerid, 0, Train[sidx][trainPosX], Train[sidx][trainPosY], Train[sidx][trainPosZ]-1.5, Train[sidx+1][trainPosX], Train[sidx+1][trainPosY], Train[sidx+1][trainPosZ]-1.5, 3.0);
        }
        case TRAM_WORK:
        {
            SetPlayerSkin(playerid, (p_info[playerid][sex] == 2) ? (253):(9));
