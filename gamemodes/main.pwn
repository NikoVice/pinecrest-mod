                btc = floatround(VideoCardsInfo[idx][vcBitcoin], floatround_floor);
                if(btc > 0)
                {
                    VideoCardsInfo[idx][vcBitcoin] -= float(btc);
                    p_info[playerid][bitcoin] += btc;
                    
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `videocards` SET `bitcoin` = '%f' WHERE `id` = %d",
