CMD:stats(playerid, params[])
{
    if(p_info[playerid][admin] < 1 && p_info[playerid][youtube_adm] < 3)
        return player_stats(playerid, playerid);
    if(p_info[playerid][helper] == 1) return SendError(playerid, "Команда недоступна для хелперов.");

    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "Используйте: /stats [id игрока]");

    if(params[0] == INVALID_PLAYER_ID || !IsPlayerConnected(params[0]))
        return SendError(playerid, "Игрок не найден.");

    player_stats(playerid, params[0]);

    Log(LOG_player, INFO, "%s[%d](%s %s) посмотрел статистику %s online | #AdminCheck",
    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
    get_name(params[0]));
    return 1;
}
alias:stats("getstats");

CMD:sellsim(playerid, params[])
{
    if(!PlayerToPoint(100.0, playerid, 2290.1907,-55.2788,1070.2646)) return SendError(playerid, "Вы должны находиться в банке.");

    if(!p_info[playerid][phone_number]) return SendError(playerid, "У Вас нет номера телефона.");
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "Используйте: /sellsim [id игрока] [стоимость]");
    if(params[1] < 100 || params[1] > 10_000_000) return SendError(playerid, "Стоимость должна быть не менее 100$ и не более 10 000 000$.");
    if(params[0] == INVALID_PLAYER_ID ||  params[0] == playerid) return SendError(playerid, "Игрок не найден.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
    "W"Вы хотите предложить "I"%s"W" купить Ваш номер телефона "I"%d"W" за "I"%d$.", get_name(params[0]), p_info[playerid][phone_number], params[1]);
    ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"Продажа номера телефона", STRING_GLOBAL, "Далее", "Отмена");
    SetOfferData(playerid, params[0], OFFER_ID_SELL_SIM_PHONE, params[1]);
    return 1;
}

CMD:changesim(playerid, params[])
{
    if(!PlayerToPoint(100.0, playerid, 2290.1907,-55.2788,1070.2646)) return SendError(playerid, "Вы должны находиться в банке.");

    if(!p_info[playerid][phone_number]) return SendError(playerid, "У Вас нет номера телефона.");
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "Используйте: /changesim [id игрока] [стоимость]");
    if(params[1] < 100 || params[1] > 10_000_000) return SendError(playerid, "Стоимость должна быть не менее 100$ и не более 10 000 000$.");
    if(params[0] == INVALID_PLAYER_ID ||  params[0] == playerid) return SendError(playerid, "Игрок не найден.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(!p_info[params[0]][phone_number]) return SendError(playerid, "У игрока нет номера телефона.");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
    "W"Вы хотите предложить "I"%s"W" обменять Ваш номер телефона "I"%d"W" на его номер телефона "I"%d."W"\n\n\
    С доплатой Вам: "I"%d$.", get_name(params[0]), p_info[playerid][phone_number], p_info[params[0]][phone_number], params[1]);
    ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"Обмен номером телефона", STRING_GLOBAL, "Далее", "Отмена");
    SetOfferData(playerid, params[0], OFFER_ID_CHANGE_SIM_PHONE, params[1]);
    return 1;
}

CMD:changesex(playerid, params[])
{
    if(!IsPlayerFractionMedic(playerid) || p_info[playerid][rang] < 7) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "Используйте: /changesex [id игрока] [стоимость]");
    if(params[1] < 5000 || params[1] > 10000) return SendError(playerid, "Стоимость должна быть не менее 5000$ и не более 10000$.");
    if(params[0] == INVALID_PLAYER_ID ||  params[0] == playerid) return SendError(playerid, "Игрок не найден.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");

    SendAccess(playerid, "Вы предложили %s [%d] изменить пол за %d$.", get_name(params[0]), params[0], params[1]);
    SendInfo(params[0], "%s [%d] предложил Вам изменить пол за %d$.", get_name(playerid), playerid, params[1]);

    SetFreeSlotOffer(params[0], playerid, OFFER_ID_SET_SEX, params[1]);
    return 1;
}

CMD:jail(playerid, params[])
{
    if(p_info[playerid][admin] < 1)
        return 1;

    if(p_info[playerid][helper] == 1) return SendError(playerid, "Команда /mute недоступна для хелперов.");

    new target, minutes, reason[144];
    if(sscanf(params, "uis[144]", target, minutes, reason)) return SendInfo(playerid, "Используйте: /jail [id игрока] [кол-во минут] [причина]");

    if(target == INVALID_PLAYER_ID || target == playerid)
        return SendError(playerid, "Игрок не найден.");

    if(p_info[target][admin] >= p_info[playerid][admin]) return 1;
    if(!FD(playerid) && FD(target)) return 1;

    if(!(0 <= minutes <= 300))
        return SendError(playerid, "Кол-во минут тюремного заключения не может быть менее 0 и более 300.");

    if(!(1 <= strlen(reason) <= 32))
        return SendError(playerid, "Кол-во символов в причине не может быть менее 1 и не более 32.");

    if(AdvertisingCheck(reason)) return AdvertisingPunishment(playerid, reason, 0);
    if(IsAAdminAttack(playerid, 3)) return 1;

    PlayerPlaySound(target, 17004, 0.0, 0.0, 0.0);
    ResetPlayerWeapons(target);
    p_info[target][wanted] = 0;

    if(minutes == 0)
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Администратор %s [%d] выпустил %s [%d] из тюрьмы.", get_name(playerid), playerid, get_name(target), target);
        SendAdminMessageForServer(COLOR_LIGHTRED, STRING_GLOBAL);

        SendAccess(playerid, "Вы выпустили %s [%d] из тюрьмы.", get_name(target), target);
        SendInfo(target, "Администратор %s [%d] выпустил Вас из тюрьмы.", get_name(playerid), playerid);

        p_info[target][jail_time] = minutes;
        p_info[target][jail] = 0;

        SpawnPlayer(target);
        save_player(target);
        WriteAdminLog(TYPE_LOG_UNJAIL, playerid, get_name(target), target, reason);
    }
    else
    {
        if(RegisterRace[target])
        {
            RegisterRace[target] = 0;
            for(new i; i < MAX_RACE_PLAYERS; i++)
            {
                if(RacePlayers[i] == target)
                {
                    RacePlayers[i] = INVALID_PLAYER_ID;
                    if(RaceVehicles[i] != INVALID_VEHICLE_ID) DestroyVehicleVEx(RaceVehicles[i]);
                    RaceVehicles[i] = INVALID_VEHICLE_ID;
                }
            }
        }
        if(RegisterDerby[target])
        {
            RegisterDerby[target] = 0;
            for(new i; i < MAX_DERBY_PLAYERS; i++)
            {
                if(DerbyPlayers[i] == target)
                {
                    DerbyPlayers[i] = INVALID_PLAYER_ID;
                    if(DerbyVehicles[i] != INVALID_VEHICLE_ID) DestroyVehicleVEx(DerbyVehicles[i]);
                    DerbyVehicles[i] = INVALID_VEHICLE_ID;
                }
            }
        }
        if(RegisterPaintBall[target])
        {
            if(PaintBallLeaderID == target)
            {
                PaintBallLeaderID = INVALID_PLAYER_ID, PaintBallLeaderKills = 0;
            }
            RegisterPaintBall[target] = 0;
            PaintBallWeaponID[target] = 0;
            for(new i; i < MAX_PAINTBALL_PLAYERS; i++)
            {
                if(PaintBallPlayers[i] == target)
                {
                    PaintBallPlayers[i] = INVALID_PLAYER_ID;
                    break;
                }
            }
        }
        if(p_temp[target][cossack_robbers_register])
        {
            new team = p_temp[playerid][cossack_robbers_team];
            if(CossackRobbersLeaders[team] == playerid)
            {
                CossackRobbersLeaders[team] = INVALID_PLAYER_ID, CossackRobbersLeadersKills[team] = 0;
            }
            p_temp[target][cossack_robbers_register] = 0;
            p_temp[target][cossack_robbers_team] = 0;
            p_temp[target][cossack_robbers_kills] = 0;
            p_temp[target][cossack_robbers_deaths] = 0;
            p_temp[target][cossack_robbers_give] = 0.0;
            p_temp[target][cossack_robbers_take] = 0.0;
            for(new i = 0, x = 0; i < MAX_COSSACK_ROBBERS_TEAM; i++)
            {
                for(x = 0; x < MAX_COSSACK_ROBBERS_PLAYERS; x++)
                {
                    if(CossackRobbersPlayers[i][x] == target)
                    {
                        CossackRobbersPlayers[i][x] = INVALID_PLAYER_ID;
                        break;
                    }
                }
            }
        }
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Администратор %s [%d] посадил %s [%d] в тюрьму на %d %s. Причина: %s", get_name(playerid), playerid, get_name(target), target, minutes, Declension_ReturnWord(minutes, "минуту", "минуты", "минут"), reason);
        SendAdminMessageForServer(COLOR_LIGHTRED, STRING_GLOBAL);

        WriteAdminLog(TYPE_LOG_JAIL, playerid, get_name(target), target, reason);

        switch(p_info[target][p_vip])
        {
            case 1: p_info[target][jail_time] += ((minutes * 60) / 100) * 90;
            case 2: p_info[target][jail_time] += ((minutes * 60) / 100) * 80;
            case 3: p_info[target][jail_time] += ((minutes * 60) / 100) * 70;
            default: p_info[target][jail_time] += minutes*60;
        }
        p_info[target][jail] = 6;

        save_player(target);

        SpawnPlayer(target);
        GameTextForPlayer(target, "~r~PRISON", 10000, 0);

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Администратор %s [%d] посадил Вас в тюрьму на %d %s. Причина: %s", get_name(playerid), playerid, minutes, Declension_ReturnWord(minutes, "минуту", "минуты", "минут"), reason);
        SendInfo(target, STRING_GLOBAL);

        SendInfo(target, "Информация о сроке: /time");

        DeletePVar(target,"PlayerCuffed");
        SetPlayerCuffed(target, false);
        Fix_TogglePlayerControllable(target, 1);

        p_info[target][wanted] = 0;
        SetPlayerWantedLevel(target, 0);
    }

    a_info[playerid][a_jail] = 1;
    MysqlUpdateAdminInt(playerid, "a_jail", a_info[playerid][a_jail]);
    return 1;
}


CMD:ajail(playerid, params[])
{
    if(p_info[playerid][admin] < 1)
        return 1;

    new count;
    STRING_GLOBAL[0] = EOS;
    foreach(new i: Player)
    {
        if(count >= 30) break;
        if(p_info[i][jail_time] > 0 && p_info[i][jail] == 6)
        {
            f(STRING_GLOBAL, "%s"I"[%d]"W" %s (%s)\n", STRING_GLOBAL, count+1, get_name(i), ConvertTime(p_info[i][jail_time]));
            count++;
        }
    }
    if(!strlen(STRING_GLOBAL)) return SendInfo(playerid, "В деморгане никого нет.");
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, "Деморган:", STRING_GLOBAL, "Окей", "");
    return 1;
}

CMD:amute(playerid, params[])
{
    if(p_info[playerid][admin] < 1)
        return 1;

    if(p_info[playerid][helper] == 1) return SendError(playerid, "Команда /amute недоступна для хелперов.");

    new count;
    STRING_GLOBAL[0] = EOS;
    foreach(new i: Player)
    {
        if(count >= 30) break;
        if(p_info[i][mute] > 0)
        {
            f(STRING_GLOBAL, "%s"I"[%d]"W" %s (%s)\n", STRING_GLOBAL, count+1, get_name(i), ConvertTime(p_info[i][mute]));
            count++;
        }
    }
    if(!strlen(STRING_GLOBAL)) return SendInfo(playerid, "С баном чата никого нет.");
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, "Бан чата:", STRING_GLOBAL, "Окей", "");
    return 1;
}


CMD:helpers(playerid, params[])
{
    if(p_info[playerid][admin] < 1 && p_info[playerid][p_vip] == 0) return 1;
    if(!Iter_Count(gHelpers)) return SendError(playerid, "Помощников нет в сети.");
    STRING_GLOBAL = ""W"[#] Никнейм\t"W"Уровень\t"W" \t"W" \n";
    new count;
    foreach(new i: gHelpers)
    {
        if(p_info[i][helper] == 0) continue;
        if(pSpectateId[i] == INVALID_PLAYER_ID)
        {
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d] "W"%s[%d]\t%d\t%s\t \n", STRING_GLOBAL, count+1, get_name(i), i, p_info[i][admin], p_info[i][p_afkTime] < 2 ? " " : "AFK");
        }
        else
        {
            if(p_info[playerid][admin] < 1)
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d] "W"%s[%d]\t%d\t%s\t \n", STRING_GLOBAL, count+1, get_name(i), i, p_info[i][admin], p_info[i][p_afkTime] < 2 ? " " : "AFK");
            else
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d] "W"%s[%d]\t%d\t%s\t/re %d\n", STRING_GLOBAL, count+1, get_name(i), i, p_info[i][admin], p_info[i][p_afkTime] < 2 ? " " : "AFK", pSpectateId[i]);
        }
        count++;
    }
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, ""I"Помощники онлайн", STRING_GLOBAL, "OK", "");
    return 1;
}

CMD:admins(playerid, params[])
{
    if(p_info[playerid][admin] < 1 && p_info[playerid][p_vip] == 0) return 1;
    if(!Iter_Count(gAdmins)) return SendError(playerid, "Администраторов нет в сети.");
    STRING_GLOBAL = ""W"[#] Никнейм\t"W"Уровень\t"W" \t"W" \n";
    new count;
    foreach(new i: gAdmins)
    {
        if(p_info[i][helper] == 1) continue;
        if(p_info[i][admin] >= 7) continue;
        if(pSpectateId[i] == INVALID_PLAYER_ID)
        {
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d] "W"%s[%d]\t%d\t%s\t \n", STRING_GLOBAL, count+1, get_name(i), i, p_info[i][admin], p_info[i][p_afkTime] < 2 ? " " : "AFK");
        }
        else
        {
            if(p_info[playerid][admin] < 1)
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d] "W"%s[%d]\t%d\t%s\t \n", STRING_GLOBAL, count+1, get_name(i), i, p_info[i][admin], p_info[i][p_afkTime] < 2 ? " " : "AFK");
            else
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d] "W"%s[%d]\t%d\t%s\t/re %d\n", STRING_GLOBAL, count+1, get_name(i), i, p_info[i][admin], p_info[i][p_afkTime] < 2 ? " " : "AFK", pSpectateId[i]);
        }
        count++;
    }
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, ""I"Администраторы онлайн", STRING_GLOBAL, "OK", "");
    return 1;
}
CMD:back(playerid, params[])
{
    button_back(playerid);
    return 1;
}
CMD:next(playerid, params[])
{
    button_next(playerid);
    return 1;
}
CMD:buy(playerid, params[])
{
    button_buy(playerid);
    return 1;
}
CMD:cancelbuy(playerid, params[])
{
    button_cancelbuy(playerid);
    return 1;
}

stock button_cancelbuy(playerid)
{
    if(GetPlayerInterior(playerid) == 15 && GetPlayerVirtualWorld(playerid) == 2023 && GetPlayerSkin(playerid) > 311)
    {
        HideTextDrawForPlayer(playerid, TD_ID_SHOP);

        SetCameraBehindPlayer(playerid);
        p_temp[playerid][shop_id] = 0;
        return 1;
    }
    if(p_temp[playerid][tune_default] == true)
        return ShowPlayerDialog(playerid, D_TUNE_DEFAULT_CANCEL, DIALOG_STYLE_MSGBOX, ""I"Отмена покупки", ""W"Вы действительно хотите отказаться от покупки?", "Да", "Нет");
    /*
    if(p_temp[playerid][tune_object] == true)
        return ShowPlayerDialog(playerid, D_TUNE_OBJECT_CANCEL, DIALOG_STYLE_MSGBOX, ""I"Отмена покупки", ""W"Вы действительно хотите отказаться от покупки?", "Да", "Нет");
    */
    new h = GetPlayerHouseID(playerid);
    if(h != INVALID_HOUSE_ID && p_temp[playerid][h_repair_txtid] != -1)
    {
        new h_class = h_info[h][h_squar]-1;
        new int_id = h_info[h][h_int];
        if(IsPlayerInRangeOfPoint(playerid, 50.0, h_ints[h_class][int_id][i_spawn_pos][0],h_ints[h_class][int_id][i_spawn_pos][1],h_ints[h_class][int_id][i_spawn_pos][2]) && h+50 == GetPlayerVirtualWorld(playerid) ||
            IsPlayerInRangeOfPoint(playerid, 50.0, g_info[h_class-1][g_pX], g_info[h_class-1][g_pY], g_info[h_class-1][g_pZ]) && h+50 == GetPlayerVirtualWorld(playerid))
            return ShowPlayerDialog(playerid, D_CANCEL_REPAIR, DIALOG_STYLE_MSGBOX, ""I"Отмена покупки", ""W"Вы действительно хотите отказаться от покупки?", "Да", "Нет");
    }
    new biz_id = GetPVarInt(playerid, "bID");
    if(b_info[biz_id][_tip] == 2 && PlayerToPoint(5.0,playerid,b_info[biz_id][b_menu][0],b_info[biz_id][b_menu][1],b_info[biz_id][b_menu][2]))
    {
        if(!gang(playerid) && !mafia(playerid) && !biker(playerid) && p_info[playerid][fwork] != true)
            return ShowPlayerDialog(playerid,D_CANCEL_SKIN, DIALOG_STYLE_MSGBOX, ""I"Отмена покупки", ""W"Вы действительно хотите отказаться от покупки?", "Да", "Нет");
    }
    else if(b_info[biz_id][_tip] == B_ACCESSORIES && PlayerToPoint(5.0,playerid,b_info[biz_id][b_menu][0],b_info[biz_id][b_menu][1],b_info[biz_id][b_menu][2]))
        return ShowPlayerDialog(playerid, D_CANCEL_ACCESSORIES, DIALOG_STYLE_MSGBOX, ""I"Отмена покупки", ""W"Вы действительно хотите отказаться от покупки?", "Да", "Нет");
    return 1;
}

stock button_buy(playerid)
{
    if(GetPlayerInterior(playerid) == 15 && GetPlayerVirtualWorld(playerid) == 2023 && GetPlayerSkin(playerid) > 311)
    {
        return ShowPlayerDialog(playerid, D_BUY_REAL_SKIN, DIALOG_STYLE_MSGBOX, ""I"Покупка", ""W"Вы действительно хотите купить данный скин?", "Да", "Нет");
    }

    if(p_temp[playerid][tune_default] == true)
        return ShowPlayerDialog(playerid, D_TUNE_DEFAULT_BUY, DIALOG_STYLE_MSGBOX, ""I"Покупка", ""W"Вы действительно хотите купить выбранный элемент?", "Да", "Нет");
    /*
    if(p_temp[playerid][tune_object] == true)
        return ShowPlayerDialog(playerid, D_TUNE_OBJECT_BUY, DIALOG_STYLE_MSGBOX, ""I"Покупка", ""W"Вы действительно хотите купить данный аксессуар?", "Да", "Нет");
    */
    new h = GetPlayerHouseID(playerid);
    if(h != INVALID_HOUSE_ID && p_temp[playerid][h_repair_txtid] != -1)
    {
        new h_class = h_info[h][h_squar]-1;
        new int_id = h_info[h][h_int];
        if( IsPlayerInRangeOfPoint(playerid, 50.0, h_ints[h_class][int_id][i_spawn_pos][0],h_ints[h_class][int_id][i_spawn_pos][1],h_ints[h_class][int_id][i_spawn_pos][2]) && h+50 == GetPlayerVirtualWorld(playerid) ||
            IsPlayerInRangeOfPoint(playerid, 50.0, g_info[h_class-1][g_pX], g_info[h_class-1][g_pY], g_info[h_class-1][g_pZ]) && h+50 == GetPlayerVirtualWorld(playerid))
            return ShowPlayerDialog(playerid, D_BUY_REPAIR, DIALOG_STYLE_MSGBOX, ""I"Покупка", "Вы действительно хотите купить данный ремонт?", "Да", "Нет");
    }
    new biz_id = GetPVarInt(playerid, "bID");
    if(b_info[biz_id][_tip] == 2 && PlayerToPoint(5.0,playerid,b_info[biz_id][b_menu][0],b_info[biz_id][b_menu][1],b_info[biz_id][b_menu][2]))
    {
        if(!gang(playerid) && !mafia(playerid) && !biker(playerid) && p_info[playerid][fwork] != true)
            return ShowPlayerDialog(playerid, D_BUY_SKIN, DIALOG_STYLE_MSGBOX, ""I"Покупка", ""W"Вы действительно хотите купить данный скин?", "Да", "Нет");
    }
    else if(b_info[biz_id][_tip] == B_ACCESSORIES && PlayerToPoint(5.0,playerid,b_info[biz_id][b_menu][0],b_info[biz_id][b_menu][1],b_info[biz_id][b_menu][2]))
        return ShowPlayerDialog(playerid, D_BUY_ACCESSORIES, DIALOG_STYLE_MSGBOX, ""I"Покупка аксессуара", "Вы действительно хотите купить данный аксессуар?", "Да", "Нет");
    return 1;
}

stock button_next(playerid)
{
    if(GetPlayerInterior(playerid) == 15 && GetPlayerVirtualWorld(playerid) == 2023 && GetPlayerSkin(playerid) > 311)
    {
        p_temp[playerid][shop_id]++;
        if(p_temp[playerid][shop_id] >= sizeof(skinDonate)) p_temp[playerid][shop_id] = 0;
        SetPlayerSkin(playerid, ItemsInfo[skinDonate[p_temp[playerid][shop_id]][0]][iModel]);
        new string[14];
        format(string,sizeof(string),"%d FM", skinDonate[p_temp[playerid][shop_id]][1]);
        PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], string);
        return 1;
    }

    if(p_temp[playerid][tune_default] == true)
    {
        if(!IsPlayerInAnyVehicle(playerid) || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
            return Service_Error(playerid, "Вы должны находиться в транспортном средстве.");
        new vehicleid = GetPlayerVehicleID(playerid),
            tune_id = p_temp[playerid][p_listitem][1];
        if(p_temp[playerid][p_listitem][0] != vehicleid)
            return Service_Error(playerid, "ID транспорта не совпадает с первоначальным, воспользуйтесь услугами автосервиса повторно.");
        new max_value = p_temp[playerid][p_listitem][5];
        if(max_value == -1) return Service_Error(playerid, "Не найдено максимальное значение, воспользуйтесь услугами автосервиса повторно.");

        p_temp[playerid][shop_id]++;
        if(p_temp[playerid][shop_id] >= max_value) p_temp[playerid][shop_id] = 0;

        new till = Service_GetTill(playerid);
        if(till == -1) return Service_Error(playerid, "Не найден ID автосервиса, воспользуйтесь услугами автосервиса повторно.");

        STRING_GLOBAL[0] = EOS;
        if(p_temp[playerid][TextDrawServiceTune])
        {
            f(STRING_GLOBAL, "%d", GetPriceTuneElement(tune_id, p_temp[playerid][shop_id]) * till);
            PlayerTextDrawSetString(playerid, PTD_ServiceTune[playerid][8], STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            GetVehicleComponentName(p_temp[playerid][e_tListComponents][p_temp[playerid][shop_id]], STRING_GLOBAL);
            PlayerTextDrawSetString(playerid, PTD_ServiceTune[playerid][15], STRING_GLOBAL);
        }
        else
        {
            f(STRING_GLOBAL, "%d$", GetPriceTuneElement(tune_id, p_temp[playerid][shop_id]) * till);
            PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], STRING_GLOBAL);
        }

        if(tune_id == v_paintjob) ChangeVehiclePaintjob(vehicleid, p_temp[playerid][shop_id]);
        else
        {
            VEx_AddVehicleComponent(vehicleid, p_temp[playerid][e_tListComponents][p_temp[playerid][shop_id]]);
            if(tune_id == v_sideskirt || tune_id == v_vents) VEx_AddVehicleComponent(vehicleid, p_temp[playerid][e_tListComponents][p_temp[playerid][shop_id]]);
        }
        return 1;
    }
    new h = GetPlayerHouseID(playerid);
    if(h != INVALID_HOUSE_ID && p_temp[playerid][h_repair_txtid] != -1)
    {
        new h_class = h_info[h][h_squar]-1;
        new int_id = h_info[h][h_int];
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL,"%d$", h_info[h][h_squar]*TEXTURE_HOUSE_PRICE);
        if(IsPlayerInRangeOfPoint(playerid, 50.0, h_ints[h_class][int_id][i_spawn_pos][0],h_ints[h_class][int_id][i_spawn_pos][1],h_ints[h_class][int_id][i_spawn_pos][2]) && h+50 == GetPlayerVirtualWorld(playerid))
        {
            new txd_max_value = GetMaxCountTextureHouse(p_temp[playerid][h_repair_txtid]);
            if(txd_max_value == -1) return SendError(playerid, "КОД: 7099 / Обратитесь на форум! %d", p_temp[playerid][h_repair_txtid]);

            p_temp[playerid][shop_id]++;
            if(p_temp[playerid][shop_id] >= txd_max_value) p_temp[playerid][shop_id] = 0;
            h_info[h][h_mapping_id][p_temp[playerid][h_repair_txtid]] = p_temp[playerid][shop_id];
            House_Repair(h);
        }
        if(h_class == 0) return 1;
        if(IsPlayerInRangeOfPoint(playerid, 50.0, g_info[h_class-1][g_pX], g_info[h_class-1][g_pY], g_info[h_class-1][g_pZ]) && h+50 == GetPlayerVirtualWorld(playerid))
        {
            new txd_max_value = GetMaxCountTextureGarage(p_temp[playerid][h_repair_txtid]);
            if(txd_max_value == -1) return SendError(playerid, "КОД: 7098 / Обратитесь на форум! %d", p_temp[playerid][h_repair_txtid]);

            p_temp[playerid][shop_id]++;
            if(p_temp[playerid][shop_id] >= txd_max_value) p_temp[playerid][shop_id] = 0;
            h_info[h][h_garage_id][p_temp[playerid][h_repair_txtid]] = p_temp[playerid][shop_id];
            Garage_Repair(h);
        }
        PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], STRING_GLOBAL);
        return 1;
    }

    new biz_id = GetPVarInt(playerid, "bID");
    if(b_info[biz_id][_tip] == 2 && PlayerToPoint(5.0,playerid,b_info[biz_id][b_menu][0],b_info[biz_id][b_menu][1],b_info[biz_id][b_menu][2]))
    {
        if(!gang(playerid) && !mafia(playerid) && !biker(playerid) && p_info[playerid][fwork] != true)
        {
            new string[256];
            if(p_info[playerid][sex] == 2)
            {
                p_temp[playerid][shop_id]++;
                if(p_temp[playerid][shop_id] >= sizeof(skinBuyMan)) p_temp[playerid][shop_id] = 0;
                SetPlayerSkin(playerid, ItemsInfo[skinBuyMan[p_temp[playerid][shop_id]]][iModel]);
                format(string,sizeof(string),"%d$",ItemsInfo[skinBuyMan[p_temp[playerid][shop_id]]][iPrice]);
                PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], string);
            }
            else
            {
                p_temp[playerid][shop_id]++;
                if(p_temp[playerid][shop_id] >= sizeof(skinBuyMale)) p_temp[playerid][shop_id] = 0;
                SetPlayerSkin(playerid, ItemsInfo[skinBuyMale[p_temp[playerid][shop_id]]][iModel]);
                format(string,sizeof(string),"%d$",ItemsInfo[skinBuyMale[p_temp[playerid][shop_id]]][iPrice]);
                PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], string);
            }
            return 1;
        }
    }
    else if(b_info[biz_id][_tip] == B_ACCESSORIES && PlayerToPoint(5.0,playerid,b_info[biz_id][b_menu][0],b_info[biz_id][b_menu][1],b_info[biz_id][b_menu][2]))
    {
        if(p_temp[playerid][p_listitem_int] == -1) return SendError(playerid, "Произошла ошибка: 11.01-2144.");
        p_temp[playerid][shop_id]++;
        if(p_temp[playerid][shop_id] >= p_temp[playerid][p_listitem_int]) p_temp[playerid][shop_id] = 0;
        PreviewShopAccessories(playerid);
    }
    return 1;
}

stock button_back(playerid)
{
    if(GetPlayerInterior(playerid) == 15 && GetPlayerVirtualWorld(playerid) == 2023 && GetPlayerSkin(playerid) > 311)
    {
        p_temp[playerid][shop_id]--;
        if(p_temp[playerid][shop_id] < 0) p_temp[playerid][shop_id] = (sizeof(skinDonate)-1);
        SetPlayerSkin(playerid, ItemsInfo[skinDonate[p_temp[playerid][shop_id]][0]][iModel]);
        new string[14];
        format(string,sizeof(string),"%d FM", skinDonate[p_temp[playerid][shop_id]][1]);
        PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], string);
        return 1;
    }

    if(p_temp[playerid][tune_default] == true)
    {
        if(!IsPlayerInAnyVehicle(playerid) || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
            return Service_Error(playerid, "Вы должны находиться в транспортном средстве.");
        new vehicleid = GetPlayerVehicleID(playerid),
            tune_id = p_temp[playerid][p_listitem][1];
        if(p_temp[playerid][p_listitem][0] != vehicleid)
            return Service_Error(playerid, "ID транспорта не совпадает с первоначальным, воспользуйтесь услугами автосервиса повторно.");
        new max_value = p_temp[playerid][p_listitem][5];
        if(max_value == -1)
            return Service_Error(playerid, "Не найдено максимальное значение, воспользуйтесь услугами автосервиса повторно.");
        p_temp[playerid][shop_id]--;
        if(p_temp[playerid][shop_id] < 0) p_temp[playerid][shop_id] = (max_value-1);
        new till = Service_GetTill(playerid);
        if(till == -1) return Service_Error(playerid, "Не найден ID автосервиса, воспользуйтесь услугами автосервиса повторно.");

        STRING_GLOBAL[0] = EOS;
        if(p_temp[playerid][TextDrawServiceTune])
        {
            f(STRING_GLOBAL, "%d", GetPriceTuneElement(tune_id, p_temp[playerid][shop_id]) * till);
            PlayerTextDrawSetString(playerid, PTD_ServiceTune[playerid][8], STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            GetVehicleComponentName(p_temp[playerid][e_tListComponents][p_temp[playerid][shop_id]], STRING_GLOBAL);
            PlayerTextDrawSetString(playerid, PTD_ServiceTune[playerid][15], STRING_GLOBAL);
        }
        else
        {
            f(STRING_GLOBAL, "%d$", GetPriceTuneElement(tune_id, p_temp[playerid][shop_id]) * till);
            PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], STRING_GLOBAL);
        }

        if(tune_id == v_paintjob) ChangeVehiclePaintjob(vehicleid, p_temp[playerid][shop_id]);
        else
        {
            VEx_AddVehicleComponent(vehicleid, p_temp[playerid][e_tListComponents][p_temp[playerid][shop_id]]);
            if(tune_id == v_sideskirt || tune_id == v_vents) VEx_AddVehicleComponent(vehicleid, p_temp[playerid][e_tListComponents][p_temp[playerid][shop_id]]);
        }
    }
    /*
    if(p_temp[playerid][tune_object] == true)
    {
        new slot = p_temp[playerid][p_listitem][2],
            vehicleid = p_temp[playerid][p_listitem][3];
        if(vehicleid != GetPlayerVehicleID(playerid))
            return Service_Error(playerid, "Вы не на этой машине начинали тюнинг, воспользуйтесь услугами автосервиса повторно.");
        new vehmodel = GetVehicleModelEx(vehicleid)-400;
        if(vehmodel < 0) return 1;
        new max_value = GetMaxCountObjectTune(vehmodel, slot);
        if(max_value == -1)
            return Service_Error(playerid, "Не найдено максимальное значение, воспользуйтесь услугами автосервиса повторно.");

        if(--p_temp[playerid][shop_id] < 0) p_temp[playerid][shop_id] = (max_value-1);
        if(p_temp[playerid][shop_id] < 0 || p_temp[playerid][shop_id] > max_value) p_temp[playerid][shop_id] = 0;
        new groupid = p_temp[playerid][shop_id];
        new till = Service_GetTill(playerid);
        if(till == -1) return Service_Error(playerid, "Не найден ID автосервиса, воспользуйтесь услугами автосервиса повторно.");

        STRING_GLOBAL[0] = EOS;
        if(p_temp[playerid][TextDrawServiceTune])
        {
            if(veh_info[vehicleid][v_family_id] != -1) f(STRING_GLOBAL, "%d/%d FC", TuneObjData[vehmodel][slot][groupid][uPrice] * till, TuneObjData[vehmodel][slot][groupid][uPriceFamilyCoins]);
            else f(STRING_GLOBAL, "%d", TuneObjData[vehmodel][slot][groupid][uPrice] * till);
            PlayerTextDrawSetString(playerid, PTD_ServiceTune[playerid][8], STRING_GLOBAL);

            PlayerTextDrawSetString(playerid, PTD_ServiceTune[playerid][15], TuneObjData[vehmodel][slot][groupid][uName]);
        }
        else
        {
            if(veh_info[vehicleid][v_family_id] != -1) f(STRING_GLOBAL, "%d$/%d FC", TuneObjData[vehmodel][slot][groupid][uPrice] * till, TuneObjData[vehmodel][slot][groupid][uPriceFamilyCoins]);
            else f(STRING_GLOBAL, "%d$", TuneObjData[vehmodel][slot][groupid][uPrice] * till);
            PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], STRING_GLOBAL);
        }
        SetVehicleAttach(vehicleid, slot, groupid);
        Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
        return 1;
    }
    */
    new h = GetPlayerHouseID(playerid);
    if(h != INVALID_HOUSE_ID && p_temp[playerid][h_repair_txtid] != -1)
    {
        new h_class = h_info[h][h_squar]-1;
        new int_id = h_info[h][h_int];

        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL,"%d$", h_info[h][h_squar]*TEXTURE_HOUSE_PRICE);
        PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], STRING_GLOBAL);
        if(IsPlayerInRangeOfPoint(playerid, 50.0, h_ints[h_class][int_id][i_spawn_pos][0],h_ints[h_class][int_id][i_spawn_pos][1],h_ints[h_class][int_id][i_spawn_pos][2]) && h+50 == GetPlayerVirtualWorld(playerid))
        {
            new txd_max_value = GetMaxCountTextureHouse(p_temp[playerid][h_repair_txtid]);
            if(txd_max_value == -1) return SendError(playerid, "КОД: 7099 / Обратитесь на форум! %і", p_temp[playerid][h_repair_txtid]);

            p_temp[playerid][shop_id]--;
            if(p_temp[playerid][shop_id] < 0) p_temp[playerid][shop_id] = (txd_max_value-1);
            h_info[h][h_mapping_id][p_temp[playerid][h_repair_txtid]] = p_temp[playerid][shop_id];
            House_Repair(h);
        }
        if(h_class == 0) return 1;
        if(IsPlayerInRangeOfPoint(playerid, 50.0, g_info[h_class-1][g_pX], g_info[h_class-1][g_pY], g_info[h_class-1][g_pZ]) && h+50 == GetPlayerVirtualWorld(playerid))
        {
            new txd_max_value = GetMaxCountTextureGarage(p_temp[playerid][h_repair_txtid]);
            if(txd_max_value == -1) return SendError(playerid, "КОД: 7098 / Обратитесь на форум! %і", p_temp[playerid][h_repair_txtid]);

            p_temp[playerid][shop_id]--;
            if(p_temp[playerid][shop_id] < 0) p_temp[playerid][shop_id] = (txd_max_value-1);
            h_info[h][h_garage_id][p_temp[playerid][h_repair_txtid]] = p_temp[playerid][shop_id];
            Garage_Repair(h);
        }
        return 1;
    }
    new biz_id = GetPVarInt(playerid, "bID");
    if(b_info[biz_id][_tip] == 2 && PlayerToPoint(5.0,playerid,b_info[biz_id][b_menu][0],b_info[biz_id][b_menu][1],b_info[biz_id][b_menu][2]))
    {
        if(!gang(playerid) && !mafia(playerid) && !biker(playerid) && p_info[playerid][fwork] != true)
        {
            new string[256];
            if(p_info[playerid][sex] == 2)
            {
                p_temp[playerid][shop_id]--;
                if(p_temp[playerid][shop_id] < 0) p_temp[playerid][shop_id] = (sizeof(skinBuyMan)-1);
                SetPlayerSkin(playerid,ItemsInfo[skinBuyMan[p_temp[playerid][shop_id]]][iModel]);
                format(string,sizeof(string),"%d$",ItemsInfo[skinBuyMan[p_temp[playerid][shop_id]]][iPrice]);
                PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], string);
            }
            else
            {
                p_temp[playerid][shop_id]--;
                if(p_temp[playerid][shop_id] < 0) p_temp[playerid][shop_id] = (sizeof(skinBuyMale)-1);
                SetPlayerSkin(playerid, ItemsInfo[skinBuyMale[p_temp[playerid][shop_id]]][iModel]);
                format(string,sizeof(string),"%d$",ItemsInfo[skinBuyMale[p_temp[playerid][shop_id]]][iPrice]);
                PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], string);
            }
        }
        //ApplyAnimation(playerid,"CARRY","crry_prtial",4.1,0,1,1,1,1);
    }
    else if(b_info[biz_id][_tip] == B_ACCESSORIES && PlayerToPoint(5.0,playerid,b_info[biz_id][b_menu][0],b_info[biz_id][b_menu][1],b_info[biz_id][b_menu][2]))
    {
        if(p_temp[playerid][p_listitem_int] == -1) return SendError(playerid, "Произошла ошибка: 11.01-2143.");
        p_temp[playerid][shop_id]--;
        if(p_temp[playerid][shop_id] <= 0) p_temp[playerid][shop_id] = p_temp[playerid][p_listitem_int]-1;
        PreviewShopAccessories(playerid);
    }
    return 1;
}

CMD:spawnchange(playerid, params[])
{
    ShowPlayerDialog(playerid, D_SET_SPAWN, DIALOG_STYLE_LIST, ""I"Изменение места появления в игре", "\
    "I"[1]"W" На вокзале\n\
    "I"[2]"W" В собственном доме\n\
    "I"[3]"W" На базе организации\n\
    "I"[4]"W" В доме семьи\n\
    "I"[5]"W" В отеле\n\
    "I"[6]"W" В трейлере", "Выбрать", "Отмена");
    return 1;
}
alias:spawnchange("changespawn", "setspawn");

CMD:map(playerid, params[])
{
    if(!FD(playerid))
        return 1;
    SendRconCommand("gmx");
    return 1;
}

CMD:referals(playerid, params[])
{
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name`, `level` FROM `accounts` WHERE `referral` = %d ORDER BY `level` DESC LIMIT 10",
        p_info[playerid][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL, "ReferalsInfo_Callback", "i", playerid);
    return 1;
}

forward ReferalsInfo_Callback(playerid);
public ReferalsInfo_Callback(playerid)
{
    new rows;
    cache_get_row_count(rows);
    p_temp[playerid][FirstReferal] = 0;
    if(!rows) return SendError(playerid, "Ничего не найдено.");
    new Level, Name_tmp[MAX_PLAYER_NAME];
    STRING_GLOBAL[0] = EOS;
    for(new i; i < rows; i ++)
    {
        cache_get_value_name(i, "name", Name_tmp, MAX_PLAYER_NAME);
        cache_get_value_name_int(i, "level",Level);

        if(Level < 4) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{FF0000}%i."W" %s - {FFFF00}%d LEVEL\n", STRING_GLOBAL, i+1, Name_tmp, Level);
        else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{FF0000}%i."W" %s - {FFFF00}%d LEVEL\n", STRING_GLOBAL, i+1, Name_tmp, Level);
    }
    ShowPlayerDialog(playerid, D_REFERALS, DIALOG_STYLE_MSGBOX, ""I"Приглашенные", STRING_GLOBAL, "Далее", "Назад");
    return 1;
}

CMD:areferals(playerid, params[])
{
    if(p_info[playerid][admin] < 3) return 1;
    if(!(3 <= strlen(params) <= 24)) return SendError(playerid, "Длина введеного текста должна быть не менее 3 и не более 24 символов.");
    p_temp[playerid][FirstReferal] = 0;
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id` FROM `accounts` WHERE `name` = '%s' LIMIT 1", params);
    mysql_tquery(con_bd, STRING_GLOBAL, "AReferalsInfo_Callback", "i", playerid);
    return 1;
}

forward AReferalsInfo_Callback(playerid);
public AReferalsInfo_Callback(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(!rows) return SendError(playerid, "Игрока с таким ником в базе данных не найдено.");
    cache_get_value_name_int(0, "id", p_temp[playerid][p_listitem_int]);
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id`, `name`, `level`, `donate_all_new` FROM `accounts` WHERE `referral` = %d ORDER BY `level` DESC LIMIT 20", p_temp[playerid][p_listitem_int]);
    mysql_tquery(con_bd, STRING_GLOBAL, "OnPlayerCheckAllReferal", "i", playerid);
    return 1;
}

forward OnPlayerCheckAllReferal(playerid);
public OnPlayerCheckAllReferal(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(!rows) return SendError(playerid, "Ничего не найдено.");

    new Level, AllDonate, nickName[MAX_PLAYER_NAME];
    STRING_GLOBAL[0] = EOS;
    for(new i; i < rows; i++)
    {
        cache_get_value_name(i, "name",         nickName);
        cache_get_value_name_int(i,  "level",        Level);
        cache_get_value_name_int(i,  "donate_all_new",   AllDonate);
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"W"Nick: {FFFF00}%s\t"W"Level: {FFFF00}%d\t"W"Donate: {FFFF00}%d\n", STRING_GLOBAL, nickName, Level, AllDonate);
    }
    ShowPlayerDialog(playerid, D_AREFERALS, DIALOG_STYLE_MSGBOX, ""I"Список рефералов", STRING_GLOBAL, "Дальше", "Назад");
    return 1;
}

CMD:restart(playerid, params[])
{
    if(!FD(playerid))
        return 1;

    if(isnull(params))
    {
        SendInfo(playerid, "Используйте: /restart [кол-во секунд]");
        SendInfo(playerid, "30 секунд | 60 секунд | 120 секунд");
        SendInfo(playerid, "180 секунд | 240 секунд | 300 секунд");
        return 1;
    }

    new seconds = strval(params);
    if(!(30 <= seconds <= 300))
        return SendError(playerid, "Кол-во секунд должно быть не менее 30 и не более 300.");

    SendMesAll(COLOR_LIGHTRED, "----------=============== [ Внимание! Технический рестарт сервера через %d секунды! ] ===============----------", seconds);

    GameTextForAll("~r~RESTART", 10000, 0);

    save_gz_restart();
    SetTimer("game_mode_exit", 1000*seconds, 0);
    return 1;
}

CMD:getpos(playerid, params[])
{
    new Float:pang;
    GetPlayerFacingAngle(playerid, pang);
    SendInfo(playerid, "Interior: %d, VirtualWorld: %d. | FacingAngle: %f", GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid), pang);
    return 1;
}

CMD:divorce(playerid, params[])
{
    if(strlen(p_info[playerid][Partner]) <= 5) return SendError(playerid, "У Вас нет мужа или жены.");
    SendAccess(playerid, "Вы развелись.");

    new targetid = GetPlayerID(p_info[playerid][Partner]);
    if(targetid != 0xFFFF) strmid(p_info[targetid][Partner], "None", 0, 10);
    else
    {
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `partner` = 'None' WHERE `name` = '%e' LIMIT 1",
        p_info[playerid][Partner]);
        mysql_tquery(con_bd, STRING_GLOBAL);
    }
    strmid(p_info[playerid][Partner], "None", 0, 10);
    return 1;
}

CMD:propose(playerid, params[])
{
    if(IsPlayerInRangeOfPoint(playerid, 10.0, -1989.9000, 1117.8800, 54.4700) == 0) return SendError(playerid, "Вы слишком далеко от церкви.");
    if(strlen(p_info[playerid][Partner]) >= 5) return SendError(playerid, "У Вас уже есть муж или жена.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /propose [id игрока]");
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не найден.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");
    if(strlen(p_info[params[0]][Partner]) >= 5) return SendError(playerid, "У игрока уже есть муж или жена.");
    if(p_info[playerid][sex] == p_info[params[0]][sex]) return SendError(playerid, "В штате запрещены однополные браки.");

    if(p_info[playerid][cash] < 50000) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
    if(p_info[params[0]][cash] < 50000) return SendError(playerid, "У игрока нет столько денег. Используйте /donate");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
    "W"Вы хотите предложить "I"%s"W" заключить бракосочетание за "I"50000$.", get_name(params[0]));
    ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"Предложение бракосочетания", STRING_GLOBAL, "Далее", "Отмена");
    SetOfferData(playerid, params[0], OFFER_ID_PROPOSE, params[1]);
    return 1;
}

