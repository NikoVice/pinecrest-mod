        if(panel_warehouse < 25)
        {
            panel_warehouse += random(5) + 1;
            MysqlUpdateOtherInt("panel_warehouse", panel_warehouse);
        }
        if(vc_warehouse < 25)
        {
            vc_warehouse += random(5) + 1;
            MysqlUpdateOtherInt("vc_warehouse", panel_warehouse);
        }
        if(undergroundbots_warehouse < 25)
        {
            undergroundbots_warehouse += random(5) + 1;
