        }
        if(cotton_warehouse < 5)
        {
            cotton_warehouse += random(5) + 1;
            MysqlUpdateOtherInt("cotton_warehouse", cotton_warehouse);
        }
        if(linen_warehouse < 5)
        {
            linen_warehouse += random(5) + 1;
            MysqlUpdateOtherInt("linen_warehouse", linen_warehouse);
        }
        switch(timestamp_hour)
        {
            case 14 .. 22: CreateWarPlane();
            default: CreateAirDrop();
        }
        totalcasket[1] = 0;
        totalcasket[2] = 0;
        totalcasket[3] = 0;

        TruckerOrder[0] += random(10);
        if(TruckerOrder[0] > 30) TruckerOrder[0] = 0;
        TruckerOrder[1] += random(10);
        if(TruckerOrder[1] > 30) TruckerOrder[1] = 0;
        TruckerOrder[2] += random(10);
        if(TruckerOrder[2] > 30) TruckerOrder[2] = 0;

        new str[12];
        f(str, "%d", TruckerOrder[0]);
        SetDynamicObjectMaterialText(TruckerObject[0], 0, str, 130, "Arial Black", 55, 0, 0xFF000000, 0x00000000, 1);
        SetDynamicObjectMaterialText(TruckerObject[1], 0, str, 130, "Arial Black", 55, 0, 0xFFFFFFFF, 0x00000000, 1);
        f(str, "%d", TruckerOrder[1]);
        SetDynamicObjectMaterialText(TruckerObject[2], 0, str, 130, "Arial Black", 55, 0, 0xFF000000, 0x00000000, 1);
        SetDynamicObjectMaterialText(TruckerObject[3], 0, str, 130, "Arial Black", 55, 0, 0xFFFFFFFF, 0x00000000, 1);
        f(str, "%d", TruckerOrder[2]);
        SetDynamicObjectMaterialText(TruckerObject[4], 0, str, 130, "Arial Black", 55, 0, 0xFF000000, 0x00000000, 1);
        SetDynamicObjectMaterialText(TruckerObject[5], 0, str, 130, "Arial Black", 55, 0, 0xFFFFFFFF, 0x00000000, 1);
    }

    if(timestamp_minute == 2 && timestamp_second == 30)
    {
        SaveFractionWarehouse(MAYOR_LS);
    }

    if(timestamp_minute == 00 && timestamp_second == 05) if(RaceStarted == false && DerbyStarted == false && PaintBallStarted == false && CossackRobbersStart == false) InfoEvent(0);
    if(timestamp_minute == 15 && timestamp_second == 05) if(RaceStarted == false && DerbyStarted == false && PaintBallStarted == false && CossackRobbersStart == false) InfoEvent(1);
    if(timestamp_minute == 30 && timestamp_second == 05) if(RaceStarted == false && DerbyStarted == false && PaintBallStarted == false && CossackRobbersStart == false) InfoEvent(2);
    if(timestamp_minute == 45 && timestamp_second == 05) if(RaceStarted == false && DerbyStarted == false && PaintBallStarted == false && CossackRobbersStart == false) InfoEvent(3);

