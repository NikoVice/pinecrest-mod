            p_info[playerid][flinmoney] += price;
            MysqlUpdatePlayerInt(playerid, "flinmoney", p_info[playerid][flinmoney]);
            PromocodeInfo[playerid][TYPE_PROMOCODE_DONATE] = 0;

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `promocode` SET `donate` = 0 WHERE `id` = %d", p_info[playerid][promocode_create]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            Log(LOG_player, INFO, "%s[%d](%s %s) забрал(-а) %d Pinecrest Money с промокода %s | #Promocode",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                price, PromocodeName[playerid]);

            ShowDialogPromocode(playerid, PROMOCODE_GIVEDONATE, price);
            return 1;
