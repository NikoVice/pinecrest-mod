forward MysqlCheckSMS(playerid, inputtext[]);
public MysqlCheckSMS(playerid, inputtext[])
{
    new rows;
    cache_get_row_count(rows);

    if(!rows) return SendError(playerid, "������ �� �������.");
    new black_list;
    cache_get_value_name_int(0, "BlackList", black_list);
    if(black_list == 1) return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"����������",""W"�� � ������ ������!","�������","");

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `phone_messages` VALUES('%e', '%e', '%e', '1', %d)",
    get_name(playerid), p_temp[playerid][Phone_NickTarget], inputtext, timestamp);
    mysql_tquery(con_bd, STRING_GLOBAL, "MysqlAddMessage", "d", playerid);

    new id;
    sscanf(p_temp[playerid][Phone_NickTarget], "i", id);
    if(id != INVALID_PLAYER_ID && p_temp[id][offphone] != true)
    {
        SendInfo(id, "��� ������ ����� ���������.");
        SetPlayerChatBubble(id, "�������(-�) ���������", COLOR_MAIN, 20.0, 10000);
    }

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd,STRING_GLOBAL, sizeof STRING_GLOBAL, "UPDATE `phone_messages` SET `Read` = 0 WHERE `NickTarget` = '%s' AND `NickPlayer` = '%s'",
    get_name(playerid), p_temp[playerid][Phone_NickTarget]);
    mysql_tquery(con_bd, STRING_GLOBAL);
    return 1;
}

forward MysqlChencheGroup(playerid);
