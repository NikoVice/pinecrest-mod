                if(DuelData[duelid][dCommand2][i] != INVALID_PLAYER_ID)
                    SendAccess(DuelData[duelid][dCommand2][i], "%s [%d] установил %d раундов для дуэли.", get_name(playerid), playerid, DuelData[duelid][dRound]);
            }
            OnServerShowDialogDuelMenu(playerid);
            return 1;
