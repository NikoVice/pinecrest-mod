    if(clickedid == TD_Recon[23])
    { //NEXT >>
        if(p_temp[playerid][recon_antiflood] > timestamp) return SendError(playerid, "����������� ����� ��� � 1 �������.");
        p_temp[playerid][recon_antiflood] = timestamp+1;

        for(new next_id = pSpectateId[playerid]+1; next_id < MAX_PLAYERS; next_id++)
        {
            if(!IsPlayerConnected(next_id)) continue;
            if(!p_info[next_id][loggedIn] || next_id == playerid ||
                pSpectateId[next_id] != INVALID_PLAYER_ID || GetPlayerState(next_id) == PLAYER_STATE_SPECTATING) continue;
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d",  next_id);
            callcmd::recon(playerid, STRING_GLOBAL);
            return 1;
        }
        for(new next_id; next_id <= pSpectateId[playerid]; next_id++)
        {
            if(!IsPlayerConnected(next_id)) continue;
            if(!p_info[next_id][loggedIn] || next_id == playerid ||
                pSpectateId[next_id] != INVALID_PLAYER_ID || GetPlayerState(next_id) == PLAYER_STATE_SPECTATING) continue;
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d",  next_id);
            callcmd::recon(playerid, STRING_GLOBAL);
            return 1;
        }
    }
