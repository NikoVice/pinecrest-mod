                if(fix_listitem < 1 || fix_listitem > 200) return SendError(playerid, "Материалов должно быть не менее 1 и не более 200.");
                if(fix_listitem > GetFractionWarehouse(p_info[playerid][member], fwMate)) return SendError(playerid, "На складе недостаточно материалов.");
                if(!GetFractionSettings(p_info[playerid][member], fWareHouseStatus) && p_info[playerid][rang] != 10) return SendError(playerid, "Лидер закрыл склад.");
                if(!GivePlayerInventory(playerid, 627, fix_listitem))
                    return 1;
                SetFractionWarehouse(p_info[playerid][member], fwMate, -fix_listitem);

                SendAccess(playerid, "Вы взяли со склада \"%s\" %d материалов.", GetFractionName(p_info[playerid][member]), fix_listitem);
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] взял со склада %d материалов.", get_name(playerid), playerid, fix_listitem);
                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
            }
            else
            {
                if(fix_listitem < 1) return SendError(playerid, "Вы не можете положить менее 1 материала.");
                if(GetInventoryAmount(playerid, 627) < fix_listitem) return SendError(playerid, "У Вас нет столько материалов.");
                SetFractionWarehouse(p_info[playerid][member], fwMate, fix_listitem);
