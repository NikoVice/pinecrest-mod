        case D_FRACTION_MEMBER_MENU:
        {
            if(!response) return UpdatePlayerList(playerid);
            new list_id = p_temp[playerid][p_listitem_int];
            if(!(0 <= list_id < 25)) return SendError(playerid, "����������� ������: BUG-F002! ���������� ��� ���.");
            new player_mysql_id = p_temp[playerid][p_listitem][list_id];
            if(player_mysql_id <= INVALID_MYSQL_ID) return SendError(playerid, "����������� ������: BUG-F003! ���������� ��� ���.");

            if(GetPlayerUserID(player_mysql_id) != INVALID_PLAYER_ID) return SendError(playerid, "����� � ����.");
            switch(listitem)
            {
                case 0:
                {
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name`, `rang`, `fwarn`, `lastenter` FROM `accounts` WHERE `id` = %d LIMIT 1", player_mysql_id);
                    mysql_tquery(con_bd, STRING_GLOBAL, "FractionMemberInfo", "i", playerid);
                }
                case 1:
                {
                    STRING_GLOBAL[0] = EOS;
