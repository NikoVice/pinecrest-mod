cmd:shadow(playerid, params[])
{
    if(SRV_ID) return 1;
    new texture_name[64];
    if(sscanf(params, "iiiiis", params[0], params[1], params[2], params[3], params[4], texture_name)) return SendInfo(playerid, "Используйте: /shadow value1 value2 value3");
    SetVehicleShadowParams(GetPlayerVehicleID(playerid), params[0], params[1], params[2], params[3], params[4], texture_name);
    SendAccess(playerid, "sizeX %d sizeY %d r:%d g:%d b:%d texture: %s", params[0], params[1], params[2], params[3], params[4], texture_name);
    return 1;
}

