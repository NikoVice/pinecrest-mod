                    b_info[bizz_id][_till] = 1;

                    b_info[bizz_id][_percent] = 10;
                    b_info[bizz_id][b_fare][0] = 200;
                    b_info[bizz_id][b_fare][1] = 250;
                    b_info[bizz_id][b_fare][2] = 200;
                    b_info[bizz_id][b_fare][3] = 500;

