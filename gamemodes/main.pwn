    {
        if(!IsValidVehicle(vehicleid)) return 1;
        if((veh_info[vehicleid][v_npoType] == NPO_JOB && veh_info[vehicleid][v_npoId] == JOB_TC_TAXI) || veh_info[vehicleid][v_job] == JOB_TC_TAXI)
        {
            foreach(new i: Player)
            {
                if(!p_info[i][loggedIn]) continue;
                if(GetPlayerVehicleSeat(i) == 0 && GetPlayerVehicleID(i) == vehicleid && (IsPlayerOwnerVehicle(playerid, vehicleid) || p_temp[i][rented_veh] != INVALID_VEHICLE_ID) && p_temp[i][Work_ID] == TAXI_WORK)
                {
                    SendInfo(i, "%s [%d] ��� � ���� �����.", get_name(playerid), playerid);
                    //SendInfo(i, "�������� ������ � ������� ����� �������� ������������.");
                    SetPVarInt(i,"@passenger",playerid+1);
                    SetPVarInt(i,"@passenger_count",GetPVarInt(i,"@passenger_count")+1);

                    GetPlayerPos(playerid, p_temp[playerid][TaxiFix][0], p_temp[playerid][TaxiFix][1], p_temp[playerid][TaxiFix][2]);
                    if(p_temp[i][p_GPS] == false) ShowPlayerDialog(playerid, D_SELECT_TAXI, DIALOG_STYLE_LIST, ""I"��������� �����", ""I"[1]"W" ��������� �����\n"I"[2]"W" ������� �� ����������", "�������", "������");
                    break;
                }
            }
        }
        if(GetVehicleModelEx(vehicleid) == 487 && veh_info[vehicleid][v_int] == 100)
        { // FIX ��������� ���, ����� � ���������� ���� ����� ����������
            RemovePlayerAccessories(playerid, false);
            SetPVarInt(playerid, #AIRBALLOON_USE, vehicleid);
        }
    }
    if(oldstate == PLAYER_STATE_PASSENGER)
    {
        ResetPlayerWeapons(playerid);
        for (new i; i < MAX_WEAPONS; i++)
        {
            if(p_info[playerid][Weapon][i] == 42)
            {
                p_info[playerid][Weapon][i] = 0;
                p_info[playerid][Ammo][i] = 0;
                p_temp[playerid][FireAmmo] = 0;
                p_temp[playerid][mechanic_ammo] = 0;
                continue;
            }
            GivePlayerWeapon(playerid, p_info[playerid][Weapon][i], p_info[playerid][Ammo][i]);
        }
        SetPlayerArmedWeapon(playerid, 0);
        if(GetPVarInt(playerid, #AIRBALLOON_USE) == vehicleid)
        {
            AttachToPlayerAccOrCostume(playerid, INVALID_PLAYER_ID);
            DeletePVar(playerid, #AIRBALLOON_USE);
        }
    }
    return 1;
}

public OnPlayerEnterCheckpoint(playerid)
{
    if(p_temp[playerid][p_GPS] == true)
    {
        if(p_temp[playerid][panic_target_id] != INVALID_PLAYER_ID)
            p_temp[playerid][panic_target_id] = INVALID_PLAYER_ID;
        CancelPlayerGPS(playerid);
        SendInfo(playerid, "�� �������� ����� ����������.");
        return 1;
    }


    if(p_temp[playerid][Work_ID] == COLLECTOR_WORK || p_temp[playerid][Work_ID] == ROBBER_WORK || p_temp[playerid][Work_ID] == ELECTRIC_WORK || p_temp[playerid][Work_ID] == OIL_WORK)
    {
        if(GetPVarInt(playerid, "USE_OnPlayerEnterCheckpoint") > timestamp) return 0;
        SetPVarInt(playerid, "USE_OnPlayerEnterCheckpoint", timestamp + 2);
    }

    if(p_temp[playerid][prison_escape] == 2 && p_info[playerid][jail] > 0 && p_temp[playerid][prison_escape_time] > 0)
    {
        DisablePlayerCheckpoint(playerid);
        SendAccess(playerid, "�� �������� �� ������ �� ����.");
        p_info[playerid][jail] =
        p_info[playerid][jail_time] =
        p_temp[playerid][prison_escape] =
        p_temp[playerid][prison_escape_time] = 0;
        SetPlayerWantedLevel(playerid, p_info[playerid][wanted]);
        return 1;
    }
    if(p_temp[playerid][prison_work] == 1 && p_info[playerid][jail] == 5 && GetPlayerVirtualWorld(playerid) == 1)
    {
        if(p_info[playerid][jail_time] < 20) return SendError(playerid, "�� �� ����������� � ������ ��� ����� ���������� �����������.");
        if(!p_temp[playerid][prison_work]) return SendError(playerid, "��� ������ ���������� ������ ��������� �������������� ������.");
        ClearAnimations(playerid);
        ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 1, 0, 0, 1, 1);
        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
        p_temp[playerid][prison_work] = 2;
        SendAccess(playerid, "�� ����� �����.");
        SendInfo(playerid, "�������� ��� �� �����.");
        DisablePlayerCheckpoint(playerid);
        return 1;
    }
    #if EVENT_HALLOWEEN == 1
        if(p_info[playerid][halloween_id] == 1 && p_info[playerid][halloween_progress] < 3)
        {
            new houseId = GetPVarInt(playerid, "HALLOWEEN:HOUSE_ID");
            if(houseId != 0 && 1 <= houseId <= totalhouses-1)
            {
                if(IsPlayerInRangeOfPoint(playerid, 2.5, h_info[houseId][h_enter][0], h_info[houseId][h_enter][1], h_info[houseId][h_enter][2]))
                {
                    DisablePlayerCheckpoint(playerid);
                    DeletePVar(playerid, "HALLOWEEN:HOUSE_ID");
                    MeAction(playerid, "��������(-�) � ����� � ������� \"�������� ��� �������\"");

                    new result = random(5);
                    switch(result)
                    {
                        case 0: ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"������ ����", ""W"�������� � ���� ������! �������, �����.", "�������", "");
                        case 1: ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"������ ����", ""W"������ ��� ��������� ��� �����? ����� ������! ���� �������.", "�������", "");
                        case 2: ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"������ ����", ""W"� ���� � ����������, ���� �������!", "�������", "");
                        case 3: ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"������ ����", ""W"������ � ���� �� ���! ���� ������!", "�������", "");
                        default: ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"������ ����", ""W"����� �� ���������, � ����������� �������. ��� � ���� ������!", "�������", "");
                    }

                    if(result <= 2)
                    {
                        p_info[playerid][halloween_progress]++;
                        MysqlUpdatePlayerInt(playerid, "halloween_progress", p_info[playerid][halloween_progress]);
                        SendAccess(playerid, "�������, ������� ��������.");
                    }
                    else SendError(playerid, "� ���������, ������� ����� �������� �� �������.");
                    HalloweenQuest_Check(playerid);
                    return 1;
                }
            }
        }

        if(p_info[playerid][halloween_id] == 2 && 3 <= p_info[playerid][halloween_progress] <= 6)
        {
            new graver_id = GetPVarInt(playerid, "HALLOWEEN:GRAVER_ID");
            if(graver_id != 0 && 1 <= graver_id <= MAX_HALLOWEEN_GRAVES+1)
            {
                graver_id--;
                if(IsPlayerInRangeOfPoint(playerid, 2.5, halloween_graves_pos[graver_id][0], halloween_graves_pos[graver_id][1], halloween_graves_pos[graver_id][2]))
                {
                    ClearAnimations(playerid);
                    ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                    //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);

                    DisablePlayerCheckpoint(playerid);
                    DeletePVar(playerid, "HALLOWEEN:GRAVER_ID");
                    MeAction(playerid, "���������� � ��������(-�) �����");

                    p_info[playerid][halloween_progress]++;
                    MysqlUpdatePlayerInt(playerid, "halloween_progress", p_info[playerid][halloween_progress]);
                    SendAccess(playerid, "�������, ����� ���������.");

                    HalloweenQuest_Check(playerid);
                    return 1;
                }
            }
        }
    #endif
    if(p_temp[playerid][Work_ID] == DRUG_WORK && p_temp[playerid][WorkCheckDrug] != -1 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
    {
        if(IsPlayerInRangeOfPoint(playerid, 2.0, drug_position[p_temp[playerid][WorkCheckDrug]][0], drug_position[p_temp[playerid][WorkCheckDrug]][1], drug_position[p_temp[playerid][WorkCheckDrug]][2]))
        {
            ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 4.0, 0, 0, 0, 0, 0, 1);
            if(p_temp[playerid][WorkCountDrug] == 0)
            {
                SetTimerEx("DrugsOff", (3500 + random(2500)), 0, "d", playerid);
                p_temp[playerid][WorkCountDrug] = 1;
            }
            return 1;
        }
    }

    new vehicleid = GetPlayerVehicleID(playerid);

    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
    {
        if(p_temp[playerid][Work_ID] == THEFT_CAR_WORK && TheftCarGPS[playerid] == true)
        {
            if(TheftCarIDx[playerid] == -1) return SendError(playerid, "� ��� ��� ���������.");
            new idx = TheftCarIDx[playerid];
            if(TheftCarVehicle[idx][tcvVehicle] != vehicleid) return SendError(playerid, "������������ �������� �� �������� ��������.");
            if(AntiCheatWarningTime[playerid][0] > timestamp) return SendError(playerid, "�� �� ������ ���������� ������������ �������� ��� �����, ���������.");
            new Float:v_hp;
            GetVehicleHealth(vehicleid, v_hp);
            if(v_hp < 750) return SendError(playerid, "������������ �������� � ����������� ���������.");

            new vehicle_model = GetVehicleModelEx(vehicleid), class = GetVehicleData(vehicle_model, E_VD_CLASS), salary[5] = {2500, 5000, 7500, 10000, 10000}, new_salary = salary[class];

            new reason_money = GetPlayerMoneySkill(playerid, new_salary, 6);
            UpdatePlayerWorkSkill(playerid, 6);

            CheckPlayerMission(playerid, START_THEFT);
            CheckPlayerMission(playerid, DAILY_THEFT);
            CheckPlayerMission(playerid, ACHIEVEMENT_THEFT);

            CheckPlayerFreelance(playerid, FREELANCE_THEFT);
            CheckPlayerBattlePass(playerid, BATTLEPASS_THEFT);

            SetPlayerMoney(playerid, reason_money, true, "�������� ��������");
            OnServerInfoForMoney[16] += reason_money;

            SendMes(playerid, COLOR_BLUE, "�� ����� ������������ ��������.");
            SendMes(playerid, COLOR_LYELLOW, "� ����� �������� ���������: {"#cLIME"}%d$.", reason_money);

            veh_info[vehicleid][v_thief_ID] = INVALID_PLAYER_ID;

            RemovePlayerFromVehicle(playerid);
            DestroyTheftCarVehicle(playerid);
            ClearTheftCar(playerid, TYPE_THEFT_CAR_VEHICLE);

            UpdateFamilyLevel(playerid);
            UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_THEFT_CAR); // ���������: ��������
            return 1;
        }
    }

    if(p_temp[playerid][Work_ID] == PIZZABOY_WORK && p_temp[playerid][PizzaboyIDx] != -1)
    {
        new houseid = p_temp[playerid][PizzaboyIDx];
        if(IsPlayerInRangeOfPoint(playerid, 5.0, h_info[houseid][h_enter][0], h_info[houseid][h_enter][1], h_info[houseid][h_enter][2]))
        {
            if(AntiCheatWarningTime[playerid][0] > timestamp) return SendError(playerid, "�� �� ������ ���������� ������ ��� �����, ���������.");

            DisablePlayerCheckpoint(playerid);
            SendMes(playerid, COLOR_BLUE, "�� ��������� �����.");
            new reason_money = GetPlayerMoneySkill(playerid, p_temp[playerid][PizzaboySalary], 7);

            if(CheckPlayerMaxSalarySkill(playerid, 7, reason_money))
            {
                SetPlayerMoney(playerid, reason_money, true, "�������� �����");
                OnServerInfoForMoney[17] += reason_money;
                SendMes(playerid, COLOR_LYELLOW, "� ����� �������� ���������: {"#cLIME"}%d$.", reason_money);

                p_info[playerid][job_skill_salary][7] += reason_money;
            }
            else SendError(playerid, "�� ��������� ��� ���� ���� ���������� ������������ ���������� �������� �������.");

            if(GetPlayerGiveCasket(100, 5) != -1) GivePlayerCasket(playerid, -1);
            UpdatePlayerWorkSkill(playerid, 7);
            SendMes(playerid, COLOR_SEA_WAVE, "������������� � \"Cluckin Bell\" ����� ����� ����� �����.");
            p_temp[playerid][PizzaboyIDx] = -1;
            p_temp[playerid][PizzaboySalary] = 0;

            AntiCheatWarningTime[playerid][2] = timestamp + AntiCheatWarningTime[playerid][1];

            CheckPlayerMission(playerid, START_PIZZA);
            CheckPlayerMission(playerid, DAILY_PIZZA);
            CheckPlayerMission(playerid, ACHIEVEMENT_PIZZA);

            CheckPlayerFreelance(playerid, FREELANCE_PIZZA);
            CheckPlayerBattlePass(playerid, BATTLEPASS_PIZZA);

            UpdateFamilyLevel(playerid);
            UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_PIZZABOY); // ���������: ��������� �����
        } else SetHouseCheckpoint(playerid, 0, p_temp[playerid][PizzaboyIDx]);
        return 1;
    }
    if(p_temp[playerid][Work_ID] == SPACE_WORK && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
    {
        new idx = p_temp[playerid][SpaceIDx] - 1;
        if(idx != -1 && IsPlayerInRangeOfPoint(playerid, 5.0, SpaceFossilsInfo[idx][sfPos][0], SpaceFossilsInfo[idx][sfPos][1], SpaceFossilsInfo[idx][sfPos][2]))
        {
            SendMes(playerid, COLOR_SEA_WAVE, "����� ������ ����������, ��������� ALT.");
            DisablePlayerCheckpoint(playerid);
            return 1;
        }
    }
    if(p_temp[playerid][Work_ID] == COLLECTOR_WORK && CollectorIDx[playerid] != -1)
    {
        switch(CollectorAttachedObject[playerid])
        {
            case 0:
            {
                if(IsPlayerInRangeOfPoint(playerid, 5.0, 1362.6382,-1658.9019,13.4751) && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
                {
                    CheckPlayerCollector(playerid);
                    return 1;
                }
            }
            case 1, 3:
            {
                if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
                {
                    new idx = CollectorVehicleIDx[playerid], Float:x, Float:y, Float:z;
                    GetCoordBootVehicle(idx, x, y, z);
                    if(IsPlayerInRangeOfPoint(playerid, 2.5, x, y, z))
                    {
                        CheckPlayerCollector(playerid);
                        return 1;
                    }
                }
            }
            case 2:
            {
                new idx = CollectorIDx[playerid];
                if(IsPlayerInRangeOfPoint(playerid, 5.0, ATMInfo[idx][aPos][0], ATMInfo[idx][aPos][1], ATMInfo[idx][aPos][2]))
                {
                    CheckPlayerCollector(playerid);
                    return 1;
                }
            }
            case 4:
            {
                if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
                {
                    new idx = CollectorIDx[playerid];
                    if(IsPlayerInRangeOfPoint(playerid, 2.5, ATMInfo[idx][aPos][0], ATMInfo[idx][aPos][1], ATMInfo[idx][aPos][2]))
                    {
                        CheckPlayerCollector(playerid);
                        return 1;
                    }
                }
            }
            case 5:
            {
                if(IsPlayerInRangeOfPoint(playerid, 5.0, 1362.6382,-1651.1910,13.4759))
                {
                    new vehicleid = CollectorVehicleIDx[playerid];
                    if(!IsPlayerRentedVehicle(playerid, vehicleid)) return SendError(playerid, "������ ������������ �������� �� �������� ����� ������������ ������������ ���������.");
                    if(veh_info[vehicleid][v_npoType] != NPO_JOB && veh_info[vehicleid][v_npoId] != JOB_COLLECTOR && veh_info[vehicleid][v_temp_job] != JOB_COLLECTOR) return SendError(playerid, "������ ������������ �������� �� �������� ������������ ��������� ������������� �����.");
                    CheckPlayerCollector(playerid);
                    return 1;
                }
            }
        }
        return 1;
    }
    if(p_temp[playerid][Work_ID] == ELECTRIC_WORK && ElectricIDx[playerid] != -1)
    {
        new idx = ElectricIDx[playerid], vehicleid = ElectricVehicleIDx[playerid], Float:x, Float:y, Float:z;
        switch(ElectricAttachedObject[playerid])
        {
            case 0:
            {
                if(IsPlayerInRangeOfPoint(playerid, 5.0, PowerLinesInfo[idx][plPos][0], PowerLinesInfo[idx][plPos][1], PowerLinesInfo[idx][plPos][2]) && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
                {
                    CheckPlayerElectric(playerid);
                    return 1;
                }
            }
            case 1, 3:
            {
                if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
                {
                    GetCoordBootVehicle(vehicleid, x, y, z);
                    if(IsPlayerInRangeOfPoint(playerid, 2.5, x, y, z))
                    {
                        CheckPlayerElectric(playerid);
                        return 1;
                    }
                }
            }
            case 2, 4:
            {
                if(IsPlayerInRangeOfPoint(playerid, 5.0, 2076.8025,-2006.6671,13.5469))
                {
                    CheckPlayerElectric(playerid);
                    return 1;
                }
            }
            case 5:
            {
                if(IsPlayerInRangeOfPoint(playerid, 5.0, -65.1904,-1120.8057,1.0781))
                {
                    new vehicleid = ElectricVehicleIDx[playerid];
                    if(!IsPlayerRentedVehicle(playerid, vehicleid)) return SendError(playerid, "������ ������������ �������� �� �������� ����� ������������ ������������ ���������.");
                    if(veh_info[vehicleid][v_npoType] != NPO_JOB && veh_info[vehicleid][v_npoId] != JOB_ELECTRIC && veh_info[vehicleid][v_temp_job] != JOB_ELECTRIC) return SendError(playerid, "������ ������������ �������� �� �������� ������������ ��������� ������������� ����������.");
                    CheckPlayerElectric(playerid);
                    return 1;
                }
            }
        }
        return 1;
    }
    if(p_temp[playerid][Work_ID] == ROBBER_WORK && RobberIDx[playerid] != -1)
    {
        if(RobberAttachedObject[playerid] == 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
        {
            new idx = RobberIDx[playerid];
            if(IsPlayerInRangeOfPoint(playerid, 2.5, h_info[idx][h_enter][0], h_info[idx][h_enter][1], h_info[idx][h_enter][2]))
            {
                CheckPlayerRobbery(playerid);
                return 1;
            }
        }
        else if(RobberAttachedObject[playerid] == 1 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
        {
            new idx = RobberVehicleIDx[playerid], Float:x, Float:y, Float:z;
            GetCoordBootVehicle(idx, x, y, z);
            if(IsPlayerInRangeOfPoint(playerid, 2.5, x, y, z))
            {
                CheckPlayerRobbery(playerid);
                return 1;
            }
        }
        else if(RobberAttachedObject[playerid] == 2 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
            if(IsPlayerInRangeOfPoint(playerid, 5.0, 1751.4620,-2056.3772,13.8308))
            {
                new vehicleid = GetPlayerVehicleID(playerid);
                if(!IsPlayerRentedVehicle(playerid, vehicleid)) return SendError(playerid, "������ ������������ �������� �� �������� ����� ������������ ������������ ���������.");
                if(veh_info[vehicleid][v_npoType] != NPO_JOB || veh_info[vehicleid][v_npoId] != JOB_ROBBER) return SendError(playerid, "������ ������������ �������� �� �������� ������������ ��������� ������������� ����������.");
                CheckPlayerRobbery(playerid);
                return 1;
            }
        }
        return 1;
    }
    if(p_temp[playerid][Work_ID] == HUNTING_WORK && HuntingStatus[playerid] == true && HuntingIDx[playerid] != -1)
    {
        new idx = HuntingIDx[playerid];
        if(HuntingInfo[idx][hStatus] == HUNTING_DEER_STATUS_TAKE && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
        {
            new vehicleid = HuntingVehicleIDx[playerid], Float:x, Float:y, Float:z;
            GetCoordBootVehicle(vehicleid, x, y, z);
            if(IsPlayerInRangeOfPoint(playerid, 2.5, x, y, z))
            {
                SetPlayerHunting(playerid);
                return 1;
            }
        }
        return 1;
    }
    return 1;
}

public OnPlayerLeaveCheckpoint(playerid)
{
    return 1;
}

SetPlayerGPS(playerid, Float:fX, Float:fY, Float:fZ, Float:sizeGPS)
{
    SetPlayerCheckpoint(playerid, fX, fY, fZ, sizeGPS);
    p_temp[playerid][p_GPS] = true;
    if(p_info[playerid][p_settings][INTERFACE]) ShowTextDrawForPlayer(playerid, TD_ID_GPS);
}

CancelPlayerGPS(playerid)
{
    if(p_temp[playerid][TaxiArea] != -1)
    {
        DestroyDynamicArea(p_temp[playerid][TaxiArea]);
        p_temp[playerid][TaxiArea] = -1;
    }
    if(p_temp[playerid][panic_target_id] != INVALID_PLAYER_ID)
    {
        p_temp[playerid][panic_target_id] = INVALID_PLAYER_ID;
    }

    DisablePlayerCheckpoint(playerid);
    p_temp[playerid][p_GPS] = false;
    if(p_info[playerid][p_settings][INTERFACE]) HideTextDrawForPlayer(playerid, TD_ID_GPS);
}

public OnPlayerEnterRaceCheckpoint(playerid)
{
    new distance = floatround(GetPlayerDistanceFromPoint(playerid, AntiCheatPlayerPos[playerid][0], AntiCheatPlayerPos[playerid][1], AntiCheatPlayerPos[playerid][2]));
    new max_distance = 75;

    if(p_info[playerid][job] == JOB_PILOT)
    {
        if(IsPlayerInAnyVehicle(playerid))
        {
            new vehicleid = GetPlayerVehicleID(playerid);
            if(veh_info[vehicleid][v_npoId] == JOB_PILOT || veh_info[vehicleid][v_temp_job] == JOB_PILOT) max_distance = 80;
        }
    }

    if(distance > max_distance) return 1;

    new vehicleid = GetPlayerVehicleID(playerid);

    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);

    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
    {
        if(GetPlayerVirtualWorld(playerid) == 500)
