            mysql_tquery(con_bd, STRING_GLOBAL);

            SendAccess(playerid, "Вы оплатили все штрафы на сумму %d$.", amount);
            p_temp[playerid][ATM_STATUS] = false;
            return 1;
        }

        case 60:
        {
            if(!strlen(inputtext))
                return 1;
            new fix_listitem;
            if(sscanf(inputtext, "i", fix_listitem))
                return 1;
            if(!response)
            {
                if(p_info[playerid][bank] < fix_listitem)
                    return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                if(!(1 <= fix_listitem <= 5_000_000))
                    return SendError(playerid, "Вы не можете снять менее 1$ и более 5000000$.");
                new tax = GetTaxCount(playerid, fix_listitem, TAX_TAKE_BANK);
                SetPlayerMoney(playerid, fix_listitem-tax, true, "");
                p_info[playerid][bank] -= fix_listitem;
                MysqlUpdatePlayerInt(playerid, "bank", p_info[playerid][bank]);

                SendAccess(playerid, "Вы сняли с банковского счета: %d$. Всего: %d$. Налог: %d$.", fix_listitem, p_info[playerid][bank], tax);
                Log(LOG_player, INFO, "%s[%d](%s %s) снял деньги[%d$] с банка[%d$] в сумме %d$. Налог: %d$",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    p_info[playerid][cash], p_info[playerid][bank], fix_listitem, tax);

                SetFractionWarehouse(MAYOR_LS, fwMoney, tax);

            }
            else
            {
                if(p_info[playerid][cash] < fix_listitem)
                    return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                if(!(1 <= fix_listitem <= 5_000_000))
                    return SendError(playerid, "Вы не можете положить менее 1$ и более 5000000$.");
                new tax = GetTaxCount(playerid, fix_listitem, TAX_PUT_BANK);
                SetPlayerMoney(playerid,-fix_listitem, true, "");
                p_info[playerid][bank] += fix_listitem-tax;
                MysqlUpdatePlayerInt(playerid, "bank", p_info[playerid][bank]);
                SendAccess(playerid, "Вы положили на банковский счет: %d$. Всего: %d$. Налог: %d$.", fix_listitem, p_info[playerid][bank], tax);
                Log(LOG_player, INFO, "%s[%d](%s %s) положил деньги[%d$] с банка[%d$] в сумме %d$. Налог: %d$",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    p_info[playerid][cash], p_info[playerid][bank], fix_listitem, tax);

                SetFractionWarehouse(MAYOR_LS, fwMoney, tax);

            }

            if(p_info[playerid][bank] < 0)
            {
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s[%d] пополнял/снимал с банка %d$ | ЗАБАГАЛ ДЕНЕГИ В БАНКЕ(!!!)",  get_name(playerid), playerid, fix_listitem);
                SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `table_ban` (`Name_Admin`, `Name_Player`, `Ban_Data`, `Unban_Data`, `Ban_Reason`) VALUES ('System', '%e', NOW(), %d, 'Багоюз денег в банке')",
                get_name(playerid), timestamp + (30 * 86400));
                mysql_tquery(con_bd, STRING_GLOBAL);

                Kick(playerid);
            }
        }
        case 61:
        {
            if(response)
            {
                new fix_listitem;
                if(sscanf(inputtext, "u", fix_listitem)) return 1;
                if(fix_listitem == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не найден.");

                SetPVarInt(playerid, "ID_TRANS", fix_listitem);
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                Введите количество денег для перевода "I"%s:"W"\n\n\
