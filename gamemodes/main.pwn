                    SetCameraBehindPlayer(playerid);

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `style_styde` = %d, `style_progress` = %d WHERE `id` = %d",
                    p_info[playerid][style_styde], p_info[playerid][style_progress], p_info[playerid][ID]);
                    mysql_tquery(con_bd, STRING_GLOBAL);

                    SetTimerEx("FIX_GYM", 1100, 0, "i", playerid);
                }
                case B_ACCESSORIES:
                {
                    new count;
                    for(new i; i < MAX_ITEMS; i++)
                    {
                        if(ItemsInfo[i][iAccessoriesType] != listitem+1) continue;
                        p_temp[playerid][p_listitem][count] = i;
                        count++;
                    }
                    p_temp[playerid][p_listitem_int] = count;
                    SetPVarInt(playerid, "SelectAccessoriesType", listitem);

                    p_temp[playerid][shop_id] = 0;
                    ShowTextDrawForPlayer(playerid, TD_ID_SHOP);

                    PreviewShopAccessories(playerid);

                    if(GetPlayerAttachedCostume(playerid) != -1)
                    {
                        SendInfo(playerid, "С Вас снят костюм, он будет надет после выхода из магазина.");
                        TakePlayerAttachedCostume(playerid, GetPlayerAttachedCostume(playerid), false);
                    }
                    else RemovePlayerAccessories(playerid, false);
                }
                case B_HOTEL:
                {
