    return 1;
}

forward OnMysqlDefragmentation(type_id);
public OnMysqlDefragmentation(type_id)
{
    new rows = cache_num_rows();
    if(!rows) return 1;
    new temp_id, time = GetTickCount();
    switch(type_id)
    {
        case 0: //house
        {
            for(new i; i < rows; i++)
            {
                cache_get_value_index_int(i, 0, temp_id);
                if(i+1 != temp_id)
                {
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof STRING_GLOBAL, "UPDATE `house` SET `h_mysql_id` = %d WHERE `h_mysql_id` = %d", i+1, temp_id);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                }
            }
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof STRING_GLOBAL, "ALTER TABLE `house` AUTO_INCREMENT = %d", rows+1);
            mysql_tquery(con_bd, STRING_GLOBAL);

            mysql_tquery(con_bd,"SELECT * FROM `house`", "load_house", ""); // �������� �����;
        }
        case 1: //bizz
        {
            for(new i; i < rows; i++)
            {
                cache_get_value_index_int(i, 0, temp_id);
                if(i+1 != temp_id)
                {
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof STRING_GLOBAL, "UPDATE `biz` SET `b_mysql_id` = %d WHERE `b_mysql_id` = %d", i+1, temp_id);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                }
            }
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof STRING_GLOBAL, "ALTER TABLE `biz` AUTO_INCREMENT = %d", rows+1);
            mysql_tquery(con_bd, STRING_GLOBAL);

            mysql_tquery(con_bd,"SELECT * FROM `biz`", "load_bizz",""); // �������� ��������;
            LoadDatabaseInfo();
        }
    }
    printf("Defragmentation: [%s] �� %d ms", !type_id  ? "HOUSE" : "BIZ",  GetTickCount()-time);
    return 1;
}

CMD:defregment(playerid, params[])
{
    if(SRV_ID || p_info[playerid][admin] < 10) return 1;
    new type_id = strval(params);
    if(!strlen(params) || !(0 <= type_id <= 1))
        return SendInfo(playerid, "/defregment 1 - house / 2 - bizz");
    mysql_tquery(con_bd, !type_id ? "SELECT `h_mysql_id` FROM `house`" : "SELECT `b_mysql_id` FROM `biz`", "OnMysqlDefragmentation", "i", type_id); // ��� �����/��������;
    SendInfo(playerid, "Defregmentation Success - next step: RESTART Server");
    return 1;
}
alias:defregment("defragmentation");


forward ShowInfoPromocode(playerid);
