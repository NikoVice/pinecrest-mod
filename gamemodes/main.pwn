        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `edit_advertise` SET `day_7` = `day_7` + '1' WHERE `user_id` = %d",
        p_info[playerid][ID]);
        mysql_tquery(con_bd, STRING_GLOBAL);
    }
    return 1;
}
