            SendInfo(playerid, "Пост '%s' отмечен на GPS навигаторе.", post_info[listitem][Name]);
            return 1;
        }
        case D_SURRENDER:
        {
            if(!response) return 1;
            if(p_info[playerid][wanted] > 4) p_info[playerid][jail] = 5;
            else p_info[playerid][jail] = GetPlayerPositionCity(playerid);
            p_info[playerid][jail_time] += ((600*p_info[playerid][wanted])/100)*80;
            p_info[playerid][wanted] = 0;
            SetPlayerWantedLevel(playerid, p_info[playerid][wanted]);
            SendAccess(playerid, "Вы добровольно сдались. Ваш срок уменьшен на 20 процентов.");
            SendInfo(playerid, "Информация о сроке: /time");
            return 1;
        }
        case D_SUSPECT_MENU:
        {
            if(!response) {
                p_temp[playerid][p_listitem][5] = -1;
                return 1;
            }
            p_temp[playerid][p_listitem][6] = listitem;
            ShowPlayerDialog(playerid, D_SUSPECT_REASON, DIALOG_STYLE_LIST, ""I"Выберите причину", suspect_player[listitem][suspect_name_reason], "Выбрать", "Назад");
            return 1;
        }
        case D_SUSPECT_REASON:
        {
            new targetid = p_temp[playerid][p_listitem][5],
                idx = p_temp[playerid][p_listitem][6];
            p_temp[playerid][p_listitem][5] =
            p_temp[playerid][p_listitem][6] = -1;
            if(!response) return 1;
            if(suspect_player[idx][suspect_level][listitem] == -1) return 1;

            if(GetFractionWarehouse(p_info[playerid][member], fwMate) > 25)
            {
                SetFractionWarehouse(p_info[playerid][member], fwMate, -25);
            }

            p_info[targetid][wanted] += suspect_player[idx][suspect_level][listitem];
            if(p_info[targetid][wanted] > 6) p_info[targetid][wanted] = 6;
            SetPlayerWantedLevel(targetid, p_info[targetid][wanted]);

            SendAccess(playerid, "Вы объявили %s [%d] в розыск. Причина: %s", get_name(targetid), targetid, suspect_player[idx][suspect_name_folder]);
            SendInfo(targetid, "%s [%d] объявил Вас в розыск. Причина: %s", get_name(playerid), playerid, suspect_player[idx][suspect_name_folder]);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] выдал розыск %s [%d]. Уровень розыска: %d. Причина: %s", get_name(playerid), playerid, get_name(targetid), targetid, p_info[targetid][wanted], suspect_player[idx][suspect_name_folder]);
            SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] выдал розыск %s [%d]. Уровень розыска: %d. Причина: %s", get_name(playerid), playerid, get_name(targetid), targetid, p_info[targetid][wanted], suspect_player[idx][suspect_name_folder]);
            SendAdminMessage(0xA3A3A3FF, STRING_GLOBAL);

            if(p_info[targetid][p_settings][PACIFIST_MODE])
                PacifistModeToggle(targetid, 0);

            p_info[playerid][fracdata][3]++;
            SaveFracData(playerid);
            CheckPlayerMission(playerid, POLICE_SU);
            UpdateFamilyLevel(playerid);

            p_info[playerid][ftop_su]++;
            MysqlUpdatePlayerInt(playerid, "ftop_su", p_info[playerid][ftop_su]);

            if(p_info[playerid][p_settings][ROLEPLAY] == 1)
            {
                DoAction(playerid, "На поясном держателе висит портативная рация.");
                MeAction(playerid, "отцепив портативную рацию связался с диспетчером, передал все нарушения ему...");
                MeAction(playerid, "...после чего получил от диспетчера информацию");
            }
            return 1;
        }

