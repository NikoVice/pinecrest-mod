CMD:fdoor(playerid, params[])
{
    if(p_info[playerid][rang] < 10) return SendError(playerid, "� ��� ��� �������.");
    new member_id = p_info[playerid][leader];
    if(GetFactionCategory(p_info[member_id][member]) != FACTION_CATEGORY_GANG || GetFactionCategory(p_info[member_id][member]) != FACTION_CATEGORY_SNN)
    {
        new member_id = p_info[playerid][leader];
        SetFractionSettings(member_id, fDoorStatus, !GetFractionSettings(member_id, fDoorStatus));
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] %s ����� �������.", get_name(playerid), playerid, GetFractionSettings(member_id, fDoorStatus) ? "������" : "������");
        SendFractionMessage(member_id, 0x33CC66FF, STRING_GLOBAL);
        callcmd::fraction(playerid, "/0");
    }
    return 1;
}


CMD:fraction(playerid, params[])
