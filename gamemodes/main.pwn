            DuelData[owner_duel][dCommand1][0] = owner_duel;
            p_temp[owner_duel][DuelID] = owner_duel;
            SendAccess(owner_duel, "Вы создали дуэль.");

            // Очистка значений для второго игрока;
            DuelData[playerid][dGun] = 24;
            DuelData[playerid][dRound] = 3;
            DuelData[playerid][dBank] = 1000;
            DuelData[playerid][dGameState] =
            DuelData[playerid][dMap] =
            DuelData[playerid][dFamilyStatus] = 0;
            for(new i; i < 10; i++)
