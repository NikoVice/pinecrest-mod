                    ShowPlayerDialog(playerid, D_AUCTION_BIZZ_BET, DIALOG_STYLE_INPUT, ""I"������� ��������", STRING_GLOBAL, "�����", "GPS");
                    return 1;
                }
                if(fix_listitem < b_info[b][b_auction_bet]+(b_info[b][b_auction_bet]/10) || fix_listitem > p_info[playerid][cash])
                {
                    if(fix_listitem > p_info[playerid][cash]) SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, ""W"\
                    �������� �������: %s\n\
                    ��� �������: %s\n\n\
                    ������� ������: ������\n\
                    ���� ������ ������ ���� ������ ������� �� 10 ���������.\n\
                    ���� ���� ������ ��������, ��� �������� 90 ��������� �� ����� ������.\n\n\
                    �� ����� ��������: %d ���(-�/-��)\n\n\
                    ������� ������:", b_info[b][_name], bizz_type_name[b_info[b][_tip]], b_info[b][b_auction_time]);//, b_info[b][b_auction_bet]);
                    ShowPlayerDialog(playerid, D_AUCTION_BIZZ_BET, DIALOG_STYLE_INPUT, ""I"������� ��������", STRING_GLOBAL, "�����", "GPS");
                    return 1;
                }

                for(new i = 0; i < totalbizz; i++)
                {
                    if(b_info[i][b_mysql_id] == INVALID_MYSQL_ID) continue;
                    if(b_info[i][b_auction_user_id] == p_info[playerid][ID]) return SendError(playerid, "� ��� ��� ����������� ������ �� ���� �� ��������.");
                }

