new panels, tires, engine,lights,alarm,doors,bonnet,boot,objective;

SetVehicleParamsVEx(vehicle, v_engines, v_lights, v_alarm, v_door, v_bonnet, v_boot, v_objective)
{
    if(vehicle == INVALID_VEHICLE_ID) return 1;
    veh_info[vehicle][v_engine] = v_engines;
    veh_info[vehicle][v_lock] = v_door;
    veh_info[vehicle][v_light] = v_lights;
    GetVehicleParamsEx (vehicle, engine,lights,alarm,doors,bonnet,boot,objective);
    engine = v_engines;
    doors = v_door;
    lights = v_lights;
    SetVehicleParamsEx(vehicle,  engine, lights, v_alarm, doors, v_bonnet, v_boot, v_objective);
    return 1;
}

