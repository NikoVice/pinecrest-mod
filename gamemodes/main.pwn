forward ShowDPromo(playerid);
public ShowDPromo(playerid)
{
    new rows = 0;
    cache_get_row_count(rows);
    if(0 == rows)
        return SendError(playerid, "Действующих промокодов не найдено.");

    new
        code[24],
        priztext[24],
        string[100],
        typepriz,
        amountpriz,
        activate;

    STRING_GLOBAL[0] = EOS;
    strcat(STRING_GLOBAL, "{F44607}№:\t{F49E07}Промокод:\t{F4E807}Тип приза:\t{99F407}Количество:\t{4BE8B6}Число активаций:\n");

    for(new i; i < rows; i++)
    {
        cache_get_value_name(i, "name", code, 24);
        cache_get_value_name_int(i, "typepriz", typepriz);
        cache_get_value_name_int(i, "amountpriz", amountpriz);
        cache_get_value_name_int(i, "activate", activate);

        switch(typepriz)
        {
            case 1: priztext = "Опыт(EXP)", format(string, sizeof string, "%d шт.", amountpriz);
            case 2: priztext = "Игр. валюта", format(string, sizeof string, "%d$.", amountpriz);
            case 3: priztext = "Pinecrest Money", format(string, sizeof string, "%d FM.", amountpriz);
        }

        format(string,sizeof(string),"{F44607}%d  \t{F49E07}%s  \t{F4E807}%s  \t{99F407}%s  \t{4BE8B6}%d\n", i+1, code, priztext,string, activate);
        strcat(STRING_GLOBAL, string);
    }

    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Список действующих промокодов", STRING_GLOBAL, "Закрыть", "");
    return 1;
}
