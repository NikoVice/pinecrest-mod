        case D_HELP_START_JOB:
        {
            if(!response) return ShowPlayerDialog(playerid, D_HELP, DIALOG_STYLE_LIST, ""I"Помощь по игре", ""I"[1]"W" Что же такое SA-MP Mobile?\n"I"[2]"W" Что такое Pinecrest Mobile и в чем его плюсы?\n"I"[3]"W" F.A.Q\n"I"[4]"W" Что такое RolePlay и в чем его суть?\n"I"[5]"W" Термины и понятия\n"I"[6]"W" Почему важно использовать ресурсы Pinecrest Mobile?\n"I"[7]"W" Как правильно начать игру и играть дальше?\n"I"[8]"W" Как получить помощь в игре?\n"I"[9]"W" Различия фракций и общественных работ\n"I"[10]"W" Кто такие лидеры и админы?\n"I"[11]"W" Развлечения на сервере\n"I"[12]"W" Первоначальные работы\n"I"[13]"W" Основные работы\n"I"[14]"W" Рыбалка\n"I"[15]"W" Охота\n"I"[16]"W" Ограбление дома\n"I"[17]"W" Ограбление банка\n"I"[18]"W" Ограбление АЗС\n"I"[19]"W" Майнинг ферма\n"I"[20]"W" Биржа труда\n"I"[21]"W" Battle Pass\n"I"[22]"W" Подпольное помещение\n"I"[23]"W" Ежедневные награды\n"I"[24]"W" Ларцы\n"I"[25]"W" Автосалоны\n"I"[26]"W" Аренда транспорта\n"I"[27]"W" Авторынок\n"I"[28]"W" Аукцион контейнеров", "Далее", "Отмена");
            switch(listitem)
