                    ShowPlayerDialog(playerid, D_PLAYER_SETTINGS_ACCOUNT, DIALOG_STYLE_TABLIST, ""I"Настройки аккаунта", STRING_GLOBAL, "Выбрать", "Отмена");
                }
                case 1: // Settings Personage
                {
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
                        "I"[1]"W" Настройки стилей\t \n\
                        "I"[2]"W" Использовать скин \t"I"%s\n\
                        "I"[3]"W" Воспроизведение музыкального проигрывателя\t"I"%s\n\
                        "I"[4]"W" Воспроизведение автомобильной акустики\t"I"%s\n\
                        "I"[5]"W" Авто-репорт о ДМ \t"I"%s\n\
                        "I"[6]"W" Автоматические RolePlay отыгровки \t"I"%s\n\
                        "I"[7]"W" Режим пацифиста \t"I"%s",
                        p_info[playerid][p_settings][SKIN_DEFAULT] == 0 ? "Личный" : "Семейный",
                        p_info[playerid][p_settings][STATUS_BOOMBOX] == 0 ? "Включено" : "Выключено",
                        p_info[playerid][p_settings][STATUS_RADIO] == 0 ? "Включено" : "Выключено",
                        p_info[playerid][p_settings][STATUS_REPORT_DM] == 0 ? "Включено" : "Выключено",
                        p_info[playerid][p_settings][ROLEPLAY] == 0 ? "Выключены" : "Включены",
                        p_info[playerid][p_settings][PACIFIST_MODE] == 0 ? "Выключен" : "Включен");
                    ShowPlayerDialog(playerid, D_PLAYER_SETTINGS_PERSONAGE, DIALOG_STYLE_TABLIST, ""I"Настройки персонажа", STRING_GLOBAL, "Выбрать", "Отмена");
                }
                case 2: // Settings Graphics
                {
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
                        "I"[1]"W" Damage Informer \t"I"%s\n\
                        "I"[2]"W" Новые интерфейсы \t"I"%s\n\
                        "I"[3]"W" Настройки логотипа\t \n\
                        "I"[4]"W" Настройки отображения худа\n\
                        "I"[5]"W" Настройки телефона\n\
                        "I"[6]"W" Отображение названий семей \t"I"%s\n\
                        "I"[7]"W" Отображение описание персонажей \t"I"%s\n\
                        "I"[8]"W" Настройки прицела\n\
                        "I"[9]"W" Отображние нового транспорта \t"I"%s\n\
                        "I"[10]"W" Отображние новых скинов \t"I"%s\n\
                        "I"[11]"W" Отображние акксесуаров/костюмов на игроках \t"I"%s\n\
                        "I"[12]"W" Отображние номеров на т/с \t"I"%s",
                        p_info[playerid][p_settings][STATUS_DAMAGE] == 0 ? "Включено" : "Выключено",
                        p_info[playerid][p_settings][INTERFACE] == 0 ? "Выключены" : "Включены",
                        p_info[playerid][p_settings][FAMILY_LABEL] == 1 ? "Включено" : "Выключено",
                        p_info[playerid][p_settings][PAME_LABEL] == 1 ? "Включено" : "Выключено",
                        p_info[playerid][p_settings][REAL_CARS] == 1 ? "Включено" : "Выключено",
                        p_info[playerid][p_settings][REAL_SKINS] == 1 ? "Включено" : "Выключено",
                        p_info[playerid][p_settings][ACC_VISIBLE] == 1 ? "Включено" : "Выключено",
                        p_info[playerid][p_settings][NUMBER_VEHICLES] == 1 ? "Включено" : "Выключено");
                    ShowPlayerDialog(playerid, D_PLAYER_SETTINGS_GRAPHICS, DIALOG_STYLE_TABLIST, ""I"Настройки отображения и графики", STRING_GLOBAL, "Выбрать", "Отмена");
                }
                case 3: // Settings client
                {
                    ShowPlayerSettingsClient(playerid);
                    return 1;
                }
                case 4: // Settings chat
                {
                    ShowPlayerSettingsChat(playerid);
                    return 1;
                }
            }
            return 1;
        }
        case D_PLAYER_SETTINGS_ACCOUNT:
        {
            if(!response) return ShowPlayerSettings(playerid);
            switch(listitem)
            {
                case 0:
                {
                    if(strlen(p_info[playerid][mail]))
                    {
                        if(!p_info[playerid][email_confirmed])
                        {
                            SendCodeMail(playerid, p_info[playerid][mail]);
                            ShowPlayerDialog(playerid, D_EMAIL_CONFIRM, DIALOG_STYLE_INPUT, ""I"E-Mail", ""W"Введите код высланный Вам на Email адрес:", "Далее", "Отмена");
                        }
                        else
                            ShowPlayerDialog(playerid, D_EMAIL_SELECT_TYPE, DIALOG_STYLE_LIST, ""I"E-Mail", ""I"[1]"W" Отвязать почту\n"I"[2]"W" Привязать новую почту", "Далее", "Отмена");
                    }
                    else
                    {
                        SetPVarInt(playerid, #PROTECTION_DIALOG, 1);
                        ShowPlayerDialog(playerid, D_EMAIL_NEW_LINK, DIALOG_STYLE_INPUT, ""I"E-Mail", ""W" Чтобы предотвратить потерю Вашего аккаунта, мы хотим\n\
                            защитить его с помощью привязки к электронной почте.\n\
                            Это поможет не допустить попытку взлома или утери данных\n\
                            аккаунта.\n\n\
                            "I"Вводите настоящую, ее надо будет подтвердить, подходит только Google/Yandex.", "Далее", "Отмена");
                    }
                }
                case 1: ShowPlayerDialog(playerid, D_CHANGE_PASS, DIALOG_STYLE_INPUT, ""I"Изменить пароль", ""W"Введите Ваш действующий пароль:", "Далее", "Отмена");
                case 2: Google_ShowMainPanel(playerid);
                case 3:
                {
                    if(!ServerInfo[VKSecurity])
                        return SendError(playerid, "VK защита отключена администрацией.");
                    if(IsVKConfirmed(playerid))
                        VK_ShowMainPanel(playerid);
                    else
                    {
                        ShowPlayerDialog(playerid, D_VK_CONFIRMATION, DIALOG_STYLE_MSGBOX, ""I"Защита ВКонтакте",!"{ffffff}Данный вид защиты Вашего игрового аккаунта позволит комфортно подтверждать/блокировать авторизации в Ваш игровой профиль.\n\n\
                            {00FF7F}+ {ffffff}Комфортное подтверждение через личные сообщения сообщества с помощью кнопок.\n\
                            {00FF7F}+ {ffffff}Возможность блокировки входа потенциального злоумышленника\n\
                            {00FF7F}+ {ffffff}Долгосрочная история входов.\n\
                            {00FF7F}+ {ffffff}Если хотите продолжить привязку нажмите \"Далее\"\n\
                            В ином случае просто нажмите \"Отмена\"", "Далее", "Отмена");
                    }
                }
                case 4:
                {
                    if(!ServerInfo[TGSecurity])
                        return SendError(playerid, "Telegram защита отключена администрацией.");
                    if(IsTGConfirmed(playerid))
                        TG_ShowMainPanel(playerid);
                    else
                    {
                        ShowPlayerDialog(playerid, D_TG_CONFIRMATION, DIALOG_STYLE_MSGBOX, ""I"Защита Telegram",!"{ffffff}Данный вид защиты Вашего игрового аккаунта позволит комфортно подтверждать/блокировать авторизации в Ваш игровой профиль.\n\n\
                            {00FF7F}+ {ffffff}Комфортное подтверждение через личные сообщения сообщества с помощью кнопок.\n\
                            {00FF7F}+ {ffffff}Возможность блокировки входа потенциального злоумышленника\n\
                            {00FF7F}+ {ffffff}Долгосрочная история входов.\n\
                            {00FF7F}+ {ffffff}Если хотите продолжить привязку нажмите \"Далее\"\n\
                            В ином случае просто нажмите \"Отмена\"", "Далее", "Отмена");
                    }
                }
                case 5:
                {
                    if(p_info[playerid][free_change_nick] > timestamp)
                        return SendError(playerid, "Бесплатная смена никнейма разрешена 1 раз в 30 дней.");
                    if(GetPVarInt(playerid, "CHANGE_NICK:FLOOD") > timestamp) 
                        return SendError(playerid, "Отправлять заявление на смену никнейма можно раз в 5 минут.");
                    SetPVarInt(playerid, "CHANGE_NICK:FREE", 1);
                    ShowPlayerDialog(playerid, D_CHANGE_NICK, DIALOG_STYLE_INPUT, ""I"Изменить ник", 
                        ""W"Если Вы по каким-то причинам хотите сменить свой никнейм, введите новый в поле ниже:\n\n\
                        "I"Примечания:"W" Имя должно соответствовать правилам сервера (формат Nick_Name), состоять\n\
                        только из букв, не являться оскорбляющим).", "Далее", "Отмена");
                }
            }
            return 1;
        }
        case D_GOOGLE_AUTH_MAIN_PANEL:
        {
            if(!response) return ShowPlayerSettings(playerid);
            if(strlen(p_info[playerid][google_code]) < 5)
                return 1;
            switch(listitem) {
                case 0: Google_ShowMainPanel(playerid);
                case 1:
                {
                    p_info[playerid][google_auth] = !p_info[playerid][google_auth];
                    MysqlUpdatePlayerInt(playerid, "google_auth", p_info[playerid][google_auth]);
                    SendAccess(playerid, "Вы сменили тип защиты на %s.", p_info[playerid][google_auth] == 0 ? "запрашивать всегда" : "запрашивать при смене IP адреса");
                    return Google_ShowMainPanel(playerid);
                }
                case 2:
                    return ShowPlayerDialog(playerid, D_GOOGLE_AUTH, DIALOG_STYLE_INPUT, ""I"Google Authenticator", ""W"Что бы отключить защиту, введите одноразовый код из приложения Google Authenticator:\n\n{"#cLIGHTRED"}Обратите внимание! Код состоит из цифр.", "Далее", "");
            }
            return 1;
        }
        case D_PLAYER_SETTINGS_PERSONAGE:
        {
            if(!response) return ShowPlayerSettings(playerid);
            switch(listitem)
            {
                case 0:
                {
                    ShowPlayerDialog(playerid, D_STYLE, DIALOG_STYLE_LIST, ""I"Настройка стилей", ""I"[1]"W" Стиль походки\n"I"[2]"W" Стиль разговора\n"I"[3]"W" Стиль боя", "Далее", "Отмена");
                    return 1;
                }
                case 1:
                {
                    p_info[playerid][p_settings][SKIN_DEFAULT] = !p_info[playerid][p_settings][SKIN_DEFAULT];
                    UpdatePlayerSetting(playerid);
                    SetPlayerSkinEx(playerid);
                    if(p_info[playerid][p_settings][SKIN_DEFAULT]) SendInfo(playerid, "Если на Вас не появился семейный скин то возможно его нет для Вашего ранга.");
                    return 1;
                }
                case 2:
                {
                    p_info[playerid][p_settings][STATUS_BOOMBOX] = !p_info[playerid][p_settings][STATUS_BOOMBOX];
                    if(p_info[playerid][p_settings][STATUS_BOOMBOX] == 1)
                    {
                        if(GetPVarInt(playerid, "pAudioStream"))
                        {
                            DeletePVar(playerid, "pAudioStream");
                            StopAudioStreamForPlayer(playerid);
                        }
                    }
                    SendAccess(playerid, "Вы %s воспроизведение музыкального проигрывателя.", p_info[playerid][p_settings][STATUS_BOOMBOX] == 0 ? "включили" : "выключили");
                    return 1;
                }
                case 3:
                {
                    p_info[playerid][p_settings][STATUS_RADIO] ^= 1;
                    if(p_info[playerid][p_settings][STATUS_RADIO] == 1)
                    {
                        if(GetPVarInt(playerid, "UseMusicVehicle"))
                        {
                            DeletePVar(playerid, "UseMusicVehicle");
                            StopAudioStreamForPlayer(playerid);
                        }
                    }
                    SendAccess(playerid, "Вы %s воспроизведение автомобильной акустики.", p_info[playerid][p_settings][STATUS_RADIO] == 0 ? "включили" : "выключили");
                    UpdatePlayerSetting(playerid);
                    return 1;
                }
                case 4:
                {
                    p_info[playerid][p_settings][STATUS_REPORT_DM] ^= 1;
                    SendAccess(playerid, "Вы %s Авто-оповещение администрации о DM.", p_info[playerid][p_settings][STATUS_REPORT_DM] == 0 ? "включили" : "выключили");
                    UpdatePlayerSetting(playerid);
                    return 1;
                }
                case 5:
                {
                    p_info[playerid][p_settings][ROLEPLAY] ^= 1;
                    SendAccess(playerid, "Вы %s автоматические RolePlay отыгровки.", p_info[playerid][p_settings][ROLEPLAY] == 0 ? "выключили" : "включили");
                    UpdatePlayerSetting(playerid);
                    return 1;
                }
                case 6: callcmd::pacifist(playerid, "/0");
            }
            return 1;
        }
        case D_PLAYER_SETTINGS_GRAPHICS:
        {
            if(!response) return ShowPlayerSettings(playerid);
            switch(listitem)
            {
                case 0:
                {
                    p_info[playerid][p_settings][STATUS_DAMAGE] ^= 1;
                    SendAccess(playerid, "Вы %s Damage Informer.", p_info[playerid][p_settings][STATUS_DAMAGE] == 0 ? "включили" : "выключили");
                    UpdatePlayerSetting(playerid);
                    return 1;
                }
                case 1:
                {
                    if(IsTDVisible(playerid) != -1) return 1;
                    HideTextDrawForPlayer(playerid, TD_ID_SPEEDOMETER);
                    p_info[playerid][p_settings][INTERFACE] ^= 1;
                    ShowTextDrawForPlayer(playerid, TD_ID_SPEEDOMETER);
                    SendAccess(playerid, "Вы изменили тип интерфейсов на %s.", p_info[playerid][p_settings][INTERFACE] == 0 ? "стандартный" : "инновационный");
                    UpdatePlayerSetting(playerid);

                    Logotype_Time(playerid);

                    Interface_WarningActual(playerid);
                    return 1;
                }
                case 2: ShowPlayerDialog(playerid, D_LOGO_SELECT, DIALOG_STYLE_LIST, ""I"Настройки логотипа", ""I"[1] "W"Стандартное\n"I"[2] "W"Стиль 1\n"I"[2] "W"Стиль 2", "Выбрать", "Отмена");
                case 3: ShowPlayerSettingsHud(playerid);
                case 4: callcmd::changephone(playerid, "/0");
                case 5: callcmd::familytags(playerid, "/0");
                case 6: callcmd::pametags(playerid, "/0");
                case 7:
                {
                    if(GetPlayerGameVersion(playerid) < CLIENT_VERSION_052021)
                        return SendError(playerid, "Вы либо с ПК либо на Вашей версии клиента это не доступно.");
                    STRING_GLOBAL = ""I"[1] "W"Стандартное\n";
                    for(new i = 1; i < 15; i++)
                    {
                        f(STRING_GLOBAL, "%s"I"[%d] "W"Стиль %d\n", STRING_GLOBAL, i+1, i);
                    }
                    ShowPlayerDialog(playerid, D_CROSSHAIR_SELECT, DIALOG_STYLE_LIST, ""I"Настройки прицела", STRING_GLOBAL, "Выбрать", "Отмена");
                }
                case 8: callcmd::vehicletags(playerid);
                case 9: callcmd::skintags(playerid);
                case 10: callcmd::acctags(playerid);
                case 11: callcmd::vehnumtags(playerid);
            }
            return 1;
        }
        case D_CROSSHAIR_SELECT:
        {
            if(!response) return 1;
            if(p_info[playerid][p_settings][CROSSHAIR_ID] == listitem) return SendError(playerid, "Уже выбран данный прицел.");
            p_info[playerid][p_settings][CROSSHAIR_ID] = listitem;

            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "crosshair_%d", listitem);
            SendChangeAim(playerid, STRING_GLOBAL);

            UpdatePlayerSetting(playerid);
            return 1;
        }
        case D_LOGO_SELECT:
        {
            if(!response) return 1;
            if(p_info[playerid][p_settings][LOGO_ID] == listitem) return SendError(playerid, "Уже выбран данный логотип.");
            if(listitem != 0 && !p_info[playerid][p_settings][INTERFACE]) return SendError(playerid, "Нужно включить новые интерфейсы.");
            p_info[playerid][p_settings][LOGO_ID] = listitem;
            Logotype_Show(playerid);

            UpdatePlayerSetting(playerid);
            if(listitem != 0) Interface_WarningActual(playerid);
            return 1;
        }
        case D_DONATION:
        {
            if(!response) return callcmd::menu(playerid, "/0");
            switch(listitem)
            {
                case 0: ShowPlayerDialog(playerid, D_DONATION_MONEY, DIALOG_STYLE_INPUT, ""I"Пожретвование", ""W"Введите количество денег, которое Вы хотите пожертвовать:", "Далее", "Отмена");
                case 1:
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name`, `count` FROM `donation` WHERE `count` != 0 ORDER BY `count` DESC");
                    new Cache:result = mysql_query(con_bd, STRING_GLOBAL);
                    new Name_tmp[32], count;
                    new rows;
                    cache_get_row_count(rows);
                    if(rows)
                    {
                        STRING_GLOBAL[0] = EOS;
                        for(new i; i < 25; i ++)
                        {
                            if(i >= rows) break;
                            cache_get_value_name(i, "name", Name_tmp, MAX_PLAYER_NAME);
                            cache_get_value_name_int(i, "count", count);
                            if(i == 0) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"%s[%d] %s - %d$\n", STRING_GLOBAL, i+1, Name_tmp, count);
                            else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s[%d] %s - %d$\n", STRING_GLOBAL, i+1, Name_tmp, count);
                        }
                        if(!ShowPlayerDialog(playerid, D_DONATION_BACK, DIALOG_STYLE_MSGBOX, ""I"Самые щедрые", STRING_GLOBAL, "Далее", "Отмена")) return SendError(playerid, "Ничего не найдено.");
                    }
                    else SendError(playerid, "Ничего не найдено.");
                    cache_delete(result);
                    return 1;
                }
            }
        }
        case D_DONATION_MONEY:
        {
            if(!response) return ShowPlayerDialog(playerid, D_DONATION, DIALOG_STYLE_LIST, ""I"Пожертвования", ""I"[1]"W" Пожертвовать\n"I"[2]"W" Самые щедрые", "Далее", "Отмена");
            new count;
            if(sscanf(inputtext, "i", count)) return SendError(playerid, "Вы ничего не ввели.");
            if(count < 1) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            if(p_info[playerid][cash] < count) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            SetPlayerMoney(playerid, -count, true, "пожертвовал в личном меню");
            SendAccess(playerid, "Вы пожертвовали %d$.", count);

            //lastlog(DONATION, "пожертвовал в личном меню", -1, playerid, playerid, -count);
            // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) пожертвовал в личном меню %d$
            Log(LOG_player, INFO, "%s[%d](%s %s) пожертвовал в личном меню %d$",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", count);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id` FROM `donation` WHERE `id` = %d LIMIT 1",
            p_info[playerid][ID]);
            new Cache:result = mysql_query(con_bd, STRING_GLOBAL);

            if(cache_num_rows() != 0)
            {
                new baseid;
                cache_get_value_name_int(0, "id", baseid);

                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `donation` SET `timestamp` = NOW(), `count` = `count` + %d WHERE `id` = %d",
                count, baseid);
                mysql_tquery(con_bd, STRING_GLOBAL);
            }
            else
            {
                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `donation` (`name`, `count`) VALUES ('%e', '%d')",
                get_name(playerid), count);
                mysql_tquery(con_bd, STRING_GLOBAL);
            }
            cache_delete(result);
            return 1;
        }
        case D_DONATION_BACK:
        {
            if(!response) return ShowPlayerDialog(playerid, D_DONATION, DIALOG_STYLE_LIST, ""I"Пожертвования", ""I"[1]"W" Пожертвовать\n"I"[2]"W" Самые щедрые", "Далее", "Отмена");
        }
        case D_STYLE:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0: callcmd::walkstyle(playerid, "/0");
                case 1:
                {
                    ShowPlayerDialog(playerid, D_STYLE_CHAT, DIALOG_STYLE_LIST, ""I"Стиль разговора", "\
                        "I"[1]"W" Стандартный\n\
                        "I"[2]"W" Недоверяющий\n\
                        "I"[3]"W" Нееодобряющий\n\
                        "I"[4]"W" Настойчивый\n\
                        "I"[5]"W" Позитивный\n\
                        "I"[6]"W" Неуверенный", "Далее", "Отмена");
                }
                case 2:
                {
                    if(GetPVarInt(playerid, "GymTrainingStyde")) return SendError(playerid, "Во время тренировки нельзя изменить стиль боя.");
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""I"[1]"W" Боксерский (%s)\n"I"[2]"W" Кунг-Фу (%s)\n"I"[3]"W" Тхеквондо (%s)\n"I"[4]"W" Стандартный ({33CC66}Изучен"W")", \
                    (!p_info[playerid][pstyle][1]) ? ("{"#cLIGHTRED"}Не изучен"W"") : ("{33CC66}Изучен"W""),
                    (!p_info[playerid][pstyle][2]) ? ("{"#cLIGHTRED"}Не изучен"W"") : ("{33CC66}Изучен"W""),
                    (!p_info[playerid][pstyle][3]) ? ("{"#cLIGHTRED"}Не изучен"W"") : ("{33CC66}Изучен"W""));
                    ShowPlayerDialog(playerid, D_STYLE_FIGHT, DIALOG_STYLE_LIST, ""I"Стиль боя", STRING_GLOBAL, "Далее", "Отмена");
                }
            }
            return 1;
        }
        case D_STYLE_CHAT:
        {
            if(!response) return ShowPlayerDialog(playerid, D_STYLE, DIALOG_STYLE_LIST, ""I"Настройка стилей", ""I"[1]"W" Стиль походки\n"I"[2]"W" Стиль разговора\n"I"[3]"W" Стиль боя", "Далее", "Отмена");
            if(p_info[playerid][p_settings][STYLE_CHAT_ID] == listitem)
            {
                SendError(playerid, "У Вас уже установлен этот стиль разговора.");
                ShowPlayerDialog(playerid, D_STYLE_CHAT, DIALOG_STYLE_LIST, ""I"Стиль разговора", "\
                    "I"[1]"W" Стандартный\n\
                    "I"[2]"W" Недоверяющий\n\
                    "I"[3]"W" Нееодобряющий\n\
                    "I"[4]"W" Настойчивый\n\
                    "I"[5]"W" Позитивный\n\
                    "I"[6]"W" Неуверенный", "Далее", "Отмена");
                return 1;
            }
            p_info[playerid][p_settings][STYLE_CHAT_ID] = listitem;
            UpdatePlayerSetting(playerid);
            SendAccess(playerid, "Вы изменили стиль разговора.");
            return 1;
        }
        case D_STYLE_FIGHT:
        {
            if(!response) return ShowPlayerDialog(playerid, D_STYLE, DIALOG_STYLE_LIST, ""I"Настройка стилей", ""I"[1]"W" Стиль походки\n"I"[2]"W" Стиль разговора\n"I"[3]"W" Стиль боя", "Далее", "Отмена");
            switch(listitem)
            {
                case 0:
                {
                    if(p_info[playerid][pstyle][1] == 0) return SendError(playerid, "У Вас не изучен этот стиль боя.");
                    p_info[playerid][pstyle][0] = 5;
                    SetPlayerFightingStyle(playerid, FIGHT_STYLE_BOXING);
                    SendAccess(playerid, "Вы изменили стиль боя.");
                }
                case 1:
                {
                    if(p_info[playerid][pstyle][2] == 0) return SendError(playerid, "У Вас не изучен этот стиль боя.");
                    p_info[playerid][pstyle][0] = 6;
                    SetPlayerFightingStyle(playerid, FIGHT_STYLE_KUNGFU);
                    SendAccess(playerid, "Вы изменили стиль боя.");
                }
                case 2:
                {
                    if(p_info[playerid][pstyle][3] == 0) return SendError(playerid, "У Вас не изучен этот стиль боя.");
                    p_info[playerid][pstyle][0] = 7;
                    SetPlayerFightingStyle(playerid, FIGHT_STYLE_KNEEHEAD);
                    SendAccess(playerid, "Вы изменили стиль боя.");
                }
                case 3:
                {
                    p_info[playerid][pstyle][0] = 0;
                    SetPlayerFightingStyle(playerid, FIGHT_STYLE_NORMAL);
                    SendAccess(playerid, "Вы изменили стиль боя.");
                }
            }
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%i|%i|%i|%i",
            p_info[playerid][pstyle][0], p_info[playerid][pstyle][1], p_info[playerid][pstyle][2], p_info[playerid][pstyle][3]);
            MysqlUpdatePlayerStr(playerid, "Style", STRING_GLOBAL);
            return 1;
        }

        case D_ACCESSORIES_SELECT:
        {
            new slot_id = GetPVarInt(playerid, #USE_SLOT_ID),
                acc_slot = GetPVarInt(playerid, #USE_ACC_SLOT);

            DeletePVar(playerid, #USE_SLOT_ID);
            DeletePVar(playerid, #USE_ACC_SLOT);
            if(!response) return 1;
            if(!(0 <= listitem <= 1)) return 1;
            InventoryPlayer[playerid][slot_id][inv_status_use] = listitem+1;
            if(!AttachPlayerAccessories(playerid, slot_id, .slot_use = acc_slot))
                return 1;
            SendAccess(playerid, "Вы надели аксессуар, используйте /editor для редактирования.");
            Equipment_Update(playerid);
            return 1;
        }

        case D_MARKET_START:
        {
            if(!response) return 1;
            if(p_temp[playerid][market_buy_idx] == -1) return SendError(playerid, "Что-то пошло не так, подойдите к палатке заново.");
            if(p_temp[playerid][market_arend] != -1) return SendError(playerid, "У Вас уже есть арендованная палатка."), ClearPlayerMarketUse(playerid);
            if(p_info[playerid][exchangePartner] != INVALID_PLAYER_ID) return SendError(playerid, "У Вас не законченный трейд.");
            new idx = p_temp[playerid][market_buy_idx];
            if(MarketInfo[idx][mOwnerID] != INVALID_PLAYER_ID) return SendError(playerid, "Данная палатка уже имеет арендатора."), ClearPlayerMarketUse(playerid);
            p_temp[playerid][market_arend] = idx;
            MarketInfo[idx][mOwnerID] = playerid;
            SendAccess(playerid, "Вы арендовали палатку.");
            SendInfo(playerid, "Редактировать товар: /market");
            UpdateMarket(idx);

            for(new i = MAX_MARKET_PLAYER_USE-1; i != -1; i--)
            {
                if(MarketInfo[idx][mPlayerUse][i] != INVALID_PLAYER_ID)
                    MarketInfo[idx][mPlayerUse][i] = INVALID_PLAYER_ID;
            }
            return 1;
        }
        case D_MARKET_MENU:
        {
            if(!response) return ClearPlayerMarketUse(playerid);
            if(p_temp[playerid][market_buy_idx] == -1) return SendError(playerid, "Что-то пошло не так, подойдите к палатке заново.");
            new idx = p_temp[playerid][market_buy_idx];
            if(idx == -1) return SendError(playerid, "Палатка не определена, подойдите заново.");
            switch(listitem)
            {
                case 0: ShowItemsBuyMarket(playerid);
                case 1: ShowItemsSellMarket(playerid);
            }
            return 1;
        }
        case D_MARKET_CONTROL:
        {
            if(!response) return 1;
            if(p_temp[playerid][market_arend] == -1) return SendError(playerid, "Вы не являетесь арендатором какой либо палатки.");
            switch(listitem)
            {
                case 0: ShowPlayerItemsSellMarket(playerid);
                case 1: ShowPlayerDialog(playerid, D_MARKET_BUY_TYPE, DIALOG_STYLE_LIST, ""I"Купить товар",
                    ""I"[1]"W" Предмет инвентаря\n\
                    "I"[2]"W" Аксессуар\n\
                    "I"[3]"W" Скин\n", "Выбрать", "Отмена");
                case 2: OnPlayerLeaveFromMarket(playerid);
            }
            return 1;
        }
        case D_MARKET_BUY_TYPE:
        {
            if(p_temp[playerid][market_arend] == -1) return SendError(playerid, "Вы не являетесь арендатором какой либо палатки.");
            if(!response) return ShowPlayerControlMarket(playerid);
            switch(listitem)
            {
                case 0: listitem = LIST_ID_MARKET_BUY_INV;
                case 1: listitem = LIST_ID_MARKET_BUY_ACC;
                case 2: listitem = LIST_ID_MARKET_BUY_SKIN;
            }
            ShowPlayerItemsBuyMarket(playerid, listitem);
            return 1;
        }
        case D_MARKET_SELL_ITEM_ADD: // Арендатор - Продажа в палатке: добавление
        {
            if(p_temp[playerid][market_arend] == -1) return SendError(playerid, "Вы не являетесь арендатором какой либо палатки.");
            if(!response) return ShowPlayerControlMarket(playerid);
            new i = GetPVarInt(playerid, #SELECT_SLOT_ID),
                itemID = InventoryPlayer[playerid][i][inv_item_id];
            if(InventoryPlayer[playerid][i][inv_mysql_id] == INVALID_MYSQL_ID)
                return SendError(playerid, "Произошла не известная ошибка: 12.01-20:37.");

            if(!strlen(inputtext))
            {
                ShowDialogMarketItemsSellAdd(playerid, i);
                SendError(playerid, "Вы ничего не ввели.");
                return 1;
            }
            new count = 1, price = strval(inputtext);
            if(ItemsInfo[itemID][iType] == TYPE_ITEMS_INVENTORY)
            {
                if(!IsTextNums(inputtext, 0, 1))
                {
                    ShowDialogMarketItemsSellAdd(playerid, i);
                    SendError(playerid, "Вы не можете вводить точки, несколько запятых и пробелов.");
                    return 1;
                }
                if(sscanf(inputtext, "p<,>ii", count, price))
                {
                    ShowDialogMarketItemsSellAdd(playerid, i);
                    return 1;
                }
                new iTotalAmount = GetInventoryAmount(playerid, itemID);
                if(InventoryPlayer[playerid][i][inv_market_sell_amount]+count > iTotalAmount || !(1<= count <= iTotalAmount))
                    return SendError(playerid, "Кол-во должно быть не менее 1 и не более %d.", iTotalAmount-InventoryPlayer[playerid][i][inv_market_sell_amount]);

                if(itemID == 679 && TentIDx[playerid] == 679 || itemID == 680 && TentIDx[playerid] == 680)
                    return SendError(playerid, "Для начала необходимо забрать свой переносной ларек.");
            }
            if(!(1 <= price <= 100_000_000) || price == 4295000000)
            {
                ShowDialogMarketItemsSellAdd(playerid, i);
                SendError(playerid, "Стоимость должна быть не менее 1 и не более 100 000 000$.");
                return 1;
            }
            if(!(1 <= (InventoryPlayer[playerid][i][inv_market_sell_amount]+count*price) <= 2_000_000_000))
            {
                ShowDialogMarketItemsSellAdd(playerid, i);
                SendError(playerid, "Уменьшите цену за шт. либо количество.");
                return 1;
            }
            MarketItemsSellAdd(playerid, i, count, price);
            DeletePVar(playerid, #SELECT_SLOT_ID);
            return 1;
        }
        case D_MARKET_SELL_ITEM_TAKE: // Арендатор - Продажа в палатке: отнимание
        {
            if(p_temp[playerid][market_arend] == -1) return SendError(playerid, "Вы не являетесь арендатором какой либо палатки.");
            if(!response) return ShowPlayerControlMarket(playerid);
            new i = GetPVarInt(playerid, #SELECT_SLOT_ID),
                itemID = InventoryPlayer[playerid][i][inv_item_id];
            if(InventoryPlayer[playerid][i][inv_mysql_id] == INVALID_MYSQL_ID)
                return SendError(playerid, "Произошла не известная ошибка: 12.01-20:37.");

            new count = 1;
            if(ItemsInfo[itemID][iType] == TYPE_ITEMS_INVENTORY)
            {
                if(sscanf(inputtext, "i", count))
                {
                    ShowDialogMarketItemsSellTake(playerid, i);
                    return 1;
                }
                new iTotalAmount = GetInventoryAmount(playerid, itemID);
                if(!(1<= count <= InventoryPlayer[playerid][i][inv_market_sell_amount]) || count > iTotalAmount)
                {
                    ShowDialogMarketItemsSellTake(playerid, i);
                    return SendError(playerid, "Кол-во должно быть не менее 1 и не более %d.", InventoryPlayer[playerid][i][inv_market_sell_amount]);
                }
                if(InventoryPlayer[playerid][i][inv_market_sell_amount] > iTotalAmount)
                {
                    InventoryPlayer[playerid][i][inv_market_sell_amount] = iTotalAmount;
                    return SendError(playerid, "Нет достаточного количества товара.");
                }
                if(itemID == 679 && TentIDx[playerid] == 679 || itemID == 680 && TentIDx[playerid] == 680)
                    return SendError(playerid, "Для начала необходимо забрать свой переносной ларек.");
            }
            MarketItemsSellTake(playerid, i, count);
            DeletePVar(playerid, #SELECT_SLOT_ID);
            return 1;
        }

        case D_MARKET_BUY_ITEM_ADD: // Арендатор - Закупка в палатке: добавление
        {
            if(p_temp[playerid][market_arend] == -1) return SendError(playerid, "Вы не являетесь арендатором какой либо палатки.");
            if(!response) return ShowPlayerControlMarket(playerid);
            new count = 1, price, item_id = GetPVarInt(playerid, #SELECT_SLOT_ID),
                iColor1, iColor2, iWear, premium;
            if(ItemsInfo[item_id][iType] == TYPE_ITEMS_INVENTORY)
            {
                if(!IsTextNums(inputtext, 0, 1))
                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
                    SendError(playerid, "Вы не можете вводить точки, несколько запятых и пробелов.");
                    return 1;
                }
                if(sscanf(inputtext, "p<,>ii", count, price))
                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
                    return 1;
                }
                new free_amount = GetInventoryFreeItems(playerid, item_id);
                if(!(1 <= count <= free_amount))
                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
                    if(!free_amount) SendError(playerid, "В инвентаре нет места.");
                    else SendError(playerid, "Кол-во товара должно быть не менее 1 и не более %d.", free_amount);
                    return 1;
                }
            }
            else if(ItemsInfo[item_id][iType] == TYPE_ITEMS_ACCESSORIES)
            {
                if(!IsTextNums(inputtext, 0, 3))
                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
                    SendError(playerid, "Вы не можете вводить точки, несколько запятых и пробелов.");
                    return 1;
                }
                if(sscanf(inputtext, "p<,>iiiii", iColor1, iColor2, iWear, price, premium))
                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
                    return 1;
                }
                if(!(0 <= iColor1 <= sizeof(AccessoriesColorInfo)) || !(0 <= iColor2 <= sizeof(AccessoriesColorInfo)))
                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
                    SendError(playerid, "Цвет должен быть от 0 до %d.", sizeof(AccessoriesColorInfo));
                    return 1;
                }
                if(!(0 <= iWear <= 100))
                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
                    SendError(playerid, "Процент износа должен быть от 0 до 100.");
                    return 1;
                }
                if(!(0 <= premium <= 1))
                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
                    SendError(playerid, "Премиум должен быть от 0 до 1.");
                    return 1;
                }
            }
            else if(ItemsInfo[item_id][iType] == TYPE_ITEMS_SKINS)
            {
                if(sscanf(inputtext, "p<,>iii", iWear, price, premium))
                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
                    return 1;
                }
                if(!(0 <= iWear <= 100))
                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
                    SendError(playerid, "Процент износа должен быть от 0 до 100.");
                    return 1;
                }
                if(!(0 <= premium <= 1))
                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
                    SendError(playerid, "Премиум должен быть от 0 до 1.");
                    return 1;
                }
            }
            else if(ItemsInfo[item_id][iType] == TYPE_ITEMS_VEHICLE_TUNE)
            {
                if(sscanf(inputtext, "p<,>i", price))
                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
                    return 1;
                }
            }
            if(!(1 <= price <= 100_000_000) || price == 4295000000)
            {
                ShowDialogMarketItemsBuyAdd(playerid, item_id);
                SendError(playerid, "Стоимость должна быть не менее 1$ и не более 100 000 000$.");
                return 1;
            }
            if(!(1 <= count*price <= 2_000_000_000))
            {
                ShowDialogMarketItemsBuyAdd(playerid, item_id);
                SendError(playerid, "Уменьшите цену за шт. либо количество.");
                return 1;
            }
            MarketItemsBuyAdd(playerid, item_id, count, price, iWear, iColor1, iColor2, premium);
            DeletePVar(playerid, #SELECT_SLOT_ID);
            ShowPlayerItemsBuyMarket(playerid, p_temp[playerid][list_type], p_temp[playerid][list_page]);
            return 1;
        }
        case D_MARKET_BUY_ITEM_TAKE: // Арендатор - Закупка в палатке: отнимание
        {
            if(p_temp[playerid][market_arend] == -1) return SendError(playerid, "Вы не являетесь арендатором какой либо палатки.");
            if(!response) return ShowPlayerControlMarket(playerid);
            new i = GetPVarInt(playerid, #SELECT_SLOT_ID),
                itemID = InventoryPlayer[playerid][i][inv_item_id],
                count = 1;
            if(ItemsInfo[itemID][iType] == TYPE_ITEMS_INVENTORY)
            {
                if(sscanf(inputtext, "i", count))
                {
                    ShowDialogMarketItemsBuyTake(playerid, i);
                    return 1;
                }

                if(!(1 <= count <= InventoryPlayer[playerid][i][inv_market_buy_amount]))
                {
                    ShowDialogMarketItemsBuyTake(playerid, i);
                    return SendError(playerid, "Кол-во должно быть не менее 1 и не более %d.", InventoryPlayer[playerid][i][inv_market_buy_amount]);
                }
            }
            MarketItemsBuyTake(playerid, i, count);
            DeletePVar(playerid, #SELECT_SLOT_ID);
            return 1;
        }

        case D_MARKET_BUY_ITEM: // Покупатель: Покупка в палатке
        {
            new idx = p_temp[playerid][market_buy_idx], item_id = p_temp[playerid][market_buy_items][0];
            if(idx == -1 || item_id < 1)
            {
                SendError(playerid, "Вы не просматриваете товар в какой либо палатке.");
                ClearPlayerMarketUse(playerid);
                p_temp[playerid][market_buy_items][0] =
                p_temp[playerid][market_buy_items][1] = -1;
                return 1;
            }
            if(!response) return ShowItemsBuyMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;
            if(!p_temp[playerid][TextDrawMarket]) return 1;
            new targetid = MarketInfo[idx][mOwnerID];
            if(targetid == INVALID_PLAYER_ID) return SendError(playerid, "Палатка не имеет арендатора."), ClearPlayerMarketUse(playerid), p_temp[playerid][market_buy_items][0] = -1;
            new count = 1,
                price_item = p_temp[playerid][market_buy_items][1],
                slot_id = -1,
                item_type = ItemsInfo[item_id][iType];

            new max_slot, min_slot;
            GetSlotInfoInventory(targetid, EQUIPMENT_INVENTORY_PLAYER, max_slot, min_slot);
            if(min_slot >= max_slot) return 1;

            for(new i = max_slot; i != min_slot; i--)
            {
                if(InventoryPlayer[targetid][i][inv_item_id] == item_id && InventoryPlayer[targetid][i][inv_market_sell_price] == price_item)
                {
                    slot_id = i;
                    break;
                }
            }
            if(slot_id == -1 || price_item <= 0)
            {
                SendError(playerid, "Вы не просматриваете товар в какой либо палатке.");
                ClearPlayerMarketUse(playerid);
                p_temp[playerid][market_buy_items][0] = 
                p_temp[playerid][market_buy_items][1] = -1;
                return 1;
            }
            if(item_type == TYPE_ITEMS_NONE)
            {
                SendError(playerid, "Данный предмет закупать нельзя.");
                return ShowItemsBuyMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;
            }

            if(item_type == TYPE_ITEMS_INVENTORY)
            {
                if(!strlen(inputtext)) return SendError(playerid, "Вы ничего не ввели."), ShowItemsBuyMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;
                count = strval(inputtext);
            }
            if(InventoryPlayer[targetid][slot_id][inv_market_sell_amount] < 1 || !(1 <= count <= InventoryPlayer[targetid][slot_id][inv_market_sell_amount])) return SendError(playerid, "Кол-во товара должно быть не менее 1 и не более %d.", InventoryPlayer[targetid][slot_id][inv_market_sell_amount]), ShowItemsBuyMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;
            new price = InventoryPlayer[targetid][slot_id][inv_market_sell_price] * count;
            if(!(1 <= price <= 100_000_000)) return SendError(playerid, "Стоимость должна быть не менее 1 и не более 100 000 000$."), ShowItemsBuyMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;
            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate"), ShowItemsBuyMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;

            if(item_type == TYPE_ITEMS_NONE) return SendError(playerid, "Предмет не определен."), ShowItemsBuyMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;
            if(count > GetInventoryFreeItems(playerid, item_id))
                    return SendError(playerid, "У вас не достаточно места в инвентаре."), ShowItemsBuyMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;

            new iTotalItems = GetInventoryAmount(targetid, item_id);
            if(count > iTotalItems)
            {
                if(InventoryPlayer[targetid][slot_id][inv_market_sell_amount] > iTotalItems)
                    InventoryPlayer[targetid][slot_id][inv_market_sell_amount] = iTotalItems;
                return SendError(playerid, "У продавца не достаточно предмета в инвентаре."), ShowItemsBuyMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;
            }

            new itemBuyPrice = InventoryPlayer[targetid][slot_id][inv_market_buy_price],
                itemBuyAmount = InventoryPlayer[targetid][slot_id][inv_market_buy_amount],
                Float:wear = item_type == TYPE_ITEMS_ACCESSORIES ? InventoryPlayer[targetid][slot_id][inv_acc_wear] : InventoryPlayer[targetid][slot_id][inv_skin_wear],
                mc1 = InventoryPlayer[targetid][slot_id][inv_acc_mt][0],
                mc2 = InventoryPlayer[targetid][slot_id][inv_acc_mt][1],
                premium = item_type == TYPE_ITEMS_ACCESSORIES ? InventoryPlayer[targetid][slot_id][inv_acc_premium] : InventoryPlayer[targetid][slot_id][inv_skin_premium];

            if(!GivePlayerInventory(playerid, item_id, count, wear, mc1, mc2, .premium = premium))
                return ShowItemsBuyMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;

            if(item_type == TYPE_ITEMS_INVENTORY)
            {
                if(!GivePlayerInventory(targetid, item_id, -count))
                    return ShowItemsBuyMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;
            }
            else DropPlayerEquipment(targetid, slot_id);

            if(InventoryPlayer[targetid][slot_id][inv_mysql_id] != INVALID_MYSQL_ID && InventoryPlayer[targetid][slot_id][inv_item_id] != 0)
            {
                InventoryPlayer[targetid][slot_id][inv_market_sell_amount] -= count;
                if(InventoryPlayer[targetid][slot_id][inv_market_sell_amount] == 0)
                    InventoryPlayer[targetid][slot_id][inv_market_sell_price] = 0;
            }

            if(itemBuyPrice > 0 && itemBuyAmount > 0)
            {
                InventoryPlayer[targetid][slot_id][inv_item_id] = item_id;
                InventoryPlayer[targetid][slot_id][inv_market_buy_price] = itemBuyPrice;
                InventoryPlayer[targetid][slot_id][inv_market_buy_amount] = itemBuyAmount;
            }

            new tax = GetTaxCount(targetid, price, TAX_MARKET_SELL);

            SendAccess(playerid, "Вы купили \"%s\" %d ед. за %d$.", ItemsInfo[item_id][iName], count, price);
            SendAccess(targetid, "Вы продали \"%s\" %d ед. за %d$. Налог: %d$.", ItemsInfo[item_id][iName], count, price, tax);

            p_temp[playerid][market_buy_items][0] = -1;
            ShowItemsBuyMarket(playerid);

            if(item_type == TYPE_ITEMS_INVENTORY || item_type == TYPE_ITEMS_SKINS || item_type == TYPE_ITEMS_VEHICLE_TUNE)
            {
                Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] купил у %s[%d](%s %s)[$%d] на рынке товар <%s> %d ед. за %d$. Налог %d$ | #MARKET",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                    get_name(targetid), p_info[targetid][ID], p_temp[targetid][session_IP], IsPlayerMobile(targetid) ? "Mobile": "PC", p_info[targetid][cash],
                    ItemsInfo[item_id][iName], count, price, tax);

                Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] продал %s[%d](%s %s)[$%d] на рынке товар <%s> %d ед. за %d$. Налог %d$ | #MARKET",
                get_name(targetid), p_info[targetid][ID], p_temp[targetid][session_IP], IsPlayerMobile(targetid) ? "Mobile": "PC", p_info[targetid][cash],
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                    ItemsInfo[item_id][iName], count, price, tax);
            }
            else if(item_type == TYPE_ITEMS_ACCESSORIES)
            {
                Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] продал %s[%d](%s %s)[$%d] через рынок <%s> [%.1f] (%s/%s) за %d$. Налог %d$ | #MARKET",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                    get_name(targetid), p_info[targetid][ID], p_temp[targetid][session_IP], IsPlayerMobile(targetid) ? "Mobile": "PC", p_info[targetid][cash],
                    ItemsInfo[item_id][iName], wear, AccessoriesColorInfo[mc1][acName], AccessoriesColorInfo[mc2][acName], price, tax);

                Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] купил у %s[%d](%s %s)[$%d] через рынок <%s> [%.1f] (%s/%s) за %d$. Налог %d$ | #MARKET",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                    get_name(targetid), p_info[targetid][ID], p_temp[targetid][session_IP], IsPlayerMobile(targetid) ? "Mobile": "PC", p_info[targetid][cash],
                    ItemsInfo[item_id][iName], wear, AccessoriesColorInfo[mc1][acName], AccessoriesColorInfo[mc2][acName], price, tax);
            }

            SetPlayerMoney(playerid, -price, true, "");
            SetPlayerMoney(targetid, price-tax, true, "");
            return 1;
        }
        case D_MARKET_SELL_ITEM:  // Покупатель: Продажа в палатке
        {
            new idx = p_temp[playerid][market_buy_idx], item_id = p_temp[playerid][market_buy_items][0];
            if(idx == -1 || item_id < 1)
            {
                SendError(playerid, "Вы не просматриваете товар в какой либо палатке.");
                ClearPlayerMarketUse(playerid);
                p_temp[playerid][market_buy_items][0] =
                p_temp[playerid][market_buy_items][1] = -1;
                return 1;
            }
            if(!response) return ShowItemsSellMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;
            if(!p_temp[playerid][TextDrawMarket]) return 1;
            new targetid = MarketInfo[idx][mOwnerID];
            if(targetid == INVALID_PLAYER_ID) return SendError(playerid, "Палатка не имеет арендатора."), ClearPlayerMarketUse(playerid), p_temp[playerid][market_buy_items][0] = -1;
            new count = 1,
                price_item = p_temp[playerid][market_buy_items][1],
                slot_id = -1,
                item_type = ItemsInfo[item_id][iType];

            new max_slot, min_slot;
            GetSlotInfoInventory(targetid, EQUIPMENT_INVENTORY_PLAYER, max_slot, min_slot);
            if(min_slot >= max_slot) return 1;

            for(new i = max_slot; i != min_slot; i--)
            {
                if(InventoryPlayer[targetid][i][inv_item_id] == item_id && InventoryPlayer[targetid][i][inv_market_buy_price] == price_item)
                {
                    slot_id = i;
                    break;
                }
            }
            if(slot_id == -1 || price_item <= 0)
            {
                SendError(playerid, "Вы не просматриваете товар в какой либо палатке.");
                ClearPlayerMarketUse(playerid);
                p_temp[playerid][market_buy_items][0] =
                p_temp[playerid][market_buy_items][1] = -1;
                return 1;
            }
            if(playerid == targetid || p_info[playerid][ID] == p_info[targetid][ID])
            {
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s[%d]%s[%d] ЗАБАГАЛ РЫНОК И БЫЛ ЗАБЛОКИРОВАН",  get_name(playerid), playerid, get_name(playerid), playerid);
                SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `table_ban` (`Name_Admin`, `Name_Player`, `Ban_Data`, `Unban_Data`, `Ban_Reason`) VALUES ('System', '%e', NOW(), '%d', 'Багоюз рынка')",
                    get_name(playerid), timestamp + (30 * 86400));
                mysql_tquery(con_bd, STRING_GLOBAL);

                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `table_ban` (`Name_Admin`, `Name_Player`, `Ban_Data`, `Unban_Data`, `Ban_Reason`) VALUES ('System', '%e', NOW(), '%d', 'Багоюз рынка')",
                    get_name(targetid), timestamp + (30 * 86400));
                mysql_tquery(con_bd, STRING_GLOBAL);

                Kick(playerid);
                Kick(targetid);
                return 1;
            }

            if(item_type == TYPE_ITEMS_INVENTORY)
            {
                if(!strlen(inputtext)) return SendError(playerid, "Вы ничего не ввели."), ShowItemsSellMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;
                count = strval(inputtext);
            }
            if(InventoryPlayer[targetid][slot_id][inv_market_buy_amount] < 1 || !(1 <= count <= InventoryPlayer[targetid][slot_id][inv_market_buy_amount])) return SendError(playerid, "Кол-во товара должно быть не менее 1 и не более %d.", InventoryPlayer[targetid][slot_id][inv_market_buy_amount]), ShowItemsSellMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;
            new price = InventoryPlayer[targetid][slot_id][inv_market_buy_price] * count;
            if(!(1 <= price <= 100_000_000)) return SendError(playerid, "Стоимость должна быть не менее 1 и не более 100 000 000$."), ShowItemsSellMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;
            
            new tax = GetTaxCount(targetid, price, TAX_MARKET_BUY);
            if(p_info[targetid][cash] < price+tax) return SendError(playerid, "У владельца палатки нет столько денег."), ShowItemsSellMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;

            if(item_type == TYPE_ITEMS_NONE) return SendError(playerid, "Предмет не определен."), ShowItemsSellMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;

            if(count > GetInventoryFreeItems(targetid, item_id))
                return SendError(playerid, "У покупателя не достаточно места в инвентаре."), ShowItemsSellMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;
            if(count > GetInventoryAmount(playerid, item_id))
                return SendError(playerid, "Кол-во должно быть не менее 1 и не более %d.", GetInventoryAmount(playerid, item_id)), ShowItemsSellMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;

            InventoryPlayer[targetid][slot_id][inv_market_buy_amount] -= count;
            if(InventoryPlayer[targetid][slot_id][inv_market_buy_amount] == 0)
            {
                if(InventoryPlayer[targetid][slot_id][inv_mysql_id] == INVALID_MYSQL_ID)
                    InventoryPlayer[targetid][slot_id][inv_item_id] = 0;
                InventoryPlayer[targetid][slot_id][inv_market_buy_price] = 0;
            }
            new Float:wear = item_type == TYPE_ITEMS_ACCESSORIES ? InventoryPlayer[targetid][slot_id][inv_acc_wear] : InventoryPlayer[targetid][slot_id][inv_skin_wear],
                mc1 = InventoryPlayer[targetid][slot_id][inv_acc_mt][0],
                mc2 = InventoryPlayer[targetid][slot_id][inv_acc_mt][1],
                premium = item_type == TYPE_ITEMS_ACCESSORIES ? InventoryPlayer[targetid][slot_id][inv_acc_premium] : InventoryPlayer[targetid][slot_id][inv_skin_premium];

            if(item_type == TYPE_ITEMS_INVENTORY || item_type == TYPE_ITEMS_VEHICLE_TUNE)
            {
                if(!GivePlayerInventory(playerid, item_id, -count))
                    return ShowItemsSellMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;
            }
            else if(item_type == TYPE_ITEMS_ACCESSORIES)
            {
                new acc_slot_id = MarketSearchSlotAccessories(playerid, item_id, wear, mc1, mc2, premium);
                if(acc_slot_id == -1)
                    return SendError(playerid, "Подходящего аксессуара у Вас не найдено."), ShowItemsSellMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;
                DropPlayerEquipment(playerid, acc_slot_id);
            }
            else if(item_type == TYPE_ITEMS_SKINS)
            {
                new acc_slot_id = MarketSearchSlotSkins(playerid, item_id, wear, premium);
                if(acc_slot_id == -1)
                    return SendError(playerid, "Подходящего скина у Вас не найдено."), ShowItemsSellMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;
                DropPlayerEquipment(playerid, acc_slot_id);
            }

            if(!GivePlayerInventory(targetid, item_id, count, wear, mc1 != 0 ? mc1-1 : mc1, mc2 != 0 ? mc2-1 : mc2, .premium = premium))
                return ShowItemsBuyMarket(playerid), p_temp[playerid][market_buy_items][0] = -1;

            SendAccess(targetid, "Вы купили \"%s\" %d ед. за %d$. Налог: %d$.", ItemsInfo[item_id][iName], count, price, tax);
            SendAccess(playerid, "Вы продали \"%s\" %d ед. за %d$.", ItemsInfo[item_id][iName], count, price);

            p_temp[playerid][market_buy_items][0] = -1;
            ShowItemsSellMarket(playerid);

            if(item_type == TYPE_ITEMS_INVENTORY || item_type == TYPE_ITEMS_SKINS || item_type == TYPE_ITEMS_VEHICLE_TUNE)
            {
                // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2)[$112345] купил у Durel_Pavel[3](127.0.0.1 PC/0.3.7-R2)[$112345] на рынке товар <Камень> 10 шт. за 100$
                Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] продал %s[%d](%s %s)[$%d] на рынке товар <%s> %d ед. за %d$. Налог: %d$ | #MARKET",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                    get_name(targetid), p_info[targetid][ID], p_temp[targetid][session_IP], IsPlayerMobile(targetid) ? "Mobile": "PC", p_info[targetid][cash],
                    ItemsInfo[item_id][iName], count, price, tax);

                // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2)[$112345] продал Durel_Pavel[3](127.0.0.1 PC/0.3.7-R2)[$112345] на рынке товар <Камень> 10 шт. за 100$
                Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] купил у %s[%d](%s %s)[$%d] на рынке товар <%s> %d ед. за %d$. Налог: %d$ | #MARKET",
                    get_name(targetid), p_info[targetid][ID], p_temp[targetid][session_IP], IsPlayerMobile(targetid) ? "Mobile": "PC", p_info[targetid][cash],
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                    ItemsInfo[item_id][iName], count, price, tax);
            }
            else if(item_type == TYPE_ITEMS_ACCESSORIES)
            {
                // Hardi_Devidson[1](192.168.1.1 M/0.0.1-patch1)[$112345] продал Jeffrey_Collinz[0](127.0.0.1 PC/0.3.7-R2)[$154321] аксессуар <Голубая бандана>(18906) через рынок за 130000$
                Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] продал %s[%d](%s %s)[$%d] на рынке товар <%s>(%d) [%.1f] (%s/%s) через рынок за %d$. Налог: %d$ | #MARKET",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                    get_name(targetid), p_info[targetid][ID], p_temp[targetid][session_IP], IsPlayerMobile(targetid) ? "Mobile": "PC", p_info[targetid][cash],
                    ItemsInfo[item_id][iName], item_id, wear, AccessoriesColorInfo[mc1][acName], AccessoriesColorInfo[mc2][acName], price, tax);

                // Jeffrey_Collinz[0](127.0.0.1 PC/0.3.7-R2)[$154321] купил у Hardi_Devidson[1](192.168.1.1 - Offline)[$112345] аксессуар <Голубая бандана>(18906) через рынок за 130000$
                Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] купил у %s[%d](%s %s)[$%d] на рынке товар <%s>(%d) [%.1f] (%s/%s) через рынок за %d$. Налог: %d$ | #MARKET",
                    get_name(targetid), p_info[targetid][ID], p_temp[targetid][session_IP], IsPlayerMobile(targetid) ? "Mobile": "PC", p_info[targetid][cash],
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                    ItemsInfo[item_id][iName], item_id, wear, AccessoriesColorInfo[mc1][acName], AccessoriesColorInfo[mc2][acName], price, tax);
            }

            SetPlayerMoney(targetid, -(price+tax), true, "");
            SetPlayerMoney(playerid, price, true, "");
            return 1;
        }

        case D_HOTEL_MENU_ROOMS_LIST:
        {
            if(!response) return 1;
            new biz_id = GetPVarInt(playerid, "bID"), hotel_id = b_info[biz_id][b_mysql_id];
            if(hotel_rooms_info[hotel_id][listitem][hr_user_id] != 0) return SendError(playerid, "У этого номера уже есть владелец.");

            if(GetPlayerHouseID(playerid) != INVALID_HOUSE_ID) return SendError(playerid, "У Вас уже есть дом или Вы подселены.");
            if(GetPlayerHotelID(playerid, 0) != -1 || GetPlayerHotelID(playerid, 1) != -1) return SendError(playerid, "У Вас уже есть номер отеля.");

            SetPVarInt(playerid, "hrID", listitem);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "Номер: %d\nСтоимость аренды: %d$", listitem, 2500);
            ShowPlayerDialog(playerid, D_HOTEL_RENT_ROOM, DIALOG_STYLE_MSGBOX, ""I"Аренда номера", STRING_GLOBAL, "Далее", "Отмена");
            return 1;
        }
        case D_HOTEL_ROOMS_ENTER:
        {
            if(!response) return 1;
            new hotel_id = GetPVarInt(playerid, "bID"), room_id = GetPVarInt(playerid, "hrID");
            SetPlayerPos(playerid, 2198.4780, -1160.3774, 1029.7969);
            SetPlayerFacingAngle(playerid, 358.3456);
            SetPlayerInterior(playerid, b_info[hotel_id][_int]);
            SetPlayerVirtualWorld(playerid, hotel_id * 12 + room_id);
            return 1;
        }
        case D_HOTEL_RENT_ROOM:
        {
            if(!response) return 1;
            new biz_id = GetPVarInt(playerid, "bID"), hotel_id = b_info[biz_id][b_mysql_id], room_id = GetPVarInt(playerid, "hrID");
            if(GetPlayerHouseID(playerid) != INVALID_HOUSE_ID) return SendError(playerid, "У Вас уже есть дом или Вы подселены.");
            if(GetPlayerHotelID(playerid, 0) != -1 || GetPlayerHotelID(playerid, 1) != -1) return SendError(playerid, "У Вас уже есть номер отеля.");
            if(hotel_rooms_info[hotel_id][room_id][hr_user_id] != 0) return SendError(playerid, "У этого номера уже есть владелец.");
            if(p_info[playerid][cash] < 2500) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            OnServerInfoForMoney[10] += 2500;
            SetPlayerMoney(playerid, -2500, true, "арендовал номер в отеле");

            if(b_info[biz_id][_prod] >= 2500 / 100)
            {
                b_info[biz_id][_prod] -= 2500 / 100;
                b_info[biz_id][_bank] += 2250;
                AddMafiaBank(biz_id, 250);

                biz_finka[biz_id] += 2250;
                UpdateIntForFinanceBiz(biz_id, 2250);
            }

            strmid(hotel_rooms_info[hotel_id][room_id][hr_owner], get_name(playerid), 0, strlen(get_name(playerid)), MAX_PLAYER_NAME);
            hotel_rooms_info[hotel_id][room_id][hr_user_id] = p_info[playerid][ID];
            hotel_rooms_info[hotel_id][room_id][hr_rent] = 24;

            //lastlog(BUY_HOTEL_GOS, "Аренда номера в отеле", hotel_id, playerid, playerid, -2500, hotel_rooms_info[hotel_id][room_id][hr_owner], room_id);

            // [logs] реализовать получение версии клиента
            // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) арендовал номер %d в отеле %d за %d$
            Log(LOG_player, INFO, "%s[%d](%s %s) арендовал номер %d в отеле %d за %d$",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                room_id, hotel_id, 2500);


            p_info[playerid][key_hotel] = hotel_id;
            p_info[playerid][key_hotel_room] = room_id;

            p_info[playerid][spawn] = SPAWN_HOTEL;

            DestroyDynamicPickup(hotel_rooms_info[hotel_id][room_id][hr_pickup]);
            hotel_rooms_info[hotel_id][room_id][hr_pickup] = CreateDynamicPickup(((hotel_rooms_info[hotel_id][room_id][hr_user_id] == 0) ? 1273 : 1272), 23, hotel_rooms_pos[room_id][0], hotel_rooms_pos[room_id][1], hotel_rooms_pos[room_id][2], b_info[biz_id][_world]);
            UpdatePickupInfo(hotel_rooms_info[hotel_id][room_id][hr_pickup], TYPE_BUSINESS, PICKUP_SUBTYPE_BUSINESS_HOTEL, hotel_id);

            save_hotel_rooms(hotel_id, room_id);

            SendAccess(playerid, "Вы сняли номер в отеле.");
            SendInfo(playerid, "Оплатить проживание в отеле или выселиться из него можно на ресепшене.");

            CheckPlayerMission(playerid, START_HOTEL);
            return 1;
        }
        case D_HOTEL_ROOM_PAY:
        {
            if(!response) return 1;

            new biz_id = GetPVarInt(playerid, "bID"), hotel_id = p_info[playerid][key_hotel], room_id = p_info[playerid][key_hotel_room];
            if(hotel_rooms_info[hotel_id][room_id][hr_user_id] != p_info[playerid][ID]) return SendError(playerid, "Этот номер принадлежит не Вас.");
            new fix_listitem;
            if(sscanf(inputtext, "i", fix_listitem))
            {
                ShowPlayerDialog(playerid, D_HOTEL_ROOM_PAY, DIALOG_STYLE_INPUT, ""I"Оплата", ""W"Стоимость проживания: $2500 в день.\n\nВведите количество часов для оплаты:", "Далее", "Отмена");
                return SendError(playerid, "Вы ничего не ввели.");
            }
            if(!(1 <= fix_listitem <= 30))
            {
                ShowPlayerDialog(playerid, D_HOTEL_ROOM_PAY, DIALOG_STYLE_INPUT, ""I"Оплата", ""W"Стоимость проживания: $2500 в день.\n\nВведите количество часов для оплаты:", "Далее", "Отмена");
                return SendError(playerid, "Вы не можете оплатить номер меньше 1 или более 30 дней.");
            }
            if(hotel_rooms_info[hotel_id][room_id][hr_rent] + (fix_listitem*24) > 720) // 720 - это 30 дней (24 часа * 30 дней = 720 часов)
            {
                ShowPlayerDialog(playerid, D_HOTEL_ROOM_PAY, DIALOG_STYLE_INPUT, ""I"Оплата", ""W"Стоимость проживания: $2500 в день.\n\nВведите количество часов для оплаты:", "Далее", "Отмена");
                return SendError(playerid, "Вы не можете оплатить номер более чем на 30 дней.");
            }
            if(p_info[playerid][cash] < fix_listitem * 2500)
            {
                ShowPlayerDialog(playerid, D_HOTEL_ROOM_PAY, DIALOG_STYLE_INPUT, ""I"Оплата", ""W"Стоимость проживания: $2500 в день.\n\nВведите количество часов для оплаты:", "Далее", "Отмена");
                return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            }
            OnServerInfoForMoney[10] += fix_listitem * 2500;
            SetPlayerMoney(playerid, -(fix_listitem * 2500), true, "оплатил номер в отеле");

            if(b_info[biz_id][_prod] >= (fix_listitem * 2500) / 100)
            {
                b_info[biz_id][_prod] -= (fix_listitem * 2500) / 100;
                b_info[biz_id][_bank] += 2250 * fix_listitem;
                AddMafiaBank(biz_id, 250 * fix_listitem);

                biz_finka[biz_id] += 2250 * fix_listitem;
                UpdateIntForFinanceBiz(biz_id, 2250 * fix_listitem);
            }
            hotel_rooms_info[hotel_id][room_id][hr_rent] += fix_listitem * 24;
            save_hotel_rooms(hotel_id, room_id);
            SendAccess(playerid, "Вы оплатили номер еще на %d дней. Стоимость: %d$.", fix_listitem, fix_listitem * 2500);
            return 1;
        }
        case D_HOTEL_EVICT_ROOM:
        {
            if(!response) return 1;
            new biz_id = GetPVarInt(playerid, "bID"), hotel_id = p_info[playerid][key_hotel], room_id = p_info[playerid][key_hotel_room];
            if(hotel_id == -1 || room_id == -1)
                return SendError(playerid, "Этот номер принадлежит не Вам.");
            if(hotel_rooms_info[hotel_id][room_id][hr_user_id] != p_info[playerid][ID]) return SendError(playerid, "Этот номер принадлежит не Вам.");

            //lastlog(SELL_HOTEL_GOS, "Выселение из отеля", hotel_id, playerid, playerid, 0, hotel_rooms_info[hotel_id][room_id][hr_owner], room_id);

            // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) выселился из номера %d отеля %d
            Log(LOG_player, INFO, "%s[%d](%s %s) выселился из номера %d отеля %d",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                room_id, hotel_id);

            strmid(hotel_rooms_info[hotel_id][room_id][hr_owner], "None", 0, strlen("None"), MAX_PLAYER_NAME);
            hotel_rooms_info[hotel_id][room_id][hr_user_id] = 0;
            hotel_rooms_info[hotel_id][room_id][hr_rent] = 24;

            p_info[playerid][key_hotel] = -1;
            p_info[playerid][key_hotel_room] = -1;

            p_info[playerid][spawn] = 0;

            DestroyDynamicPickup(hotel_rooms_info[hotel_id][room_id][hr_pickup]);
            hotel_rooms_info[hotel_id][room_id][hr_pickup] = CreateDynamicPickup(((hotel_rooms_info[hotel_id][room_id][hr_user_id] == 0) ? 1273 : 1272), 23, hotel_rooms_pos[room_id][0], hotel_rooms_pos[room_id][1], hotel_rooms_pos[room_id][2], b_info[biz_id][_world]);
            UpdatePickupInfo(hotel_rooms_info[hotel_id][room_id][hr_pickup], TYPE_BUSINESS, PICKUP_SUBTYPE_BUSINESS_HOTEL, hotel_id);

            save_hotel_rooms(hotel_id, room_id);

            SendAccess(playerid, "Вы выселились из отеля.");
            return 1;
        }
        case D_FRACTION_VEHICLE_SPAWN:
        {
            if(!response) return 1;
            new frac_id = p_info[playerid][member];
            if(!(1 <= frac_id < MAX_FRACTIONS)) return SendError(playerid, "FVP BUG-1: Обратитесь на форум с этим сообщением.");
            if(listitem > MAX_FRACTIONS_VEHICLES - 1) return SendError(playerid, "Что-то пошло не так, попробуйте заново или обновите версию клиента.");
            if(FractionsData[frac_id][fVehModelUseCount][listitem] >= FractionsData[frac_id][fVehModelMaxCount][listitem])
                return SendError(playerid, "Свободных доступных Т/С нет.");
            if(FractionsData[frac_id][fVehAccessRank][listitem] > p_info[playerid][rang])
                return SendError(playerid, "Вашего ранга не достаточно чтобы заспавнить эту машину.");

            new vcolors1[] = {1, 0, 0, 0, 0, 77, 1, 0, 0, 0, 86, 5, 7, 2, 6, 1, 1, 1, 1,  1, 77, 61, 7, 0, 1, 86},
                vcolors2[] = {1, 1, 1, 1, 0, 77, 2, 0, 0, 0, 86, 5, 7, 2, 6, 3, 3, 3, 16, 1, 77, 1,  1, 0, 3, 1},
                model_id = FractionsData[frac_id][fVehModelsID][listitem],
                vtime_spawn = 600;

            if(GetPlayerStatusCapture(playerid) == CAPTURE_ID_GANG || GetPlayerStatusCapture(playerid) == CAPTURE_ID_MAFIA || GetPlayerStatusCapture(playerid) == CAPTURE_ID_FAMILY)
                vtime_spawn = 120;

            new vehicleid = CreateVehicleVEx(NPO_FACTION, frac_id, model_id,
                FractionsData[frac_id][fVehSpawnPos][0], FractionsData[frac_id][fVehSpawnPos][1],
                FractionsData[frac_id][fVehSpawnPos][2], FractionsData[frac_id][fVehSpawnPos][3],
                vcolors1[frac_id], vcolors2[frac_id], vtime_spawn);

            LinkVehicleToInterior(vehicleid, FractionsData[frac_id][fVehSpawnField][fInterior]);
            SetVehicleVirtualWorld(vehicleid, FractionsData[frac_id][fVehSpawnField][fVirtualWorld]);

            PutPlayerInVehicle(playerid, vehicleid, 0);
            //veh_info[vehicleid][v_fraction_rang] = FractionsData[frac_id][fVehAccessRank][listitem];
            return 1;
        }
        case D_FRACTION_VEHICLE:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0:
                {
                    if(p_info[playerid][leader] == 0) return SendError(playerid, "Вы не можете пользоваться этой функцией.");
                    if(!gang(playerid) && !mafia(playerid) && !biker(playerid)) return SendError(playerid, "Доступно только для нелегальной организации.");
                    if(p_info[playerid][admin] < 10) return SendError(playerid, "Данная возможность доступна только красной администрации.");
                    new member_id = p_info[playerid][member];
                    if(!IsPlayerInRangeOfPoint(playerid, 100.0, FractionsData[member_id][fUnloadingPos][0], FractionsData[member_id][fUnloadingPos][1], FractionsData[member_id][fUnloadingPos][2])) return SendError(playerid, "Вы не можете приобретать транспортные средства далеко от фракционного спавна.");
                    STRING_GLOBAL[0] = EOS;
                    new str[128];
                    if(gang(playerid))
                    {
                        new fraction_cars_gang[20] = {478, 482, 466, 475, 580, 474, 529, 540, 410, 550, 401, 534, 518, 567, 492, 600, 549, 566, 517, 412};
                        for(new i; i < sizeof(fraction_cars_gang); i++)
                        {
                            f(str, ""I"[%d]"W" %s (%d$) (ID %d)\n", i+1, GetVehicleName(INVALID_VEHICLE_ID, fraction_cars_gang[i]), GetVehicleData(fraction_cars_gang[i], E_VD_PRICE), fraction_cars_gang[i]);
                            strcat(STRING_GLOBAL, str);
                        }
                    }
                    else if(mafia(playerid))
                    {
                        new fraction_cars_mafia[10] = {418, 478, 482, 409, 580, 579, 468, 445, 560, 561};
                        for(new i; i < sizeof(fraction_cars_mafia); i++)
                        {
                            f(str, ""I"[%d]"W" %s (%d$) (ID %d)\n", i+1, GetVehicleName(INVALID_VEHICLE_ID, fraction_cars_mafia[i]), GetVehicleData(fraction_cars_mafia[i], E_VD_PRICE), fraction_cars_mafia[i]);
                            strcat(STRING_GLOBAL, str);
                        }
                    }
                    else if(biker(playerid))
                    {
                        new fraction_cars_biker[3] = {463, 478, 482};
                        for(new i; i < sizeof(fraction_cars_biker); i++)
                        {
                            f(str, ""I"[%d]"W" %s (%d$) (ID %d)\n", i+1, GetVehicleName(INVALID_VEHICLE_ID, fraction_cars_biker[i]), GetVehicleData(fraction_cars_biker[i], E_VD_PRICE), fraction_cars_biker[i]);
                            strcat(STRING_GLOBAL, str);
                        }
                    }
                    ShowPlayerDialog(playerid, D_FRACTION_VEHICLE_BUY, DIALOG_STYLE_LIST, ""I"Приобрести транспорт", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 1:
                {
                    if(p_info[playerid][leader] == 0) return SendError(playerid, "Вы не можете пользоваться этой функцией.");
                    if(!gang(playerid) && !mafia(playerid) && !biker(playerid)) return SendError(playerid, "Доступно только для нелегальной организации.");
                    if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Вы должны находиться в транспортном средстве.");
                    if(p_info[playerid][admin] < 10) return SendError(playerid, "Данная возможность доступна только красной администрации.");
                    new vehicleid = GetPlayerVehicleID(playerid);
                    if(veh_info[vehicleid][v_npoType] != NPO_FACTION || veh_info[vehicleid][v_npoId] != p_info[playerid][member]) return SendError(playerid, "Транспортное средство не принадлежит Вашей фракции.");
                    if(veh_info[vehicleid][v_owner_id] != INVALID_MYSQL_ID) return SendError(playerid, "Транспортным средством владеет игрок.");
                    new str[128];
                    f(str, ""W"Вы желаете продать фракционный транспорт (%s) государству за %d$?", GetVehicleName(vehicleid), GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_PRICE)/2);
                    ShowPlayerDialog(playerid, D_FRACTION_VEHICLE_SELL, DIALOG_STYLE_MSGBOX, ""I"Продать транспорта", str, "Да", "Нет");
                }
                case 2:
                {
                    if(p_info[playerid][leader] == 0) return SendError(playerid, "Вы не можете пользоваться этой функцией.");
                    if(!gang(playerid) && !mafia(playerid) && !biker(playerid)) return SendError(playerid, "Доступно только для нелегальной организации.");
                    if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Вы должны находиться в транспортном средстве.");
                    new vehicleid = GetPlayerVehicleID(playerid);
                    if(veh_info[vehicleid][v_npoType] != NPO_FACTION || veh_info[vehicleid][v_npoId] != p_info[playerid][member]) return SendError(playerid, "Транспортное средство не принадлежит Вашей фракции.");
                    if(veh_info[vehicleid][v_owner_id] != INVALID_MYSQL_ID) return SendError(playerid, "Транспортным средством владеет игрок.");
                    ShowPlayerDialog(playerid, D_FRACTION_VEHICLE_RANK, DIALOG_STYLE_INPUT, ""I"Изменить ранг для транспорта", ""W"Введите ранг, который желаете установить:", "Далее", "Отмена");
                }
                case 3: {
                    if(p_info[playerid][cash] < 10_000)
                        return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                    SetPlayerMoney(playerid, -10_000, true, "заправил все автомобили фракции <%s>", GetFractionName(p_info[playerid][member]));
                    foreach(new v: Vehicle)
                    {
                        if(veh_info[v][v_owner_id] != INVALID_MYSQL_ID ||
                            veh_info[v][v_npoId] != p_info[playerid][member] ||
                            veh_info[v][v_npoType] != NPO_FACTION) continue;
                        veh_info[v][v_fuel] = GetVehicleData(GetVehicleModelEx(v), E_VD_MAX_FUEL);
                    }
                    SendAccess(playerid, "Вы заправили транспортные средства Вашей фракции.");
                }
                case 4: {
                    if(p_info[playerid][cash] < 5_000)
                        return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                    SetPlayerMoney(playerid, -5_000, true, "зареспавнил все автомобили фракции <%s>", GetFractionName(p_info[playerid][member]));
                    new idx;
                    //for(new v = 1, j = GetVehiclePoolSize(); v <= j; v++)
                    foreach(new v: Vehicle)
                    {
                        if(veh_info[v][v_owner_id] != INVALID_MYSQL_ID ||
                            veh_info[v][v_npoId] != p_info[playerid][member] ||
                            veh_info[v][v_npoType] != NPO_FACTION ||
                            IsVehicleOccupied(v)) continue;
                        idx = GetSlotFractionVehicle(p_info[playerid][member], veh_info[v][v_model]);
                        if(idx != -1) DestroyVehicleVEx(v);
                        else SetVehicleToRespawn(v);
                    }
                    SendAccess(playerid, "Вы доставили транспортные средства Вашей фракции на место парковки.");
                }
            }
            return 1;
        }
        case D_FRACTION_VEHICLE_BUY:
        {
            if(!response) return callcmd::fcars(playerid, "/0");
            new price = 5000000, model_id = 400;
            if(gang(playerid))
            {
                new fraction_cars_gang[20] = {478, 482, 466, 475, 580, 474, 529, 540, 410, 550, 401, 534, 518, 567, 492, 600, 549, 566, 517, 412};
                price = GetVehicleData(fraction_cars_gang[listitem], E_VD_PRICE), model_id = fraction_cars_gang[listitem];
            }
            else if(mafia(playerid))
            {
                new fraction_cars_mafia[10] = {418, 478, 482, 409, 580, 579, 468, 445, 560, 561};
                price = GetVehicleData(fraction_cars_mafia[listitem], E_VD_PRICE), model_id = fraction_cars_mafia[listitem];
            }
            else if(biker(playerid))
            {
                new fraction_cars_biker[3] = {463, 478, 482};
                price = GetVehicleData(fraction_cars_biker[listitem], E_VD_PRICE), model_id = fraction_cars_biker[listitem];
            }
            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            new frac_id = p_info[playerid][member];
            new idx = GetSlotFractionVehicle(frac_id, model_id);
            if(idx == -1)
            {
                for(new i; i < MAX_FRACTIONS_VEHICLES; i++)
                {
                    if(FractionsData[frac_id][fVehModelsID][i] == 0)
                    {
                        idx = i;
                        break;
                    }
                }
            }
            if(idx == -1) return SendError(playerid, "Нет свободного слота для покупки.");
            FractionsData[frac_id][fVehModelsID][idx] = model_id;
            FractionsData[frac_id][fVehModelMaxCount][idx]++;
            SaveFractionVehParkings(frac_id);

            SendAccess(playerid, "Вы приобрели фракционное транспортное средство \"%s\" за %d$.", GetVehicleName(INVALID_VEHICLE_ID, model_id), price);

            Log(LOG_player, INFO, "%s[%d](%s %s)[%d$] купил из госа фрак. транспорт <%s>(%d) для %s за %d$",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                GetVehicleName(INVALID_VEHICLE_ID, model_id), model_id, GetFractionName(p_info[playerid][member]), price);

            SetPlayerMoney(playerid, -price, true, "");
            return 1;
        }
        case D_FRACTION_VEHICLE_SELL:
        {
            if(!response) return callcmd::fcars(playerid, "/0");
            if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "Вы должны находиться в транспортном средстве.");
            if(p_info[playerid][admin] < 10) return SendError(playerid, "Данная возможность доступна только красной администрации.");
            new vehicleid = GetPlayerVehicleID(playerid);
            if(veh_info[vehicleid][v_npoType] != NPO_FACTION || veh_info[vehicleid][v_npoId] != p_info[playerid][member]) return SendError(playerid, "Транспортное средство не принадлежит Вашей фракции.");
            if(veh_info[vehicleid][v_owner_id] != INVALID_MYSQL_ID) return SendError(playerid, "Транспортным средством владеет игрок.");
            new price = GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_PRICE)/2;

            new frac_id = p_info[playerid][member];
            new idx = GetSlotFractionVehicle(frac_id, GetVehicleModelEx(vehicleid));
            if(idx == -1) return SendError(playerid, "Данная модель не числится за этой фракцией.");
            DestroyVehicleVEx(vehicleid);
            veh_info[vehicleid][v_lock] = 0;

            FractionsData[frac_id][fVehModelMaxCount][idx]--;
            if(FractionsData[frac_id][fVehModelMaxCount][idx] <= 0)
            {
                FractionsData[frac_id][fVehModelsID][idx] =
                FractionsData[frac_id][fVehModelMaxCount][idx] =
                FractionsData[frac_id][fVehModelUseCount][idx] = 0;
                if(idx < MAX_FRACTIONS_VEHICLES-1)
                {
                    for(new i = idx; i < MAX_FRACTIONS_VEHICLES; i++)
                    {
                        FractionsData[frac_id][fVehModelsID][i] = FractionsData[frac_id][fVehModelsID][i+1];
                        FractionsData[frac_id][fVehModelMaxCount][i] = FractionsData[frac_id][fVehModelMaxCount][i+1];
                        FractionsData[frac_id][fVehModelUseCount][i] = FractionsData[frac_id][fVehModelUseCount][i+1];
                        FractionsData[frac_id][fVehAccessRank][i] = FractionsData[frac_id][fVehAccessRank][i+1];
                        if(i+2 < MAX_FRACTIONS_VEHICLES && FractionsData[frac_id][fVehModelsID][i+2] == 0)
                        {
                            FractionsData[frac_id][fVehModelsID][i+1] =
                            FractionsData[frac_id][fVehModelMaxCount][i+1] =
                            FractionsData[frac_id][fVehModelUseCount][i+1] = 0;
                            FractionsData[frac_id][fVehAccessRank][i+1] = 1;
                            break;
                        }
                    }
                }
            }
            SaveFractionVehParkings(frac_id);

            SendAccess(playerid, "Вы продали фракционный транспорт.");
            // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) продал фрак. транспорт <Infernus>(411)[133] в гос за 100$
            Log(LOG_player, INFO, "%s[%d](%s %s)[%d$] продал фрак. транспорт <%s>(%d) из %s в гос за %d",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), GetFractionName(p_info[playerid][member]), price);

            SetPlayerMoney(playerid, price, true, "");
            return 1;
        }
        case D_FRACTION_VEHICLE_RANK:
        {
            if(!response) return callcmd::fcars(playerid, "/0");
            new rank = strval(inputtext);
            if(!strlen(inputtext) || rank < 1 || rank > 10) return SendError(playerid, "Ранг должен быть не менее 1 и не более 10.");
            if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "Вы должны находиться в транспортном средстве.");
            new vehicleid = GetPlayerVehicleID(playerid);
            if(veh_info[vehicleid][v_npoType] != NPO_FACTION || veh_info[vehicleid][v_npoId] != p_info[playerid][member]) return SendError(playerid, "Транспортное средство не принадлежит Вашей фракции.");
            if(veh_info[vehicleid][v_owner_id] != INVALID_MYSQL_ID) return SendError(playerid, "Транспортным средством владеет игрок.");
            new frac_id = p_info[playerid][member];
            new idx = GetSlotFractionVehicle(frac_id, GetVehicleModelEx(vehicleid));
            if(idx == -1) return SendError(playerid, "Данная модель не числиться за этой фракцией.");

            FractionsData[frac_id][fVehAccessRank][idx] = rank;
            SaveFractionVehParkings(frac_id);

            SendAccess(playerid, "Вы изменили ранг для транспортного средства.");
            return 1;
        }
        case D_VACANCY:
        {
            if(!response) return 1;
            if(listitem == -1) return 1;
            if(p_temp[playerid][p_listitem][listitem] == -1) return 1;
            new idx = p_temp[playerid][p_listitem][listitem];
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Собеседование в %s.\n\n\
            Информация:\n\
            \t%s\n\
            Время:\n\
            \t%s", GetFractionName(idx), VacancyInfo[idx], VacancyTime[idx]);
            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Вакансии", STRING_GLOBAL, "Отмена", "");
        }
        case D_SET_VACANCY:
        {
            if(!response) return 1;
            new idx = p_info[playerid][member];
            switch(listitem)
            {
                case 0:
                {
                    if(Vacancy[idx] == 0)
                    {
                        Vacancy[idx] = 1;
                        SendAccess(playerid, "Вы объявили о собеседовании, заполните о нем информацию.");
                    }
                    else
                    {
                        Vacancy[idx] = 0;
                        SendAccess(playerid, "Вы завершили собеседование.");
                    }
                }
                case 1: ShowPlayerDialog(playerid, D_SET_VACANCY_INFO, DIALOG_STYLE_INPUT, ""I"Информация", ""W"Введите информацию о собеседовании:", "Далее", "Отмена");
                case 2: ShowPlayerDialog(playerid, D_SET_VACANCY_TIME, DIALOG_STYLE_INPUT, ""I"Время", ""W"Введите время собеседования:", "Далее", "Отмена");
            }
        }
        case D_SET_VACANCY_INFO:
        {
            if(!response) return callcmd::setvacancy(playerid, "/0");
            new _VacancyInfo[144];
            if(sscanf(inputtext, "s[144]", _VacancyInfo)) return ShowPlayerDialog(playerid, D_SET_VACANCY_INFO, DIALOG_STYLE_INPUT, ""I"Информация", ""W"Введите информацию о собеседовании:", "Далее", "Отмена");
            new idx = p_info[playerid][member];
            format(VacancyInfo[idx], 144, _VacancyInfo);
            SendAccess(playerid, "Вы изменили информацию о собеседовании на \"%s\".", VacancyInfo[idx]);
        }
        case D_SET_VACANCY_TIME:
        {
            if(!response) return callcmd::setvacancy(playerid, "/0");
            new _VacancyTime[144];
            if(sscanf(inputtext, "s[144]", _VacancyTime)) return ShowPlayerDialog(playerid, D_SET_VACANCY_TIME, DIALOG_STYLE_INPUT, ""I"Время", ""W"Введите время собеседования:", "Далее", "Отмена");
            new idx = p_info[playerid][member];
            format(VacancyTime[idx], 144, _VacancyTime);
            SendAccess(playerid, "Вы изменили время собеседования на \"%s\".", VacancyTime[idx]);
        }
        case D_DUTY_PIZZABOY:
        {
            if(!response) return 1;
            if(p_temp[playerid][Work_ID] == PIZZABOY_WORK) return EndPlayerJob(playerid);
            StartPlayerJob(playerid, PIZZABOY_WORK);
            return 1;
        }
        case D_DUTY_FIREMAN:
        {
            if(!response) return 1;
            if(p_temp[playerid][Work_ID] == FIREMAN_WORK) return EndPlayerJob(playerid);
            StartPlayerJob(playerid, FIREMAN_WORK);
            return 1;
        }
        case D_DUTY_ROADMAN:
        {
            if(!response) return 1;
            if(p_temp[playerid][Work_ID] == ROADMAN_WORK) return EndPlayerJob(playerid);
            StartPlayerJob(playerid, ROADMAN_WORK);
            return 1;
        }
        case D_DUTY_TRAM:
        {
            if(!response) return 1;
            if(p_temp[playerid][Work_ID] == TRAM_WORK) return EndPlayerJob(playerid);
            StartPlayerJob(playerid, TRAM_WORK);
            return 1;
        }
        case D_DUTY_LABORATORY:
        {
            if(!response) return 1;
            if(p_temp[playerid][Work_ID] == LABORATORY_WORK) return EndPlayerJob(playerid);
            StartPlayerJob(playerid, LABORATORY_WORK);
            return 1;
        }
        case D_DUTY_COLLECTOR:
        {
            if(!response) return 1;
            if(p_temp[playerid][Work_ID] == COLLECTOR_WORK) return EndPlayerJob(playerid);
            StartPlayerJob(playerid, COLLECTOR_WORK);
            return 1;
        }
        case D_DUTY_ELECTRIC:
        {
            if(!response) return 1;
            if(p_temp[playerid][Work_ID] == ELECTRIC_WORK) return EndPlayerJob(playerid);
            StartPlayerJob(playerid, ELECTRIC_WORK, listitem == 0 ? 0 : 1);
            return 1;
        }
        case D_DUTY_OIL:
        {
            if(!response) return 1;
            if(p_temp[playerid][Work_ID] == OIL_WORK) return EndPlayerJob(playerid);
            StartPlayerJob(playerid, OIL_WORK);
            return 1;
        }
        case D_DUTY_TREASURE_HUNTER:
        {
            if(!response) return 1;
            if(p_temp[playerid][Work_ID] == TREASURE_HUNTER_WORK) return EndPlayerJob(playerid);
            StartPlayerJob(playerid, TREASURE_HUNTER_WORK);
            return 1;
        }
        case D_TREASURE_HUNTER:
        {
            switch(p_temp[playerid][t_hunter_game])
            {
                case TYPE_T_HUNTER_BUTTON_DYNAMITE:
                {
                    UpdatePlayerTHunterButton(playerid);
                    ClearTHunterButton(playerid);
                }
                case TYPE_T_HUNTER_BUTTON_PRIZE:
                {
                    HideTextDrawForPlayer(playerid, TD_ID_T_HUNTER_GAME);
                    SetPlayerTHunter(playerid);
                    ShowTextDrawForPlayer(playerid, TD_ID_T_HUNTER_GPS);
