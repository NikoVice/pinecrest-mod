        }*/
        case D_NOTIFICATION:
        {
            if(!response) return 1;
            callcmd::notify(playerid, "/0");
            return 1;
        }
        case D_HOSPITAL_BED:
        {
            if(!response) {
                SendError(playerid, "Вы отказались от аренды койки.");

                p_temp[playerid][hospital_bed_id] = -1;
                return 1;
            }

            new Float:ac_health;
            GetPlayerHealth(playerid, ac_health);
            if(ac_health < 80)
            {
                if(p_info[playerid][cash] < BED_PRICE) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                new bed_id = p_temp[playerid][hospital_bed_id],
                    hospital_id = GetPlayerVirtualWorld(playerid) - 1;
                if(hospital_id > 2) return SendError(playerid, "Что-то пошло не так, попробуйте заново или обновите версию клиента.");
                HospitalBedInfo[bed_id][hb_Busy][hospital_id] = playerid;
                SendAccess(playerid, "Вы арендовали место в палате.");
                SendInfo(playerid, "Лечение пройдет в несколько раз быстрее.");

                SetPlayerMoney(playerid, -BED_PRICE, true, "заплатил за койку");

                STRING_GLOBAL[0] = EOS;
                f(STRING_GLOBAL, ""I"\
                Койка: "W"#%d"I"\n\n\
                Пациент: "W"%s", bed_id+1, get_name(playerid));
                UpdateDynamic3DTextLabelText(HospitalBedInfo[bed_id][hb_Text][hospital_id], COLOR_MAIN, STRING_GLOBAL);
            }
            else
            {
                SendError(playerid, "Вы не находитесь на лечении.");
                p_temp[playerid][hospital_bed_id] = -1;
            }
            return 1;
        }
        case D_SELL_GUN:
        {
            if(!response) return 1;
            new id_list, target, price, patron_count;
            if(sscanf(inputtext, "p<,>iiii", id_list, patron_count, target, price))
            {
                callcmd::sellgun(playerid, "/0");
                return SendError(playerid, "Вы ничего не ввели.");
            }
            id_list--;
            if(!(0 <= id_list <= sizeof(gangWEAPON)-1))
            {
                callcmd::sellgun(playerid, "/0");
                return SendError(playerid, "Вы ввели неверный ID пункта.");
            }
            if(target == INVALID_PLAYER_ID)
            {
                callcmd::sellgun(playerid, "/0");
                return SendError(playerid, "Игрок не найден.");
            }
            if(target == playerid)
            {
                SendError(playerid, "Вы ввели свой ID.");
                return callcmd::sellgun(playerid, "/0");
            }
            if(!IsPlayerStream(5.0, playerid, target) || pSpectateId[target] != INVALID_PLAYER_ID) {
                SendError(playerid, "Игрок слишком далеко от Вас.");
                return callcmd::sellgun(playerid, "/0");
            }
            if(p_info[target][level] < 3)
            {
                SendError(playerid, "У игрока нет 3-его уровня.");
                return callcmd::sellgun(playerid, "/0");
            }
            if(p_info[target][Lic][LIC_WEAPON] != 1)
            {
                SendError(playerid, "У игрока нет лицензии на \"%s\".", name_license[LIC_WEAPON]);
                return callcmd::sellgun(playerid, "/0");
            }
            if(!(1 <=  patron_count <= GetInventoryAmount(playerid, 628)))
            {
                SendError(playerid, "У Вас нет столько патронов.");
                return callcmd::sellgun(playerid, "/0");
            }
            if(!(1 <= price <= 10_000))
            {
                SendError(playerid, "Стоимость должна быть не менее 1$ и не более 10000$.");
                return callcmd::sellgun(playerid, "/0");
            }

            SendAccess(playerid, "Вы предложили %s [%d] приобрести \"%s\" с %d патронами за %d$.", get_name(target), target, WEAPON_Name[gangWEAPON[id_list][g_Id]], patron_count, price);
            SendInfo(target, "%s [%d] предложил Вам приобрести \"%s\" с %d патронами за %d$.", get_name(playerid), playerid, WEAPON_Name[gangWEAPON[id_list][g_Id]], patron_count, price);

            p_temp[target][p_listitem][10] = id_list;
            SetFreeSlotOffer(target, playerid, OFFER_ID_SELL_GUN, price, patron_count, id_list);
            return 1;
        }
        case D_PHONE_BALANCE_ADD:
        {
            if(!strlen(inputtext) || !response)
                return 1;
            new value;
            if(sscanf(inputtext, "i", value))
            {
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                Чтобы "I"пополнить"W" баланс телефона, введите количество:\n\n\
                Баланс телефона: "I"$%d.", p_info[playerid][phone_balance]);
                ShowPlayerDialog(playerid, D_PHONE_BALANCE_ADD, DIALOG_STYLE_INPUT, ""I"Пополнить баланс телефона", STRING_GLOBAL, "Далее", "Отмена");
                return 1;
            }
            if(!(1 <= value <= 500))
            {
                SendError(playerid, "Максимальный баланс телефона 500$.");
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                Чтобы "I"пополнить"W" баланс телефона, введите количество:\n\n\
                Баланс телефона: "I"$%d.", p_info[playerid][phone_balance]);
                ShowPlayerDialog(playerid, D_PHONE_BALANCE_ADD, DIALOG_STYLE_INPUT, ""I"Пополнить баланс телефона", STRING_GLOBAL, "Далее", "Отмена");
                return 1;
            }
            if(p_info[playerid][cash] < value)
            {
                SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                Чтобы "I"пополнить"W" баланс телефона, введите количество:\n\n\
                Баланс телефона: "I"$%d.", p_info[playerid][phone_balance]);
                ShowPlayerDialog(playerid, D_PHONE_BALANCE_ADD, DIALOG_STYLE_INPUT, ""I"Пополнить баланс телефона", STRING_GLOBAL, "Далее", "Отмена");
                return 1;
            }
            if(p_info[playerid][phone_balance] + value > 500)
            {
                SendError(playerid, "Максимальный баланс телефона 500$.");
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                Чтобы "I"пополнить"W" баланс телефона, введите количество:\n\n\
                Баланс телефона: "I"$%d.", p_info[playerid][phone_balance]);
                ShowPlayerDialog(playerid, D_PHONE_BALANCE_ADD, DIALOG_STYLE_INPUT, ""I"Пополнить баланс телефона", STRING_GLOBAL, "Далее", "Отмена");
                return 1;
            }

            new tax = GetTaxCount(playerid, value, TAX_PHONE_BALANCE_ADD);

            SetPlayerMoney(playerid, -value, true, "пополнил баланс телефона");
            p_info[playerid][phone_balance] += value - tax;
            SendAccess(playerid, "Вы пополнили баланс телефона на %d$. Налог: %d$.", value, tax);

            SetFractionWarehouse(MAYOR_LS, fwMoney, tax);
            return 1;
        }
        case D_BANK_DEPOSIT:
        {
            if(!response)
            {
                if(!strlen(inputtext))
                    return 1;

                new
                    fix_listitem = 0;

                if(sscanf(inputtext, "i", fix_listitem))
                    return 1;

                if(p_info[playerid][bank_deposit] < fix_listitem)
                    return SendError(playerid, "У Вас нет столько денег на банковском вкладе."), ShowBankDeposit(playerid);

                if(p_info[playerid][bank_deposit_limit_take])
                    return SendError(playerid, "Вы не можете снимать деньги с банковского вклада в течение %d час(-а/-ов).", p_info[playerid][bank_deposit_limit_take]), ShowBankDeposit(playerid);

                if(!(1 <= fix_listitem <= 1000000))
                    return SendError(playerid, "Вы не можете снять менее 1$ и более 1000000$."), ShowBankDeposit(playerid);

                SetPlayerMoney(playerid, fix_listitem, true, "снял с банковского вклада");

                p_info[playerid][bank_deposit] -= fix_listitem;
                p_info[playerid][bank_deposit_limit_take] = 0;

                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank_deposit` = %d, `bank_deposit_limit_take` = %d WHERE `id` = %d",
                p_info[playerid][bank_deposit], p_info[playerid][bank_deposit_limit_take], p_info[playerid][ID]);
                mysql_tquery(con_bd, STRING_GLOBAL);

                SendAccess(playerid, "Вы сняли с банковского вклада: %d$. Всего: %d$.", fix_listitem, p_info[playerid][bank_deposit]);

                ShowBankDeposit(playerid);
                return 1;
            }
            else
            {
                if(!strlen(inputtext))
                    return 1;

                new
                    fix_listitem = 0;

                if(sscanf(inputtext, "i", fix_listitem))
                    return 1;

                if(p_info[playerid][cash] < fix_listitem)
                    return SendError(playerid, "У Вас нет столько денег. Используйте /donate"), ShowBankDeposit(playerid);

                if(!(1 <= fix_listitem <= 10_000_000))
                    return SendError(playerid, "Вы не можете положить менее 1$ и более 10 000 000$."), ShowBankDeposit(playerid);

                if(p_info[playerid][bank_deposit] + fix_listitem > max_deposit)
                    return SendError(playerid, "На банковском вкладе не может быть более %d$.", max_deposit), ShowBankDeposit(playerid);

                SetPlayerMoney(playerid, -fix_listitem, true, "пополнил банковский вклад");

                p_info[playerid][bank_deposit] += fix_listitem;
                p_info[playerid][bank_deposit_limit_take] = 3;

                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank_deposit` = %d, `bank_deposit_limit_take` = %d WHERE `id` = %d",
                p_info[playerid][bank_deposit], p_info[playerid][bank_deposit_limit_take], p_info[playerid][ID]);
                mysql_tquery(con_bd, STRING_GLOBAL);

                SendAccess(playerid, "Вы положили на банковский вклад: %d$. Всего: %d$.", fix_listitem, p_info[playerid][bank_deposit]);

                ShowBankDeposit(playerid);
                return 1;
            }
        }
