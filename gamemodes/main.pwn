CMD:gettax(playerid, params[])
{
    if(p_info[playerid][admin] < 4)
        return 1;

    if(isnull(params))
        return SendInfo(playerid, "�����������: /gettax [id �������]");

    new
        fraction = strval(params);

    if(!(1 <= fraction <= 21))
        return SendError(playerid, "�������� ID �������.");

