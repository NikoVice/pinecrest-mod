            if(!response) return OnServerShowDialogDuelMenu(playerid);
            switch(listitem)
            {
                case 0: DuelData[duelid][dGun] = WEAPON_DEAGLE;
                case 1: DuelData[duelid][dGun] = WEAPON_SHOTGUN;
                case 2: DuelData[duelid][dGun] = WEAPON_AK47;
                case 3: DuelData[duelid][dGun] = WEAPON_M4;
                case 4: DuelData[duelid][dGun] = WEAPON_MP5;
            }
            for(new i; i < 10; i++)
            {
                if(DuelData[duelid][dCommand1][i] != INVALID_PLAYER_ID)
                    SendAccess(DuelData[duelid][dCommand1][i], "%s [%d] установил оружие (%s) для дуэли.", get_name(playerid), playerid, WEAPON_Name[DuelData[duelid][dGun]]);

                if(DuelData[duelid][dCommand2][i] != INVALID_PLAYER_ID)
                    SendAccess(DuelData[duelid][dCommand2][i], "%s [%d] установил оружие (%s) для дуэли.", get_name(playerid), playerid, WEAPON_Name[DuelData[duelid][dGun]]);
            }
            OnServerShowDialogDuelMenu(playerid);
            return 1;
