                    f(STRING_GLOBAL, ""W"\
                    Вы желаете приобрести "I"ускоритель опыта"W" за {"#cGREEN"}%d Pinecrest Money?"W"\n\n\
                    Данный предмет будет добавлен в инвентарь, в дальнейшем его можно будет активировать\n\
                    или продать другим игрокам на центральном рынке.\n\n\
                    {"#cLIGHTRED"}Обратите внимание! С ускорителем опыта за выполнение заданий будет начисляться в два раза больше опыта!",
                    BATTLEPASS_PRICE_SPEED);
                    ShowPlayerDialog(playerid, D_BATTLEPASS_BUY_SPEED, DIALOG_STYLE_MSGBOX, ""I"Battle Pass:"W" Покупка ускорителя опыта", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 2:
                {
                    if(p_info[playerid][battle_lvl] == MAX_BATTLEPASS_REWARD) return SendMes(playerid, COLOR_DARKORANGE, "[BATTLE PASS]:"W" У Вас максимальный уровень.");
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, ""W"\
                    Введите количество уровней, которое хотите приобрести:\n\n\
                    Доступно: %s\n\
                    Стоимость 1-го уровня: {"#cGREEN"}%d Pinecrest Money", GetPlayerBattlePassLevel(playerid), BATTLEPASS_PRICE_LVL);
                    ShowPlayerDialog(playerid, D_BATTLEPASS_BUY_LEVEL, DIALOG_STYLE_INPUT, ""I"Battle Pass:"W" Покупка уровня", STRING_GLOBAL, "Далее", "Отмена");
                }
