        case D_AC_SETMAXWARNS:
        {
            if(!response)
            {
                DeletePVar(playerid, "ACPANEL:CHEAT");
                return ShowCheatList(playerid, D_AC_MAXWARNS);
            }

            new cheat = GetPVarInt(playerid, "ACPANEL:CHEAT");
            new maxwarns = strval(inputtext);
            if(maxwarns == 0)
