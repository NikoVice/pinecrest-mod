            else SendAccess(playerid, "�� ��������� %d ��. \"%s\" - %s �� %d Pinecrest Money.", iCount, DonateName[type], DonateInfo[i][dName], price);
            if(message_show) SendInfo(playerid, "����� �������� �������: /items");
