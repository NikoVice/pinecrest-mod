            return 1;
        }
        case D_COSTUME:
        {
            if(!response) return 1;
            if(p_info[playerid][costume][listitem] == 0) return SendError(playerid, "У Вас нет этого костюма."), ShowPlayerCostume(playerid);
            if(p_info[playerid][costume_use][listitem] == 1) return TakePlayerAttachedCostume(playerid, listitem, true);
            if(GetPlayerAttachedCostume(playerid) != -1) TakePlayerAttachedCostume(playerid, GetPlayerAttachedCostume(playerid), true);
            SetPlayerAttachedCostume(playerid, listitem, true);
            return 1;
        }
        case D_MISSION:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0: ShowPlayerMission(playerid, MISSION_TYPE_START_TASK, 0);
                case 1: ShowPlayerMission(playerid, MISSION_TYPE_DAILY_TASK, 32);
                case 2: ShowPlayerMission(playerid, MISSION_TYPE_DAILY_FRACTION, 32);
                case 3: ShowPlayerMission(playerid, MISSION_TYPE_ACHIEVEMENT, 100);
                case 4: ShowPlayerMissionInfo(playerid, MISSION_TYPE_START_TASK);
                case 5: ShowPlayerMissionInfo(playerid, MISSION_TYPE_DAILY_TASK);
                case 6: ShowPlayerMissionInfo(playerid, MISSION_TYPE_ACHIEVEMENT);
                case 7: callcmd::daily(playerid, "/0");
                case 8:
                {
                    if(p_info[playerid][level] < 3) return SendError(playerid, "Бесплатная рулетка доступна с 3-его уровня.");
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    За каждые %d часа игры на сервере выдается случайная рулетка.\n\
                    Для получения бесплатной рулетки отыграно: "I"%s."W"\n\n\
                    {"#cLIGHTRED"}ВАЖНО! БЕСПЛАТНАЯ РУЛЕТКА ВЫДАЕТСЯ АВТОМАТИЧЕСКИ И ПОЯВЛЯЕТСЯ В СПИСКЕ ПРИЗОВ "W"/ITEMS\n\
                    {"#cLIGHTRED"}ВАЖНО! ВОСПОЛЬЗОВАТЬСЯ БЕСПЛАТНОЙ РУЛЕТКОЙ: "W"/mn > [15] Рулетка", GetPlayerRoulettePayDay(playerid), ConvertTime(p_info[playerid][free_roulette_time]));
                    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Бесплатная рулетка", STRING_GLOBAL, "ОК", "");
                }
            }
            return 1;
        }
        case D_MISSION_START_TASK:
        {
            if(!response) return callcmd::mission(playerid, "/0");
            if(listitem == MissionDialogListitem[playerid][1])
            {
                ShowPlayerMission(playerid, MISSION_TYPE_START_TASK, MissionDialogListitem[playerid][0] == 0 ? 16 : 0);
            }
            else
            {
                ShowPlayerMission(playerid, MISSION_INFO_START_TASK, listitem);
            }
            return 1;
        }
        case D_MISSION_DAILY_TASK:
        {
            if(!response) return callcmd::mission(playerid, "/0");
            if(listitem == MissionDialogListitem[playerid][1])
                ShowPlayerMission(playerid, MISSION_TYPE_DAILY_TASK, MissionDialogListitem[playerid][0] == 0 ? 47 : 32);
            else
                ShowPlayerMission(playerid, MISSION_INFO_DAILY_TASK, listitem);
            return 1;
        }
        case D_MISSION_ACHIEVEMENT:
        {
