                            �� ������������� ������ ���������� ������ ������������ ��������?", STRING_GLOBAL,
                            veh_info[vehicleid][v_twinturbo_data][tt_suspension],veh_info[vehicleid][v_twinturbo_data][tt_transmission],
                            veh_info[vehicleid][v_twinturbo_data][tt_turbocharging],veh_info[vehicleid][v_twinturbo_data][tt_engine],
                            veh_info[vehicleid][v_details][0], veh_info[vehicleid][v_details][1], veh_info[vehicleid][v_details][2],
                            veh_info[vehicleid][v_details][3], veh_info[vehicleid][v_details][4],
                            floatround(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_SPEED)),
