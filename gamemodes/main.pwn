            if(fix_listitem < 1000 || fix_listitem > 100000000) return SendError(playerid, "Ставка должна быть не менее 1000$ и не более 100000000$."), UpdateBone(s);
            if(DiceInfo[s][bank] > 0) return SendError(playerid, "В данный момент нельзя изменять настройки стола, стоит ставка.");
            if(DiceInfo[s][game_start] != 0) return SendError(playerid, "В данный момент нельзя изменять настройки стола, началась игра.");
            DiceInfo[s][bet] = fix_listitem;
            SendAccess(playerid, "Вы установили ставку на этом столе.");
            return UpdateBone(s);
        }
        case D_BIZ_LIST:
        {
            if(!response) return 1;
            new fracid = -1, count_business = 1;
            switch(p_info[playerid][member])
            {
                case MAFIA_RM: fracid = BANK_RM;
                case MAFIA_LCN: fracid = BANK_LCN;
                case MAFIA_YAKUDZA: fracid = BANK_YAKUZA;
                case BIKER: fracid = BANK_BIKER;
                case MAFIA_IRAN: fracid = BANK_IRAN;
            }
            STRING_GLOBAL[0] = EOS;
            STRING_GLOBAL = "№. Название + Доход бизнеса за последний час\n\n";
            for(new i=51; i< totalbizz; i++)
            {
                if(b_info[i][b_mysql_id] == INVALID_MYSQL_ID) continue;
                if(b_info[i][b_mafia] != p_info[playerid][member]) continue;
                if(fracid == -1) continue;
                format(STRING_GLOBAL, sizeof STRING_GLOBAL, "%s%i. %s + {77FF1B}%d$"W"\n",STRING_GLOBAL, count_business, b_info[i][_name], gBankMafia[fracid][i]);
                count_business++;
            }
            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Бизнесы мафий и байкеров", STRING_GLOBAL, "Закрыть", "");
            return 1;
        }
