                ShowPlayerDialog(playerid, D_FAMILY_BUY_EXP, DIALOG_STYLE_INPUT, ""I"Семейные EXP", STRING_GLOBAL, "Далее", "Отмена");
                return 1;
            }
            if(p_info[playerid][flinmoney] < fix_listitem)
            {
                SendError(playerid, "У Вас нет столько Pinecrest Money.");
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                Вы желаете приобрести семейные EXP?\n\n\
                Информация: {"#cLIGHTRED"}семейные EXP расширяют ее возможности."W"\n\n\
