            for(new i = p_temp[playerid][p_listitem_int]; i < family_count; i++) {
                if(i >= count+50) break;
                if(FamilyData[i][fMysqlID] == -1) continue;
                f(STRING_GLOBAL,  "%s№%d - {0ee33e}%s"W"(Game ID: "I"%d"W")\n", STRING_GLOBAL, i+1, FamilyData[i][fName], i);
                p_temp[playerid][p_listitem_int]++;
