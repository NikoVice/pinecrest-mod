    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"����� 200000$, 200 Pinecrest Money, VIP-������� � BMW M5 E60", STRING_GLOBAL, "�������", "");
    return 1;
}

