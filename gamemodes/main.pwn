        case D_AHELP_BACK:
        {
            if(!response) return callcmd::ahelp(playerid, "/0");
            return 1;
        }
        case D_REPORT_LIST:
        {
            if(!response) return 1;
            if(aReportInfo[listitem][rIsTooked] == false) ShowPlayer_Admin_Report_Answer(playerid, listitem);
            else SendError(playerid, "Администрация уже работает по данной жалобе.");
            return 1;
        }
        case D_REPORT_ANS:
        {
            new report_id = GetPVarInt(playerid, "report_id_to_answer");
            if(report_id == -1) return ShowPlayer_Admin_Report_List(playerid);
            if(!response)
            {
                aReportInfo[report_id][rIsTooked] = false;
                DeletePVar(playerid, "report_id_to_answer");
                DeletePVar(playerid, "report_playerid");
                ShowPlayer_Admin_Report_List(playerid);
                return 1;
            }
            if(!strlen(inputtext))
            {
                aReportInfo[report_id][rIsTooked] = false;
                DeletePVar(playerid, "report_id_to_answer");
                DeletePVar(playerid, "report_playerid");
                ShowPlayer_Admin_Report_List(playerid);
                return 1;
            }
            new target_id = aReportInfo[report_id][rPlayerID];
            if(target_id == INVALID_PLAYER_ID || !IsPlayerConnected(target_id))
            {
                aReportInfo[report_id][rIsTooked] = false;
                DeletePVar(playerid, "report_id_to_answer");
                DeletePVar(playerid, "report_playerid");
                ShowPlayer_Admin_Report_List(playerid);
                SendError(playerid, "Игрок не в игре.");
                return 1;
            }
            if(target_id != GetPVarInt(playerid, "report_playerid"))
            {
                aReportInfo[report_id][rIsTooked] = false;
                DeletePVar(playerid, "report_id_to_answer");
                DeletePVar(playerid, "report_playerid");
                ShowPlayer_Admin_Report_List(playerid);
                SendError(playerid, "Игрок уже получил ответ.");
                return 1;
            }
            if(inputtext[0] == 'r' && inputtext[1] == 'e')
            {
                new iReconPlayerID = INVALID_PLAYER_ID;
                if(strequals(inputtext, "re")) iReconPlayerID = target_id;
                else
                {
                    strdel(inputtext, 0, 2);
                    if(sscanf(inputtext, "u", iReconPlayerID) || iReconPlayerID == playerid || iReconPlayerID == INVALID_PLAYER_ID)
                    {
                        SendError(playerid, "Игрок с таким ID не найден.");
                        aReportInfo[report_id][rIsTooked] = false;
                        DeletePVar(playerid, "report_id_to_answer");
                        DeletePVar(playerid, "report_playerid");
                        ShowPlayer_Admin_Report_List(playerid);
                        return 1;
                    }
                }
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] ответил %s [%d]: Слежу, обрабатываю Вашу жалобу.", get_name(playerid), playerid, get_name(target_id), target_id);
                SendAdminMessage(0xD99B69FF, STRING_GLOBAL, true);

                STRING_GLOBAL[0] = EOS;
                f(STRING_GLOBAL, "%d", iReconPlayerID);
                callcmd::recon(playerid, STRING_GLOBAL);

                SendInfo(target_id, "Администратор %s [%d] ответил Вам: Слежу, обрабатываю Вашу жалобу.", get_name(playerid), playerid);
            
                Log(LOG_player, INFO, "%s[%d](%s %s) ответил %s[%d](%s %s): Слежу, обрабатываю Вашу жалобу. | #AdminLogs",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    get_name(target_id), p_info[target_id][ID], p_temp[target_id][session_IP], IsPlayerMobile(target_id) ? "Mobile": "PC");
            }
            else
            {
                if(!strlen(inputtext))
                {
                    aReportInfo[report_id][rIsTooked] = false;
                    DeletePVar(playerid, "report_id_to_answer");
                    DeletePVar(playerid, "report_playerid");
                    ShowPlayer_Admin_Report_List(playerid);
                    return 1;
                }

                if(target_id == INVALID_PLAYER_ID || !IsPlayerConnected(target_id))
                {
                    aReportInfo[report_id][rIsTooked] = false;
                    DeletePVar(playerid, "report_id_to_answer");
                    DeletePVar(playerid, "report_playerid");
                    ShowPlayer_Admin_Report_List(playerid);
                    SendError(playerid, "Игрок не в игре.");
                    return 1;
                }

                if(target_id != GetPVarInt(playerid, "report_playerid"))
                {
                    aReportInfo[report_id][rIsTooked] = false;
                    DeletePVar(playerid, "report_id_to_answer");
                    DeletePVar(playerid, "report_playerid");
                    ShowPlayer_Admin_Report_List(playerid);
                    SendError(playerid, "Игрок уже получил ответ.");
                    return 1;
                }
                
                STRING_GLOBAL[0] = EOS;
                if(p_info[playerid][helper] == 1)  format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[H] %s [%d] ответил %s [%d]: %s", get_name(playerid), playerid, get_name(target_id), target_id, inputtext);
                else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] ответил %s [%d]: %s", get_name(playerid), playerid, get_name(target_id), target_id, inputtext);
                SendAdminMessage(0xD99B69FF, STRING_GLOBAL, true);

                if(p_info[playerid][helper] == 1) SendInfo(target_id, "Помощник %s [%d] ответил Вам: %s", get_name(playerid), playerid, inputtext);
                else SendInfo(target_id, "Администратор %s [%d] ответил Вам: %s", get_name(playerid), playerid, inputtext);

                Log(LOG_player, INFO, "%s[%d](%s %s) ответил %s[%d](%s %s): %s | #AdminLogs",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    get_name(target_id), p_info[target_id][ID], p_temp[target_id][session_IP], IsPlayerMobile(target_id) ? "Mobile": "PC", inputtext);
            }
            DeletePVar(target_id, "report_id");

            aReportInfo[report_id][rID] = report_id;
            aReportInfo[report_id][rPlayerID] = INVALID_PLAYER_ID;
            aReportInfo[report_id][rText][0] = EOS;
            aReportInfo[report_id][rWhenWroted_Time] = -1;
            aReportInfo[report_id][rIsTooked] = false;
            aReportInfo[report_id][rWhenWroted_Text][0] = EOS;

            a_info[playerid][a_ans] = 1;
            MysqlUpdateAdminInt(playerid, "a_ans", a_info[playerid][a_ans]);
            ShowPlayer_Admin_Report_List(playerid);

            DeletePVar(playerid, "report_id_to_answer");
            DeletePVar(playerid, "report_playerid");
            return 1;
        }
        case D_WELCOME:
        {
            if(!response) return 1;
            STRING_GLOBAL[0] = EOS;
            for(new i; i < sizeof(StartInfoList); i++) strcat(STRING_GLOBAL, StartInfoList[i]);
            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"С чего начать", STRING_GLOBAL, "Закрыть", "");
            return 1;
        }
        case D_CANCEL_REPAIR:
        {
            if(!response) return 1;
            SetCameraBehindPlayer(playerid);
            OnHouseMappingBack(playerid, GetPlayerHouseID(playerid), p_temp[playerid][h_repair_txtid], p_temp[playerid][h_repair_old], 5);
            return 1;
        }
        case D_CANCEL_SKIN:
        {
            if(!response) return 1;
            HideTextDrawForPlayer(playerid, TD_ID_SHOP);

            SetCameraBehindPlayer(playerid);
            SetPlayerSkinEx(playerid);
            p_temp[playerid][shop_id] = 0;
        }
        case D_CANCEL_ACCESSORIES:
        {
            if(!response) return 1;
            HideTextDrawForPlayer(playerid, TD_ID_SHOP);

            SetCameraBehindPlayer(playerid);
            if(IsPlayerAttachedObjectSlotUsed(playerid, 0))
                RemovePlayerAttachedObject(playerid, 0);
            DeletePVar(playerid,"SelectAccessoriesType");
            p_temp[playerid][p_listitem_int] = -1;
        }
        case D_BUY_REPAIR:
        {
            if(!response) return 1;
            new txd_id = p_temp[playerid][h_repair_txtid],
                h = GetPlayerHouseID(playerid);

            if(p_info[playerid][cash] < h_info[h][h_squar]*TEXTURE_HOUSE_PRICE)
            {
                OnHouseMappingBack(playerid, h, p_temp[playerid][h_repair_txtid], p_temp[playerid][h_repair_old], 4);
                return SendError(playerid, "Недостаточно денег.");
            }
            if(p_temp[playerid][h_repair_list] != GARAGE_REPAIR_ID)
            {
                if(h_info[h][h_mapping_id][txd_id] == p_temp[playerid][h_repair_old])
                    return SendError(playerid, "У Вас уже установлена данная текстура.");

                save_house_interior(h, txd_id, p_temp[playerid][shop_id]);
                SendAccess(playerid, "Вы успешно купили ремонт "I"'%s'"W" за "I"%d$", h_info[h][h_squar] == 1 ? house_repair_name1[p_temp[playerid][h_repair_list]] : h_info[h][h_squar] == 2 ? house_repair_name2[p_temp[playerid][h_repair_list]] : h_info[h][h_squar] == 3 ? house_repair_name3[p_temp[playerid][h_repair_list]] : house_repair_name4[p_temp[playerid][h_repair_list]], h_info[h][h_squar]*TEXTURE_HOUSE_PRICE);
            }
            else
            {
                if(h_info[h][h_garage_id][txd_id] == p_temp[playerid][h_repair_old])
                    return SendError(playerid, "У Вас уже установлена данная текстура.");

                save_garage_interior(h, txd_id, p_temp[playerid][shop_id]);
                SendAccess(playerid, "Вы успешно купили ремонт "I"'%s'"W" за "I"%d$", p_temp[playerid][h_repair_txtid] == G_FOOR ? "Пол" : p_temp[playerid][h_repair_txtid] == G_WALL ?  "Стена" : "Потолок", h_info[h][h_squar]*TEXTURE_HOUSE_PRICE);
            }
            p_temp[playerid][h_repair_old] =
            p_temp[playerid][h_repair_list] =
            p_temp[playerid][h_repair_txtid] = -1;
            p_temp[playerid][shop_id] = 0;
            if(IsValidTimer(h_info[h][h_mapping_timer])) KillTimer(h_info[h][h_mapping_timer]);

            SetPlayerMoney(playerid, -(h_info[h][h_squar]*TEXTURE_HOUSE_PRICE), true, "ремонт дома");
            HideTextDrawForPlayer(playerid, TD_ID_SHOP);
            return 1;
        }
        case D_BUY_REAL_SKIN:
        {
            if(!response) return 1;
            if(!(0 <= p_temp[playerid][shop_id] <= sizeof(skinDonate)-1))
                return SendError(playerid, "Не определен ID скина для покупки.");
            new cost_skin = skinDonate[p_temp[playerid][shop_id]][1];
            if(p_info[playerid][flinmoney] < cost_skin) return SendError(playerid, "У Вас нет столько Pinecrest Money.");

            new skin_id = skinDonate[p_temp[playerid][shop_id]][0]; //getIDx

            if(!GivePlayerInventory(playerid, skin_id, .status_use = 1))
                return 1;

            p_info[playerid][flinmoney] -= cost_skin;
            MysqlUpdatePlayerInt(playerid, "flinmoney", p_info[playerid][flinmoney]);

            SendAccess(playerid, "Вы приобрели одежду %s.", ItemsInfo[skin_id][iName]);
            SendInfo(playerid, "Чтобы одеть воспользуйтесь инвентарем.");

            HideTextDrawForPlayer(playerid, TD_ID_SHOP);

            SetCameraBehindPlayer(playerid);
            p_temp[playerid][p_listitem_int] = -1;
            p_temp[playerid][shop_id] = 0;

            CheckPlayerMission(playerid, START_CLOTHES);

            Log(LOG_player, INFO, "%s[%d](%s %s) приобрел 1ед. Real Skin - ID: %d за %d Pinecrest Money | #Donate",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", 
                ItemsInfo[skin_id][iModel], cost_skin);
        }
        case D_BUY_SKIN:
        {
            if(!response) return 1;
            BuySkinShop(playerid);
            return 1;
        }
        case D_BUY_ACCESSORIES:
        {
            if(!response) return 1;
            HideTextDrawForPlayer(playerid, TD_ID_SHOP);
            new iAccID = p_temp[playerid][p_listitem][p_temp[playerid][shop_id]];

            p_temp[playerid][shop_id] = 0;
            p_temp[playerid][p_listitem_int] = -1;
            DeletePVar(playerid, "SelectAccessoriesType");

            if(p_info[playerid][cash] < ItemsInfo[iAccID][iPrice]) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            if(!GivePlayerInventory(playerid, iAccID, .reason = "покупка в магазине аксессуаров"))
                return 1;
            if(IsPlayerAttachedObjectSlotUsed(playerid, 0)) RemovePlayerAttachedObject(playerid, 0);

            SendAccess(playerid, "Вы приобрели аксессуар.");
            SetCameraBehindPlayer(playerid);
            SetPlayerMoney(playerid, -ItemsInfo[iAccID][iPrice], true, "купил аксессуар <%s>(%d)", ItemsInfo[iAccID][iName], iAccID);



            new biz_id = GetPVarInt(playerid, "bID");
            if(b_info[biz_id][_prod] >= (((ItemsInfo[iAccID][iPrice] / 100) * 50) - ((ItemsInfo[iAccID][iPrice] / 100) * 10)) / 100)
            {
                b_info[biz_id][_prod] -= (((ItemsInfo[iAccID][iPrice] / 100) * 50) - ((ItemsInfo[iAccID][iPrice] / 100) * 10)) / 100;
                b_info[biz_id][_bank] += (((ItemsInfo[iAccID][iPrice] / 100) * 50) - (ItemsInfo[iAccID][iPrice] / 100) * 10);
                AddMafiaBank(biz_id, (ItemsInfo[iAccID][iPrice] / 100) * 10);

                biz_finka[biz_id] += (((ItemsInfo[iAccID][iPrice] / 100) * 50) - (ItemsInfo[iAccID][iPrice] / 100) * 10);
                UpdateIntForFinanceBiz(biz_id, (((ItemsInfo[iAccID][iPrice] / 100) * 50) - (ItemsInfo[iAccID][iPrice] / 100) * 10));
            }
        }
        case D_PHONE_CALL:
        {
            if(response)
            {
                new number = strval(inputtext);
                if(number >= 0 && strlen(inputtext))
                {
                    new params[5];
                    format(params, 5, "%d", number);
                    callcmd::call(playerid, params);
                }
                else SendError(playerid, "Вы ничего не ввели.");
            }
        }
        case D_PHONE_CALL_SERVICE:
        {
            if(!response) return 1;
            if(!strlen(inputtext)) return SendError(playerid, "Вы ничего не ввели.");
            SetPVarInt(playerid, "call:flood", timestamp+30);
            new fraction_id, Float:pos[3];
            GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
            fraction_id = GetPlayerPositionCity(playerid, pos[0], pos[1], pos[2]);

            switch(GetPVarInt(playerid, "CALL:SERVICES"))
            {
                case 1: // полиция
                {
                    SendInfo(playerid, "911 Оператор (телефон): Мы известили все подразделения в Вашем районе, пожалуйста, оставайтесь на месте.");

                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] вызывает полицию. Он сейчас в \"%s\", район \"%s\". Принять вызов: /mdc (в машине).", get_name(playerid), playerid, gSAZonesCity[GetCityName(pos[0],pos[1])][SAZONE_NAME], gSAZones[GetZonaName(pos[0],pos[1])][SAZONE_NAME]);
                    SendFractionMessage(fraction_id, 0x33CC66FF, STRING_GLOBAL);
                    if(fraction_id == POLICE_LS) SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Сообщение: %s", inputtext);
                    SendFractionMessage(fraction_id, 0x33CC66FF, STRING_GLOBAL);
                    if(fraction_id == POLICE_LS) SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);

                    Add_Call(playerid, 1, inputtext);
                }
                case 2: // скорая
                {
                    SendAccess(playerid, "Вы вызвали медиков.");
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] вызывает медиков. Он сейчас в \"%s\", район \"%s\". Принять вызов: /to %d", get_name(playerid), playerid, gSAZonesCity[GetCityName(pos[0],pos[1])][SAZONE_NAME], gSAZones[GetZonaName(pos[0],pos[1])][SAZONE_NAME], playerid);
                    SendFractionMessage(fraction_id+14, 0x33CC66FF, STRING_GLOBAL);
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Сообщение: %s", inputtext);
                    SendFractionMessage(fraction_id+14, 0x33CC66FF, STRING_GLOBAL);
                }
                case 3: // такси
                {
                    new idx = p_temp[playerid][tc_call_idx], type = p_temp[playerid][tc_call_type];
                    SendAccess(playerid, "Вы вызвали такси.");
                    new rentedVehicle = INVALID_VEHICLE_ID;
                    foreach(new i : Player)
                    {
                        if(p_info[playerid][taxi_idx] == 0) continue;

                        rentedVehicle = p_temp[i][rented_veh];

                        if(rentedVehicle != INVALID_VEHICLE_ID && veh_info[rentedVehicle][v_npoType] == NPO_JOB && veh_info[rentedVehicle][v_npoId] == JOB_TC_TAXI && GetBizVehicleType(rentedVehicle) == type || IsPlayerInAnyVehicle(i) && IsPlayerOwnerVehicle(playerid, GetPlayerVehicleID(i)) && p_info[i][Lic][LIC_TAXI] == 1 && GetBizVehicleType(GetPlayerVehicleID(i)) == type)
                        {
                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[%s: %s [%d]]: %s [%d] вызывает такси \"%s\" класса.", bizz_type_name[b_info[idx][_tip]], b_info[idx][_name], b_info[idx][b_mysql_id], get_name(playerid), playerid, TransportCompanyFareName[type]);
                            SendTransportCompanyMes(idx, 0, 0x33CC66FF, STRING_GLOBAL);
                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[%s: %s [%d]]: Он сейчас в %s, район %s.(( Принять вызов: /to %d. ))", bizz_type_name[b_info[idx][_tip]], b_info[idx][_name], b_info[idx][b_mysql_id], gSAZonesCity[GetCityName(pos[0],pos[1])][SAZONE_NAME], gSAZones[GetZonaName(pos[0],pos[1])][SAZONE_NAME], playerid);
                            SendTransportCompanyMes(idx, 0, 0x33CC66FF, STRING_GLOBAL);
                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[%s: %s [%d]]: Сообщение: %s", bizz_type_name[b_info[idx][_tip]], b_info[idx][_name], b_info[idx][b_mysql_id], inputtext);
                            SendTransportCompanyMes(idx, 0, 0x33CC66FF, STRING_GLOBAL);
                        }
                    }
                }
                case 4: // механика
                {
                    SendAccess(playerid, "Вы вызвали механика.");
                    foreach(new i : gJobPlayers[JOB_MECHANIC])
                    {
                        if(p_temp[i][rented_veh] != INVALID_VEHICLE_ID && (veh_info[p_temp[i][rented_veh]][v_npoType] == NPO_JOB && veh_info[p_temp[i][rented_veh]][v_npoId] == JOB_MECHANIC || veh_info[p_temp[i][rented_veh]][v_temp_job] == JOB_MECHANIC))
                        {
                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s [%d] вызывает механика. Он сейчас в %s, район %s.(( Принять вызов: /to %d. ))", get_name(playerid), playerid, gSAZonesCity[GetCityName(pos[0],pos[1])][SAZONE_NAME], gSAZones[GetZonaName(pos[0],pos[1])][SAZONE_NAME], playerid);
                            SendInfo(i, STRING_GLOBAL);
                            SendInfo(i, "Сообщение: %s", inputtext);
                        }
                    }
                }
            }
            return 1;
        }
