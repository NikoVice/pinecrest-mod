                    if(iValue < 0 || iValue > 311) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"��������", ""W"������� ID ����� �� 0 �� 311:", "�����", "������"), SendError(playerid, "ID ����� ������ ���� �� ����� 0 � �� ����� 311.");
                    if(iValue == 0 || iValue == 74) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"��������", ""W"������� ID ����� �� 0 �� 311:", "�����", "������"), SendError(playerid, "�� ����� ����������� ID �����.");
