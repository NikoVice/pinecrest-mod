CMD:oldmembers(playerid, params[])
{
    if(!p_info[playerid][member])
        return SendError(playerid, "�� �� �������� �� �������.");
    STRING_GLOBAL[0] = EOS;
    STRING_GLOBAL = ""W"����� ����������� ������:\n";

    new status_work[16];
    foreach(new i: gFactionPlayers[p_info[playerid][member]])
    {
        if(p_info[i][admin] > 0 || p_info[playerid][member] != p_info[i][member]) continue;
        status_work[0] = EOS;
        if(p_info[i][fwork] == true && (gos(i) || GetFactionType(p_info[i][member]) == FACTION_TYPE_SNN)) status_work = "[�� ������]";
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"%s%s [%d] ����: %s [%d] | ����.: %d/3 | %s\n", STRING_GLOBAL, get_name(i), i,  GetPlayerFractionRangName(i), p_info[i][rang], p_info[i][fwarn], status_work);
    }
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"������ ������", STRING_GLOBAL, "�������", "");
    return 1;
}

CMD:getbizzid(playerid, params[])
{
    for(new i; i < totalbizz; i++){
        if(b_info[i][b_mysql_id] == INVALID_MYSQL_ID) continue;
        if(IsPlayerInRangeOfPoint(playerid,3.0,b_info[i][b_enter][0],b_info[i][b_enter][1],b_info[i][b_enter][2]) )
        {
            SendInfo(playerid, "ID �������: %d.", i);
            break;
        }
    }
    return 1;
}
CMD:setbizpos(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10) return 1;
    new bizz_id, Float:pX, Float:pY, Float:pZ, Float:pA;
    if(sscanf(params, "i", bizz_id)) return SendInfo(playerid, "�����������: /setbizpos [id �������]");
    if(bizz_id < 0 || bizz_id >= totalbizz) return 1;

    GetPlayerPos(playerid,pX,pY,pZ);
    GetPlayerFacingAngle(playerid, pA);

    b_info[bizz_id][b_enter][0] = pX;
    b_info[bizz_id][b_enter][1] = pY;
    b_info[bizz_id][b_enter][2] = pZ;
    b_info[bizz_id][b_enter][3] = pA;

    DestroyDynamicPickup(b_info[bizz_id][b_pickup_enter]);
    b_info[bizz_id][b_pickup_enter] = CreateDynamicPickup(1318, 23, b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2]);

    DestroyDynamicArea(b_info[bizz_id][b_area_enter]);
    b_info[bizz_id][b_area_enter] = CreateDynamicSphere(b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2], 5.0, -1, -1, -1);
    UpdateAreaInfo(b_info[bizz_id][b_area_enter], TYPE_BUSINESS, AREA_SUBTYPE_BUSINESS_ENTER, bizz_id);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd,STRING_GLOBAL,sizeof(STRING_GLOBAL),"UPDATE `biz` SET `b_enterX` = '%f', `b_enterY` = '%f', `b_enterZ` = '%f', `b_enterA` = '%f' WHERE `b_mysql_id`= %d",
    b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2], b_info[bizz_id][b_enter][3], b_info[bizz_id][b_mysql_id]);
    mysql_tquery(con_bd, STRING_GLOBAL);
    SendInfo(playerid, "���������� ���� �������� ��� ������ �� �������: /sba");

    save_bizz(bizz_id);
    update_bizz(bizz_id);
    return 1;
}
CMD:setbizprice(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10) return 1;
    new bizz_id, bizz_price;
    if(sscanf(params, "ii", bizz_id, bizz_price)) return SendInfo(playerid, "�����������: /setbizprice [id �������] [����]");
    if(bizz_id < 0 || bizz_id >= totalbizz) return 1;
    if(bizz_price < 1 || bizz_price > 100000000)

    bizz_id++;

    b_info[bizz_id][_price] = bizz_price;

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd,STRING_GLOBAL,sizeof(STRING_GLOBAL), "UPDATE `biz` SET `b_price` = %d WHERE `b_mysql_id`= %d",
    b_info[bizz_id][_price], b_info[bizz_id][b_mysql_id]);
    mysql_tquery(con_bd, STRING_GLOBAL);

    SendAccess(playerid, "�� �������� ��������� ������� %d �� %d$.", b_info[bizz_id][b_mysql_id], b_info[bizz_id][_price]);

    save_bizz(bizz_id);
    update_bizz(bizz_id);
    return 1;
}
CMD:sethousepos(playerid, params[])
