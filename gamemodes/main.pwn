SetCameraForPlayer(playerid, id_camera, Float:distanse = 8.5, Float:camera_Z = 3.0, isMove = false, type = TYPE_UPDATE_CAMERA_INVALID)
{
    new Float:x, Float:y, Float:z, Float:a,
        Float:x2, Float:y2;

    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER || GetPlayerState(playerid) == PLAYER_STATE_PASSENGER)
    {
        new vehicleid = GetPlayerVehicleID(playerid);
        GetVehiclePos(vehicleid, x, y, z);
        GetVehicleZAngle(vehicleid, a);
    }
    else
    {
        GetPlayerPos(playerid, x, y, z);
        GetPlayerFacingAngle(playerid, a);
    }

    new oldA = id_camera;

    if(type == TYPE_UPDATE_CAMERA_RIGHT)
    {
        id_camera = id_camera - 30;
        if(id_camera < 0) id_camera += 360;
    }
    else if(type == TYPE_UPDATE_CAMERA_LEFT)
    {
        id_camera = id_camera + 30;
        if(id_camera > 360) id_camera -= 360;
    }

    x2 = x - distanse * floatsin(a-id_camera, degrees);
    y2 = y + distanse * floatcos(a-id_camera, degrees);

    if(isMove)
    {
        new Float:OldX, Float:OldY;

        OldX = x - distanse * floatsin(a-oldA, degrees);
        OldY = y + distanse * floatcos(a-oldA, degrees);
        InterpolateCameraPos(playerid, OldX, OldY, z+camera_Z, x2, y2, z+camera_Z, 500);
        InterpolateCameraLookAt(playerid, x, y, z, x, y, z, 500);
    }
    else
    {
        SetPlayerCameraPos(playerid, x2, y2, z+camera_Z);
        SetPlayerCameraLookAt(playerid, x, y, z);
    }
    p_temp[playerid][camera_id] = id_camera;
}
//=========================
CMD:resetevent(playerid)
{
    if(!FD(playerid) || p_info[playerid][admin] < 10)
        return 1;
    ClearEvent();
    return 1;
}

ClearEvent()
{
    mysql_tquery(con_bd,
        "UPDATE `accounts` SET `gift_promocode_status` = 0, `gift_promocode_time` = 0, `gift` = 0, `gift_check` = 0, `gift_idx` = 0, `event_quest_id` = 0, `event_quest_stage` = 0", "");
}
