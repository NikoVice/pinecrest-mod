            }
            if(total != -1) return SendError(playerid, "� ������������ ��� ���� ���� ����������.");
            new idx = -1;
            for(new i; i < MAX_NEWS_ADS; i++)
            {
                if(AdvertInfo[i][aStatus] == 0)
                {
                    idx = i;
                    break;
                }
            }
            if(idx == -1) return SendError(playerid, "� ������������ ��� ��������� ���� ��� ����������.");
