            if(p_info[playerid][cash] < tax) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_CONTROL, idx), SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            VideoCardsInfo[idx][vcTax] = 0;
