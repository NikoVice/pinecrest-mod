            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            SetPlayerMoney(playerid, -price, true, "оплатил лечение болезни");
            SendAccess(playerid, "Вы вылечились от болезни \"%s\" за %d$.", diseasename[listitem], price);
            p_info[playerid][Disease][listitem] = 0;
            OnServerInfoForMoney[23] += price;
        }
        case D_HOSPITAL:
        {
            if(!response) return 1;
            new idx = GetPlayerVirtualWorld(playerid) + 14;
            if(idx < 15 || idx > 17) return SendError(playerid, "Вы должны находиться в больнице.");
            switch(listitem)
            {
                case 0:
                {
                    new total = 0;
                    foreach(new i:Player)
                    {
                        if(IsPlayerInRangeOfPoint(i, 100.0, 205.6737,-1681.2388,1007.4592) && GetPlayerVirtualWorld(i) == GetPlayerVirtualWorld(playerid) && p_info[i][p_afkTime] < 2)
                        {
                            if(IsPlayerFractionMedic(i) && p_info[i][fwork] == true)
                            {
                                total++;
                                break;
                            }
                        }
                    }
                    if(total != 0) return SendError(playerid, "В больнице есть врач, обратитесь к нему.");
                    new price = 100;
                    if(p_info[playerid][level] >= 4) price = 300;
                    GetPlayerHealth(playerid, p_info[playerid][pHealth]);
                    if(p_info[playerid][pHealth] >= 99.0) return SendError(playerid, "Вы не нуждаетесь в лечении.");
                    if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                    if(GetFractionWarehouse(idx, fwDrugs) < 100) return SendError(playerid, "На складе недостаточно медикаментов.");

                    if(p_info[playerid][med_insurance] != 0)
                    {
                        SendInfo(playerid, "У Вас действует мед. страховка, цену лечения снижено в 2 раза.");
                        price = price/2;
                    }

                    SetPlayerMoney(playerid, -price, true, "лечение у участкового");

                    p_info[playerid][pHealth] = 100.0;
                    SetPlayerHealth(playerid, p_info[playerid][pHealth]);

                    SendAccess(playerid, "Участковый вылечил Вас за %d$.", price);

                    SetFractionWarehouse(idx, fwDrugs, -100);
                    SetFractionWarehouse(idx, fwMoney, price);
                }
                case 1:
                {
                    new total = 0;
                    foreach(new i:Player)
                    {
                        if(IsPlayerInRangeOfPoint(i, 100.0, 205.6737,-1681.2388,1007.4592) && GetPlayerVirtualWorld(i) == GetPlayerVirtualWorld(playerid) && p_info[i][p_afkTime] < 2)
                        {
                            if(IsPlayerFractionMedic(i) && p_info[i][fwork] == true)
                            {
                                total++;
                                break;
                            }
                        }
                    }
                    if(total != 0) return SendError(playerid, "В больнице есть врач, обратитесь к нему.");
                    if(p_info[playerid][med_card] == 1) return SendError(playerid, "У Вас уже есть мед. карта.");
                    new price = 2500;
                    switch(p_info[playerid][level])
                    {
                        case 1 .. 5: price = 2500;
                        case 6 .. 10: price = 5000;
                        case 11 .. 15: price = 7500;
                        default: price = 10000;
                    }
                    if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                    if(GetFractionWarehouse(idx, fwDrugs) < 50) return SendError(playerid, "На складе недостаточно медикаментов.");

                    SetPlayerMoney(playerid, -price, true, "покупка мед. карты у участкового");
                    p_info[playerid][med_card] = 1;
                    p_info[playerid][med_card_time] = 336;
                    MysqlUpdatePlayerInt(playerid, "med_card", p_info[playerid][med_card]);
                    MysqlUpdatePlayerInt(playerid, "med_card_time", p_info[playerid][med_card_time]);

                    SendAccess(playerid, "Участковый выдал Вам мед. карту за %s.", ConvertNumber(price));

                    SetFractionWarehouse(idx, fwDrugs, -50);
                    SetFractionWarehouse(idx, fwMoney, price);
                }
            }
        }
        case D_PLAYER_SETTINGS_CHAT:
        {
            if(!response) return ShowPlayerSettings(playerid);
            switch(listitem)
            {
                case 0:
                {
                    for(new i = 14; i != -1; i--)
                    {
                        SendMes(playerid, 0xFFFFFFFF, " ");
                    }
                    SendAccess(playerid, "Вы очистили игровой чат.");
                    return 1;
                }
                case 1:
                {
                    p_info[playerid][p_settings][CHAT_ADVERT] = !p_info[playerid][p_settings][CHAT_ADVERT];
                    SendAccess(playerid, "Вы %s отображение объявлений.", p_info[playerid][p_settings][CHAT_ADVERT] == 1 ? "включили" : "выключили");
                }
                case 2:
                {
                    p_info[playerid][p_settings][CHAT_JOB] = !p_info[playerid][p_settings][CHAT_JOB];
                    SendAccess(playerid, "Вы %s отображение рабочего чата.", p_info[playerid][p_settings][CHAT_JOB] == 1 ? "включили" : "выключили");
                }
                case 3:
                {
                    p_info[playerid][p_settings][CHAT_ADMIN_ACT] = !p_info[playerid][p_settings][CHAT_ADMIN_ACT];
                    SendAccess(playerid, "Вы %s отображение админ. действия.", p_info[playerid][p_settings][CHAT_ADMIN_ACT] == 1 ? "включили" : "выключили");
                }
                case 4:
                {
                    p_info[playerid][p_settings][CHAT_VIP] = !p_info[playerid][p_settings][CHAT_VIP];
                    SendAccess(playerid, "Вы %s отображение VIP чата.", p_info[playerid][p_settings][CHAT_VIP] == 1 ? "включили" : "выключили");
                }
                case 5:
                {
                    p_info[playerid][p_settings][CHAT_FRACTION] = !p_info[playerid][p_settings][CHAT_FRACTION];
                    SendAccess(playerid, "Вы %s отображение фракционного чата.", p_info[playerid][p_settings][CHAT_FRACTION] == 1 ? "включили" : "выключили");
                }
                case 6:
                {
                    p_info[playerid][p_settings][CHAT_FAMILY] = !p_info[playerid][p_settings][CHAT_FAMILY];
                    SendAccess(playerid, "Вы %s отображение семейного чата.", p_info[playerid][p_settings][CHAT_FAMILY] == 1 ? "включили" : "выключили");
                }
            }
            UpdatePlayerSetting(playerid);
            ShowPlayerSettingsChat(playerid);
            return 1;
        }
        case D_GOOGLE_AUTH_CREATE:
        {
            if(!response) return 1;
            if(strlen(p_info[playerid][google_code]) < 5)
            {
                if(!IsMailConfirmed(playerid))
                    return SendError(playerid, "Подтвердите вашу почту, что бы получить Google код.");
                new google_password[17];
                for(new i; i < 17; i ++) strcat(google_password, gBase64Alphabet[random(sizeof(gBase64Alphabet)-1)]);

                ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"ОЧЕНЬ ВАЖНО!", ""W"Код для Google Authenticator отправлен на ваш E-Mail."W"\n\nСохраните его в свой \"Authenticator\".\n\n{"#cLIGHTRED"}ЭТО ОЧЕНЬ ВАЖНО! КОД ВОССТАНОВИТЬ НЕЛЬЗЯ!", "Закрыть","");

                STRING_GLOBAL[0] = EOS;
                f(STRING_GLOBAL,"%sНик: <strong>%s</strong><br/>Код: <strong>%s</strong>%s", Mail_Header, get_name(playerid), google_password, Mail_Footer);
                //SendMail(p_info[playerid][mail], "flin-rp.com", "flin-rp.com", STRING_GLOBAL, "b5b834bt");

                p_info[playerid][google_code][0] = EOS;
                strcat(p_info[playerid][google_code], google_password);
                MysqlUpdatePlayerStr(playerid, "google_code", p_info[playerid][google_code]);
                SendAccess(playerid, "Код для Google Authenticator отправлен на ваш E-Mail.");
            }
            return 1;
        }
        case D_GOOGLE_AUTH:
        {
            if(!response) return 1;
            new number;
            if(sscanf(inputtext, "i", number))
            {
                SendInfo(playerid, "Вы ввели неверный код Google Authenticator.");
                ShowPlayerDialog(playerid, D_GOOGLE_AUTH, DIALOG_STYLE_INPUT, ""I"Google Authenticator", ""W"Введите одноразовый код из приложения Google Authenticator:\n\n{"#cLIGHTRED"}Обратите внимание! Код состоит из цифр.", "Далее", "");
                return 1;
            }
            if(strlen(p_info[playerid][google_code]) > 5)
            {
                new fixtime = timestamp;
                fixtime = fixtime - (13*60*60);

                for(new hour; hour < 26; hour++)
                {
                    new heh = GoogleAuthenticatorCode(p_info[playerid][google_code], fixtime);
                    if(number == heh)
                    {
                        if(p_info[playerid][loggedIn] == 1)
                        {
                            p_info[playerid][google_code] = EOS;
                            MysqlUpdatePlayerStr(playerid, "google_code", p_info[playerid][google_code]);
                            SendAccess(playerid, "Вы отключили Google Authenticator.");
                        }
                        else
                        {
                            if(ServerInfo[VKSecurity] && IsVKConfirmed(playerid) && (!p_info[playerid][vk_auth] || (p_info[playerid][vk_auth] && !strequals(p_temp[playerid][session_IP], p_info[playerid][lastIP]))))
                                VK_ShowDialogAuth(playerid);
                            else if(ServerInfo[TGSecurity] && IsTGConfirmed(playerid) && (!p_info[playerid][tg_auth] || (p_info[playerid][tg_auth] && !strequals(p_temp[playerid][session_IP], p_info[playerid][lastIP]))))
                                TG_ShowDialogAuth(playerid);
                            else LoadPlayerAccount(playerid);
                        }
                        return 1;
                    }
                    else
                    {
                        fixtime = fixtime - 300;
                        for(new offset; offset < 600; offset++)
                        {
                            heh = GoogleAuthenticatorCode(p_info[playerid][google_code], fixtime);
                            if(number == heh)
                            {
                                if(p_info[playerid][loggedIn] == 1)
                                {
                                    p_info[playerid][google_code] = EOS;
                                    MysqlUpdatePlayerStr(playerid, "google_code", p_info[playerid][google_code]);
                                    SendAccess(playerid, "Вы отключили Google Authenticator.");
                                }
                                else
                                {
                                    if(ServerInfo[VKSecurity] && IsVKConfirmed(playerid) && (!p_info[playerid][vk_auth] || (p_info[playerid][vk_auth] && !strequals(p_temp[playerid][session_IP], p_info[playerid][lastIP]))))
                                        VK_ShowDialogAuth(playerid);
                                    else if(ServerInfo[TGSecurity] && IsTGConfirmed(playerid) && (!p_info[playerid][tg_auth] || (p_info[playerid][tg_auth] && !strequals(p_temp[playerid][session_IP], p_info[playerid][lastIP]))))
                                        TG_ShowDialogAuth(playerid);
                                    else LoadPlayerAccount(playerid);
                                }
                                return 1;
                            }
                            fixtime ++;
                        }
                        fixtime = fixtime - 300;
                        fixtime = fixtime + 3600;
                    }
                }
                SendInfo(playerid, "Вы ввели неверный код Google Authenticator.");
                if(p_info[playerid][loggedIn] != 1)
                {
                    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Информация", 
                        ""W"Вы были отключены от сервера с блокировкой IP на 5 cекунд.\n\
                        Не волнуйтесь, через 5 секунд IР разблокируется.\n\
                        Причина: {"#cLIGHTRED"}Неверный ввод кода Google Authenticator.\n\
                        "W"Для выхода с сервера введите \"/q\" в чат.", "ОК", "");
                    BlockIpAddress(p_temp[playerid][session_IP], 5000);
                    Kick(playerid);
                    return 1;
                }
            }
            return 1;
        }
        //////////////////
        case D_CHANGE_PASS:
        {
            if(!response) return 1;
            bcrypt_check(inputtext, p_info[playerid][password], "OnPasswordCheckChange", "d", playerid);
        }
        case D_CHANGE_PASS_NEW:
        {
            if(!response) return 1;
            if(strlen(inputtext) < 6 || strlen(inputtext) > 15 || strlen(inputtext) == 0)
            {
                SendInfo(playerid, "Пароль должен быть не менее 6 и не более 15 символов.");
                SendInfo(playerid, "Пароль не должен содержать в себе запрещенные символы.");
                ShowPlayerDialog(playerid,D_CHANGE_PASS_NEW, 1, ""I"Изменить пароль", ""W"Введите новый пароль:", "Далее", "Отмена");
                return 1;
            }
            for(new i = strlen(inputtext)-1; i != -1; i--)
            {
                switch(inputtext[i])
                {
                    case '0'..'9', 'а'..'я', 'a'..'z', 'А'..'Я', 'A'..'Z': continue;
                    default:
                    {
                        SendInfo(playerid, "Пароль должен быть не менее 6 и не более 15 символов.");
                        SendInfo(playerid, "Пароль не должен содержать в себе запрещенные символы.");
                        ShowPlayerDialog(playerid,D_CHANGE_PASS_NEW, 1, ""I"Изменить пароль", ""W"Введите новый пароль:", "Далее", "Отмена");
                        return 1;
                    }
                }
            }
            bcrypt_hash(inputtext, BCRYPT_COST, "OnPasswordHashedNCP", "ds", playerid, inputtext);
        }
        case D_PASSPORT:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0:
                {
                    new total = 0;
                    foreach(new i:Player)
                    {
                        if(IsPlayerInRangeOfPoint(i, 100.0, 1563.2675,1131.7980,1038.6191) && GetPlayerVirtualWorld(i) == GetPlayerVirtualWorld(playerid) && p_info[i][p_afkTime] < 2)
                        {
                            if(p_info[i][member] == MAYOR_LS && p_info[i][rang] == 4 && p_info[i][fwork] == true)
                            {
                                total++;
                                break;
                            }
                        }
                    }
                    if(total != 0) return SendError(playerid, "В мэрии есть секретарь, обратитесь к нему.");
                    if(p_info[playerid][passport]) return CheckPlayerMission(playerid, START_PASS), SendError(playerid, "У Вас уже есть паспорт.");
                    p_info[playerid][passport] = 1;
