save_gz(idx)
{
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `gangzone` SET `fraction` = %d WHERE `id` = %d",
    GangZone_Info[idx][g_Fraction], idx);
    mysql_tquery(con_bd, STRING_GLOBAL);
    return 1;
}

save_gz_restart()
{
    for(new i = TOTALGZ; i != 0; i--)
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `gangzone` SET `fraction` = %d WHERE `id` = %d", GangZone_Info[i][g_Fraction], i);
        mysql_tquery(con_bd, STRING_GLOBAL);
    }
    return 1;
}

this::load_gangzone()
{
    new str[256];

    Capture_Info[0][gGangZoneID] = INVALID_CRIMINAL_ZONE_ID;
    Capture_Info[1][gGangZoneID] = INVALID_CRIMINAL_ZONE_ID;
    Capture_Info[0][gStatus] = GANG_ZONE_NONE;
    Capture_Info[1][gStatus] = GANG_ZONE_NONE;

    new rows;
    cache_get_row_count(rows);
    if(rows)
    {
        for(new idx = 1; idx < 1 + rows; idx++)
        {
            f_mysql_fetch_row_format(idx-1, str, cache_num_fields());
            sscanf(str, "p<|>iffffi",
            GangZone_Info[idx][gID],
            GangZone_Info[idx][gCoords][0],
            GangZone_Info[idx][gCoords][1],
            GangZone_Info[idx][gCoords][2],
            GangZone_Info[idx][gCoords][3],
            GangZone_Info[idx][g_Fraction]);
            GangZone_Info[idx][gID] = GangZoneCreate(GangZone_Info[idx][gCoords][0],GangZone_Info[idx][gCoords][1],GangZone_Info[idx][gCoords][2],GangZone_Info[idx][gCoords][3]);
            GangZone_Info[idx][g_Area] = CreateDynamicRectangle(GangZone_Info[idx][gCoords][0],GangZone_Info[idx][gCoords][1],GangZone_Info[idx][gCoords][2],GangZone_Info[idx][gCoords][3], 0, 0, -1);
            UpdateAreaInfo(GangZone_Info[idx][g_Area], TYPE_CRIMINAL_ZONE, AREA_SUBTYPE_GANG_ZONE, idx);

            TOTALGZ++;
            SetGangTerritory(GangZone_Info[idx][g_Fraction], 1);
        }
    }

    GangSpawnKillZone[0] = CreateDynamicRectangle(2440.466796875, -1724.167007446289, 2501.466796875, -1657.167007446289, 0, 0, -1); //GROOVE
    GangSpawnKillZone[1] = CreateDynamicRectangle(1975.4287109375, -1167.5, 2056.4287109375, -1098.5, 0, 0, -1); //BALLAS
    GangSpawnKillZone[2] = CreateDynamicRectangle(2777.0554809570312, -1993.8888397216797, 2819.0554809570312, -1943.8888397216797, 0, 0, -1); //RIFA
    GangSpawnKillZone[3] = CreateDynamicRectangle(1659.7224426269531, -2147.77783203125, 1750.7224426269531, -2076.77783203125, 0, 0, -1); //AZTEC
    GangSpawnKillZone[4] = CreateDynamicRectangle(2736.0556640625, -1241.666748046875, 2779.0556640625, -1170.666748046875, 0, 0, -1); //VAGOS

    printf("[%i counts] Gangzone loads", TOTALGZ);
    return 1;
}

