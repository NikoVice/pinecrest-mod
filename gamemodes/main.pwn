        Введите ID камеры чтобы открыть или закрыть ее:\n\n\
        \t- Введите -1 чтобы открыть все камеры;\n\
        \t- Введите -2 чтобы закрыть все камеры;\n\
        \t- Введите -3 чтобы посадить всех заключенных в камеры;\n\n");
    new idx = 0;
    for(new i; i < sizeof(PrisonDoor); i++)
    {
        if(idx < 1) format(STRING_MIN, sizeof(STRING_MIN), "Камера [%d] | Состояние: %s\t", i+1, (PrisonDoor[i] == INVALID_OBJECT_ID) ? ("{"#cGREEN"}Открыта"W"") : ("{"#cLIGHTRED"}Закрыта"W"")), idx++;
        else format(STRING_MIN, sizeof(STRING_MIN), "Камера [%d] | Состояние: %s\n", i+1, (PrisonDoor[i] == INVALID_OBJECT_ID) ? ("{"#cGREEN"}Открыта"W"") : ("{"#cLIGHTRED"}Закрыта"W"")), idx = 0;
        strcat(STRING_GLOBAL, STRING_MIN);
    }
    ShowPlayerDialog(playerid, D_PRISON_DOOR, DIALOG_STYLE_INPUT, ""I"Состояние камер", STRING_GLOBAL, "Далее", "Отмена");
    return 1;
}

