    p_info[playerid][Lic][LIC_CAR], p_info[playerid][Lic][LIC_MOTO],
    p_info[playerid][Lic][LIC_BOAT], p_info[playerid][Lic][LIC_PLANE],
    p_info[playerid][Lic][LIC_WEAPON], p_info[playerid][Lic][LIC_FISHING],
    p_info[playerid][Lic][LIC_HUNTER], p_info[playerid][Lic][LIC_TAXI],
    p_info[playerid][Lic][LIC_LAWYER],
    p_info[playerid][Lic_Warn][LIC_CAR], p_info[playerid][Lic_Warn][LIC_MOTO],
    p_info[playerid][Lic_Warn][LIC_BOAT], p_info[playerid][Lic_Warn][LIC_PLANE],
    p_info[playerid][Lic_Warn][LIC_WEAPON], p_info[playerid][Lic_Warn][LIC_FISHING],
    p_info[playerid][Lic_Warn][LIC_HUNTER], p_info[playerid][Lic_Warn][LIC_TAXI],
    p_info[playerid][Lic_Warn][LIC_LAWYER],
    p_info[playerid][Lic_Time][LIC_CAR], p_info[playerid][Lic_Time][LIC_MOTO],
    p_info[playerid][Lic_Time][LIC_BOAT], p_info[playerid][Lic_Time][LIC_PLANE],
    p_info[playerid][Lic_Time][LIC_WEAPON], p_info[playerid][Lic_Time][LIC_FISHING],
    p_info[playerid][Lic_Time][LIC_HUNTER], p_info[playerid][Lic_Time][LIC_TAXI],
    p_info[playerid][Lic_Time][LIC_LAWYER],
    p_info[playerid][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL);
    return 1;
}

