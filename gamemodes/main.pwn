                            DerbyVehicles[p] = INVALID_VEHICLE_ID;
                            SendInfo(i, "Вы были дисквалифицированны с дерби.");
                        }
                    }
                }

                if(veh_info[vehicleid][v_engine] == 1)
                {
                    veh_info[vehicleid][v_engine] = VEHICLE_PARAMS_OFF;
                    SendError(i, "Двигатель транспортного средства сломан, вызовите механика.");
                }

                if(SRV_ID != 0) SetVehicleHealth(vehicleid, 300.0);
                SetVehicleParamsVEx(vehicleid, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, alarm, veh_info[vehicleid][v_lock], bonnet, boot, objective);
            }
            if((veh_info[vehicleid][v_npoType] == NPO_PUB_SALON && veh_info[vehicleid][v_used_key_ID] != i) ||
                veh_info[vehicleid][v_npoType] == NPO_CONTAINER ||
                veh_info[vehicleid][v_npoType] == NPO_AUCTION)
            {
                if(speed > 10) {
                    AntiCheatKick(i, 3066);
                    continue;
                }
                if(!PlayerToPoint(50.0, i, veh_info[vehicleid][v_pos][0],veh_info[vehicleid][v_pos][1],veh_info[vehicleid][v_pos][2])) {
                    SetVehiclePos(vehicleid, veh_info[vehicleid][v_pos][0],veh_info[vehicleid][v_pos][1],veh_info[vehicleid][v_pos][2]);
                    SetVehicleZAngle(vehicleid, veh_info[vehicleid][v_pos][3]);
                    LinkVehicleToInterior(vehicleid, veh_info[vehicleid][v_int]);
                    SetVehicleVirtualWorld(vehicleid, veh_info[vehicleid][v_virt]);
                    AntiCheatKick(i, 3065);
                    continue;
                }
            }
            if(veh_info[vehicleid][v_npoType] == NPO_JOB)
            {
                if(speed > 5 && GetPVarInt(i, "ARENDA:FIX") == 1)
                {
                    AntiCheatKick(i, 3066);
                    continue;
                }
            }
            if(veh_info[vehicleid][v_job] == JOB_TC_TAXI && (IsPlayerOwnerVehicle(i, vehicleid) || veh_info[vehicleid][v_npoType] == NPO_JOB && veh_info[vehicleid][v_npoId] == JOB_TC_TAXI) && p_temp[i][Work_ID] == TAXI_WORK && GetPVarInt(i,"@passenger") > 0)
            {
                new passenger_id = GetPVarInt(i, "@passenger") - 1;

                if(!IsPlayerInVehicle(passenger_id, vehicleid))
                {
                    if(!IsPlayerOwnerVehicle(i, vehicleid) && IsPlayerInRangeOfPoint(passenger_id, 100.0, p_temp[passenger_id][TaxiFix][0], p_temp[passenger_id][TaxiFix][1], p_temp[passenger_id][TaxiFix][2]) == 0 && p_info[passenger_id][TaxiTime] < timestamp)
                    {
                        p_info[passenger_id][TaxiTime] = timestamp + 180;
                        UpdatePlayerWorkSkill(i, 8);

                        CheckPlayerMission(i, START_TAXI);
                        CheckPlayerMission(i, DAILY_TAXI);
                        CheckPlayerMission(i, ACHIEVEMENT_TAXI);

                        CheckPlayerFreelance(i, FREELANCE_TAXI);
                        CheckPlayerBattlePass(i, BATTLEPASS_TAXI);

                        UpdateFamilyLevel(i);
                        UpdateFamilyContract(i, CONTRACT_FAMILY_ID_TAXI); // Контракты: Водитель такси
                    }

                    if(p_info[passenger_id][cash] >= floatround(p_temp[i][taxi_zp]))
                    {
                        SetPlayerMoney(passenger_id, -floatround(p_temp[i][taxi_zp]), true, "проезд в такси");

                        if(GetPVarInt(i,"PayDayCashJob") > timestamp) {}
                        else
                        {
                            new reason_money = GetPlayerMoneySkill(i, GetBizPercent(i, TYPE_TC_TAXI, floatround(p_temp[i][taxi_zp])), 8);
                            SetPlayerMoney(i, reason_money, false, "зарплата таксиста");
                            OnServerInfoForMoney[17] += reason_money;
                            SetPVarInt(i,"PayDayCashJob",timestamp + 30);
                            TransferBizMoney(i, TYPE_TC_TAXI, p_temp[i][fix_bug_biz_tc_salary]);
                        }
                    }
                    else
                    {
                        SendError(passenger_id, "У Вас нет столько денег. Используйте /donate");
                        SendError(i, "У игрока нет столько денег.");
                    }

                    p_temp[i][fix_flood] = INVALID_PLAYER_ID;
                    SendInfo(i, "Пассажир вышел из транспортного средства.");

                    p_temp[i][taxi_zp] = 0.0;
                    p_temp[i][taxi_enter] = 0;
                    DeletePVar(i,"@passenger");
                }
                else
                {
                    new Float:v_Miliage;
                    if(speed >= 91) v_Miliage = ((speed * veh_info[vehicleid][v_cost_taxi]) / 10.0) / 20;
                    if(speed <= 90) v_Miliage = ((speed * veh_info[vehicleid][v_cost_taxi]) / 10.0) / 15;

                    if(p_info[passenger_id][cash] > floatround(p_temp[i][taxi_zp] + v_Miliage))
                    {
                        p_temp[i][taxi_zp] += v_Miliage;
                    }
                    else
                    {
                        if(p_temp[i][fix_flood] == INVALID_PLAYER_ID || p_temp[i][fix_flood] != passenger_id)
                        {
                            SendInfo(passenger_id, "У Вас закончились деньги, дальнейший проезд будет бесплатный.");
                            SendInfo(i, "У игрока закончились деньги, дальнейший проезд будет бесплатный.");
                            p_temp[i][fix_flood] = passenger_id;
                        }
                    }
                    new string[32];
                    format(string, sizeof(string), "~w~Fare: ~g~%d$", GetBizPercent(i, TYPE_TC_TAXI, floatround(p_temp[i][taxi_zp])));
                    GameTextForPlayer(i, string, 2000, 6);
                    format(string, sizeof(string), "~w~Fare: ~r~%d$", floatround(p_temp[i][taxi_zp]));
                    GameTextForPlayer(passenger_id, string, 2000, 6);
                }
            }
            if(p_info[i][p_radar_id] != -1) {
                new idx = p_info[i][p_radar_id];
                p_info[i][p_radar_id] = -1;
                if(speed >= RadarInfo[idx][rSpeed]+10 && p_info[i][p_radar] < timestamp)
                {
                    new shtraf = ((speed-RadarInfo[idx][rSpeed])*RadarInfo[idx][rSpeed])/2;
                    p_info[i][p_radar] = timestamp+3;
                    SendInfo(i, "Вы превысили скорость транспортного средства на %d KM/h. Ограничение: %d KM/h. Штраф: %d$.", speed-RadarInfo[idx][rSpeed], RadarInfo[idx][rSpeed], shtraf);

                    new pd_id = GetPlayerPositionCity(i);
                    if(p_info[i][cash] > shtraf) {
                        SetPlayerMoney(i, -shtraf, true, "оплатил штраф: радар 2");
                        SetFractionWarehouse(pd_id, fwMoney, shtraf/10);
                    }
                    else {
                        if(p_info[i][wanted] < 6) p_info[i][wanted]++;
                        SetPlayerWantedLevel(i, p_info[i][wanted]);
                        SendInfo(i, "У Вас нет столько денег. Используйте /donate");
                        SendInfo(i, "Вы объявлены в розыск.");

                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] объявлен в розыск. Уровень розыска: %d. Причина: Превышение скорости.", get_name(i), i, p_info[i][wanted]);
                        SendFractionMessage(pd_id, 0x33CC66FF, STRING_GLOBAL);
                    }
                }
            }
            if(p_info[i][p_busTime] > 0)
            {
                new string[32];
                p_info[i][p_busTime]--;
                format(string,32,"~r~%i", p_info[i][p_busTime]);
                GameTextForPlayer(i, string, 2000, 6);
                if(p_info[i][p_busTime] == 0)
                {
                    new type = GetPVarInt(i, "TypeBus"), p = p_temp[i][pPressed];
                    SetPVarInt(i, "BusStop", 1);
                    switch(type)
                    {
                        case 1: SetPlayerRaceCheckpoint(i,0, BusCityLS[p][0],BusCityLS[p][1],BusCityLS[p][2],BusCityLS[p][3],BusCityLS[p][4],BusCityLS[p][5],5.0);
                        case 2: SetPlayerRaceCheckpoint(i,0, BusCitySF[p][0],BusCitySF[p][1],BusCitySF[p][2],BusCitySF[p][3],BusCitySF[p][4],BusCitySF[p][5],5.0);
                        case 3: SetPlayerRaceCheckpoint(i,0, BusCityLV[p][0],BusCityLV[p][1],BusCityLV[p][2],BusCityLV[p][3],BusCityLV[p][4],BusCityLV[p][5],5.0);
                        case 4: SetPlayerRaceCheckpoint(i,0, BusSchool[p][0],BusSchool[p][1],BusSchool[p][2],BusSchool[p][3],BusSchool[p][4],BusSchool[p][5],5.0);
                        case 5: SetPlayerRaceCheckpoint(i,0, BusLSLV[p][0],BusLSLV[p][1],BusLSLV[p][2],BusLSLV[p][3],BusLSLV[p][4],BusLSLV[p][5],5.0);
                    }
                }
            }
            if(p_temp[i][TrainTimer] <= 11 && p_temp[i][TrainTimer] >= 1)
            {
                new string[32];
                p_temp[i][TrainTimer]--;
                format(string,32,"~r~%i", p_temp[i][TrainTimer]);
                GameTextForPlayer(i, string, 2000, 6);
                if(p_temp[i][TrainTimer] < 1)
                {
                    p_temp[i][TrainStop] = false;
                    OnPlayerEnterRaceCheckpoint(i);
                }
            }
            if(p_temp[i][TramTimer] <= 11 && p_temp[i][TramTimer] >= 1)
            {
                new string[32];
                p_temp[i][TramTimer]--;
                format(string,32,"~r~%i", p_temp[i][TramTimer]);
                GameTextForPlayer(i, string, 2000, 6);
                if(p_temp[i][TramTimer] < 1)
                {
                    p_temp[i][TramStop] = false;
                    OnPlayerEnterRaceCheckpoint(i);
                }
            }
            if(IsPlayerRentedVehicle(i, vehicleid) &&
                GetVehicleModelEx(vehicleid) == 532 && !IsPlayerInRangeOfPoint(i, 250.0, -239.5335,-1346.4384,7.5946)) EndPlayerJob(i);
        }
        /*if(player_state == PLAYER_STATE_DRIVER || PLAYER_STATE_PASSENGER)
        {
            if(IsPlayerInDynamicArea(i, VEHICLE_MARKET_CUBE) && playerState != PLAYER_STATE_ONFOOT && p_info[i][admin] < 1)
            {
                new vehicleid = GetPlayerVehicleID(i);
                if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_CAR)
                {
                    SendError(i, "Читерить не хорошо...");
                    p_info[i][jail_time] = 300*60;
                    p_info[i][jail] = 6;

                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s[%d] читер! ТП внутрь Б/У рынка, посажан в деморган!", get_name(i), i);
                    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);
                }
                else
                {
                    SendInfo(i, "На территории авторынка запрещено находиться в транспортном средстве.");
                    SendInfo(i, "Ваше транспортное средство отправлено на место парковки.");
                }
                RemovePlayerFromVehicle(i);
                SetVehicleToRespawn(vehicleid);
            }
        }*/
        if(GetPlayerSpecialAction(i) == SPECIAL_ACTION_DRINK_WINE || GetPlayerSpecialAction(i) == SPECIAL_ACTION_DRINK_BEER)
        {
            SetPVarInt(i, "drink",GetPVarInt(i, "drink")+1);
            if(GetPVarInt(i, "drink") == 25) SetPlayerSpecialAction(i,0);
        }
        if(GetPVarInt(i, "Conv")) OnPlayerInConvoi(i);
        if(p_temp[i][chase_targetId] != INVALID_PLAYER_ID)
        {
            if(IsPlayerConnected(p_temp[i][chase_targetId]))
            {
                new Float:temp_pos_x, Float:temp_pos_y, Float:temp_pos_z;
                GetPlayerPos(p_temp[i][chase_targetId], temp_pos_x, temp_pos_y, temp_pos_z);
                SetPlayerCheckpoint(i, temp_pos_x, temp_pos_y, temp_pos_z, 5.0);
            }
            else p_temp[i][chase_targetId] = INVALID_PLAYER_ID;
        }
        if(p_info[i][jail_time] != 0)
        {
            if(p_temp[i][prison_escape] != 0 && p_temp[i][prison_escape_time] > 0)
            {
                p_temp[i][prison_escape_time]--;
                if(p_temp[i][prison_escape_time] == 0)
                {
                    SendInfo(i, "У Вас не получилось совершить побег, время вышло, срок заключения увеличен на 10 минут.");
                    if(p_info[i][jail] != 5) SendInfo(i, "Вас перевели в федеральную тюрьму.");
                    p_info[i][jail] = 5;
                    switch(p_info[i][p_vip])
                    {
                        case 1: p_info[i][jail_time] += ((10 * 60) / 100) * 90;
                        case 2: p_info[i][jail_time] += ((10 * 60) / 100) * 80;
                        case 3: p_info[i][jail_time] += ((10 * 60) / 100) * 70;
                        default: p_info[i][jail_time] += 10*60;
                    }
                    p_temp[i][prison_escape] =
                    p_temp[i][prison_escape_time] = 0;
                }
            }
            else
            {
                if(!PlayerToPoint(25.0, i, 2599.2146,2126.8960,1048.2335) && p_info[i][jail] == 1)
                {
                    SetPlayerInterior(i, 1);
                    SetPlayerVirtualWorld(i, 1);
                    switch(random(5))
                    {
                        case 0: SetPlayerPos(i, 2594.8792,2120.9707,1048.2335), SetPlayerFacingAngle(i, 269.1924);
                        case 1: SetPlayerPos(i, 2594.5432,2124.9297,1048.2335), SetPlayerFacingAngle(i, 267.9159);
                        case 2: SetPlayerPos(i, 2594.8469,2128.9121,1048.2335), SetPlayerFacingAngle(i, 269.5059);
                        case 3: SetPlayerPos(i, 2594.8542,2132.9133,1048.2335), SetPlayerFacingAngle(i, 268.2526);
                        case 4: SetPlayerPos(i, 2598.8616,2136.0291,1048.2335), SetPlayerFacingAngle(i, 177.6983);
                    }
                }
                if(!PlayerToPoint(25.0, i, 2599.2146,2126.8960,1048.2335) && p_info[i][jail] == 2)
                {
                    SetPlayerInterior(i, 1);
                    SetPlayerVirtualWorld(i, 2);
                    switch(random(5))
                    {
