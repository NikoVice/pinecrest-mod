                price = GetVehicleData(fraction_cars_biker[listitem], E_VD_PRICE), model_id = fraction_cars_biker[listitem];
            }
            if(p_info[playerid][cash] < price) return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");

            new frac_id = p_info[playerid][member];
            new idx = GetSlotFractionVehicle(frac_id, model_id);
            if(idx == -1)
            {
                for(new i; i < MAX_FRACTIONS_VEHICLES; i++)
                {
                    if(FractionsData[frac_id][fVehModelsID][i] == 0)
                    {
                        idx = i;
                        break;
                    }
                }
            }
            if(idx == -1) return SendError(playerid, "��� ���������� ����� ��� �������.");
            FractionsData[frac_id][fVehModelsID][idx] = model_id;
            FractionsData[frac_id][fVehModelMaxCount][idx]++;
            SaveFractionVehParkings(frac_id);

            SendAccess(playerid, "�� ��������� ����������� ������������ �������� \"%s\" �� %d$.", GetVehicleName(INVALID_VEHICLE_ID, model_id), price);

