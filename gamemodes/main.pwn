MeAction(playerid,action[],Float:distance = 13.0)
{
    if(p_info[playerid][mute] > 0) return 1;
    new string[144];
    format(string,144,"* %s[%d] %s",get_name(playerid), playerid, action);
    SendStreamMessage(distance, playerid, string, 0xE75480FF);
    return 1;
}

DoAction(playerid,action[],Float:distance = 13.0)
{
    if(p_info[playerid][mute] > 0) return 1;
    new string[144];
    format(string,144,"%s (%s[%d])", action, get_name(playerid), playerid);
    SendStreamMessage(distance, playerid, string, 0xDD90FFFF);
    return 1;
}

SendStreamMessage(Float:radius, playerid, mes[], color)
{
    new Float:pX,
        Float:pY,
        Float:pZ,
        virtword = GetPlayerVirtualWorld(playerid),
        intid =  GetPlayerInterior(playerid);
    GetPlayerPos(playerid,pX,pY,pZ);
    foreach(new i:Player)
    {
        if(GetPlayerVirtualWorld(i) == virtword && GetPlayerInterior(i) == intid)
        {
            if(PlayerToPoint(radius,i,pX,pY,pZ)) SendMes(i, color, mes);
        }
    }
}

stock MysqlUpdateAdminInt(playerid, field[], data[])
{
    new string[256];
    mysql_format(con_bd, string, sizeof(string), "UPDATE `admin_logs` SET `%s` = `%s` + %d WHERE `name` = '%e'",
    field, field, data, get_name(playerid));
    mysql_tquery(con_bd, string, "", "");
}

stock MysqlUpdatePlayerStr(playerid, field[], data[])
{
    if(p_info[playerid][loggedIn] != 1) return 1;
    new string[512];
    mysql_format(con_bd, string, sizeof(string), "UPDATE `accounts` SET `%s` = '%e' WHERE `id` = %d",
    field, data, p_info[playerid][ID]);
    mysql_tquery(con_bd, string, "", "");
    return 1;
}

