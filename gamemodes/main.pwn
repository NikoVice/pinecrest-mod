                        SetPlayerRaceCheckpoint(playerid, 1, ConstructionWarehousePos[idx][0], ConstructionWarehousePos[idx][1], ConstructionWarehousePos[idx][2], 0.0, 0.0, 0.0, 2.5);
                        return 1;
                    }
                    if(AntiCheatWarningTime[playerid][0] > timestamp)
                    {
                        SendError(playerid, "�� �� ������ ���������� ������ ��� �����, ���������.");
                        new idx = random(sizeof(ConstructionWarehousePos));
                        SetPlayerRaceCheckpoint(playerid, 1, ConstructionWarehousePos[idx][0], ConstructionWarehousePos[idx][1], ConstructionWarehousePos[idx][2], 0.0, 0.0, 0.0, 2.5);
                        return 1;
                    }
                    if(p_temp[playerid][ConstructionObject] != INVALID_OBJECT_ID)
                    {
                        DestroyDynamicObject(p_temp[playerid][ConstructionObject]);
                        p_temp[playerid][ConstructionObject] = INVALID_OBJECT_ID;
                    }

                    DisablePlayerRaceCheckpoint(playerid);
                    switch(random(6))
                    {
                        case 0:
                        {
                            p_temp[playerid][ConstructionObject] = CreateDynamicObject(1685, 0, 0, 0, 0, 0, 0);
                            SetDynamicObjectMaterial(p_temp[playerid][ConstructionObject], 0, 9583, "bigshap_sfw", "freight_crate4", -1);
                            AttachDynamicObjectToVehicle(p_temp[playerid][ConstructionObject], vehicleid, 0.000, 1.010, 0.680, 0.000, 0.000, 0.000);
                        }
                        case 1:
                        {
                            p_temp[playerid][ConstructionObject] = CreateDynamicObject(1846, 0, 0, 0, 0, 0, 0);
                            SetDynamicObjectMaterial(p_temp[playerid][ConstructionObject], 0, 19962, "samproadsigns", "materialtext1", 0);
                            SetDynamicObjectMaterial(p_temp[playerid][ConstructionObject], 1, 18996, "mattextures", "policeshieldgls", 0);
                            AttachDynamicObjectToVehicle(p_temp[playerid][ConstructionObject], vehicleid, 0.000, 1.050, -1.010, 0.000, 0.000, 0.000);
                        }
                        case 2:
                        {
                            p_temp[playerid][ConstructionObject] = CreateDynamicObject(19435, 0, 0, 0, 0, 0, 0);
                            SetDynamicObjectMaterial(p_temp[playerid][ConstructionObject], 0, 7978, "vgssairport", "newall_harling_sless", -1);
                            AttachDynamicObjectToVehicle(p_temp[playerid][ConstructionObject], vehicleid, 0.000, 0.920, 0.030, 0.000, 90.000, 0.000);
                        }
                        case 3:
                        {
                            p_temp[playerid][ConstructionObject] = CreateDynamicObject(19433, 0, 0, 0, 0, 0, 0);
                            AttachDynamicObjectToVehicle(p_temp[playerid][ConstructionObject], vehicleid, 0.000, 0.930, 0.029, 0.000, 90.000, 0.000);
                        }
                        case 4:
                        {
                            p_temp[playerid][ConstructionObject] = CreateDynamicObject(19843, 0, 0, 0, 0, 0, 0);
                            AttachDynamicObjectToVehicle(p_temp[playerid][ConstructionObject], vehicleid, 0.000, 0.640, -0.060, 0.000, 0.000, 0.000);
                        }
                        default:
                        {
                            p_temp[playerid][ConstructionObject] = CreateDynamicObject(2960, 0, 0, 0, 0, 0, 0);
                            SetDynamicObjectMaterial(p_temp[playerid][ConstructionObject], 0, 14653, "ab_trukstpb", "met_supp", 0);
                            AttachDynamicObjectToVehicle(p_temp[playerid][ConstructionObject], vehicleid, 0.000, 0.470, 0.290, 0.000, 0.000, 0.000);
                        }
                    }
                    p_temp[playerid][ConstructionCheck] ^= 1;

                    SendMes(playerid, COLOR_SEA_WAVE, "�� ��������� ��������������, �������� �� �� �������.");

                    new idx = random(sizeof(ConstructionVehiclePos));
                    SetPlayerRaceCheckpoint(playerid, 1, ConstructionVehiclePos[idx][0], ConstructionVehiclePos[idx][1], ConstructionVehiclePos[idx][2], 0.0, 0.0, 0.0, 2.5);

                    AntiCheatWarningTime[playerid][0] = timestamp + 3;
                }
                else
                {
                    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
                    {
                        new idx = random(sizeof(ConstructionVehiclePos));
                        SetPlayerRaceCheckpoint(playerid, 1, ConstructionVehiclePos[idx][0], ConstructionVehiclePos[idx][1], ConstructionVehiclePos[idx][2], 0.0, 0.0, 0.0, 2.5);
                        return 1;
                    }
                    if(AntiCheatWarningTime[playerid][0] > timestamp)
                    {
                        SendError(playerid, "�� �� ������ ���������� ������ ��� �����, ���������.");
                        new idx = random(sizeof(ConstructionVehiclePos));
                        SetPlayerRaceCheckpoint(playerid, 1, ConstructionVehiclePos[idx][0], ConstructionVehiclePos[idx][1], ConstructionVehiclePos[idx][2], 0.0, 0.0, 0.0, 2.5);
                        return 1;
                    }
                    if(p_temp[playerid][ConstructionObject] != INVALID_OBJECT_ID)
                    {
                        DestroyDynamicObject(p_temp[playerid][ConstructionObject]);
                        p_temp[playerid][ConstructionObject] = INVALID_OBJECT_ID;
                    }

                    p_temp[playerid][ConstructionCheck] ^= 1;
                    DisablePlayerRaceCheckpoint(playerid);
                    p_temp[playerid][ConstructionCount]++;
                    SendMes(playerid, COLOR_LYELLOW, "��������������� ����������: {"#cLIME"}%d.", p_temp[playerid][ConstructionCount]);

                    new reason_money = GetPlayerMoneySkill(playerid, 137, 3);

                    if(CheckPlayerMaxSalarySkill(playerid, 3, reason_money))
                    {
                        SetPlayerMoney(playerid, reason_money, true, "�������� �������");
                        OnServerInfoForMoney[17] += reason_money;
                        p_temp[playerid][ConstructionSalary] += reason_money;
                        SendMes(playerid, COLOR_LYELLOW, "� ����� �������� ���������: {"#cLIME"}%d$.{"#cLYELLOW"} ���������� �����: {"#cLIME"}%d$.", reason_money, p_temp[playerid][ConstructionSalary]);

                        p_info[playerid][job_skill_salary][3] += reason_money;
                    }
                    else SendError(playerid, "�� ��������� ��� ���� ���� ���������� ������������ ���������� �������� �������.");

                    if(GetPlayerGiveCasket(200, 5) != -1) GivePlayerCasket(playerid, 720);

                    UpdatePlayerWorkSkill(playerid, 3);

                    CheckPlayerMission(playerid, START_CONSTRUCTION);
                    CheckPlayerMission(playerid, DAILY_CONSTRUCTION);
                    CheckPlayerMission(playerid, ACHIEVEMENT_CONSTRUCTION);

                    CheckPlayerFreelance(playerid, FREELANCE_CONSTRUCTION);
                    CheckPlayerBattlePass(playerid, BATTLEPASS_CONSTRUCTION);

                    UpdateFamilyLevel(playerid);
                    UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_CONSTRUCTION); // ���������: ���������

                    STRING_GLOBAL[0] = EOS;
                    if(p_info[playerid][p_settings][INTERFACE])
                    {
                        f(STRING_GLOBAL, "%d", p_temp[playerid][ConstructionCount]);
                        PlayerTextDrawSetString(playerid, PTD_NewSalary[playerid][2], STRING_GLOBAL);
                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, "%d$", p_temp[playerid][ConstructionSalary]);
                        PlayerTextDrawSetString(playerid, PTD_NewSalary[playerid][1], STRING_GLOBAL);
                    }
                    else
                    {
                        f(STRING_GLOBAL, "Progress: %d", p_temp[playerid][ConstructionCount]);
                        PlayerTextDrawSetString(playerid, PTD_Salary[playerid][5], STRING_GLOBAL);
                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, "%d$", p_temp[playerid][ConstructionSalary]);
                        PlayerTextDrawSetString(playerid, PTD_Salary[playerid][6], STRING_GLOBAL);
                    }

                    new idx = random(sizeof(ConstructionWarehousePos));
                    SetPlayerRaceCheckpoint(playerid, 1, ConstructionWarehousePos[idx][0], ConstructionWarehousePos[idx][1], ConstructionWarehousePos[idx][2], 0.0, 0.0, 0.0, 2.5);

                    AntiCheatWarningTime[playerid][0] = timestamp + 3;

                    CheckPlayerBot(playerid, 10);
                }
                return 1;
            }
        }
    }
    return 1;
}

public OnPlayerLeaveRaceCheckpoint(playerid)
{
    if(p_info[playerid][loggedIn] != 1) return 0;
    return 1;
}

public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
    if(p_info[playerid][loggedIn] != 1) return 0;
    if(gPickupInfo[pickupid][pickup_type] != PICKUP_SUBTYPE_INVALID_ID &&
        gPickupInfo[pickupid][pickup_type] != TYPE_COSSACK_ROBBERS &&
        gPickupInfo[pickupid][pickup_type] != TYPE_VEHICLE)
    {
        new object_id = gPickupInfo[pickupid][pickup_object_id];
        if(gPickupInfo[pickupid][pickup_type] == TYPE_BUSINESS && gPickupInfo[pickupid][pickup_subtype] == PICKUP_SUBTYPE_BUSINESS_ENTER &&
            (b_info[object_id][_tip] == B_EAT || b_info[object_id][_tip] == B_CAR_SERVICE || b_info[object_id][_tip] == B_FUEL))
            SetPVarInt(playerid, "bID", gPickupInfo[pickupid][pickup_object_id]);

        if(p_temp[playerid][EventPickupID] != pickupid)
        {
            p_temp[playerid][EventPickupID] = pickupid;
            GetPlayerPos(playerid, p_temp[playerid][PickupPosX], p_temp[playerid][PickupPosY], p_temp[playerid][PickupPosZ]);
        }
        if(p_info[playerid][p_settings][INTERFACE]) ShowTextDrawForPlayer(playerid, TD_ID_PRESS_ALT);
        else GameTextForPlayer(playerid, "~n~~n~~g~PRESS ~b~ALT", 2500, 6);
        return 1;
    }

    if(GetTickCount() - p_temp[playerid][TickPickup] < 15000/*&& p_info[playerid][halloween_id] != 2*/)
        return 1;

    p_temp[playerid][EventPickupID] = pickupid;
    GetPlayerPos(playerid, p_temp[playerid][PickupPosX], p_temp[playerid][PickupPosY], p_temp[playerid][PickupPosZ]);

    p_temp[playerid][TickPickup] = GetTickCount();

    #if EVENT_HALLOWEEN == 1
    if(pickupid >= HalloweenQuest_FlowersPickups[0] && pickupid <= HalloweenQuest_FlowersPickups[MAX_HALLOWEEN_FLOWERS-1])
    {
        if(p_info[playerid][halloween_id] == 2 && p_info[playerid][halloween_progress] < 3)
        {
            ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 1, 1, 1, 0);
            p_temp[playerid][ClearAnimFix] = 1;
            p_temp[playerid][ClearAnimTimerFix] = timestamp + 3;
            new result = random(5);
            if(result <= 2)
            {
                p_info[playerid][halloween_progress]++;
                MysqlUpdatePlayerInt(playerid, "halloween_progress", p_info[playerid][halloween_progress]);
                SendAccess(playerid, "�������, ����� ������.");
            }
            else SendError(playerid, "� ���������, ����� ������� �� �������.");
            HalloweenQuest_Check(playerid);
        }
        return 1;
    }
    #endif

    switch(gPickupInfo[pickupid][pickup_type])
    {
        case TYPE_COSSACK_ROBBERS:
        {
            if(p_temp[playerid][cossack_robbers_register] != 2) return SendError(playerid, "�� �� ���������� � �������-�����������.");
            switch(gPickupInfo[pickupid][pickup_subtype])
            {
                case PICKUP_SUBTYPE_COS_ROB_A:
                {
                    GameTextForPlayer(playerid, "~b~ARMOUR: +100", 2000, 6);
                    SetPlayerArmour(playerid, 100);
                    SetPlayerChatBubble(playerid, "�����(-�) ����������", COLOR_MAIN, 20.0, 10000);
                }
                case PICKUP_SUBTYPE_COS_ROB_H:
                {
                    GameTextForPlayer(playerid, "~b~HEAL: +100", 2000, 6);
                    p_info[playerid][pHealth] = 100.0;
                    SetPlayerHealth(playerid, p_info[playerid][pHealth]);
                    SetPlayerChatBubble(playerid, "�������(-��/-���)", COLOR_MAIN, 20.0, 10000);
                }
            }
            return 1;
        }
        case TYPE_VEHICLE:
        {
            new vehicleid = gPickupInfo[pickupid][pickup_object_id];
            if(pickupid == veh_info[vehicleid][v_pickup])
            {
                if((army(playerid) == 1 || mafia(playerid) == 1 || gang(playerid) == 1 || biker(playerid) == 1 || IsPlayerFractionMedic(playerid) == 1 || p_temp[playerid][Work_ID] == OIL_WORK || p_temp[playerid][Work_ID] == ROADMAN_WORK))
                {
                    if(veh_info[vehicleid][v_loading] == 1 && p_temp[playerid][Work_ID] == DRUG_WORK)
                    {
                        if(veh_info[vehicleid][v_npoId] != p_info[playerid][member]) return SendError(playerid, "������������ �������� �� ����������� ����� �������.");
                        if(p_temp[playerid][WorkCountDrug] != 500) return SendError(playerid, "� ��� ��� ����������.");
                        if(veh_info[vehicleid][v_drugs] >= MAX_VEHICLE_DRUGS) return SendError(playerid, "� ������������ �������� ��� �����.");

                        new countOfDrugs = p_temp[playerid][WorkCountDrug];

                        veh_info[vehicleid][v_drugs] += countOfDrugs;
                        ClearAnimations(playerid);
                        ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                        if(veh_info[vehicleid][v_drugs] > MAX_VEHICLE_DRUGS) veh_info[vehicleid][v_drugs] = MAX_VEHICLE_DRUGS;

                        if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                        {
                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
                            "W"���������: "I"%d �� �� %d ��",
                            veh_info[vehicleid][v_drugs], MAX_VEHICLE_DRUGS);
                            Update3DTextLabelText(veh_info[vehicleid][v_text], COLOR_MAIN, STRING_GLOBAL);
                        }

                        new random_check = random(sizeof(drug_position)-1);
                        p_temp[playerid][WorkCheckDrug] = random_check;
                        p_temp[playerid][WorkCountDrug] = 0;

                        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);

                        SetPlayerCheckpoint(playerid, drug_position[random_check][0], drug_position[random_check][1], drug_position[random_check][2], 2.0);
                        SendInfo(playerid, "����� ������ ���� ���������� ������������� �� ����� ���������� �� GPS ����������.");

                        if(gang(playerid))
                        {
                            p_info[playerid][fracdata][19] += countOfDrugs;
                            SaveFracData(playerid);
                            CheckPlayerMission(playerid, GANG_LDRUGS, countOfDrugs);

                            p_info[playerid][ftop_gload_drugs] += countOfDrugs;
                            MysqlUpdatePlayerInt(playerid, "ftop_gload_drugs", p_info[playerid][ftop_gload_drugs]);
                        }
                        else if(mafia(playerid))
                        {
                            p_info[playerid][fracdata][24] += countOfDrugs;
                            SaveFracData(playerid);
                            CheckPlayerMission(playerid, MAFIA_LDRUGS, countOfDrugs);

                            p_info[playerid][ftop_mload_drugs] += countOfDrugs;
                            MysqlUpdatePlayerInt(playerid, "ftop_mload_drugs", p_info[playerid][ftop_mload_drugs]);
                        }
                        else if(biker(playerid))
                        {
                            p_info[playerid][fracdata][29] += countOfDrugs;
                            SaveFracData(playerid);
                            CheckPlayerMission(playerid, BIKER_LDRUGS, countOfDrugs);

                            p_info[playerid][ftop_bload_drugs] += countOfDrugs;
                            MysqlUpdatePlayerInt(playerid, "ftop_bload_drugs", p_info[playerid][ftop_bload_drugs]);
                        }

                        UpdateFamilyLevel(playerid);
                        return 1;
                    }
                    if(veh_info[vehicleid][v_loading] == 2)
                    {
                        if(veh_info[vehicleid][v_npoId] != p_info[playerid][member]) return SendError(playerid, "������������ �������� �� ����������� ����� �������.");

                        if(p_temp[playerid][LoadCount] == 0) return SendError(playerid, "� ��� ��� ����� � ��������� � �����������.");

                        if(veh_info[vehicleid][v_patron] == MAX_VEHICLE_PATRON_MATERIALS || veh_info[vehicleid][v_materials] == MAX_VEHICLE_PATRON_MATERIALS)
                        {
                            SendError(playerid, "� ������������ �������� ��� �����.");

                            ClearAnimations(playerid);
                            ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                            //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                            if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);

                            SetFractionWarehouse(NATIONAL_GUARD, fwMate, 500);
                            SetFractionWarehouse(NATIONAL_GUARD, fwPatron, 500);

                            UpdateWarehouseInfo(0);

                            p_temp[playerid][LoadCount] = 0;
                            return 1;
                        }

                        veh_info[vehicleid][v_patron] += 500;
                        veh_info[vehicleid][v_materials] += 500;

                        if(gang(playerid))
                        {
                            p_info[playerid][fracdata][21] += 1000;
                            SaveFracData(playerid);
                            CheckPlayerMission(playerid, GANG_LMATERIALS, 1000);

                            p_info[playerid][ftop_gload_materials] += 1000;
                            MysqlUpdatePlayerInt(playerid, "ftop_gload_materials", p_info[playerid][ftop_gload_materials]);
                        }
                        else if(mafia(playerid))
                        {
                            p_info[playerid][fracdata][26] += 1000;
                            SaveFracData(playerid);
                            CheckPlayerMission(playerid, MAFIA_LMATERIALS, 1000);

                            p_info[playerid][ftop_mload_materials] += 1000;
                            MysqlUpdatePlayerInt(playerid, "ftop_mload_materials", p_info[playerid][ftop_mload_materials]);
                        }
                        else if(biker(playerid))
                        {
                            p_info[playerid][fracdata][31] += 1000;
                            SaveFracData(playerid);
                            CheckPlayerMission(playerid, BIKER_LMATERIALS, 1000);

                            p_info[playerid][ftop_bload_materials] += 1000;
                            MysqlUpdatePlayerInt(playerid, "ftop_bload_materials", p_info[playerid][ftop_bload_materials]);
                        }

                        if(veh_info[vehicleid][v_patron] > MAX_VEHICLE_PATRON_MATERIALS) veh_info[vehicleid][v_patron] = MAX_VEHICLE_PATRON_MATERIALS;
                        if(veh_info[vehicleid][v_materials] > MAX_VEHICLE_PATRON_MATERIALS) veh_info[vehicleid][v_materials] = MAX_VEHICLE_PATRON_MATERIALS;

                        if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                        {
                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "�������: "W"%d �� %d"I"\n���������: "W"%d �� %d", veh_info[vehicleid][v_patron], MAX_VEHICLE_PATRON_MATERIALS, veh_info[vehicleid][v_materials], MAX_VEHICLE_PATRON_MATERIALS);
                            Update3DTextLabelText(veh_info[vehicleid][v_text], COLOR_MAIN, STRING_GLOBAL);
                        }

                        p_temp[playerid][LoadCount] = 0;

                        ClearAnimations(playerid);
                        ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
                        return 1;
                    }
                    if(veh_info[vehicleid][v_loading] == 3)
                    {
                        if(veh_info[vehicleid][v_npoId] != p_info[playerid][member]) return SendError(playerid, "������������ �������� �� ����������� ����� �������.");

                        if(p_temp[playerid][LoadCount] == 0) return SendError(playerid, "� ��� ��� ����� � ��������� � �����������.");

                        if(veh_info[vehicleid][v_patron] == MAX_VEHICLE_PATRON_MATERIALS || veh_info[vehicleid][v_materials] == MAX_VEHICLE_PATRON_MATERIALS)
                        {
                            SendError(playerid, "� ������������ �������� ��� �����.");

                            ClearAnimations(playerid);
                            ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                            //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                            if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);

                            SetFractionWarehouse(NATIONAL_GUARD, fwMate, 500);
                            SetFractionWarehouse(NATIONAL_GUARD, fwPatron, 500);

                            UpdateWarehouseInfo(0);

                            p_temp[playerid][LoadCount] = 0;
                            return 1;
                        }

                        veh_info[vehicleid][v_patron] += 500;
                        veh_info[vehicleid][v_materials] += 500;

                        p_info[playerid][fracdata][9] += 1000;
                        SaveFracData(playerid);
                        CheckPlayerMission(playerid, ARMY_LMATERIALS, 1000);

                        UpdateFamilyLevel(playerid);

                        p_info[playerid][ftop_aload_materials] += 1000;
                        MysqlUpdatePlayerInt(playerid, "ftop_aload_materials", p_info[playerid][ftop_aload_materials]);

                        if(veh_info[vehicleid][v_patron] > MAX_VEHICLE_PATRON_MATERIALS) veh_info[vehicleid][v_patron] = MAX_VEHICLE_PATRON_MATERIALS;
                        if(veh_info[vehicleid][v_materials] > MAX_VEHICLE_PATRON_MATERIALS) veh_info[vehicleid][v_materials] = MAX_VEHICLE_PATRON_MATERIALS;

                        if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                        {
                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "�������: "W"%d �� %d"I"\n���������: "W"%d �� %d", veh_info[vehicleid][v_patron], MAX_VEHICLE_PATRON_MATERIALS, veh_info[vehicleid][v_materials], MAX_VEHICLE_PATRON_MATERIALS);
                            Update3DTextLabelText(veh_info[vehicleid][v_text], COLOR_MAIN, STRING_GLOBAL);
                        }

                        p_temp[playerid][LoadCount] = 0;

                        ClearAnimations(playerid);
                        ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
                        return 1;
                    }
                    if(veh_info[vehicleid][v_loading] == 4)
                    {
                        if(veh_info[vehicleid][v_npoId] != p_info[playerid][member]) return SendError(playerid, "������������ �������� �� ����������� ����� �������.");

                        if(p_temp[playerid][LoadCount] == 0) return SendError(playerid, "� ��� ��� ����� � �������������.");

                        if(veh_info[vehicleid][v_medicines] == MAX_VEHICLE_MEDICINES)
                        {
                            SendError(playerid, "� ������������ �������� ��� �����.");

                            ClearAnimations(playerid);
                            ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                            //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                            if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);

                            WarehouseMedicines += 500;
                            MysqlUpdateOtherInt("warehouse_medicines", WarehouseMedicines);

                            UpdateWarehouseInfo(1);

                            p_temp[playerid][LoadCount] = 0;
                            return 1;
                        }

                        veh_info[vehicleid][v_medicines] += 500;

                        p_info[playerid][fracdata][15] += 500;
                        SaveFracData(playerid);
                        CheckPlayerMission(playerid, HOSPITAL_LMEDICINES, 500);

                        UpdateFamilyLevel(playerid);

                        p_info[playerid][ftop_hload_medicines]++;
                        MysqlUpdatePlayerInt(playerid, "ftop_hload_medicines", p_info[playerid][ftop_hload_medicines]);

