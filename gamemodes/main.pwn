CMD:dice(playerid, params[])
{
    if(!PlayerToPoint(100.0, playerid, 493.4070,-24.8200,1000.6799) &&
        !PlayerToPoint(100.0, playerid, 502.0140,-67.6100,998.7579) &&
        !PlayerToPoint(100.0, playerid, 1204.7500,-13.8010,1000.9219) &&
        !PlayerToPoint(100.0, playerid, -2636.6809,1402.5260,906.4609) &&
        !PlayerToPoint(100.0, playerid, -229.2480,1401.2590,27.7660)) return SendError(playerid, "Вы должны находиться в баре.");

    /*if(!PlayerToPoint(100.0,playerid, 1946.9025,1015.7595,1991.4031))
        return SendError(playerid, "Вы должны находиться в казино.");*/

    if(sscanf(params, "ud", params[0], params[1]))
        return SendInfo(playerid, "Введите: /dice [id игрока] [ставка]");
    if(params[1] < 100 || params[1] > 1000000)
        return SendError(playerid, "Минимальная ставка 100$ максимальная 1000000$.");
    if(params[0] == INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок не в сети.");
    if(params[0] == playerid) return 1;
    if(!IsPlayerStream(6.0, playerid, params[0]))
        return SendError(playerid, "Игрок слишком далеко.");
    if(p_info[params[0]][cash] < params[1])
        return SendError(playerid, "У этого игрока нет столько денег.");
    if(p_info[playerid][cash] < params[1])
        return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
    if(p_temp[params[0]][dice_targetid] != INVALID_PLAYER_ID)
        return SendError(playerid, "У игрока уже есть предложение.");
    if(p_temp[playerid][dice_targetid] != INVALID_PLAYER_ID)
        return SendError(playerid, "У Вас уже есть предложение.");

    SendAccess(playerid, "Вы предложили %s бросить кости. Ставка: %i$", get_name(params[0]), params[1]);
    SendInfo(playerid, "чтобы отменить: "I"/ndice (либо N)");

    SendInfo(params[0], "%s предлагает бросить кости. Ставка: %i$", get_name(playerid), params[1]);
    SendInfo(params[0], "Введите: "I"/ydice (Либо нажмите Y) "W"чтобы согласиться "I"/ndice (либо N) "W"для отказа.");

    p_temp[params[0]][dice_targetid] = playerid;
    p_temp[playerid][dice_targetid] = params[0];
    p_temp[params[0]][dice_response] = 1;

    p_temp[params[0]][dice_money] =
    p_temp[playerid][dice_money] = params[1];

    PreloadAnimLib(playerid, "CARRY");
    PreloadAnimLib(params[0], "CARRY");
    return true;
}
cmd:ndice(playerid, params[])
{
    new targetid = p_temp[playerid][dice_targetid];
    if(targetid == INVALID_PLAYER_ID || !p_temp[playerid][dice_money])
        return 1;

    SendInfo(playerid, "Вы отказались от игры в кости.");
    SendInfo(targetid, "%s отказался от игры в кости.", get_name(playerid));

    EndBones(playerid);
    return 1;
}

cmd:ydice(playerid, params[])
{
    new targetid = p_temp[playerid][dice_targetid];
    if(targetid == INVALID_PLAYER_ID || !p_temp[playerid][dice_response])
        return 1;

    new bones[2],
        money_win = p_temp[playerid][dice_money];

    if(p_info[playerid][cash] < money_win)
    {
        EndBones(playerid);
        EndBones(targetid);

        SendError(playerid, "Игра не может быть совершена, у Вас нет столько денег.");
        SendError(targetid, "Игра не может быть совершена, у игрока нет столько денег.");
        return 1;
    }
    if(p_info[targetid][cash] < money_win)
    {
        EndBones(playerid);
        EndBones(targetid);

        SendError(targetid, "Игра не может быть совершена, у Вас нет столько денег.");
        SendError(playerid, "Игра не может быть совершена, у игрока нет столько денег.");
        return 1;
    }
    if(p_temp[playerid][dice_timer] > 0) return 1;

    bones[0] = random(6)+1;
    bones[1] = random(6)+1;

    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "%s и %s бросили кости. Результат: {CC9900}%i:%i", get_name(targetid), get_name(playerid), bones[0], bones[1]);
    ProxDetector(30.0, playerid, STRING_GLOBAL, 0xC2A2DAAA,0xC2A2DAAA,0xC2A2DAAA,0xC2A2DAAA,0xC2A2DAAA);

    new
        bizz_id = GetPVarInt(targetid, "bID"),
        biz_percent = b_info[bizz_id][_percent],
        percent = 100 - biz_percent,
        win_money = (money_win/100)*percent,
        biz_money = money_win - win_money
    ;

    if(bones[0] > bones[1])
    {
        SendInfo(playerid, "К сожалению, Вы проиграли.");
        SendInfo(targetid, "Поздравляем, Вы выиграли.");

        SetPlayerMoney(playerid, -money_win, true, "/dice проигрыш");
        SetPlayerMoney(targetid, win_money, true, "/dice победа");

        if(b_info[bizz_id][_prod] >= biz_money / 100)
        {
            b_info[bizz_id][_prod] -= biz_money / 100;
            b_info[bizz_id][_bank] += biz_money - (biz_money / 10);
            AddMafiaBank(bizz_id, biz_money / 10);

            biz_finka[bizz_id] += biz_money - (biz_money / 10);
            UpdateIntForFinanceBiz(bizz_id, biz_money - (biz_money / 10));
        }
    }
    if(bones[0] < bones[1])
    {
        SendInfo(targetid, "К сожалению, Вы проиграли.");
        SendInfo(playerid, "Поздравляем, Вы выиграли.");

        SetPlayerMoney(targetid, -money_win, true, "/dice проигрыш");
        SetPlayerMoney(playerid, win_money, true, "/dice победа");

        if(b_info[bizz_id][_prod] >= biz_money / 100)
        {
            b_info[bizz_id][_prod] -= biz_money / 100;
            b_info[bizz_id][_bank] += biz_money - (biz_money / 10);
            AddMafiaBank(bizz_id, biz_money / 10);

            biz_finka[bizz_id] += biz_money - (biz_money / 10);
            UpdateIntForFinanceBiz(bizz_id, biz_money - (biz_money / 10));
        }
    }
    if(bones[0] == bones[1])
    {
        SendInfo(playerid, "Игра закончилась в ничью.");
        SendInfo(targetid, "Игра закончилась в ничью.");
    }

    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "Выпало: %i", bones[0]);
    SetPlayerChatBubble(targetid, STRING_GLOBAL, COLOR_MAIN, 20.0, 10000);
    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "Выпало: %i", bones[1]);
    SetPlayerChatBubble(playerid, STRING_GLOBAL, COLOR_MAIN, 20.0, 10000);

    ApplyAnimation(playerid,"CARRY", "crry_prtial",4.1,1,0,0,1,1);
    ApplyAnimation(targetid,"CARRY", "crry_prtial",4.1,1,0,0,1,1);

    new Float:bone_pos[][] =
    {
        {93.000000, -0.699998}, // 1
        {183.000000, -0.699998}, // 2
        {3.000000, 90.000000}, // 3
        {3.000000, 270.000000}, // 4
        {3.000000, -0.699998}, // 5
        {273.000000, -0.699998} // 6
    };

    SetPlayerAttachedObject(targetid, 9, 1851, 1, 0.194999, 0.397000, -0.028000, -3.399997, bone_pos[bones[0]-1][0], bone_pos[bones[0]-1][1], 1.000000, 1.000000, 1.000000);
    SetPlayerAttachedObject(playerid, 9, 1851, 1, 0.194999, 0.397000, -0.028000, -3.399997, bone_pos[bones[1]-1][0], bone_pos[bones[1]-1][1], 1.000000, 1.000000, 1.000000);

    p_temp[playerid][dice_timer] =
    p_temp[targetid][dice_timer] = 5;

    p_temp[playerid][dice_response] = 0;
    return 1;
}
EndBones(playerid)
{
    if(p_temp[playerid][dice_targetid] == INVALID_PLAYER_ID) return 1;
    new targetid = p_temp[playerid][dice_targetid];

    p_temp[playerid][dice_targetid] =
    p_temp[targetid][dice_targetid] = INVALID_PLAYER_ID;

    p_temp[targetid][dice_money] =
    p_temp[playerid][dice_money] =

    p_temp[targetid][dice_timer] =
    p_temp[playerid][dice_timer] =

    p_temp[targetid][dice_response] =
    p_temp[playerid][dice_response] = 0;

    if(IsPlayerAttachedObjectSlotUsed(playerid, 9)) RemovePlayerAttachedObject(playerid, 9);// забрали кубик
    if(IsPlayerAttachedObjectSlotUsed(targetid, 9)) RemovePlayerAttachedObject(targetid, 9);// забрали кубик

    ClearAnimations(playerid);
    ClearAnimations(targetid);

    ApplyAnimation(playerid,"FAT","IDLE_tired", 4.0, 0, 0, 0, 0, 1);
    ApplyAnimation(targetid,"FAT","IDLE_tired", 4.0, 0, 0, 0, 0, 1);

    //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
    //SetPlayerSpecialAction(targetid, SPECIAL_ACTION_NONE);
    return 1;
}
