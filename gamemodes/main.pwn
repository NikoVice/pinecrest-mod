            if(p_info[playerid][level] < 3)
                return callcmd::snews(playerid), SendError(playerid, "Голосовать можно с 3 уровня");
            new id = p_temp[playerid][p_listitem_int],
                iRating = p_temp[playerid][p_listitem][LIST_OFFSET_MAX+id];
            if(1 <= iRating <= 5)
                return callcmd::snews(playerid), SendError(playerid, "Вы уже проголосовали за новость.");
            new mysqlID = p_temp[playerid][p_listitem][id];

            p_temp[playerid][p_listitem][LIST_OFFSET_MAX+id] = listitem+1;
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `server_forum_stats` SET `rating` = %d WHERE `userid` = %d AND `newsid` = %d",
                listitem+1, p_info[playerid][ID], mysqlID);
            mysql_tquery(con_bd, STRING_GLOBAL, "OnUpdateSFNewsCallback", "iii", playerid, p_info[playerid][ID], mysqlID);

            SendAccess(playerid, "Спасибо за вашу оценку, нам очень важно получать от вас обратную связь.");
            return 1;
        }
        case D_SERVICE_BUY_VEHICLE_TUNE:
        {
            if(!response) return 1;
            new id = p_temp[playerid][p_listitem_int];
            p_temp[playerid][p_listitem_int] = -1;
            if(id == -1) return 1;
            new price = ItemsInfo[id][iPrice];

            if(p_info[playerid][cash] < price)
            {
                if(!p_temp[playerid][TextDrawServiceTune])
                    ShowDialogTuneDefault(playerid);
                SendError(playerid, "У Вас не достаточно денег.");
                return 1;
            }

            if(!GivePlayerInventory(playerid, id, .reason = "покупка в СТО акссесуара на Т/С"))
                return 1;

            BuyPlayerService(playerid, price);
            SendAccess(playerid, "Вы приобрели %s за %d$.", ItemsInfo[id][iName], price);
            return 1;
        }
        case D_CHANGENICK_LIST:
        {
            if(!response) return 1;
            if(!(0 <= listitem <= MAX_CHANGE_NICK)) return 1;
            new targetid = ChangeNickName[listitem];
            if(targetid == INVALID_PLAYER_ID || !IsPlayerConnected(targetid))
                return SendError(playerid, "Игрок не в сети.");
            if(GetPVarInt(targetid, "CHANGE_NICK:FREE") != 1)
                return SendError(playerid, "Игрок не подавал заявление на изменение никнейма.");
            p_temp[playerid][p_listitem_int] = targetid;
            ShowPlayerDialog(playerid, D_CHANGENICK_SOLUTION, DIALOG_STYLE_MSGBOX, ""I"Cмена ника", ""W"Подтвердите или удалите запрос игрока.", "Сменить", "Удалить");
            return 1;
        }
        case D_CHANGENICK_SOLUTION:
        {
            new targetid =  p_temp[playerid][p_listitem_int];
            p_temp[playerid][p_listitem_int] = -1;
            if(targetid == INVALID_PLAYER_ID || !IsPlayerConnected(targetid))
            {
                callcmd::changename(playerid);
                return SendError(playerid, "Игрок не в сети.");
            }
            if(GetPVarInt(targetid, "CHANGE_NICK:FREE") != 1)
            {
                ClearChangeNick(targetid);
                DeletePVar(targetid, "NewNickName");
                callcmd::changename(playerid);
                return SendError(playerid, "Игрок не подавал заявление на изменение никнейма.");
            }

            new new_nickname[MAX_PLAYER_NAME+1];
            GetPVarString(targetid, "NewNickName", new_nickname, MAX_PLAYER_NAME);
            DeletePVar(targetid, "NewNickName");

            if(!response) 
            {
                ClearChangeNick(targetid);
                SendInfo(targetid, "Администратор отклонил вашу заявку на смену ника.");
                SendInfo(playerid, "Вы отклонили %s заявку на смену ника.", get_name(targetid));
            }
            else
            {
                if(!(3 <= strlen(new_nickname) <= 20))
                    return SendError(playerid, "Игрок ввел неверный ник.");

                SendMesAll(0xFFD700FF, "Внимание! "W"%s [%d] изменил никнейм на %s.", get_name(targetid), targetid, new_nickname);

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] одобрил заявление на изменение никнейма %s [%d] на %s.", get_name(playerid), playerid, get_name(targetid), targetid, new_nickname);
                SendAdminMessage(0x33CC66FF, STRING_GLOBAL);

                WriteAdminLog(TYPE_LOG_SETNICK, playerid, get_name(targetid), targetid);
                SetPlayerNickName(targetid, new_nickname);
            }
            callcmd::changename(playerid);
            return 1;
        }
