CMD:ftazer(playerid, params[])
{
    if(p_info[playerid][member] != FBI_TEAM) return 1;
    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "Используйте: /ftazer [тип]");
    if(!(1 <= params[0] <= 3)) return SendError(playerid, "Тип должен быть не менее 1 и не более 3.");

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "на поясе висит шоковая граната.");
        MeAction(playerid, "сняв шоковую гранату с пояса, вынул чеку и бросил гранату на землю");
        DoAction(playerid, "шоковая граната сдетонировала ударившись об землю, оглушив цели.");
    }

    if(params[0] == 1)
    {
        foreach(new targetid : Player)
        {
            if(IsPlayerStream(15.0, playerid, targetid) && targetid != playerid)
            {
                if(p_info[targetid][p_afkTime] > 2) continue;
                SendInfo(targetid, "Вы заморожены на 10 секунд.");
                SetPlayerSpecialAction(targetid, SPECIAL_ACTION_HANDSUP);
                Fix_TogglePlayerControllable(targetid, 0);
                p_temp[targetid][UnFreezeFix] = 1;
                p_temp[targetid][UnFreezeTimerFix] = timestamp + 15;
            }
        }
    }
    else if(params[0] == 2)
    {
        foreach(new targetid : Player)
        {
            if(IsPlayerStream(15.0, playerid, targetid) && targetid != playerid && GetFactionType(targetid) == FACTION_TYPE_GOS)
            {
                if(p_info[targetid][p_afkTime] > 2) continue;
                SendInfo(targetid, "Вы заморожены на 10 секунд.");
                SetPlayerSpecialAction(targetid, SPECIAL_ACTION_HANDSUP);
                Fix_TogglePlayerControllable(targetid, 0);
                p_temp[targetid][UnFreezeFix] = 1;
                p_temp[targetid][UnFreezeTimerFix] = timestamp + 15;
            }
        }
    }
    else if(params[0] == 3)
    {
        foreach(new targetid : Player)
        {
            if(IsPlayerStream(15.0, playerid, targetid) && targetid != playerid && p_info[playerid][member] == NONE_FRACTION)
            {
                if(p_info[targetid][p_afkTime] > 2) continue;
                SendInfo(targetid, "Вы заморожены на 10 секунд.");
                SetPlayerSpecialAction(targetid, SPECIAL_ACTION_HANDSUP);
                Fix_TogglePlayerControllable(targetid, 0);
                p_temp[targetid][UnFreezeFix] = 1;
                p_temp[targetid][UnFreezeTimerFix] = timestamp + 15;
            }
        }
    }
    return 1;
}
CMD:repaircar(playerid, params[])
{
    if(RegisterDerby[playerid] == 2) return SendError(playerid, "На мероприятии запрещено использовать рем. комплект.");
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return SendError(playerid, "Вы должны находиться на ногах.");
    new vehicleid = GetPlayerNearestVehicleID(playerid, 7.0);
    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "Рядом с Вами нет транспортного средства.");
    new Float:x, Float:y, Float:z;
    GetCoordBonnetVehicle(vehicleid, x, y, z);
    if(!IsPlayerInRangeOfPoint(playerid, 7.5, x, y, z)) return SendError(playerid, "Вы далеко от капота.");
    if(!GivePlayerInventory(playerid, 631, -1)) return SendError(playerid, "У Вас нет рем. комплекта.");

    GameTextForPlayer(playerid, "~r~repair vehicle 5 seconds", 1000, 1);
    p_temp[playerid][repair_timer] = 5;
    ApplyAnimation(playerid, "INT_SHOP", "shop_cashier", 4.1, 1, 0, 0, 1, 1);
    p_temp[playerid][ClearAnimFix] = 1;
    p_temp[playerid][ClearAnimTimerFix] = timestamp + 5;
    SetPVarInt(playerid, #VEHICLE_ID_REPAIR, vehicleid);
    return 1;
}
alias:repaircar("rc","rcar");

CMD:pour(playerid, params[])
{
    new vehicleid = GetPlayerNearestVehicleID(playerid, 5.0);
    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "Рядом с Вами нет транспортного средства.");
    if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_VELO_MOPED) return 1;
    if(veh_info[vehicleid][v_fuel] >= GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_FUEL)) return SendError(playerid, "У Вас полный бак.");
    if(!(GivePlayerInventory(playerid, 630, -1))) return SendError(playerid, "У Вас нет канистры.");

    veh_info[vehicleid][v_fuel] += 5.0;
    if(veh_info[vehicleid][v_fuel] > GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_FUEL)) veh_info[vehicleid][v_fuel] = GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_FUEL);
    GameTextForPlayer(playerid, "~b~+ 5 ~w~Fuel", 1000, 1);
    SendAccess(playerid, "Вы воспользовались канистрой.");
    return 1;
}

CMD:carmenu(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || vehicleid == 0)
        return SendError(playerid, "Вы не за рулем транспортного средства.");
    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "\
        "I"[1]"W" Двигатель (%s)\n\
        "I"[2]"W" Фары (%s)\n\
        "I"[3]"W" Двери (%s)",
        veh_info[vehicleid][v_engine] == 1 ? ("{33CC66}Включен"W"") : ("{"#cLIGHTRED"}Выключен"W""),
        veh_info[vehicleid][v_light] == 1 ? ("{33CC66}Включены"W"") : ("{"#cLIGHTRED"}Выключены"W""),
        veh_info[vehicleid][v_lock] == 1 ? ("{"#cLIGHTRED"}Закрыты"W"") : ("{33CC66}Открыты"W""));
    ShowPlayerDialog(playerid, D_CAR_MENU, DIALOG_STYLE_LIST, ""I"Меню транспортного средства", STRING_GLOBAL, "Далее", "Отмена");
    return 1;
}

CMD:cars(playerid, params[])
{
    ShowPlayerDialog(playerid, D_CARS_LIST, DIALOG_STYLE_LIST, ""I"Транспорт", ""I"[1]"W" Велик\n"I"[2]"W" Мото\n"I"[3]"W" Автомобиль\n"I"[4]"W" Водный\n"I"[5]"W" Воздушный", "Выбрать", "Отмена");
    return 1;
}
alias:cars("vehicles", "vehs");

forward list_player_vehicle(playerid, veh_type, type_select);
public list_player_vehicle(playerid, veh_type, type_select)
{
    if(!(0 <= veh_type <= 5) || !(0 <= type_select <= 1)) return SendError(playerid, "Код ошибки: 1008 (Обратитесь к администрации)");

    new rows = cache_num_rows();

    new status_used[36],
        modelid,
        fmt_str[144],
        twinturbo,
        premium,
        bonus, count_veh, sell_block;
    static const twinturbo_status[][] = {"", "[{ffff00}TT"W"]"};
    static const premium_status[][] = {"", "[{ffff00}PREMIUM"W"]"};
    STRING_GLOBAL[0] = EOS;
    if(rows)
    {
        for(new idx; idx < rows; idx++)
        {
            if(count_veh >= 30) break;

            p_temp[playerid][p_listitem_cars][count_veh] = -1;
            cache_get_value_name_int(idx, "v_model", modelid);
            if(GetVehicleData(modelid, E_VD_TYPE) != veh_type) continue;
            cache_get_value_name_int(idx, "v_mysql_id", p_temp[playerid][p_listitem_cars][count_veh]);
            
            if(type_select)
                p_temp[playerid][p_listitem][count_veh] = modelid;

            cache_get_value_name_int(idx, "v_twinturbo", twinturbo);
            cache_get_value_name_int(idx, "v_premium", premium);
            cache_get_value_name_int(idx, "v_bonus", bonus);
            cache_get_value_name_int(idx, "v_sell_block", sell_block);

            if(GetSlotVehicleMarket(p_temp[playerid][p_listitem_cars][count_veh]) != -1) format(status_used, sizeof status_used, ""A"[На авторынке]");
            else format(status_used, sizeof status_used, "%s", GetPlayerVehicleMySQLID(playerid, p_temp[playerid][p_listitem_cars][count_veh]) != -1 ? "[{ffcc00}Используется"W"]" : "[{669900}Не используется"W"]");
            f(STRING_GLOBAL, "%s"I"[%d]"W" %s %s %s \t%s%s%s\n", STRING_GLOBAL, count_veh+1, GetVehicleName(INVALID_VEHICLE_ID, modelid), twinturbo_status[twinturbo], premium_status[premium], status_used, bonus == 0 ? "" : "[{ffff00}BONUS"W"]", sell_block == 0 ? "" : "[{"#cLIGHTRED"}Подарочный т/с, продажа за 0$"W"]");
            count_veh++;
        }
    }
    if(count_veh < GetPlayerLimiteCars(playerid, veh_type))
    {
        for(new idx = count_veh; idx < GetPlayerLimiteCars(playerid, veh_type); idx++)
        {
            p_temp[playerid][p_listitem_cars][idx] = -1;
            f(STRING_GLOBAL, "%s"I"[%d]"W" Слот свободный\n", STRING_GLOBAL, idx+1);
        }
    }
    p_temp[playerid][loadcar_max] = count_veh;
    p_temp[playerid][p_listitem_int] = veh_type;
    if(!type_select)
    {
        if(count_veh <= 30) f(STRING_GLOBAL, "%s"I"[%d]"W" Купить дополнительный слот\t ", STRING_GLOBAL, GetPlayerLimiteCars(playerid, veh_type)+1);
        f(fmt_str, ""I"%s | Слоты: %d/%d", vehicle_type_name[veh_type], count_veh, GetPlayerLimiteCars(playerid, veh_type));
        ShowPlayerDialog(playerid, D_LOAD_CAR, DIALOG_STYLE_TABLIST, fmt_str, STRING_GLOBAL, "Далее", "Отмена");
    }
    else 
    {
        f(fmt_str, ""I"%s", vehicle_type_name[veh_type]);
        ShowPlayerDialog(playerid, D_FAMILY_TRANSFER_VEHICLE_MENU, DIALOG_STYLE_TABLIST, fmt_str, STRING_GLOBAL, "Далее", "Отмена");
    }
    return 1;
}

CMD:unrent(playerid, params[])
{
    new vehicleid = p_temp[playerid][rented_veh];
    if(!IsPlayerRentedVehicle(playerid, vehicleid)) 
        return SendError(playerid, "Вы не арендуете Т/С.");
    if(GetPlayerVehicleID(playerid) == vehicleid)
    {
        new Float:POS[3];
        GetVehiclePos(vehicleid, POS[0], POS[1], POS[2]);
        SetPlayerPos(playerid, POS[0]+1, POS[1]+1, POS[2]+0.3);
    }
    if(veh_info[vehicleid][v_npoType] == NPO_JOB) EndPlayerJob(playerid);
    else
    {
        if(veh_info[vehicleid][v_temp_job])
        {
            veh_info[vehicleid][v_temp_job] = 0;
            new scdplayerid = veh_info[vehicleid][v_used_key_ID];
            if(scdplayerid != INVALID_PLAYER_ID) EndPlayerJob(scdplayerid);
        }
        veh_info[vehicleid][v_rented_ID] = INVALID_MYSQL_ID;
        veh_info[vehicleid][v_used_key_ID] = INVALID_PLAYER_ID;
        p_temp[playerid][rented_veh] = INVALID_VEHICLE_ID;

        if(veh_info[vehicleid][v_npoType] != NPO_PLAYERCAR) 
            DestroyVehicleVEx(vehicleid);
    }
    SendMes(playerid, COLOR_BLUE, "Вы отказались от аренды транспортного средства.");
    return 1;
}

CMD:fixcar(playerid, params[])
{
    VehiclePlayerList(playerid, VEHICLE_ID_DELIVERY);
    return 1;
}

CMD:findcar(playerid, params[])
{
    VehiclePlayerList(playerid, VEHICLE_ID_FIND);
    return 1;
}

VehiclePlayer_Delivery(playerid, vehicleid)
{
    if(AntiDMZone(playerid)) return SendError(playerid, "Вы не можете доставить транспортное средство в \"Зеленой зоне\".");
    if(GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0) return SendError(playerid, "Вы не можете доставить транспортное средство в помещении.");
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return SendError(playerid, "Вы должны находиться не в транспортном средстве.");
    new vehtype = GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE);
    if(vehtype == VEHICLE_STATE_TRAIN)
        return 1;
    if(SRV_ID && veh_info[vehicleid][v_insurance] == 0 &&
        veh_info[vehicleid][v_bonus] == 0 &&
        (vehtype == VEHICLE_STATE_VELO_MOPED || 
        vehtype == VEHICLE_STATE_MOTO || 
        vehtype == VEHICLE_STATE_CAR))
        return SendError(playerid, "На транспортном средстве должна быть страховка.");
    new price_veh_spawn = 5000;
    if(veh_info[vehicleid][v_premium]) price_veh_spawn = price_veh_spawn / 2;
    if(p_info[playerid][cash] < price_veh_spawn) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
    if(IsVehicleOccupied(vehicleid)) return SendError(playerid, "Транспортное средство используется.");
    if(GetSlotVehicleMarket(veh_info[vehicleid][v_mysql_id]) != -1)
        return SendError(playerid, "Взаимодействие с транспортным средство невозможно, оно находится на авторынке.");
    new Float:POS[3];
    GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
    if(POS[2] > 0.3 && vehtype == VEHICLE_STATE_BOAT)
        return SendError(playerid, "Вы не находитесь в воде.");
    if(POS[2] < 0.3 && vehtype != VEHICLE_STATE_BOAT)
        return SendError(playerid, "Вы находитесь в воде.");

    SetPlayerMoney(playerid, -price_veh_spawn, true, "оплатил fixcar <%s>(%d)[%d]", GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id]);

    if(vehtype == VEHICLE_STATE_BOAT)
    {
        SetVehiclePos(vehicleid, POS[0], POS[1], POS[2]+0.3);
        PutPlayerInVehicle(playerid, vehicleid, 0);
    }
    else
        SetVehiclePos(vehicleid, POS[0]+1+random(2), POS[1]+1+random(2), POS[2]+0.3);

    LinkVehicleToInterior(vehicleid, 0);
    SetVehicleVirtualWorld(vehicleid, 0);
    SendAccess(playerid, "Вы доставили транспортное средство.");
    return 1;
}

VehiclePlayer_Find(playerid, vehicleid)
{
    if(IsGPSVisable(playerid) != -1) return 1;

    new Float:POS[3];
    new id_parking = GetVehicleVirtualWorld(vehicleid)-5000;
    if(id_parking >= 0 && id_parking < MAX_PARKING)
    {
        POS[0] = ParkData[id_parking][p_enter][0];
        POS[1] = ParkData[id_parking][p_enter][1];
        POS[2] = ParkData[id_parking][p_enter][2];
        SendInfo(playerid, "Ваше Т/С находится на парковке #%d.", id_parking);
    }
    else GetVehiclePos(vehicleid, POS[0], POS[1], POS[2]);

    new Float:distance = GetPlayerDistanceFromPoint(playerid, POS[0], POS[1], POS[2]);
    if(p_temp[playerid][TaxiGPS] == true)
    {
        if(GetPlayerTaxiDriver(playerid) == INVALID_PLAYER_ID) return SendError(playerid, "В такси нет водителя.");

        new driverid = GetPlayerTaxiDriver(playerid);
        p_temp[playerid][TaxiGPS] = false;
        SetPlayerGPS(driverid, POS[0], POS[1], POS[2],5.0);

        SendInfo(driverid, "%s обозначил место назначения. Расстояние: %.0f метров.", get_name(playerid), distance);
        return 1;
    }
    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);

    SetPlayerGPS(playerid, POS[0], POS[1], POS[2],5.0);
    SendInfo(playerid, "\"Транспорт\" отмечен на GPS навигаторе. Расстояние: %.0f метров.", distance);
    return 1;
}

CMD:ipremium(playerid, params[])
{
    if(GetInventoryAmount(playerid, 681) <= 0) return SendError(playerid, "У Вас нет Premium на т/с.");
    if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Вы должны находиться в транспортном средстве.");
    new vehicleid = GetPlayerNearestVehicleID(playerid, 5.0);
    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "Рядом с Вами нет транспортного средства.");
    if(!IsPlayerOwnerVehicle(playerid, vehicleid) && veh_info[vehicleid][v_family_id] == -1) return SendError(playerid, "Вы должны находиться в своем личном транспортном средстве.");
    if(veh_info[vehicleid][v_bonus] != 0) return SendError(playerid, "На бонусное транспортное средство нельзя установить Premium.");
    if(veh_info[vehicleid][v_premium] == 1) return SendError(playerid, "Данное транспортное средство итак является Premium.");
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы действительно хотите установить \"Premium\" на \"%s\"?", GetVehicleName(vehicleid));
    ShowPlayerDialog(playerid, D_INSTALL_PREMIUM_CAR, DIALOG_STYLE_MSGBOX, ""I"Premium на транспортное средство", STRING_GLOBAL, "Да", "Нет");
    return 1;
}

CMD:park(playerid, params[])
{
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "Вы должны находиться за рулем транспортного средства.");
    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID ||
        !IsPlayerOwnerVehicle(playerid, vehicleid)) return SendError(playerid, "Вы слишком далеко от своего транспортного средства.");
    if(AntiDMZone(playerid)) return SendError(playerid, "Вы не можете припарковать транспортное средство в \"Зеленой зоне\".");

    new Float:POS[3];
    GetVehiclePos(vehicleid, POS[0], POS[1], POS[2]);

    if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_BOAT && POS[2] < 0.2) return SendError(playerid, "Вы не можете припарковать транспортное средство в воде.");
    if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_PLANE)
    {
        new aero_check;
        if((IsPlayerInRangeOfPoint(playerid, 150.0, 1499.3673,1526.0774,10.9874) ||
            IsPlayerInRangeOfPoint(playerid, 100.0, -1299.7699,-155.4822,14.148) ||
            IsPlayerInRangeOfPoint(playerid, 100.0, 1944.9186,-2324.0544,13.5469)) && POS[2] < 16.9874) aero_check++;

        new h;
        for(new i; i < p_info[playerid][house_slots]; i++)
        {
            h = GetPlayerHouseID(playerid, i);
            if(h != INVALID_HOUSE_ID && IsPlayerInRangeOfPoint(playerid, 25.0, h_info[h][h_enter][0],h_info[h][h_enter][1], h_info[h][h_enter][2])) aero_check++;
        }
        if(aero_check == 0) return SendError(playerid, "Припарковать транспортное средство можно только на территории аэропортов и возле дома.");
    }
    if(gang(playerid) && GetVehicleModelEx(vehicleid) == 508 && GetPlayerStatusCapture(playerid) == CAPTURE_ID_GANG)
    {
        new i = -1;
        if(Capture_Info[0][gFaction][0] == p_info[playerid][member] || Capture_Info[0][gFaction][1] == p_info[playerid][member])
            i = 0;
        else if(Capture_Info[1][gFaction][0] == p_info[playerid][member] || Capture_Info[1][gFaction][1] == p_info[playerid][member])
            i = 1;
        
        if(i != -1 && Capture_Info[i][gGangZoneID] != INVALID_CRIMINAL_ZONE_ID)
        {
            new gangzone = Capture_Info[i][gGangZoneID];
            if(IsPlayerCaptureZone(playerid, GangZone_Info[gangzone][gCoords][0], GangZone_Info[gangzone][gCoords][1], GangZone_Info[gangzone][gCoords][2], GangZone_Info[gangzone][gCoords][3]))
                return SendError(playerid, "Нельзя парковать т/с в зоне захвата территори.");
        }
    }
    if(GetPlayerVirtualWorld(playerid) > 0 && GetPlayerVirtualWorld(playerid) < 5000)
    {
        new h = GetHouseGameID(playerid);
        if(p_info[playerid][key_h_rent] == h || h_info[h][h_user_id] == p_info[playerid][ID])
        {
            if(GetPlayerVirtualWorld(playerid) != h+50)
                return SendError(playerid, "Припарковать транспортное средство можно только в своем гараже.");
            if(p_info[playerid][key_h_rent] == h && p_info[playerid][h_r_settings][R_GARAGE] == 0)
                return SendError(playerid, "У Вас нет разрешения чтобы припарковать свое транспортное средство в гараже.");
            if(GetVehicleModelEx(vehicleid) == 508)
                return SendError(playerid, "Вы не можете припарковать трейлер в гараже.");
        }
    }
    new Float:zange;
    GetVehicleZAngle(vehicleid, zange);
    veh_info[vehicleid][v_pos][0] = POS[0];
    veh_info[vehicleid][v_pos][1] = POS[1];
    veh_info[vehicleid][v_pos][2] = POS[2];
    veh_info[vehicleid][v_pos][3] = zange;

    veh_info[vehicleid][v_int] = GetPlayerInterior(playerid);
    veh_info[vehicleid][v_virt] = GetPlayerVirtualWorld(playerid);
    SaveVehicle(vehicleid);
    return SendAccess(playerid, "Вы припарковали транспортное средство.");
}

CMD:buycan(playerid, params[])
{
    new bizz_id = GetPVarInt(playerid, "bID");
    if(b_info[bizz_id][_tip] != B_FUEL ||
        !IsPlayerInRangeOfPoint(playerid, 7.5, b_info[bizz_id][b_enter][0],b_info[bizz_id][b_enter][1],b_info[bizz_id][b_enter][2]))
        return SendError(playerid, "Вы слишком далеко от заправки.");
    p_temp[playerid][p_shop_biz_item] = 630;
    ShowPlayerDialog(playerid, D_BUY_SHOP_ITEM, DIALOG_STYLE_INPUT, ""I"Канистры",  ""W"Введите количество, которое хотите приобрести:", "Купить", "Отмена");
    return 1;
}

CMD:fuel(playerid, params[])
{
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return 1;

    new
        vehicleid = GetPlayerVehicleID(playerid);

    if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_VELO_MOPED)
        return 1;

    if(sscanf(params, "i", params[0]))
        return SendInfo(playerid, "Используйте: /fuel [кол-во]");

    if(params[0] < 5 || params[0] > 200)
        return SendError(playerid, "Количество литров должно быть не менее 5 и не более 200.");

    new max_litres = GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_FUEL);

    for(new idx; idx < totalbizz; idx++)
    {
        if(b_info[idx][b_mysql_id] == INVALID_MYSQL_ID) continue;
        if(IsPlayerInRangeOfPoint(playerid,5.0,b_info[idx][b_enter][0],b_info[idx][b_enter][1],b_info[idx][b_enter][2]) )
        {
            if(/*b_info[idx][b_user_id] != INVALID_MYSQL_ID && */b_info[idx][_tip] == 4)
            {
                if(veh_info[vehicleid][v_fuel] < 0.0) veh_info[vehicleid][v_fuel] = 0.0;

                if(veh_info[vehicleid][v_fuel] + params[0] > max_litres)
                    return SendError(playerid, "Вы не можете заправить транспортное средство более %d литров.", floatround(max_litres-veh_info[vehicleid][v_fuel], floatround_ceil));

                new price = BIZZ_FILL_PRICE * params[0] * b_info[idx][_till];

                new list_percent[3] = {90, 80, 70}, vip_idx = p_info[playerid][p_vip];
                if(vip_idx) price = ((price / 100) * list_percent[vip_idx - 1]);

                if(price < 50 || price > 50000)
                    return SendError(playerid, "Произошла ошибка (Fuel - #1). Сообщите в тех. раздел.");

                if(p_info[playerid][cash] < price)
                    return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

                SendAccess(playerid, "Вы заправили транспортное средство на %d литров за %d$.", params[0], price);

                if(b_info[idx][_prod] >= params[0])
                {
                    b_info[idx][_prod] -= params[0];
                    b_info[idx][_bank] += (price / 100) * 90;
                    AddMafiaBank(idx, price/10);

                    biz_finka[idx] += (price / 100) * 90;
                    UpdateIntForFinanceBiz(idx, (price / 100) * 90);
                }

                OnServerInfoForMoney[10] += price;
                SetPlayerMoney(playerid, -price, true, "заправка автомобиля");
                veh_info[vehicleid][v_fuel] += float(params[0]);
                if(veh_info[vehicleid][v_mysql_id] != INVALID_MYSQL_ID) SaveVehicle(vehicleid);
                return 1;
            }
        }
    }
    SendError(playerid, "Вы слишком далеко от заправки.");
    return 1;
}

////////////////////////////////////////////////////////////////////////////////
CMD:bizlist(playerid, params[])
{
    if(!mafia(playerid) && !biker(playerid)) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    new count_business,
        fracid = -1;
    switch(p_info[playerid][member])
    {
        case MAFIA_RM: fracid = BANK_RM;
        case MAFIA_LCN: fracid = BANK_LCN;
        case MAFIA_YAKUDZA: fracid = BANK_YAKUZA;
        case BIKER: fracid = BANK_BIKER;
        case MAFIA_IRAN: fracid = BANK_IRAN;
    }
    STRING_GLOBAL[0] = EOS;
    STRING_GLOBAL = "№. Название + Доход бизнеса за последний час\n\n";
    for(new i; i< totalbizz; i++)
    {
        if(b_info[i][b_mysql_id] == INVALID_MYSQL_ID) continue;
        if(b_info[i][b_mafia] != p_info[playerid][member]) continue;
        if(fracid == -1) continue;
        if(count_business == 50) break;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%i. %s [ID: %d] + {77FF1B}%d$"W"\n",STRING_GLOBAL, count_business, b_info[i][_name], i, gBankMafia[fracid][i]);
        count_business++;
    }
    if(count_business < 50) ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Бизнесы мафий и байкеров", STRING_GLOBAL, "Понял", "");
    else if(!count_business) ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Бизнесы мафий и байкеров", "Бизнесов не найдено", "Ок", "");
    else ShowPlayerDialog(playerid, D_BIZ_LIST, DIALOG_STYLE_MSGBOX, ""I"Бизнесы мафий и байкеров", STRING_GLOBAL, "Далее", "Закрыть");
    return 1;
}

CMD:cput(playerid, params[])
{
    if(!IsPlayerFractionPolice(playerid) && !mafia(playerid) && !gang(playerid) && !biker(playerid)) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(mafia(playerid) && p_info[playerid][rang] < 5) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(gang(playerid) && p_info[playerid][rang] < 7) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(biker(playerid) && p_info[playerid][rang] < 7) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /cput [id игрока]");
    if(params[0] == INVALID_PLAYER_ID || params[0] == playerid) return SendError(playerid, "Игрок не найден.");
    if(IsPlayerInAnyVehicle(params[0])) return SendError(playerid, "Игрок уже находится в транспортном средстве.");
    if(gang(playerid) && !p_temp[params[0]][tTied]) return SendError(playerid, "Игрок должен быть связан.");
    if(mafia(playerid) && !p_temp[params[0]][tTied]) return SendError(playerid, "Игрок должен быть связан.");
    if(biker(playerid) && !p_temp[params[0]][tTied]) return SendError(playerid, "Игрок должен быть связан.");
    if(IsPlayerFractionPolice(playerid) && GetPVarInt(params[0],"PlayerCuffed") == 0) return SendError(playerid, "Игрок должен быть в наручниках.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID)
    {
        vehicleid = INVALID_VEHICLE_ID;
        new Float:POS[3];
        foreach(new i: Vehicle)
        {
            GetVehiclePos(i, POS[0], POS[1], POS[2]);
            if(IsPlayerInRangeOfPoint(playerid,3.0, POS[0], POS[1], POS[2]))
            {
                vehicleid = i;
                break;
            }
        }
        if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "Вы слишком далеко от транспортного средства.");
    }
    if(vehicleid != INVALID_VEHICLE_ID)
    {
        new bool:seat[4], passanger_id = -1;
        for(new i = 0; i < 8; i++)
        {
            if(veh_info[vehicleid][v_passenger][i] != INVALID_PLAYER_ID) 
            {
                if(GetPlayerVehicleSeat(veh_info[vehicleid][v_passenger][i]) == 1) seat[0] = true;
                else if(GetPlayerVehicleSeat(veh_info[vehicleid][v_passenger][i]) == 2) seat[1] = true;
                else if(GetPlayerVehicleSeat(veh_info[vehicleid][v_passenger][i]) == 3) seat[2] = true;
                else if(4 <= GetPlayerVehicleSeat(veh_info[vehicleid][v_passenger][i]) <= 8) seat[3] = true;
            }
        }
        for(new i; i < 4; i++)
        {
            if(!seat[i])
            {
                passanger_id = i+1;
                break;
            }
        }
        if(!(1 <= passanger_id <= 4)) return SendError(playerid, "В транспортном средстве нет мест.");
        PutPlayerInVehicle(params[0], vehicleid, passanger_id);
        Fix_TogglePlayerControllable(params[0], 0);

        if(p_info[playerid][p_settings][ROLEPLAY] == 1)
        {
            DoAction(playerid, "Дверь машины закрыта.");
            MeAction(playerid, "открыв дверь автомобиля затолкнул нарушителя внутрь, после чего закрыл дверь");
        }
        return true;
    }
    return 1;
}

CMD:tie(playerid, params[])
{
    if(!mafia(playerid) && !biker(playerid)) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(p_info[playerid][rang] < 6) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(GetInventoryAmount(playerid, 636) <= 0) return SendError(playerid, "У Вас нет веревки.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /tie [id игрока]");
    if(AntiDMZone(playerid)) return SendError(playerid, "Вы не можете связать \"Зеленой зоне\".");
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
    if(p_temp[playerid][tTied])  return SendError(playerid, "Вы связаны.");
    if(p_temp[params[0]][tTied]) return SendError(playerid, "Игрок уже связан.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");
    if(p_info[params[0]][p_afkTime] > 2) return SendError(playerid, "Данный игрок в AFK.");

    new string[128];
    format(string, sizeof(string), "%s связал(-а) %s", get_name(playerid), p_info[params[0]][name]);
    SendStreamMessage(30.0, playerid, string, 0xE75480FF);
    Fix_TogglePlayerControllable(params[0], 0);
    p_temp[params[0]][tTied] = true;

    GivePlayerInventory(playerid, 636, -1);

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "Веревка лежит в кармане.");
        MeAction(playerid, "засунул правую руку в карман, после чего нащупав веревку достал ее");
        MeAction(playerid, "достав веревку связал человека на против");
    }
    return 1;
}
CMD:untie(playerid, params[])
{
    if(!mafia(playerid) && !biker(playerid)) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(p_info[playerid][rang] < 6) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /untie [id игрока]");
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(p_temp[playerid][tTied])  return SendError(playerid, "Вы связаны.");
    if(!p_temp[params[0]][tTied]) return SendError(playerid, "Игрок не связан.");
    if(params[0] == playerid)  return SendError(playerid, "Вы ввели свой ID.");

    new string[128];
    format(string, sizeof(string), "%s развязал(-а) %s", get_name(playerid), p_info[params[0]][name]);
    SendStreamMessage(30.0, playerid, string, 0xE75480FF);
    Fix_TogglePlayerControllable(params[0], 1);
    p_temp[params[0]][tTied] = false;

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "Раскладной нож лежит в кармане.");
        MeAction(playerid, "засунул правую руку в карман, после чего нащупав раскладной нож достал его");
        MeAction(playerid, "достав раскладной нож перерезал веревку с человека на против");
    }
    return 1;
}

CMD:gag(playerid, params[])
{
    if(mafia(playerid) == 0) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(p_info[playerid][rang] < 5) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /gag [id игрока]");
    if(AntiDMZone(playerid)) return SendError(playerid, "Вы не можете вставить кляп \"Зеленой зоне\".");
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
    if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");
    if(!p_temp[params[0]][tTied]) return SendError(playerid, "Игрок не связан.");
    if(p_temp[playerid][tTied]) return SendError(playerid, "Вы связаны.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(p_info[params[0]][p_afkTime] > 2) return SendError(playerid, "Данный игрок в AFK.");

    new string[128];
    if(!mafia(playerid)) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    p_temp[params[0]][tGag] = true;
    p_temp[params[0]][tGagTime] = 300;
    format(string, sizeof(string), "%s вставил(-а) кляп в рот %s", get_name(playerid), p_info[params[0]][name]);
    SendStreamMessage(30.0, playerid, string, 0xE75480FF);

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "Кляп лежит в кармане.");
        MeAction(playerid, "засунул правую руку в карман, после чего нащупав кляп достал его");
        MeAction(playerid, "достав кляп засунул его в рот человеку на против");
    }
    return 1;
}

CMD:ungag(playerid, params[])
{
    if(mafia(playerid) == 0) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(p_info[playerid][rang] < 5) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /ungag [id игрока]");
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
    if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");
    if(!p_temp[params[0]][tGag]) return SendError(playerid, "У игрока нет кляпа.");
    if(p_temp[playerid][tTied]) return SendError(playerid, "Вы связаны.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");

    new string[128];
    format(string, sizeof(string), "%s достал(-а) кляп из рта %s", get_name(playerid), p_info[params[0]][name]);
    SendStreamMessage(30.0, playerid, string, 0xE75480FF);
    p_temp[params[0]][tGagTime] = 0;
    p_temp[params[0]][tGag] = false;

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        MeAction(playerid, "протянул руку ко рту человека на против, после чего вытащил кляп из его рта");
    }
    return 1;
}

CMD:bizwar(playerid, params[])
{
    if(!mafia(playerid) && !biker(playerid)) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(p_info[playerid][rang] < 6) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(BizWar_Info[bWarTime] > 0) return SendError(playerid, "Захват бизнеса уже идет.");
    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "Используйте: /bizwar [id территории]");
    if(params[0] < 1 || params[0] > 4) return SendError(playerid, "ID территории должен быть не менее 1 и не более 4.");

    if(timestamp_hour < 10 || timestamp_hour > 23) return SendError(playerid, "Проводить захват бизнеса разрешено с 10:00 до 23:00.");
    if(!(0 <= timestamp_minute <= 5)) return SendError(playerid, "Проводить захват территории разрешено с **:00 до **:05.");

    if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Вы находитесь в транспортном средстве.");
    if(Iter_Count(gFactionPlayers[p_info[playerid][member]]) < 3) return SendError(playerid, "У Вашей фракции слишком мало игроков в игре.");
    if(GetPVarInt(playerid, "FLOOD:CAPTURE") > timestamp) return SendError(playerid, "Вы не можете так часто использовать команды.");
    SetPVarInt(playerid, "FLOOD:CAPTURE", timestamp+10);

    for(new i; i < totalbizz; i++) {
        if(b_info[i][b_mysql_id] == INVALID_MYSQL_ID) continue;
        if(IsPlayerInRangeOfPoint(playerid,2.5,b_info[i][b_enter][0],b_info[i][b_enter][1],b_info[i][b_enter][2])) //fixeds
        {
            if(b_info[i][b_mafia] == p_info[playerid][member]) return SendError(playerid, "Данный бизнес принадлежит Вашей фракции.");
            if(!(MAFIA_RM <= b_info[i][b_mafia] <= MAFIA_YAKUDZA) && b_info[i][b_mafia] != BIKER && b_info[i][b_mafia] != MAFIA_IRAN)
            {
                b_info[i][b_mafia] = p_info[playerid][member];
                MafiaCountBizz(b_info[i][b_mafia], 1);
                save_bizz(i);
                update_bizz(i);
                SendAccess(playerid, "Вы взяли бизнес под контроль мафии или байкеров.");
                return 1;
            }
            if(Iter_Count(gFactionPlayers[b_info[i][b_mafia]]) < 3) return SendError(playerid, "У \"%s\" слишком мало игроков в игре.", GetFractionName(b_info[i][b_mafia]));
            if(params[0] < 3)
            {
                SendAccess(playerid, "Вы начали захват бизнеса \"%s\". Место встречи: %d. Контроль бизнеса: %s.", b_info[i][_name], params[0], GetFractionName(b_info[i][b_mafia]));
                SendInfo(playerid, "Встреча состоится через 5 минут.");

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] из \"%s\" начал захват бизнеса \"%s\". Контроль: \"%s\". Территория: %d.", get_name(playerid), playerid, GetFractionName(p_info[playerid][member]), b_info[i][_name], GetFractionName(b_info[i][b_mafia]), params[0]);
                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
                SendFractionMessage(b_info[i][b_mafia], 0x33CC66FF, STRING_GLOBAL);
                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, "[F] Встреча состоится через 5 минут.");
                SendFractionMessage(b_info[i][b_mafia], 0x33CC66FF, "[F] Встреча состоится через 5 минут.");

                switch(params[0])
                {
                    case 1: {
                        BizWar_Info [ bWarPos ] [ 0 ] = 273;
                        BizWar_Info [ bWarPos ] [ 1 ] = 2429;
                        BizWar_Info [ bWarPos ] [ 2 ] = 450.400146484375;
                        BizWar_Info [ bWarPos ] [ 3 ] = 2558;
                    }
                    case 2: {
                        BizWar_Info [ bWarPos ] [ 0 ] = -469.60003662109375;
                        BizWar_Info [ bWarPos ] [ 1 ] = 2171;
                        BizWar_Info [ bWarPos ] [ 2 ] = -292.60003662109375;
                        BizWar_Info [ bWarPos ] [ 3 ] = 2300;
                    }
                    case 3: {
                        BizWar_Info [ bWarPos ] [ 0 ] = -592.5999145507812;
                        BizWar_Info [ bWarPos ] [ 1 ] = -179;
                        BizWar_Info [ bWarPos ] [ 2 ] = -415.59991455078125;
                        BizWar_Info [ bWarPos ] [ 3 ] = -50;
                    }
                }
                biz_war_gangzone = GangZoneCreate(BizWar_Info [ bWarPos ] [ 0 ],BizWar_Info [ bWarPos ] [ 1 ], BizWar_Info [ bWarPos ] [ 2 ], BizWar_Info [ bWarPos ] [ 3 ]);
                GangZoneShowForAll(biz_war_gangzone, 0xB2B2B2AA);
                GangZoneFlashForAll(biz_war_gangzone, COLOR_RED);

                BizWar_Info[bWarTime] = 450;
                BizWar_Info[bMafia][0] = p_info[playerid][member];
                BizWar_Info[bMafia][1] = b_info[i][b_mafia];
                BizWar_Info[bCount][0] = 0;
                BizWar_Info[bCount][1] = 0;

                InitTopList(p_info[playerid][member], b_info[i][b_mafia], CAPTURE_ID_MAFIA, 450);

                SetTimerEx("BizWarTimer",1000,0,"iii", i, p_info[playerid][member], BizWar_Info[bMafia][1]);

                foreach(new i:Player)
                {
                    if(p_info[i][member] == BizWar_Info[bMafia][0] || p_info[i][member] == BizWar_Info[bMafia][1])
                    {
                        ShowTextDrawForPlayer(i, TD_ID_CAPTURE);
                        CaptureInfoUpdate(i, CAPTURE_ID_MAFIA);
                    }
                }
            }
            else
            {
                SendInfo(playerid, "Выберите на карте место для захвата.");
                SendInfo(playerid, "Место должно быть в пригороде \"Las Venturas\".");
                p_temp[playerid][biz_war_map] = true;
                p_temp[playerid][p_listitem_int] = i;
            }
            return 1 ;
        }
    }
    SendError(playerid, "Вы слишком далеко от бизнеса.");
    return 1;
}

CMD:togphone(playerid, params[])
{
    if(p_temp[playerid][offphone] != true) p_temp[playerid][offphone] = true, SendAccess(playerid, "Вы выключили телефон.");
    else if(p_temp[playerid][offphone] == true) p_temp[playerid][offphone] = false, SendAccess(playerid, "Вы включили телефон.");
    return 1;
}

CMD:to(playerid, params[])
{
    if(p_info[playerid][member] <= 0 && p_info[playerid][job] <= 0)
        return 1;

    new targetid;
    if(sscanf(params, "u", targetid))
        return SendInfo(playerid, "Используйте: /to [id игрока]");

    new service_check = GetPVarInt(targetid, "CALL:SERVICES");
    if(service_check != 5) DeletePVar(targetid, "CALL:SERVICES");

    switch(service_check)
    {
        case 0: return SendError(playerid, "Игрок не вызывал Вас или вызов уже принял кто-то из игроков.");
        //case 1: if(!IsPlayerFractionPolice(playerid)) return SendError(playerid, "Игрок не вызывал Вас.");
        case 2: if(!IsPlayerFractionMedic(playerid)) return SendError(playerid, "Игрок не вызывал Вас.");
        case 3:
        {
            if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Вы должны находиться в транспортном средстве.");
            if(p_info[playerid][taxi_idx] == 0) return SendError(playerid, "Игрок не вызывал Вас.");
            new tcid = p_info[playerid][taxi_idx], idx = p_temp[targetid][tc_call_idx], type = p_temp[targetid][tc_call_type], vehicleid = GetPlayerVehicleID(playerid);
            if(tcid != idx) return SendError(playerid, "Игрок не вызывал Вашу службу такси.");
            if(GetBizVehicleType(vehicleid) != type) return SendError(playerid, "Ваше транспортное средство не подходит под тип вызова.");
            if(p_temp[playerid][taxi_bots_idx] != 0) DestroyTaxi(playerid);
            p_temp[playerid][taxi_bots_idx] = 0;
            p_temp[playerid][taxi_bots_timer] = RandomEx(120, 240);
        }
        case 4:
        {
            if(p_info[playerid][job] != JOB_MECHANIC) return SendError(playerid, "Игрок не вызывал Вас.");
            if(p_temp[playerid][mechanic_idx] != 0) DestroyMechanic(playerid);
            p_temp[playerid][mechanic_idx] = 0;
            p_temp[playerid][mechanic_timer] = RandomEx(120, 240);
        }
        case 5:
        {
            p_temp[playerid][panic_target_id] = targetid;
        }
        default: return 1;
    }

    new Float: x, Float: y, Float: z;
    GetPlayerPos(targetid, x, y, z);
    SetPlayerGPS(playerid, x, y, z, 4.0);

    SendAccess(playerid, "Вы принял вызов от %s [%d].", get_name(targetid), targetid);
    SendAccess(targetid, "%s [%d] принял Ваш вызов.", get_name(playerid), playerid);
    return 1;
}


CMD:radiostation(playerid, params[])
{
    ShowPlayerDialog(playerid, D_NEWS_RADIO, DIALOG_STYLE_LIST, ""I"Радиостанция", "\
    "I"[1]"W" LS News\n\
    "I"[2]"W" SF News\n\
    "I"[3]"W" LV News\n\
    "I"[4]"W" Выключить", "Далее", "Отмена");
    return 1;
}

MobileCrash(playerid)
{
    new id = p_temp[playerid][calling];
    if(GetPVarInt(id, "EtherCalled")) DeletePVar(id, "EtherCalled");
    SendError(id, "Игрок не найден.");

    SetPlayerSpecialAction(id, SPECIAL_ACTION_STOPUSECELLPHONE);

    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_STOPUSECELLPHONE);
    return 1;
}

////////////////////////////////////////////////////////////////////////////////
CMD:medcard(playerid, params[])
{
    if(!p_info[playerid][med_card]) return SendError(playerid, "У Вас нет мед. карты.");
    if(sscanf(params, "u", params[0]))
    {
        params[0] = playerid;
        SendInfo(playerid, "Используйте: /medcard [id игрока]");
    }
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(params[0] == playerid)
    {
        ShowMeditionCard(playerid, playerid);
    }
    else if(GetPVarInt(params[0],"BoneStol_ID")) return 1;
    else
    {
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL, ""W"Вы хотите предложить "I"%s "W"посмотреть Вашу мед карту.", get_name(params[0]));
        ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"Мед.карта", STRING_GLOBAL, "Далее", "Отмена");
        SetOfferData(playerid, params[0], OFFER_ID_SHOW_MED_CARD);
    }
    return 1;
}

CMD:medins(playerid, params[])
{
    if(!IsPlayerFractionMedic(playerid) || p_info[playerid][rang] < 3) return 1;
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /medins [id игрока]");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(GetPVarInt(params[0],"BoneStol_ID")) return 1;
    if(p_info[params[0]][med_insurance] != 0) return SendError(playerid, "У игрока есть мед. страхование");

    SendAccess(playerid, "Вы предложили %s [%d] приобрести мед. страхование за 10000$.", get_name(params[0]), params[0]);
    SendInfo(params[0], "%s [%d] предложил Вам приобрести мед. страхование за 10000$.", get_name(playerid), playerid);

    SetFreeSlotOffer(params[0], playerid, OFFER_ID_MED_INSURANCE, 10000);
    return 1;
}


CMD:givemedcard(playerid, params[])
{
    if(!IsPlayerFractionMedic(playerid) || p_info[playerid][rang] < 3) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /givemedcard [id игрока]");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(!PlayerToPoint(40.0,playerid, FractionsData[p_info[playerid][member]][fSpawnPos][0], FractionsData[p_info[playerid][member]][fSpawnPos][1], FractionsData[p_info[playerid][member]][fSpawnPos][2]))
        return SendError(playerid, "Вы должны находиться в больнице.");
    if(!IsPlayerConnected(params[0])) return true;
    if(params[0] == INVALID_PLAYER_ID) return true;
    if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");
    if(p_info[params[0]][med_card] == 1) return SendError(playerid, "У игрока уже есть мед. карта.");
    if(GetFractionWarehouse(p_info[playerid][member], fwDrugs) < 50) return SendError(playerid, "На складе недостаточно медикаментов.");

    new price = 2500;
    switch(p_info[params[0]][level])
    {
        case 1 .. 5: price = 2500;
        case 6 .. 10: price = 5000;
        case 11 .. 15: price = 7500;
        default: price = 10000;
    }

    SendAccess(playerid, "Вы предложили %s [%d] приобрести мед. карту за %d$.", get_name(params[0]), params[0], price);
    SendInfo(params[0], "%s [%d] предложил Вам приобрести мед. карту за %d$.", get_name(playerid), playerid, price);

    SetFreeSlotOffer(params[0], playerid, OFFER_ID_BUY_MED_CARD, price);
    return 1;
}

CMD:hospital(playerid, params[])
{
    new hospital_id = GetPlayerVirtualWorld(playerid) - 1;
    if(!(0 <= hospital_id <= 2)) return 1;
    for(new i = sizeof(HospitalBedInfo)-1; i != -1; i--)
    {
        if(p_temp[playerid][hospital_bed_id] != -1) continue;
        if(!IsPlayerInRangeOfPoint (playerid, 2.0, HospitalBedInfo[i][hb_X],HospitalBedInfo[i][hb_Y],HospitalBedInfo[i][hb_Z])) continue;

        if(HospitalBedInfo[i][hb_Busy][hospital_id] != INVALID_PLAYER_ID)
        {
            SendError(playerid, "На койке нет места.");
            break;
        }
        p_temp[playerid][hospital_bed_id] = i;
        STRING_GLOBAL[0] = EOS;

        f(STRING_GLOBAL, ""W"Вы действительно хотите арендовать данную койку за "I"%d$", BED_PRICE);
        ShowPlayerDialog (playerid, D_HOSPITAL_BED, DIALOG_STYLE_MSGBOX, ""I"Койка", STRING_GLOBAL, "Да", "Нет" );
        break;
    }
    return 1;
}

CMD:heal(playerid, params[])
{
    if(!IsPlayerFractionMedic(playerid) && (p_info[playerid][member] != PRISON || p_info[playerid][rang] < 5))
        return 1;

    new target, price;
    if(sscanf(params, "ui", target, price)) return SendInfo(playerid, "Используйте: /heal [id игрока] [стоимость]");

    if(!(50 <= price <= 500))
        return SendError(playerid, "Стоимость лечения не может быть менее 50$ и более 500$.");

    if(target == INVALID_PLAYER_ID || !IsPlayerConnected(target) || target == playerid)
        return SendError(playerid, "Игрок не найден.");

    if(!IsPlayerStream(5.0, playerid, target) || pSpectateId[target] != INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок слишком далеко от Вас.");

    new
        target_vehicle = GetPlayerVehicleID(target),
        playerid_vehicle = GetPlayerVehicleID(playerid);

    if(p_info[target][level] <= 3 && (!medic_car(playerid_vehicle) && !medic_car(target_vehicle)) && (price < 50 || price > 100))
        return SendError(playerid, "Стоимость лечения малоимущих не может быть менее 50$ и более 100$.");
    else  if(p_info[target][level] >= 4 && (!medic_car(playerid_vehicle) && !medic_car(target_vehicle)) && (price < 100 || price > 300))
        return SendError(playerid, "Стоимость обычного лечения не может быть менее 100$ и более 300$.");
    else  if((medic_car(playerid_vehicle) && playerid_vehicle == target_vehicle) && (price < 300 || price > 500))
        return SendError(playerid, "Стоимость лечения в карете не может быть менее 300$ и более 500$.");

    if(IsPlayerInRangeOfPoint(playerid, 100.0, 185.5570,-1681.7745,1007.4592))
    {
        switch(p_info[playerid][member])
        {
            case MEDIC_LS: if(GetPlayerVirtualWorld(playerid) != 1) return SendError(playerid, "Вы должны находиться в больнице \"Los Santos\".");
            case MEDIC_SF: if(GetPlayerVirtualWorld(playerid) != 2) return SendError(playerid, "Вы должны находиться в больнице \"San Fierro\".");
            case MEDIC_LV: if(GetPlayerVirtualWorld(playerid) != 3) return SendError(playerid, "Вы должны находиться в больнице \"Las Venturas\".");
        }
    }
    if(p_info[target][med_insurance] != 0)
    {
        SendInfo(target, "У Вас действует мед. страховка, цену лечения снижено в 2 раза.");
        SendInfo(playerid, "У игрока действует мед. страховка, цену лечения снижено в 2 раза.");
        price = price/2;
    }

    if(medic_car(playerid_vehicle) && playerid_vehicle == target_vehicle || PlayerToPoint(100.0, playerid, 185.5570,-1681.7745,1007.4592))
    {
        SendAccess(playerid, "Вы предложили %s [%d] вылечиться за %d$.", get_name(target), target, price);
        SendInfo(target, "%s [%d] предложил Вам вылечиться за %d$.", get_name(playerid), playerid, price);

        SetFreeSlotOffer(target, playerid, OFFER_ID_BUY_HEAL, price);
    }
    return 1;
}

CMD:tpcor(playerid, params[])
{
    if(p_info[playerid][admin] < 5 && p_temp[playerid][premiumgamer] != PREMIUM_GAME) return 1;
    new Float:pX, Float:pY, Float:pZ, int_, world_;
    if(sscanf(params, "p<,>fffI(-1)I(-1)", pX, pY, pZ, int_, world_)) return SendInfo(playerid, "Используйте: /tpcor [x] [y] [z] [a] [interior] [virtualworld]");
    SetPlayerPos(playerid, pX, pY, pZ);
    //if(pA != -1) SetPlayerFacingAngle(playerid, pA);
    if(int_!= -1) SetPlayerInterior(playerid, int_);
    if(world_ != -1) SetPlayerVirtualWorld(playerid, world_);
    return 1;
}

CMD:pass(playerid, params[])
{
    if(!p_info[playerid][passport]) return SendError(playerid, "У Вас нет паспорта.");

    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "Используйте: /pass [id игрока]");

    if(params[0] == INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок не найден.");

    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок слишком далеко от Вас.");

    if(pSpectateId[params[0]] != INVALID_PLAYER_ID)
        return 1;

    if(GetPVarType(params[0],"BoneStol_ID") == PLAYER_VARTYPE_INT)
        return 1;

    if(params[0] == playerid)
    {
        ShowPass(playerid, playerid);
        MeAction(playerid, "достал(-а) ID карту и рассматривает ее");
    }
    else
    {
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL, ""W"Вы хотите предложить "I"%s "W"посмотреть Вашу ID карту.", get_name(params[0]));
        ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"ID карта.", STRING_GLOBAL, "Далее", "Отмена");
        SetOfferData(playerid, params[0], OFFER_ID_SHOW_PASS);
    }
    return 1;
}

alias:pass("showcard", "idcard", "card");

CMD:gotoveh(playerid, params[])
{
    if(p_info[playerid][admin] < 3)
        return 1;

    if(isnull(params))
        return SendInfo(playerid, "Используйте: /gotoveh [id транспортного средства]");

    new
        vehicle = strval(params);

    if(vehicle == INVALID_VEHICLE_ID || !IsValidVehicle(vehicle))
        return SendError(playerid, "Неверный ID транспортного средства.");

    new
        Float:x,
        Float:y,
        Float:z;

    GetVehiclePos(vehicle, x, y, z);
    SetPlayerPos(playerid, x + 2.0, y + 2.0, z);

    SendAccess(playerid, "Вы телепортировались к транспортному средству.");
    return 1;
}

CMD:settime(playerid, params[])
{
    if(SRV_ID != 0 && (!FD(playerid) || p_info[playerid][admin] < 6)) return 1;

    if(isnull(params))
        return SendInfo(playerid, "Используйте: /settime [время]");

    new
        hour = strval(params);

    if(!(0 <= hour <= 24))
        return SendError(playerid, "Время должно быть не менее 0 и не более 24.");

    foreach(new i:Player)
    {
        if(p_temp[i][BeingInSpace] != false) continue;
        SetPlayerTime(i, hour, 0);
    }

    SendAccess(playerid, "Вы изменили время на сервере.");
    return 1;
}

CMD:amusic(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10)
        return 1;

    new radius, link[144];
    if(sscanf(params, "is[144]", radius, link)) return SendInfo(playerid, "Используйте: /amusic [радиус] [ссылку]");

    if(!(1 <= radius <= 100))
        return SendError(playerid, "Радиус должен быть не менее 1 и не более 100.");

    new
        Float:x,
        Float:y,
        Float:z;

    GetPlayerPos(playerid, x, y, z);

    foreach(new i: Player)
    {
        if(!p_info[i][loggedIn]) continue;
        if(!IsPlayerInRangeOfPoint(i, float(radius), x, y, z))
            continue;

        PlayAudioStreamForPlayer(i, link);
    }

    SendAccess(playerid, "Вы включили музыку.");
    return 1;
}

CMD:banip(playerid, params[])
{
    if(p_info[playerid][admin] < 5)
        return 1;

    new ban_ip[22],
        reason[144];

    if(sscanf(params, "s[24]s[144]", ban_ip, reason))
        return SendInfo(playerid, "Используйте: /banip [ip адрес] [причина]");

    if(strfind(ban_ip, "*", true) != -1 || strfind(ban_ip, "#", true) != -1)
        return SendInfo(playerid, "Используйте: /banip [ip адрес] [причина]");

    if(AdvertisingCheck(reason)) return AdvertisingPunishment(playerid, reason, 0);
    if(IsAAdminAttack(playerid, 7)) return 1;

    foreach(new i:Player)
    {
        if(FD(i))
        {
            if(strequals(ban_ip, p_info[i][regIP]) || strequals(ban_ip, p_temp[i][session_IP]))
            {
                SendInfo(playerid, "С Вас были сняты права администратора за попытку бана по IP спец. администратора.");

                Iter_Remove(gAdmins, playerid);
                p_info[playerid][admin] = 0;
                p_info[playerid][admin_pass] = 0;
                Kick(playerid);
                return 1;
            }
        }
    }

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `IP` FROM `table_ban` WHERE `IP` = '%e' LIMIT 1", ban_ip);
    mysql_tquery(con_bd, STRING_GLOBAL, "banip", "iss", playerid, ban_ip, reason);
    return 1;
}
forward banip(playerid,ip_banned[], reason[]);
public banip(playerid,ip_banned[], reason[])
{
    new rows;
    cache_get_row_count(rows);
    if(!rows)
    {
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `table_ban` (`IP`, `Name_Admin`, `Ban_Data`, `Ban_Reason`, `Unban_Data`) VALUES ('%e', '%e', NOW(), '%e', %d)",
        ip_banned, get_name(playerid), reason, timestamp + (7*86400));
        mysql_tquery(con_bd, STRING_GLOBAL);

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] заблокировал IP: %s. Причина: %s", get_name(playerid), playerid, ip_banned, reason);
        SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

        WriteAdminLog(TYPE_LOG_BANIP, playerid, ip_banned, INVALID_PLAYER_ID, reason);
    }
    else SendError(playerid, "IP уже заблокировано.");
    return 1;
}

CMD:unbanip(playerid, params[])
{
    if(p_info[playerid][admin] < 5) return 1;
    if(isnull(params) || strlen(params) > 16) return SendInfo(playerid, "Используйте: /unbanip [ip адресс]");
    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `IP` FROM `table_ban` WHERE `IP` = '%e' LIMIT 1",
    params);
    mysql_tquery(con_bd, STRING_GLOBAL, "unban_ip", "is", playerid, params);
    return 1;
}

forward unban_ip(playerid,ip_banned[]);
public unban_ip(playerid,ip_banned[])
{
    new rows;
    cache_get_row_count(rows);
    if(!rows) return SendError(playerid, "IP не заблокировано.");

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `table_ban` WHERE `IP` = '%e' LIMIT 1",
    ip_banned);
    mysql_tquery(con_bd, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] разблокировал IP: %s.", get_name(playerid), playerid, ip_banned);
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

    WriteAdminLog(TYPE_LOG_UNBANIP, playerid, ip_banned, INVALID_PLAYER_ID);
    return 1;
}
CMD:disband(playerid, params[])
{
    if(p_info[playerid][admin] < 6) return 1;
    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "Используйте: /disband [id фракции]");
    if(params[0] > MAX_FRACTIONS || params[0] < 1) return SendError(playerid, "ID фракции должен быть не менее 1 и не более %d.", MAX_FRACTIONS);

    if(GetPVarInt(playerid, "DisbandAccept") != params[0])
    {
        SendInfo(playerid, "Вы действительно хотите расформировать \"%s\"?", GetFractionName(params[0]));
        SendInfo(playerid, "Для подтверждения введите команду еще раз.");
        SetPVarInt(playerid, "DisbandAccept", params[0]);
        return 1;
    }

    foreach(new i: Player)
    {
        if(p_info[i][member] != params[0]) continue;

        if(!p_info[i][admin])
        {
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `log_fraction` (`PlayerID`, `Member`, `Rang`, `Type`, `Reason`) VALUES (%d, %d, %d, '1', 'Адм. расформировка')",
            p_info[i][ID], p_info[i][member], p_info[i][rang]);
            mysql_tquery(con_bd, STRING_GLOBAL);
        }

        if(GetPlayerStatusCapture(i))
                HideTextDrawForPlayer(i, TD_ID_CAPTURE);

        Iter_Remove(gFactionPlayers[p_info[i][member]], i);
        p_info[i][member] = 0;
        p_info[i][rang] = 0;
        p_info[i][fskin] = 0;
        Iter_Add(gFactionPlayers[p_info[i][member]], i);
        if(GetFreeSlotHouse(i) != p_info[i][house_slots] || p_info[i][key_h_rent] != INVALID_HOUSE_ID) p_info[i][spawn] = 2;
        else p_info[i][spawn] = 0;
        p_info[i][fwork] = false;
        SetPlayerSkinEx(i);
        SetPlayerColor(i, fraction_color[0]);
        if(GetFactionCategory(p_info[i][member]) == FACTION_CATEGORY_PD || GetFactionCategory(p_info[i][member]) == FACTION_CATEGORY_FBI)
            p_temp[i][StatusOnDuty] = 0;
        save_player(i);
        f_ResetPlayerWeapons(i);

        /*
        p_info[i][ftop_gkills_week] = 
        p_info[i][ftop_gdeaths_week] = 0;
        p_info[i][ftop_gdamagegive_week] = 
        p_info[i][ftop_gdamagetake_week] = 0;
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `ftop_gkills_week` = 0, `ftop_gdeaths_week`  = 0, `ftop_gdamagegive_week` = 0.0, `ftop_gdamagetake_week` = 0.0 WHERE `id` = %d", p_info[i][ID]);
        mysql_tquery(con_bd, STRING_GLOBAL);
        */

        SendInfo(i, "Администратор %s [%d] уволил Вас из \"%s\" по причине расформировки.", get_name(playerid), playerid, GetFractionName(params[0]));

        Log(LOG_player, INFO, "%s[%d](%s %s) был уволен %s[%d](%s %s) из %s. Причина: Адм. расформировка | #Fraction",
            get_name(i), p_info[i][ID], p_temp[i][session_IP], IsPlayerMobile(i) ? "Mobile": "PC",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", GetFractionName(params[0]));

        Log(LOG_player, INFO, "%s[%d](%s %s) уволил %s[%d](%s %s) из %s. Причина: Адм. расформировка | #Fraction",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
            get_name(i), p_info[i][ID], p_temp[i][session_IP], IsPlayerMobile(i) ? "Mobile": "PC", GetFractionName(params[0]));
    }

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id`, `member`, `rang` FROM `accounts` WHERE `member` = '%d'", params[0]);
    mysql_tquery(con_bd, STRING_GLOBAL, "disband_offline", "i", playerid);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `leader` = 0, `member` = 0, `rang` = 0, `fskin` = 0, `spawn` = 0, `fwork` = 0 WHERE `member` = %d",
    params[0]);
    mysql_tquery(con_bd, STRING_GLOBAL);

    DeletePVar(playerid, "DisbandAccept");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] расформировал \"%s\".", get_name(playerid), playerid, GetFractionName(params[0]));
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

    SendAccess(playerid, "Вы расформировали \"%s\".", GetFractionName(params[0]));

    Log(LOG_player, INFO, "%s[%d](%s %s) расформировал фракцию %s | #AdminLogs",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        GetFractionName(params[0]));


    return 1;
}
forward disband_offline(playerid);
public disband_offline(playerid)
{
    if(cache_num_rows())
    {
        new members, rangs, mysql_player_id;
        for(new i = 0; i < cache_num_rows(); i++)
        {
            cache_get_value_name_int(i, "id", mysql_player_id);
            cache_get_value_name_int(i, "member", members);
            cache_get_value_name_int(i, "rang", rangs);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `log_fraction` (`PlayerID`, `Member`, `Rang`, `Type`, `Reason`) VALUES (%d, %d, %d, '1', 'Адм. расформировка')", mysql_player_id, members, rangs);
            mysql_tquery(con_bd, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `leader` = 0, `member` = 0, `rang` = 0, `fskin` = 0, `spawn` = 0, `fwork` = 0 WHERE `id` = %d", mysql_player_id);
            mysql_tquery(con_bd, STRING_GLOBAL);
        }
    }
    return 1;
}

CMD:leaders(playerid, params[])
{
    ShowPlayerList(playerid, LIST_ID_LEADERS);
    return true;
}
alias:leaders("offleaders");

CMD:zams(playerid, params[])
{
    ShowPlayerList(playerid, LIST_ID_ZAMS);
    return true;
}
alias:zams("offzams");

CMD:members(playerid, params[])
{
    if(p_info[playerid][member] == 0)
        return SendError(playerid, "Вы не состоите во фракции.");
    ShowPlayerList(playerid, LIST_ID_FRACTION_ONLINE_MEMBERS);
    return true;
}

CMD:oldmembers(playerid, params[])
{
    if(!p_info[playerid][member])
        return SendError(playerid, "Вы не состоите во фракции.");
    STRING_GLOBAL[0] = EOS;
    STRING_GLOBAL = ""W"Члены организации онлайн:\n";

    new status_work[16];
    foreach(new i: gFactionPlayers[p_info[playerid][member]])
    {
        if(p_info[i][admin] > 0 || p_info[playerid][member] != p_info[i][member]) continue;
        status_work[0] = EOS;
        if(p_info[i][fwork] == true && (gos(i) || GetFactionType(p_info[i][member]) == FACTION_TYPE_SNN)) status_work = "[На работе]";
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"%s%s [%d] ранг: %s [%d] | Пред.: %d/3 | %s\n", STRING_GLOBAL, get_name(i), i,  GetPlayerFractionRangName(i), p_info[i][rang], p_info[i][fwarn], status_work);
    }
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Состав онлайн", STRING_GLOBAL, "Закрыть", "");
    return 1;
}

CMD:getbizzid(playerid, params[])
{
    for(new i; i < totalbizz; i++){
        if(b_info[i][b_mysql_id] == INVALID_MYSQL_ID) continue;
        if(IsPlayerInRangeOfPoint(playerid,3.0,b_info[i][b_enter][0],b_info[i][b_enter][1],b_info[i][b_enter][2]) )
        {
            SendInfo(playerid, "ID бизнеса: %d.", i);
            break;
        }
    }
    return 1;
}
CMD:setbizpos(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10) return 1;
    new bizz_id, Float:pX, Float:pY, Float:pZ, Float:pA;
    if(sscanf(params, "i", bizz_id)) return SendInfo(playerid, "Используйте: /setbizpos [id бизнеса]");
    if(bizz_id < 0 || bizz_id >= totalbizz) return 1;

    GetPlayerPos(playerid,pX,pY,pZ);
    GetPlayerFacingAngle(playerid, pA);

    b_info[bizz_id][b_enter][0] = pX;
    b_info[bizz_id][b_enter][1] = pY;
    b_info[bizz_id][b_enter][2] = pZ;
    b_info[bizz_id][b_enter][3] = pA;

    DestroyDynamicPickup(b_info[bizz_id][b_pickup_enter]);
    b_info[bizz_id][b_pickup_enter] = CreateDynamicPickup(1318, 23, b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2]);

    DestroyDynamicArea(b_info[bizz_id][b_area_enter]);
    b_info[bizz_id][b_area_enter] = CreateDynamicSphere(b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2], 5.0, -1, -1, -1);
    UpdateAreaInfo(b_info[bizz_id][b_area_enter], TYPE_BUSINESS, AREA_SUBTYPE_BUSINESS_ENTER, bizz_id);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd,STRING_GLOBAL,sizeof(STRING_GLOBAL),"UPDATE `biz` SET `b_enterX` = '%f', `b_enterY` = '%f', `b_enterZ` = '%f', `b_enterA` = '%f' WHERE `b_mysql_id`= %d",
    b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2], b_info[bizz_id][b_enter][3], b_info[bizz_id][b_mysql_id]);
    mysql_tquery(con_bd, STRING_GLOBAL);
    SendInfo(playerid, "Установите угол поворота при выходе из бизнеса: /sba");

    save_bizz(bizz_id);
    update_bizz(bizz_id);
    return 1;
}
CMD:setbizprice(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10) return 1;
    new bizz_id, bizz_price;
    if(sscanf(params, "ii", bizz_id, bizz_price)) return SendInfo(playerid, "Используйте: /setbizprice [id бизнеса] [цена]");
    if(bizz_id < 0 || bizz_id >= totalbizz) return 1;
    if(bizz_price < 1 || bizz_price > 100000000)

    bizz_id++;

    b_info[bizz_id][_price] = bizz_price;

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd,STRING_GLOBAL,sizeof(STRING_GLOBAL), "UPDATE `biz` SET `b_price` = %d WHERE `b_mysql_id`= %d",
    b_info[bizz_id][_price], b_info[bizz_id][b_mysql_id]);
    mysql_tquery(con_bd, STRING_GLOBAL);

    SendAccess(playerid, "Вы изменили стоимость бизнеса %d на %d$.", b_info[bizz_id][b_mysql_id], b_info[bizz_id][_price]);

    save_bizz(bizz_id);
    update_bizz(bizz_id);
    return 1;
}
CMD:sethousepos(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10) return 1;
    new house_id, Float:pX, Float:pY, Float:pZ, Float:pA;
    if(sscanf(params, "i", house_id)) return SendInfo(playerid, "Используйте: /sethousepos [id дома]");
    if(house_id < 0 || house_id >= totalhouses) return 1;

    GetPlayerPos(playerid,pX,pY,pZ);
    GetPlayerFacingAngle(playerid, pA);

    h_info[house_id][h_enter][0]=pX;
    h_info[house_id][h_enter][1]=pY;
    h_info[house_id][h_enter][2]=pZ;
    h_info[house_id][h_enter][3]=pA;

    save_house(house_id);
    update_house(house_id);
    return 1;
}

