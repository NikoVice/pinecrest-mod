            new JOB_IDx[12] = {
                JOB_PIZZABOY, JOB_BUS, JOB_MECHANIC,
                JOB_COLLECTOR, JOB_ROADMAN, JOB_TRAIN,
                JOB_TRAM, JOB_FIREMAN, JOB_PILOT,
                JOB_PANEL, JOB_ELECTRIC, JOB_OIL};

            new JOB_LEVEL[12] = {
                level_pizzaboy, level_bus, level_mechanic,
                level_collector, level_roadman, level_train,
                level_tram, level_fireman, level_pilot,
                level_panel, level_electric, level_oil};

            new JOB_NAME[12][32] = {
                "развозчиком пиццы", "водителем автобуса", "автомехаником",
                "инкассатором", "ремонтником дорог", "машинистом поезда",
                "водителем трамвая" , "пожарным", "пилотом",
                "ремонтником солнечных панелей", "электриком", "нефтяником"};

            if(p_info[playerid][level] < JOB_LEVEL[listitem]) return SendError(playerid, "У Вас нет %d-ого уровня.", JOB_LEVEL[listitem]);
            if(p_info[playerid][job] == JOB_IDx[listitem]) return SendError(playerid, "Вы уже работаете на данной работе.");

            if(p_info[playerid][job] != 0) Iter_Remove(gJobPlayers[p_info[playerid][job]], playerid);
            p_info[playerid][job] = JOB_IDx[listitem];
            Iter_Add(gJobPlayers[p_info[playerid][job]], playerid);

            SendMes(playerid, COLOR_BLUE, "Вы устроились "W"%s.", JOB_NAME[listitem]);
            SendMes(playerid, COLOR_LIME, "Помощь по работе: {"#cLYELLOW"}/mn > [4] Помощь по игре > [13] Основные работы");
            SendMes(playerid, COLOR_LIME, "Команды для работы: {"#cLYELLOW"}/mm > [5] Команды сервера > [7] Команды по работе");
            return 1;
