CMD:todo(playerid, params[])
{
    if(strlen(params) > 95) return SendError(playerid, "�� ����� ������� ������� �����.");
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "� ��� ����.");
    if(p_info[playerid][mute] > 0) return SendError(playerid, "� ��� ���������� ����.");
    if(GetPVarInt(playerid,"BoneStol_ID")) return 1;
    new message[144], action[144];
    if(sscanf(params, "p<*>s[144]s[144]", message, action)) return SendInfo(playerid, "�����������: /todo [�����*��������]");
    if(strlen(message) < 2 || strlen(action) < 2) return SendInfo(playerid, "�����������: /todo [�����*��������]");
    if(AdvertisingCheck(message)) return AdvertisingPunishment(playerid, message, 1);
    if(AdvertisingCheck(action)) return AdvertisingPunishment(playerid, action, 1);
    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "- '%s' - {DE92FF}������(-�) %s, %s", message, get_name(playerid), action);
    SendStreamMessage(10.0, playerid, STRING_GLOBAL, COLOR_WHITE);
    return 1;
}

CMD:statsradio(playerid, params[])
{
    new n_count[4];
    foreach(new i: Player)
    {
        if(!p_info[i][loggedIn]) continue;
        if(p_info[i][news] == RADIO_LS) n_count[0]++;
        if(p_info[i][news] == RADIO_SF) n_count[1]++;
        if(p_info[i][news] == RADIO_LV) n_count[2]++;
        if(p_info[i][news] == 0) n_count[3]++;
    }
    SendInfo(playerid, "���������� \"Los Santos\": %d | ���������� \"San Fierro\": %d | ���������� \"Las Venturas\": %d | ���������: %d.", n_count[0], n_count[1], n_count[2], n_count[3]);
    return 1;
}

CMD:changevehnum(playerid, params[])
{
    new vehicleid = GetPlayerOwnerNearestVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "�� ������� ������ �� ������ ������������� ��������.");
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "�����������: /changevehnum [id ������] [���-�� �������� �������]");
    if(params[0] == INVALID_PLAYER_ID || params[0] == playerid)
        return SendError(playerid, "����� �� ������.");
    new target_vehicle = GetPlayerOwnerNearestVehicleID(params[0]);
    if(target_vehicle == INVALID_VEHICLE_ID) return SendError(playerid, "����� ������ ��� ����� ������������� ��������.");
    if(params[1] < 1 || params[1] > 10_000_000)
        return SendError(playerid, "��������� ������ ���� �� ����� 1$ � �� ����� 10 000 000$.");
    if(strequals(veh_info[vehicleid][v_number], "NULL"))
        return SendError(playerid, "� ��� ��� ������� �� ������ ������������ ��������.");
    if(params[0] == INVALID_PLAYER_ID || !IsPlayerConnected(params[0])) return SendError(playerid, "����� �� ������.");
    if(params[0] == playerid) return SendError(playerid, "�� ����� ���� ID.");
    if(strequals(veh_info[target_vehicle][v_number], "NULL"))
        return SendError(playerid, "� ������ ��� ������� ������������ ��������.");
    //GetVehiclePos(target_vehicle, POS[0], POS[1], POS[2]);
    //if(!IsPlayerInRangeOfPoint(playerid, 8,  POS[0], POS[1], POS[2])) return SendError(playerid, "��������� �� ������� ��� ���������� �����, ����� ���.");
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
    "W"�� ������ ���������� "I"%s"W" �������� ��� ����� ������������� �������� "I"%s"W" �� "I"%s."W"\n\n\
    � �������� ���: "I"%d$.", get_name(params[0]), veh_info[vehicleid][v_number], veh_info[target_vehicle][v_number], params[1]);
    ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"����� �������� ������������� ��������", STRING_GLOBAL, "�����", "������");
    SetOfferData(playerid, params[0], OFFER_ID_CHANGE_VEH_NUMBER, params[1]);

    p_temp[playerid][p_listitem][40] = vehicleid;
    p_temp[playerid][p_listitem][41] = target_vehicle;
    return 1;
}

CMD:sellvehnum(playerid, params[])
{
    new vehicleid = GetPlayerOwnerNearestVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID)
        return SendError(playerid, "����� ��� ��� ����� ������������� ��������.");
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "�����������: /sellvehnum [id ������] [���������]");
    if(params[0] == INVALID_PLAYER_ID)
        return SendError(playerid, "����� �� ������.");
    if(params[0] == playerid)
        return SendError(playerid, "�� ����� ���� ID.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID)
        return SendError(playerid, "����� ������� ������ �� ���.");
    if(params[1] < 1 || params[1] > 10_000_000)
        return SendError(playerid, "��������� ������ ���� �� ����� 1$ � �� ����� 10000000$.");
    if(strequals(veh_info[vehicleid][v_number], "NULL"))
        return SendError(playerid, "� ��� ��� ������� �� ������ ������������ ��������.");

    SendAccess(playerid, "�� ���������� %s [%d] ������ ����� �/� %s �� %d$.", get_name(params[0]), params[0], veh_info[vehicleid][v_number], params[1]);
    SendInfo(params[0], "%s [%d] ��������� ��� ������ ����� �/� %s �� %d$.", get_name(playerid), playerid, veh_info[vehicleid][v_number], params[1]);

    SetFreeSlotOffer(params[0], playerid, OFFER_ID_SELL_VEH_NUMBER, params[1]);

    p_temp[playerid][p_listitem][40] = vehicleid;
    return 1;
}

CMD:carpass(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "�� ������ ���������� � ������������ ��������.");
    if(sscanf(params, "u", params[0]))
    {
        params[0] = playerid;
        SendInfo(playerid, "�����������: /carpass [id ������]");
    }
    if(playerid != params[0] && (!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID)) return SendError(playerid, "����� ������� ������ �� ���.");
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "����� �� ������.");
    if(params[0] == playerid) ShowCarPass(playerid, playerid);
    else
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
        "W"�� ������ ���������� �������� ���. ������� "I"%s", get_name(params[0]));
        ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"���. �������", STRING_GLOBAL, "�����", "������");
        SetOfferData(playerid, params[0], OFFER_ID_CAR_PASS);
    }
    return 1;
}

ShowCarPass(playerid, targetid)
{
    if(!IsPlayerInAnyVehicle(targetid)) return SendError(targetid, "�� ������ ���������� � ������������ ��������.");
    new vehicleid = GetPlayerVehicleID(targetid);
    if(vehicleid == 0) return SendError(playerid, "�� ������ ���������� � ������������ ��������.");
    STRING_GLOBAL[0] = EOS;
    strcat(STRING_GLOBAL, ""W"����������� �������:\n\n");
    f(STRING_GLOBAL, "%s������: %s\n", STRING_GLOBAL, GetVehicleName(vehicleid));

    if(veh_info[vehicleid][v_npoType] == NPO_PLAYERCAR && veh_info[vehicleid][v_owner_id] != INVALID_MYSQL_ID)
    {
        new onwer_veh_id = INVALID_PLAYER_ID;
        if(veh_info[vehicleid][v_owner_id] == p_info[playerid][ID]) onwer_veh_id = playerid;
        else {
            foreach(new i: Player)
            {
                if(!p_info[i][loggedIn]) continue;
                if(IsPlayerOwnerVehicle(i, vehicleid))
                {
                    onwer_veh_id = i;
                    break;
                }
            }
        }
        if(onwer_veh_id != INVALID_PLAYER_ID) f(STRING_GLOBAL, "%s��������: %s\n", STRING_GLOBAL, get_name(onwer_veh_id));

        if(strequals(veh_info[vehicleid][v_number], "NULL")) strcat(STRING_GLOBAL, "�������� ����: {"#cLIGHTRED"}���"W"\n");
        else f(STRING_GLOBAL, "%s�������� ����: {"#cGREEN"}%s"W"\n", STRING_GLOBAL, veh_info[vehicleid][v_number]);

        new insurance_info[64];
        if(veh_info[vehicleid][v_insurance] == 0) insurance_info = "{"#cLIGHTRED"}���"W"";
        else format(insurance_info, sizeof(insurance_info), "{"#cGREEN"}����"W" [%d ���(-�/-��)]", veh_info[vehicleid][v_insurance_time]);

        f(STRING_GLOBAL, "%s���������: %s", STRING_GLOBAL, insurance_info);
    }
    else
    {
        if(veh_info[vehicleid][v_npoType] == NPO_FACTION)
        {
            if(veh_info[vehicleid][v_npoId] >= MAX_FRACTIONS) printf("CRASHED: %d, %s %s", veh_info[vehicleid][v_npoId], GetPlayerFractionRangName(targetid), GetFractionName(p_info[targetid][member]));
            else f(STRING_GLOBAL, "%s��������: %s", STRING_GLOBAL, GetFractionName(veh_info[vehicleid][v_npoId]));
        }
        if(veh_info[vehicleid][v_npoType] == NPO_JOB && veh_info[vehicleid][v_npoId] != JOB_TC_TRUCK && veh_info[vehicleid][v_npoId] != JOB_TC_TAXI) strcat(STRING_GLOBAL, "��������: ���-��\n");
        if(veh_info[vehicleid][v_npoType] == NPO_JOB && (veh_info[vehicleid][v_npoId] == JOB_TC_TRUCK || veh_info[vehicleid][v_npoId] == JOB_TC_TAXI))
        {
            new tcid = veh_info[vehicleid][v_tc];
            f(STRING_GLOBAL, "\
                %s��������: %s %s [%d]", STRING_GLOBAL, bizz_type_name[b_info[tcid][_tip]], b_info[tcid][_name], b_info[tcid][b_mysql_id]);
        }
        if(veh_info[vehicleid][v_npoType] == NPO_FAMILY && veh_info[vehicleid][v_family_id] != -1)
        {
            f(STRING_GLOBAL, "\
            %s�������� �����: %s\n\
            �������� ����: GOS %04d\n\
            ��������� ����������: {"#cGREEN"}����"W"", STRING_GLOBAL, FamilyData[veh_info[vehicleid][v_family_id]][fName], vehicleid);
        }
    }
    f(STRING_GLOBAL, "%s\n\n\
        ����������� ��������������:\n\n\
        ��������: %d �� 3\n\
        �����������: %d �� 3\n\
        �����������: %d �� 3\n\
        ���������: %d �� 3\n\n\
        ��������� ��������: %.1f\n\
        ��������� ������������: %.1f\n\
        ��������� ��������� �������: %.1f\n\
        ��������� ���������: %.1f\n\
        ��������� ���������: %.1f\n\n\
        ����. ��������: %d KM/H\n\
        ����. �������� � ��������: %d KM/H\n\n\
        �������: %s", STRING_GLOBAL,
        veh_info[vehicleid][v_twinturbo_data][tt_suspension], veh_info[vehicleid][v_twinturbo_data][tt_transmission],
        veh_info[vehicleid][v_twinturbo_data][tt_turbocharging], veh_info[vehicleid][v_twinturbo_data][tt_engine],
        veh_info[vehicleid][v_details][0], veh_info[vehicleid][v_details][1], veh_info[vehicleid][v_details][2],
        veh_info[vehicleid][v_details][3], veh_info[vehicleid][v_details][4], floatround(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_SPEED)),
        GetVehicleMaxSpeed(vehicleid), (veh_info[vehicleid][v_premium] == 1) ? ("{"#cGREEN"}����"W"") : ("{"#cLIGHTRED"}���"W""));
    if(veh_info[vehicleid][v_sell_block] != 0) strcat(STRING_GLOBAL, "\n\n{"#cLIGHTRED"}������ ������������ �������� ���������� � ������� ����������� �������� �� 0$!"W"");
    if(veh_info[vehicleid][v_bonus] != 0) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s\n\n������������ �������� ����� ������� ����� {"#cLIGHTRED"}%s"W".", STRING_GLOBAL, ConvertTime(veh_info[vehicleid][v_bonus]-timestamp));
    ShowPlayerDialog(targetid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"���. �������", STRING_GLOBAL, "��", "");

    new str[144];
    str = "������(-�) ��������� �� ��������";
    if(targetid != playerid) format(str, sizeof(str), "%s � �������(-�) �� %s", str, get_name(targetid));
    MeAction(playerid, str);
    return 1;
}


CMD:setmbiz(playerid, params[])
{
    if(p_info[playerid][admin] < 4)
        return 1;

    new bizid, mafia_id;
    if(sscanf(params, "ii", bizid, mafia_id)) return SendInfo(playerid, "�����������: /setmbiz [id �������] [id �������]");

    if(!(0 <= bizid < totalbizz))
        return SendError(playerid, "�������� ID �������.");
    if(b_info[bizid][b_mysql_id] == INVALID_MYSQL_ID)
        return SendError(playerid, "�������� ID �������.");
    if(!(MAFIA_RM <= mafia_id <= MAFIA_YAKUDZA) && mafia_id != BIKER && mafia_id != MAFIA_IRAN && mafia_id != 0)
        return SendError(playerid, "�������� ID �����.");

    if(b_info[bizid][b_mafia] == mafia_id)
        return SendError(playerid, "������ ����� ���� �������� ������ ����� �������.");

    if(b_info[bizid][b_mafia] != 0) MafiaCountBizz(b_info[bizid][b_mafia], -1);
    if(mafia_id != 0) MafiaCountBizz(mafia_id, 1);

    b_info[bizid][b_mafia] = mafia_id;
    save_bizz(bizid);
    update_bizz(bizid);

    SendAccess(playerid, "�� �������� �������� ��� ��������.");

    Log(LOG_player, INFO, "%s[%d](%s %s) ��������� �������� ��� �������� %s(%d): %s | #AdminLogs",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        b_info[bizid][_name], bizid, GetFractionName(mafia_id));
    return 1;
}
