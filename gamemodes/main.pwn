CMD:changeskin(playerid, params[])
{
    if(p_info[playerid][rang] < 9)
        return SendError(playerid, "�� �� ������ ������������ ���� ��������.");

    new targetid;
    if(sscanf(params, "u", targetid)) return SendInfo(playerid, "�����������: /changeskin [id ������]");

    if(targetid == INVALID_PLAYER_ID)
        return SendError(playerid, "����� �� ������.");

    if(p_info[targetid][member] != p_info[playerid][member])
        return SendError(playerid, "����� �� ������� �� �������.");

    if(!IsPlayerStream(5.0, playerid, targetid) || pSpectateId[targetid] != INVALID_PLAYER_ID)
        return SendError(playerid, "����� ������� ������ �� ���.");

    if(p_info[targetid][rang] >= p_info[playerid][rang] && targetid != playerid)
        return SendError(playerid, "� ��� ������� ��������� ���� �� �������.");
    for(new i = 10; i != -1; i--) p_temp[playerid][p_listitem][i] = -1;
    p_temp[playerid][p_listitem_int] = targetid;
    ShowPlayerListTD(playerid, LIST_TD_ID_FRACTION_CHANGE_SKIN);
    return 1;
}

CMD:givegun(playerid, params[])
{
    if(p_info[playerid][admin] < 4 && p_info[playerid][youtube_adm] < 3)
        return 1;
    if(sscanf(params, "uii", params[0], params[1], params[2])) return SendInfo(playerid, "�����������: /givegun [id ������] [id ������] [�������]");
    if(params[0] == INVALID_PLAYER_ID)
        return SendError(playerid, "����� �� ������.");
    if(p_info[params[0]][level] < 2)
        return SendError(playerid, "� ������ ��� 2-��� ������.");
    if(SRV_ID != 0 && (params[1] >= 35 && params[1] <= 40 || params[1] >= 44 && params[1] <= 46))
        return SendError(playerid, "�� ����� ����������� ID ������.");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] ����� %s [%d] ������ %d, �������� %d.", get_name(playerid), playerid, get_name(params[0]), params[0], params[1], params[2]);
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

    SendAccess(playerid, "�� ������ %s [%d] ������ %d, �������� %d.", get_name(params[0]), params[0], params[1], params[2]);
    SendInfo(params[0], "������������� %s [%d] ����� ��� ������ %d, �������� %d.", get_name(playerid), playerid, params[1], params[2]);

    GivePlayerWeapon(params[0], params[1], params[2]);

    Log(LOG_player, INFO, "%s[%d](%s %s) ����� %s[%d](%s %s) ������ (%d) � %d �������� | #AdminLogs",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC", params[1], params[2]);
    return 1;
}

CMD:givegunr(playerid, params[]) {
    if(p_info[playerid][admin] < 3 && p_info[playerid][youtube_adm] < 3) return 1;
    if(sscanf(params, "iii", params[0], params[1], params[2])) return SendInfo(playerid, "�����������: /givegunr [id ������] [�������] [������]");

    if(params[0] >= 35 && params[0] <= 40 || params[0] >= 44 || params[0] < 1)
        return SendError(playerid, "�� ����� ����������� ID ������.");

    if(params[2] > 100.0 || params[2] < 1.0) return SendError(playerid, "������ ������ ���� �� ����� 1 � �� ����� 100.");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] ����� ������ %d, �������� %d � ������� %0.2f.", get_name(playerid), playerid, params[0], params[1], params[2]);
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

    foreach(new i: Player) {
        if(!p_info[i][loggedIn]) continue;
        if(IsPlayerStream(params[2], playerid, i) && p_info[i][level] > 1) {
            SendInfo(i, "������������� %s [%d] ����� ��� ������ %d, �������� %d.", get_name(playerid), playerid, params[0], params[1]);
            GivePlayerWeapon(i, params[0], params[1]);
        }
    }
    SendAccess(playerid, "�� ������ ������� ������ %d, �������� %d � ������� %d.", params[0], params[1], params[2]);
    return 1;
}

CMD:resetgun(playerid, params[]) {
    if(p_info[playerid][admin] < 3) return 1;
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "�����������: /resetgun [id ������]");

    if(params[0] == INVALID_PLAYER_ID)
        return SendError(playerid, "����� �� ������.");

    SendAccess(playerid, "�� ������� � %s [%d] ������.", get_name(params[0]), params[0]);
    SendInfo(params[0], "������������� %s [%d] ������ � ��� ������.", get_name(playerid), playerid);

    f_ResetPlayerWeapons(params[0]);
    return 1;
}

CMD:resetgunr(playerid, params[]) {
    if(p_info[playerid][admin] < 3) return 1;
    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "�����������: /resetgunr [������]");
    if(params[0] > 100 || params[0] < 1) return SendError(playerid, "������ ������ ���� �� ����� 1 � �� ����� 100.");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] ������ ������ � ������� %d.", get_name(playerid), playerid, params[0]);
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

    foreach(new i: Player) {
        if(!p_info[i][loggedIn]) continue;
        if(IsPlayerStream(params[0], playerid, i)) {
            SendInfo(i, "������������� %s [%d] ������ � ��� ������.", get_name(playerid), playerid);
            ResetPlayerWeapons(i);
        }
    }
    SendAccess(playerid, "�� ������� ������ � ������� � ������� %d.", params[0]);
    return 1;
}

