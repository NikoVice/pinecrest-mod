        if((GetPlayerFamilyID(i) != -1 || gang(i) || mafia(i) || biker(i)) && p_temp[i][rob_bank_timer] == 1 && p_temp[i][rob_bank_timer_max] > 0 && p_temp[i][rob_bank_backup] == 1)
        {
            temp_rob_bank_idx = p_temp[i][rob_bank_idx];
            temp_rob_bank_type = RobberyBankContract[temp_rob_bank_idx][rbcType];
            if(temp_rob_bank_idx != -1 && GetPlayerVirtualWorld(i) == RobberyBankContract[temp_rob_bank_idx][rbcBankIDx] && RobberyBankContract[temp_rob_bank_idx][rbcItemsStart][7] == 0 && RobberyBankContract[temp_rob_bank_idx][rbcMetalUse] == 0 && IsPlayerInRangeOfPoint(i, 5.0, 2264.9810,-60.0826,1070.2646))
            {
                temp_rob_bank_money = 300;
                if(p_temp[i][rob_bank_backup_items][0] < MAX_ROBBERY_BANK_MONEY)
                {
                    p_temp[i][rob_bank_backup_items][0] += temp_rob_bank_money;
                    if(p_temp[i][rob_bank_backup_items][0] > MAX_ROBBERY_BANK_MONEY) p_temp[i][rob_bank_backup_items][0] = MAX_ROBBERY_BANK_MONEY;
                }
                if(temp_rob_bank_type == 1 && random(100) < 25 && p_temp[i][rob_bank_backup_items][1] < MAX_ROBBERY_BANK_GOLD)
                {
                    temp_rob_bank_gold = random(1);
                    p_temp[i][rob_bank_backup_items][1] += temp_rob_bank_gold;
                    if(p_temp[i][rob_bank_backup_items][1] > MAX_ROBBERY_BANK_MONEY) p_temp[i][rob_bank_backup_items][1] = MAX_ROBBERY_BANK_GOLD;
                }
                new str[64];
                if(temp_rob_bank_type == 1) format(str, sizeof(str), "~n~~n~~n~~n~~n~~n~~g~%d$ ~w~& ~y~%d KG. GOLD~n~~b~%d SEC.", p_temp[i][rob_bank_backup_items][0], p_temp[i][rob_bank_backup_items][1], p_temp[i][rob_bank_timer_max]);
                else format(str, sizeof(str), "~n~~n~~n~~n~~n~~n~~g~%d$~n~~b~%d SEC.", p_temp[i][rob_bank_backup_items][0], p_temp[i][rob_bank_timer_max]);
                GameTextForPlayer(i, str, 500, 3);
                if(p_temp[i][rob_bank_backup_items][0] == MAX_ROBBERY_BANK_MONEY || p_temp[i][rob_bank_backup_items][1] == MAX_ROBBERY_BANK_GOLD)
                {
                    p_temp[i][rob_bank_timer] = 2;
                    SendInfo(i, "В Вашей сумке нет места, отнесите её в транспортное средство или на сбыт к Джеку.");
                    SendInfo(i, "Чтобы разгрузить сумку, введите /robbing возле багажника.");
                }
            }
        }
        if(p_temp[i][rob_bank_timer_max] > 0)
        {
            temp_rob_bank_idx = p_temp[i][rob_bank_idx];
