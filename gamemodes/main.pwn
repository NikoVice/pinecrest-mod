                    case WEAPON_SHOTGUN:
                        if(ammo >= 30) return SendError(playerid, "� ��� ��� ���� ������ ������� ����.");
                    case WEAPON_M4, WEAPON_AK47:
                        if(ammo >= 300) return SendError(playerid, "� ��� ��� ���� ������ ������� ����.");
                    case WEAPON_UZI, WEAPON_MP5:
                        if(ammo >= 150) return SendError(playerid, "� ��� ��� ���� ������ ������� ����.");
                }

                f_GivePlayerWeapon(playerid, fbiWEAPON[listitem][g_Id], fbiWEAPON[listitem][g_Patr]);

