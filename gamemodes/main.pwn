                if(gos(playerid)) return SendError(playerid, "�� �� ��������� ������� ����.");
                if(p_temp[playerid][rob_fuel_idx] == -1) return SendError(playerid, "�� �� ���������� � ���������� ���.");
                ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_BUY, 3);
