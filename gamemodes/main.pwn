            if(b > totalbizz) return 1;
            if(b == -1) return 1;
            if(b_info[b][b_auction_bet] == 0) return 1;
            if((b_info[b][_tip] == B_TAXI || b_info[b][_tip] == B_TRUCKER) && 
                IsPlayerOwnerBizzType(playerid, b_info[b][_tip]))
                    return SendError(playerid, "� ��� ��� ���� %s.", b_info[b][_tip] == B_TRUCKER ? "������������ ��������":"���������");
