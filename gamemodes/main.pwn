            SetPlayerAttachedObject(playerid, 4, 19995, 6, 0.092000, 0.013000, 0.270000, 0.000000, -52.799999, -89.500000, 1.422996, 0.690000, 1.031000);
            SetPlayerAttachedObject(playerid, 5, 18634, 6, 0.324999, 0.004999, 0.810000, 25.900020, 97.399948, -114.699958, 0.257999, 1.542999, 0.719999, 0xFFFF0000, 0x0);
            SetPlayerAttachedObject(playerid, 6, 19421, 2, 0.045999, 0.000000, 0.001000, 90.699920, -3.999979, -89.300025, 1.018000, 0.886999, 0.759000);
            SendMes(playerid, COLOR_BLUE, "�� ����� �������� ����������� ���������� ����, � ������� ���������� ����� ����.");
            SendMes(playerid, COLOR_LIME, "����� ������ ��������, �������������� �������� {"#cLYELLOW"}/tr{"#cLIME"} ����� ����� �����.");
            SendMes(playerid, COLOR_SEA_WAVE, "�� ����� �������� ���������� ��������� ����� � ������� �����, �� � ����� �� ��� ��������� �����.");
            GangZoneShowForPlayer(playerid, treasure_hunter_zone, 0xCFB406AA);
            SetPlayerTHunter(playerid);
        }
    }
    p_temp[playerid][Work_ID] = type;
    return 1;
}

EndPlayerJob(playerid, type = 0)
{
    SendMes(playerid, COLOR_BLUE, "�� ��������� ������� ����.");

    new vehicleid = GetPlayerVehicleID(playerid), rent_vehicleid = p_temp[playerid][rented_veh], bool:change_skin = true, checkworkcar;

    if(rent_vehicleid != INVALID_VEHICLE_ID) checkworkcar = veh_info[rent_vehicleid][v_temp_job];

    for(new i = 0; i < 10; i++) if(IsPlayerAttachedObjectSlotUsed(playerid, i)) RemovePlayerAttachedObject(playerid, i);

    if(IsPlayerInAnyVehicle(playerid) && checkworkcar == 0) RemovePlayerFromVehicle(playerid);

    if(IsPlayerOwnerVehicle(playerid, vehicleid) && veh_info[vehicleid][v_job] == JOB_TC_TAXI && p_temp[playerid][Work_ID] == TAXI_WORK)
    {
        new Text3D:vehicle_text = veh_info[vehicleid][v_text];
        if(vehicle_text != INVALID_3DTEXT_ID)
        {
            Delete3DTextLabel(vehicle_text);
            veh_info[vehicleid][v_text] = INVALID_3DTEXT_ID;
        }
        p_temp[playerid][fix_flood] = INVALID_PLAYER_ID;
        p_temp[playerid][taxi_zp] = 0.0;
        p_temp[playerid][taxi_enter] = 0;
        veh_info[vehicleid][v_cost_taxi] = 0;
        veh_info[vehicleid][v_job] = 0;
        p_temp[playerid][fix_bug_biz_tc_salary] = 0;
        SendMes(playerid, COLOR_LYELLOW, "���������� �����: {"#cLIME"}%d.", GetPVarInt(playerid, "@payment"));
        SendMes(playerid, COLOR_LYELLOW, "���-�� ����������: {"#cLIME"}%d.", GetPVarInt(playerid, "@passenger_count"));
        DeletePVar(playerid, "@passenger");
        DeletePVar(playerid, "@passenger_count");
        change_skin = false;
    }

    if(p_info[playerid][taxi_idx] && rent_vehicleid != INVALID_VEHICLE_ID && veh_info[rent_vehicleid][v_job] == JOB_TC_TAXI)
    {
        if(veh_info[rent_vehicleid][v_text] != INVALID_3DTEXT_ID)
        {
            Delete3DTextLabel(veh_info[rent_vehicleid][v_text]);
            veh_info[rent_vehicleid][v_text] = INVALID_3DTEXT_ID;
        }
        veh_info[rent_vehicleid][v_cost_taxi] = 0;
        veh_info[rent_vehicleid][v_job] = 0;
        veh_info[rent_vehicleid][v_lock] = 0;

        p_temp[playerid][fix_flood] = INVALID_PLAYER_ID;
        p_temp[playerid][taxi_zp] = 0.0;
        p_temp[playerid][taxi_enter] = 0;
        p_temp[playerid][fix_bug_biz_tc_salary] = 0;
        SendMes(playerid, COLOR_LYELLOW, "���������� �����: {"#cLIME"}%d.", GetPVarInt(playerid, "@payment"));
        SendMes(playerid, COLOR_LYELLOW, "���-�� ����������: {"#cLIME"}%d.", GetPVarInt(playerid, "@passenger_count"));
        DeletePVar(playerid, "@passenger");
        DeletePVar(playerid, "@passenger_count");
        change_skin = false;
    }

    if(p_info[playerid][tc_idx] && rent_vehicleid != INVALID_VEHICLE_ID && (veh_info[rent_vehicleid][v_job] == JOB_TC_TRUCK || veh_info[rent_vehicleid][v_temp_job] == JOB_TC_TRUCK))
    {
        veh_info[rent_vehicleid][v_lock] = 0;
        p_temp[playerid][TruckerLoad] = 0;
        p_temp[playerid][TruckerSalary] = 0;
        new vehicleid = p_temp[playerid][TruckerTrailer];
        if(vehicleid != INVALID_VEHICLE_ID)
        {
            DestroyVehicleVEx(vehicleid);
            p_temp[playerid][TruckerTrailer] = INVALID_VEHICLE_ID;
        }
        p_temp[playerid][fix_bug_biz_tc_salary] = 0;
        change_skin = false;
    }

    switch(p_temp[playerid][Work_ID])
    {
        case GUN_FACTORY_WORK:
        {
            if(p_temp[playerid][GunFactoryLocat]) GunFactoryWorkTableStat[p_temp[playerid][GunFactoryLocat]-1] = false;
            p_temp[playerid][GunFactoryCheck] = 0;
            p_temp[playerid][GunFactoryIDx] = 0;
            p_temp[playerid][GunFactoryCount] = 0;
            p_temp[playerid][GunFactorySalary] = 0;
            p_temp[playerid][GunFactoryLocat] = 0;
        }
        case RAILWAY_WORK:
        {
            if(p_temp[playerid][RailwayLocat]) RailwayWorkTableStat[p_temp[playerid][RailwayLocat]-1] = false;
            p_temp[playerid][RailwayType] = 0;
            p_temp[playerid][RailwayCheck] = 0;
            p_temp[playerid][RailwayIDx] = 0;
            p_temp[playerid][RailwayCount][0] = 0;
            p_temp[playerid][RailwayCount][1] = 0;
            p_temp[playerid][RailwaySalary] = 0;
            p_temp[playerid][RailwayLocat] = 0;
            new idx = p_temp[playerid][RailwayObject];
            if(idx != INVALID_OBJECT_ID)
            {
                DestroyDynamicObject(idx);
                p_temp[playerid][RailwayObject] = INVALID_OBJECT_ID;
            }
        }
        case CAR_FACTORY_WORK:
        {
            if(CarFactoryIDx[playerid] != -1 && CarFactoryType[playerid] != -1)
            {
                new i = CarFactoryIDx[playerid], idx = CarFactoryType[playerid];
                if(CarFactory[i][cfPlayerID][idx] == playerid)
                {
                    CarFactory[i][cfPlayerID][idx] = INVALID_PLAYER_ID;
                    UpdateCarFactoryStatusPos(i, idx);
                }
            }

            CarFactoryIDx[playerid] = -1;
            CarFactoryType[playerid] = -1;
            CarFactoryCarParts[playerid] = -1;
            CarFactorySalary[playerid] = 0;

            HidePlayerCarFactory(playerid);
        }
        case FARM_WORK:
        {
            p_temp[playerid][FarmType] = 0;
            new vehicleid = p_temp[playerid][FarmTrailer];
            if(vehicleid != INVALID_VEHICLE_ID)
            {
                DestroyVehicleVEx(vehicleid);
                p_temp[playerid][FarmTrailer] = INVALID_VEHICLE_ID;
            }
            if(p_temp[playerid][FarmTrailerTimer])
            {
                KillTimer(p_temp[playerid][FarmTrailerTimer]);
                p_temp[playerid][FarmTrailerTimer] = 0;
            }
            if(p_temp[playerid][FarmTreeIDx] != -1)
            {
                new idx = p_temp[playerid][FarmTreeIDx];
                if(FarmTreeInfo[idx][ftPlayerID] == playerid)
                {
                    FarmTreeInfo[idx][ftPlayerID] = INVALID_PLAYER_ID;
                    UpdateFarm(TYPE_FARM_TREE, idx);
                }
            }
            if(p_temp[playerid][FarmMilkerIDx] != -1)
            {
                new idx = p_temp[playerid][FarmMilkerIDx];
                if(FarmMilkerInfo[idx][fmPlayerID] == playerid)
                {
                    FarmMilkerInfo[idx][fmPlayerID] = INVALID_PLAYER_ID;
                    UpdateFarm(TYPE_FARM_MILKER, idx);
                }
            }
            p_temp[playerid][FarmCheck] = 0;
            p_temp[playerid][FarmBucket] = 0;
            p_temp[playerid][FarmCount] = 0;
            p_temp[playerid][FarmSalary] = 0;
            p_temp[playerid][farm_use_idx] = -1;
            p_temp[playerid][farm_use_type] = -1;
            p_temp[playerid][farm_extraction_timer] = 0;
            if(p_temp[playerid][FarmBizIDx] != -1)
            {
                new idx = p_temp[playerid][FarmBizIDx];
                FarmWarehouseInfo[2][fwarCount] += b_info[idx][b_order];
                UpdateFarm(TYPE_FARM_PRODUCT, 2);
                MysqlUpdateOtherInt("farm_warehouse_product", FarmWarehouseInfo[2][fwarCount]);
                b_info[idx][b_order_player_id] = INVALID_PLAYER_ID;
                p_temp[playerid][FarmBizIDx] = -1;
            }
        }
        case CONSTRUCTION_WORK:
        {
            p_temp[playerid][ConstructionType] = 0;
            p_temp[playerid][ConstructionCheck] = 0;
            p_temp[playerid][ConstructionCount] = 0;
            p_temp[playerid][ConstructionSalary] = 0;
            new idx = p_temp[playerid][ConstructionObject];
            if(idx != INVALID_OBJECT_ID)
            {
                DestroyDynamicObject(idx);
                p_temp[playerid][ConstructionObject] = INVALID_OBJECT_ID;
            }
            p_temp[playerid][ConstructionIDx] = -1;
        }
        case SPACE_WORK:
        {
            if(p_temp[playerid][SpaceIDx] != 0) DestroySpaceFossils(playerid);
            p_temp[playerid][SpaceIDx] = 0;
            p_temp[playerid][SpaceTimer] = 0;
            p_temp[playerid][SpaceProgress] = 0;
            p_temp[playerid][SpaceCount] = 0;
            p_temp[playerid][SpaceSalary] = 0;
        }
        case THEFT_CAR_WORK:
        {
            DestroyTheftCarVehicle(playerid);
            ClearTheftCar(playerid, TYPE_THEFT_CAR_WORK);
        }
        case PIZZABOY_WORK:
        {
            p_temp[playerid][PizzaboyIDx] = -1;
            p_temp[playerid][PizzaboySalary] = 0;
        }
        case TAXI_WORK:
        {
            DestroyTaxi(playerid);
            p_temp[playerid][taxi_bots_idx] = 0;
            p_temp[playerid][taxi_bots_timer] = 0;
            p_temp[playerid][taxi_bots_salary] = 0;
            p_temp[playerid][taxi_bots_gps_idx] = 0;
            change_skin = false;
        }
        case TRUCK_WORK:
        {
            change_skin = false;
        }
        case BUS_WORK:
        {
            p_info[playerid][p_busTime] = 0;
            SendMes(playerid, COLOR_LYELLOW, "���������� �����: {"#cLIME"}%d.", GetPVarInt(playerid, "BusMoney"));
            SendMes(playerid, COLOR_LYELLOW, "���-�� ����������: {"#cLIME"}%d.", GetPVarInt(playerid, "@passenger_count"));
            SendMes(playerid, COLOR_LYELLOW, "������������ �������: {"#cLIME"}%d.", GetPVarInt(playerid, "@payment")*GetPVarInt(playerid, "@passenger_count"));
            if(IsValidVehicle(rent_vehicleid))
            {
                new Float:healths;
                GetVehicleHealth(rent_vehicleid, healths);
                if(veh_info[rent_vehicleid][v_temp_job] == JOB_BUS) SendMes(playerid, COLOR_LIME, "�� ������ �� ������ ������������ �������� � ���������� ����� ���������: {"#cLYELLOW"}%d$.", (GetPVarInt(playerid, "BusMoney") / 100) * 20);
                else SendMes(playerid, COLOR_LYELLOW, "������ ������������� ��������: {"#cLIME"}%d.", floatround(floatsub(1000.0, healths)));
            }
            DeletePVar(playerid, "BusMoney");
            DeletePVar(playerid, "@passenger_count");
            DeletePVar(playerid, "TypeBus");
            change_skin = false;
        }
        case MECHANIC_WORK:
        {
            DeletePVar(playerid,"toplivo");
            DeletePVar(playerid,"MehName");
            ResetPlayerWeapons(playerid);
            DestroyMechanic(playerid);
            for (new i; i < MAX_WEAPONS; i++)
            {
                if(p_info[playerid][Weapon][i] == 42)
                {
                    p_info[playerid][Weapon][i] = 0;
                    p_info[playerid][Ammo][i] = 0;
                    p_temp[playerid][mechanic_ammo] = 0;
                    continue;
                }
                GivePlayerWeapon(playerid, p_info[playerid][Weapon][i], p_info[playerid][Ammo][i]);
            }
            p_temp[playerid][mechanic_idx] = 0;
            p_temp[playerid][mechanic_timer] = 0;
            p_temp[playerid][mechanic_salary] = 0;
            p_temp[playerid][mechanic_exting] = 0;
            p_temp[playerid][mechanic_exting_count] = 0;
            p_temp[playerid][mechanic_ammo] = 0;
            change_skin = false;
        }
        case ROADMAN_WORK:
        {
            p_temp[playerid][roadman_check] = 0;
            p_temp[playerid][roadman_use_idx] = -1;
            p_temp[playerid][roadman_hash_idx] = -1;
            p_temp[playerid][roadman_extraction_timer] = 0;

            for(new i = 0; i < MAX_ROADCRASH_VEHICLE_TRASH; i++)
            {
                if(p_temp[playerid][roadman_object][i] != INVALID_OBJECT_ID)
                {
                    DestroyDynamicObject(p_temp[playerid][roadman_object][i]);
                    p_temp[playerid][roadman_object][i] = INVALID_OBJECT_ID;
                }
            }
        }
        case COLLECTOR_WORK:
        {
            new idx = CollectorIDx[playerid];
            if(idx != -1) ATMInfo[idx][aPlayerID] = INVALID_PLAYER_ID;
            CollectorIDx[playerid] = -1;
            CollectorVehicleIDx[playerid] = INVALID_VEHICLE_ID;
            CollectorAttachedObject[playerid] = 0;
            for(new i = 0; i < 3; i++)
            {
                new scdplayerid = CollectorMembersParty[playerid][i];
                if(scdplayerid != INVALID_PLAYER_ID)
                {
                    if(IsPlayerConnected(scdplayerid))
                    {
                        SendInfo(scdplayerid, "%s [%d] ��������(-�) ������� ����, �� ������ �� ��������� ���������.", get_name(playerid), playerid);
                        CollectorParty[scdplayerid] = INVALID_PLAYER_ID;

                        DisablePlayerCheckpoint(scdplayerid);
                        new idx = CollectorIDx[scdplayerid];
                        if(idx != -1) ATMInfo[idx][aPlayerID] = INVALID_PLAYER_ID;
                        CollectorIDx[scdplayerid] = -1;
                        CollectorVehicleIDx[scdplayerid] = INVALID_VEHICLE_ID;
                        CollectorAttachedObject[scdplayerid] = 0;
                        p_temp[scdplayerid][p_GPS] = false;
                    }
                }
                CollectorMembersParty[playerid][i] = INVALID_PLAYER_ID;
            }
            if(CollectorParty[playerid] != INVALID_PLAYER_ID)
            {
                new scdplayerid = CollectorParty[playerid];
                if(IsPlayerConnected(scdplayerid))
                {
                    for(new i = 0; i < 3; i++)
                    {
                        if(CollectorMembersParty[scdplayerid][i] == playerid)
                        {
                            SendInfo(scdplayerid, "%s [%d] ��������(-�) ������� ����, �� ������ �� ��������� ���������.", get_name(playerid), playerid);
                            CollectorMembersParty[scdplayerid][i] = INVALID_PLAYER_ID;
                        }
                    }
                }
                CollectorParty[playerid] = INVALID_PLAYER_ID;
            }
        }
        case FIREMAN_WORK:
        {
            if(p_temp[playerid][FireStatus] != 0) DestroyFire(playerid);
            p_temp[playerid][FireStatus] = 0;
            p_temp[playerid][FireTimer] = 0;
            p_temp[playerid][FireExting] = 0;
            p_temp[playerid][FireExtingCount] = 0;
            p_temp[playerid][FireAmmo] = 0;
            ResetPlayerWeapons(playerid);
            for (new i; i < MAX_WEAPONS; i++)
            {
                if(p_info[playerid][Weapon][i] == 42)
                {
                    p_info[playerid][Weapon][i] = 0;
                    p_info[playerid][Ammo][i] = 0;
                    p_temp[playerid][FireAmmo] = 0;
                    continue;
                }
                GivePlayerWeapon(playerid, p_info[playerid][Weapon][i], p_info[playerid][Ammo][i]);
            }
        }
        case TRAIN_WORK:
        {
            if(p_temp[playerid][TrainVehicleIDx] != INVALID_VEHICLE_ID)
            {
                new vehicleid = p_temp[playerid][TrainVehicleIDx];
                if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                {
                    Delete3DTextLabel(veh_info[vehicleid][v_text]);
                    veh_info[vehicleid][v_text] = INVALID_3DTEXT_ID;
                }
            }
            p_temp[playerid][TrainVehicleIDx] = INVALID_VEHICLE_ID;
            p_temp[playerid][TrainTimer] = 0;
            p_temp[playerid][TrainStop] = false;
            p_temp[playerid][TrainStopIDx] = 0;
            p_temp[playerid][TrainSpeedWarning] = 0;
            change_skin = false;
            SetCameraBehindPlayer(playerid);
        }
        case TRAM_WORK:
        {
            if(p_temp[playerid][TramVehicleIDx] != INVALID_VEHICLE_ID)
            {
                new vehicleid = p_temp[playerid][TramVehicleIDx];
                if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                {
                    Delete3DTextLabel(veh_info[vehicleid][v_text]);
                    veh_info[vehicleid][v_text] = INVALID_3DTEXT_ID;
                }
                DestroyVehicleVEx(vehicleid);
                veh_info[vehicleid][v_lock] = 0;
            }
            p_temp[playerid][TramVehicleIDx] = INVALID_VEHICLE_ID;
            p_temp[playerid][TramTimer] = 0;
            p_temp[playerid][TramStop] = false;
            p_temp[playerid][TramStopIDx] = 0;
            p_temp[playerid][TramSpeedWarning] = 0;
            SetCameraBehindPlayer(playerid);
        }
        case PILOT_WORK:
        {
            DeletePVar(playerid, "TypePilot");
            change_skin = false;
        }
        case PANEL_WORK:
        {
            new idx = p_temp[playerid][PanelIDx];
            if(idx != -1) PanelHouseInfo[idx][PanelHouseRepairPlayerID] = INVALID_PLAYER_ID;
            p_temp[playerid][PanelIDx] = -1;
            if(p_temp[playerid][TextDrawPanel] == true) HideTextDrawForPlayer(playerid, TD_ID_PANEL);
        }
        case ROBBER_WORK:
        {
            RobberIDx[playerid] = -1;
            RobberVehicleIDx[playerid] = INVALID_VEHICLE_ID;
            RobberAttachedObject[playerid] = 0;
            for(new i = 0; i < 3; i++)
            {
                new scdplayerid = RobberMembersParty[playerid][i];
                if(scdplayerid != INVALID_PLAYER_ID)
                {
                    if(IsPlayerConnected(scdplayerid))
                    {
                        SendInfo(scdplayerid, "%s [%d] ��������(-�) ������� ����, �� ������ �� ��������� ���������.", get_name(playerid), playerid);
                        RobberParty[scdplayerid] = INVALID_PLAYER_ID;

                        DisablePlayerCheckpoint(scdplayerid);
                        RobberIDx[scdplayerid] = -1;
                        RobberVehicleIDx[scdplayerid] = INVALID_VEHICLE_ID;
                        RobberAttachedObject[scdplayerid] = 0;
                        p_temp[scdplayerid][p_GPS] = false;
                    }
                }
                RobberMembersParty[playerid][i] = INVALID_PLAYER_ID;
            }
            if(RobberParty[playerid] != INVALID_PLAYER_ID)
            {
                new scdplayerid = RobberParty[playerid];
                if(IsPlayerConnected(scdplayerid))
                {
                    for(new i = 0; i < 3; i++)
                    {
                        if(RobberMembersParty[scdplayerid][i] == playerid)
                        {
                            SendInfo(scdplayerid, "%s [%d] ��������(-�) ������� ����, �� ������ �� ��������� ���������.", get_name(playerid), playerid);
                            RobberMembersParty[scdplayerid][i] = INVALID_PLAYER_ID;
                        }
                    }
                }
                RobberParty[playerid] = INVALID_PLAYER_ID;
            }
        }
        case GREEN_HOUSES_WORK:
        {
            new idx = p_temp[playerid][GreenHousesIDx];
            if(idx != -1)
            {
                FlowersGreenHousesInfo[idx][fPlayerID] = INVALID_PLAYER_ID;
                UpdateFlowers(idx);
            }
            p_temp[playerid][GreenHousesIDx] = -1;
            p_temp[playerid][GreenHousesSalary] = 0;
            p_temp[playerid][GreenHousesTimer] = 0;
        }
        case DRUG_WORK:
        {
            SetPlayerSkinEx(playerid);
            p_temp[playerid][WorkCheckDrug] = -1;
        }
        case LABORATORY_WORK:
        {
            p_temp[playerid][LaboratoryTimer] = 0;
            p_temp[playerid][LaboratoryCount] = 0;
            p_temp[playerid][LaboratorySalary] = 0;
            p_temp[playerid][LaboratoryCheck] = 0;
        }
        case HUNTING_WORK:
        {
            ClearPlayerHunting(playerid, HUNTING_TYPE_CLEAR_FINISH);
            change_skin = false;
        }
        case ELECTRIC_WORK:
        {
            new idx = ElectricIDx[playerid];
            if(idx != -1)
            {
                PowerLinesInfo[idx][plPlayerID] = INVALID_PLAYER_ID;
                PowerLinesInfo[idx][plRepair] = 0;
                PowerLinesInfo[idx][plMetal] = MAX_VEHICLE_POWER_LINES_COUNT;
            }
            ElectricIDx[playerid] = -1;
            ElectricVehicleIDx[playerid] = INVALID_VEHICLE_ID;
            ElectricAttachedObject[playerid] = 0;
            ElectricType[playerid] = 0;
            for(new i = 0; i < 3; i++)
            {
                new scdplayerid = ElectricMembersParty[playerid][i];
                if(scdplayerid != INVALID_PLAYER_ID)
                {
                    if(IsPlayerConnected(scdplayerid))
                    {
                        SendInfo(scdplayerid, "%s [%d] ��������(-�) ������� ����, �� ������ �� ��������� ���������.", get_name(playerid), playerid);
                        ElectricParty[scdplayerid] = INVALID_PLAYER_ID;

                        DisablePlayerCheckpoint(scdplayerid);
                        new idx = ElectricIDx[scdplayerid];
                        if(idx != -1)
                        {
                            PowerLinesInfo[idx][plPlayerID] = INVALID_PLAYER_ID;
                            PowerLinesInfo[idx][plRepair] = 0;
                            PowerLinesInfo[idx][plMetal] = MAX_VEHICLE_POWER_LINES_COUNT;
                        }
                        ElectricIDx[scdplayerid] = -1;
                        ElectricVehicleIDx[scdplayerid] = INVALID_VEHICLE_ID;
                        ElectricAttachedObject[scdplayerid] = 0;
                    }
                }
                ElectricMembersParty[playerid][i] = INVALID_PLAYER_ID;
            }
            if(ElectricParty[playerid] != INVALID_PLAYER_ID)
            {
                new scdplayerid = ElectricParty[playerid];
                if(IsPlayerConnected(scdplayerid))
                {
                    for(new i = 0; i < 3; i++)
                    {
                        if(ElectricMembersParty[scdplayerid][i] == playerid)
                        {
                            SendInfo(scdplayerid, "%s [%d] ��������(-�) ������� ����, �� ������ �� ��������� ���������.", get_name(playerid), playerid);
                            ElectricMembersParty[scdplayerid][i] = INVALID_PLAYER_ID;
                        }
                    }
                }
                ElectricParty[playerid] = INVALID_PLAYER_ID;
            }
        }
        case OIL_WORK:
        {
            for(new i = 0; i < 25; i++)
            {
                if(p_temp[playerid][oil_object][i] != INVALID_OBJECT_ID)
                {
                    DestroyDynamicObject(p_temp[playerid][oil_object][i]);
                    p_temp[playerid][oil_object][i] = INVALID_OBJECT_ID;
                }
            }
        }
        case TREASURE_HUNTER_WORK:
        {
            GangZoneHideForPlayer(playerid, treasure_hunter_zone);
        }
    }

    DisablePlayerRaceCheckpoint(playerid);
    DisablePlayerCheckpoint(playerid);
    Fix_TogglePlayerControllable(playerid, true);

    p_temp[playerid][Work_ID] = NONE_WORK;

    if(type == 0 && change_skin == true) SetPlayerSkinEx(playerid);

    ClearAnimations(playerid);
    //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);

    //for(new i; i < 3; i++) AntiCheatWarningTime[playerid][i] = 0;

    HideTextDrawForPlayer(playerid, TD_ID_SALARY);

    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);

    for(new i = 0; i < 25; i++)
    {
        if(i < 2 && p_temp[playerid][PanelObject][i] != INVALID_OBJECT_ID)
        {
            DestroyDynamicObject(p_temp[playerid][PanelObject][i]);
            p_temp[playerid][PanelObject][i] = INVALID_OBJECT_ID;
        }
        if(i < 5 && p_temp[playerid][FarmObject][i] != INVALID_OBJECT_ID)
        {
            DestroyDynamicObject(p_temp[playerid][FarmObject][i]);
            p_temp[playerid][FarmObject][i] = INVALID_OBJECT_ID;
        }
        if(i < 5 && p_temp[playerid][roadman_object][i] != INVALID_OBJECT_ID)
        {
            DestroyDynamicObject(p_temp[playerid][roadman_object][i]);
            p_temp[playerid][roadman_object][i] = INVALID_OBJECT_ID;
        }
        if(p_temp[playerid][oil_object][i] != INVALID_OBJECT_ID)
        {
            DestroyDynamicObject(p_temp[playerid][oil_object][i]);
            p_temp[playerid][oil_object][i] = INVALID_OBJECT_ID;
        }
    }

    p_temp[playerid][ExitCarTimer] = false;

    if(IsValidVehicle(rent_vehicleid) && IsPlayerRentedVehicle(playerid, rent_vehicleid) && veh_info[rent_vehicleid][v_loading] > 0)
    {
        veh_info[rent_vehicleid][v_loading] = 0;
        veh_info[rent_vehicleid][v_loading_playerid] = INVALID_PLAYER_ID;
        if(veh_info[rent_vehicleid][v_pickup] != -1)
        {
            DestroyDynamicPickup(veh_info[rent_vehicleid][v_pickup]);
            veh_info[rent_vehicleid][v_pickup] = -1;
        }
        if(veh_info[rent_vehicleid][v_text] != INVALID_3DTEXT_ID)
        {
            Delete3DTextLabel(veh_info[rent_vehicleid][v_text]);
            veh_info[rent_vehicleid][v_text] = INVALID_3DTEXT_ID;
        }
    }

    if(IsValidVehicle(rent_vehicleid) && IsPlayerRentedVehicle(playerid, rent_vehicleid) && (veh_info[rent_vehicleid][v_npoType] == NPO_JOB || veh_info[rent_vehicleid][v_temp_job] >= JOB_BUS))
    {
        veh_info[rent_vehicleid][v_temp_job] = 0;
        veh_info[rent_vehicleid][v_rented_ID] = INVALID_MYSQL_ID;
        veh_info[rent_vehicleid][v_used_key_ID] = INVALID_PLAYER_ID;
        if(checkworkcar == 0) SetVehicleToRespawn(rent_vehicleid);
        p_temp[playerid][rented_veh] = INVALID_VEHICLE_ID;
    }

    AttachToPlayerAccOrCostume(playerid, INVALID_PLAYER_ID);
    return 1;
}

distance_chat(playerid,Float:Radi=10.0,color,text[])
{
    new Float:pos[3];
    GetPlayerPos(playerid,pos[0],pos[1],pos[2]);
    foreach(new i: Player)
    {
        if(!p_info[i][loggedIn]) continue;
        if(IsPlayerInRangeOfPoint(i,Radi,pos[0],pos[1],pos[2])) if(GetPlayerVirtualWorld(i) == GetPlayerVirtualWorld(playerid) && GetPlayerInterior(playerid) == GetPlayerInterior(i) && p_temp[i][premiumgamer] != PREMIUM_GAME) SendMes(i, color, text);
    }
}

///gang capture 2.0
forward CaptureTimers(i);
public CaptureTimers(i)
{
    if(Capture_Info[i][gStatus] != GANG_ZONE_NONE)
    {
        if(Capture_Info[i][gTime] > 0)
        {
            Capture_Info[i][gTime]--;
            foreach(new playerid: Player)
            {
                if(Capture_Info[i][gFaction][0] != p_info[playerid][member] && Capture_Info[i][gFaction][1] != p_info[playerid][member]) continue;
                CaptureInfoUpdate(playerid, CAPTURE_ID_GANG, i, false);
            }
            if(Capture_Info[i][gTime] == 0)
            {
                if(Capture_Info[i][gStatus] == GANG_ZONE_PREPARATION)
                {
                    Capture_Info[i][gStatus] = GANG_ZONE_CAPTURE;
                    Capture_Info[i][gTime] = (60*20);
                    SendFractionMessage(Capture_Info[i][gFaction][0], 0x33CC66FF, "[F] ���������� �����������, ������� ������ ����������.");
                    SendFractionMessage(Capture_Info[i][gFaction][1], 0x33CC66FF, "[F] ���������� �����������, ������� ������ ����������.");
                }
            }
            SetTimerEx("CaptureTimers",1000,false, "i", i);
        }
        else
        {
            STRING_GLOBAL[0] = EOS;
            if((Capture_Info[i][gCount][0] > Capture_Info[i][gCount][1]) || (!Capture_Info[i][gCount][0] && !Capture_Info[i][gCount][1]))
            {
                GangZone_Info[Capture_Info[i][gGangZoneID]][g_Fraction] = Capture_Info[i][gFaction][0];

                f(STRING_GLOBAL, "[F] \"%s\" �������� ������ ���������� \"%s\".",GetFractionName(Capture_Info[i][gFaction][0]), GetFractionName(Capture_Info[i][gFaction][1]));

                GangCountTerritory[Capture_Info[i][gFaction][0]-10]++;
                GangCountTerritory[Capture_Info[i][gFaction][1]-10]--;

                UpdateInfoFractionWarehouse(Capture_Info[i][gFaction][0]);
                UpdateInfoFractionWarehouse(Capture_Info[i][gFaction][1]);

                if(Capture_Info[i][gGangZoneID] == 39)
                {
                    DrugDenInfo[ddOwner] = Capture_Info[i][gFaction][0];
                    SaveDrugDen();
                }
            }
            else if((Capture_Info[i][gCount][0] < Capture_Info[i][gCount][1]) || (Capture_Info[i][gCount][0] == Capture_Info[i][gCount][1]))
            {
                GangZone_Info[Capture_Info[i][gGangZoneID]][g_Fraction] = Capture_Info[i][gFaction][1];

                f(STRING_GLOBAL, "[F] \"%s\" �������� ���������� \"%s\".", GetFractionName(Capture_Info[i][gFaction][1]), GetFractionName(Capture_Info[i][gFaction][0]));
            }
            SendFractionMessage(Capture_Info[i][gFaction][0], 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(Capture_Info[i][gFaction][1], 0x33CC66FF, STRING_GLOBAL);

            new best_id[4];

            foreach(new playerid : Player)
            {
                if(Capture_Info[i][gFaction][0] != p_info[playerid][member] && Capture_Info[i][gFaction][1] != p_info[playerid][member]) continue;
                if(p_temp[playerid][CaptureBizWarInfoInt][0] > p_temp[best_id[0]][CaptureBizWarInfoInt][0]) best_id[0] = playerid;
                if(p_temp[playerid][CaptureBizWarInfoInt][1] > p_temp[best_id[1]][CaptureBizWarInfoInt][1]) best_id[1] = playerid;
                if(p_temp[playerid][CaptureBizWarInfoFloat][0] > p_temp[best_id[2]][CaptureBizWarInfoFloat][0]) best_id[2] = playerid;
                if(p_temp[playerid][CaptureBizWarInfoFloat][1] > p_temp[best_id[3]][CaptureBizWarInfoFloat][1]) best_id[3] = playerid;

                HideTextDrawForPlayer(playerid, TD_ID_CAPTURE);

                if(PlayerFixZone[playerid] != 0)
                {
                    PlayerFixZone[playerid] = 0;
                    GangZoneStopFlashForPlayer(playerid, i);
                }
            }

            STRING_GLOBAL[0] = EOS;
            if(best_id[0] == 0) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] ������ ����� �� ������� �� ��������� �� ���������.");
            else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] ������ ����� �� ������� �� ��������� %s [%d] (%s). ����������: %d.", get_name(best_id[0]), best_id[0], GetFractionName(p_info[best_id[0]][member]), p_temp[best_id[0]][CaptureBizWarInfoInt][0]);
            SendFractionMessage(Capture_Info[i][gFaction][0], 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(Capture_Info[i][gFaction][1], 0x33CC66FF, STRING_GLOBAL);
            STRING_GLOBAL[0] = EOS;
            if(best_id[1] == 0) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] ������ ����� �� ������� �� ������� �� ���������.");
            else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] ������ ����� �� ������� �� ������� %s [%d] (%s). ����������: %d.", get_name(best_id[1]), best_id[1], GetFractionName(p_info[best_id[1]][member]), p_temp[best_id[1]][CaptureBizWarInfoInt][1]);
            SendFractionMessage(Capture_Info[i][gFaction][0], 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(Capture_Info[i][gFaction][1], 0x33CC66FF, STRING_GLOBAL);
            STRING_GLOBAL[0] = EOS;
            if(best_id[2] == 0) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] ������ ����� �� ������� �� ����������� ����� �� ���������.");
            else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] ������ ����� �� ������� �� ����������� ����� %s [%d] (%s). ����������: %0.2f.", get_name(best_id[2]), best_id[2], GetFractionName(p_info[best_id[2]][member]), p_temp[best_id[2]][CaptureBizWarInfoFloat][0]);
            SendFractionMessage(Capture_Info[i][gFaction][0], 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(Capture_Info[i][gFaction][1], 0x33CC66FF, STRING_GLOBAL);
            STRING_GLOBAL[0] = EOS;
            if(best_id[3] == 0) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] ������ ����� �� ������� �� ����������� ����� �� ���������.");
            else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] ������ ����� �� ������� �� ����������� ����� %s [%d] (%s). ����������: %0.2f.", get_name(best_id[3]), best_id[3], GetFractionName(p_info[best_id[3]][member]), p_temp[best_id[3]][CaptureBizWarInfoFloat][1]);
            SendFractionMessage(Capture_Info[i][gFaction][0], 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(Capture_Info[i][gFaction][1], 0x33CC66FF, STRING_GLOBAL);

            GangZoneStopFlashForAll(GangZone_Info[Capture_Info[i][gGangZoneID]][gID]);
            GangZoneHideForAll(GangZone_Info[Capture_Info[i][gGangZoneID]][gID]);
            GangZoneShowForAll(GangZone_Info[Capture_Info[i][gGangZoneID]][gID], fraction_color[GangZone_Info[Capture_Info[i][gGangZoneID]][g_Fraction]]);
            save_gz(Capture_Info[i][gGangZoneID]);

            if(Capture_Info[i][gGangZoneID] == 39)
            {
                DrugDenInfo[ddCapture] = timestamp * (86400 * 3);
                SaveDrugDen();
            }
            Capture_Info[i][gGangZoneID] = INVALID_CRIMINAL_ZONE_ID;

            SetFractionSettings(Capture_Info[i][gFaction][0], fFreezeCapture, 0);
            SetFractionSettings(Capture_Info[i][gFaction][1], fFreezeCapture, 0);
            SetGangPC(Capture_Info[i][gFaction][0], INVALID_MYSQL_ID);
            SetGangPC(Capture_Info[i][gFaction][1], INVALID_MYSQL_ID);

            Capture_Info[i][gCount][0] = 0;
            Capture_Info[i][gCount][1] = 0;
            //Capture_Info[i][gTime][1] = timestamp+(60*50);
            Capture_Info[i][gStatus] = GANG_ZONE_NONE;//

            Capture_Info[i][gFaction][0] = 0;
            Capture_Info[i][gFaction][1] = 0;

            
        }
    }
}

IsPlayerToSquare(playerid, Float:min_x, Float:min_y, Float:max_x, Float:max_y) {
    new Float:pX1,Float:pY1,Float:pZ1;
    GetPlayerPos(playerid,pX1,pY1,pZ1);
    if((pX1 <= max_x && pX1 >= min_x) && (pY1 <= max_y && pY1 >= min_y)) return 1;
    return 0;
}

IsPlayerCaptureZone(playerid, Float:min_x, Float:min_y, Float:max_x, Float:max_y) {
    new Float:pX1,Float:pY1,Float:pZ1;
    GetPlayerPos(playerid,pX1,pY1,pZ1);

    new Float:width = max_x-min_x,
        Float:height = max_y-min_y;

    min_x = min_x - width/2;
    min_y = min_y - height/2;
    max_x = max_x + width/2;
    max_y = max_y + height/2;

    if((pX1 <= max_x && pX1 >= min_x) && (pY1 <= max_y && pY1 >= min_y)) return 1;
    return 0;
}

GetGangZoneID(playerid)
{
    new gangzoneid = p_temp[playerid][CriminalZoneID];
    if(gangzoneid != INVALID_CRIMINAL_ZONE_ID && !IsPlayerInDynamicArea(playerid, GangZone_Info[gangzoneid][g_Area]))
        gangzoneid = INVALID_CRIMINAL_ZONE_ID;

    return gangzoneid;
}

GetZonaName(Float:x, Float: y)
{
    for(new i = sizeof(gSAZones)-1; i != -1; i--)
    {
        if(x >= gSAZones[i][SAZONE_AREA][0] && x <= gSAZones[i][SAZONE_AREA][3] && y >= gSAZones[i][SAZONE_AREA][1] && y <= gSAZones[i][SAZONE_AREA][4])
            return i;
    }
    return 1;
}
GetCityName(Float: x,  Float: y)
{
    for(new i = sizeof(gSAZonesCity)-1; i != -1; i--)
    {
        if(x >= gSAZonesCity[i][SAZONE_AREA][0] && x <= gSAZonesCity[i][SAZONE_AREA][3] && y >= gSAZonesCity[i][SAZONE_AREA][1] && y <= gSAZonesCity[i][SAZONE_AREA][4])
            return i;
    }
    return 1;
}

GetPlayer2DZone(playerid, zone[], len)
{
    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);
    for(new i = MAX_ZONE_COUNT-1; i != -1; i--)
    {
        if(x >= gSAZones[i][SAZONE_AREA][0] && x <= gSAZones[i][SAZONE_AREA][3] && y >= gSAZones[i][SAZONE_AREA][1] && y <= gSAZones[i][SAZONE_AREA][4])
            return format(zone, len, gSAZones[i][SAZONE_NAME], 0);
    }
    return 0;
}

MENU_BIZ(playerid, bizz_id)
{
    if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return 1;
    if(p_info[playerid][exchangePartner] != INVALID_PLAYER_ID) return 1;
    new str[13];
    STRING_GLOBAL[0] = EOS;
    new till = b_info[bizz_id][_till];
    SetPVarInt(playerid, "bID", bizz_id);
    SetPVarInt(playerid, #BIZZ_TYPE_ID, b_info[bizz_id][_tip]);
    switch(b_info[bizz_id][_tip])
    {
        case B_SUPERMARKET:
        {
            f(STRING_GLOBAL,
                ""I"[1]"W" �������: Motorola DynaTAC (%d$)\n\
                "I"[2]"W" �������� ����� �������� (%d$)\n\
                "I"[3]"W" ������� (%d$ - 1 ��.)\n\
                "I"[4]"W" ����� (%d$ - 1 ��.)\n\
                "I"[5]"W" �������� (%d$ - 1 ��.)\n\
                "I"[6]"W" ������ (%d$)\n\
                "I"[7]"W" ������� �������� � ������� (%d$)\n\
                "I"[8]"W" ������ ��� ������������� �������� (%d$)\n\
                "I"[9]"W" ������ (%d$ - 1 ��.)\n\
                "I"[10]"W" ������ (%d$)\n\
                "I"[11]"W" ���������� ����� (50000$)\n\
                "I"[12]"W" ������ ����� ������ (5000$)", 2500 * till, 1000 * till, 300 * till, 500 * till, 250 * till, 10000 * till, 2500 * till, 20000 * till, 1000 * till, 250 * till);
        }
        case B_SHOP:
        {
            if(p_info[playerid][fwork] == true && p_info[playerid][member] != NONE_FRACTION)
            {
                if(p_info[playerid][fskin] == 252)
                {
                    SetPlayerFractionSkin(playerid);
                    save_player(playerid);
                    return 1;
                }
                else
                {
                    SendError(playerid, "�� �������� �� �������, ������������ ������ ����������.");
                    return 1;
                }
            }
            /*
            new Float:P_pos[4];
            GetPlayerPos(playerid, P_pos[0], P_pos[1], P_pos[2]);
            GetPlayerFacingAngle(playerid,P_pos[3]);
            SetPlayerCameraPos(playerid, P_pos[0] + 0.7*-floatsin(P_pos[3],degrees), P_pos[1] + 0.7*floatcos(P_pos[3],degrees), P_pos[2] + 0.5);
            SetPlayerCameraLookAt(playerid,P_pos[0], P_pos[1], P_pos[2]);
            */

            // Fix_TogglePlayerControllable(playerid, false);
            // SetPlayerPos(playerid,210.4674,-33.0304,1001.9297);
            // SetPlayerFacingAngle(playerid,123.6620);
            //SendInfo(playerid, "�����: /next | �����: /back | ����������: /buy | ������: /cancelbuy");
            SetPlayerSkin(playerid, (p_info[playerid][sex] == 2) ? (ItemsInfo[skinBuyMan[p_temp[playerid][shop_id]]][iModel]) : ( ItemsInfo[skinBuyMale[p_temp[playerid][shop_id]]][iModel]));
            format(str,sizeof(str),"%d$",(p_info[playerid][sex] == 2) ? (ItemsInfo[skinBuyMan[p_temp[playerid][shop_id]]][iPrice]) : (ItemsInfo[skinBuyMale[p_temp[playerid][shop_id]]][iPrice]));

            ShowTextDrawForPlayer(playerid, TD_ID_SHOP);
            PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], str);

            p_temp[playerid][shop_id] = 0;
            return 1;
        }
        case B_BAR:
        {
            f(STRING_GLOBAL, ""I"[1]"W" ���� (%d$)\n"I"[2]"W" ���� (%d$)\n"I"[3]"W" ������ (%d$)\n"I"[4]"W" ����� (%d$)", 500 * till, 1000 * till, 1500 * till, 2000 * till);
        }
        case B_AMMO:
        {
            if(p_info[playerid][level] < 3) return SendError(playerid, "� ��� ��� 3-�� ������.");
            if(p_info[playerid][Lic][LIC_WEAPON] != 1) return SendError(playerid, "� ��� ��� �������� �� \"%s\".", name_license[LIC_WEAPON]);

            for (new i, j = sizeof(shopWEAPON); i < j; i++)
                f(STRING_GLOBAL, "%s"I"[%d]"W" %s (������ - %i, ���� - %i$)\n", STRING_GLOBAL, i+1, WEAPON_Name[shopWEAPON[i][g_Id]], shopWEAPON[i][g_Patr], shopWEAPON[i][g_Price] * till);
        }
        case B_EAT:
        {
            f(STRING_GLOBAL, ""I"[1]"W" ������� (%d$)\n"I"[2]"W" ������ (%d$)", 500 * till, 250 * till);
        }
        case B_REALTOR:
        {
            ShowPlayerDialog(playerid, D_REALTOR, DIALOG_STYLE_LIST, ""I"����������� ���������", "\
                "I"[1]"W" ������ ��������� ���� (2500$)\n\
                "I"[2]"W" ������ ��������� ������� (5000$)\n\
                "I"[3]"W" ������ ����, ������� ����� ����������� (1250$)\n\
                "I"[4]"W" ������ �������, ������� ����� ����������� (2500$)\n\
                "I"[5]"W" ������� �����\n\
                "I"[6]"W" ������� ��������", "�����", "������");
            return 1;
        }
        case B_GYM:
        {
            if(GetPVarInt(playerid, "GymTrainingStyde"))
            {
                LeaveFromGym(playerid);
                SetTimerEx("FIX_GYM", 1100, 0, "i", playerid);
            }
            else if(p_info[playerid][style_styde] && GetPVarInt(playerid, "GymTrainingStyde") == 0)
            {
                SetPVarInt(playerid, "GymTrainingStyde", true);
                SendAccess(playerid, "�� ������ ����������.");
                SendInfo(playerid, "����������� ������������� � ������ ��� �������� ����� ���.");

                new rskins[2] = {81, 80};
                SetPlayerSkin(playerid, rskins[random(2)]);
                SetPlayerFightingStyle(playerid, p_info[playerid][style_styde]+4);

                SetPlayerPos(playerid, 762.6852,5.6262,1000.7128);
                SetPlayerFacingAngle(playerid, 272.4190);
                SetCameraBehindPlayer(playerid);

                SetTimerEx("FIX_GYM", 1100, 0, "i", playerid);
            }
            else f(STRING_GLOBAL, ""I"[1]"W" �������� ����������� ����� (%d$)\n"I"[2]"W" �������� ����-�� (%d$)\n"I"[3]"W" �������� ����-���-�� (%d$)", SET_GYM_BOXING, SET_GYM_KUNGFU, SET_GYM_KNEEHEAD);
        }
        case B_ACCESSORIES:
        {
