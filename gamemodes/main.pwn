        return 1;
    }
    else if(pickupid == FamilyPickup[2]) // (Гараж);
    {
        if(GetPlayerVirtualWorld(playerid) == p_temp[playerid][parking_id]+5000)
        {
            new park_id = p_temp[playerid][parking_id];
            p_temp[playerid][parking_id] = -1;
            SetPlayerPos(playerid, ParkData[park_id][p_enter][0], ParkData[park_id][p_enter][1], ParkData[park_id][p_enter][2]); //улица
            SetPlayerFacingAngle(playerid, ParkData[park_id][p_enter][3]);
            SetPlayerInterior(playerid, 0);
            SetPlayerVirtualWorld(playerid, 0);
        }
        else if(GetPlayerVirtualWorld(playerid) == 5500)
        {
            SetPlayerPos(playerid, 1087.2070,-1375.6184,13.5087);
            SetPlayerFacingAngle(playerid, 270.0000);
            SetPlayerInterior(playerid, 0);
            SetPlayerVirtualWorld(playerid, 0);
        }
        else ShowPlayerDialog(playerid, D_FAMILY_GARAGE, DIALOG_STYLE_LIST, ""I"Куда выйти?", ""I"[1]"W" Внутрь\n"I"[2]"W" На улицу", "Выбрать", "Отмена");
        return 1;
    }
    else if(pickupid == FamilyPickup[3]) // (Контракты);
    {
        ShowFamilyContracts(playerid);
        return 1;
    }
    if(pickupid >= PickPickup[0] && pickupid <= PickPickup[5])
    {
        if(Pick == false) return SendError(playerid, "В штате нет выборов.");
        if(p_info[playerid][level] < 3) return SendError(playerid, "Принимать участие в выборах можно с 3-его уровня.");
        if(p_info[playerid][pick] > 0) return SendError(playerid, "Вы уже голосовали на этих выборах.");
        new total = 0;
        STRING_GLOBAL[0] = EOS;
        for(new i; i < 7; i++)
        {
            if(strcmp(PickName[i], "None", false))
            {
                f(STRING_GLOBAL, "%s"I"[%d]"W" %s\n", STRING_GLOBAL, i+1, PickName[i]);
                total++;
            }
        }
        if(total == 0) strcat(STRING_GLOBAL, "Кандидатов нет."), ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Выборы", STRING_GLOBAL, "Отмена", "");
        else ShowPlayerDialog(playerid, D_PICK, DIALOG_STYLE_LIST, ""I"Выборы", STRING_GLOBAL, "Далее", "Отмена");
        return 1;
    }
    if(pickupid == WarehousePickup[0])
    {
        if(army(playerid) || gang(playerid) || mafia(playerid) || biker(playerid))
        {
            if(p_temp[playerid][LoadCount] != 0) return SendError(playerid, "У Вас уже есть ящик с патронами и материалами, отнесите его в транспортное средство.");

            if(GetFractionWarehouse(NATIONAL_GUARD, fwMate) < 500) return SendError(playerid, "На складе нет столько материалов.");
            if(GetFractionWarehouse(NATIONAL_GUARD, fwPatron) < 500) return SendError(playerid, "На складе нет столько патронов.");

            SetPlayerAttachedObject(playerid, 1, 2358, 6, 0.0, 0.10, -0.2, -110.0, 0.0, 78.0, 1.000000, 1.000000, 1.000000);
            ClearAnimations(playerid);
            ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 1, 0, 0, 1, 1);
            //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);

            SetFractionWarehouse(NATIONAL_GUARD, fwMate, -500);
            SetFractionWarehouse(NATIONAL_GUARD, fwPatron, -500);

            UpdateWarehouseInfo(0);

            p_temp[playerid][LoadCount] = 1;

            SendAccess(playerid, "Вы взяли ящик с патронами и материалами, отнесите его в транспортное средство.");
            SendInfo(playerid, "Чтобы выбросить ящик, введите /end");
        }
        else SendError(playerid, "Вы не можете пользоваться данным складом.");
        return 1;
    }
    if(pickupid == WarehousePickup[1])
    {
        if(p_info[playerid][member] == 0) return SendError(playerid, "Вы не состоите во фракции.");
        if(GetFactionType(p_info[playerid][member]) != FACTION_TYPE_GOS) return SendError(playerid, "Вы не состоите в гос. фракции.");
        if(p_info[playerid][rang] < 9) return SendError(playerid, "Создание гос. контрактов на поставку патронов и материалов доступно лидерам и заместителям.");
        if(army(playerid)) return SendError(playerid, "Для Вашей организации недоступны гос. контракты.");
        ShowWarehouseInfo(playerid);
        return 1;
    }
    if(pickupid == WarehousePickup[2])
    {
        if(IsPlayerFractionMedic(playerid))
        {
            if(p_temp[playerid][LoadCount] != 0) SendError(playerid, "У Вас уже есть мешок с медикаментами.");
            else
            {
                if(WarehouseMedicines < 500) return SendError(playerid, "На складе нет столько медикаментов.");

                SetPlayerAttachedObject(playerid, 1, 1279, 6, 0.0, 0.10, -0.2, -110.0, 0.0, 78.0, 1.000000, 1.000000, 1.000000);
                ClearAnimations(playerid);
                ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 1, 0, 0, 1, 1);
                //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);

                WarehouseMedicines -= 500;
                MysqlUpdateOtherInt("warehouse_medicines", WarehouseMedicines);

                UpdateWarehouseInfo(1);

                p_temp[playerid][LoadCount] = 1;

                SendAccess(playerid, "Вы взяли мешок с медикаментами, отнесите его в транспортное средство.");
                SendInfo(playerid, "Чтобы выбросить мешок, введите /end");
            }
        }
        else SendError(playerid, "Вы не можете пользоваться данным складом.");
        return 1;
    }
    return 1;
}

public OnPlayerPickUpPickup(playerid, pickupid)
{
    if(p_info[playerid][loggedIn] != 1) return 0;
    //SendDebug(playerid, "event Pickup id %d | old: %d | dynamic: %d", pickupid, p_temp[playerid][OldPickupID], p_temp[playerid][EventPickupID]);

    if(p_temp[playerid][OldPickupID] == pickupid) return 1;
    p_temp[playerid][OldPickupID] = pickupid;
    if(p_temp[playerid][EventPickupID] != -1) return 1;
    if(GetTickCount() - p_temp[playerid][TickPickup] < 15000)
        return 1;
    p_temp[playerid][TickPickup] = GetTickCount();
    GetPlayerPos(playerid, p_temp[playerid][PickupPosX], p_temp[playerid][PickupPosY], p_temp[playerid][PickupPosZ]);

    if(pickupid == pickup_drugden[2])
    {
        ShowDrugDenMenu(playerid, TYPE_DRUGDEN_MAIN);
        return 1;
    }

    if(pickupid == pickup_drugden[3])
    {
        ShowDrugDenMenu(playerid, TYPE_DRUGDEN_STREET);
        return 1;
    }

    if(pickupid == pickup_fish)
    {
        ShowFishMenu(playerid, MENU_FISH_MAIN);
        return 1;
    }

    if(pickupid == pickup_hunting)
    {
        ShowDialogHunting(playerid, HUNTING_MENU);
        return 1;
    }

    if(pickupid == pickup_change_civil_coins)
    {
        ShowChangeCivilCoins(playerid);
        return 1;
    }

    if(pickupid >= pickup_mission[0] && pickupid <= pickup_mission[3])
    {
        ShowPlayerMission(playerid, MISSION_TYPE_START_TASK, 0);
        return 1;
    }

    if(pickupid == pickup_top)
    {
        ShowPlayerDialog(playerid, D_TOP, DIALOG_STYLE_LIST, ""I"ТОП", "\
        "I"[1]"W" Обычный\n\
        "I"[2]"W" Фракционный", "Далее", "Отмена");
        return 1;
    }

    if(pickupid == pickup_lvpd[0])
    {
        if(gos(playerid))
        {
            SetPlayerPos(playerid, 2343.3806,2458.1057,14.9688);
            SetPlayerFacingAngle(playerid, 180.0000);
        }
        return 1;
    }
    if(pickupid == pickup_lvpd[1])
    {
        if(gos(playerid))
        {
            SetPlayerPos(playerid, 2277.8828,2460.1050,38.6837);
            SetPlayerFacingAngle(playerid, 0.0000);
        }
        return 1;
    }

    if(pickupid == pickup_lva[0])
    {
        if(gos(playerid) || p_info[playerid][member] == NATIONAL_GUARD && p_info[playerid][fwork] == false)
        {
            SetPlayerPos(playerid, 99.4711, 1920.8563, 18.2364);
            SetPlayerFacingAngle(playerid, 270.0000);
        }
        return 1;
    }
    if(pickupid == pickup_lva[1])
    {
        if(gos(playerid) || p_info[playerid][member] == NATIONAL_GUARD && p_info[playerid][fwork] == false)
        {
            SetPlayerPos(playerid, 92.2584, 1920.8887, 18.0054);
            SetPlayerFacingAngle(playerid, 90.0000);
        }
        return 1;
    }

    if(pickupid == rs_pickup[0]) // Real Skin (Вход);
    {
        SetPlayerInterior(playerid, 15);
        SetPlayerVirtualWorld(playerid, 2023);
        SetPlayerPos(playerid, 207.6525,-108.8663,1005.1328);
        SetPlayerFacingAngle(playerid, 0.0);
        SetCameraBehindPlayer(playerid);
        return 1;
    }
    else if(pickupid == rs_pickup[1]) // Real Skin (Выход);
    {
        SetPlayerSkinEx(playerid);
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        SetPlayerPos(playerid, 479.9583,-1534.1165,19.6490);
        SetPlayerFacingAngle(playerid, 290.0);
        SetCameraBehindPlayer(playerid);
    }

    if(pickupid == drug_work)
    {
        if(!gang(playerid) && !mafia(playerid) && !biker(playerid)) return SendError(playerid, "Вы не можете пользоваться этой командой.");
        if(p_temp[playerid][Work_ID] == DRUG_WORK) return EndPlayerJob(playerid);
        StartPlayerJob(playerid, DRUG_WORK);
    }
    if(pickupid == tram_pickup)
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != TRAM_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
        if(p_info[playerid][job] != JOB_TRAM) return SendError(playerid, "Вы не работаете водителем трамвая.");
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы желаете %s рабочий день?", p_temp[playerid][Work_ID] != TRAM_WORK ? ("{"#cGREEN"}начать"W"") : ("{"#cLIGHTRED"}завершить"W""));
        ShowPlayerDialog(playerid, D_DUTY_TRAM, DIALOG_STYLE_MSGBOX, ""I"Водитель трамвая", STRING_GLOBAL, "Далее", "Отмена");
        return 1;
    }
    if(pickupid == laboratory_pickup[0]) // Лаборатория (Вход);
    {
        if(GetFactionType(p_info[playerid][member]) != FACTION_TYPE_GOS && p_temp[playerid][keys_door] != MEDIC_LS && p_temp[playerid][keys_door] != MEDIC_SF && p_temp[playerid][keys_door] != MEDIC_LV && p_info[playerid][member] != FBI_TEAM)
            return SendError(playerid, "У Вас нет ключей от этих дверей.");
        SetPlayerInterior(playerid, 1);
        SetPlayerVirtualWorld(playerid, 1);
        SetPlayerPos(playerid, 2714.7585,746.2165,1024.4215);
        SetPlayerFacingAngle(playerid, 177.0842);
        SetCameraBehindPlayer(playerid);
    }
    else if(pickupid == laboratory_pickup[1]) // Лаборатория (Выход);
    {
        if(p_temp[playerid][Work_ID] == LABORATORY_WORK) return SendError(playerid, "Вы не закончили рабочий день.");
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        SetPlayerPos(playerid, 1350.3611,349.1705,20.2478);
        SetPlayerFacingAngle(playerid, 67.0670);
        SetCameraBehindPlayer(playerid);
        return 1;
    }
    else if(pickupid == laboratory_pickup[2]) // Лаборатория (Раздевалка);
    {
        if(!IsPlayerFractionMedic(playerid)) return SendError(playerid, "Вы не состоите в Больнице ЛС, СФ и ЛВ.");
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != LABORATORY_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
        STRING_MIN[0] = EOS;
        format(STRING_MIN, sizeof(STRING_MIN), ""W"Вы желаете %s рабочий день?", (p_temp[playerid][Work_ID] != LABORATORY_WORK) ? ("{"#cGREEN"}начать"W"") : ("{"#cLIGHTRED"}завершить"W""));
        ShowPlayerDialog(playerid, D_DUTY_LABORATORY, DIALOG_STYLE_MSGBOX, ""I"Лаборатория", STRING_MIN, "Далее", "Отмена");
    }
    else if(pickupid == laboratory_pickup[3]) // Лаборатория (Склад);
    {
        if(!IsPlayerFractionMedic(playerid)) return SendError(playerid, "Вы не состоите в Больнице ЛС, СФ и ЛВ.");
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != LABORATORY_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
        if(p_temp[playerid][Work_ID] != LABORATORY_WORK) return SendError(playerid, "Вы не начали рабочий день.");

        if(p_temp[playerid][LaboratoryCheck] == 0) return SendError(playerid, "Вы не изготовили медикаменты.");

        new amount = p_temp[playerid][LaboratoryCheck], salary = amount / 2;

        SetPlayerMoney(playerid, salary, true, "зарплата в лаборатории");
        OnServerInfoForMoney[16] += salary;

        p_temp[playerid][LaboratorySalary] += salary;
        SendMes(playerid, COLOR_LYELLOW, "К Вашей зарплате добавлено: {"#cLIME"}%d$.{"#cLYELLOW"} Заработано всего: {"#cLIME"}%d$.", salary, p_temp[playerid][LaboratorySalary]);
        p_temp[playerid][LaboratoryCount] += p_temp[playerid][LaboratoryCheck];
        p_temp[playerid][LaboratoryCheck] = 0;

        ClearAnimations(playerid);
        ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);

        STRING_GLOBAL[0] = EOS;
        if(p_info[playerid][p_settings][INTERFACE])
        {
            f(STRING_GLOBAL, "%d", p_temp[playerid][LaboratoryCount]);
            PlayerTextDrawSetString(playerid, PTD_NewSalary[playerid][2], STRING_GLOBAL);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d$", p_temp[playerid][LaboratorySalary]);
            PlayerTextDrawSetString(playerid, PTD_NewSalary[playerid][1], STRING_GLOBAL);
        }
        else
        {
            f(STRING_GLOBAL, "Progress: %d", p_temp[playerid][LaboratoryCount]);
            PlayerTextDrawSetString(playerid, PTD_Salary[playerid][5], STRING_GLOBAL);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d$", p_temp[playerid][LaboratorySalary]);
            PlayerTextDrawSetString(playerid, PTD_Salary[playerid][6], STRING_GLOBAL);
        }

        UpdateFamilyLevel(playerid);

        WarehouseMedicines += amount;

        UpdateWarehouseInfo(1);
    }
    if(pickupid == pickup_collector) // Инкассатор (Раздевалка);
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != COLLECTOR_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
        if(p_info[playerid][job] != JOB_COLLECTOR) return SendError(playerid, "Вы не работаете инкассатором.");
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы желаете %s рабочий день?", p_temp[playerid][Work_ID] != COLLECTOR_WORK ? ("{"#cGREEN"}начать"W"") : ("{"#cLIGHTRED"}завершить"W""));
        ShowPlayerDialog(playerid, D_DUTY_COLLECTOR, DIALOG_STYLE_MSGBOX, ""I"Инкассатор", STRING_GLOBAL, "Далее", "Отмена");
    }
    if(pickupid == pickup_electric) // Электрик (Раздевалка);
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != ELECTRIC_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
        if(p_info[playerid][job] != JOB_ELECTRIC) return SendError(playerid, "Вы не работаете электриком.");
        if(p_temp[playerid][Work_ID] == ELECTRIC_WORK) ShowPlayerDialog(playerid, D_DUTY_ELECTRIC, DIALOG_STYLE_MSGBOX, ""I"Электрик", ""W"Вы желаете {"#cLIGHTRED"}завершить"W" рабочий день?", "Далее", "Отмена");
        else ShowPlayerDialog(playerid, D_DUTY_ELECTRIC, DIALOG_STYLE_LIST, ""I"Электрик", ""I"[1]"W" Ремонт ЛЭП\n"I"[2]"W" Ограбление ЛЭП", "Далее", "Отмена");
    }
    if(pickupid == pickup_oil) // Нефтяник (Раздевалка);
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != OIL_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
        if(p_info[playerid][job] != JOB_OIL) return SendError(playerid, "Вы не работаете нефтяником.");
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы желаете %s рабочий день?", p_temp[playerid][Work_ID] != OIL_WORK ? ("{"#cGREEN"}начать"W"") : ("{"#cLIGHTRED"}завершить"W""));
        ShowPlayerDialog(playerid, D_DUTY_OIL, DIALOG_STYLE_MSGBOX, ""I"Нефтяник", STRING_GLOBAL, "Далее", "Отмена");
    }
    if(pickupid == pickup_roadman) // Ремонтник дорог (Раздевалка);
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != ROADMAN_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
        if(p_info[playerid][job] != JOB_ROADMAN) return SendError(playerid, "Вы не работаете ремонтником дорог.");
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы желаете %s рабочий день?", p_temp[playerid][Work_ID] != ROADMAN_WORK ? ("{"#cGREEN"}начать"W"") : ("{"#cLIGHTRED"}завершить"W""));
        ShowPlayerDialog(playerid, D_DUTY_ROADMAN, DIALOG_STYLE_MSGBOX, ""I"Ремонтник дорог", STRING_GLOBAL, "Далее", "Отмена");
    }
    if(pickupid == pickup_panel) // Ремонтник панелей (Раздевалка);
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != PANEL_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
        if(p_info[playerid][job] != JOB_PANEL) return SendError(playerid, "Вы не работаете ремонтником солнечных панелей.");
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы желаете %s рабочий день?", p_temp[playerid][Work_ID] != PANEL_WORK ? ("{"#cGREEN"}начать"W"") : ("{"#cLIGHTRED"}завершить"W""));
        ShowPlayerDialog(playerid, D_DUTY_PANEL, DIALOG_STYLE_MSGBOX, ""I"Ремонтник панелей", STRING_GLOBAL, "Далее", "Отмена");
    }
    if(pickupid == pickup_ghouses) // Тепличный комплекс (Раздевалка);
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != GREEN_HOUSES_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы желаете %s рабочий день?", p_temp[playerid][Work_ID] != GREEN_HOUSES_WORK ? ("{"#cGREEN"}начать"W"") : ("{"#cLIGHTRED"}завершить"W""));
        ShowPlayerDialog(playerid, D_DUTY_GREEN_HOUSES, DIALOG_STYLE_MSGBOX, ""I"Тепличный комплекс", STRING_GLOBAL, "Далее", "Отмена");
    }
    if(pickupid == pickup_robber[0]) // Грабитель (Раздевалка);
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != ROBBER_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
        STRING_MIN[0] = EOS;
        format(STRING_MIN, sizeof(STRING_MIN), ""W"Вы желаете %s рабочий день?", p_temp[playerid][Work_ID] != ROBBER_WORK ? ("{"#cGREEN"}начать"W"") : ("{"#cLIGHTRED"}завершить"W""));
        ShowPlayerDialog(playerid, D_DUTY_ROBBER, DIALOG_STYLE_MSGBOX, ""I"Грабитель", STRING_MIN, "Далее", "Отмена");
        return 1;
    }
    else if(pickupid == pickup_robber[1]) // Грабитель (Заказы);
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != ROBBER_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
        if(p_temp[playerid][Work_ID] != ROBBER_WORK) return SendError(playerid, "Вы не начали рабочий день.");
        new vehicleid = RobberVehicleIDx[playerid];
        if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "У Вас нет арендованного рабочего транспортного средства.");
        if(!IsPlayerRentedVehicle(playerid, vehicleid)) return SendError(playerid, "У Вас нет арендованного рабочего транспортного средства.");
        if(RobberParty[playerid] != INVALID_PLAYER_ID) return SendError(playerid, "Вы работаете совместно с кем-то.");

        SetRobberyHouseCheckpoint(playerid, RobberIDx[playerid]);
        return 1;
    }
    if(pickupid == pickup_car_factory[0])
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != CAR_FACTORY_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
        STRING_MIN[0] = EOS;
        format(STRING_MIN, sizeof(STRING_MIN), ""W"Вы желаете %s рабочий день?", p_temp[playerid][Work_ID] != CAR_FACTORY_WORK ? ("{"#cGREEN"}начать"W"") : ("{"#cLIGHTRED"}завершить"W""));
        ShowPlayerDialog(playerid, D_DUTY_CAR_FACTORY, DIALOG_STYLE_MSGBOX, ""I"Сборщик автомобилей", STRING_MIN, "Далее", "Отмена");
        return 1;
    }
    else if(pickupid == pickup_car_factory[1])
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != CAR_FACTORY_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
        if(p_temp[playerid][Work_ID] != CAR_FACTORY_WORK) return SendError(playerid, "Вы не начали рабочий день.");
        if(CarFactoryCarParts[playerid] == 0) return SendError(playerid, "У Вас уже есть запчасти для сборки ходовой.");
        CarFactoryCarParts[playerid] = 0;
        SendAccess(playerid, "Вы взяли запчасти для сборки ходовой.");
        SendInfo(playerid, "Отправляйтесь на сборку ходовой.");
        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
        if(IsPlayerAttachedObjectSlotUsed(playerid, 2)) RemovePlayerAttachedObject(playerid, 2);
        new parts_object[6] = {1575, 1576, 1577, 1578, 1579, 1580}, idx = random(6);
        SetPlayerAttachedObject(playerid, 1, parts_object[idx], 5, 0.219000, -0.076999, 0.026998, 58.999965, -176.400039, 90.899986, 1.000000, 1.000000, 1.000000);
        SetPlayerAttachedObject(playerid, 2, parts_object[idx], 6, 0.216999, 0.087000, 0.072998, -75.899978, -176.199981, -70.500045, 1.000000, 1.000000, 1.000000);
        return 1;
    }
    else if(pickupid == pickup_car_factory[2])
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != CAR_FACTORY_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
        if(p_temp[playerid][Work_ID] != CAR_FACTORY_WORK) return SendError(playerid, "Вы не начали рабочий день.");
        if(CarFactoryCarParts[playerid] == 1) return SendError(playerid, "У Вас уже есть запчасти для сборки двигателя.");
        CarFactoryCarParts[playerid] = 1;
        SendAccess(playerid, "Вы взяли запчасти для сборки двигателя.");
        SendInfo(playerid, "Отправляйтесь на сборку двигателя.");
        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
        if(IsPlayerAttachedObjectSlotUsed(playerid, 2)) RemovePlayerAttachedObject(playerid, 2);
        new parts_object[6] = {1575, 1576, 1577, 1578, 1579, 1580}, idx = random(6);
        SetPlayerAttachedObject(playerid, 1, parts_object[idx], 5, 0.219000, -0.076999, 0.026998, 58.999965, -176.400039, 90.899986, 1.000000, 1.000000, 1.000000);
        SetPlayerAttachedObject(playerid, 2, parts_object[idx], 6, 0.216999, 0.087000, 0.072998, -75.899978, -176.199981, -70.500045, 1.000000, 1.000000, 1.000000);
        return 1;
    }
    else if(pickupid == pickup_car_factory[3])
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != CAR_FACTORY_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
        if(p_temp[playerid][Work_ID] != CAR_FACTORY_WORK) return SendError(playerid, "Вы не начали рабочий день.");
        if(CarFactoryCarParts[playerid] == 2) return SendError(playerid, "У Вас уже есть запчасти для сборки кузова.");
        CarFactoryCarParts[playerid] = 2;
        SendAccess(playerid, "Вы взяли запчасти для сборки кузова.");
        SendInfo(playerid, "Отправляйтесь на сборку кузова.");
        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
        if(IsPlayerAttachedObjectSlotUsed(playerid, 2)) RemovePlayerAttachedObject(playerid, 2);
