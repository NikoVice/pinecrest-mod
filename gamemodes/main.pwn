                if(gos(playerid)) return SendError(playerid, "�� �� ��������� ������� ����.");
                if(p_temp[playerid][rob_fuel_idx] == -1) return SendError(playerid, "�� �� ���������� � ���������� ���.");
                ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_3);
                return 1;
            }
            if(IsPlayerInDynamicArea(playerid, rob_bank_area[0])) // �����;
            {
                if(GetPlayerFamilyID(playerid) == -1 && !gang(playerid) && !mafia(playerid) && !biker(playerid)) return SendError(playerid, "�� �� �������� � ����� ��� ����������� �����������.");
                if(gos(playerid)) return SendError(playerid, "�� �� ��������� ������� ����.");
                if(p_info[playerid][level] < 20) return SendError(playerid, "����������� � ����������� ����� � 20-��� ������.");
                ShowRobberyBank(playerid, ROBBERY_BANK_NPC_1);
                return 1;
            }
            if(IsPlayerInDynamicArea(playerid, rob_bank_area[1])) // ������;
            {
