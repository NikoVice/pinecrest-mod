            else if(p_info[playerid][rang] == 6) category_id = FACTION_CATEGORY_MEDIC, mayor_rang = 6;
            else if(p_info[playerid][rang] == 7) category_id = FACTION_CATEGORY_ARMY, mayor_rang = 7;
            else if(p_info[playerid][rang] == 8) category_id = FACTION_CATEGORY_PD, mayor_rang = 8;
            else return 1;
        }
        default: return 1;
    }
    if(category_id == -1 || mayor_rang == -1) return 1;
    if(p_info[playerid][member] != MAYOR_LS) f(STRING_GLOBAL, "(( [R] [%s] %s %s[%d]: %s ))", GetFractionName(p_info[playerid][member]), GetPlayerFractionRangName(playerid), get_name(playerid), playerid, params);
    else f(STRING_GLOBAL, "(( [R] [%s] %s[%d]: %s ))", GetPlayerFractionRangName(playerid), get_name(playerid), playerid, params);
    foreach(new targetid : Player)
    {
        if(category_id == FACTION_CATEGORY_PD)
        {
            if(((GetFactionCategory(p_info[targetid][member]) == FACTION_CATEGORY_FBI || GetFactionCategory(p_info[targetid][member]) == FACTION_CATEGORY_PD) && p_info[targetid][fwork] == true) || (p_info[targetid][member] == MAYOR_LS && p_info[targetid][rang] == 8 && p_info[targetid][fwork] == true))
                SendMes(targetid, 0x3399CCFF, STRING_GLOBAL);
        }
        else if((GetFactionCategory(p_info[targetid][member]) == category_id && p_info[targetid][fwork] == true) || (p_info[targetid][member] == MAYOR_LS && p_info[targetid][rang] == mayor_rang && p_info[targetid][fwork] == true))
            SendMes(targetid, 0x3399CCFF, STRING_GLOBAL);
    }
    return 1;
}

CMD:lr(playerid, params[])
{
    if(p_info[playerid][leader] == 0) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(strlen(params) < 1 || strlen(params) > 80) return SendError(playerid, "���-�� �������� � ��������� �� ����� ���� ����� 1 � ����� 80.");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);
    f(STRING_GLOBAL, "[LR] [%s] %s %s[%d]: %s", GetFractionName(p_info[playerid][member]), GetPlayerFractionRangName(playerid), get_name(playerid), playerid, params);
    foreach(new targetid: Player)
    {
        if(p_info[targetid][leader] != 0) SendMes(targetid, 0x3399CCFF, STRING_GLOBAL);
    }
    return 1;
}

CMD:namestore(playerid, params[])
{
    if(p_info[playerid][admin] < 3) return 1;
    if(!(3 <= strlen(params) <= 24)) return SendError(playerid, "����� ��������� ������ ������ ���� �� ����� 3 � �� ����� 24 ��������.");
    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id` FROM `accounts` WHERE `name` = '%e' LIMIT 1", params);
    mysql_tquery(con_bd, STRING_GLOBAL, "OnServerCheckAccountData", "i", playerid);
    return 1;
}

forward OnServerCheckAccountData(playerid);
public OnServerCheckAccountData(playerid)
{
    new string;
    cache_get_row_count(string);
    if(!string) return SendError(playerid, "������ �� �������.");

    new BaseID;
    cache_get_value_name_int(0, "id", BaseID);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `log_name` WHERE `OWNER` = %d",
    BaseID);
    mysql_tquery(con_bd, STRING_GLOBAL, "OnServerCheckNickNameData", "i", playerid);
    return 1;
}

forward OnServerCheckNickNameData(playerid);
public OnServerCheckNickNameData(playerid)
{
    new string;
    cache_get_row_count(string);
    if(!string) return SendError(playerid, "������ �� �������.");

    STRING_GLOBAL[0] = EOS;
    strcat(STRING_GLOBAL, ""W"� ������ ���\t"W"����� ���\t"W"���� ���������\n"W"");

    for(new i; i != string; i ++)
    {
        new old_name[MAX_PLAYER_NAME];
        new new_name[MAX_PLAYER_NAME];
        new str_date[MAX_PLAYER_NAME];

        cache_get_value_name(i, "OLD_NAME", old_name, MAX_PLAYER_NAME);
        cache_get_value_name(i, "NEW_NAME", new_name, MAX_PLAYER_NAME);
        cache_get_value_name(i, "DATA",     str_date, MAX_PLAYER_NAME);

        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{FF0000}%s     {00FF00}%s     "W"%s\n", STRING_GLOBAL, old_name, new_name, str_date);
    }
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"������� ����� ����", STRING_GLOBAL, "�������", "");
    return 1;
}

CMD:uptest(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10) return 1;
    TEST_SYSTEM = !TEST_SYSTEM;
    SendAccess(playerid, "���������.");
    return 1;
}

CMD:wbook(playerid, params[])
{
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "�����������: /wbook [id ������]");
    if(IsPlayerConnected(params[0]) == 0) return SendError(playerid, "����� �� ������.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "����� ������� ������ �� ���.");

    if(params[0] == playerid)
    {
        ShowWBook(playerid, playerid);
        MeAction(playerid, "������(-�) �������� ����� � ������������� ��");
    }
    else
    {
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL, ""W"�� ������ ����������"I"%s "W"���������� ���� �������� �����.", get_name(params[0]));
        ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"�������� �����.", STRING_GLOBAL, "�����", "������");
        SetOfferData(playerid, params[0], OFFER_ID_SHOW_WBOOK);
    }
    return 1;
}


CMD:rang(playerid, params[])
{
    STRING_GLOBAL[0] = EOS;
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "�����������: /rang [id ������] [����]");
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "����� �� ������.");
    if(params[0] == playerid) return SendError(playerid, "�� ����� ���� ID.");
    if(p_info[playerid][member] == MAYOR_LS && p_info[params[0]][member] != MAYOR_LS)
    {
        if(p_info[params[0]][leader] != 0) return SendError(playerid, "����� ����� �������.");
        switch(p_info[playerid][rang])
        {
            case 8:
            {
                if(GetFactionCategory(p_info[params[0]][member]) != FACTION_CATEGORY_PD)
                    return SendError(playerid, "����� �� ������� � �������.");
            }
            case 7:
            {
                if(GetFactionCategory(p_info[params[0]][member]) != FACTION_CATEGORY_ARMY)
                    return SendError(playerid, "����� �� ������� � �����.");
            }
            case 6:
            {
                if(GetFactionCategory(p_info[params[0]][member]) != FACTION_CATEGORY_MEDIC)
                    return SendError(playerid, "����� �� ������� � ��������.");
            }
            case 5:
            {
                if(GetFactionCategory(p_info[params[0]][member]) != FACTION_CATEGORY_SNN)
                    return SendError(playerid, "����� �� ������� � �����������.");
            }
            default: return SendError(playerid, "�� �� �������.");
        }
    }
    else
    {
        if(p_info[playerid][leader] == 0 && p_info[playerid][rang] < 9) return true;
        if(p_info[params[0]][member] != p_info[playerid][member]) return SendError(playerid, "����� �� ������� �� �������.");
        if(p_info[params[0]][leader] == p_info[playerid][member]) return 1;
        if(GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_ARMY && p_info[playerid][rang] < 7) return 1;
        if(p_info[playerid][rang] <= p_info[params[0]][rang]) return 1;
        if(p_info[params[0]][fwork] == false) return SendError(playerid, "����� ������ ���� � �����.");
        if(p_info[playerid][rang] <= 9 && params[1] > 7) return SendError(playerid, "���� �� ����� ���� 7.");
        if(!(1 <= params[1] <= p_info[playerid][rang]-1)) return SendError(playerid, "���� �� ����� ���� ����� 1 � ����� ��� %d(���-1).", p_info[playerid][rang]-1);
    }
    if(!(1 <= params[1] <= 9))
        return SendError(playerid, "���� �� ����� ���� ����� 1 � ����� 9.");

    p_info[params[0]][rang] = params[1];
    SetPlayerFractionSkin(params[0]);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "�� �������� %s [%d] ���� �� %s (%d).", get_name(params[0]), params[0], GetPlayerFractionRangName(params[0]), p_info[params[0]][rang]);
    SendAccess(playerid, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s [%d] ������� ��� ���� �� %s (%d).", get_name(playerid), playerid, GetPlayerFractionRangName(params[0]), p_info[params[0]][rang]);
    SendAccess(params[0], STRING_GLOBAL);

    save_player(params[0]);

    Log(LOG_player, INFO, "%s[%d](%s %s) ��� �������/������� %s[%d](%s %s) �� %d ���� � %s | #Fraction",
        get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", params[1], GetFractionName(p_info[params[0]][member]));

    Log(LOG_player, INFO, "%s[%d](%s %s) �������/������� %s[%d](%s %s) �� %d ���� � %s | #Fraction",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC", params[1], GetFractionName(p_info[params[0]][member]));
    return true;
}
CMD:gov(playerid, params[])
{
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "� ��� ����.");
    if(p_info[playerid][mute] > 0) return SendError(playerid, "� ��� ���������� ����.");
    if(gos(playerid) == 0 && GetFactionCategory(p_info[playerid][member]) != FACTION_CATEGORY_SNN) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(p_info[playerid][rang] < 9) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(!(1 <= strlen(params) <= 80)) return SendError(playerid, "����� ��������� ������ ������ ���� �� ����� 1 � �� ����� 80 ��������.");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 0);

    // ��������� �������;
    if(GetPVarInt(playerid, "GovAntiAttack") > 20) return OnPlayerSystemBan(playerid, "GOV-ATTACK");
    // ��������� �������;
    SetPVarInt(playerid, "GovAntiAttack", GetPVarInt(playerid, "GovAntiAttack") + 5);

    SendMesAll(0x18A5E6FF, "[���. �������] %s [%d]: "W"%s", get_name(playerid), playerid, params);
    return 1;
}
alias:gov("government");
//�������
CMD:sms(playerid, params[])
{
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "� ��� ����.");
    if(p_info[playerid][mute] > 0) return SendError(playerid, "� ��� ���������� ����.");

    if(!GetInventoryAmount(playerid, p_info[playerid][active_phone_id]))
    {
        SendError(playerid, "�� �� ������ ��������� ���������, ������ ����� ���� ���������:");
        SendError(playerid, "1. � ��� ��� ��������;");
        SendError(playerid, "2. � ��� �� ������ �������� ������� � ������� ������� /phone;");
        return 1;
    }

    if(!p_info[playerid][phone_number]) return SendError(playerid, "� ��� ��� ������ ��������.");
    if(sscanf(params, "is[144]", params[0], params[1])) return SendInfo(playerid, "�����������: /sms [����� ��������] [�����]" );
    if(strlen(params[1]) < 1 || strlen(params[1]) > 50) return SendError(playerid, "���-�� �������� � ��������� �� ����� ���� ����� 1 � ����� 50.");
    if(p_temp[playerid][offphone] == true) return SendError(playerid, "� ��� �������� �������, �������� ���.");
    if(AdvertisingCheck(params[1])) return AdvertisingPunishment(playerid, params[0], 1);
    if(params[0] == 0) return 1;
    if(params[0] == 14)
    {
        if(p_info[playerid][news] != RADIO_LS) return SendError(playerid, "�� ������ ���� ���������� � ������������.");
        if(EtherSms[0] == false) return SendError(playerid, "������������ �� ��������� ���������.");

        if(p_info[playerid][phone_balance] < SmsPrice[0])
            return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");

        foreach(new i : gFactionPlayers[RADIO_LS])
        {
            if((GetPVarInt(i, "Ether") == RADIO_LS))
            {
                p_info[playerid][phone_balance] -= SmsPrice[0];

                SetFractionWarehouse(RADIO_LS, fwMoney, SmsPrice[0]/10);
                PlayerPlaySound(i, 1052, 0.0, 0.0, 0.0);
                PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SMS: %s | �����������: %s [%d] (�. %d)", params[1], get_name(playerid), playerid, p_info[playerid][phone_number]);
                SendInfo(i, STRING_GLOBAL);

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SMS: %s | ����������: LSN (�. 555)", params[1]);
                SendInfo(playerid, STRING_GLOBAL);

                SendAccess(playerid, "�� ��������� ���������.");
                MeAction(playerid, "������(-�) ��������� �������");

                Log(LOG_player, INFO, "%s[%d](%s %s) �������� sms: %s. ����������: LSN | #AdminLogs",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    params[1]);
                break;
            }
        }
        return 1;
    }
    if(params[0] == 15)
    {
        if(p_info[playerid][news] != RADIO_SF) return SendError(playerid, "�� ������ ���� ���������� � ������������.");
        if(EtherSms[1] == false) return SendError(playerid, "������������ �� ��������� ���������.");

        if(p_info[playerid][phone_balance] < SmsPrice[1])
            return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");

        foreach(new i : gFactionPlayers[RADIO_SF])
        {
            if((GetPVarInt(i, "Ether") == RADIO_SF))
            {
                p_info[playerid][phone_balance] -= SmsPrice[1];

                SetFractionWarehouse(RADIO_SF, fwMoney, SmsPrice[1]/10);

                PlayerPlaySound(i, 1052, 0.0, 0.0, 0.0);
                PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SMS: %s | �����������: %s [%d] (�. %d)", params[1], get_name(playerid), playerid, p_info[playerid][phone_number]);
                SendInfo(i, STRING_GLOBAL);

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SMS: %s | ����������: SFN (�. 777)", params[1]);
                SendInfo(playerid, STRING_GLOBAL);

                SendAccess(playerid, "�� ��������� ���������.");
                MeAction(playerid, "������(-�) ��������� �������");

                Log(LOG_player, INFO, "%s[%d](%s %s) �������� sms: %s. ����������: SFN | #AdminLogs",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    params[1]);
                break;
            }
        }
        return 1;
    }
    if(params[0] == 16)
    {
        if(p_info[playerid][news] != RADIO_LV) return SendError(playerid, "�� ������ ���� ���������� � ������������.");
        if(EtherSms[2] == false) return SendError(playerid, "������������ �� ��������� ���������.");

        if(p_info[playerid][phone_balance] < SmsPrice[1])
            return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");

        foreach(new i : gFactionPlayers[RADIO_LV])
        {
            if((GetPVarInt(i, "Ether") == RADIO_LV))
            {
                p_info[playerid][phone_balance] -= SmsPrice[2];

                SetFractionWarehouse(RADIO_LV, fwMoney, SmsPrice[2]/10);
                PlayerPlaySound(i, 1052, 0.0, 0.0, 0.0);
                PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SMS: %s | �����������: %s [%d] (�. %d)", params[1], get_name(playerid), playerid, p_info[playerid][phone_number]);
                SendInfo(i, STRING_GLOBAL);

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SMS: %s | ����������: LVN (�. 999)", params[1]);
                SendInfo(playerid, STRING_GLOBAL);

                SendAccess(playerid, "�� ��������� ���������.");
                MeAction(playerid, "������(-�) ��������� �������");

                Log(LOG_player, INFO, "%s[%d](%s %s) �������� sms: %s. ����������: LVN | #AdminLogs",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    params[1]);
                break;
            }
        }
        return 1;
    }
    new count;
    foreach(new i: Player)
    {
        if(!p_info[i][loggedIn]) continue;
        if(p_info[i][phone_number] == params[0])
        {
            if(!GetInventoryAmount(i, p_info[i][active_phone_id]) || p_temp[i][offphone] == true)
            {
                SendError(playerid, "�� �� ������ ��������� ��������� �� ������ �����, ������ ����� ���� ���������:");
                SendError(playerid, "1. � ������ �������� �������;");
                SendError(playerid, "2. � ������ �� ������ �������� ������� � ������� ������� /phone;");
                return 1;
            }

            PlayerPlaySound(i,1052, 0.0, 0.0, 0.0 );
            PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0 );

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SMS: %s | �����������: %s [%d] (�. %d)", params[1], get_name(playerid), playerid, p_info[playerid][phone_number]);
            SendInfo(i, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SMS: %s | ����������: %s [%d] (�. %d)", params[1], get_name(i), i, p_info[i][phone_number]);
            SendInfo(playerid, STRING_GLOBAL);

            SendAccess(playerid, "�� ��������� ���������.");
            MeAction(playerid, "������(-�) ��������� �������");

            Log(LOG_player, INFO, "%s[%d](%s %s) �������� sms: %s. ����������: %s[%d](%s %s) | #AdminLogs",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                params[1],
                get_name(i), p_info[i][ID], p_temp[i][session_IP], IsPlayerMobile(i) ? "Mobile": "PC");
            count++;
            break;
        }
    }
    if(count == 0) SendError(playerid, "����� �������� ��� ���� ������� ����.");
    return 1;
}

CMD:call(playerid, params[])
{
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "� ��� ����.");
    if(p_info[playerid][mute] > 0) return SendError(playerid, "� ��� ���������� ����.");

    if(!GetInventoryAmount(playerid, p_info[playerid][active_phone_id]))
    {
        SendError(playerid, "�� �� ������ ���������, ������ ����� ���� ���������:");
        SendError(playerid, "1. � ��� ��� ��������;");
        SendError(playerid, "2. � ��� �� ������ �������� ������� � ������� ������� /phone;");
        return 1;
    }

    if(!p_info[playerid][phone_number]) return SendError(playerid, "� ��� ��� ������ ��������.");
    if(sscanf(params, "i", params[0])) {
        ShowPlayerDialog(playerid, D_PHONE_CALL, DIALOG_STYLE_INPUT, ""I"���������", ""W"\
        ������� ����� ���. ������:\n\n\
        ������� - "I"10"W"\n\
        ������ ������ - "I"11"W"\n\
        ����� - "I"12"W"\n\
        ����������� - "I"13"W"\n\
        ���������� [LS] - "I"14"W"\n\
        ���������� [SF] - "I"15"W"\n\
        ���������� [LV] - "I"16"W"\n\
