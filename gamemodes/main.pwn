{
    if(!FD(playerid) || p_info[playerid][admin] < 10) return 1;
    new house_id,int_id, Float:pX, Float:pY, Float:pZ;
    if(sscanf(params,"ii",house_id, int_id)) return SendInfo(playerid, "Используйте: /sethousepos [id дома] [id интерьера]");
    if(house_id < 0 || house_id >= totalhouses) return 1;

