                    CheckPlayerMission(playerid, START_PASS);
                }
                case 1: ShowPlayerDialog(playerid, D_CHANGE_NICK_MERIA, DIALOG_STYLE_INPUT, ""I"Смена ника", ""W"\
                            Если Вы по каким-то причинам хотите сменить свой никнейм, введите новый в поле ниже:\n\n\
                            "I"Примечания:"W" Имя должно соответствовать правилам сервера (формат Nick_Name), состоять\n\
                            только из букв, не являться оскорбляющим).\n\n\
                            Стоимость смены никнейма составляет: "I"3000000$", "Далее", "Отмена");
            }
            return 1;
        }
        case D_CHANGE_NICK_MERIA:
        {
            if(!response)
                return 1;

            if(!IsValidRPNickName(inputtext)) return ShowPlayerDialog(playerid, D_CHANGE_NICK_MERIA, DIALOG_STYLE_INPUT, ""I"Смена ника", ""W"\
            "W"Если Вы по каким-то причинам хотите сменить свой никнейм, введите новый в поле ниже:\n\n\
            "I"Примечания:"W" Имя должно соответствовать правилам сервера (формат Nick_Name), состоять\n\
            только из букв, не являться оскорбляющим).\n\n\
            Стоимость смены никнейма составляет: "I"3000000$", "Далее", "Отмена");
            if(p_info[playerid][cash] < 3000000) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id` FROM `accounts` WHERE `name` = '%e' LIMIT 1", inputtext);
            mysql_tquery(con_bd, STRING_GLOBAL, "CheckUseNickNameCallback", "iis", playerid, 0, inputtext);
            return 1;
        }
        case D_CHANGE_NICK:
        {
            if(!response) return 1;
            if(!(3 <= strlen(inputtext) <= 20)) return ShowPlayerDialog(playerid, D_CHANGE_NICK, DIALOG_STYLE_INPUT, ""I"Изменить ник", 
                ""W"Если Вы по каким-то причинам хотите сменить свой никнейм, введите новый в поле ниже:\n\n\
                "I"Примечания:"W" Имя должно соответствовать правилам сервера (формат Nick_Name), состоять\n\
                только из букв, не являться оскорбляющим).", "Далее", "Отмена");

            if(!IsValidRPNickName(inputtext)) return ShowPlayerDialog(playerid, D_CHANGE_NICK, DIALOG_STYLE_INPUT, ""I"Изменить ник", 
                ""W"Если Вы по каким-то причинам хотите сменить свой никнейм, введите новый в поле ниже:\n\n\
                "I"Примечания:"W" Имя должно соответствовать правилам сервера (формат Nick_Name), состоять\n\
                только из букв, не являться оскорбляющим).", "Далее", "Отмена");            
            STRING_GLOBAL[0] = EOS;
