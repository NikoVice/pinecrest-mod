                    for(new i = 0; i < sizeof(LobbyTypeName); i++)
                    {
                        format(STRING_MIN, sizeof(STRING_MIN), ""I"[%d]"W" %s\n", i + 1, LobbyTypeName[i]);
                        strcat(STRING_GLOBAL, STRING_MIN);
                    }
                    ShowPlayerDialog(playerid, D_LOBBY_CREATE_TYPE, DIALOG_STYLE_LIST, ""I"Тип", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 1: ShowPlayerDialog(playerid, D_LOBBY_CREATE_CAPACITY, DIALOG_STYLE_INPUT, ""I"Вместимость", ""W"Введите максимальное количество игроков от 2 до 20:", "Далее", "Отмена");
                case 2: ShowPlayerDialog(playerid, D_LOBBY_CREATE_TIME, DIALOG_STYLE_INPUT, ""I"Время", ""W"Введите количество минут от 1 до 10:", "Далее", "Отмена");
                case 3:
                {
                    switch(player_lobby_settings[playerid][0])
                    {
                        case LOBBY_TYPE_DEATHMATCH - 1: ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"Параметр", ""W"Введите ID оружия от 0 до 46:", "Далее", "Отмена");
                        case LOBBY_TYPE_RACE - 1, LOBBY_TYPE_DERBY - 1, LOBBY_TYPE_STUNT -1: ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"Параметр", ""W"Введите ID транспортного средства от 400 до 610:", "Далее", "Отмена");
                        case LOBBY_TYPE_PARKOUR - 1: ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"Параметр", ""W"Введите ID скина от 0 до 311:", "Далее", "Отмена");
                    }
                }
                case 4:
                {
                    STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;
                    new idx;
                    for(new i = 0; i < 5; i++)
                    {
                        idx = player_lobby_settings[playerid][0];
                        if(!strcmp(LobbyMapName[idx][i], "None", false)) continue;
                        format(STRING_MIN, sizeof(STRING_MIN), ""I"[%d]"W" %s\n", i + 1, LobbyMapName[idx][i]);
                        strcat(STRING_GLOBAL, STRING_MIN);
                    }
                    ShowPlayerDialog(playerid, D_LOBBY_CREATE_MAP, DIALOG_STYLE_LIST, ""I"Карта", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 5:
                {
                    STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;
                    for(new i = 0; i < sizeof(LobbyDeviceName); i++)
                    {
                        format(STRING_MIN, sizeof(STRING_MIN), ""I"[%d]"W" %s\n", i + 1, LobbyDeviceName[i]);
                        strcat(STRING_GLOBAL, STRING_MIN);
                    }
                    ShowPlayerDialog(playerid, D_LOBBY_CREATE_DEVICE, DIALOG_STYLE_LIST, ""I"Устройство", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 6: ShowPlayerDialog(playerid, D_LOBBY_CREATE_PASSWORD, DIALOG_STYLE_INPUT, ""I"Пароль", ""W"Введите пароль от 0 до 999999:", "Далее", "Отмена");
                case 7:
                {
                    if(player_lobby_settings[playerid][0] < 0 || player_lobby_settings[playerid][0] > 5) return ShowLobbyCreate(playerid), SendError(playerid, "Тип не может быть менее 1 и более 5.");
                    if(player_lobby_settings[playerid][1] < 2 || player_lobby_settings[playerid][1] > 20) return ShowLobbyCreate(playerid), SendError(playerid, "Вместимость не может быть менее 2 и более 20.");
                    if(player_lobby_settings[playerid][2] < 60 || player_lobby_settings[playerid][2] > 600) return ShowLobbyCreate(playerid), SendError(playerid, "Время не может быть менее 1 и более 10.");
                    switch(player_lobby_settings[playerid][0])
                    {
                        case LOBBY_TYPE_DEATHMATCH - 1:
                        {
                            if(player_lobby_settings[playerid][3] < 0 || player_lobby_settings[playerid][3] > 46) return ShowLobbyCreate(playerid), SendError(playerid, "ID оружия не может быть менее 0 и более 46.");
                        }
                        case LOBBY_TYPE_RACE - 1, LOBBY_TYPE_DERBY - 1, LOBBY_TYPE_STUNT - 1:
                        {
                            if(player_lobby_settings[playerid][3] < 400 || player_lobby_settings[playerid][3] > 611) return ShowLobbyCreate(playerid), SendError(playerid, "ID транспортного средства не может быть менее 400 и более 611.");
                        }
                        case LOBBY_TYPE_PARKOUR - 1:
                        {
                            if(player_lobby_settings[playerid][3] < 0 || player_lobby_settings[playerid][3] > 311) return ShowLobbyCreate(playerid), SendError(playerid, "ID скина не может быть менее 0 и более 311.");
                            if(player_lobby_settings[playerid][3] == 0 || player_lobby_settings[playerid][3] == 74) return ShowLobbyCreate(playerid), SendError(playerid, "Вы ввели запрещенный ID скина.");
                        }
                    }
                    new max_value = 2;
                    if(player_lobby_settings[playerid][0] == 0) max_value = 4;
                    if(player_lobby_settings[playerid][4] < 0 || player_lobby_settings[playerid][4] > max_value) return ShowLobbyCreate(playerid), SendError(playerid, "Карта не может быть менее 1 и более %d.", max_value + 1);
                    if(player_lobby_settings[playerid][5] < 0 || player_lobby_settings[playerid][5] > 2) return ShowLobbyCreate(playerid), SendError(playerid, "Устройство не может быть менее 1 и более 3.");
                    if(player_lobby_settings[playerid][6] < 0 || player_lobby_settings[playerid][6] > 999999) return ShowLobbyCreate(playerid), SendError(playerid, "Пароль не может быть менее 0 и более 999999.");
                    CreateLobby(playerid, player_lobby_settings[playerid][0] + 1, player_lobby_settings[playerid][1], player_lobby_settings[playerid][2], player_lobby_settings[playerid][3], player_lobby_settings[playerid][4], player_lobby_settings[playerid][5], player_lobby_settings[playerid][6]);
                }
            }
            return 1;
        }
        case D_LOBBY_CREATE_TYPE:
        {
            if(!response) return ShowLobbyCreate(playerid);
            player_lobby_settings[playerid][0] = listitem;
            ShowLobbyCreate(playerid);
            return 1;
        }
        case D_LOBBY_CREATE_CAPACITY:
        {
            if(!response) return ShowLobbyCreate(playerid);
            if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_CAPACITY, DIALOG_STYLE_INPUT, ""I"Вместимость", ""W"Введите максимальное количество игроков от 2 до 20:", "Далее", "Отмена"), SendError(playerid, "Вы ничего не ввели.");
            if(strval(inputtext) < 2 || strval(inputtext) > 20) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_CAPACITY, DIALOG_STYLE_INPUT, ""I"Вместимость", ""W"Введите максимальное количество игроков от 2 до 20:", "Далее", "Отмена"), SendError(playerid, "Вместимость должна быть не менее 2 и не более 20.");
            player_lobby_settings[playerid][1] = strval(inputtext);
            ShowLobbyCreate(playerid);
            return 1;
        }
        case D_LOBBY_CREATE_TIME:
        {
            if(!response) return ShowLobbyCreate(playerid);
            if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_TIME, DIALOG_STYLE_INPUT, ""I"Время", ""W"Введите количество минут от 1 до 10:", "Далее", "Отмена"), SendError(playerid, "Вы ничего не ввели.");
            if(strval(inputtext) < 1 || strval(inputtext) > 10) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_TIME, DIALOG_STYLE_INPUT, ""I"Время", ""W"Введите количество минут от 1 до 10:", "Далее", "Отмена"), SendError(playerid, "Время должно быть не менее 1 и не более 10.");
            player_lobby_settings[playerid][2] = strval(inputtext) * 60;
            ShowLobbyCreate(playerid);
            return 1;
        }
        case D_LOBBY_CREATE_SUBJECT:
        {
            if(!response) return ShowLobbyCreate(playerid);
            new iValue = strval(inputtext);
            switch(player_lobby_settings[playerid][0])
            {
                case LOBBY_TYPE_DEATHMATCH - 1:
                {
                    if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"Параметр", ""W"Введите ID оружия от 0 до 46:", "Далее", "Отмена"), SendError(playerid, "Вы ничего не ввели.");
                    if(iValue < 0 || iValue > 46) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"Параметр", ""W"Введите ID оружия от 0 до 46:", "Далее", "Отмена"), SendError(playerid, "ID оружия должен быть не менее 0 и не более 46.");
                    if(iValue == 16 || iValue >= 35 && iValue <= 40 || iValue >= 44 && iValue <= 46) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"Параметр", ""W"Введите ID оружия от 0 до 46:", "Далее", "Отмена"), SendError(playerid, "Вы ввели запрещенный ID оружия.");
                }
                case LOBBY_TYPE_RACE - 1, LOBBY_TYPE_DERBY - 1, LOBBY_TYPE_STUNT - 1:
                {
                    if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"Параметр", ""W"Введите ID транспортного средства от 400 до 610:", "Далее", "Отмена"), SendError(playerid, "Вы ничего не ввели.");
                    if(iValue < 400 || iValue > 600) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"Параметр", ""W"Введите ID транспортного средства от 400 до 610:", "Далее", "Отмена"), SendError(playerid, "ID транспортного средства должен быть не менее 400 и не более 611.");
                    if(GetVehicleData(iValue, E_VD_TYPE) == VEHICLE_STATE_BOAT || GetVehicleData(iValue, E_VD_TYPE) == VEHICLE_STATE_PLANE || GetVehicleData(iValue, E_VD_TYPE) == VEHICLE_STATE_TRAIN) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"Параметр", ""W"Введите ID транспортного средства от 400 до 610:", "Далее", "Отмена"), SendError(playerid, "Вы ввели запрещенный ID транспорта.");
                    if(iValue == 432 || iValue == 520 || iValue == 425) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"Параметр", ""W"Введите ID транспортного средства от 400 до 610:", "Далее", "Отмена"), SendError(playerid, "Вы ввели запрещенный ID транспорта.");
                }
                case LOBBY_TYPE_PARKOUR - 1:
                {
                    if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"Параметр", ""W"Введите ID скина от 0 до 311:", "Далее", "Отмена"), SendError(playerid, "Вы ничего не ввели.");
                    if(iValue < 0 || iValue > 311) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"Параметр", ""W"Введите ID скина от 0 до 311:", "Далее", "Отмена"), SendError(playerid, "ID скина должен быть не менее 0 и не более 311.");
                    if(iValue == 0 || iValue == 74) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"Параметр", ""W"Введите ID скина от 0 до 311:", "Далее", "Отмена"), SendError(playerid, "Вы ввели запрещенный ID скина.");
                }
            }
            player_lobby_settings[playerid][3] = iValue;
            ShowLobbyCreate(playerid);
            return 1;
        }
        case D_LOBBY_CREATE_MAP:
        {
            if(!response) return ShowLobbyCreate(playerid);
            player_lobby_settings[playerid][4] = listitem;
            ShowLobbyCreate(playerid);
            return 1;
        }
        case D_LOBBY_CREATE_DEVICE:
        {
            if(!response) return ShowLobbyCreate(playerid);
            player_lobby_settings[playerid][5] = listitem;
            ShowLobbyCreate(playerid);
            return 1;
        }
        case D_LOBBY_CREATE_PASSWORD:
        {
            if(!response) return ShowLobbyCreate(playerid);
            if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_PASSWORD, DIALOG_STYLE_INPUT, ""I"Пароль", ""W"Введите пароль от 0 до 999999:", "Далее", "Отмена"), SendError(playerid, "Вы ничего не ввели.");
            if(strval(inputtext) < 0 || strval(inputtext) > 999999) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_PASSWORD, DIALOG_STYLE_INPUT, ""I"Пароль", ""W"Введите пароль от 0 до 999999:", "Далее", "Отмена"), SendError(playerid, "Пароль должен быть не менее 0 и не более 999999.");
            player_lobby_settings[playerid][6] = strval(inputtext);
            ShowLobbyCreate(playerid);
            return 1;
        }
        #if GIFT_STATUS == 1
            case D_GIFT:
            {
                if(!response) return 1;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `accounts` WHERE `gift` != 0 ORDER BY `gift` DESC LIMIT 10");
                mysql_tquery(con_bd, STRING_GLOBAL, "OnPlayerShowListSearchGift", "d", playerid);
                return 1;
            }
            case D_GIFT_CHANGE_COINS:
            {
                if(!response) return 1;
                p_temp[playerid][p_listitem_int] = listitem;
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы действительно хотите обменять "I"%d "W"яиц на "I"\"%s\"", GetChangeGiftCoinsPrice(listitem), GetChangeCivilCoinsName(ChangeGiftCoins[listitem][cbcType], ChangeGiftCoins[listitem][cbcIDx]));
                ShowPlayerDialog(playerid, D_GIFT_CHANGE_COINS_CONFIRM, DIALOG_STYLE_MSGBOX, ""I"Обмен яиц", STRING_GLOBAL, "Дальше", "Отмена");
                return 1;
            }
            case D_GIFT_CHANGE_COINS_CONFIRM:
            {
                listitem = p_temp[playerid][p_listitem_int];
                p_temp[playerid][p_listitem_int] = -1;
                if(!response || listitem == -1) return 1;
                if(!ChangeGiftCoinsWarehouse[listitem]) return ShowGiftChangeCoins(playerid), SendError(playerid, "На складе нет данного предмета.");
                new price = GetChangeGiftCoinsPrice(listitem);
                if(price > GetInventoryAmount(playerid, 894)) return ShowGiftChangeCoins(playerid), SendError(playerid, "У Вас нет столько яиц.");

                switch(ChangeGiftCoins[listitem][cbcType])
                {
                    case TYPE_CHANGE_VEHICLE: SetPlayerItem(playerid, 8, p_info[playerid][ID], TYPE_GIVE_ITEM_VEHICLE, ChangeGiftCoins[listitem][cbcIDx]);
                    case TYPE_CHANGE_ROULETTE:
                    {
                        new inventory_idx = ChangeGiftCoins[listitem][cbcIDx];
                        if(!GivePlayerInventory(playerid, inventory_idx)) return SendError(playerid, "В инвентаре нет места.");
                    }
                    case TYPE_CHANGE_ACCESSORIES: SetPlayerItem(playerid, 8, p_info[playerid][ID], TYPE_GIVE_ITEM_ACCESSORIES, ChangeGiftCoins[listitem][cbcIDx]);
                    case TYPE_CHANGE_SKIN: SetPlayerItem(playerid, 8, p_info[playerid][ID], TYPE_GIVE_ITEM_U_SKIN, ChangeGiftCoins[listitem][cbcIDx]);
                    case TYPE_CHANGE_COSTUME:
                    {
                        new costume_idx = ChangeGiftCoins[listitem][cbcIDx];
                        if(p_info[playerid][costume][costume_idx] == 1) return ShowGiftChangeCoins(playerid), SendError(playerid, "У Вас уже есть костюм \"%s\".", CostumeName[costume_idx]);
                        GivePlayerCostume(playerid, costume_idx);
                    }
                }

                ChangeGiftCoinsWarehouse[listitem]--;

                STRING_GLOBAL[0] = EOS;
                for(new i; i < MAX_GIFT_CHANGE_COINS; i++)
                {
                    f(STRING_GLOBAL, "%s%i%s", STRING_GLOBAL, ChangeGiftCoinsWarehouse[i], i == MAX_GIFT_CHANGE_COINS-1 ? "":",");
                }
                MysqlUpdateOtherStr("change_gift_coins_warehouse", STRING_GLOBAL);

                GivePlayerInventory(playerid, 894, -price);

                SendAccess(playerid, "Вы обменяли %d яиц на %s.", price, GetChangeCivilCoinsName(ChangeGiftCoins[listitem][cbcType], ChangeGiftCoins[listitem][cbcIDx]));

                Log(LOG_player, INFO, "%s[%d](%s %s) обменял %d яиц на %s | #ChangeStaff",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", price, GetChangeCivilCoinsName(ChangeGiftCoins[listitem][cbcType], ChangeGiftCoins[listitem][cbcIDx]));
                return 1;
            }
        #endif
        case D_ROB_HOUSE_NPC_1:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0: ShowRobberyHouse(playerid, ROBBERY_HOUSE_INFO);
                case 1: ShowRobberyHouse(playerid, ROBBERY_HOUSE_LIST);
                case 2:
                {
                    new idx = p_temp[playerid][rob_house_idx];
                    if(idx == -1) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_1), SendError(playerid, "Вы не участвуете в ограблении дома.");
                    ShowRobberyHouse(playerid, ROBBERY_HOUSE_CONTRACT_INFO, idx);
                }
            }
            return 1;
        }
        case D_ROB_HOUSE_INFO: return ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_1);
        case D_ROB_HOUSE_LIST:
        {
            if(!response) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_1);
            new idx = p_temp[playerid][p_listitem][listitem];
            for(new i; i < 100; i++) p_temp[playerid][p_listitem][i] = -1;
            if(idx == -1) return SendError(playerid, "Что-то пошло не так, попробуйте заново или обновите версию клиента.");
            ShowRobberyHouse(playerid, ROBBERY_HOUSE_CONTRACT, idx);
            return 1;
        }
        case D_ROB_HOUSE_CONTRACT:
        {
            if(!response) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_LIST), DeletePVar(playerid, "RobberyHouse:idx");
            ShowRobberyHouse(playerid, ROBBERY_HOUSE_CONTRACT_START);
            return 1;
        }
        case D_ROB_HOUSE_CONTRACT_START:
        {
            if(!response) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_LIST), DeletePVar(playerid, "RobberyHouse:idx");
            new idx = GetPVarInt(playerid, "RobberyHouse:idx");
            DeletePVar(playerid, "RobberyHouse:idx");
            if(RobberyHouseContract[idx][rhcType] == 1 && p_info[playerid][p_vip] < 3) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_LIST), SendError(playerid, "Данный контракт премиальный, у Вас нет VIP Gold.");
            if(RobberyHouseContract[idx][rhcStatus] != 1) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_LIST), SendError(playerid, "Данный контракт уже приобрели или он был удален.");
            new price = RobberyHouseContract[idx][rhcPrice];
            if(p_info[playerid][cash] < price) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_LIST), SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            SetPlayerMoney(playerid, -price, true, "покупка контракта для ограбления дома");
            RobberyHouseContract[idx][rhcStatus] = 2;
            RobberyHouseContract[idx][rhcTime] = 1800;
            RobberyHouseContract[idx][rhcOwnerID] = p_info[playerid][ID];
            RobberyHouseContract[idx][rhcPlayerID][0] = playerid;
            new houseid = RobberyHouseContract[idx][rhcHouseIDx];
            SendAccess(playerid, "Вы приобрели контракт за %d$ на ограбления дома %d.", price, houseid);
            SendInfo(playerid, "Подробнее: /robbing");
            SendInfo(playerid, "Помощь по ограблениям: /mn > [4] Помощь по игре > [16] Ограбление дома");
            CreateRobberyHouseObject(idx, houseid);
            p_temp[playerid][rob_house_idx] = idx;
            ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
            if(GetPlayerAttachedCostume(playerid) != -1)
            {
                SendInfo(playerid, "С Вас снят костюм, он будет надет после завершения ограбления.");
                TakePlayerAttachedCostume(playerid, GetPlayerAttachedCostume(playerid), false);
            }
            else RemovePlayerAccessories(playerid, false);
            return 1;
        }
        case D_ROB_HOUSE_CONTRACT_INFO:
        {
            if(IsPlayerInRangeOfPoint(playerid, 2.5, 1413.4436,-1487.6085,20.4344)) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_1);
            else return ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
        }
        case D_ROB_HOUSE_MENU:
        {
            if(!response) return 1;
            new idx = p_temp[playerid][rob_house_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении дома.");
            switch(listitem)
            {
                case 0: ShowRobberyHouse(playerid, ROBBERY_HOUSE_CONTRACT_INFO, idx);
                case 1: ShowRobberyHouse(playerid, ROBBERY_HOUSE_PLAYER, idx);
                case 2: ShowRobberyHouse(playerid, ROBBERY_HOUSE_USE, idx);
                case 3:
                {
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    SetPlayerGPS(playerid, 2323.4768,-1222.8743,22.6349, 5.0);
                    SendInfo(playerid, "Владимир отмечен на GPS навигаторе. Расстояние: %.0f метров.", GetPlayerDistanceFromPoint(playerid, 2323.4768,-1222.8743,22.6349));
                }
                case 4:
                {
                    new houseid = RobberyHouseContract[idx][rhcHouseIDx], Float:distance = GetPlayerDistanceFromPoint(playerid, h_info[houseid][h_enter][0], h_info[houseid][h_enter][1], h_info[houseid][h_enter][2]);
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    SetPlayerGPS(playerid, h_info[houseid][h_enter][0], h_info[houseid][h_enter][1], h_info[houseid][h_enter][2], 5.0);
                    SendInfo(playerid, "\"Дом #%d\" отмечен на GPS навигаторе. Расстояние: %.0f метров.", houseid, distance);
                }
                case 5:
                {
                    new vehicleid = RobberyHouseContract[idx][rhcVehicleIDx];
                    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "В контракте нет транспортного средства, продайте вещи из сумки Владимиру."), ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);

                    new Float:x, Float:y, Float:z, Float:r;

                    GetVehicleZAngle(vehicleid, r);
                    GetVehiclePos(vehicleid, x, y, z);
                    y = y - (2.5 * floatcos(r, degrees));
                    x = x - (-2.5 * floatsin(r, degrees));

                    if(!IsPlayerInRangeOfPoint(playerid, 5.0, x, y, z)) return SendError(playerid, "Вы далеко от багажника."), ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);

                    new items_idx, count;
                    if(GetFreeRobHouseObject(playerid) == MAX_ROBBERY_HOUSE_PLAYER_ITEMS)
                    {
                        for(new i = 0, x = 0; i < MAX_ROBBERY_HOUSE_ITEMS; i++)
                        {
                            items_idx = RobberyHouseContract[idx][rhcVehicleItems][i];
                            if(items_idx != -1)
                            {
                                for(x = 0; x < MAX_ROBBERY_HOUSE_PLAYER_ITEMS; x++)
                                {
                                    if(p_temp[playerid][rob_house_backup_items][x] == -1)
                                    {
                                        p_temp[playerid][rob_house_backup_items][x] = items_idx;
                                        RobberyHouseContract[idx][rhcVehicleItems][i] = -1;
                                        SendAccess(playerid, "Вы взяли предмет \"%s\" из багажника.", RobberyHouseItems[items_idx][rhiName]);
                                        count++;
                                        break;
                                    }
                                }
                            }
                        }
                        if(count == 0) SendError(playerid, "В транспортном средстве ничего нет."), ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
                    }
                    else
                    {
                        for(new i = 0, x = 0; i < MAX_ROBBERY_HOUSE_PLAYER_ITEMS; i++)
                        {
                            items_idx = p_temp[playerid][rob_house_backup_items][i];
                            if(items_idx != -1)
                            {
                                for(x = 0; x < MAX_ROBBERY_HOUSE_ITEMS; x++)
                                {
                                    if(RobberyHouseContract[idx][rhcVehicleItems][x] == -1)
                                    {
                                        RobberyHouseContract[idx][rhcVehicleItems][x] = items_idx;
                                        p_temp[playerid][rob_house_backup_items][i] = -1;
                                        SendAccess(playerid, "Вы положили предмет \"%s\" в багажник.", RobberyHouseItems[items_idx][rhiName]);
                                        count++;
                                        break;
                                    }
                                }
                            }
                        }
                        if(count == 0) SendError(playerid, "В транспортном средстве нет места."), ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
                    }
                }
                case 6:
                {
                    if(RobberyHouseContract[idx][rhcStatus] == 3) return SendError(playerid, "Ограбление дома уже началось."), ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);

                    for(new i = 0; i < MAX_ROBBERY_HOUSE_ITEMS_START; i++)
                    {
                        if(RobberyHouseContract[idx][rhcItemsStart][i] == 0 && RobberyHouseItemsStart[i][rhisStatus] == true) return SendError(playerid, "Для начала ограбления необходимо приобрести предмет \"%s\".", RobberyHouseItemsStart[i][rhisName]), ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
                    }
                    if(RobberyHouseContract[idx][rhcVehicleIDx] == INVALID_VEHICLE_ID) return SendError(playerid, "Для начала ограбления необходимо арендовать транспортное средство."), ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
                    ShowRobberyHouse(playerid, ROBBERY_HOUSE_START, idx);
                }
                case 7: ShowRobberyHouse(playerid, ROBBERY_HOUSE_ITEMS_LIST, idx);
                case 8:
                {
                    if(RobberyHouseContract[idx][rhcTimeUpdate]) return SendError(playerid, "Продлевать контракт можно 1 раз."), ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
                    ShowRobberyHouse(playerid, ROBBERY_HOUSE_EXTEND_CONTRACT, idx);
                }
                case 9:
                {
                    if(p_temp[playerid][rob_house_backup_pickup] == -1 || p_temp[playerid][rob_house_backup_area] == -1) return SendError(playerid, "Вы не теряли сумку или ее кто-то уже забрал."), ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
                    new Float:distance = GetPlayerDistanceFromPoint(playerid, p_temp[playerid][rob_house_backup_pos][0], p_temp[playerid][rob_house_backup_pos][1], p_temp[playerid][rob_house_backup_pos][2]);
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    SetPlayerGPS(playerid, p_temp[playerid][rob_house_backup_pos][0], p_temp[playerid][rob_house_backup_pos][1], p_temp[playerid][rob_house_backup_pos][2], 5.0);
                    SendInfo(playerid, "\"Сумка\" отмечена на GPS навигаторе. Расстояние: %.0f метров.", distance);
                }
                case 10:
                {
                    if(RobberyHouseContract[idx][rhcOwnerID] == p_info[playerid][ID]) return SendError(playerid, "Владелец контракта не может покинуть ограбление дома, откажитесь от контракта."), ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
                    ShowRobberyHouse(playerid, ROBBERY_HOUSE_LEAVE);
                }
                case 11:
                {
                    if(RobberyHouseContract[idx][rhcOwnerID] != p_info[playerid][ID]) return SendError(playerid, "Вы не являетесь владелецем контракта."), ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
                    ShowRobberyHouse(playerid, ROBBERY_HOUSE_DELETE, idx);
                }
            }
            return 1;
        }
        case D_ROB_HOUSE_PLAYER:
        {
            if(!response) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
            new fix_listitem, idx = p_temp[playerid][rob_house_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении дома.");
            if(RobberyHouseContract[idx][rhcStatus] == 3) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_PLAYER, idx), SendError(playerid, "Вы не можете пригласить подельника, ограбление дома уже началось.");
            if(sscanf(inputtext, "i", fix_listitem)) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_PLAYER, idx), SendError(playerid, "Вводить нужно только цифру пункта.");
            if(fix_listitem == INVALID_PLAYER_ID) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_PLAYER, idx), SendError(playerid, "Игрок не найден.");
            if(!IsPlayerStream(5.0, playerid, fix_listitem) || pSpectateId[fix_listitem] != INVALID_PLAYER_ID) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_PLAYER, idx), SendError(playerid, "Игрок слишком далеко от Вас.");
            if(GetFreRobberyHousePlayer(idx) == -1) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_PLAYER, idx), SendError(playerid, "В ограблении дома уже участвует максимальное количество человек.");
            if(GetPlayerFamilyID(fix_listitem) == -1 && !gang(fix_listitem) && !mafia(fix_listitem) && !biker(fix_listitem)) return SendError(playerid, "Данный игрок не состоит в семье или нелегальной организации.");
            if(gos(fix_listitem)) return SendError(playerid, "Данынй игрок не закончил рабочий день.");
            if(p_temp[fix_listitem][rob_house_idx] != -1 || p_temp[fix_listitem][rob_bank_idx] != -1 || p_temp[fix_listitem][rob_fuel_idx] != -1) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_PLAYER, idx), SendError(playerid, "Данный игрок уже состоит в какой-то команде в ограблении дома, банка или АЗС.");
            if(p_info[fix_listitem][level] < 20) return SendError(playerid, "Участвовать в ограблениях можно с 20-ого уровня.");
            SendAccess(playerid, "Вы предложили %s [%d] участвовать в ограблении дома.", get_name(fix_listitem), fix_listitem);
            SendInfo(fix_listitem, "%s [%d] предложил Вам участвовать в ограблении дома.", get_name(playerid), playerid);
            SetFreeSlotOffer(fix_listitem, playerid, OFFER_ID_INVITE_ROB_HOUSE);
            return 1;
        }
        case D_ROB_HOUSE_USE:
        {
            if(!response) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
            new idx = p_temp[playerid][rob_house_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении дома.");
            new houseid = RobberyHouseContract[idx][rhcHouseIDx], scdplayerid;
            if(RobberyHouseContract[idx][rhcItemsStart][listitem] == 0) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_USE, idx), SendError(playerid, "В списке предметов для ограбления дома нет \"%s\".", RobberyHouseItemsStart[listitem][rhisName]);
            if(RobberyHouseContract[idx][rhcStatus] != 3) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_USE, idx), SendError(playerid, "Вы не можете использовать предметы, ограбление дома еще не началось.");
            if((listitem == 2 || listitem == 3 || listitem == 4) && !IsPlayerInRangeOfPoint(playerid, 5.0, h_info[houseid][h_enter][0], h_info[houseid][h_enter][1], h_info[houseid][h_enter][2])) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_USE, idx), SendError(playerid, "Вы слишком далеко от дома.");
            switch(listitem)
            {
                case 0:
                {
                    RobberyHouseContract[idx][rhcItemsStart][0] = 0;
                    for(new i = 0; i < MAX_ROBBERY_HOUSE_PLAYER; i++)
                    {
                        scdplayerid = RobberyHouseContract[idx][rhcPlayerID][i];
                        if(scdplayerid != INVALID_PLAYER_ID)
                        {
                            SetPlayerArmour(scdplayerid, 100);
                        }
                    }
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "[ROBBERY] %s [%d] использовал(-а) бронежилеты для всей команды.", get_name(playerid), playerid);
                    SendRobberyHouseMessage(idx, 0xDEB887FF, STRING_GLOBAL);
                }
                case 1:
                {
                    RobberyHouseContract[idx][rhcItemsStart][1] = 0;
                    for(new i = 0; i < MAX_ROBBERY_HOUSE_PLAYER; i++)
                    {
                        scdplayerid = RobberyHouseContract[idx][rhcPlayerID][i];
                        if(scdplayerid != INVALID_PLAYER_ID)
                        {
                            f_GivePlayerWeapon(scdplayerid, 24, 50);
                            f_GivePlayerWeapon(scdplayerid, 31, 150);
                        }
                    }
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "[ROBBERY] %s [%d] использовал(-а) оружие для всей команды.", get_name(playerid), playerid);
                    SendRobberyHouseMessage(idx, 0xDEB887FF, STRING_GLOBAL);
                }
                case 2:
                {
                    if(h_info[houseid][h_lock] == 0) return SendError(playerid, "Данный дом открыт.");
                    RobberyHouseContract[idx][rhcItemsStart][2] = 0;
                    StartRobbingMiniGame(playerid, ROBBING_TYPE_HOUSE, ROB_HOUSE_ITEMS_ELECTRO_JAMMER, 180);
                }
                case 3:
                {
                    if(h_info[houseid][h_lock] == 0) return SendError(playerid, "Данный дом открыт.");
                    RobberyHouseContract[idx][rhcItemsStart][3] = 0;
                    StartRobbingMiniGame(playerid, ROBBING_TYPE_HOUSE, ROB_HOUSE_ITEMS_MASTER_KEY, 60);
                }
                case 4:
                {
                    if(h_info[houseid][h_lock] == 0) return SendError(playerid, "Данный дом открыт.");
                    RobberyHouseContract[idx][rhcItemsStart][4] = 0;
                    StartRobbingMiniGame(playerid, ROBBING_TYPE_HOUSE, ROB_HOUSE_ITEMS_SCRAP, 90);
                }
                case 5:
                {
                    if(RobberyHouseContract[idx][rhcType] != 1) return SendError(playerid, "Использование инструментов доступно только в премиальных контрактах.");
                    if(RobberyHouseContract[idx][rhcSafe] == INVALID_OBJECT_ID) return SendError(playerid, "В доме нет сейфа или он уже взломан.");
                    new class = h_info[houseid][h_squar] - 1;
                    if(!IsPlayerInRangeOfPoint(playerid, 5.0, RobberyHouseSafePos[class][0], RobberyHouseSafePos[class][1], RobberyHouseSafePos[class][2])) return SendError(playerid, "Вы далеко от сейфа.");
                    RobberyHouseContract[idx][rhcItemsStart][5] = 0;
                    StartRobbingMiniGame(playerid, ROBBING_TYPE_HOUSE, ROB_HOUSE_ITEMS_TOOLS, 300);
                }
                case 6:
                {
                    if(RobberyHouseContract[idx][rhcItemsStart][8] != 0) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_USE, idx), SendError(playerid, "Для начала необходимо использовать \"%s\".", RobberyHouseItemsStart[8][rhisName]);
                    RobberyHouseContract[idx][rhcItemsStart][6] = 0;
                    new idx_skin;
                    for(new i = 0; i < MAX_ROBBERY_HOUSE_PLAYER; i++)
                    {
                        scdplayerid = RobberyHouseContract[idx][rhcPlayerID][i];
                        if(scdplayerid != INVALID_PLAYER_ID)
                        {
                            idx_skin = GetPlayerSkin(scdplayerid);

                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `accessories_coords` WHERE `type` = 31 AND `skin_id` = %d LIMIT 1", idx_skin);
                            mysql_pquery(con_bd, STRING_GLOBAL, "AccessoriesCoords", "ddd", scdplayerid, p_info[scdplayerid][ID], 0);

                            SetPlayerChatBubble(scdplayerid, "Надел(-а) маску", COLOR_MAIN, 20.0, 10000);
                            if(!IsPlayerInAnyVehicle(scdplayerid)) ApplyAnimation(scdplayerid, "SHOP", "ROB_Shifty", 4.0, 0, 0, 0, 0, 0, 1);
                            SetPlayerColor(scdplayerid, 0x4F4F4F00);
                            p_temp[scdplayerid][UseMaskFix] = 1;
                            p_temp[scdplayerid][UseMaskTimerFix] = timestamp + 3600;
                            SendAccess(scdplayerid, "Вы надели маску.");
                            SendInfo(scdplayerid, "Ваше местоположение на GPS навигаторе скрыто на 60 мин.");

                            if(p_info[playerid][p_settings][ROLEPLAY] == 1)
                            {
                                DoAction(scdplayerid, "Маска лежит в кармане.");
                                MeAction(scdplayerid, "засунул правую руку в карман, после чего нащупав маску достал ее и одел на голову");
                            }
                        }
                    }
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "[ROBBERY] %s [%d] использовал(-а) маски для всей команды.", get_name(playerid), playerid);
                    SendRobberyHouseMessage(idx, 0xDEB887FF, STRING_GLOBAL);
                }
                case 7:
                {
                    if(RobberyHouseContract[idx][rhcItemsStart][8] != 0) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_USE, idx), SendError(playerid, "Для начала необходимо использовать \"%s\".", RobberyHouseItemsStart[8][rhisName]);
                    RobberyHouseContract[idx][rhcItemsStart][7] = 0;
                    new idx_skin;
                    for(new i = 0; i < MAX_ROBBERY_HOUSE_PLAYER; i++)
                    {
                        scdplayerid = RobberyHouseContract[idx][rhcPlayerID][i];
                        if(scdplayerid != INVALID_PLAYER_ID)
                        {
                            idx_skin = GetPlayerSkin(scdplayerid);

                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `accessories_coords` WHERE `type` = 127 AND `skin_id` = %d LIMIT 1", idx_skin);
                            mysql_pquery(con_bd, STRING_GLOBAL, "AccessoriesCoords", "ddd", scdplayerid, p_info[scdplayerid][ID], 1);

                            p_temp[scdplayerid][rob_house_backup] = 1;
                        }
                    }
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "[ROBBERY] %s [%d] использовал(-а) сумки для всей команды.", get_name(playerid), playerid);
                    SendRobberyHouseMessage(idx, 0xDEB887FF, STRING_GLOBAL);
                }
                case 8:
                {
                    RobberyHouseContract[idx][rhcItemsStart][8] = 0;
                    for(new i = 0; i < MAX_ROBBERY_HOUSE_PLAYER; i++)
                    {
                        scdplayerid = RobberyHouseContract[idx][rhcPlayerID][i];
                        if(scdplayerid != INVALID_PLAYER_ID)
                        {
                            SetPlayerSkin(scdplayerid, 119);
                            RobberyHouseContract[idx][rhcSkin][i] = 1;
                        }
                    }
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "[ROBBERY] %s [%d] использовал(-а) одежду для всей команды.", get_name(playerid), playerid);
                    SendRobberyHouseMessage(idx, 0xDEB887FF, STRING_GLOBAL);
                }
            }
            if(listitem == 0 || listitem == 1 || listitem == 6 || listitem == 7 || listitem == 8) ShowRobberyHouse(playerid, ROBBERY_HOUSE_USE, idx);
            return 1;
        }
        case D_ROB_HOUSE_START:
        {
            if(!response) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
            new idx = p_temp[playerid][rob_house_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении дома.");
            if(RobberyHouseContract[idx][rhcStatus] == 3) return SendError(playerid, "Вы не можете начать ограбление дома, оно уже началось."), ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "[ROBBERY] %s [%d] начал(-а) ограбление.", get_name(playerid), playerid);
            SendRobberyHouseMessage(idx, 0xDEB887FF, STRING_GLOBAL);
            RobberyHouseContract[idx][rhcStatus] = 3;
            ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
            return 1;
        }
        case D_ROB_HOUSE_ITEMS_LIST: return ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
        case D_ROB_HOUSE_EXTEND_CONTRACT:
        {
            if(!response) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
            new idx = p_temp[playerid][rob_house_idx], price = RobberyHouseContract[idx][rhcPrice] / 2;
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении дома.");
            if(RobberyHouseContract[idx][rhcTimeUpdate]) return SendError(playerid, "Продлевать контракт можно 1 раз."), ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate"), ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
            SetPlayerMoney(playerid, -price, true, "продление контракта для ограбления дома");
            RobberyHouseContract[idx][rhcTime] += 1800;
            RobberyHouseContract[idx][rhcTimeUpdate] = 1;
            SendAccess(playerid, "Вы продлили контракт ограбления дома на 30 минут.");
            ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
            return 1;
        }
        case D_ROB_HOUSE_LEAVE:
        {
            if(!response) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
            new idx = p_temp[playerid][rob_house_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении дома.");
            if(RobberyHouseContract[idx][rhcOwnerID] == p_info[playerid][ID]) return SendError(playerid, "Владелец контракта не может покинуть ограбление дома, откажитесь от контракта."), ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
            for(new i = 0; i < MAX_ROBBERY_HOUSE_PLAYER; i++)
            {
                if(RobberyHouseContract[idx][rhcPlayerID][i] == playerid)
                {
                    RobberyHouseContract[idx][rhcPlayerID][i] = INVALID_PLAYER_ID;
                    ClearRobberyHouse(playerid, 1);
                    ClearRobberyHouseBackup(playerid, 1);
                    SetPlayerSkinEx(playerid);
                    maskOFF(playerid);
                    SendAccess(playerid, "Вы покинули ограбление дома.");
                    AttachToPlayerAccOrCostume(playerid, INVALID_PLAYER_ID);
                    return 1;
                }
            }
            SendError(playerid, "Вы не участвуете в ограблении дома.");
            return 1;
        }
        case D_ROB_HOUSE_DELETE:
        {
            if(!response) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
            new idx = p_temp[playerid][rob_house_idx], scdplayerid;
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении дома.");
            if(RobberyHouseContract[idx][rhcOwnerID] != p_info[playerid][ID]) return SendError(playerid, "Вы не являетесь владелецем контракта."), ShowRobberyHouse(playerid, ROBBERY_HOUSE_MENU);
            SendAccess(playerid, "Вы завершили контракт.");
            new money = GetRobberyHouseShare(idx);
            for(new i = 0; i < MAX_ROBBERY_HOUSE_PLAYER; i++)
            {
                scdplayerid = RobberyHouseContract[idx][rhcPlayerID][i];
                if(scdplayerid != INVALID_PLAYER_ID)
                {
                    RobberyHouseContract[idx][rhcPlayerID][i] = INVALID_PLAYER_ID;
                    ClearRobberyHouse(scdplayerid, 1);
                    ClearRobberyHouseBackup(scdplayerid, 1);
                    SetPlayerSkinEx(scdplayerid);
                    maskOFF(scdplayerid);
                    SetPlayerMoney(scdplayerid, money, true, "завершил ограбление дома");
                    RobbingInfoForMoney[1] += money;
                    SendInfo(scdplayerid, "Владелец контракта завершил ограбление дома.");
                    SendInfo(scdplayerid, "Вы заработали: %d$.", money);
                    AttachToPlayerAccOrCostume(scdplayerid, INVALID_PLAYER_ID);
                }
            }
            DestroyRobberyHouseContract(idx);
            return 1;
        }
        case D_ROB_HOUSE_NPC_2:
        {
            if(!response) return 1;
            new idx = p_temp[playerid][rob_house_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении дома.");
            switch(listitem)
            {
                case 0: ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_2_SELL, idx);
                case 1: ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_2_BUY);
                case 2:
                {
                    if(RobberyHouseContract[idx][rhcStatus] == 3) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_2), SendError(playerid, "Вы не можете арендовать транспортное средство, ограбление дома уже началось.");
                    if(RobberyHouseContract[idx][rhcVehicleIDx] != INVALID_VEHICLE_ID) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_2), SendError(playerid, "Транспортное средство для ограбления уже было арендовано.");
                    ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_2_R_VEHICLE, idx);
                }
            }
            return 1;
        }
        case D_ROB_HOUSE_NPC_2_SELL:
        {
            if(!response) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_2);
            if(p_temp[playerid][rob_house_backup] == 0) return SendError(playerid, "У Вас нет сумки."), ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_2);
            new rob_idx = p_temp[playerid][rob_house_idx];
            if(rob_idx == -1) return SendError(playerid, "Вы не участвуете в ограблении дома.");
            new idx = p_temp[playerid][p_listitem][listitem];
            if(idx == -1) return SendError(playerid, "Что-то пошло не так, попробуйте заново или обновите версию клиента.");
            new items_idx = p_temp[playerid][rob_house_backup_items][idx], houseid = RobberyHouseContract[rob_idx][rhcHouseIDx], price = RobberyHouseItems[items_idx][rhiPrice] * h_info[houseid][h_squar];
            for(new i; i < 100; i++) p_temp[playerid][p_listitem][i] = -1;
            p_temp[playerid][rob_house_backup_items][idx] = -1;
            RobberyHouseContract[rob_idx][rhcKush] += price;
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "[ROBBERY] %s [%d] продал(-а) \"%s\" за %d$. Общий куш: %d$.", get_name(playerid), playerid, RobberyHouseItems[items_idx][rhiName], price, RobberyHouseContract[rob_idx][rhcKush]);
            SendRobberyHouseMessage(rob_idx, 0xDEB887FF, STRING_GLOBAL);
            ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_2_SELL, rob_idx);
            return 1;
        }
        case D_ROB_HOUSE_NPC_2_BUY:
        {
            if(!response) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_2);
            ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_2_BUY_ACT, p_temp[playerid][rob_house_idx], listitem);
            return 1;
        }
        case D_ROB_HOUSE_NPC_2_BUY_ACT:
        {
            if(!response) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_NPC_2_BUY);
            new idx = p_temp[playerid][rob_house_idx], i = GetPVarInt(playerid, "RobberyHouse:items_buy");
            DeletePVar(playerid, "RobberyHouse:items_buy");
