            if(price < 10 || price > 25) return ShowPlayerDialog(playerid, D_NEWS_SET_SMS, DIALOG_STYLE_INPUT, ""I"��������� 1 ���������", ""W"������� ��������� 1 ���������:\n\n{"#cLIGHTRED"}�������� ��������! ��������� ������ ���� �� ����� 10$ � �� ����� 25$.", "�����", "������");

