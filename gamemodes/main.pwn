                Стоимость: "I"2"W" EXP "I"2 Pinecrest Money", ((FamilyData[family_idx][fLevel]+1)*COUNT_EXP_FAMILY)-FamilyData[family_idx][fExp]);
                ShowPlayerDialog(playerid, D_FAMILY_BUY_EXP, DIALOG_STYLE_INPUT, ""I"Семейные EXP", STRING_GLOBAL, "Далее", "Отмена");
                return 1;
            }
            p_info[playerid][flinmoney] -= fix_listitem;
            MysqlUpdatePlayerInt(playerid, "flinmoney", p_info[playerid][flinmoney]);
            UpdateFamilyLevel(playerid, fix_listitem);
            SendAccess(playerid, "Вы успешно приобрели %d EXP для своей семьи.", fix_listitem);

            ShowPlayerDonate(playerid, DONATE_TYPE_OTHER);

