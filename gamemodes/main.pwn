                    p_info[playerid][p_settings][listitem+18] ^= 1;
                    TogglePlayerHudElement(playerid, listitem == HUD_ELEMENT_VOICE ? listitem+1 : listitem, p_info[playerid][p_settings][listitem+18]);

                    SendAccess(playerid, "Вы %s отображения %s.", p_info[playerid][p_settings][listitem+18] == 1 ? "включили" : "выключили", hud_element_name[listitem]);
