BusGoNext(playerid)
{
    new i = p_temp[playerid][pPressed], type = GetPVarInt(playerid, "TypeBus");
    switch(type)
    {
        case 1: SetPlayerRaceCheckpoint(playerid,0,BusCityLS[i][0],BusCityLS[i][1],BusCityLS[i][2],BusCityLS[i][3],BusCityLS[i][4],BusCityLS[i][5],7.0);
        case 2: SetPlayerRaceCheckpoint(playerid,0,BusCitySF[i][0],BusCitySF[i][1],BusCitySF[i][2],BusCitySF[i][3],BusCitySF[i][4],BusCitySF[i][5],7.0);
        case 3: SetPlayerRaceCheckpoint(playerid,0,BusCityLV[i][0],BusCityLV[i][1],BusCityLV[i][2],BusCityLV[i][3],BusCityLV[i][4],BusCityLV[i][5],7.0);
        case 4: SetPlayerRaceCheckpoint(playerid,0,BusSchool[i][0],BusSchool[i][1],BusSchool[i][2],BusSchool[i][3],BusSchool[i][4],BusSchool[i][5],7.0);
        case 5: SetPlayerRaceCheckpoint(playerid,0,BusLSLV[i][0],BusLSLV[i][1],BusLSLV[i][2],BusLSLV[i][3],BusLSLV[i][4],BusLSLV[i][5],5.0);
    }
}

PilotGoNext(playerid)
{
    new i = p_temp[playerid][pPressed], idx = GetPVarInt(playerid, "TypePilot") - 1;
    SetPlayerRaceCheckpoint(playerid, 1, PilotRoute[idx][i][0], PilotRoute[idx][i][1], PilotRoute[idx][i][2], PilotRoute[idx][i][3], PilotRoute[idx][i][4], PilotRoute[idx][i][5], 15.0);
    return 1;
}

ShowPlayer_Admin_Report_List(playerid)
{
    STRING_GLOBAL[0] = EOS;
    for(new i; i < MAX_ADMIN_REPORTS; i++)
    {
        if(aReportInfo[i][rPlayerID] == INVALID_PLAYER_ID) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s "I"[%d]"W" -\t \n", STRING_GLOBAL, i+1);
        else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s "I"[%d]"W" %s\t[%s]\n", STRING_GLOBAL, i+1, get_name(aReportInfo[i][rPlayerID]), aReportInfo[i][rIsTooked] == false ? "{33CC66}���������"W"" : "{FF0000}�����"W"");
    }
    ShowPlayerDialog(playerid, D_REPORT_LIST, DIALOG_STYLE_TABLIST, ""I"��������� � �������������", STRING_GLOBAL, "�����", "������");
    return 1;
}

AddMafiaBank(bizz_id, sum)
{
    switch(b_info[bizz_id][b_mafia])
    {
        case MAFIA_RM: gBankMafia[0][bizz_id] += sum;
        case MAFIA_LCN: gBankMafia[1][bizz_id] += sum;
        case MAFIA_YAKUDZA: gBankMafia[2][bizz_id] += sum;
        case BIKER: gBankMafia[3][bizz_id] += sum;
        case MAFIA_IRAN: gBankMafia[4][bizz_id] += sum;
        case NONE_FRACTION: return 1;
    }
    save_bizz(bizz_id);
    return 1;
}

public OnPlayerEditObject(playerid, playerobject, objectid, response, Float:fX, Float:fY, Float:fZ, Float:fRotX, Float:fRotY, Float:fRotZ)
{
    if(response == EDIT_RESPONSE_FINAL)
    {// player clicked on sav�
        /*
        if(p_temp[playerid][tl_id] != -1)
        {
            new idx = p_temp[playerid][tl_id];
            GetPlayerFacingAngle(playerid, fRotZ);

            TL_Data[idx][tl_object_pos][0] = fX;
            TL_Data[idx][tl_object_pos][1] = fY;
            TL_Data[idx][tl_object_pos][2] = fZ;

            new Float:rz = fRotZ;
            if(rz >= 315.0 && rz <= 360.0 || rz >= 0.0 && rz <= 45.0) fRotZ = 360.0; //0/360
            if(rz > 45.0 && rz < 135.0) fRotZ = 90.0;
            if(rz >= 135.0 && rz <= 225.0) fRotZ = 180.0;
            if(rz > 225.0 && rz < 315.0) fRotZ = 270.0;

            CreateTrafficLight(fX, fY, fZ, fRotZ);
            TL_Data[idx][tl_object_pos][3] = fRotZ;

            // 180 x+ ||  270 x-
            //if(z_angle-90 < 0) z_angle = (360+z_angle)-90;
            TL_Data[idx][tl_area_pos][0] = fX;
            TL_Data[idx][tl_area_pos][1] = fY;
            if(fRotZ == 180.0) TL_Data[idx][tl_area_pos][0] += 5.0;
            if(fRotZ == 360.0) TL_Data[idx][tl_area_pos][0] -= 5.0;
            if(fRotZ == 90.0) TL_Data[idx][tl_area_pos][1] -= 5.0;
            if(fRotZ == 270.0) TL_Data[idx][tl_area_pos][1] += 5.0;

            totaltl++;
            DestroyObject(objectid);
        }
        */
        if(GetPVarInt(playerid, "addrad") == 1)
        {
            RadarInfo[TOTALRADAR][rX] = fX;
            RadarInfo[TOTALRADAR][rY] = fY;
            RadarInfo[TOTALRADAR][rZ] = fZ;
            RadarInfo[TOTALRADAR][rRZ] = fRotZ;

            RadarInfo[TOTALRADAR][rSpeed] = GetPVarInt(playerid, "speed");

            RadarInfo[TOTALRADAR][rID] = TOTALRADAR+1;
            RadarInfo[TOTALRADAR][rRadius] = GetPVarInt(playerid, "radius");

            RadarInfo[TOTALRADAR][rArea] = CreateDynamicSphere(fX,fY,fZ, 20.0, 0, 0, -1);
            UpdateAreaInfo(RadarInfo[TOTALRADAR][rArea], TYPE_RADAR, AREA_SUBTYPE_INVALID_ID, TOTALRADAR);

            RadarInfo[TOTALRADAR][rMapIcon] = CreateDynamicMapIcon(fX,fY,fZ, 34, -1, 0, -1, -1, 100.0);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `radars` (`rX`, `rY`, `rZ`, `rRZ`, `rSpeed`, `rRadius`) VALUES ('%f', '%f', '%f', '%f', %d, %d)",
                fX, fY, fZ, fRotZ, RadarInfo[TOTALRADAR][rSpeed], RadarInfo[TOTALRADAR][rRadius]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "����� �%d\n����������� ��������: %d KM/H", RadarInfo[TOTALRADAR][rID], RadarInfo[TOTALRADAR][rSpeed]);
            RadarInfo[TOTALRADAR][r3DText] = CreateDynamic3DTextLabel(STRING_GLOBAL, COLOR_MAIN, RadarInfo[TOTALRADAR][rX], RadarInfo[TOTALRADAR][rY], RadarInfo[TOTALRADAR][rZ], 20.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, streamer_TESTLOL, -1, -1, -1);

            DeletePVar(playerid, "addrad");
            DeletePVar(playerid, "speed");
            DeletePVar(playerid, "radius");
        }
    }
    else if(response == EDIT_RESPONSE_CANCEL){// player cancelled (ESC)
        //if(p_temp[playerid][tl_id] != -1) p_temp[playerid][tl_id] = -1;
        DestroyObject(objectid);
        if(GetPVarInt(playerid, "addrad") > 0) {
            TOTALRADAR--;
            DeletePVar(playerid, "addrad");
            DeletePVar(playerid, "speed");
            DeletePVar(playerid, "radius");
        }
    }
    else if(response == EDIT_RESPONSE_UPDATE){// player moved the object (edition did not stop at all)
        SetObjectPos(objectid, fX, fY, fZ);
        SetObjectRot(objectid, fRotX, fRotY, fRotZ);
    }
    return 1;
}

static const cmd_white_list[][] =
{
    "report", "time", "me", "todo", "do", "b", "n",
    "fb", "f", "r", "rb", "d", "db",
    "p", "h", "sms", "cctv", "interface"
};
///////////////////////////////////////////////
public OnPlayerCommandText(playerid, cmdtext[]) return 0;
//////////////////////////
public OnPlayerCommandReceived(playerid, cmd[], params[], flags)
{
    //printf("%s OnPlayerCommandReceived(playerid = %i, cmd = %s, params = %s | timestamp %d  | Flood %d", get_name(playerid), playerid, cmd, params, timestamp, GetPVarInt(playerid, "Flood:CMD"));
    //Log(LOG_sscanf, INFO, "%s playerid = %i, cmd = %s, params = %s", get_name(playerid), playerid, cmd, params);

    if(p_info[playerid][loggedIn] != 1) return SendError(playerid, "�� �� ������������.") & 0;
    if(p_temp[playerid][TextDrawCaptcha] != 0) return SendError(playerid, "������� ����� ��� ������� ������.") & 0;
    if(p_temp[playerid][AntiFloodCMD] > timestamp) return SendError(playerid, "�� �� ������ ��� ����� ������������ �������.") & 0;
    p_temp[playerid][AntiFloodCMD] = timestamp+1;
    if(p_temp[playerid][MDC_BODYCAM] != INVALID_PLAYER_ID) return 0;

    if(GetPVarInt(playerid, "advert_id_to_sending"))
        return SendError(playerid, "� ��� ������� ����������, ��������, ��������� ��� ��������� ���.") & 0;

    new text_cmd = 0;
    if(p_info[playerid][exchangePartner] != INVALID_PLAYER_ID)
    {
        for(new i; i < sizeof(cmd_white_list); i++)
            if(strequals(cmd, cmd_white_list[i])) text_cmd++;
        if(text_cmd) return SendError(playerid, "� ��� ������������ �����. ��������� ���.") & 0;
        if(!strequals(cmd, "ready") &&
        !strequals(cmd, "stopex") &&
        !strequals(cmd, "bet") &&
        !strequals(cmd, "apanel") &&
        !strequals(cmd, "unbet")) return SendError(playerid, "� ��� ������������ �����. ��������� ���.") & 0;
    }

    if(GetPVarInt(playerid,"Conv") == 1 || GetPVarInt(playerid, "PlayerCuffed") == 1)
    {
        for(new i; i < sizeof(cmd_white_list); i++)
            if(strequals(cmd, cmd_white_list[i])) text_cmd++;
        if(!text_cmd) return SendError(playerid, "�� ��� �������.") & 0;
    }

    if((p_info[playerid][pfreeze] == 0 || p_temp[playerid][death_status] == 1) && p_info[playerid][admin] < 1)
    {
        for(new i; i < sizeof(cmd_white_list); i++)
            if(strequals(cmd, cmd_white_list[i])) text_cmd++;
        if(!text_cmd) return SendError(playerid, "�� ����������, ������ �������� ����������.") & 0;
    }
    if(p_temp[playerid][DuelID] != INVALID_PLAYER_ID)
    {
        if(strequals(cmd, "mask") || strequals(cmd, "go") || strequals(cmd, "gomp"))
            return SendError(playerid, "�� �� �����, ������ �������� ����������.") & 0;
    }
    if( strfind(params, "`",true) !=-1 ||
        strfind(params, "accounts",true) !=-1 ||
        strfind(params, "delete",true) !=-1 ||
        strfind(params, "update",true) !=-1 ||
        (strfind(params, "{",true) !=-1  && strfind(params, "}",true) !=-1))
        return SendError(playerid, "�� ����������� ����������� �������.") & 0;

    if(admin_acces[playerid] == false && p_info[playerid][admin] > 0) return callcmd::alogin(playerid, "/0") & 0;
    if(CheckBinderCommand(playerid, cmd)) return 0;
    return 1; //
}
public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
    return 1;
}

alias:escape("usekey");
CMD:escape(playerid, params[])
{
    if(p_info[playerid][jail] == 0) return SendError(playerid, "�� �� ���������� � ������.");
    if(p_info[playerid][jail] == 6) return SendError(playerid, "�� �� ������ ������������ ������� � ���������.");
    if(p_info[playerid][jail_time] < 60) return SendError(playerid, "��� �������� ������ ������ � ������.");
    if(p_temp[playerid][prison_escape] != 0 || p_temp[playerid][prison_escape_time] != 0) return SendError(playerid, "�� ��� ����������� ����� ������.");
    if(p_info[playerid][escape_limit] > 0) return SendError(playerid, "�� �� ������ ��������� ����� ��� � ������� %d ���(-�/-��).", p_info[playerid][escape_limit]);
    if(!GivePlayerInventory(playerid, 637, -1)) return SendError(playerid, "� ��� ��� �������.");
    p_temp[playerid][prison_escape] = 1;
    p_info[playerid][escape_limit] = 3;

    p_temp[playerid][mini_games_type] = 1;
    ShowTextDrawForPlayer(playerid, TD_ID_MINI_GAMES);

    SendInfoMessage(playerid, "�� ������ ����� �� ������, ��� ���������� ������ ���� ����.");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] �������� ��������� ����� �� ������.", get_name(playerid), playerid);
    SendFractionMessage(POLICE_LS, 0x33CC66FF, STRING_GLOBAL);
    SendFractionMessage(POLICE_SF, 0x33CC66FF, STRING_GLOBAL);
    SendFractionMessage(POLICE_LV, 0x33CC66FF, STRING_GLOBAL);
    SendFractionMessage(PRISON, 0x33CC66FF, STRING_GLOBAL);
    SendFractionMessage(FBI_TEAM, 0x33CC66FF, STRING_GLOBAL);
    SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);
    return 1;
}

CMD:fban(playerid, params[])
{
    if(p_info[playerid][youtube_adm] < 2 && p_info[playerid][youtube_adm] < 3)
        return 1;

    new target, days, reason[144];
    if(sscanf(params, "uis[144]", target, days, reason)) return SendInfo(playerid, "�����������: /fban [id ������] [���-�� ����] [�������]");

    if(target == INVALID_PLAYER_ID)
        return SendError(playerid, "����� �� ������.");

    if(!(1 <= days <= 30))
        return SendError(playerid, "���-�� ���� ���������� ������ ���� �� ����� 1 � �� ����� 30.");

    if(p_info[target][admin] >= p_info[playerid][admin] || FD(target))
        return SendError(playerid, "� ��� ������� ��������� ������� ��������������.");

    if(AdvertisingCheck(reason)) return AdvertisingPunishment(playerid, reason, 0);
    if(IsAAdminAttack(playerid, 7)) return 1;

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "������������� %s [%d] ������������ %s [%d] �� %d %s. �������: %s", get_name(playerid), playerid, get_name(target), target, days, Declension_ReturnWord(days, "����", "���", "����"), reason);
    SendAdminMessageForServer(COLOR_LIGHTRED, STRING_GLOBAL);

    new
        year,
        month,
        day;

    getdate(year, month, day);


    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"��������! ��� ������ ��� {"#cLIGHTRED"}��������.\n\
        "W"��� �������(�): {"#cLIGHTRED"}%s\n\
        "W"�����: {"#cLIGHTRED"}%02d:%02d:%02d\n\
        "W"����: {"#cLIGHTRED"}%d.%d.%d\n\
        "W"�������: {"#cLIGHTRED"}%s\n\
        "W"������ �����: {"#cLIGHTRED"}%d ����\n\n\
        ����� ���������: {"#cLIGHTRED"}"FORUM_URL"\n"W"����� > ������ > {"#cLIGHTRED"}������ �� �������������",
        get_name(playerid),
        timestamp_hour, timestamp_minute, timestamp_second,
        year, month, day,
        reason,
        days);

    ShowPlayerDialog(target,D_NULL,DIALOG_STYLE_MSGBOX, ""I"����������", STRING_GLOBAL,"�������","");
    Kick(target);
    return 1;
}

