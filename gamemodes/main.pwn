            if(price < 1 || price > 10) return ShowPlayerDialog(playerid, D_NEWS_SET_CALL, DIALOG_STYLE_INPUT, ""I"��������� 1 ������� �����", ""W"������� ��������� 1 ������� � �����:\n\n{"#cLIGHTRED"}�������� ��������! ��������� ������ ���� �� ����� 1$ � �� ����� 10$.", "�����", "������");
            switch(p_info[playerid][member])
