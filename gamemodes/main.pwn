            if(p_info[playerid][cash] < tax) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx), SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");
            UndergroundBotsInfo[idx][ubTax] = 0;
