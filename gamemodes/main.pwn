                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name`, `count` FROM `donation` WHERE `count` != 0 ORDER BY `count` DESC");
                    new Cache:result = mysql_query(con_bd, STRING_GLOBAL);
                    new Name_tmp[32], count;
                    new rows;
                    cache_get_row_count(rows);
                    if(rows)
                    {
                        STRING_GLOBAL[0] = EOS;
                        for(new i; i < 25; i ++)
                        {
                            if(i >= rows) break;
                            cache_get_value_name(i, "name", Name_tmp, MAX_PLAYER_NAME);
                            cache_get_value_name_int(i, "count", count);
                            if(i == 0) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"%s[%d] %s - %d$\n", STRING_GLOBAL, i+1, Name_tmp, count);
                            else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s[%d] %s - %d$\n", STRING_GLOBAL, i+1, Name_tmp, count);
