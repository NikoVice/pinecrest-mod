                    undergroundbots_warehouse--;
                    if(undergroundbots_warehouse < 0) undergroundbots_warehouse = 0;
                    MysqlUpdateOtherInt("undergroundbots_warehouse", undergroundbots_warehouse);

                    OnServerInfoForMoney[10] += price;
