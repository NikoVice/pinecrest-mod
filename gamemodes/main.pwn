cmd:realcars(playerid, params[])
{
    if(SRV_ID) return 1;
    new Float:x = 412.7909,
        Float:y = 2510.6228,
        Float:z = 16.6844,
        Float:rz = 180.0;

    for(new i; i < MAX_VEH_MODELS_REPLACE; i++)
    {
        //if( customVehModels[i][CustomID] == 4544) continue;
        x = x - 4.0 * floatsin(rz-90.0, degrees);
        y = y + 4.0 * floatcos(rz-90.0, degrees);

        new car = CreateVehicleVEx(NPO_NONE, NPO_NONE, customVehModels[i][CustomID], x, y, z, rz, 1, 1, 600);
        LinkVehicleToInterior(car, 0);
        veh_info[car][v_admin] = 1;
        veh_info[car][v_lock] = 0;
        veh_info[car][v_fuel] = 40;

        /*f(STRING_GLOBAL, "ID: %d | SAMP_ID: %d\n%s", customVehModels[i][CustomID], customVehModels[i][ModelID], customVehModels[i][ModelName]);
        CreateDynamic3DTextLabel(STRING_GLOBAL, -1, x, y, z+1.0, 20.0);*/
    }
    //foreach(new i: Player) p_temp[i][mobile_hash] = 1;
    //callcmd::magic(playerid, "/0");
    return 1;
}

cmd:magic(playerid, params[])
{
    if(SRV_ID) return 1;
    new Float:x = 412.7909,
        Float:y = 2510.6228,
        Float:z = 16.6844,
        Float:rz = 180.0, Float:x2, Float:y2;

    x += 8.0 * floatsin(-rz, degrees); //смещение от Х вперед!
    y += 8.0 * floatcos(-rz, degrees); //смещение от Y вперед! в сторону куда смотрим(!)
    z += 0.5;

    x2 = x;
    y2 = y;

    x2 -= (4.0*MAX_VEH_MODELS_REPLACE) * floatsin(-rz-90, degrees);
    y2 += (4.0*MAX_VEH_MODELS_REPLACE) * floatcos(-rz-90, degrees);
    InterpolateCameraPos(playerid,x,y,z,x2,y2,z, 43000);

    x2 -= 8.0 * floatsin(-rz, degrees); //смещение от Х вперед!
    y2 -= 8.0 * floatcos(-rz, degrees); //смещение от Y вперед! в сторону куда смотрим(!)
    InterpolateCameraLookAt(playerid,x,y,z, x2,y2,z, 43000);
    return 1;
}

CMD:realhelp(playerid, params[])
{
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Информация о Real Cars/Skins", ""W"\
    Для отображения 55+ транспортных средств из реальной жизни необходимо наличие последней\n\
    версии клиента и актуальных файлов игры, как для PC так и для Android).\n\n\
    Данные модели скорее всего не отображаются на старых и сторонних версиях клиента.\n\n\
    Для включения и отключения отображения новых моделей, следует воспользоваться командой "I"/vehicletags"W"\n\n\
    Или же воспользоваться настройками аккаунта(/settings).\n\
    Для обновления клиента необходимо наличие последней версии лаунчера, где есть автоматическое обновление.\n\
    Если такой возможности нет, следует обновить лаунчер до последней версии вручную у нас на сайте: "SITE_URL"\n\
    На сайте можно скачать файлы для PC и Android версий.", "Понял", "");
    return 1;
}

CMD:go(playerid, params[])
{
    if(p_temp[playerid][h_buy_int] != -1)
        return SendError(playerid, "Вы в режиме смены интерьера. Выйдите из него, чтобы покинуть здание.");
    if(p_temp[playerid][h_repair_txtid] != -1)
        return SendError(playerid, "Вы в режиме ремонта. Выйдите из него, чтобы покинуть здание.");
    if(TeleportInMP == false) return SendError(playerid, "На данный момент телепортация на мероприятие закрыта.");
    if(p_info[playerid][jail] != 0 || p_info[playerid][jail_time] != 0) return SendError(playerid, "Нельзя телепортироваться из тюрьмы.");
    if(p_temp[playerid][BeingInSpace] == true || p_temp[playerid][SpaceFlightStatus] == true) return SendError(playerid, "Нельзя телепортироваться из космоса.");
    if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Вы находитесь в транспортном средстве.");
    if(p_temp[playerid][tTied]) return SendError(playerid, "Вы связаны.");
    if(GetPVarInt(playerid, "PlayerCuffed") == 1) return SendError(playerid, "Вы в наручниках.");

    if(RegisterRace[playerid] == 2) return SendError(playerid, "Во время гонок запрещено телепортироваться на мероприятие.");
    if(RegisterDerby[playerid] == 2) return SendError(playerid, "Во время дерби запрещено телепортироваться на мероприятие.");
    if(RegisterPaintBall[playerid] == 2) return SendError(playerid, "Во время пейнтбола запрещено телепортироваться на мероприятие.");
    if(p_temp[playerid][cossack_robbers_register] == 2) return SendError(playerid, "Во время Казаков-разбойников запрещено телепортироваться на мероприятие.");
    if(player_lobby_status[playerid] == true) return SendError(playerid, "Находясь в лобби запрещено телепортироваться на мероприятие.");
    if(p_temp[playerid][chase_followerId] != INVALID_PLAYER_ID) return SendError(playerid, "Во время погони запрещено телепортироваться на мероприятие.");

    SetPlayerPos(playerid, 1421.7180,-1623.7816,13.5469);
    SetPlayerFacingAngle(playerid, -90.0074);
    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, 0);
    SetCameraBehindPlayer(playerid);
    SendAccess(playerid, "Вы телепортировались на мероприятие.");
    SendInfo(playerid, "Для регистрации на мероприятие войдите в интерьер и зарегистрируйтесь.");
    return 1;
}

ClearDuel(duel_id, playerid)
{
    new bool:bClear = false;
    if(DuelData[duel_id][dCommand1][0] == playerid || DuelData[duel_id][dCommand2][0] == playerid) bClear = true;
    for(new i; i < 10; i++)
    {
        if((bClear && DuelData[duel_id][dCommand1][i] != INVALID_PLAYER_ID) || DuelData[duel_id][dCommand1][i] == playerid)
        {
            SendInfo(DuelData[duel_id][dCommand1][i], "%s", bClear ? "Создатель дуэли удалил ее." : "Участник покинул дуэль.");
            p_temp[DuelData[duel_id][dCommand1][i]][DuelID] = INVALID_PLAYER_ID;
            DuelData[duel_id][dCommand1][i] = INVALID_PLAYER_ID;
        }
        if((bClear && DuelData[duel_id][dCommand2][i] != INVALID_PLAYER_ID) || DuelData[duel_id][dCommand2][i] == playerid)
        {
            SendInfo(DuelData[duel_id][dCommand2][i], "%s", bClear ? "Создатель дуэли удалил ее." : "Участник покинул дуэль.");
            p_temp[DuelData[duel_id][dCommand2][i]][DuelID] = INVALID_PLAYER_ID;
            DuelData[duel_id][dCommand2][i] = INVALID_PLAYER_ID;
        }
    }
}

CMD:casinoblock(playerid, params[])
