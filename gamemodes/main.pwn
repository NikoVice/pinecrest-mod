                    SetPlayerInterior(playerid, 0);
                    SetPlayerVirtualWorld(playerid, 0);
                    SetPlayerPos(playerid, 2414.2959,1123.7134,10.8203);
                    SetPlayerFacingAngle(playerid, 270.0);
                }
                case 1: // кабинет
                {
                    if(GetFactionType(p_info[playerid][member]) != FACTION_TYPE_GOS && p_temp[playerid][keys_door] != PRISON)
                        return SendError(playerid, "Вы не работаете в тюрьме или у Вас нет пропуска.");
                    SetPlayerInterior(playerid, 1);
                    SetPlayerVirtualWorld(playerid, 1);
                    SetPlayerPos(playerid, 33.6339,1438.9664,2072.6711);
                    SetPlayerFacingAngle(playerid, 270.0);
                }
