        case D_WAREHOUSE:
        {
            if(!response) return 1;
            if(!army(playerid)) return SendError(playerid, "Вы не можете пользоваться этой командой.");
            if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "Вы должны находиться в транспортном средстве.");
            new vehicleid = GetPlayerVehicleID(playerid);
            if(GetVehicleModelEx(vehicleid) != 433) return SendError(playerid, "В данном транспортном средстве нет возможности перевозить материалы и патроны.");
            new idx = p_temp[playerid][p_listitem][listitem], fraction = WarehouseInfo[idx][WarehouseFraction];
            p_temp[playerid][p_listitem][listitem] = -1;
            WarehousePlayerStatus[playerid] = 1;
            WarehousePlayerIDx[playerid] = idx;
            WarehousePlayerFraction[playerid] = fraction;
            SetPlayerCheckpoint(playerid, FractionsData[fraction][fUnloadingPos][0], FractionsData[fraction][fUnloadingPos][1], FractionsData[fraction][fUnloadingPos][2], 7.5);
            SendAccess(playerid, "Вы начали выполнение гос. контракта.");
            SendInfo(playerid, "Название фракции: %s. Кол-во патронов: %d. Кол-во материалов: %d.", GetFractionName(fraction), WarehouseInfo[idx][WarehouseCartridges], WarehouseInfo[idx][WarehouseMaterials]);
            return 1;
