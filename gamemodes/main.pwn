            LinkVehicleToInterior(vehicleid, 0), SetVehicleVirtualWorld(vehicleid, 0);
            veh_info[vehicleid][v_lock] = 0;
            veh_info[vehicleid][v_color] = 1;
            veh_info[vehicleid][v_model] = 449;
            veh_info[vehicleid][v_fuel] = GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_FUEL);
            for(new i; i < 5; i++) veh_info[vehicleid][v_details][i] = 100.0;
            format(veh_info[vehicleid][v_number], 16, "NULL");
            veh_info[vehicleid][v_int] =
            veh_info[vehicleid][v_virt] =
            veh_info[vehicleid][v_insurance] =
            veh_info[vehicleid][v_insurance_time] = 0;
            veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];
            veh_info[vehicleid][v_used_key_ID] = playerid;
            p_temp[playerid][rented_veh] = vehicleid;
            PutPlayerInVehicle(playerid, vehicleid, 0);
            veh_info[vehicleid][v_engine] = 1;
            SetVehicleParamsVEx(vehicleid, veh_info[vehicleid][v_engine], veh_info[vehicleid][v_light], alarm, veh_info[vehicleid][v_lock], bonnet, boot, objective);
            OnPlayerUpdateVehicleInfo(playerid, SPEEDO_ENGINE);
            p_temp[playerid][TramVehicleIDx] = vehicleid;
            p_temp[playerid][TramTimer] = 0;
            p_temp[playerid][TramStop] = false;
            p_temp[playerid][TramStopIDx] = 0;
            p_temp[playerid][TramSpeedWarning] = 0;
            SetPlayerInterior(playerid, 0), SetPlayerVirtualWorld(playerid, 0);
            if(veh_info[vehicleid][v_text] == INVALID_3DTEXT_ID)
            {
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Водитель трамвая\nСлед. остановка: "W"%s"I"\nПроезд бесплатный", TramStopName[p_temp[playerid][TramStopIDx]]);
                veh_info[vehicleid][v_text] = Create3DTextLabel(STRING_GLOBAL, COLOR_MAIN, 0.0, 0.0, 0.0, 10.0, 0, 1);
                Attach3DTextLabelToVehicle(veh_info[vehicleid][v_text], vehicleid, 0.0, 0.0, 3.0);
            }
            p_temp[playerid][pPressed] = 0;
            new i = p_temp[playerid][pPressed];
            SetPlayerRaceCheckpoint(playerid, 0, Tram[i][tramPosX], Tram[i][tramPosY], Tram[i][tramPosZ]-1.5, Tram[i+1][tramPosX], Tram[i+1][tramPosY], Tram[i+1][tramPosZ]-1.5, 3.0);
        }
        case PILOT_WORK:
        {
            ShowPlayerDialog(playerid, D_PILOT_START_LIST, DIALOG_STYLE_LIST, ""I"Маршрут", ""I"[1]"W" Лос-Сантос - Сан-Фиерро\n"I"[2]"W" Лос-Сантос - Лас-Вентурас\n"I"[3]"W" Сан-Фиерро - Лос-Сантос\n"I"[4]"W" Сан-Фиерро - Лас-Вентурас\n"I"[5]"W" Лас-Вентурас - Лос-Сантос\n"I"[6]"W" Лас-Вентурас - Сан-Фиерро", "Далее", "Отмена");
        }
        case PANEL_WORK:
        {
            SetPlayerSkin(playerid, 26);
            p_temp[playerid][PanelIDx] = -1;
            p_temp[playerid][PanelSalary] = 0;
            for(new i = 0; i < 2; i++) p_temp[playerid][PanelObject][i] = INVALID_OBJECT_ID;
            SendMes(playerid, COLOR_SEA_WAVE, "Сядьте в свободный транспорт предназначенный для ремонтников солнечных панелей и возьмите заказ.");
            SendMes(playerid, COLOR_LIME, "Помощь по работе: {"#cLYELLOW"}/mn > [4] Помощь по игре > [13] Основные работы > [19] Ремонтник панелей");
        }
        case GREEN_HOUSES_WORK:
        {
            SetPlayerSkin(playerid, 44);
            p_temp[playerid][GreenHousesIDx] = -1;
            p_temp[playerid][GreenHousesSalary] = 0;
            p_temp[playerid][GreenHousesTimer] = 0;
            SendMes(playerid, COLOR_SEA_WAVE, "Отправляйтесь в теплицы и собирайте цветы.");
            SendMes(playerid, COLOR_LIME, "Помощь по работе: {"#cLYELLOW"}/mn > [4] Помощь по игре > [12] Первоначальные работы > [7] Работник теплицы");
        }
        case ROBBER_WORK:
        {
            SetPlayerSkin(playerid, random(2) == 0 ? 182 : 262);
            RobberIDx[playerid] = -1;
            RobberVehicleIDx[playerid] = INVALID_VEHICLE_ID;
            RobberAttachedObject[playerid] = 0;
            for(new i = 0; i < 3; i++) RobberMembersParty[playerid][i] = INVALID_PLAYER_ID;
            RobberParty[playerid] = INVALID_PLAYER_ID;
            SendMes(playerid, COLOR_SEA_WAVE, "Сядьте в свободный транспорт предназначенный для ограблений и возьмите заказ.");
            SendMes(playerid, COLOR_LIME, "Помощь по работе: {"#cLYELLOW"}/mn > [4] Помощь по игре > [12] Первоначальные работы > [6] Грабитель");
        }
        case DRUG_WORK:
        {
            SetPlayerSkin(playerid, gang(playerid) ? 146 : 144);
            new random_check = random(sizeof(drug_position)-1);
            p_temp[playerid][WorkCheckDrug] = random_check;
            p_temp[playerid][WorkCountDrug] = 0;
            SetPlayerCheckpoint(playerid, drug_position[random_check][0], drug_position[random_check][1], drug_position[random_check][2], 2.0);
            SendMes(playerid, COLOR_SEA_WAVE, "Чтобы начать сбор наркотиков отправляйтесь на место отмеченное на GPS навигаторе.");
        }
        case LABORATORY_WORK:
        {
            PreloadAnimLib(playerid, "CARRY");
            PreloadAnimLib(playerid, "SWORD");
            p_temp[playerid][LaboratoryTimer] = 0;
            p_temp[playerid][LaboratoryCount] = 0;
            p_temp[playerid][LaboratorySalary] = 0;
            p_temp[playerid][LaboratoryCheck] = 0;
            SendMes(playerid, COLOR_SEA_WAVE, "Подойдите к столу и нажмите ALT чтобы разработать медикаменты.");
            ShowTextDrawForPlayer(playerid, TD_ID_SALARY);
        }
        case HUNTING_WORK:
        {
            HuntingStatus[playerid] = true;
            ClearPlayerHunting(playerid, HUNTING_TYPE_CLEAR_START);
            SendMes(playerid, COLOR_BLUE, "Вы получили разрешение на охоту.");
            SendMes(playerid, COLOR_SEA_WAVE, "Для начала охоты Вам необходимо арендовать транспортное средство \"Bobcat\".");
        }
        case ELECTRIC_WORK:
        {
            SetPlayerSkin(playerid, 50);
            ElectricIDx[playerid] = -1;
            ElectricVehicleIDx[playerid] = INVALID_VEHICLE_ID;
            ElectricAttachedObject[playerid] = 0;
            ElectricType[playerid] = idx;
            for(new i = 0; i < 3; i++) ElectricMembersParty[playerid][i] = INVALID_PLAYER_ID;
            ElectricParty[playerid] = INVALID_PLAYER_ID;
            SendMes(playerid, COLOR_SEA_WAVE, "Сядьте в свободный транспорт предназначенный для электриков и введите /pl");
            SendMes(playerid, COLOR_LIME, "Помощь по работе: {"#cLYELLOW"}/mn > [4] Помощь по игре > [13] Основные работы > [11] Электрик");
        }
        case OIL_WORK:
        {
            for(new i = 0; i < 25; i++) p_temp[playerid][oil_object][i] = INVALID_OBJECT_ID;
            SetPlayerSkin(playerid, 61);
            SendMes(playerid, COLOR_SEA_WAVE, "Сядьте в свободный транспорт предназначенный для нефтяников и введите /oil");
            SendMes(playerid, COLOR_LIME, "Помощь по работе: {"#cLYELLOW"}/mn > [4] Помощь по игре > [13] Основные работы > [12] Нефтяник");
        }
        case TREASURE_HUNTER_WORK:
        {
            SetPlayerSkin(playerid, 26);
            SetPlayerAttachedObject(playerid, 0, 1269, 6, 0.278999, 0.000000, 0.722999, 0.100001, 15.699997, 88.600013, 1.000000, 1.000000, 1.000000, 0xFF2F4F4F, 0x0);
            SetPlayerAttachedObject(playerid, 1, 11749, 6, 0.463999, 0.008000, 1.371997, 0.000000, -75.400032, 0.000000, 5.536999, 3.069000, 2.344000, 0xFF2F4F4F, 0x0);
            SetPlayerAttachedObject(playerid, 2, 11749, 6, 0.464999, 0.008000, 1.371997, 0.000000, -75.400032, 90.099975, 5.536999, 3.069000, 2.344000, 0xFF2F4F4F, 0x0);
            SetPlayerAttachedObject(playerid, 3, 19942, 6, -0.063999, -0.023000, 0.305999, 0.000000, 105.399993, 118.299949, 1.642999, 0.868999, 0.755999);
            SetPlayerAttachedObject(playerid, 4, 19995, 6, 0.092000, 0.013000, 0.270000, 0.000000, -52.799999, -89.500000, 1.422996, 0.690000, 1.031000);
            SetPlayerAttachedObject(playerid, 5, 18634, 6, 0.324999, 0.004999, 0.810000, 25.900020, 97.399948, -114.699958, 0.257999, 1.542999, 0.719999, 0xFFFF0000, 0x0);
            SetPlayerAttachedObject(playerid, 6, 19421, 2, 0.045999, 0.000000, 0.001000, 90.699920, -3.999979, -89.300025, 1.018000, 0.886999, 0.759000);
            SendMes(playerid, COLOR_BLUE, "На карте отмечена специальная коричневая зона, в которой необходимо найти клад.");
            SendMes(playerid, COLOR_LIME, "Чтобы начать раскопки, воспользуйтесь командой {"#cLYELLOW"}/tr{"#cLIME"} возле места клада.");
            SendMes(playerid, COLOR_SEA_WAVE, "Во время раскопок необходимо открывать ячеки в поисках клада, но в одной из них находится бомба.");
            GangZoneShowForPlayer(playerid, treasure_hunter_zone, 0xCFB406AA);
            SetPlayerTHunter(playerid);
        }
    }
    p_temp[playerid][Work_ID] = type;
    return 1;
}

EndPlayerJob(playerid, type = 0)
{
    SendMes(playerid, COLOR_BLUE, "Вы завершили рабочий день.");

    new vehicleid = GetPlayerVehicleID(playerid), rent_vehicleid = p_temp[playerid][rented_veh], bool:change_skin = true, checkworkcar;

    if(rent_vehicleid != INVALID_VEHICLE_ID) checkworkcar = veh_info[rent_vehicleid][v_temp_job];

    for(new i = 0; i < 10; i++) if(IsPlayerAttachedObjectSlotUsed(playerid, i)) RemovePlayerAttachedObject(playerid, i);

    if(IsPlayerInAnyVehicle(playerid) && checkworkcar == 0) RemovePlayerFromVehicle(playerid);

    if(IsPlayerOwnerVehicle(playerid, vehicleid) && veh_info[vehicleid][v_job] == JOB_TC_TAXI && p_temp[playerid][Work_ID] == TAXI_WORK)
    {
        new Text3D:vehicle_text = veh_info[vehicleid][v_text];
        if(vehicle_text != INVALID_3DTEXT_ID)
        {
            Delete3DTextLabel(vehicle_text);
            veh_info[vehicleid][v_text] = INVALID_3DTEXT_ID;
        }
        p_temp[playerid][fix_flood] = INVALID_PLAYER_ID;
        p_temp[playerid][taxi_zp] = 0.0;
        p_temp[playerid][taxi_enter] = 0;
        veh_info[vehicleid][v_cost_taxi] = 0;
        veh_info[vehicleid][v_job] = 0;
        p_temp[playerid][fix_bug_biz_tc_salary] = 0;
        SendMes(playerid, COLOR_LYELLOW, "Заработная плата: {"#cLIME"}%d.", GetPVarInt(playerid, "@payment"));
        SendMes(playerid, COLOR_LYELLOW, "Кол-во пассажиров: {"#cLIME"}%d.", GetPVarInt(playerid, "@passenger_count"));
        DeletePVar(playerid, "@passenger");
        DeletePVar(playerid, "@passenger_count");
        change_skin = false;
    }

    if(p_info[playerid][taxi_idx] && rent_vehicleid != INVALID_VEHICLE_ID && veh_info[rent_vehicleid][v_job] == JOB_TC_TAXI)
    {
        if(veh_info[rent_vehicleid][v_text] != INVALID_3DTEXT_ID)
        {
            Delete3DTextLabel(veh_info[rent_vehicleid][v_text]);
            veh_info[rent_vehicleid][v_text] = INVALID_3DTEXT_ID;
        }
        veh_info[rent_vehicleid][v_cost_taxi] = 0;
        veh_info[rent_vehicleid][v_job] = 0;
        veh_info[rent_vehicleid][v_lock] = 0;

        p_temp[playerid][fix_flood] = INVALID_PLAYER_ID;
        p_temp[playerid][taxi_zp] = 0.0;
        p_temp[playerid][taxi_enter] = 0;
        p_temp[playerid][fix_bug_biz_tc_salary] = 0;
        SendMes(playerid, COLOR_LYELLOW, "Заработная плата: {"#cLIME"}%d.", GetPVarInt(playerid, "@payment"));
        SendMes(playerid, COLOR_LYELLOW, "Кол-во пассажиров: {"#cLIME"}%d.", GetPVarInt(playerid, "@passenger_count"));
        DeletePVar(playerid, "@passenger");
        DeletePVar(playerid, "@passenger_count");
        change_skin = false;
    }

    if(p_info[playerid][tc_idx] && rent_vehicleid != INVALID_VEHICLE_ID && (veh_info[rent_vehicleid][v_job] == JOB_TC_TRUCK || veh_info[rent_vehicleid][v_temp_job] == JOB_TC_TRUCK))
    {
        veh_info[rent_vehicleid][v_lock] = 0;
        p_temp[playerid][TruckerLoad] = 0;
        p_temp[playerid][TruckerSalary] = 0;
        new vehicleid = p_temp[playerid][TruckerTrailer];
        if(vehicleid != INVALID_VEHICLE_ID)
        {
            DestroyVehicleVEx(vehicleid);
            p_temp[playerid][TruckerTrailer] = INVALID_VEHICLE_ID;
        }
        p_temp[playerid][fix_bug_biz_tc_salary] = 0;
        change_skin = false;
    }

    switch(p_temp[playerid][Work_ID])
    {
        case GUN_FACTORY_WORK:
        {
            if(p_temp[playerid][GunFactoryLocat]) GunFactoryWorkTableStat[p_temp[playerid][GunFactoryLocat]-1] = false;
            p_temp[playerid][GunFactoryCheck] = 0;
            p_temp[playerid][GunFactoryIDx] = 0;
            p_temp[playerid][GunFactoryCount] = 0;
            p_temp[playerid][GunFactorySalary] = 0;
            p_temp[playerid][GunFactoryLocat] = 0;
        }
        case RAILWAY_WORK:
        {
            if(p_temp[playerid][RailwayLocat]) RailwayWorkTableStat[p_temp[playerid][RailwayLocat]-1] = false;
            p_temp[playerid][RailwayType] = 0;
            p_temp[playerid][RailwayCheck] = 0;
            p_temp[playerid][RailwayIDx] = 0;
            p_temp[playerid][RailwayCount][0] = 0;
            p_temp[playerid][RailwayCount][1] = 0;
            p_temp[playerid][RailwaySalary] = 0;
            p_temp[playerid][RailwayLocat] = 0;
            new idx = p_temp[playerid][RailwayObject];
            if(idx != INVALID_OBJECT_ID)
            {
                DestroyDynamicObject(idx);
                p_temp[playerid][RailwayObject] = INVALID_OBJECT_ID;
            }
        }
        case CAR_FACTORY_WORK:
        {
            if(CarFactoryIDx[playerid] != -1 && CarFactoryType[playerid] != -1)
            {
                new i = CarFactoryIDx[playerid], idx = CarFactoryType[playerid];
                if(CarFactory[i][cfPlayerID][idx] == playerid)
                {
                    CarFactory[i][cfPlayerID][idx] = INVALID_PLAYER_ID;
                    UpdateCarFactoryStatusPos(i, idx);
                }
            }

            CarFactoryIDx[playerid] = -1;
            CarFactoryType[playerid] = -1;
            CarFactoryCarParts[playerid] = -1;
            CarFactorySalary[playerid] = 0;

            HidePlayerCarFactory(playerid);
        }
        case FARM_WORK:
        {
            p_temp[playerid][FarmType] = 0;
            new vehicleid = p_temp[playerid][FarmTrailer];
            if(vehicleid != INVALID_VEHICLE_ID)
            {
                DestroyVehicleVEx(vehicleid);
                p_temp[playerid][FarmTrailer] = INVALID_VEHICLE_ID;
            }
            if(p_temp[playerid][FarmTrailerTimer])
            {
                KillTimer(p_temp[playerid][FarmTrailerTimer]);
                p_temp[playerid][FarmTrailerTimer] = 0;
            }
            if(p_temp[playerid][FarmTreeIDx] != -1)
            {
                new idx = p_temp[playerid][FarmTreeIDx];
                if(FarmTreeInfo[idx][ftPlayerID] == playerid)
                {
                    FarmTreeInfo[idx][ftPlayerID] = INVALID_PLAYER_ID;
                    UpdateFarm(TYPE_FARM_TREE, idx);
                }
            }
            if(p_temp[playerid][FarmMilkerIDx] != -1)
            {
                new idx = p_temp[playerid][FarmMilkerIDx];
                if(FarmMilkerInfo[idx][fmPlayerID] == playerid)
                {
                    FarmMilkerInfo[idx][fmPlayerID] = INVALID_PLAYER_ID;
                    UpdateFarm(TYPE_FARM_MILKER, idx);
                }
            }
            p_temp[playerid][FarmCheck] = 0;
            p_temp[playerid][FarmBucket] = 0;
            p_temp[playerid][FarmCount] = 0;
            p_temp[playerid][FarmSalary] = 0;
            p_temp[playerid][farm_use_idx] = -1;
            p_temp[playerid][farm_use_type] = -1;
            p_temp[playerid][farm_extraction_timer] = 0;
            if(p_temp[playerid][FarmBizIDx] != -1)
            {
                new idx = p_temp[playerid][FarmBizIDx];
                FarmWarehouseInfo[2][fwarCount] += b_info[idx][b_order];
                UpdateFarm(TYPE_FARM_PRODUCT, 2);
                MysqlUpdateOtherInt("farm_warehouse_product", FarmWarehouseInfo[2][fwarCount]);
                b_info[idx][b_order_player_id] = INVALID_PLAYER_ID;
                p_temp[playerid][FarmBizIDx] = -1;
            }
        }
        case CONSTRUCTION_WORK:
        {
            p_temp[playerid][ConstructionType] = 0;
            p_temp[playerid][ConstructionCheck] = 0;
            p_temp[playerid][ConstructionCount] = 0;
            p_temp[playerid][ConstructionSalary] = 0;
            new idx = p_temp[playerid][ConstructionObject];
            if(idx != INVALID_OBJECT_ID)
            {
                DestroyDynamicObject(idx);
                p_temp[playerid][ConstructionObject] = INVALID_OBJECT_ID;
            }
            p_temp[playerid][ConstructionIDx] = -1;
        }
        case SPACE_WORK:
        {
            if(p_temp[playerid][SpaceIDx] != 0) DestroySpaceFossils(playerid);
            p_temp[playerid][SpaceIDx] = 0;
            p_temp[playerid][SpaceTimer] = 0;
            p_temp[playerid][SpaceProgress] = 0;
            p_temp[playerid][SpaceCount] = 0;
            p_temp[playerid][SpaceSalary] = 0;
        }
        case THEFT_CAR_WORK:
        {
            DestroyTheftCarVehicle(playerid);
            ClearTheftCar(playerid, TYPE_THEFT_CAR_WORK);
        }
        case PIZZABOY_WORK:
        {
            p_temp[playerid][PizzaboyIDx] = -1;
            p_temp[playerid][PizzaboySalary] = 0;
        }
        case TAXI_WORK:
        {
            DestroyTaxi(playerid);
            p_temp[playerid][taxi_bots_idx] = 0;
            p_temp[playerid][taxi_bots_timer] = 0;
            p_temp[playerid][taxi_bots_salary] = 0;
            p_temp[playerid][taxi_bots_gps_idx] = 0;
            change_skin = false;
        }
        case TRUCK_WORK:
        {
            change_skin = false;
        }
        case BUS_WORK:
        {
            p_info[playerid][p_busTime] = 0;
            SendMes(playerid, COLOR_LYELLOW, "Заработная плата: {"#cLIME"}%d.", GetPVarInt(playerid, "BusMoney"));
            SendMes(playerid, COLOR_LYELLOW, "Кол-во пассажиров: {"#cLIME"}%d.", GetPVarInt(playerid, "@passenger_count"));
            SendMes(playerid, COLOR_LYELLOW, "Приобретение билетов: {"#cLIME"}%d.", GetPVarInt(playerid, "@payment")*GetPVarInt(playerid, "@passenger_count"));
            if(IsValidVehicle(rent_vehicleid))
            {
                new Float:healths;
                GetVehicleHealth(rent_vehicleid, healths);
                if(veh_info[rent_vehicleid][v_temp_job] == JOB_BUS) SendMes(playerid, COLOR_LIME, "За работу на личном транспортном средстве к заработной плате добавлено: {"#cLYELLOW"}%d$.", (GetPVarInt(playerid, "BusMoney") / 100) * 20);
                else SendMes(playerid, COLOR_LYELLOW, "Ремонт транспортного средства: {"#cLIME"}%d.", floatround(floatsub(1000.0, healths)));
            }
            DeletePVar(playerid, "BusMoney");
            DeletePVar(playerid, "@passenger_count");
            DeletePVar(playerid, "TypeBus");
            change_skin = false;
        }
        case MECHANIC_WORK:
        {
            DeletePVar(playerid,"toplivo");
            DeletePVar(playerid,"MehName");
            ResetPlayerWeapons(playerid);
            DestroyMechanic(playerid);
            for (new i; i < MAX_WEAPONS; i++)
            {
                if(p_info[playerid][Weapon][i] == 42)
                {
                    p_info[playerid][Weapon][i] = 0;
                    p_info[playerid][Ammo][i] = 0;
                    p_temp[playerid][mechanic_ammo] = 0;
                    continue;
                }
                GivePlayerWeapon(playerid, p_info[playerid][Weapon][i], p_info[playerid][Ammo][i]);
            }
            p_temp[playerid][mechanic_idx] = 0;
            p_temp[playerid][mechanic_timer] = 0;
            p_temp[playerid][mechanic_salary] = 0;
            p_temp[playerid][mechanic_exting] = 0;
            p_temp[playerid][mechanic_exting_count] = 0;
            p_temp[playerid][mechanic_ammo] = 0;
            change_skin = false;
        }
        case ROADMAN_WORK:
        {
            p_temp[playerid][roadman_check] = 0;
            p_temp[playerid][roadman_use_idx] = -1;
            p_temp[playerid][roadman_hash_idx] = -1;
            p_temp[playerid][roadman_extraction_timer] = 0;

            for(new i = 0; i < MAX_ROADCRASH_VEHICLE_TRASH; i++)
            {
                if(p_temp[playerid][roadman_object][i] != INVALID_OBJECT_ID)
                {
                    DestroyDynamicObject(p_temp[playerid][roadman_object][i]);
                    p_temp[playerid][roadman_object][i] = INVALID_OBJECT_ID;
                }
            }
        }
        case COLLECTOR_WORK:
        {
            new idx = CollectorIDx[playerid];
            if(idx != -1) ATMInfo[idx][aPlayerID] = INVALID_PLAYER_ID;
            CollectorIDx[playerid] = -1;
            CollectorVehicleIDx[playerid] = INVALID_VEHICLE_ID;
            CollectorAttachedObject[playerid] = 0;
            for(new i = 0; i < 3; i++)
            {
                new scdplayerid = CollectorMembersParty[playerid][i];
                if(scdplayerid != INVALID_PLAYER_ID)
                {
                    if(IsPlayerConnected(scdplayerid))
                    {
                        SendInfo(scdplayerid, "%s [%d] завершил(-а) рабочий день, Вы больше не работаете совместно.", get_name(playerid), playerid);
                        CollectorParty[scdplayerid] = INVALID_PLAYER_ID;

                        DisablePlayerCheckpoint(scdplayerid);
                        new idx = CollectorIDx[scdplayerid];
                        if(idx != -1) ATMInfo[idx][aPlayerID] = INVALID_PLAYER_ID;
                        CollectorIDx[scdplayerid] = -1;
                        CollectorVehicleIDx[scdplayerid] = INVALID_VEHICLE_ID;
                        CollectorAttachedObject[scdplayerid] = 0;
                        p_temp[scdplayerid][p_GPS] = false;
                    }
                }
                CollectorMembersParty[playerid][i] = INVALID_PLAYER_ID;
            }
            if(CollectorParty[playerid] != INVALID_PLAYER_ID)
            {
                new scdplayerid = CollectorParty[playerid];
                if(IsPlayerConnected(scdplayerid))
                {
                    for(new i = 0; i < 3; i++)
                    {
                        if(CollectorMembersParty[scdplayerid][i] == playerid)
                        {
                            SendInfo(scdplayerid, "%s [%d] завершил(-а) рабочий день, Вы больше не работаете совместно.", get_name(playerid), playerid);
                            CollectorMembersParty[scdplayerid][i] = INVALID_PLAYER_ID;
                        }
                    }
                }
                CollectorParty[playerid] = INVALID_PLAYER_ID;
            }
        }
        case FIREMAN_WORK:
        {
            if(p_temp[playerid][FireStatus] != 0) DestroyFire(playerid);
            p_temp[playerid][FireStatus] = 0;
            p_temp[playerid][FireTimer] = 0;
            p_temp[playerid][FireExting] = 0;
            p_temp[playerid][FireExtingCount] = 0;
            p_temp[playerid][FireAmmo] = 0;
            ResetPlayerWeapons(playerid);
            for (new i; i < MAX_WEAPONS; i++)
            {
                if(p_info[playerid][Weapon][i] == 42)
                {
                    p_info[playerid][Weapon][i] = 0;
                    p_info[playerid][Ammo][i] = 0;
                    p_temp[playerid][FireAmmo] = 0;
                    continue;
                }
                GivePlayerWeapon(playerid, p_info[playerid][Weapon][i], p_info[playerid][Ammo][i]);
            }
        }
        case TRAIN_WORK:
        {
            if(p_temp[playerid][TrainVehicleIDx] != INVALID_VEHICLE_ID)
            {
                new vehicleid = p_temp[playerid][TrainVehicleIDx];
                if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                {
                    Delete3DTextLabel(veh_info[vehicleid][v_text]);
                    veh_info[vehicleid][v_text] = INVALID_3DTEXT_ID;
                }
            }
            p_temp[playerid][TrainVehicleIDx] = INVALID_VEHICLE_ID;
            p_temp[playerid][TrainTimer] = 0;
            p_temp[playerid][TrainStop] = false;
            p_temp[playerid][TrainStopIDx] = 0;
            p_temp[playerid][TrainSpeedWarning] = 0;
            change_skin = false;
            SetCameraBehindPlayer(playerid);
        }
        case TRAM_WORK:
        {
            if(p_temp[playerid][TramVehicleIDx] != INVALID_VEHICLE_ID)
            {
                new vehicleid = p_temp[playerid][TramVehicleIDx];
                if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                {
                    Delete3DTextLabel(veh_info[vehicleid][v_text]);
                    veh_info[vehicleid][v_text] = INVALID_3DTEXT_ID;
                }
                DestroyVehicleVEx(vehicleid);
                veh_info[vehicleid][v_lock] = 0;
            }
            p_temp[playerid][TramVehicleIDx] = INVALID_VEHICLE_ID;
            p_temp[playerid][TramTimer] = 0;
            p_temp[playerid][TramStop] = false;
            p_temp[playerid][TramStopIDx] = 0;
            p_temp[playerid][TramSpeedWarning] = 0;
            SetCameraBehindPlayer(playerid);
        }
        case PILOT_WORK:
        {
            DeletePVar(playerid, "TypePilot");
            change_skin = false;
        }
        case PANEL_WORK:
        {
            new idx = p_temp[playerid][PanelIDx];
            if(idx != -1) PanelHouseInfo[idx][PanelHouseRepairPlayerID] = INVALID_PLAYER_ID;
            p_temp[playerid][PanelIDx] = -1;
            if(p_temp[playerid][TextDrawPanel] == true) HideTextDrawForPlayer(playerid, TD_ID_PANEL);
        }
        case ROBBER_WORK:
        {
            RobberIDx[playerid] = -1;
            RobberVehicleIDx[playerid] = INVALID_VEHICLE_ID;
            RobberAttachedObject[playerid] = 0;
            for(new i = 0; i < 3; i++)
            {
                new scdplayerid = RobberMembersParty[playerid][i];
                if(scdplayerid != INVALID_PLAYER_ID)
                {
                    if(IsPlayerConnected(scdplayerid))
                    {
                        SendInfo(scdplayerid, "%s [%d] завершил(-а) рабочий день, Вы больше не работаете совместно.", get_name(playerid), playerid);
                        RobberParty[scdplayerid] = INVALID_PLAYER_ID;

                        DisablePlayerCheckpoint(scdplayerid);
                        RobberIDx[scdplayerid] = -1;
                        RobberVehicleIDx[scdplayerid] = INVALID_VEHICLE_ID;
                        RobberAttachedObject[scdplayerid] = 0;
                        p_temp[scdplayerid][p_GPS] = false;
                    }
                }
                RobberMembersParty[playerid][i] = INVALID_PLAYER_ID;
            }
            if(RobberParty[playerid] != INVALID_PLAYER_ID)
            {
                new scdplayerid = RobberParty[playerid];
                if(IsPlayerConnected(scdplayerid))
                {
                    for(new i = 0; i < 3; i++)
                    {
                        if(RobberMembersParty[scdplayerid][i] == playerid)
                        {
                            SendInfo(scdplayerid, "%s [%d] завершил(-а) рабочий день, Вы больше не работаете совместно.", get_name(playerid), playerid);
                            RobberMembersParty[scdplayerid][i] = INVALID_PLAYER_ID;
                        }
                    }
                }
                RobberParty[playerid] = INVALID_PLAYER_ID;
            }
        }
        case GREEN_HOUSES_WORK:
        {
            new idx = p_temp[playerid][GreenHousesIDx];
            if(idx != -1)
            {
                FlowersGreenHousesInfo[idx][fPlayerID] = INVALID_PLAYER_ID;
                UpdateFlowers(idx);
            }
            p_temp[playerid][GreenHousesIDx] = -1;
            p_temp[playerid][GreenHousesSalary] = 0;
            p_temp[playerid][GreenHousesTimer] = 0;
        }
        case DRUG_WORK:
        {
            SetPlayerSkinEx(playerid);
            p_temp[playerid][WorkCheckDrug] = -1;
        }
        case LABORATORY_WORK:
        {
            p_temp[playerid][LaboratoryTimer] = 0;
            p_temp[playerid][LaboratoryCount] = 0;
            p_temp[playerid][LaboratorySalary] = 0;
            p_temp[playerid][LaboratoryCheck] = 0;
        }
        case HUNTING_WORK:
        {
            ClearPlayerHunting(playerid, HUNTING_TYPE_CLEAR_FINISH);
            change_skin = false;
        }
        case ELECTRIC_WORK:
        {
            new idx = ElectricIDx[playerid];
            if(idx != -1)
            {
                PowerLinesInfo[idx][plPlayerID] = INVALID_PLAYER_ID;
                PowerLinesInfo[idx][plRepair] = 0;
                PowerLinesInfo[idx][plMetal] = MAX_VEHICLE_POWER_LINES_COUNT;
            }
            ElectricIDx[playerid] = -1;
            ElectricVehicleIDx[playerid] = INVALID_VEHICLE_ID;
            ElectricAttachedObject[playerid] = 0;
            ElectricType[playerid] = 0;
            for(new i = 0; i < 3; i++)
            {
                new scdplayerid = ElectricMembersParty[playerid][i];
                if(scdplayerid != INVALID_PLAYER_ID)
                {
                    if(IsPlayerConnected(scdplayerid))
                    {
                        SendInfo(scdplayerid, "%s [%d] завершил(-а) рабочий день, Вы больше не работаете совместно.", get_name(playerid), playerid);
                        ElectricParty[scdplayerid] = INVALID_PLAYER_ID;

                        DisablePlayerCheckpoint(scdplayerid);
                        new idx = ElectricIDx[scdplayerid];
                        if(idx != -1)
                        {
                            PowerLinesInfo[idx][plPlayerID] = INVALID_PLAYER_ID;
                            PowerLinesInfo[idx][plRepair] = 0;
                            PowerLinesInfo[idx][plMetal] = MAX_VEHICLE_POWER_LINES_COUNT;
                        }
                        ElectricIDx[scdplayerid] = -1;
                        ElectricVehicleIDx[scdplayerid] = INVALID_VEHICLE_ID;
                        ElectricAttachedObject[scdplayerid] = 0;
                    }
                }
                ElectricMembersParty[playerid][i] = INVALID_PLAYER_ID;
            }
            if(ElectricParty[playerid] != INVALID_PLAYER_ID)
            {
                new scdplayerid = ElectricParty[playerid];
                if(IsPlayerConnected(scdplayerid))
                {
                    for(new i = 0; i < 3; i++)
                    {
                        if(ElectricMembersParty[scdplayerid][i] == playerid)
                        {
                            SendInfo(scdplayerid, "%s [%d] завершил(-а) рабочий день, Вы больше не работаете совместно.", get_name(playerid), playerid);
                            ElectricMembersParty[scdplayerid][i] = INVALID_PLAYER_ID;
                        }
                    }
                }
                ElectricParty[playerid] = INVALID_PLAYER_ID;
            }
        }
        case OIL_WORK:
        {
            for(new i = 0; i < 25; i++)
            {
                if(p_temp[playerid][oil_object][i] != INVALID_OBJECT_ID)
                {
                    DestroyDynamicObject(p_temp[playerid][oil_object][i]);
                    p_temp[playerid][oil_object][i] = INVALID_OBJECT_ID;
                }
            }
        }
        case TREASURE_HUNTER_WORK:
        {
            GangZoneHideForPlayer(playerid, treasure_hunter_zone);
        }
    }

    DisablePlayerRaceCheckpoint(playerid);
    DisablePlayerCheckpoint(playerid);
    Fix_TogglePlayerControllable(playerid, true);

    p_temp[playerid][Work_ID] = NONE_WORK;

    if(type == 0 && change_skin == true) SetPlayerSkinEx(playerid);

    ClearAnimations(playerid);
    //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);

    //for(new i; i < 3; i++) AntiCheatWarningTime[playerid][i] = 0;

    HideTextDrawForPlayer(playerid, TD_ID_SALARY);

    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);

    for(new i = 0; i < 25; i++)
    {
        if(i < 2 && p_temp[playerid][PanelObject][i] != INVALID_OBJECT_ID)
        {
            DestroyDynamicObject(p_temp[playerid][PanelObject][i]);
            p_temp[playerid][PanelObject][i] = INVALID_OBJECT_ID;
        }
        if(i < 5 && p_temp[playerid][FarmObject][i] != INVALID_OBJECT_ID)
        {
            DestroyDynamicObject(p_temp[playerid][FarmObject][i]);
            p_temp[playerid][FarmObject][i] = INVALID_OBJECT_ID;
        }
        if(i < 5 && p_temp[playerid][roadman_object][i] != INVALID_OBJECT_ID)
        {
            DestroyDynamicObject(p_temp[playerid][roadman_object][i]);
            p_temp[playerid][roadman_object][i] = INVALID_OBJECT_ID;
        }
        if(p_temp[playerid][oil_object][i] != INVALID_OBJECT_ID)
        {
            DestroyDynamicObject(p_temp[playerid][oil_object][i]);
            p_temp[playerid][oil_object][i] = INVALID_OBJECT_ID;
        }
    }

    p_temp[playerid][ExitCarTimer] = false;

    if(IsValidVehicle(rent_vehicleid) && IsPlayerRentedVehicle(playerid, rent_vehicleid) && veh_info[rent_vehicleid][v_loading] > 0)
    {
        veh_info[rent_vehicleid][v_loading] = 0;
        veh_info[rent_vehicleid][v_loading_playerid] = INVALID_PLAYER_ID;
        if(veh_info[rent_vehicleid][v_pickup] != -1)
        {
            DestroyDynamicPickup(veh_info[rent_vehicleid][v_pickup]);
            veh_info[rent_vehicleid][v_pickup] = -1;
        }
        if(veh_info[rent_vehicleid][v_text] != INVALID_3DTEXT_ID)
        {
            Delete3DTextLabel(veh_info[rent_vehicleid][v_text]);
            veh_info[rent_vehicleid][v_text] = INVALID_3DTEXT_ID;
        }
    }

    if(IsValidVehicle(rent_vehicleid) && IsPlayerRentedVehicle(playerid, rent_vehicleid) && (veh_info[rent_vehicleid][v_npoType] == NPO_JOB || veh_info[rent_vehicleid][v_temp_job] >= JOB_BUS))
    {
        veh_info[rent_vehicleid][v_temp_job] = 0;
        veh_info[rent_vehicleid][v_rented_ID] = INVALID_MYSQL_ID;
        veh_info[rent_vehicleid][v_used_key_ID] = INVALID_PLAYER_ID;
        if(checkworkcar == 0) SetVehicleToRespawn(rent_vehicleid);
        p_temp[playerid][rented_veh] = INVALID_VEHICLE_ID;
    }

    AttachToPlayerAccOrCostume(playerid, INVALID_PLAYER_ID);
    return 1;
}

distance_chat(playerid,Float:Radi=10.0,color,text[])
{
    new Float:pos[3];
    GetPlayerPos(playerid,pos[0],pos[1],pos[2]);
    foreach(new i: Player)
    {
        if(!p_info[i][loggedIn]) continue;
        if(IsPlayerInRangeOfPoint(i,Radi,pos[0],pos[1],pos[2])) if(GetPlayerVirtualWorld(i) == GetPlayerVirtualWorld(playerid) && GetPlayerInterior(playerid) == GetPlayerInterior(i) && p_temp[i][premiumgamer] != PREMIUM_GAME) SendMes(i, color, text);
    }
}

///gang capture 2.0
forward CaptureTimers(i);
public CaptureTimers(i)
{
    if(Capture_Info[i][gStatus] != GANG_ZONE_NONE)
    {
        if(Capture_Info[i][gTime] > 0)
        {
            Capture_Info[i][gTime]--;
            foreach(new playerid: Player)
            {
                if(Capture_Info[i][gFaction][0] != p_info[playerid][member] && Capture_Info[i][gFaction][1] != p_info[playerid][member]) continue;
                CaptureInfoUpdate(playerid, CAPTURE_ID_GANG, i, false);
            }
            if(Capture_Info[i][gTime] == 0)
            {
                if(Capture_Info[i][gStatus] == GANG_ZONE_PREPARATION)
                {
                    Capture_Info[i][gStatus] = GANG_ZONE_CAPTURE;
                    Capture_Info[i][gTime] = (60*20);
                    SendFractionMessage(Capture_Info[i][gFaction][0], 0x33CC66FF, "[F] Подготовка закончилась, начался захват территории.");
                    SendFractionMessage(Capture_Info[i][gFaction][1], 0x33CC66FF, "[F] Подготовка закончилась, начался захват территории.");
                }
            }
            SetTimerEx("CaptureTimers",1000,false, "i", i);
        }
        else
        {
            STRING_GLOBAL[0] = EOS;
            if((Capture_Info[i][gCount][0] > Capture_Info[i][gCount][1]) || (!Capture_Info[i][gCount][0] && !Capture_Info[i][gCount][1]))
            {
                GangZone_Info[Capture_Info[i][gGangZoneID]][g_Fraction] = Capture_Info[i][gFaction][0];

                f(STRING_GLOBAL, "[F] \"%s\" выиграла захват территории \"%s\".",GetFractionName(Capture_Info[i][gFaction][0]), GetFractionName(Capture_Info[i][gFaction][1]));

                GangCountTerritory[Capture_Info[i][gFaction][0]-10]++;
                GangCountTerritory[Capture_Info[i][gFaction][1]-10]--;

                UpdateInfoFractionWarehouse(Capture_Info[i][gFaction][0]);
                UpdateInfoFractionWarehouse(Capture_Info[i][gFaction][1]);

                if(Capture_Info[i][gGangZoneID] == 39)
                {
                    DrugDenInfo[ddOwner] = Capture_Info[i][gFaction][0];
                    SaveDrugDen();
                }
            }
            else if((Capture_Info[i][gCount][0] < Capture_Info[i][gCount][1]) || (Capture_Info[i][gCount][0] == Capture_Info[i][gCount][1]))
            {
                GangZone_Info[Capture_Info[i][gGangZoneID]][g_Fraction] = Capture_Info[i][gFaction][1];

                f(STRING_GLOBAL, "[F] \"%s\" отстояла территорию \"%s\".", GetFractionName(Capture_Info[i][gFaction][1]), GetFractionName(Capture_Info[i][gFaction][0]));
            }
            SendFractionMessage(Capture_Info[i][gFaction][0], 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(Capture_Info[i][gFaction][1], 0x33CC66FF, STRING_GLOBAL);

            new best_id[4];

            foreach(new playerid : Player)
            {
                if(Capture_Info[i][gFaction][0] != p_info[playerid][member] && Capture_Info[i][gFaction][1] != p_info[playerid][member]) continue;
                if(p_temp[playerid][CaptureBizWarInfoInt][0] > p_temp[best_id[0]][CaptureBizWarInfoInt][0]) best_id[0] = playerid;
                if(p_temp[playerid][CaptureBizWarInfoInt][1] > p_temp[best_id[1]][CaptureBizWarInfoInt][1]) best_id[1] = playerid;
                if(p_temp[playerid][CaptureBizWarInfoFloat][0] > p_temp[best_id[2]][CaptureBizWarInfoFloat][0]) best_id[2] = playerid;
                if(p_temp[playerid][CaptureBizWarInfoFloat][1] > p_temp[best_id[3]][CaptureBizWarInfoFloat][1]) best_id[3] = playerid;

                HideTextDrawForPlayer(playerid, TD_ID_CAPTURE);

                if(PlayerFixZone[playerid] != 0)
                {
                    PlayerFixZone[playerid] = 0;
                    GangZoneStopFlashForPlayer(playerid, i);
                }
            }

            STRING_GLOBAL[0] = EOS;
            if(best_id[0] == 0) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Лучший игрок на захвате по убийствам не определен.");
            else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Лучший игрок на захвате по убийствам %s [%d] (%s). Количество: %d.", get_name(best_id[0]), best_id[0], GetFractionName(p_info[best_id[0]][member]), p_temp[best_id[0]][CaptureBizWarInfoInt][0]);
            SendFractionMessage(Capture_Info[i][gFaction][0], 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(Capture_Info[i][gFaction][1], 0x33CC66FF, STRING_GLOBAL);
            STRING_GLOBAL[0] = EOS;
            if(best_id[1] == 0) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Лучший игрок на захвате по смертям не определен.");
            else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Лучший игрок на захвате по смертям %s [%d] (%s). Количество: %d.", get_name(best_id[1]), best_id[1], GetFractionName(p_info[best_id[1]][member]), p_temp[best_id[1]][CaptureBizWarInfoInt][1]);
            SendFractionMessage(Capture_Info[i][gFaction][0], 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(Capture_Info[i][gFaction][1], 0x33CC66FF, STRING_GLOBAL);
            STRING_GLOBAL[0] = EOS;
            if(best_id[2] == 0) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Лучший игрок на захвате по нанесенному урону не определен.");
            else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Лучший игрок на захвате по нанесенному урону %s [%d] (%s). Количество: %0.2f.", get_name(best_id[2]), best_id[2], GetFractionName(p_info[best_id[2]][member]), p_temp[best_id[2]][CaptureBizWarInfoFloat][0]);
            SendFractionMessage(Capture_Info[i][gFaction][0], 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(Capture_Info[i][gFaction][1], 0x33CC66FF, STRING_GLOBAL);
            STRING_GLOBAL[0] = EOS;
            if(best_id[3] == 0) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Лучший игрок на захвате по полученному урону не определен.");
            else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Лучший игрок на захвате по полученному урону %s [%d] (%s). Количество: %0.2f.", get_name(best_id[3]), best_id[3], GetFractionName(p_info[best_id[3]][member]), p_temp[best_id[3]][CaptureBizWarInfoFloat][1]);
            SendFractionMessage(Capture_Info[i][gFaction][0], 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(Capture_Info[i][gFaction][1], 0x33CC66FF, STRING_GLOBAL);

            GangZoneStopFlashForAll(GangZone_Info[Capture_Info[i][gGangZoneID]][gID]);
            GangZoneHideForAll(GangZone_Info[Capture_Info[i][gGangZoneID]][gID]);
            GangZoneShowForAll(GangZone_Info[Capture_Info[i][gGangZoneID]][gID], fraction_color[GangZone_Info[Capture_Info[i][gGangZoneID]][g_Fraction]]);
            save_gz(Capture_Info[i][gGangZoneID]);

            if(Capture_Info[i][gGangZoneID] == 39)
            {
                DrugDenInfo[ddCapture] = timestamp * (86400 * 3);
                SaveDrugDen();
            }
            Capture_Info[i][gGangZoneID] = INVALID_CRIMINAL_ZONE_ID;

            SetFractionSettings(Capture_Info[i][gFaction][0], fFreezeCapture, 0);
            SetFractionSettings(Capture_Info[i][gFaction][1], fFreezeCapture, 0);
            SetGangPC(Capture_Info[i][gFaction][0], INVALID_MYSQL_ID);
            SetGangPC(Capture_Info[i][gFaction][1], INVALID_MYSQL_ID);

            Capture_Info[i][gCount][0] = 0;
            Capture_Info[i][gCount][1] = 0;
            //Capture_Info[i][gTime][1] = timestamp+(60*50);
            Capture_Info[i][gStatus] = GANG_ZONE_NONE;//

            Capture_Info[i][gFaction][0] = 0;
            Capture_Info[i][gFaction][1] = 0;

            
        }
    }
}

IsPlayerToSquare(playerid, Float:min_x, Float:min_y, Float:max_x, Float:max_y) {
    new Float:pX1,Float:pY1,Float:pZ1;
    GetPlayerPos(playerid,pX1,pY1,pZ1);
    if((pX1 <= max_x && pX1 >= min_x) && (pY1 <= max_y && pY1 >= min_y)) return 1;
    return 0;
}

IsPlayerCaptureZone(playerid, Float:min_x, Float:min_y, Float:max_x, Float:max_y) {
    new Float:pX1,Float:pY1,Float:pZ1;
    GetPlayerPos(playerid,pX1,pY1,pZ1);

    new Float:width = max_x-min_x,
        Float:height = max_y-min_y;

    min_x = min_x - width/2;
    min_y = min_y - height/2;
    max_x = max_x + width/2;
    max_y = max_y + height/2;

    if((pX1 <= max_x && pX1 >= min_x) && (pY1 <= max_y && pY1 >= min_y)) return 1;
    return 0;
}

GetGangZoneID(playerid)
{
    new gangzoneid = p_temp[playerid][CriminalZoneID];
    if(gangzoneid != INVALID_CRIMINAL_ZONE_ID && !IsPlayerInDynamicArea(playerid, GangZone_Info[gangzoneid][g_Area]))
        gangzoneid = INVALID_CRIMINAL_ZONE_ID;

    return gangzoneid;
}

GetZonaName(Float:x, Float: y)
{
    for(new i = sizeof(gSAZones)-1; i != -1; i--)
    {
        if(x >= gSAZones[i][SAZONE_AREA][0] && x <= gSAZones[i][SAZONE_AREA][3] && y >= gSAZones[i][SAZONE_AREA][1] && y <= gSAZones[i][SAZONE_AREA][4])
            return i;
    }
    return 1;
}
GetCityName(Float: x,  Float: y)
{
    for(new i = sizeof(gSAZonesCity)-1; i != -1; i--)
    {
        if(x >= gSAZonesCity[i][SAZONE_AREA][0] && x <= gSAZonesCity[i][SAZONE_AREA][3] && y >= gSAZonesCity[i][SAZONE_AREA][1] && y <= gSAZonesCity[i][SAZONE_AREA][4])
            return i;
    }
    return 1;
}

GetPlayer2DZone(playerid, zone[], len)
{
    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);
    for(new i = MAX_ZONE_COUNT-1; i != -1; i--)
    {
        if(x >= gSAZones[i][SAZONE_AREA][0] && x <= gSAZones[i][SAZONE_AREA][3] && y >= gSAZones[i][SAZONE_AREA][1] && y <= gSAZones[i][SAZONE_AREA][4])
            return format(zone, len, gSAZones[i][SAZONE_NAME], 0);
    }
    return 0;
}

MENU_BIZ(playerid, bizz_id)
{
    if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return 1;
    if(p_info[playerid][exchangePartner] != INVALID_PLAYER_ID) return 1;
    new str[13];
    STRING_GLOBAL[0] = EOS;
    new till = b_info[bizz_id][_till];
    SetPVarInt(playerid, "bID", bizz_id);
    SetPVarInt(playerid, #BIZZ_TYPE_ID, b_info[bizz_id][_tip]);
    switch(b_info[bizz_id][_tip])
    {
        case B_SUPERMARKET:
        {
            f(STRING_GLOBAL,
                ""I"[1]"W" Телефон: Motorola DynaTAC (%d$)\n\
                "I"[2]"W" Изменить номер телефона (%d$)\n\
                "I"[3]"W" Аптечка (%d$ - 1 шт.)\n\
                "I"[4]"W" Маска (%d$ - 1 шт.)\n\
                "I"[5]"W" Сигарета (%d$ - 1 шт.)\n\
                "I"[6]"W" Кальян (%d$)\n\
                "I"[7]"W" Обычный балончик с краской (%d$)\n\
                "I"[8]"W" Краска для транспортного средства (%d$)\n\
                "I"[9]"W" Верёвка (%d$ - 1 шт.)\n\
                "I"[10]"W" Спички (%d$)\n\
                "I"[11]"W" Лотерейный билет (50000$)\n\
                "I"[12]"W" Старая карта кладов (5000$)", 2500 * till, 1000 * till, 300 * till, 500 * till, 250 * till, 10000 * till, 2500 * till, 20000 * till, 1000 * till, 250 * till);
        }
        case B_SHOP:
        {
            if(p_info[playerid][fwork] == true && p_info[playerid][member] != NONE_FRACTION)
            {
                if(p_info[playerid][fskin] == 252)
                {
                    SetPlayerFractionSkin(playerid);
                    save_player(playerid);
                    return 1;
                }
                else
                {
                    SendError(playerid, "Вы состоите во фракции, приобретение одежды невозможно.");
                    return 1;
                }
            }
            /*
            new Float:P_pos[4];
            GetPlayerPos(playerid, P_pos[0], P_pos[1], P_pos[2]);
            GetPlayerFacingAngle(playerid,P_pos[3]);
            SetPlayerCameraPos(playerid, P_pos[0] + 0.7*-floatsin(P_pos[3],degrees), P_pos[1] + 0.7*floatcos(P_pos[3],degrees), P_pos[2] + 0.5);
            SetPlayerCameraLookAt(playerid,P_pos[0], P_pos[1], P_pos[2]);
            */

            // Fix_TogglePlayerControllable(playerid, false);
            // SetPlayerPos(playerid,210.4674,-33.0304,1001.9297);
            // SetPlayerFacingAngle(playerid,123.6620);
            //SendInfo(playerid, "Далее: /next | Назад: /back | Приобрести: /buy | Отмена: /cancelbuy");
            SetPlayerSkin(playerid, (p_info[playerid][sex] == 2) ? (ItemsInfo[skinBuyMan[p_temp[playerid][shop_id]]][iModel]) : ( ItemsInfo[skinBuyMale[p_temp[playerid][shop_id]]][iModel]));
            format(str,sizeof(str),"%d$",(p_info[playerid][sex] == 2) ? (ItemsInfo[skinBuyMan[p_temp[playerid][shop_id]]][iPrice]) : (ItemsInfo[skinBuyMale[p_temp[playerid][shop_id]]][iPrice]));

            ShowTextDrawForPlayer(playerid, TD_ID_SHOP);
            PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], str);

            p_temp[playerid][shop_id] = 0;
            return 1;
        }
        case B_BAR:
        {
            f(STRING_GLOBAL, ""I"[1]"W" Пиво (%d$)\n"I"[2]"W" Вино (%d$)\n"I"[3]"W" Коньяк (%d$)\n"I"[4]"W" Водка (%d$)", 500 * till, 1000 * till, 1500 * till, 2000 * till);
        }
        case B_AMMO:
        {
            if(p_info[playerid][level] < 3) return SendError(playerid, "У Вас нет 3-го уровня.");
            if(p_info[playerid][Lic][LIC_WEAPON] != 1) return SendError(playerid, "У Вас нет лицензии на \"%s\".", name_license[LIC_WEAPON]);

            for (new i, j = sizeof(shopWEAPON); i < j; i++)
                f(STRING_GLOBAL, "%s"I"[%d]"W" %s (патрон - %i, цена - %i$)\n", STRING_GLOBAL, i+1, WEAPON_Name[shopWEAPON[i][g_Id]], shopWEAPON[i][g_Patr], shopWEAPON[i][g_Price] * till);
        }
        case B_EAT:
        {
            f(STRING_GLOBAL, ""I"[1]"W" Сэндвич (%d$)\n"I"[2]"W" Бургер (%d$)", 500 * till, 250 * till);
        }
        case B_REALTOR:
        {
            ShowPlayerDialog(playerid, D_REALTOR, DIALOG_STYLE_LIST, ""I"Риэлторское агентство", "\
                "I"[1]"W" Узнать свободные дома (2500$)\n\
                "I"[2]"W" Узнать свободные бизнесы (5000$)\n\
                "I"[3]"W" Узнать дома, которые скоро освободятся (1250$)\n\
                "I"[4]"W" Узнать бизнесы, которые скоро освободятся (2500$)\n\
                "I"[5]"W" Аукцион домов\n\
                "I"[6]"W" Аукцион бизнесов", "Далее", "Отмена");
            return 1;
        }
        case B_GYM:
        {
            if(GetPVarInt(playerid, "GymTrainingStyde"))
            {
                LeaveFromGym(playerid);
                SetTimerEx("FIX_GYM", 1100, 0, "i", playerid);
            }
            else if(p_info[playerid][style_styde] && GetPVarInt(playerid, "GymTrainingStyde") == 0)
            {
                SetPVarInt(playerid, "GymTrainingStyde", true);
                SendAccess(playerid, "Вы начали тренировку.");
                SendInfo(playerid, "Продолжайте тренироваться с грушей для изучения стиля боя.");

                new rskins[2] = {81, 80};
                SetPlayerSkin(playerid, rskins[random(2)]);
                SetPlayerFightingStyle(playerid, p_info[playerid][style_styde]+4);

                SetPlayerPos(playerid, 762.6852,5.6262,1000.7128);
                SetPlayerFacingAngle(playerid, 272.4190);
                SetCameraBehindPlayer(playerid);

                SetTimerEx("FIX_GYM", 1100, 0, "i", playerid);
            }
            else f(STRING_GLOBAL, ""I"[1]"W" Изучение боксерского стиля (%d$)\n"I"[2]"W" Изучение Кунг-Фу (%d$)\n"I"[3]"W" Изучение Тейк-Ван-До (%d$)", SET_GYM_BOXING, SET_GYM_KUNGFU, SET_GYM_KNEEHEAD);
        }
        case B_ACCESSORIES:
        {
            f(STRING_GLOBAL, ""I"[1]"W" Банданы\n"I"[2]"W" Панамы\n"I"[3]"W" Шапки\n"I"[4]"W" Каски\n"I"[5]"W" Берет\n"I"[6]"W" Ретро шляпы\n"I"[7]"W" Кепки\n"I"[8]"W" Кепки назад\n"I"[9]"W" Шляпы мафиози\n"I"[10]"W" Полицейские кепки\n"I"[11]"W" Шлемы\n"I"[12]"W" Модные шапки\n"I"[13]"W" Хоккейные маски\n"I"[14]"W" Модные шляпы\n"I"[15]"W" Шляпы шерифа\n"I"[16]"W" Наушники\n"I"[17]"W" Очки\n"I"[18]"W" Банданы назад\n"I"[19]"W" Маски");
        }
        case B_HOTEL:
        {
            f(STRING_GLOBAL, ""I"[1]"W" Список номеров\n"I"[2]"W" Оплата проживания\n"I"[3]"W" Выселиться из отеля");
        }
        case B_GARDEN_CENTER:
        {
            ShowPlayerDialog(playerid, D_GC, DIALOG_STYLE_TABLIST_HEADERS, ""I"Садовый центр", "[#] Название\tТип\n"I"[1]"W" Объекты для сада\tДом\n"I"[2]"W" Объекты для сада\tБизнес\n"I"[3]"W" Семена для сада\tДом", "Далее", "Отмена");
            return 1;
        }
        case B_CAR_SERVICE:
        {
            new bizid = GetPVarInt(playerid, "bID"), till = b_info[bizid][_till];
            f(STRING_GLOBAL, "\
                "I"[1]"W" Ремонт транспорта (%d$)\n\
                "I"[2]"W" Рем. комплект (%d$)", 1000 * till, 2000 * till);
        }
        case B_FOOD_STALL:
        {
            new bizid = GetPVarInt(playerid, "bID"), till = b_info[bizid][_till];
            f(STRING_GLOBAL, ""I"[1]"W" Сэндвич (%d$)\n"I"[2]"W" Бургер (%d$)\n"I"[3]"W" Вода (%d$)", 500 * till, 250 * till, 250 * till);
        }
        case B_FISH:
        {
            new bizid = GetPVarInt(playerid, "bID"), till = b_info[bizid][_till];
            f(STRING_GLOBAL, ""I"[1]"W" Удочка (%d$)\n"I"[2]"W" Леска (%d$)\n"I"[3]"W" Катушка (%d$)\n"I"[4]"W" Крючок (%d$)\n"I"[5]"W" Червяк (%d$)\n"I"[6]"W" Сеть (%d$)", 2500 * till, 500 * till, 750 * till, 50 * till, 10 * till, 5000 * till);
        }
        case B_BILLBOARD:
        {
            new bizid = GetPVarInt(playerid, "bID");
            ShowDialogBillboard(playerid, bizid, BB_LIST);
            return 1;
        }
        case B_REPAIR_ACCESSORIES:
        {
            ShowPlayerDialog(playerid, D_RA, DIALOG_STYLE_LIST, ""I"Мастерская одежды", ""I"[1]"W" Отремонтировать аксессуар\n"I"[2]"W" Изменить цвет аксессуара\n"I"[3]"W" Помощь по мастерской", "Далее", "Отмена");
            return 1;
        }
        case B_PANEL_STORE:
        {
            new bizid = GetPVarInt(playerid, "bID"), till = b_info[bizid][_till];
            f(STRING_GLOBAL, ""I"[1]"W" Солнечная батарея (%d$) [На складе: %d шт.]\n"I"[2]"W" Инструменты (%d$)", 150000 * till, panel_warehouse, 250 * till);
        }
        case B_CARD_STORE:
        {
            HousePlayerList(playerid, HOUSE_ID_CARD_STORE);
            return 1;
        }
        case B_FREELANCE: return ShowFreelance(playerid, FREELANCE_TYPE_NPC);
        case B_POWER_STATION, B_TUNING, B_TAXI, B_TRUCKER, B_TANK_FARM, B_OIL_RIG, B_CAR_SHOWROOM, B_ARENDS_VEHICLE: return 1;
        case B_WASH:
        {
            ShowPlayerDialog(playerid, D_WASH, DIALOG_STYLE_LIST, ""I"Прачечная", ""I"[1]"W" Постирать одежду\n"I"[2]"W" Помощь по прачечной", "Далее", "Отмена");
            return 1;
        }
        default: return 1;
    }
    SetPVarInt(playerid, #BIZZ_TYPE_ID, b_info[bizz_id][_tip]);
    return ShowPlayerDialog(playerid, D_BUY_MAGAZ, DIALOG_STYLE_LIST, ""I"Покупка", STRING_GLOBAL, "Купить","Отмена");
}
forward FIX_GYM(playerid);
public FIX_GYM(playerid)
{
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Спортзал", ""W"чтобы прокачать стиль Вам нужно сделать в сумме "I"1000 "W"ударов в грушу\nВернуться к тренеровке вы можете в любой момент!", "Понял", "Закрыть");
    return 1;
}

CMD:realtor(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 5.0, -1161.2366, 640.4775, 1052.3817)) return 1;
    ShowPlayerDialog(playerid, D_REALTOR, DIALOG_STYLE_LIST, ""I"Риэлторское агентство", "\
        "I"[1]"W" Узнать свободные дома (2500$)\n\
        "I"[2]"W" Узнать свободные бизнесы (5000$)\n\
        "I"[3]"W" Узнать дома, которые скоро освободятся (1250$)\n\
        "I"[4]"W" Узнать бизнесы, которые скоро освободятся (2500$)\n\
        "I"[5]"W" Аукцион домов\n\
        "I"[6]"W" Аукцион бизнесов", "Далее", "Отмена");
    return 1;
}

IsPlayerFractionMedic(playerid)
{
    if(playerid == INVALID_PLAYER_ID) return 1;
    if(p_info[playerid][fwork] == true && GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_MEDIC) return true;
    return false;
}

medic_car(carid)
{
    if(veh_info[carid][v_npoType] == NPO_FACTION && (veh_info[carid][v_npoId] == MEDIC_LS || veh_info[carid][v_npoId] == MEDIC_LV || veh_info[carid][v_npoId] == MEDIC_SF)) return true;
    return false;
}

cop_car(vehicleid)
{
    if(veh_info[vehicleid][v_npoType] == NPO_FACTION && (veh_info[vehicleid][v_npoId] == POLICE_LS || veh_info[vehicleid][v_npoId] == POLICE_LV || veh_info[vehicleid][v_npoId] == POLICE_SF || veh_info[vehicleid][v_npoId] == FBI_TEAM || veh_info[vehicleid][v_npoId] == POLICE_RC)) return true;
    return false;
}

IsPlayerFractionPolice(playerid)
{
    if(playerid == INVALID_PLAYER_ID) return 1;
    if((p_info[playerid][fwork] == true) && (GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_PD || GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_FBI)) return true;
    return false;
}

army(playerid)
{
    if(playerid == INVALID_PLAYER_ID) return 1;
    if((p_info[playerid][fwork] == true) && (GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_ARMY)) return true;
    return false;
}

gang(playerid)
{
    if(playerid == INVALID_PLAYER_ID) return 1;
    if(GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_GANG) return true;
    return false;
}

mafia(playerid)
{
    if(playerid == INVALID_PLAYER_ID) return 1;
    if(GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_MAFIA) return true;
    return false;
}

biker(playerid)
{
    if(playerid == INVALID_PLAYER_ID) return 1;
    if(GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_BIKER) return true;
    return false;
}

gos(playerid)
{
    if(playerid == INVALID_PLAYER_ID) return 1;
    if((p_info[playerid][fwork] == true) && (GetFactionType(p_info[playerid][member]) == FACTION_TYPE_GOS)) return true;
    return false;
}

arm_skin(playerid)
{
    if(playerid == INVALID_PLAYER_ID) return 1;
    if(GetFactionType(p_info[playerid][member]) == FACTION_TYPE_CRIMINAL && GetPlayerSkin(playerid) == 287) return true;
    return false;
}

stock SendFractionMessage(frac_id, color, string[])
{
    foreach(new i: gAdmins)
    {
        if(p_temp[i][tipster_frac] == frac_id &&
            p_temp[i][tipster_frac] != 0 &&
            p_info[i][p_settings][CHAT_FRACTION])
        {
            SendMes(i, 0xFFFF00FF, string);
        }
    }
    foreach(new i : gFactionPlayers[frac_id])
    {
        if(pSpectatorId[i] != INVALID_PLAYER_ID &&
            p_info[pSpectatorId[i]][admin] > 0 &&
            p_info[pSpectatorId[i]][p_settings][CHAT_FRACTION])
            SendMes(pSpectatorId[i], color, string);
        if(p_info[i][fwork] && p_info[i][p_settings][CHAT_FRACTION])
            SendMes(i, color, string);
    }
    return 1;
}

SetPlayerCuffed(playerid, bool:type)
{
    if(type)
    {
        //SetPlayerAttachedObject(playerid, 4, 19418, 6, -0.011, 0.028, -0.022, -15.600, -33.699, -81.700, 0.891, 1.000, 1.168);
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CUFFED);
    }
    else
    {
        //RemovePlayerAttachedObject(playerid, 4);
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
    }
    return true;
}
OnPlayerInConvoi(playerid)
{
    new bool:current;
    if(!IsPlayerConnected(GetPVarInt(playerid,"Ved")))
    {
        SetPVarInt(playerid,"Ved",0);
        SendError(playerid, "Игрок не найден.");
        SendInfo(playerid, "Конвой завершен.");
        DeletePVar(playerid,"PlayerCuffed");
        SetPVarInt(playerid,"Conv",0);
        Fix_TogglePlayerControllable(playerid, true);
        ClearAnimations(playerid);
        return true;
    }
    if(!IsPlayerConnected(playerid))
    {
        SendError(GetPVarInt(playerid,"Ved"), "Игрок не найден.");
        SendInfo(GetPVarInt(playerid,"Ved"), "Конвой завершен.");
        return true;
    }
    if(!GetPVarInt(playerid,"PlayerCuffed"))
    {
        SetPVarInt(playerid,"Ved",0);
        SendError(GetPVarInt(playerid,"Ved"), "Игрок должен быть в наручниках.");
        SendInfo(GetPVarInt(playerid,"Ved"), "Конвой завершен.");
        SetPVarInt(playerid,"Conv",0);
        Fix_TogglePlayerControllable(playerid, true);
        ClearAnimations(playerid);
        return true;
    }
    if(IsPlayerInAnyVehicle(playerid))
    {
        SetPVarInt(playerid,"Ved",0);
        SendError(GetPVarInt(playerid,"Ved"), "Игрок находится в транспортном средстве.");
        SendInfo(GetPVarInt(playerid,"Ved"), "Конвой завершен.");
        SetPVarInt(playerid,"Conv",0);
        Fix_TogglePlayerControllable(playerid, false);
        return true;
    }
    if(GetPlayerVirtualWorld(GetPVarInt(playerid,"Ved")) != GetPlayerVirtualWorld(playerid)
    || GetPlayerInterior(GetPVarInt(playerid,"Ved")) != GetPlayerInterior(playerid))
    {
        new Float:POS[3];
        GetPlayerPos(GetPVarInt(playerid,"Ved"), POS[0], POS[1], POS[2]);
        SetPlayerPos(playerid, POS[0], POS[1], POS[2]);
        SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(GetPVarInt(playerid,"Ved")));
        SetPlayerInterior(playerid, GetPlayerInterior(GetPVarInt(playerid,"Ved")));
        current = true;
    }
    if(distance(playerid, GetPVarInt(playerid,"Ved")) < 0.9)
    {
        SetPlayerAngleToPlayer(playerid, GetPVarInt(playerid,"Ved"));
        Fix_TogglePlayerControllable(playerid, false);
    }
    else if(distance(playerid, GetPVarInt(playerid,"Ved")) > 10.0)
    {
        if(!current)
        {
            SetPVarInt(playerid,"Ved",0);
            SendError(GetPVarInt(playerid,"Ved"), "Вы слишком далеко от игрока.");
            SendInfo(GetPVarInt(playerid,"Ved"), "Конвой завершен.");
            SendError(playerid, "Игрок слишком далеко от Вас.");
            SendInfo(playerid, "Конвой завершен.");
            //SetPlayerCuffed(playerid, true);
            SetPVarInt(playerid,"Conv",0);
            Fix_TogglePlayerControllable(playerid, false);
            ClearAnimations(playerid);
        }
        else current = false;
    }
    else
    {
        Fix_TogglePlayerControllable(playerid, true);
        SetPlayerAngleToPlayer(playerid, GetPVarInt(playerid,"Ved"));
        ApplyAnimation(playerid, "ped", "WALK_civi", 6.0, 1, 1, 1, 1, 0, 1);
    }
    return true;
}
SetPlayerAngleToPlayer(playerid, targetid)
{
    new Float:POS[2][3];
    GetPlayerPos(targetid, POS[0][0], POS[0][1], POS[0][2]);
    GetPlayerPos(playerid, POS[1][0], POS[1][1], POS[1][2]);
    new Float:ANGLE = 180-atan2(POS[1][0]-POS[0][0], POS[1][1]-POS[0][1]);
    SetPlayerFacingAngle(playerid, ANGLE);
    return true;
}
distance(playerid, playerid2)
{
    new Float:x1,Float:y1,Float:z1,Float:x2,Float:y2,Float:z2;
    new Float:tmpdis;
    GetPlayerPos(playerid,x1,y1,z1);
    GetPlayerPos(playerid2,x2,y2,z2);
    tmpdis = floatsqroot(floatpower(floatabs(floatsub(x2,x1)),2)+floatpower(floatabs(floatsub(y2,y1)),2)+floatpower(floatabs(floatsub(z2,z1)),2));
    return floatround(tmpdis);
}
SendDistanceChat(playerid, Float:range, string[])
{
    new Float:POS[3],Float:radius;
    GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
    foreach(new i: Player)
    {
        if(!p_info[i][loggedIn]) continue;
        if(GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i) && p_info[i][admin] != 15)
        {
            radius = GetPlayerDistanceFromPoint(i, POS[0], POS[1], POS[2]);
            if(radius < range/16) SendMes(i, 0xE3E3E300, string);
            else if(radius < range/8) SendMes(i, 0xD8D8D800, string);
            else if(radius < range/4) SendMes(i, 0xCBCCCE00, string);
            else if(radius < range/2) SendMes(i, 0xBFC0C200, string);
            else if(radius < range) SendMes(i, 0xB4B5B700, string);
        }
    }
    return true;
}


SendAdminMessage(color, string[], bool:send = true)
{
    foreach(new i : gAdmins) {
        if(send == true) SendMes(i, color, string);
        else SendMes(i, color, string);
    }
    return 1;
}

ProxDetector(Float:radi, playerid, string[], col1,col2,col3,col4,col5)
{
    new Float: Pos[3], Float: Radius;
    GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
    new virtworld = GetPlayerVirtualWorld(playerid), int_ = GetPlayerInterior(playerid);
    foreach(new i:Player)
    {
        if(p_info[i][loggedIn] != 1) continue;
        if(virtworld != GetPlayerVirtualWorld(i) || int_ != GetPlayerInterior(i) || p_temp[playerid][premiumgamer] == PREMIUM_GAME) continue;
        Radius = GetPlayerDistanceFromPoint(i, Pos[0], Pos[1], Pos[2]);
        if(Radius < radi / 16) SendMes(i, col1, string);
        else if(Radius < radi / 8) SendMes(i, col2, string);
        else if(Radius < radi / 4) SendMes(i, col3, string);
        else if(Radius < radi / 2) SendMes(i, col4, string);
        else if(Radius < radi) SendMes(i, col5, string);
    }
    return true;
}

IsPlayerStream(Float:distanse, playerid, targetid)
{
    if(!IsPlayerConnected(targetid) || p_info[targetid][loggedIn] != 1) return 0;
    new Float:X, Float:Y, Float:Z;
    GetPlayerPos(targetid,X,Y,Z);
    return PlayerToPoint(distanse, playerid,X,Y,Z);
}

FD(playerid)
{
    if(strequals(get_name(playerid),FD1)
        || strequals(get_name(playerid),FD2)
        || strequals(get_name(playerid),FD3))
        return 1;
    return 0;
}

IsVehicleOccupied(vehicleid)
{
    foreach(new i:Player) if(GetPlayerVehicleID(i) == vehicleid) return 1;
    return 0;
}

AntiCheatKick(playerid, type)
{
    if(p_info[playerid][admin] >= 6)
        return 1;

    new fmt_msg[128], string[256];
    new Year, Month, Day;
    getdate(Year, Month, Day);

    format(fmt_msg, sizeof fmt_msg, "Вы были кикнуты по подозрению в использовании чит-программ: [code: %d]\n", type);
    strcat(string, fmt_msg);
    format(fmt_msg, sizeof fmt_msg, "Дата и время: {1F75FE}%02d:%02d:%02d %02d:%02d:%02d {1F75FE}/Пинг: {1F75FE}%d\n", Year, Month, Day, timestamp_hour, timestamp_minute, timestamp_second, GetPlayerPing(playerid));
    strcat(string, fmt_msg);
    strcat(string,"{1F75FE}Если произошла ошибка, сообщите нам на форум");
    ShowPlayerDialog(playerid,D_NULL,DIALOG_STYLE_MSGBOX, ""I"Античит", string,"Закрыть","");

    p_temp[playerid][dissconect_id] = type+3000;
    return Kick(playerid);//AntiCheatKickWithDesync(playerid, type);
}
////////////////////////////////////////////////////////////////////////////////

UpdateBone(id) //
{
    if(id == -1) return 1;
    new tmp_str[256], string[144], string1[144], str[24], d_count;

    for(new i = 0; i <= 5; i++)
    {
        tmp_str = "", string = "", string1 = "", str = "";

        for(new j; j < 5; j++)
        {
            if(DiceInfo[id][dice_playerID][j] != INVALID_MYSQL_ID)
            {
                if(DiceInfo[id][dice_set][j] == 1)
                    str = "++";
                else if(DiceInfo[id][dice_set][j] > 1)
                    f(str, "%d" , DiceInfo[id][dice_set][j]);
                else
                    str = "--";
                f(string1, "%s%s~n~", string1, str);
                
                if(DiceInfo[id][dice_gamer][j] != INVALID_PLAYER_ID) 
                    f(string,"%s%s~n~", string, get_name(DiceInfo[id][dice_gamer][j]));
                else 
                    f(string,"%sGAMER %d DISSCONNECT~n~", string, j+1);
            }
            else
            {
                f(string1, "%s--_~n~", string1);
                f(string,"%s--~n~", string);
            }
        }

        if(DiceInfo[id][dice_gamer][i] != INVALID_PLAYER_ID)
        {
            f(str, "TABLE %d", id+1);
            PlayerTextDrawSetString(DiceInfo[id][dice_gamer][i], PTD_Dice[DiceInfo[id][dice_gamer][i]][2], str);

            PlayerTextDrawSetString(DiceInfo[id][dice_gamer][i], PTD_Dice[DiceInfo[id][dice_gamer][i]][4], string);
            PlayerTextDrawSetString(DiceInfo[id][dice_gamer][i], PTD_Dice[DiceInfo[id][dice_gamer][i]][5], string1);

            f(string, "Bet: %d~n~Bank: %d~n~Money: %d", DiceInfo[id][bet],DiceInfo[id][bank], p_info[DiceInfo[id][dice_gamer][i]][cash]);
            PlayerTextDrawSetString(DiceInfo[id][dice_gamer][i], PTD_Dice[DiceInfo[id][dice_gamer][i]][7], string);
        }
    }
    // ===========================================
    f(str, "None");
    if(DiceInfo[id][dice_gamer][5] != INVALID_PLAYER_ID) f(str, "%s", get_name(DiceInfo[id][dice_gamer][5]));
    tmp_str[0] = EOS;
    format(tmp_str, sizeof tmp_str, "\
        Стол: "W"%d"I"\n\
        Крупье: "W"%s"I"\n\
        Ставка: "W"%d$"I"\n\
        Банк: "W"%d$"I"\n\
        Количество игроков: "W"%d/5"I"\n\
        Статус игры: "W"%s",
        id+1,
        str,
        DiceInfo[id][bet],
        DiceInfo[id][bank],
        d_count,
        DiceInfo[id][game_start] != 0 ? "Началась" : "Не началась");

    UpdateDynamic3DTextLabelText(DiceInfo[id][dice_text], COLOR_MAIN, tmp_str);
    return true;
}

this::ExitBone(playerid, id, exit_id)
{
    if(id == -1) return 1;

    new null[2], gamer_id;

    for(new i = 4; i != -1; i--)
    {
        gamer_id = DiceInfo[id][dice_gamer][i];
        if(gamer_id == playerid && DiceInfo[id][dice_set][i] == 1)
        {
            if(exit_id == 1 && DiceInfo[id][game_start] > 1)
                DiceInfo[id][dice_set][i] = random(10) + 2;
            else if(DiceInfo[id][game_start] <= 0)
            {
                DiceInfo[id][bank] -= DiceInfo[id][bet];
                SetPlayerMoney(playerid, DiceInfo[id][bet], true, "забрал ставку в казино");
            }
        }
        if(gamer_id != playerid && DiceInfo[id][dice_set][i] == 1) null[0]++;
        else if(gamer_id != playerid && DiceInfo[id][dice_set][i] > 1) null[1]++;
    }
    if(null[0] == 0 && null[1] > 0) 
        ShowItog(id);

    for(new i = 5; i != -1; i--) 
    {
        if(DiceInfo[id][dice_gamer][i] == playerid)
        {
            if(exit_id == 0)
            {
                DiceInfo[id][dice_playerID][i] = INVALID_MYSQL_ID;
                DiceInfo[id][dice_set][i] = 0;
            }
            DiceInfo[id][dice_gamer][i] = INVALID_PLAYER_ID;
        }
    }
    DeletePVar(playerid,"BoneStol_ID");
    UpdateBone(id);

    HideTextDrawForPlayer(playerid, TD_ID_DICE);
    return true;
}

ShowItog(id) //
{
    if(DiceInfo[id][bet] == 0) return false;
    new itog[3] = {-1, ...},
        count_set,
        gamer_id;

    for(new i = 4; i != -1; i--)
    {
        count_set = DiceInfo[id][dice_set][i];
        if(count_set > 1 && count_set > itog[0]) 
        {
            itog[0] = count_set;
            itog[1] = i;
        }
        if(count_set > 1 && i != itog[1] && count_set == itog[0])
            itog[2] = i;
    }
    if(itog[2] > -1)
    {
        new count;
        for(new i = 4; i != -1; i--)
        {
            gamer_id = DiceInfo[id][dice_gamer][i];
            count_set = DiceInfo[id][dice_set][i];
            if(count_set > 1 && count_set == itog[0])
            {
                if(gamer_id != INVALID_PLAYER_ID)
                {
                    count++;
                    DiceInfo[id][dice_set][i] = 1;
                    SendInfo(gamer_id, "У Вас есть 30 сек. чтобы бросить кости.");
                }
                else DiceInfo[id][dice_set][i] = random(10)+2;
            }
            else
                DiceInfo[id][dice_set][i] = 0;
        }
        DiceInfo[id][game_start] = count > 1 ? 30 : 3;
        SetTimerEx("UpdateGameDice", 1000, 0, "i", id);
        UpdateBone(id);
    }
    else if(itog[1] > -1)
    {
        new win_player = DiceInfo[id][dice_gamer][itog[1]];

        if(DiceInfo[id][dice_gamer][5] != INVALID_PLAYER_ID)
        {
            SetPlayerMoney(DiceInfo[id][dice_gamer][5],DiceInfo[id][bank]/1000, true, "зарплата крупье");
            OnServerInfoForMoney[26] += DiceInfo[id][bank]/1000;
        }
        STRING_GLOBAL[0] = EOS;
        if(win_player != INVALID_PLAYER_ID)
        {
            OnServerInfoForMoney[20] += (DiceInfo[id][bank]/10);
            SetPlayerMoney(win_player, DiceInfo[id][bank]-(DiceInfo[id][bank]/10), true, "победа в казино");
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Победил: %s. Кол-во очков: %d.", get_name(win_player), itog[0]);
        }
        else 
        {
            win_player = DiceInfo[id][dice_playerID][itog[1]];
            new win_money = DiceInfo[id][bank]-(DiceInfo[id][bank]/10);

            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `money` = `money` + %d WHERE `id` = %d", win_money, win_player);
            mysql_tquery(con_bd, STRING_GLOBAL);

            Log(LOG_player, INFO, "Offline[%d](OFFLINE) выиграл %d$ в казино | #Casino", win_player, win_money);

            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "Вы вышли из игры и вашу игру в казино автоматически было доиграно.\n\
                Вы победили, кол-во очков: %d | Выиграш: %d$", itog[0], win_money);
            AddNotify(win_player, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Победил: (Игрок вышел). Кол-во очков: %d.", itog[0]);
        }
        DiceInfo[id][game_start] = 0;
        DiceInfo[id][bet] = 0;
        DiceInfo[id][bank] = 0;

        // clear: end game
        for(new i = 5; i != -1; i--)
        {
            gamer_id = DiceInfo[id][dice_gamer][i];
            if(gamer_id == INVALID_PLAYER_ID) 
            {
                if(DiceInfo[id][dice_playerID][i] != INVALID_MYSQL_ID)
                {
                    DiceInfo[id][dice_playerID][i] = INVALID_MYSQL_ID;
                    DiceInfo[id][dice_set][i] = 0;
                }
                continue;
            }
            if(i < 5)
            {
                DiceInfo[id][dice_set][i] = 0;
                SendInfo(gamer_id, STRING_GLOBAL);
                #if EVENT_HALLOWEEN == 1
                if(p_info[gamer_id][halloween_id] == 4 && p_info[gamer_id][halloween_progress] < 1)
                {
                    p_info[gamer_id][halloween_progress] = 1;
                    MysqlUpdatePlayerInt(gamer_id, "halloween_progress", p_info[gamer_id][halloween_progress]);
                    SendAccess(gamer_id, "Отлично, теперь отправляйтесь в бар.");
                }
                #endif
            }

            if(!IsPlayerInDynamicArea(gamer_id, DiceInfo[id][dice_area]))
            {
                if(DiceInfo[id][dice_set][i] == 1 && DiceInfo[id][game_start] <= 0)
                {
                    DiceInfo[id][bank] -= DiceInfo[id][bet];
                    SetPlayerMoney(gamer_id, DiceInfo[id][bet], true, "забрал ставку в казино");
                }
                DiceInfo[id][dice_gamer][i] = INVALID_PLAYER_ID;
                DiceInfo[id][dice_playerID][i] = INVALID_MYSQL_ID;
                DiceInfo[id][dice_set][i] = 0;
                DeletePVar(gamer_id,"BoneStol_ID");
                DiceInfo[id][dice_set][i] = 0;
                HideTextDrawForPlayer(gamer_id, TD_ID_DICE);
            }
        }
    }
    UpdateBone(id);
    return 1;
}

forward UpdateGameDice(id);
public UpdateGameDice(id)
{
    if(DiceInfo[id][game_start] > 0)
    {
        DiceInfo[id][game_start]--;
        new texts[12], gamer_id;
        format(texts, 12, "~g~%i",DiceInfo[id][game_start]);
        for(new i = 5; i != -1; i--)
        {
            gamer_id = DiceInfo[id][dice_gamer][i];
            if(DiceInfo[id][game_start] == 0 && DiceInfo[id][dice_set][i] == 1) 
            {
                DiceInfo[id][dice_set][i] = random(10) + 2;
                UpdateBone(id);
            }
            if(gamer_id != INVALID_PLAYER_ID)
                GameTextForPlayer(gamer_id, texts, 1300, 6);
        }
        if(DiceInfo[id][game_start] == 0)
            return ShowItog(id);
        else
            SetTimerEx("UpdateGameDice", 1000, 0, "i", id);
    }
    return 1;
}

//raknet
const VehicleDestroyed = 136;
IRPC:VehicleDestroyed(playerid, BitStream:bs)
{
    new vehicleid;
    BS_ReadUint16(bs, vehicleid);
    if(GetVehicleModelEx(vehicleid) < 400) return 0;
    return OnVehicleRequestDeath(vehicleid, playerid);
}

forward OnVehicleRequestDeath(vehicleid, killerid);
public OnVehicleRequestDeath(vehicleid, killerid)
{
    if(!IsValidVehicle(vehicleid) || p_info[killerid][loggedIn] != 1) return 0;
    new Float:vhealth;// Float:depth, Float:vehicledepth;
    GetVehicleHealth(vehicleid, vhealth);
    if(vhealth >= 250.0/* && !CA_IsVehicleInWater(vehicleid, depth, vehicledepth)*/) return 0;
    return 1;
}

