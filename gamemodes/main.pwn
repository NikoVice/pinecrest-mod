            if(sscanf(inputtext, "i", fix_listitem)) return ShowPlayerDialog(playerid, D_BIZ_PUT_MONEY, DIALOG_STYLE_INPUT, ""I"Положить деньги на счет", ""W"Введите кол-во денег:", "Далее", "Отмена");
            if(!(1 <= fix_listitem <= 10_000_000)) return ShowPlayerDialog(playerid, D_BIZ_PUT_MONEY, DIALOG_STYLE_INPUT, ""I"Положить деньги на счет", ""W"Введите кол-во денег:", "Далее", "Отмена");
            new bizz_id = GetPlayerBizzID(playerid);
            if(fix_listitem > p_info[playerid][cash]) 
            {
                ShowPlayerDialog(playerid, D_BIZ_PUT_MONEY, DIALOG_STYLE_INPUT, ""I"Положить деньги на счет", ""W"Введите кол-во денег:", "Далее", "Отмена");
                return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            }
            if(b_info[bizz_id][_bank] + fix_listitem > 10_000_000)
            {
                ShowPlayerDialog(playerid, D_BIZ_PUT_MONEY, DIALOG_STYLE_INPUT, ""I"Положить деньги на счет", ""W"Введите кол-во денег:", "Далее", "Отмена");
                return SendError(playerid, "На балансе бизнеса не должно быть более 10 000 000$.");
            }
            b_info[bizz_id][_bank] += fix_listitem;
            SetPlayerMoney(playerid, -fix_listitem, true, "");
            save_bizz(bizz_id);

            //lastlog(PLAYER_MONEY,"положил на баланс бизнеса", bizz_id, playerid, playerid, -fix_listitem);
            // [logs] реализовать получение версии клиента
            // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) положил на баланс бизнеса <%s - %s>(%d)[%d] %d$
            Log(LOG_player, INFO, "%s[%d](%s %s) положил на баланс бизнеса <%s - %s>(%d)[%d] %d$",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                b_info[bizz_id][_name], bizz_type_name[b_info[bizz_id][_tip]], bizz_id, b_info[bizz_id][b_mysql_id], fix_listitem);

            SendAccess(playerid, "Вы положили на счёт бизнеса %d$.", fix_listitem);
            biz_m(playerid);
            return 1;
        }
        case D_BIZ_TAKE_MONEY:
        {
            if(!response) return biz_m(playerid);

            new
                fix_listitem = -1;

            if(sscanf(inputtext, "i", fix_listitem))
                return SendError(playerid, "Вводить нужно только цифру пункта.");

            if(fix_listitem < 0) return 1;

            new
                bizz_id = GetPlayerBizzID(playerid);
            if(fix_listitem > b_info[bizz_id][_bank])
            {
                SendError(playerid, "На балансе бизнеса нет столько денег.");
                return biz_m(playerid);
            }

            b_info[bizz_id][_bank] -= fix_listitem;
            SetPlayerMoney(playerid, fix_listitem, true, "");
            save_bizz(bizz_id);

            //lastlog(PLAYER_MONEY,"снял с баланса бизнеса", bizz_id, playerid, playerid, fix_listitem);
            // [logs] реализовать получение версии клиента
            // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) снял с баланса бизнеса <%s - %s>(%d)[%d] %d$
            Log(LOG_player, INFO, "%s[%d](%s %s) снял с баланса бизнеса <%s - %s>(%d)[%d] %d$",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                b_info[bizz_id][_name], bizz_type_name[b_info[bizz_id][_tip]], bizz_id, b_info[bizz_id][b_mysql_id], fix_listitem);

            SendAccess(playerid, "Вы сняли со счета бизнеса %d$.", fix_listitem);
            biz_m(playerid);
            return 1;
        }
        case D_BIZ_TILL:
        {
            if(!response)
                return biz_m(playerid);

            new fix_listitem = -1;
            if(sscanf(inputtext, "i", fix_listitem))
                return SendError(playerid, "Вводить нужно только цифру пункта.");
            
            new bizz_id = GetPlayerBizzID(playerid);
            if(bizz_id == INVALID_BIZZ_ID)
                return SendError(playerid, "Бизнес не определен. Повторите попытку.");
            
            new max_value = b_info[bizz_id][_tip] == B_TUNING ? 3 : 5;

            if(!( 1 <= fix_listitem <= max_value))
            {
                biz_m(playerid);
                return SendError(playerid, "Введите от 1 до %d.", max_value);
            }

            /*
            if(!IsPlayerInRangeOfPoint(playerid, 15.0, b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2]) &&
                !IsPlayerInRangeOfPoint(playerid, 15.0, b_info[bizz_id][b_exit][0], b_info[bizz_id][b_exit][1], b_info[bizz_id][b_exit][2]))
                return SendError(playerid, "Вы слишком далеко от бизнеса.");
            */

            b_info[bizz_id][_till] = fix_listitem;
            save_bizz(bizz_id);
            update_bizz(bizz_id);

            SendAccess(playerid, "Вы изменили стоимость товара на %d.", fix_listitem);
            biz_m(playerid);
            return 1;
        }
        case D_BIZ_ENTER:
        {
            if(!response)
                return biz_m(playerid);

            new
                fix_listitem = -1;

            if(sscanf(inputtext, "i", fix_listitem))
                return SendError(playerid, "Вводить нужно только цифру пункта.");

            if(fix_listitem < 0 || fix_listitem > 5000)
                return 1;

            new
                bizz_id = GetPlayerBizzID(playerid);
            b_info[bizz_id][_enter] = fix_listitem;
            save_bizz(bizz_id);
            update_bizz(bizz_id);

            SendAccess(playerid, "Вы изменили стоимость входа на %d.", fix_listitem);
            biz_m(playerid);
            return 1;
        }
        case D_BIZ_PERCENT:
        {
            if(!response)
                return biz_m(playerid);

            new
                fix_listitem = -1;

            if(sscanf(inputtext, "i", fix_listitem))
                return SendError(playerid, "Вводить нужно только цифру пункта.");

            if(fix_listitem < 0 || fix_listitem > 20)
                return 1;

            new
                bizz_id = GetPlayerBizzID(playerid);
            b_info[bizz_id][_percent] = fix_listitem;
            save_bizz(bizz_id);
            update_bizz(bizz_id);

            SendAccess(playerid, "Вы изменили процент взимаемый со ставок на %d.", fix_listitem);
            biz_m(playerid);
            return 1;
        }
        case D_ENTER_BIZ:
        {
            if(!response)
                return 1;
            new biz_id = GetPVarInt(playerid, "bID"), price = b_info[biz_id][_enter];

            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            SetPlayerMoney(playerid, -price, true, "вход в бизнес");

            if(b_info[biz_id][_prod] >= price / 100)
            {
                b_info[biz_id][_prod] -= price / 100;
                b_info[biz_id][_bank] += (price / 100) * 90;
                AddMafiaBank(biz_id, price/10);

                biz_finka[biz_id] += (price / 100) * 90;
                UpdateIntForFinanceBiz(biz_id, (price / 100) * 90);
            }

            if(b_info[biz_id][_tip] == B_BAR) SendInfo(playerid, "Чтобы играть в кости используйте /dice");

            SetPlayerPos(playerid, b_info[biz_id][b_exit][0],b_info[biz_id][b_exit][1],b_info[biz_id][b_exit][2]);
            SetPlayerInterior(playerid, b_info[biz_id][_int]), SetPlayerVirtualWorld(playerid, b_info[biz_id][_world]);
            SetCameraBehindPlayer(playerid);
            return 1;
        }
        case D_BIZ_BUY_PRODUCT:
        {
            if(!response) return biz_m(playerid);
            new fix_listitem;
            new bizz_id = GetPlayerBizzID(playerid);
            if(bizz_id == INVALID_BIZZ_ID) return SendError(playerid, "У Вас нет бизнеса в этом слоте.");
            if(b_info[bizz_id][b_order] == 0)
            {
                new max_warehouse = 25000;
                if(b_info[bizz_id][b_upgrade_warehouse] == 1) max_warehouse = max_warehouse * 2;
                if(sscanf(inputtext, "i", fix_listitem))
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Введите кол-во товара:\n\nПримечания:\n\t— Стоимость 1 ед. товара составляет 2$.\n\t— Кол-во товара должно быть не менее 1000 и не более %d.", max_warehouse);
                    ShowPlayerDialog(playerid, D_BIZ_BUY_PRODUCT, DIALOG_STYLE_INPUT, ""I"Заказать товар", STRING_GLOBAL, "Далее", "Отмена");
                    SendError(playerid, "Вы ничего не ввели.");
                    return 1;
                }
                if(fix_listitem < 0 || fix_listitem > max_warehouse)
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Введите кол-во товара:\n\nПримечания:\n\t— Стоимость 1 ед. товара составляет 2$.\n\t— Кол-во товара должно быть не менее 1000 и не более %d.", max_warehouse);
                    ShowPlayerDialog(playerid, D_BIZ_BUY_PRODUCT, DIALOG_STYLE_INPUT, ""I"Заказать товар", STRING_GLOBAL, "Далее", "Отмена");
                    SendError(playerid, "Значение должно быть не менее 0 и не более %d.", max_warehouse);
                    return 1;
                }
                if(fix_listitem < 1000 || fix_listitem > max_warehouse)
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Введите кол-во товара:\n\nПримечания:\n\t— Стоимость 1 ед. товара составляет 2$.\n\t— Кол-во товара должно быть не менее 1000 и не более %d.", max_warehouse);
                    ShowPlayerDialog(playerid, D_BIZ_BUY_PRODUCT, DIALOG_STYLE_INPUT, ""I"Заказать товар", STRING_GLOBAL, "Далее", "Отмена");
                    SendError(playerid, "Значение должно быть не менее 1000 и не более %d.", max_warehouse);
                    return 1;
                }
                if(b_info[bizz_id][_prod] + fix_listitem > max_warehouse)
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Введите кол-во товара:\n\nПримечания:\n\t— Стоимость 1 ед. товара составляет 2$.\n\t— Кол-во товара должно быть не менее 1000 и не более %d.", max_warehouse);
                    ShowPlayerDialog(playerid, D_BIZ_BUY_PRODUCT, DIALOG_STYLE_INPUT, ""I"Заказать товар", STRING_GLOBAL, "Далее", "Отмена");
                    SendError(playerid, "Вы не можете заказать более %d ед. товара.", max_warehouse - b_info[bizz_id][_prod]);
                    return 1;
                }
                if(b_info[bizz_id][_bank] < fix_listitem * 2)
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Введите кол-во товара:\n\nПримечания:\n\t— Стоимость 1 ед. товара составляет 2$.\n\t— Кол-во товара должно быть не менее 1000 и не более %d.", max_warehouse);
                    ShowPlayerDialog(playerid, D_BIZ_BUY_PRODUCT, DIALOG_STYLE_INPUT, ""I"Заказать товар", STRING_GLOBAL, "Далее", "Отмена");
                    SendError(playerid, "В бизнесе нет столько денег.");
                    return 1;
                }
                b_info[bizz_id][_bank] -= fix_listitem * 2;
                b_info[bizz_id][b_order] = fix_listitem;
                b_info[bizz_id][b_order_player_id] = INVALID_PLAYER_ID;
                save_bizz(bizz_id);
                SendAccess(playerid, "Вы заказали %d ед. товара за %d$.", fix_listitem, fix_listitem * 2);
                SendInfo(playerid, "Доставка товара осуществляется фермерами с должностью \"Развозчик продуктов\".");
            }
            else
            {
                if(b_info[bizz_id][b_order_player_id] != INVALID_PLAYER_ID) return SendError(playerid, "Вы не можете отменить заказ, в данный момент он выполняется.");
                new count = b_info[bizz_id][b_order], price = count * 2;
                b_info[bizz_id][_bank] += price;
                b_info[bizz_id][b_order] = 0;
                b_info[bizz_id][b_order_player_id] = INVALID_PLAYER_ID;
                save_bizz(bizz_id);
                SendAccess(playerid, "Вы отменили заказ на %d товара.", count);
                SendInfo(playerid, "На счёт бизнеса возвращено %d$.", price);
            }
            return 1;
        }
        case D_FARM_PRODUCT:
        {
            new idx = p_temp[playerid][p_listitem][listitem];
            for(new i; i < 100; i++) p_temp[playerid][p_listitem][i] = -1;
            if(!response) return 1;
            if(idx == -1) return 1;
            if(b_info[idx][b_order] == 0) return SendError(playerid, "Владелец бизнеса отказался от заказа товара.");
            if(b_info[idx][b_order_player_id] != INVALID_PLAYER_ID) return SendError(playerid, "Данный заказ выполняется.");
            if(FarmWarehouseInfo[2][fwarCount] < b_info[idx][b_order]) return SendError(playerid, "На складе нет столько товара.");

            new vehicleid = GetPlayerVehicleID(playerid);
            if(p_temp[playerid][rented_veh] != vehicleid) return SendError(playerid, "Данное транспортное средство не является Вашим арендованным транспортным средством.");
            if(veh_info[vehicleid][v_npoType] != NPO_JOB || veh_info[vehicleid][v_npoId] != JOB_FARM_PRODUCT) return SendError(playerid, "Данное транспортное средство не является продуктовозом принадлежащем ферме.");

            FarmWarehouseInfo[2][fwarCount] -= b_info[idx][b_order];
            UpdateFarm(TYPE_FARM_WAREHOUSE, 2);
            MysqlUpdateOtherInt("farm_warehouse_product", FarmWarehouseInfo[2][fwarCount]);

            p_temp[playerid][FarmObject][0] = CreateDynamicObject(19638, 0, 0, 0, 0, 0, 0);
            SetDynamicObjectMaterial(p_temp[playerid][FarmObject][0], 1, 6404, "beafron1_law2", "Gen_Scaffold_Wood_Under", 0);
            AttachDynamicObjectToVehicle(p_temp[playerid][FarmObject][0], vehicleid, 0.600, -1.890, -0.051, 0.000, 0.000, 0.000);
            p_temp[playerid][FarmObject][1] = CreateDynamicObject(19638, 0, 0, 0, 0, 0, 0);
            SetDynamicObjectMaterial(p_temp[playerid][FarmObject][1], 1, 6404, "beafron1_law2", "Gen_Scaffold_Wood_Under", 0);
            AttachDynamicObjectToVehicle(p_temp[playerid][FarmObject][1], vehicleid, -0.600, -1.890, -0.051, 0.000, 0.000, 0.000);
            p_temp[playerid][FarmObject][2] = CreateDynamicObject(19638, 0, 0, 0, 0, 0, 0);
            SetDynamicObjectMaterial(p_temp[playerid][FarmObject][2], 1, 6404, "beafron1_law2", "Gen_Scaffold_Wood_Under", 0);
            AttachDynamicObjectToVehicle(p_temp[playerid][FarmObject][2], vehicleid, 0.000, -1.890, -0.052, 0.000, 0.000, 0.000);
            p_temp[playerid][FarmObject][3] = CreateDynamicObject(19638, 0, 0, 0, 0, 0, 0);
            SetDynamicObjectMaterial(p_temp[playerid][FarmObject][3], 1, 6404, "beafron1_law2", "Gen_Scaffold_Wood_Under", 0);
            AttachDynamicObjectToVehicle(p_temp[playerid][FarmObject][3], vehicleid, 0.290, -1.890, 0.118, 0.000, 0.000, 0.000);
            p_temp[playerid][FarmObject][4] = CreateDynamicObject(19638, 0, 0, 0, 0, 0, 0);
            SetDynamicObjectMaterial(p_temp[playerid][FarmObject][4], 1, 6404, "beafron1_law2", "Gen_Scaffold_Wood_Under", 0);
            AttachDynamicObjectToVehicle(p_temp[playerid][FarmObject][4], vehicleid, -0.290, -1.890, 0.118, 0.000, 0.000, 0.000);

            b_info[idx][b_order_player_id] = playerid;

            p_temp[playerid][FarmBizIDx] = idx;

            SendMes(playerid, COLOR_BLUE, "Вы взяли заказ от \"%s\" на доставку %d товара.", b_info[idx][_name], b_info[idx][b_order]);

            SendMes(playerid, COLOR_BLUE, "Место обозначено на GPS навигаторе.");
            if(b_info[idx][b_mysql_id] == 85) SetPlayerGPS(playerid, 1150.3137,-1413.0038,13.3597, 5.0);
            else SetPlayerGPS(playerid, b_info[idx][b_enter][0], b_info[idx][b_enter][1], b_info[idx][b_enter][2], 5.0);
            return 1;
        }
        case D_BIZ_UPGRADE:
        {
            new bizz_id = GetPlayerBizzID(playerid);
            if(bizz_id == INVALID_BIZZ_ID) return SendError(playerid, "У Вас нет бизнеса в этом слоте.");
            if(!response) return biz_m(playerid);
            switch(listitem)
            {
                case 0:
                {
                    if(b_info[bizz_id][b_upgrade_warehouse] == 1) return SendError(playerid, "В бизнесе уже установлено увеличение вместимости склада.");
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы желаете увеличить вместимость склада за %d$?", b_info[bizz_id][_price] / 2);
                    ShowPlayerDialog(playerid, D_BIZ_BUY_W_UPGRADE, DIALOG_STYLE_MSGBOX, ""I"Увеличение вместимости склада", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 1:
                {
                    if(b_info[bizz_id][_tip] == B_ARENDS_VEHICLE)
                    {
                        if(b_info[bizz_id][b_upgrade_class] == 3) return SendError(playerid, "В бизнесе максимальный класс транспортных средств.");
                        new i = b_info[bizz_id][b_upgrade_class] + 1, price = 2500000 * i, biz_arends_class[4][6] = {"Nope", "C", "B", "A"};
                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы желаете улучшить класс транспортных средств для аренды до \"%s\" класса за %d$?", biz_arends_class[i], price);
                        ShowPlayerDialog(playerid, D_BIZ_BUY_C_UPGRADE, DIALOG_STYLE_MSGBOX, ""I"Улучшение класса транспортных средств", STRING_GLOBAL, "Далее", "Отмена");
                    }
                    else return SendError(playerid, "В данном типе бизнеса нельзя улучшить класс транспортных средств."), biz_m(playerid);
                }
                case 2:
                {
                    if(b_info[bizz_id][b_upgrade_tax] == 1) return SendError(playerid, "В бизнесе уже установлено снижение налогообложения.");
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы желаете снизить налогообложение на 50%% за %d$?", b_info[bizz_id][_price] / 2);
                    ShowPlayerDialog(playerid, D_BIZ_BUY_T_UPGRADE, DIALOG_STYLE_MSGBOX, ""I"Снижение налогообложения", STRING_GLOBAL, "Далее", "Отмена");
                }
            }
            return 1;
        }
        case D_BIZ_BUY_W_UPGRADE:
        {
            new bizz_id = GetPlayerBizzID(playerid);
            if(bizz_id == INVALID_BIZZ_ID) return SendError(playerid, "У Вас нет бизнеса в этом слоте.");
            if(!response) return biz_m(playerid);
            new price = b_info[bizz_id][_price] / 2;
            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            if(b_info[bizz_id][b_upgrade_warehouse] == 1) return SendError(playerid, "В бизнесе уже установлено увеличение вместимости склада.");
            SetPlayerMoney(playerid, -price, true, "бизнес: покупка увеличения вместимости склада");
            b_info[bizz_id][b_upgrade_warehouse] = 1;
            update_bizz(bizz_id);
            save_bizz(bizz_id);
            SendAccess(playerid, "Вы приобрели увеличение вместимости склада за %d$.", price);
            return 1;
        }
        case D_BIZ_BUY_C_UPGRADE:
        {
            new bizz_id = GetPlayerBizzID(playerid);
            if(bizz_id == INVALID_BIZZ_ID) return SendError(playerid, "У Вас нет бизнеса в этом слоте.");
            if(!response) return biz_m(playerid);
            new i = b_info[bizz_id][b_upgrade_class] + 1, price = 2500000 * i;
            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            if(b_info[bizz_id][b_upgrade_class] == 3) return SendError(playerid, "В бизнесе уже установлено максимальный класс транспортных средств.");
            SetPlayerMoney(playerid, -price, true, "бизнес: покупка класса транспортных средств");
            b_info[bizz_id][b_upgrade_class]++;
            if(b_info[bizz_id][b_upgrade_class] > 3) b_info[bizz_id][b_upgrade_class] = 3;
            update_bizz(bizz_id);
            save_bizz(bizz_id);
            new biz_arends_class[4][6] = {"Nope", "C", "B", "A"};
            SendAccess(playerid, "Вы улучшили транспортные средства для аренды до \"%s\" класса за %d$.", biz_arends_class[b_info[bizz_id][b_upgrade_class]], price);
            SendMes(playerid, COLOR_LIGHTRED, "Обратите внимание! Транспортные средства нового класса появятся после рестарта сервера!");
            return 1;
        }
        case D_BIZ_BUY_T_UPGRADE:
        {
            new bizz_id = GetPlayerBizzID(playerid);
            if(bizz_id == INVALID_BIZZ_ID) return SendError(playerid, "У Вас нет бизнеса в этом слоте.");
            if(!response) return biz_m(playerid);
            new price = b_info[bizz_id][_price] / 2;
            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            if(b_info[bizz_id][b_upgrade_tax] == 1) return SendError(playerid, "В бизнесе уже установлено снижение налогообложения.");
            SetPlayerMoney(playerid, -price, true, "бизнес: покупка снижения налогообложения");
            b_info[bizz_id][b_upgrade_tax] = 1;
            update_bizz(bizz_id);
            save_bizz(bizz_id);
            SendAccess(playerid, "Вы приобрели снижение налогообложения за %d$.", price);
            return 1;
        }
        case D_SELL_BIZZ:
        {
            new bizz_id = GetPlayerBizzID(playerid);
            if(bizz_id == INVALID_BIZZ_ID) return SendError(playerid, "У Вас нет бизнеса в этом слоте.");
            if(!response) return biz_m(playerid);
            switch(listitem)
            {
                case 0:
                {
