alias:blacklist("bl");

forward fraction_blacklist(playerid, type, nickname[], reason[], target_mysqlid);
public fraction_blacklist(playerid, type, nickname[], reason[], target_mysqlid)
{
    switch(type)
    {
        case 1:
        {
            if(!cache_num_rows()) return SendError(playerid, "Игрок не найден в базе данных.");
            new mysql_id;
            cache_get_value_name_int(0, "id", mysql_id);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `fraction_blacklist` (`f_bl_frac`, `f_bl_player_id`, `f_bl_target_id`, `f_bl_date`, `f_bl_reason`) VALUES (%d, %d, %d, NOW(), '%s')",
            p_info[playerid][member], p_info[playerid][ID], mysql_id, reason);
            mysql_tquery(con_bd, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s внес(-ла) %s в черный список %s. Причина: %s", get_name(playerid), nickname, GetFractionName(p_info[playerid][member]), reason);
            SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
        }
        case 2:
        {
            if(!cache_num_rows()) return SendError(playerid, "Игрок не найден в базе данных.");
            new mysql_id;
            cache_get_value_name_int(0, "id", mysql_id);
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `fraction_blacklist` WHERE `f_bl_target_id` = %d AND `f_bl_frac` = %d",
            mysql_id, p_info[playerid][member]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s вынес(-ла) %s из черного списка %s.", get_name(playerid), nickname, GetFractionName(p_info[playerid][member]));
            SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
        }
    }
    return 1;
}

forward load_fraction_blacklist(playerid);
public load_fraction_blacklist(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(rows)
    {
        for(new i, fr_id; i < rows; i++)
        {
            cache_get_value_name_int(i, "f_bl_frac", fr_id);
            p_temp[playerid][bl_fraction][fr_id] = true;
            cache_get_value_name(i, "f_bl_reason", p_temp[playerid][bl_reason][fr_id], 32);
        }
    }
    return 1;
}

CMD:fstats(playerid, params[])
{
    if(!p_info[playerid][member]) return SendError(playerid, "Вы не состоите во фракции.");
    if(p_info[playerid][rang] < 9) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(sscanf(params, "u", params[0])) return SendError(playerid, "Используйте: /fstats [id игрока]");
    if(params[0] == INVALID_PLAYER_ID || !IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
    if(p_info[params[0]][member] == 0) return SendError(playerid, "Игрок не состоит во фракции.");
    if(p_info[params[0]][member] != p_info[playerid][member]) return SendError(playerid, "Игрок находится в другой фракции.");
    ShowFracStats(params[0], playerid);
    return 1;
}

CMD:myfstats(playerid, params[])
{
    if(!p_info[playerid][member]) return SendError(playerid, "Вы не состоите во фракции.");
    ShowFracStats(playerid, playerid);
    return 1;
}

ShowFracStats(playerid, scdplayerid)
{
    new tdate[32], time[32],
        year, month, day;
    getdate(year, month, day);
    new month_name[12][12] = {"Января", "Февраля", "Марта", "Апреля", "Мая", "Июня", "Июля", "Августа", "Сентября", "Октября", "Ноября", "Декабря"};
    format(tdate, sizeof(tdate), "%d %s %d г", day, month_name[month-1], year);
    if(timestamp_minute < 10) format(time, sizeof(time), "%d:0%d", timestamp_hour, timestamp_minute);
    else format(time, sizeof(time), "%d:%d", timestamp_hour, timestamp_minute);
    new day_name[7][12] = {"Четверг", "Пятница", "Суббота", "Воскресенье", "Понедельник", "Вторник", "Среда"};
    STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
    Ник: %s\n\
    Дата: %s\n\
    Время: %s\n\
    День: %s\n\
    Организация: %s\n\
    Ранг: %s\n\
    Отыграно всего: %s\n", get_name(playerid), tdate, time, day_name[getDayEx()], GetFractionName(p_info[playerid][member]), GetPlayerFractionRangName(playerid), ConvertTime(p_info[playerid][p_game_time]));
    if(p_info[playerid][member] == MAYOR_LS)
    {
        format(STRING_MIN, sizeof(STRING_MIN), "\
        Освобождено из тюрьмы: %d игрок(-а/-ов)\n\
        Выдано паспортов: %d раз(-а)\n\
        Продано лицензий на адвокатские услуги: %d раз(-а)", p_info[playerid][fracdata][0], p_info[playerid][fracdata][33], p_info[playerid][fracdata][34]);
        strcat(STRING_GLOBAL, STRING_MIN);
    }
    else if(p_info[playerid][member] == POLICE_LS || p_info[playerid][member] == POLICE_SF || p_info[playerid][member] == POLICE_LV || p_info[playerid][member] == FBI_TEAM || p_info[playerid][member] == POLICE_RC)
    {
        format(STRING_MIN, sizeof(STRING_MIN), "\
        Проведено аррестов: %d раз(-а)\n\
        Освобождено из тюрьмы: %d игрок(-а/-ов)\n\
        Выдано розыска: %d раз(-а)\n\
        Снято розыска: %d раз(-а)\n\
        Выписано штрафов: %d раз(-а)\n\
        Проведено обысков: %d раз(-а)\n\
        Изъято вещей: %d раз(-а)\n\
        Продано лицензий на оружие: %d раз(-а)\n\
        Убийств членов нелегальных организаций: %d раз(-а)", p_info[playerid][fracdata][1], p_info[playerid][fracdata][2], p_info[playerid][fracdata][3], p_info[playerid][fracdata][4],
        p_info[playerid][fracdata][5], p_info[playerid][fracdata][6], p_info[playerid][fracdata][7], p_info[playerid][fracdata][8], p_info[playerid][fracdata][35]);
        strcat(STRING_GLOBAL, STRING_MIN);
    }
    else if(p_info[playerid][member] == NATIONAL_GUARD)
    {
        format(STRING_MIN, sizeof(STRING_MIN), "\
        Загружено боеприпасов: %d штук(-а/-и)\n\
        Разгружено боеприпасов: %d штук(-а/-и)\n\
        Убийств членов нелегальных организаций: %d раз(-а)", p_info[playerid][fracdata][9], p_info[playerid][fracdata][10], p_info[playerid][fracdata][36]);
        strcat(STRING_GLOBAL, STRING_MIN);
    }
    else if(p_info[playerid][member] == MEDIC_LS || p_info[playerid][member] == MEDIC_SF || p_info[playerid][member] == MEDIC_LV)
    {
        format(STRING_MIN, sizeof(STRING_MIN), "\
        Проведено лечений: %d раз(-а)\n\
        Проведено сеансов от наркозависимости: %d раз(-а)\n\
        Проведено операций по смене пола: %d раз(-а)\n\
        Выдано медкарт: %d раз(-а)\n\
        Загружено медикаментов: %d штук(-а/-и)\n\
        Разгружено медикаментов: %d штук(-а/-и)", p_info[playerid][fracdata][11], p_info[playerid][fracdata][12], p_info[playerid][fracdata][13], p_info[playerid][fracdata][14],
        p_info[playerid][fracdata][15], p_info[playerid][fracdata][16]);
        strcat(STRING_GLOBAL, STRING_MIN);
    }
    else if(p_info[playerid][member] == RADIO_LS || p_info[playerid][member] == RADIO_SF || p_info[playerid][member] == RADIO_LV)
    {
        format(STRING_MIN, sizeof(STRING_MIN), "\
        Отредактировано объявлений: %d раз(-а)", p_info[playerid][fracdata][17]);
        strcat(STRING_GLOBAL, STRING_MIN);
    }
    else if(p_info[playerid][member] == GROOVE || p_info[playerid][member] == BALLAS || p_info[playerid][member] == RIFA || p_info[playerid][member] == AZTEC || p_info[playerid][member] == VAGOS)
    {
        format(STRING_MIN, sizeof(STRING_MIN), "\
        Ограблено магазинов: %d раз(-а)\n\
        Загружено наркотиков: %d грамм(-а)\n\
        Разгружено наркотиков: %d грамм(-а)\n\
        Загружено боеприпасов: %d штук(-а/-и)\n\
        Разгружено боеприпасов: %d штук(-а/-и)\n\
        Убийств при захвате территорий: %d раз(-а)\n\
        Смертей при захвате территорий: %d раз(-а)", p_info[playerid][fracdata][18], p_info[playerid][fracdata][19], p_info[playerid][fracdata][20], p_info[playerid][fracdata][21],
        p_info[playerid][fracdata][22], p_info[playerid][fracdata][37], p_info[playerid][fracdata][38]);
        strcat(STRING_GLOBAL, STRING_MIN);
    }
    else if(p_info[playerid][member] == MAFIA_RM || p_info[playerid][member] == MAFIA_LCN || p_info[playerid][member] == MAFIA_YAKUDZA || p_info[playerid][member] == MAFIA_IRAN)
    {
        format(STRING_MIN, sizeof(STRING_MIN), "\
        Ограблено банков: %d раз(-а)\n\
        Загружено наркотиков: %d грамм(-а)\n\
        Разгружено наркотиков: %d грамм(-а)\n\
        Загружено боеприпасов: %d штук(-а/-и)\n\
        Разгружено боеприпасов: %d штук(-а/-и)\n\
        Убийств при захвате территорий: %d раз(-а)\n\
        Смертей при захвате территорий: %d раз(-а)", p_info[playerid][fracdata][23], p_info[playerid][fracdata][24], p_info[playerid][fracdata][25], p_info[playerid][fracdata][26],
        p_info[playerid][fracdata][27], p_info[playerid][fracdata][39], p_info[playerid][fracdata][40]);
        strcat(STRING_GLOBAL, STRING_MIN);
    }
    else if(p_info[playerid][member] == PRISON)
    {
        strcat(STRING_GLOBAL, ""W"В данной фракции нет статистики.");
    }
    else if(p_info[playerid][member] == LICENSE)
    {
        format(STRING_MIN, sizeof(STRING_MIN), "\
        Продано лицензий: %d штук(-а/-и)\n\
        Продано страховок: %d штук(-а/-и)", p_info[playerid][fracdata][28], p_info[playerid][fracdata][41]);
        strcat(STRING_GLOBAL, STRING_MIN);
    }
    else if(p_info[playerid][member] == BIKER)
    {
        format(STRING_MIN, sizeof(STRING_MIN), "\
        Ограблено банков: %d раз(-а)\n\
        Загружено наркотиков: %d грамм(-а)\n\
        Разгружено наркотиков: %d грамм(-а)\n\
        Загружено боеприпасов: %d штук(-а/-и)\n\
        Разгружено боеприпасов: %d штук(-а/-и)\n\
        Убийств при захвате территорий: %d раз(-а)\n\
        Смертей при захвате территорий: %d раз(-а)", p_info[playerid][fracdata][23], p_info[playerid][fracdata][29], p_info[playerid][fracdata][30], p_info[playerid][fracdata][31],
        p_info[playerid][fracdata][32], p_info[playerid][fracdata][39], p_info[playerid][fracdata][40]);
        strcat(STRING_GLOBAL, STRING_MIN);
    }
    ShowPlayerDialog(scdplayerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Статистика фракции", STRING_GLOBAL, "Отмена", "");
    return 1;
}

SaveFracData(playerid)
{
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d",
    p_info[playerid][fracdata][0], p_info[playerid][fracdata][1], p_info[playerid][fracdata][2], p_info[playerid][fracdata][3], p_info[playerid][fracdata][4], p_info[playerid][fracdata][5], p_info[playerid][fracdata][6], p_info[playerid][fracdata][7],
    p_info[playerid][fracdata][8], p_info[playerid][fracdata][9], p_info[playerid][fracdata][10], p_info[playerid][fracdata][11], p_info[playerid][fracdata][12], p_info[playerid][fracdata][13], p_info[playerid][fracdata][14], p_info[playerid][fracdata][15],
    p_info[playerid][fracdata][16], p_info[playerid][fracdata][17], p_info[playerid][fracdata][18], p_info[playerid][fracdata][19], p_info[playerid][fracdata][20], p_info[playerid][fracdata][21], p_info[playerid][fracdata][22], p_info[playerid][fracdata][23],
    p_info[playerid][fracdata][24], p_info[playerid][fracdata][25], p_info[playerid][fracdata][26], p_info[playerid][fracdata][27], p_info[playerid][fracdata][28], p_info[playerid][fracdata][29], p_info[playerid][fracdata][30], p_info[playerid][fracdata][31],
    p_info[playerid][fracdata][32], p_info[playerid][fracdata][33], p_info[playerid][fracdata][34], p_info[playerid][fracdata][35], p_info[playerid][fracdata][36], p_info[playerid][fracdata][37], p_info[playerid][fracdata][38], p_info[playerid][fracdata][39],
