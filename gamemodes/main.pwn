GetPlayerStatusCapture(playerid)
{
    new frac_id = p_info[playerid][member];
    if(gang(playerid))
    {
        if(Capture_Info[0][gFaction][0] == frac_id ||
        Capture_Info[0][gFaction][1] == frac_id ||
        Capture_Info[1][gFaction][0] == frac_id ||
        Capture_Info[1][gFaction][1] == frac_id) return CAPTURE_ID_GANG;
    }
    if(biker(playerid) || mafia(playerid))
    {
        if(BizWar_Info[bMafia][0] == frac_id ||
            BizWar_Info[bMafia][1] == frac_id) return CAPTURE_ID_MAFIA;
    }
    new family_idx = GetPlayerFamilyID(playerid);
    if(family_idx != -1)
    {
        if(GetSlotFamilyCapture(family_idx, -1) != -1)
            return CAPTURE_ID_FAMILY;
    }
    for(new i; i < MAX_PAINTBALL_PLAYERS; i++)
    {
        if(PaintBallPlayers[i] == playerid)
        {
            return CAPTURE_ID_PAINTBALL;
        }
    }
    for(new i = 0, x = 0; i < MAX_COSSACK_ROBBERS_TEAM; i++)
    {
        for(x = 0; x < MAX_COSSACK_ROBBERS_PLAYERS; x++)
        {
            if(CossackRobbersPlayers[i][x] == playerid) return CAPTURE_ID_COSSACK_ROBBERS;
        }
    }
    return CAPTURE_ID_NONE;
}


forward fraction_blacklist_search(playerid);
public fraction_blacklist_search(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(rows == 0) return SendError(playerid, "������ �� �������.");
    new PlayerName[MAX_PLAYER_NAME], TargetName[MAX_PLAYER_NAME], blDate[24], blReason[42];

    cache_get_value_name(0, "f_bl_player_name", PlayerName);
    cache_get_value_name(0, "f_bl_target_name", TargetName);
    cache_get_value_name(0, "f_bl_date", blDate);
    cache_get_value_name(0, "f_bl_reason", blReason);

    format(STRING_GLOBAL, sizeof(STRING_GLOBAL),
        ""W"������ ������: "I"%s\n\n\
        "W"�������: "I"%s\n\
        "W"�����: "I"%s\n\
        "W"����: "I"%s\n\
        "W"�������: "I"%s", GetFractionName(p_info[playerid][member]), PlayerName, TargetName, blDate, blReason);
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"������ ������", STRING_GLOBAL, "�������", "������");
    return 1;
}

CMD:asetweaponskill(playerid, params[])
{
    if (p_info[playerid][admin] < 1)
        return 1;

    new targetid, skillid, value;
    if(sscanf(params, "uii", targetid, skillid, value))
    {
        SendInfo(playerid, "�������������: /asetweaponskill [ID ������/����� ����] [ID ������ (0-9)] [������� (0-999)]");
        SendInfo(playerid, "������: 0 - ����� .45, 1 - ����� .45 � ����., 2 - Desert Eagle, 3 - ��������, 4 - �����");
        return SendInfo(playerid, "������: 5 - SPAS-12, 6 - �����-���, 7 - ��5, 8 - ��-47, 9 - �4");
    }
    if (skillid < WEAPONSKILL_PISTOL || skillid > WEAPONSKILL_M4)
        return SendError(playerid, "������������ ID ������.");
    if (value < 0 || value > 999)
        return SendError(playerid, "������������ ������� ������.");
    return SetPlayerSkillLevel(targetid, skillid, value);
}


////////////////////////////////////////////////
CaptureInfoUpdate(playerid, capture_id, i = -1, bool:status_start = true)
{
    new str[24];
    switch(capture_id)
    {
        case CAPTURE_ID_MAFIA:
        {
            if(status_start)
            {
                PlayerTextDrawHide(playerid, PTD_Capture[playerid][0]);
                PlayerTextDrawHide(playerid, PTD_Capture[playerid][1]);
                PlayerTextDrawColor(playerid, PTD_Capture[playerid][0], fraction_color[BizWar_Info[bMafia][0]]);
                PlayerTextDrawColor(playerid, PTD_Capture[playerid][1], fraction_color[BizWar_Info[bMafia][1]]);
                PlayerTextDrawShow(playerid, PTD_Capture[playerid][0]);
                PlayerTextDrawShow(playerid, PTD_Capture[playerid][1]);
            }

            f(str, "%d", BizWar_Info[bCount][0]); // ����� ����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][3], str);
            f(str, "%d", BizWar_Info[bCount][1]); // ������
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][4], str);
            f(str, "%s", ConvertTime(BizWar_Info[bWarTime], 1)); // �����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][2], str);

            f(str, "KILLS:_~s~%d", p_temp[playerid][CaptureBizWarInfoInt][0]); //��������
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][5], str);
            f(str, "DEATHS:_~s~%d", p_temp[playerid][CaptureBizWarInfoInt][1]); //�������
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][6], str);
            f(str, "GIVE:_~s~%.1f", p_temp[playerid][CaptureBizWarInfoFloat][0]); //����� �����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][7], str);
            f(str, "TAKE:_~s~%.1f", p_temp[playerid][CaptureBizWarInfoFloat][1]); //������� �����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][8], str);

            new idx = GetSlotTopList(playerid);
            if(idx != -1)
            {
                if(TopList[idx][WarID][0] == p_info[playerid][member])
                {
                    if(TopList[idx][KillsOne][0] != -1) f(str, "~w~~h~%s", TopListNickOne[idx][0]);
                    else f(str, "_");
                }
                else
                {
                    if(TopList[idx][KillsTwo][0] != -1) f(str, "~w~~h~%s", TopListNickTwo[idx][0]);
                    else f(str, "_");
                }
            }
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][9], str);
        }
        case CAPTURE_ID_GANG:
        {
            if(i == -1)
            {
                if(Capture_Info[0][gFaction][0] == p_info[playerid][member] || Capture_Info[0][gFaction][1]  == p_info[playerid][member])
                    i = 0;
                if(Capture_Info[1][gFaction][0] == p_info[playerid][member] || Capture_Info[1][gFaction][1]  == p_info[playerid][member])
                    i = 1;
            }

            if(status_start)
            {
                PlayerTextDrawHide(playerid, PTD_Capture[playerid][0]);
                PlayerTextDrawHide(playerid, PTD_Capture[playerid][1]);
                PlayerTextDrawColor(playerid, PTD_Capture[playerid][0], fraction_color[Capture_Info[i][gFaction][0]]);
                PlayerTextDrawColor(playerid, PTD_Capture[playerid][1], fraction_color[Capture_Info[i][gFaction][1]]);
                PlayerTextDrawShow(playerid, PTD_Capture[playerid][0]);
                PlayerTextDrawShow(playerid, PTD_Capture[playerid][1]);
            }

            f(str, "%d", Capture_Info[i][gCount][0]); // ����� ����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][3], str);
            f(str, "%d", Capture_Info[i][gCount][1]); // ������
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][4], str);
            f(str, "%s", ConvertTime(Capture_Info[i][gTime], 1)); // �����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][2], str);

            f(str, "KILLS:_~s~%d", p_temp[playerid][CaptureBizWarInfoInt][0]); //��������
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][5], str);
            f(str, "DEATHS:_~s~%d", p_temp[playerid][CaptureBizWarInfoInt][1]); //�������
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][6], str);
            f(str, "GIVE:_~s~%.1f", p_temp[playerid][CaptureBizWarInfoFloat][0]); //����� �����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][7], str);
            f(str, "TAKE:_~s~%.1f", p_temp[playerid][CaptureBizWarInfoFloat][1]); //������� �����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][8], str);

            new idx = GetSlotTopList(playerid);
            if(idx != -1)
            {
                if(TopList[idx][WarID][0] == p_info[playerid][member])
                {
                    if(TopList[idx][KillsOne][0] != -1) f(str, "~w~~h~%s", TopListNickOne[idx][0]);
                    else f(str, "_");
                }
                else
                {
                    if(TopList[idx][KillsTwo][0] != -1) f(str, "~w~~h~%s", TopListNickTwo[idx][0]);
                    else f(str, "_");
                }
            }
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][9], str);
            return 1;
        }
        case CAPTURE_ID_FAMILY:
        {
            if(status_start)
            {
                PlayerTextDrawHide(playerid, PTD_Capture[playerid][0]);
                PlayerTextDrawHide(playerid, PTD_Capture[playerid][1]);
                PlayerTextDrawColor(playerid, PTD_Capture[playerid][0], FAMILY_COLORS[FamilyData[fCapture_Info[i][fFamilyID][0]][fColorID]]);
                PlayerTextDrawColor(playerid, PTD_Capture[playerid][1], FAMILY_COLORS[FamilyData[fCapture_Info[i][fFamilyID][1]][fColorID]]);
                PlayerTextDrawShow(playerid, PTD_Capture[playerid][0]);
                PlayerTextDrawShow(playerid, PTD_Capture[playerid][1]);
            }

            f(str, "%d", fCapture_Info[i][fCount][0]); // ����� ����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][3], str);
            f(str, "%d", fCapture_Info[i][fCount][1]); // ������
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][4], str);
            f(str, "%s", ConvertTime(fCapture_Info[i][fTime], 1)); // �����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][2], str);

            f(str, "KILLS:_~s~%d", p_temp[playerid][CaptureBizWarInfoInt][0]); //��������
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][5], str);
            f(str, "DEATHS:_~s~%d", p_temp[playerid][CaptureBizWarInfoInt][1]); //�������
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][6], str);
            f(str, "GIVE:_~s~%.1f", p_temp[playerid][CaptureBizWarInfoFloat][0]); //����� �����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][7], str);
            f(str, "TAKE:_~s~%.1f", p_temp[playerid][CaptureBizWarInfoFloat][1]); //������� �����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][8], str);

            new idx = GetSlotTopList(playerid);
            if(idx != -1)
            {
                if(TopList[idx][WarID][0] == GetPlayerFamilyID(playerid))
                {
                    if(TopList[idx][KillsOne][0] != -1) f(str, "~w~~h~%s", TopListNickOne[idx][0]);
                    else f(str, "_");
                }
                else
                {
                    if(TopList[idx][KillsTwo][0] != -1) f(str, "~w~~h~%s", TopListNickTwo[idx][0]);
                    else f(str, "_");
                }
            }
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][9], str);
            return 1;
        }
        case CAPTURE_ID_PAINTBALL:
        {
            if(status_start)
            {
                PlayerTextDrawHide(playerid, PTD_Capture[playerid][0]);
                PlayerTextDrawHide(playerid, PTD_Capture[playerid][1]);
                TextDrawHideForPlayer(playerid, TD_Capture[9]);
                TextDrawHideForPlayer(playerid, TD_Capture[11]);
            }

            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][3], "_");
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][4], "_");
            f(str, "%s", ConvertTime(PaintBallTimerSec, 1)); // �����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][2], str);

            f(str, "KILLS:_~s~%d", PaintBallKills[playerid]); //��������
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][5], str);
            f(str, "DEATHS:_~s~%d", PaintBallDeaths[playerid]); //�������
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][6], str);
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][7], "_");
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][8], "_");

            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][9], "_");
        }
        case CAPTURE_ID_COSSACK_ROBBERS:
        {
            if(status_start)
            {
                PlayerTextDrawHide(playerid, PTD_Capture[playerid][0]);
                PlayerTextDrawHide(playerid, PTD_Capture[playerid][1]);
                PlayerTextDrawColor(playerid, PTD_Capture[playerid][0], COLOR_RED);
                PlayerTextDrawColor(playerid, PTD_Capture[playerid][1], COLOR_BLUE);
                PlayerTextDrawShow(playerid, PTD_Capture[playerid][0]);
                PlayerTextDrawShow(playerid, PTD_Capture[playerid][1]);
            }

            f(str, "%d", CossackRobbersKills[TEAM_COSSACK_ROBBERS_RED]); // ����� ����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][3], str);
            f(str, "%d", CossackRobbersKills[TEAM_COSSACK_ROBBERS_BLUE]); // ������
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][4], str);
            f(str, "%s", ConvertTime(CossackRobbersTime, 1)); // �����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][2], str);

            f(str, "KILLS:_~s~%d", p_temp[playerid][cossack_robbers_kills]); //��������
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][5], str);
            f(str, "DEATHS:_~s~%d", p_temp[playerid][cossack_robbers_deaths]); //�������
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][6], str);
            f(str, "GIVE:_~s~%.1f", p_temp[playerid][cossack_robbers_give]); //����� �����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][7], str);
            f(str, "TAKE:_~s~%.1f", p_temp[playerid][cossack_robbers_take]); //������� �����
            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][8], str);

            new team = p_temp[playerid][cossack_robbers_team], scdplayerid = CossackRobbersLeaders[team];

            if(scdplayerid == INVALID_PLAYER_ID || !IsPlayerConnected(scdplayerid)) str = "-";
            else f(str, "~w~~h~%s", get_name(scdplayerid));

            PlayerTextDrawSetString(playerid, PTD_Capture[playerid][9], str);
        }
    }
    return 1;
}

stock GetBitColorRGBA(color, &Float:color_a, &Float:color_r, &Float:color_g, &Float:color_b)
{
    color_a = float(color >> 0 & 0xFF);
    color_b = float(color >> 8 & 0xFF);
    color_g = float(color >> 16 & 0xFF);
    color_r = float(color >> 24 & 0xFF);
}

stock GetBitColorRGB(color, &color_r, &color_g, &color_b)
{
    color_b = color >> 8 & 0xFF;
    color_g = color >> 16 & 0xFF;
    color_r = color >> 24 & 0xFF;
}

stock ConvertColor(color_a, color_r, color_g, color_b)
{
    return (color_a) | (color_b << 8) | (color_g << 16) | (color_r << 24);
}
