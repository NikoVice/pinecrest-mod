                        if(UndergroundBotsInfo[idx][ubTax] >= MAX_UNDERGROUND_BOTS_TAX) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx), SendError(playerid, "У выбранного рабочего максимальное количество налога, оплатите его.");
