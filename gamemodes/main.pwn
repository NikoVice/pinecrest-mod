forward leader_offline(playerid);
public leader_offline(playerid)
{
    new rows, named[MAX_PLAYER_NAME], leader_id, last_enter[16];
    cache_get_row_count(rows);
    if(!rows) return SendError(playerid, "������ �� �������.");

    STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;
    strcat(STRING_GLOBAL, "[#] �������\t�������\t��������� ����\n");
    for(new i; i < rows; i++)
    {
        cache_get_value_name(i, "name", named, 24);
        cache_get_value_name_int(i, "leader", leader_id);
        cache_get_value_name(i, "lastenter", last_enter, 16);
        format(STRING_MIN, sizeof(STRING_MIN), ""I"[%d]"W" %s\t%s\t%s\n", i+1, named, GetFractionName(leader_id), last_enter);
        strcat(STRING_GLOBAL, STRING_MIN);
