                    p_info[playerid][active_vehicle_id] = old_id;
                    return SendError(playerid, "У Вас нет транспорта в этом слоте.");
                }
                switch(p_temp[playerid][p_listitem_int])
                {
                    case VEHICLE_ID_SELECT:
                        SendAccess(playerid, "Вы выбрали транспорт: "I"%s "W"(Слот: %d)", GetVehicleName(vehicleid), listitem+1);
                    case VEHICLE_ID_FIND:
                        VehiclePlayer_Find(playerid, vehicleid);
                    case VEHICLE_ID_DELIVERY:
                        VehiclePlayer_Delivery(playerid, vehicleid);
                    case VEHICLE_ID_MARKET_UNBET:
                    {
                        if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_CAR && GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_MOTO)
                            return SendError(playerid, "Пользоваться авторынком можно только для автомобилей и мотоциклов.");
                        CarMarketVehicleDestroy(playerid, vehicleid);
                    }
                }
                p_temp[playerid][p_listitem_int] = -1;
            }
            return 1;
        }

        case D_BIZZ_PLAYER_LIST:
        {
            if(!response) return 1;
            if(p_info[playerid][bizz_slots] <= listitem)
            {
                if(p_info[playerid][bizz_slots] >= MAX_BIZZ_PLAYER)
                {
                    SendError(playerid, "Достигнуто максимального значения - %d бизнесов.", MAX_BIZZ_PLAYER);
                    return ShowPlayerDonate(playerid, DONATE_TYPE_MENU);
                }
                new price, count_bizz = p_info[playerid][bizz_slots];
