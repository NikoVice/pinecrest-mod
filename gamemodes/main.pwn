                    SendInfo(playerid, "Макавелли отмечен на GPS навигаторе. Расстояние: %.0f метров.", GetPlayerDistanceFromPoint(playerid, 1661.4196,-1395.1777,13.5469));
                }
                case 4:
                {
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    SetPlayerGPS(playerid, 2199.0745,-1973.2469,13.5581, 5.0);
                    SendInfo(playerid, "Крис отмечен на GPS навигаторе. Расстояние: %.0f метров.", GetPlayerDistanceFromPoint(playerid, 2199.0745,-1973.2469,13.5581));
                }
                case 5:
                {
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    SetPlayerGPS(playerid, 826.3442,-1346.7013,13.5334, 5.0);
                    SendInfo(playerid, "Сантьяго отмечен на GPS навигаторе. Расстояние: %.0f метров.", GetPlayerDistanceFromPoint(playerid, 826.3442,-1346.7013,13.5334));
                }
                case 6:
                {
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    SetPlayerGPS(playerid, -1020.4773,-696.5507,32.0078, 5.0);
                    SendInfo(playerid, "Дрейк отмечен на GPS навигаторе. Расстояние: %.0f метров.", GetPlayerDistanceFromPoint(playerid, -1020.4773,-696.5507,32.0078));
                }
                case 7:
                {
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    SetPlayerGPS(playerid, 287.1633,1398.2845,10.5859, 5.0);
                    SendInfo(playerid, "Эндрю отмечен на GPS навигаторе. Расстояние: %.0f метров.", GetPlayerDistanceFromPoint(playerid, 287.1633,1398.2845,10.5859));
                }
                case 8:
                {
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    new fuelid = RobberyFuelContract[idx][rfcFuelIDx];
                    SetPlayerGPS(playerid, b_info[fuelid][b_enter][0], b_info[fuelid][b_enter][1], b_info[fuelid][b_enter][2], 5.0);
                    SendInfo(playerid, "АЗС отмечен на GPS навигаторе. Расстояние: %.0f метров.", GetPlayerDistanceFromPoint(playerid, b_info[fuelid][b_enter][0], b_info[fuelid][b_enter][1], b_info[fuelid][b_enter][2]));
                }
                case 9:
                {
                    new vehicleid = RobberyFuelContract[idx][rfcVehicleIDx];
                    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "В контракте нет транспортного средства, продайте топливо из канистры Эндрю."), ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);

                    new Float:x, Float:y, Float:z, Float:r;

                    GetVehicleZAngle(vehicleid, r);
                    GetVehiclePos(vehicleid, x, y, z);
                    y = y - (2.5 * floatcos(r, degrees));
                    x = x - (-2.5 * floatsin(r, degrees));

                    if(!IsPlayerInRangeOfPoint(playerid, 5.0, x, y, z)) return SendError(playerid, "Вы далеко от багажника."), ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);

                    new items_idx, items_max = RobberyFuelContract[idx][rfcType] == 0 ? MAX_ROBBERY_FUEL_LITERS : MAX_ROBBERY_FUEL_LITERS * 2;
                    if(p_temp[playerid][rob_fuel_backup_items][0] == 0)
                    {
                        items_idx = RobberyFuelContract[idx][rfcVehicleItems];
                        if(items_idx)
                        {
                            if(items_idx > items_max) items_idx = items_max;
                            RobberyFuelContract[idx][rfcVehicleItems] -= items_idx;
                            p_temp[playerid][rob_fuel_backup_items][0] += items_idx;
                            STRING_GLOBAL[0] = EOS;
                            f(STRING_GLOBAL, "[ROBBERY] %s [%d] взял(-а) %d литров из транспортного средства.", get_name(playerid), playerid, items_idx);
                            SendRobberyFuelMessage(idx, 0xDEB887FF, STRING_GLOBAL);
                            SendAccess(playerid, "Вы взяли %d литров из транспортного средства.", items_idx);
                        }
                        else SendError(playerid, "В транспортном средстве ничего нет."), ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
                    }
                    else
                    {
                        items_idx = p_temp[playerid][rob_fuel_backup_items][0];
                        if(items_idx)
                        {
                            RobberyFuelContract[idx][rfcVehicleItems] += items_idx;
                            p_temp[playerid][rob_fuel_backup_items][0] = 0;
                            if(p_temp[playerid][rob_fuel_timer] == 2) p_temp[playerid][rob_fuel_timer] = 1;
                            STRING_GLOBAL[0] = EOS;
                            f(STRING_GLOBAL, "[ROBBERY] %s [%d] положил(-а) %d литров из транспортного средства.", get_name(playerid), playerid, items_idx);
                            SendRobberyFuelMessage(idx, 0xDEB887FF, STRING_GLOBAL);
                            SendAccess(playerid, "Вы положили %d литров из транспортного средства.", items_idx);
                        }
                        else SendError(playerid, "В канистре ничего нет."), ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
                    }
                }
                case 10:
                {
                    if(RobberyFuelContract[idx][rfcStatus] == 3) return SendError(playerid, "Ограбление АЗС уже началось."), ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);

                    for(new i = 0; i < MAX_ROBBERY_FUEL_ITEMS_START; i++)
                    {
                        if(RobberyFuelContract[idx][rfcItemsStart][i] == 0 && RobberyFuelItemsStart[i][rfiStatus] == true) return SendError(playerid, "Для начала ограбления необходимо приобрести предмет \"%s\".", RobberyFuelItemsStart[i][rfiName]), ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
                    }
                    if(RobberyFuelContract[idx][rfcVehicleIDx] == INVALID_VEHICLE_ID) return SendError(playerid, "Для начала ограбления необходимо арендовать транспортное средство."), ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
                    ShowRobberyFuel(playerid, ROBBERY_FUEL_START, idx);
                }
                case 11: ShowRobberyFuel(playerid, ROBBERY_FUEL_ITEMS_LIST, idx);
                case 12:
                {
                    if(RobberyFuelContract[idx][rfcTimeUpdate]) return SendError(playerid, "Продлевать контракт можно 1 раз."), ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
                    ShowRobberyFuel(playerid, ROBBERY_FUEL_EXTEND_CONTRACT, idx);
                }
                case 13:
                {
                    if(p_temp[playerid][rob_fuel_backup_pickup] == -1 || p_temp[playerid][rob_fuel_backup_area] == -1) return SendError(playerid, "Вы не теряли сумку или ее кто-то уже забрал."), ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
                    new Float:distance = GetPlayerDistanceFromPoint(playerid, p_temp[playerid][rob_fuel_backup_pos][0], p_temp[playerid][rob_fuel_backup_pos][1], p_temp[playerid][rob_fuel_backup_pos][2]);
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    SetPlayerGPS(playerid, p_temp[playerid][rob_fuel_backup_pos][0], p_temp[playerid][rob_fuel_backup_pos][1], p_temp[playerid][rob_fuel_backup_pos][2], 5.0);
                    SendInfo(playerid, "\"Сумка\" отмечена на GPS навигаторе. Расстояние: %.0f метров.", distance);
                }
                case 14:
                {
                    if(RobberyFuelContract[idx][rfcOwnerID] == p_info[playerid][ID]) return SendError(playerid, "Владелец контракта не может покинуть ограбление АЗС, откажитесь от контракта."), ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
                    ShowRobberyFuel(playerid, ROBBERY_FUEL_LEAVE);
                }
                case 15:
                {
                    if(RobberyFuelContract[idx][rfcOwnerID] != p_info[playerid][ID]) return SendError(playerid, "Вы не являетесь владелецем контракта."), ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
                    ShowRobberyFuel(playerid, ROBBERY_FUEL_DELETE, idx);
                }
            }
            return 1;
        }
        case D_ROB_FUEL_PLAYER:
        {
            if(!response) return ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
            new scdplayerid, rank, idx = p_temp[playerid][rob_fuel_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении АЗС.");
            if(RobberyFuelContract[idx][rfcStatus] == 3) return ShowRobberyFuel(playerid, ROBBERY_FUEL_PLAYER, idx), SendError(playerid, "Вы не можете пригласить подельника, ограбление АЗС уже началось.");
            if(sscanf(inputtext, "p<,>ii", scdplayerid, rank)) return ShowRobberyFuel(playerid, ROBBERY_FUEL_PLAYER, idx), SendError(playerid, "Вводить нужно только цифру пункта.");
            if(scdplayerid == INVALID_PLAYER_ID) return ShowRobberyFuel(playerid, ROBBERY_FUEL_PLAYER, idx), SendError(playerid, "Игрок не найден.");
            if(!IsPlayerStream(5.0, playerid, scdplayerid) || pSpectateId[scdplayerid] != INVALID_PLAYER_ID) return ShowRobberyFuel(playerid, ROBBERY_FUEL_PLAYER, idx), SendError(playerid, "Игрок слишком далеко от Вас.");
            if(rank < 2 || rank > 4) return ShowRobberyFuel(playerid, ROBBERY_FUEL_PLAYER, idx), SendError(playerid, "Должность должна быть не менее 2 и не более 4.");
            if(RobberyFuelContract[idx][rfcPlayerID][rank-1] != INVALID_PLAYER_ID) return ShowRobberyFuel(playerid, ROBBERY_FUEL_PLAYER, idx), SendError(playerid, "На данной должности уже есть подельник.");
            if(gos(scdplayerid)) return SendError(playerid, "Данный игрок не состоит в семье или нелегальной организации.");
            if((!mafia(scdplayerid) && !gang(scdplayerid) && !biker(scdplayerid)) && p_info[scdplayerid][fwork] == true) return SendError(playerid, "Данынй игрок не закончил рабочий день.");
            if(p_temp[scdplayerid][rob_house_idx] != -1 || p_temp[scdplayerid][rob_bank_idx] != -1 || p_temp[scdplayerid][rob_fuel_idx] != -1) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_PLAYER, idx), SendError(playerid, "Данный игрок уже состоит в какой-то команде в ограблении дома, банка или АЗС.");
            if(p_info[scdplayerid][level] < 20) return SendError(playerid, "Участвовать в ограблениях можно с 20-ого уровня.");
            SendAccess(playerid, "Вы предложили %s [%d] участвовать в ограблении АЗС на должности \"%s\".", get_name(scdplayerid), scdplayerid, RobberyFuelPlayer[rank - 1][rfpName]);
            SendInfo(scdplayerid, "%s [%d] предложил Вам участвовать в ограблении АЗС на должности \"%s\".", get_name(playerid), playerid, RobberyFuelPlayer[rank - 1][rfpName]);
            SetFreeSlotOffer(scdplayerid, playerid, OFFER_ID_INVITE_ROB_FUEL, 0, rank - 1);
            return 1;
        }
        case D_ROB_FUEL_USE:
        {
            if(!response) return ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
            new idx = p_temp[playerid][rob_fuel_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении АЗС.");
            new fuelid = RobberyFuelContract[idx][rfcFuelIDx], scdplayerid;
            if(RobberyFuelContract[idx][rfcStatus] != 3) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Вы не можете использовать предметы, ограбление АЗС еще не началось.");
            if(RobberyFuelContract[idx][rfcItemsStart][listitem] == 0) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "В списке предметов для ограбления АЗС нет \"%s\".", RobberyFuelItemsStart[listitem][rfiName]);
            switch(listitem)
            {
                case 0:
                {
                    if(RobberyFuelContract[idx][rfcPlayerID][1] != INVALID_PLAYER_ID && p_temp[playerid][rob_fuel_rank] != 1) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Использовать бронежилеты может только \"%s\".", RobberyFuelPlayer[1][rfpName]);
                    RobberyFuelContract[idx][rfcItemsStart][0] = 0;
                    for(new i = 0; i < MAX_ROBBERY_FUEL_PLAYER; i++)
                    {
                        scdplayerid = RobberyFuelContract[idx][rfcPlayerID][i];
                        if(scdplayerid != INVALID_PLAYER_ID)
                        {
                            SetPlayerArmour(scdplayerid, 100);
                        }
                    }
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "[ROBBERY] %s [%d] использовал(-а) бронежилеты для всей команды.", get_name(playerid), playerid);
                    SendRobberyFuelMessage(idx, 0xDEB887FF, STRING_GLOBAL);
                }
                case 1:
                {
                    if(RobberyFuelContract[idx][rfcPlayerID][1] != INVALID_PLAYER_ID && p_temp[playerid][rob_fuel_rank] != 1) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Использовать оружие может только \"%s\".", RobberyFuelPlayer[1][rfpName]);
                    RobberyFuelContract[idx][rfcItemsStart][1] = 0;
                    for(new i = 0; i < MAX_ROBBERY_FUEL_PLAYER; i++)
                    {
                        scdplayerid = RobberyFuelContract[idx][rfcPlayerID][i];
                        if(scdplayerid != INVALID_PLAYER_ID)
                        {
                            f_GivePlayerWeapon(scdplayerid, 24, 50);
                            f_GivePlayerWeapon(scdplayerid, 31, 150);
                        }
                    }
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "[ROBBERY] %s [%d] использовал(-а) оружие для всей команды.", get_name(playerid), playerid);
                    SendRobberyFuelMessage(idx, 0xDEB887FF, STRING_GLOBAL);
                }
                case 2:
                {
                    if(RobberyFuelContract[idx][rfcPlayerID][1] != INVALID_PLAYER_ID && p_temp[playerid][rob_fuel_rank] != 1) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Использовать маски может только \"%s\".", RobberyFuelPlayer[1][rfpName]);
                    if(RobberyFuelContract[idx][rfcItemsStart][6] != 0) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Для начала необходимо использовать \"%s\".", RobberyFuelItemsStart[6][rfiName]);
                    RobberyFuelContract[idx][rfcItemsStart][2] = 0;
                    new idx_skin;
                    for(new i = 0; i < MAX_ROBBERY_FUEL_PLAYER; i++)
                    {
                        scdplayerid = RobberyFuelContract[idx][rfcPlayerID][i];
                        if(scdplayerid != INVALID_PLAYER_ID)
                        {
                            idx_skin = GetPlayerSkin(scdplayerid);
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `accessories_coords` WHERE `type` = 31 AND `skin_id` = %d LIMIT 1", idx_skin);
                            mysql_pquery(con_bd, STRING_GLOBAL, "AccessoriesCoords", "ddd", scdplayerid, p_info[scdplayerid][ID], 4);
                            //SetPlayerAttachedObject(scdplayerid, 0, 19801, 2, fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ);

                            SetPlayerChatBubble(scdplayerid, "Надел(-а) маску", COLOR_MAIN, 20.0, 10000);
                            if(!IsPlayerInAnyVehicle(scdplayerid)) ApplyAnimation(scdplayerid, "SHOP", "ROB_Shifty", 4.0, 0, 0, 0, 0, 0, 1);
                            SetPlayerColor(scdplayerid, 0x4F4F4F00);
                            p_temp[scdplayerid][UseMaskFix] = 1;
                            p_temp[scdplayerid][UseMaskTimerFix] = timestamp + 3600;
                            SendAccess(scdplayerid, "Вы надели маску.");
                            SendInfo(scdplayerid, "Ваше местоположение на GPS навигаторе скрыто на 60 мин.");

                            if(p_info[playerid][p_settings][ROLEPLAY] == 1)
                            {
                                DoAction(scdplayerid, "Маска лежит в кармане.");
                                MeAction(scdplayerid, "засунул правую руку в карман, после чего нащупав маску достал ее и одел на голову");
                            }
                        }
                    }
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "[ROBBERY] %s [%d] использовал(-а) маски для всей команды.", get_name(playerid), playerid);
                    SendRobberyFuelMessage(idx, 0xDEB887FF, STRING_GLOBAL);
                }
                case 3:
                {
                    if(RobberyFuelContract[idx][rfcPlayerID][1] != INVALID_PLAYER_ID && p_temp[playerid][rob_fuel_rank] != 1) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Использовать электронную глушилку может только \"%s\".", RobberyFuelPlayer[1][rfpName]);
                    if(!IsPlayerInRangeOfPoint(playerid, 5.5, b_info[fuelid][b_enter][0], b_info[fuelid][b_enter][1], b_info[fuelid][b_enter][2])) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Вы слишком далеко от АЗС.");

                    RobberyFuelContract[idx][rfcItemsStart][3] = 0;
                    StartRobbingMiniGame(playerid, ROBBING_TYPE_FUEL, ROB_FUEL_ITEMS_ELECTRO_JAMMER, 120);
                }
                case 4:
                {
                    if(RobberyFuelContract[idx][rfcPlayerID][2] != INVALID_PLAYER_ID && p_temp[playerid][rob_fuel_rank] != 2) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Использовать перебитые номера может только \"%s\".", RobberyFuelPlayer[2][rfpName]);
                    new vehicleid = RobberyFuelContract[idx][rfcVehicleIDx];
                    if(vehicleid == INVALID_VEHICLE_ID) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Транспортное средство для ограбления АЗС не арендовано.");
                    new Float:x, Float:y, Float:z, Float:r;
                    GetVehicleZAngle(vehicleid, r);
                    GetVehiclePos(vehicleid, x, y, z);
                    y = y - (2.5 * floatcos(r, degrees));
                    x = x - (-2.5 * floatsin(r, degrees));
                    if(!IsPlayerInRangeOfPoint(playerid, 5.0, x, y, z)) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Вы далеко от багажника.");
                    if(RobberyFuelContract[idx][rfcVehicleNumber] == 1) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "На машине уже установлены перебитые номера.");
                    RobberyFuelContract[idx][rfcItemsStart][4] = 0;
                    StartRobbingMiniGame(playerid, ROBBING_TYPE_FUEL, ROB_FUEL_ITEMS_NUMBER, 60);
                }
                case 5:
                {
                    if(RobberyFuelContract[idx][rfcPlayerID][2] != INVALID_PLAYER_ID && p_temp[playerid][rob_fuel_rank] != 2) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Использовать канистры может только \"%s\".", RobberyFuelPlayer[2][rfpName]);
                    if(RobberyFuelContract[idx][rfcItemsStart][6] != 0) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Для начала необходимо использовать \"%s\".", RobberyFuelItemsStart[6][rfiName]);
                    RobberyFuelContract[idx][rfcItemsStart][5] = 0;
                    new idx_skin;
                    for(new i = 0; i < MAX_ROBBERY_FUEL_PLAYER; i++)
                    {
                        scdplayerid = RobberyFuelContract[idx][rfcPlayerID][i];
                        if(scdplayerid != INVALID_PLAYER_ID)
                        {
                            idx_skin = GetPlayerSkin(scdplayerid);
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `accessories_coords` WHERE `type` = 130 AND `skin_id` = %d LIMIT 1", idx_skin);
                            mysql_pquery(con_bd, STRING_GLOBAL, "AccessoriesCoords", "ddd", scdplayerid, p_info[scdplayerid][ID], 5);
                            //SetPlayerAttachedObject(scdplayerid, 1, 1650, 1, fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ);

                            p_temp[scdplayerid][rob_fuel_backup] = 1;
                        }
                    }
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "[ROBBERY] %s [%d] использовал(-а) канистры для всей команды.", get_name(playerid), playerid);
                    SendRobberyFuelMessage(idx, 0xDEB887FF, STRING_GLOBAL);
                }
                case 6:
                {
                    if(RobberyFuelContract[idx][rfcPlayerID][3] != INVALID_PLAYER_ID && p_temp[playerid][rob_fuel_rank] != 3) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Использовать насос может только \"%s\".", RobberyFuelPlayer[3][rfpName]);
                    RobberyFuelContract[idx][rfcItemsStart][6] = 0;
                    new rob_fuel_skins[4] = {8, 50, 188, 249};
                    for(new i = 0; i < MAX_ROBBERY_FUEL_PLAYER; i++)
                    {
                        scdplayerid = RobberyFuelContract[idx][rfcPlayerID][i];
                        if(scdplayerid != INVALID_PLAYER_ID)
                        {
                            SetPlayerSkin(scdplayerid, rob_fuel_skins[i]);
                        }
                    }
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "[ROBBERY] %s [%d] использовал(-а) одежду для всей команды.", get_name(playerid), playerid);
                    SendRobberyFuelMessage(idx, 0xDEB887FF, STRING_GLOBAL);
                }
                case 7:
                {
                    if(RobberyFuelContract[idx][rfcPlayerID][3] != INVALID_PLAYER_ID && p_temp[playerid][rob_fuel_rank] != 3) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Использовать насос может только \"%s\".", RobberyFuelPlayer[3][rfpName]);
                    if(!IsPlayerInRangeOfPoint(playerid, 5.5, b_info[fuelid][b_enter][0], b_info[fuelid][b_enter][1], b_info[fuelid][b_enter][2])) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Вы слишком далеко от АЗС.");

                    if(RobberyFuelContract[idx][rfcAnticall] == 1) {}
                    else CallingPoliceToRobberyFuel(idx, RobberyFuelContract[idx][rfcFuelIDx]);

                    RobberyFuelContract[idx][rfcItemsStart][7] = 0;
                    StartRobbingMiniGame(playerid, ROBBING_TYPE_FUEL, ROB_FUEL_ITEMS_PUMP, 60);
                }
                case 8:
                {
                    if(RobberyFuelContract[idx][rfcPlayerID][3] != INVALID_PLAYER_ID && p_temp[playerid][rob_fuel_rank] != 3) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Использовать насос может только \"%s\".", RobberyFuelPlayer[3][rfpName]);
                    if(!IsPlayerInRangeOfPoint(playerid, 5.5, b_info[fuelid][b_enter][0], b_info[fuelid][b_enter][1], b_info[fuelid][b_enter][2])) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Вы слишком далеко от АЗС.");
                    if(RobberyFuelContract[idx][rfcItemsStart][7] != 0) return ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx), SendError(playerid, "Для начала необходимо установить \"%s\".", RobberyFuelItemsStart[7][rfiName]);

                    RobberyFuelContract[idx][rfcItemsStart][8] = 0;
                    StartRobbingMiniGame(playerid, ROBBING_TYPE_FUEL, ROB_FUEL_ITEMS_HOSE, 60);
                }
            }
            if(listitem == 0 || listitem == 1 || listitem == 2 || listitem == 5 || listitem == 6) ShowRobberyFuel(playerid, ROBBERY_FUEL_USE, idx);
            return 1;
        }
        case D_ROB_FUEL_START:
        {
            if(!response) return ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
            new idx = p_temp[playerid][rob_fuel_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении АЗС.");
            if(RobberyFuelContract[idx][rfcStatus] == 3) return SendError(playerid, "Вы не можете начать ограбление АЗС, оно уже началось."), ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "[ROBBERY] %s [%d] начал(-а) ограбление.", get_name(playerid), playerid);
            SendRobberyFuelMessage(idx, 0xDEB887FF, STRING_GLOBAL);
            RobberyFuelContract[idx][rfcStatus] = 3;
            ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
            return 1;
        }
        case D_ROB_FUEL_ITEMS_LIST: return ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
        case D_ROB_FUEL_EXTEND_CONTRACT:
        {
            if(!response) return ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
            new idx = p_temp[playerid][rob_fuel_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении АЗС.");
            new price = RobberyFuelContract[idx][rfcPrice] / 2;
            if(RobberyFuelContract[idx][rfcTimeUpdate]) return SendError(playerid, "Продлевать контракт можно 1 раз."), ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate"), ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
            SetPlayerMoney(playerid, -price, true, "продление контракта для ограбления АЗС");
            RobberyFuelContract[idx][rfcTime] += 1800;
            RobberyFuelContract[idx][rfcTimeUpdate] = 1;
            SendAccess(playerid, "Вы продлили контракт ограбления АЗС на 30 минут.");
            ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
            return 1;
        }
        case D_ROB_FUEL_LEAVE:
        {
            if(!response) return ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
            new idx = p_temp[playerid][rob_fuel_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении АЗС.");
            if(RobberyFuelContract[idx][rfcOwnerID] == p_info[playerid][ID]) return SendError(playerid, "Владелец контракта не может покинуть ограбление АЗС, откажитесь от контракта."), ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
            for(new i = 0; i < MAX_ROBBERY_FUEL_PLAYER; i++)
            {
                if(RobberyFuelContract[idx][rfcPlayerID][i] == playerid)
                {
                    RobberyFuelContract[idx][rfcPlayerID][i] = INVALID_PLAYER_ID;
                    ClearRobberyFuel(playerid, 1);
                    ClearRobberyFuelBackup(playerid, 1);
                    SetPlayerSkinEx(playerid);
                    maskOFF(playerid);
                    SendAccess(playerid, "Вы покинули ограбление АЗС.");
                    AttachToPlayerAccOrCostume(playerid, INVALID_PLAYER_ID);
                    return 1;
                }
            }
            SendError(playerid, "Вы не участвуете в ограблении АЗС.");
            return 1;
        }
        case D_ROB_FUEL_DELETE:
        {
            if(!response) return ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
            new idx = p_temp[playerid][rob_fuel_idx], scdplayerid;
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении АЗС.");
            if(RobberyFuelContract[idx][rfcOwnerID] != p_info[playerid][ID]) return SendError(playerid, "Вы не являетесь владелецем контракта."), ShowRobberyFuel(playerid, ROBBERY_FUEL_MENU);
            SendAccess(playerid, "Вы завершили контракт.");
            new money = GetRobberyFuelShare(idx);
            for(new i = 0; i < MAX_ROBBERY_FUEL_PLAYER; i++)
            {
                scdplayerid = RobberyFuelContract[idx][rfcPlayerID][i];
                if(scdplayerid != INVALID_PLAYER_ID)
                {
                    RobberyFuelContract[idx][rfcPlayerID][i] = INVALID_PLAYER_ID;
                    ClearRobberyFuel(scdplayerid, 1);
                    ClearRobberyFuelBackup(scdplayerid, 1);
                    SetPlayerSkinEx(scdplayerid);
                    maskOFF(scdplayerid);
                    SetPlayerMoney(scdplayerid, money, true, "завершил ограбление АЗС");
                    RobbingInfoForMoney[5] += money;
                    SendInfo(scdplayerid, "Владелец контракта завершил ограбление АЗС.");
                    SendInfo(scdplayerid, "Вы заработали: %d$.", money);
                    AttachToPlayerAccOrCostume(scdplayerid, INVALID_PLAYER_ID);
                }
            }
            DestroyRobberyFuelContract(idx);
            return 1;
        }
        case D_ROB_FUEL_NPC_BUY:
        {
            if(!response)
            {
                if(IsPlayerInRangeOfPoint(playerid, 2.5, 1632.7802,-1521.7112,13.6076)) ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_2);
                DeletePVar(playerid, "RobberyFuel:items_idx");
                return 1;
            }
            ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_BUY_ACT, p_temp[playerid][rob_fuel_idx], p_temp[playerid][p_listitem][listitem]);
            return 1;
        }
        case D_ROB_FUEL_NPC_BUY_ACT:
        {
            new idx = p_temp[playerid][rob_fuel_idx], i = GetPVarInt(playerid, "RobberyFuel:items_buy"), x = GetPVarInt(playerid, "RobberyFuel:items_idx");
            DeletePVar(playerid, "RobberyFuel:items_buy");
            DeletePVar(playerid, "RobberyFuel:items_idx");
            if(!response) return ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_BUY, x);
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении АЗС.");
            new price = RobberyFuelItemsStart[i][rfiPrice];
            if(RobberyFuelContract[idx][rfcStatus] == 3) return ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_BUY, x), SendError(playerid, "Вы не можете приобрести предметы, ограбление АЗС уже началось.");
            if(RobberyFuelContract[idx][rfcItemsStart][i]) return ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_BUY, x), SendError(playerid, "Данный предмет уже приобретен.");
            if(p_info[playerid][cash] < price) return ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_BUY, x), SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            SetPlayerMoney(playerid, -price, true, "покупка предмета для ограбления АЗС");
            RobbingInfoForMoney[4] += price;
            RobberyFuelContract[idx][rfcItemsStart][i] = 1;
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "[ROBBERY] %s [%d] приобрел(-а) \"%s\" для всей команды за %d$.", get_name(playerid), playerid, RobberyFuelItemsStart[i][rfiName], price);
            SendRobberyFuelMessage(idx, 0xDEB887FF, STRING_GLOBAL);
            ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_BUY, x);
            return 1;
        }
        case D_ROB_FUEL_NPC_2:
        {
            if(!response) return 1;
            new idx = p_temp[playerid][rob_fuel_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении АЗС.");
            switch(listitem)
            {
                case 0:
                {
                    if(RobberyFuelContract[idx][rfcStatus] == 3) return ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_2), SendError(playerid, "Вы не можете арендовать транспортное средство, ограбление АЗС уже началось.");
                    if(RobberyFuelContract[idx][rfcVehicleIDx] != INVALID_VEHICLE_ID) return ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_2), SendError(playerid, "Транспортное средство для ограбления уже было арендовано.");
                    ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_2_R_VEHICLE, idx);
                }
                case 1: ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_BUY, 2);
            }
            return 1;
        }
        case D_ROB_FUEL_NPC_2_RENT_VEHICLE:
        {
            if(!response) return ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_2);
            new idx = p_temp[playerid][rob_fuel_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении АЗС.");
            if(RobberyFuelContract[idx][rfcStatus] == 3) return ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_2), SendError(playerid, "Вы не можете арендовать транспортное средство, ограбление АЗС уже началось.");
            if(RobberyFuelContract[idx][rfcVehicleIDx] != INVALID_VEHICLE_ID) return ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_2), SendError(playerid, "Транспортное средство для ограбления АЗС уже было арендовано.");
            if(p_info[playerid][cash] < RENT_PRICE_ROBBERY_B_VEHICLE) return ShowRobberyFuel(playerid, ROBBERY_FUEL_NPC_2), SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            new car_id = CreateVehicleVEx(NPO_ROBBERY_FUEL, NPO_NONE, 554, 2199.6921+random(1),-1979.2178+random(1),13.6111,269.7859, 1, 1, 86400);

            RobberyFuelContract[idx][rfcVehicleIDx] = car_id;

            veh_info[car_id][v_lock] = 0;
            veh_info[car_id][v_color] = 1;
            veh_info[car_id][v_model] = 554;
            veh_info[car_id][v_fuel] = GetVehicleData(GetVehicleModelEx(car_id), E_VD_MAX_FUEL);
            for(new i; i < 5; i++) veh_info[car_id][v_details][i] = 100.0;
            format(veh_info[car_id][v_number], 16, "NULL");
            veh_info[car_id][v_int] =
            veh_info[car_id][v_virt] =
            veh_info[car_id][v_insurance] =
            veh_info[car_id][v_insurance_time] = 0;

            veh_info[car_id][v_rob_fuel_idx] = idx;

            PutPlayerInVehicle(playerid, car_id, 0);

            veh_info[car_id][v_engine] = 1;
            OnPlayerUpdateVehicleInfo(playerid, SPEEDO_ENGINE);
            PlayerPlaySound(playerid, 31810, 0.0, 0.0, 0.0);

            MeAction(playerid, "завел(-а) двигатель");
            SetVehicleParamsVEx(car_id, veh_info[car_id][v_engine], veh_info[car_id][v_light], alarm, veh_info[car_id][v_lock], bonnet, boot, objective);

            SetPlayerMoney(playerid, -RENT_PRICE_ROBBERY_B_VEHICLE, true, "т/с: аренда для ограбления АЗС <%s>(%d)", GetVehicleName(car_id), GetVehicleModelEx(car_id));
            RobbingInfoForMoney[4] += RENT_PRICE_ROBBERY_B_VEHICLE;

            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "[ROBBERY] %s [%d] арендовал(-а) \"%s\" для всей команды за %d$.", get_name(playerid), playerid, GetVehicleName(car_id), RENT_PRICE_ROBBERY_B_VEHICLE);
            SendRobberyFuelMessage(idx, 0xDEB887FF, STRING_GLOBAL);
            return 1;
        }
        case D_ROB_FUEL_NPC_3:
        {
            if(!response) return 1;
            new idx = p_temp[playerid][rob_fuel_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении АЗС.");
            if(p_temp[playerid][rob_fuel_backup] == 0) return SendError(playerid, "У Вас нет сумки.");
            new temp_rob_fuel_liters = p_temp[playerid][rob_fuel_backup_items][0];
            if(temp_rob_fuel_liters == 0) return SendError(playerid, "В Вашей канистре ничего нет.");
            p_temp[playerid][rob_fuel_backup_items][0] = 0;
            new price = temp_rob_fuel_liters * PRICE_ROBBERY_F_LITERS;
            RobberyFuelContract[idx][rfcKush] += price;
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "[ROBBERY] %s [%d] сбыл(-а) содержимое канистры на %d$. Общий куш: %d$.", get_name(playerid), playerid, price, RobberyFuelContract[idx][rfcKush]);
            SendRobberyFuelMessage(idx, 0xDEB887FF, STRING_GLOBAL);
            return 1;
        }
        case D_GPS_BANK:
        {
            if(!response) return 1;
            if(p_temp[playerid][gps_admin] == 1000+playerid)
            {
                if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
                {
                    new vehicleid = GetPlayerVehicleID(playerid);
                    SetVehiclePos(vehicleid, BankInfo[listitem][bEnter][0], BankInfo[listitem][bEnter][1], BankInfo[listitem][bEnter][2]);
                    LinkVehicleToInterior(vehicleid, 0);
                    SetVehicleVirtualWorld(vehicleid, 0);
                }
                else
                {
                    SetPlayerPos(playerid, BankInfo[listitem][bEnter][0], BankInfo[listitem][bEnter][1], BankInfo[listitem][bEnter][2]);
                    SetPlayerInterior(playerid, 0);
                    SetPlayerVirtualWorld(playerid, 0);
                }
                p_temp[playerid][gps_admin] = INVALID_PLAYER_ID;
                return 1;
            }
            new target_id = p_temp[playerid][gps_admin] == INVALID_PLAYER_ID ? playerid : p_temp[playerid][gps_admin];
            if(p_temp[playerid][gps_admin] != INVALID_PLAYER_ID)
            {
                SendInfo(target_id, "Администратор %s[%d] обозначил вам %s на GPS навигаторе.", get_name(playerid), playerid, BankInfo[listitem][bName]);
                SendInfo(playerid, "Вы обозначали %s[%d] обозначили %s на GPS навигаторе.", get_name(target_id), target_id, BankInfo[listitem][bName]);
                p_temp[playerid][gps_admin] = INVALID_PLAYER_ID;
            }
            new Float:distance = GetPlayerDistanceFromPoint(target_id, BankInfo[listitem][bEnter][0], BankInfo[listitem][bEnter][1], BankInfo[listitem][bEnter][2]);
            if(p_temp[target_id][TaxiGPS] == true)
            {
                if(GetPlayerTaxiDriver(target_id) == INVALID_PLAYER_ID) return SendError(target_id, "В такси нет водителя.");

                new driverid = GetPlayerTaxiDriver(target_id);
                p_temp[target_id][TaxiGPS] = false;
                SetPlayerGPS(driverid, BankInfo[listitem][bEnter][0], BankInfo[listitem][bEnter][1], BankInfo[listitem][bEnter][2], 6.0);

                SendInfo(driverid, "%s обозначил место назначения. Расстояние: %.0f метров.", get_name(target_id), distance);
                return 1;
            }
            
            SendInfo(target_id, "\"%s\" отмечено на GPS навигаторе. Расстояние: %.0f метров.", BankInfo[listitem][bName], distance);
            SetPlayerGPS(target_id, BankInfo[listitem][bEnter][0], BankInfo[listitem][bEnter][1], BankInfo[listitem][bEnter][2], 6.0);
            return 1;
        }
        case D_DEATH:
        {
            if(p_temp[playerid][death_status] == 0) return SendError(playerid, "Вы не можете воспользоваться выбором, время вышло.");
            if(!response)
            {
                p_temp[playerid][death_status] = 0;
                p_temp[playerid][death_timer] = 0;
                p_temp[playerid][death_anim] = 0;
                Fix_TogglePlayerControllable(playerid, 1);
                ClearAnimations(playerid);
                if(p_info[playerid][p_add_vip] != 0) p_temp[playerid][dead_status] = false;
                SpawnPlayer(playerid);
                return 1;
            }
            switch(listitem)
            {
                case 0:
                {
                    p_temp[playerid][death_status] = 0;
                    p_temp[playerid][death_timer] = 0;
                    p_temp[playerid][death_anim] = 0;
                    Fix_TogglePlayerControllable(playerid, 1);
                    ClearAnimations(playerid);
                    if(p_info[playerid][p_add_vip] != 0) p_temp[playerid][dead_status] = false;
                    SpawnPlayer(playerid);
                }
                case 1:
                {
                    new fraction_id, Float:pos[3];
                    GetPlayerPos(playerid,pos[0],pos[1],pos[2]);
                    fraction_id = GetPlayerPositionCity(playerid, pos[0],pos[1],pos[2]);
                    SetPVarInt(playerid, "CALL:SERVICES", 2);
                    SendAccess(playerid, "Вы вызвали медиков.");
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] вызывает медиков. Он сейчас в \"%s\", район \"%s\". Принять вызов: /to %d", get_name(playerid), playerid, gSAZonesCity[GetCityName(pos[0],pos[1])][SAZONE_NAME], gSAZones[GetZonaName(pos[0],pos[1])][SAZONE_NAME], playerid);
                    SendFractionMessage(fraction_id+14, 0x33CC66FF, STRING_GLOBAL);
                    SendFractionMessage(fraction_id+14, 0x33CC66FF, "[F] Сообщение: Без сознания.");
                    p_temp[playerid][death_timer] = 300;
                }
                case 2:
                {
                    if(GetInventoryAmount(playerid, 683) <= 0)
                    {
                        SendError(playerid, "У вас не укола адреналина.");
                        if(p_info[playerid][p_vip] != 0)
                            f(STRING_GLOBAL, ""I"[1]"W" Появиться на месте спавна\n"I"[2]"W" Вызвать врачей (5 мин.)\n"I"[3]"W" Использовать: укол адреналина.");
                        else 
                            f(STRING_GLOBAL, ""I"[1]"W" Появиться в больнице\n"I"[2]"W" Вызвать врачей (5 мин.)");
                        ShowPlayerDialog(playerid, D_DEATH, DIALOG_STYLE_LIST, ""I"Выберите действие", STRING_GLOBAL, "Далее", "Отмена");
                        return 1;
                    }
                    GivePlayerInventory(playerid, 683, -1);

                    p_temp[playerid][death_status] = 0;
                    p_temp[playerid][death_timer] = 0;
                    p_temp[playerid][death_anim] = 0;

                    Fix_TogglePlayerControllable(playerid, 1);
                    ClearAnimations(playerid);
                    SendAccess(playerid, "Вы реанимировали себя.");
                }
            }
            return 1;
        }
        case D_GIVE_ITEM_MENU:
        {
            if(!response) return UpdatePlayerList(playerid);

            new list_id = p_temp[playerid][p_listitem_int];
            if(!(0 <= list_id < 25)) return SendError(playerid, "Неизвестная ошибка: BUG-i002! Попробуйте еще раз.");
            new item_mysql_id = p_temp[playerid][p_listitem][list_id];
            if(item_mysql_id <= INVALID_MYSQL_ID) return SendError(playerid, "Неизвестная ошибка: BUG-i001! Попробуйте еще раз.");
            switch(listitem)
            {
                case 0:
                { //GIVE
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `player_items` WHERE `id` = %d LIMIT 1", item_mysql_id);
                    mysql_tquery(con_bd, STRING_GLOBAL, "PlayerItemCallback", "iii", playerid, p_info[playerid][ID], TYPE_PLAYER_ITEM_GIVE);
                }
                case 1:
                { // SELL 
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `player_items` WHERE `id` = %d LIMIT 1", item_mysql_id);
                    mysql_tquery(con_bd, STRING_GLOBAL, "PlayerItemCallback", "iii", playerid, p_info[playerid][ID], TYPE_PLAYER_ITEM_CONFIRM_SELL);
                }
                case 2:
                { // DELETE
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `player_items` WHERE `id` = %d LIMIT 1", item_mysql_id);
                    mysql_tquery(con_bd, STRING_GLOBAL, "PlayerItemCallback", "iii", playerid, p_info[playerid][ID], TYPE_PLAYER_ITEM_DELETE);
                }
            }
            return 1;
        }
        case D_GIVE_ITEM_SELL:
        {
            new item_mysql_id = GetPVarInt(playerid, #MYSQL_ITEM_ID);
            DeletePVar(playerid, #MYSQL_ITEM_ID);
            if(!response) return ShowPlayerDialog(playerid, D_GIVE_ITEM_MENU, DIALOG_STYLE_LIST, ""I"Действие", ""I"[1]"W" Забрать\n"I"[2]"W" Продать\n"I"[3]"W" Удалить", "Далее", "Отмена");
            if(item_mysql_id == INVALID_MYSQL_ID) return SendError(playerid, "Произошла неизвестная ошибка - 0602 #8");
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `player_items` WHERE `id` = %d LIMIT 1", item_mysql_id);
            mysql_tquery(con_bd, STRING_GLOBAL, "PlayerItemCallback", "iii", playerid, p_info[playerid][ID], TYPE_PLAYER_ITEM_SELL);
            return 1;
        }
        case D_MAYOR_TRANSFER_MONEY:
        {
            if(!response) return 1;
            new idx, price, fraction = p_info[playerid][member];
            if(sscanf(inputtext, "p<,>ii", idx, price)) return ShowMayorTransferMoney(playerid), SendError(playerid, "Вы ничего не ввели.");
            if(idx < 1 || idx > MAX_FRACTIONS - 1) return ShowMayorTransferMoney(playerid), SendError(playerid, "Введите ID фракции от 1 до %d.", MAX_FRACTIONS - 1);
            if(price < 1) return ShowMayorTransferMoney(playerid), SendError(playerid, "Вы не можете перевести менее 1$.");
            if(price > limit_mayor_transfer_money) return ShowMayorTransferMoney(playerid), SendError(playerid, "Вы не можете перевести более %d$.", limit_mayor_transfer_money);
            if(GetFractionWarehouse(fraction, fwMoney) < price) return ShowMayorTransferMoney(playerid), SendError(playerid, "Вы не можете перевести более %d$.", GetFractionWarehouse(fraction, fwMoney));
            if(FractionsData[idx][fType] != FACTION_TYPE_GOS && FractionsData[idx][fType] != FACTION_TYPE_SNN) return ShowMayorTransferMoney(playerid), SendError(playerid, "Вы не можете перевести денежные средства на склад нелегальной организации.");

            limit_mayor_transfer_money -= price;

            SetFractionWarehouse(fraction, fwMoney, -price);
            SendAccess(playerid, "Вы перевели %d$ на склад \"%s\".", price, GetFractionName(idx));

            SetFractionWarehouse(idx, fwMoney, price);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] перевел %d$ на склад %s.", get_name(playerid), playerid, price, GetFractionName(idx));
            SendFractionMessage(fraction, 0x33CC66FF, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] перевел на Ваш склад %d$.", get_name(playerid), playerid, price);
            SendFractionMessage(idx, 0x33CC66FF, STRING_GLOBAL);

            Log(LOG_player, INFO, "%s[%d](%s %s) перевел со склада %s на склад %s %d$",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                GetFractionName(p_info[playerid][member]), GetFractionName(idx), price);

            ShowMayorTransferMoney(playerid);
            return 1;
        }
        case D_TOP:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0:
                {
                    ShowPlayerDialog(playerid, D_PLAYER_TOP, DIALOG_STYLE_LIST, ""I"ТОП: Обычный", "\
                    "I"[1]"W" Отыгранное время\n\
                    "I"[2]"W" Уровень\n\
                    "I"[3]"W" Деньги\n\
                    "I"[4]"W" Донат\n\
                    "I"[5]"W" Bitcoin", "Далее", "Отмена");
                }
                case 1:
                {
                    ShowPlayerDialog(playerid, D_FRACTION_TOP, DIALOG_STYLE_LIST, ""I"ТОП: Фракционный", "\
                    "I"[1]"W" Правительство\n\
                    "I"[2]"W" Полиция и ФБР\n\
                    "I"[3]"W" Армия\n\
                    "I"[4]"W" Больница\n\
                    "I"[5]"W" Радиоцентр\n\
                    "I"[6]"W" Банды\n\
                    "I"[7]"W" Мафии\n\
                    "I"[8]"W" Автошкола\n\
                    "I"[9]"W" Байкеры", "Далее", "Отмена");
                }
            }
            return 1;
        }
        case D_PLAYER_TOP:
        {
            if(!response)
            {
                ShowPlayerDialog(playerid, D_TOP, DIALOG_STYLE_LIST, ""I"ТОП", "\
