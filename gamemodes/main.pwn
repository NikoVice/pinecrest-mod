    ShowPlayerDialog(playerid, D_OBJECTS_ADD_SELECT, DIALOG_STYLE_MSGBOX, ""I"��������", STRING_GLOBAL ,"��������", "�������");
    SetPVarInt(playerid, "SelectedObject", objectid);
    SetPVarInt(playerid, "modelid", modelid);
    return 1;
