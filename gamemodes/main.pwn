CMD:zlock(playerid, params[])
{
    if(p_info[playerid][member] != PRISON) return SendError(playerid, "Вы не работаете в тюрьме.");
    if(p_info[playerid][rang] != 6 && p_info[playerid][rang] != 8 && p_info[playerid][rang] != 9 && p_info[playerid][rang] != 10) return SendError(playerid, "Состояние камер можно просматривать дежурным, инспекторам, зам. и нач. тюрьмы.");
    new count = 0;
    for(new i; i < sizeof(PrisonDoor); i++)
    {
        if(!IsPlayerInRangeOfPoint(playerid, 2.0, PrisonDoorCoords[i][0], PrisonDoorCoords[i][1], PrisonDoorCoords[i][2])) continue;
        if(PrisonDoor[i] != INVALID_OBJECT_ID)
        {
            DestroyDynamicObject(PrisonDoor[i]);
            PrisonDoor[i] = INVALID_OBJECT_ID;
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s %s [%d] открыл дверь в камере [ID %d].", GetPlayerFractionRangName(playerid), get_name(playerid), playerid, i+1);
            SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
            count++;
            if(p_info[playerid][p_settings][ROLEPLAY] == 1)
            {
                DoAction(playerid, "Камера закрыта.");
                DoAction(playerid, "Ключ от камеры лежит в кармане.");
                MeAction(playerid, "движением правой руки вытащил из кармана ключ от камеры...");
                MeAction(playerid, "...после чего протянул правую руку к замку, а затем повернул ключ...");
                MeAction(playerid, "...на 360 градусов тем самым открыв камеру");
            }
            break;
        }
        else
        {
            PrisonDoor[i] = CreateDynamicObject(19303, PrisonDoorCoords[i][0], PrisonDoorCoords[i][1], PrisonDoorCoords[i][2], 0.0, 0.0, PrisonDoorCoords[i][3], 1, 1);
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s %s [%d] закрыл дверь в камере [ID %d].", GetPlayerFractionRangName(playerid), get_name(playerid), playerid, i+1);
            SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
            count++;
            if(p_info[playerid][p_settings][ROLEPLAY] == 1)
            {
                DoAction(playerid, "Камера открыта.");
                DoAction(playerid, "Ключ от камеры лежит в кармане.");
                MeAction(playerid, "движением правой руки вытащил из кармана ключ от камеры...");
                MeAction(playerid, "...после чего протянул правую руку к замку, а затем повернул ключ...");
                MeAction(playerid, "...на 360 градусов тем самым закрыв камеру");
            }
            break;
        }
    }
    if(count == 0) return SendError(playerid, "Вы должны быть рядом с дверью камеры.");
    return 1;
}

