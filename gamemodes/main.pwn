{
    if(p_info[playerid][admin]) return 0;
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
        �� ���� ��������� �� ������� �� ���������� � ���������.\n\n\
        ��������� ����������: "I"%s."W"\n\
        ����: "I"%d."W"\n\n\
        �������: "I"%s."W"\n\n\
        ���� ������������ ���������, ������� �������� ��� � ���. ������: "I""FORUM_URL"", GetFullDate(), GetPlayerPing(playerid), ac_name);
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"VAC - �������", STRING_GLOBAL, "�������", "");
	return 1;
}
