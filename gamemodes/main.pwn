BusGoNext(playerid)
{
    new i = p_temp[playerid][pPressed], type = GetPVarInt(playerid, "TypeBus");
    switch(type)
    {
        case 1: SetPlayerRaceCheckpoint(playerid,0,BusCityLS[i][0],BusCityLS[i][1],BusCityLS[i][2],BusCityLS[i][3],BusCityLS[i][4],BusCityLS[i][5],7.0);
        case 2: SetPlayerRaceCheckpoint(playerid,0,BusCitySF[i][0],BusCitySF[i][1],BusCitySF[i][2],BusCitySF[i][3],BusCitySF[i][4],BusCitySF[i][5],7.0);
        case 3: SetPlayerRaceCheckpoint(playerid,0,BusCityLV[i][0],BusCityLV[i][1],BusCityLV[i][2],BusCityLV[i][3],BusCityLV[i][4],BusCityLV[i][5],7.0);
        case 4: SetPlayerRaceCheckpoint(playerid,0,BusSchool[i][0],BusSchool[i][1],BusSchool[i][2],BusSchool[i][3],BusSchool[i][4],BusSchool[i][5],7.0);
        case 5: SetPlayerRaceCheckpoint(playerid,0,BusLSLV[i][0],BusLSLV[i][1],BusLSLV[i][2],BusLSLV[i][3],BusLSLV[i][4],BusLSLV[i][5],5.0);
    }
}

PilotGoNext(playerid)
{
    new i = p_temp[playerid][pPressed], idx = GetPVarInt(playerid, "TypePilot") - 1;
    SetPlayerRaceCheckpoint(playerid, 1, PilotRoute[idx][i][0], PilotRoute[idx][i][1], PilotRoute[idx][i][2], PilotRoute[idx][i][3], PilotRoute[idx][i][4], PilotRoute[idx][i][5], 15.0);
    return 1;
}

ShowPlayer_Admin_Report_List(playerid)
{
    STRING_GLOBAL[0] = EOS;
    for(new i; i < MAX_ADMIN_REPORTS; i++)
    {
        if(aReportInfo[i][rPlayerID] == INVALID_PLAYER_ID) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s "I"[%d]"W" -\t \n", STRING_GLOBAL, i+1);
        else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s "I"[%d]"W" %s\t[%s]\n", STRING_GLOBAL, i+1, get_name(aReportInfo[i][rPlayerID]), aReportInfo[i][rIsTooked] == false ? "{33CC66}Доступный"W"" : "{FF0000}Занят"W"");
    }
    ShowPlayerDialog(playerid, D_REPORT_LIST, DIALOG_STYLE_TABLIST, ""I"Обращения к администрации", STRING_GLOBAL, "Далее", "Отмена");
    return 1;
}

AddMafiaBank(bizz_id, sum)
{
    switch(b_info[bizz_id][b_mafia])
    {
        case MAFIA_RM: gBankMafia[0][bizz_id] += sum;
        case MAFIA_LCN: gBankMafia[1][bizz_id] += sum;
        case MAFIA_YAKUDZA: gBankMafia[2][bizz_id] += sum;
        case BIKER: gBankMafia[3][bizz_id] += sum;
        case MAFIA_IRAN: gBankMafia[4][bizz_id] += sum;
        case NONE_FRACTION: return 1;
    }
    save_bizz(bizz_id);
    return 1;
}

public OnPlayerEditObject(playerid, playerobject, objectid, response, Float:fX, Float:fY, Float:fZ, Float:fRotX, Float:fRotY, Float:fRotZ)
{
    if(response == EDIT_RESPONSE_FINAL)
    {// player clicked on savе
        /*
        if(p_temp[playerid][tl_id] != -1)
        {
            new idx = p_temp[playerid][tl_id];
            GetPlayerFacingAngle(playerid, fRotZ);

            TL_Data[idx][tl_object_pos][0] = fX;
            TL_Data[idx][tl_object_pos][1] = fY;
            TL_Data[idx][tl_object_pos][2] = fZ;

            new Float:rz = fRotZ;
            if(rz >= 315.0 && rz <= 360.0 || rz >= 0.0 && rz <= 45.0) fRotZ = 360.0; //0/360
            if(rz > 45.0 && rz < 135.0) fRotZ = 90.0;
            if(rz >= 135.0 && rz <= 225.0) fRotZ = 180.0;
            if(rz > 225.0 && rz < 315.0) fRotZ = 270.0;

            CreateTrafficLight(fX, fY, fZ, fRotZ);
            TL_Data[idx][tl_object_pos][3] = fRotZ;

            // 180 x+ ||  270 x-
            //if(z_angle-90 < 0) z_angle = (360+z_angle)-90;
            TL_Data[idx][tl_area_pos][0] = fX;
            TL_Data[idx][tl_area_pos][1] = fY;
            if(fRotZ == 180.0) TL_Data[idx][tl_area_pos][0] += 5.0;
            if(fRotZ == 360.0) TL_Data[idx][tl_area_pos][0] -= 5.0;
            if(fRotZ == 90.0) TL_Data[idx][tl_area_pos][1] -= 5.0;
            if(fRotZ == 270.0) TL_Data[idx][tl_area_pos][1] += 5.0;

            totaltl++;
            DestroyObject(objectid);
        }
        */
        if(GetPVarInt(playerid, "addrad") == 1)
        {
            RadarInfo[TOTALRADAR][rX] = fX;
            RadarInfo[TOTALRADAR][rY] = fY;
            RadarInfo[TOTALRADAR][rZ] = fZ;
            RadarInfo[TOTALRADAR][rRZ] = fRotZ;

            RadarInfo[TOTALRADAR][rSpeed] = GetPVarInt(playerid, "speed");

            RadarInfo[TOTALRADAR][rID] = TOTALRADAR+1;
            RadarInfo[TOTALRADAR][rRadius] = GetPVarInt(playerid, "radius");

            RadarInfo[TOTALRADAR][rArea] = CreateDynamicSphere(fX,fY,fZ, 20.0, 0, 0, -1);
            UpdateAreaInfo(RadarInfo[TOTALRADAR][rArea], TYPE_RADAR, AREA_SUBTYPE_INVALID_ID, TOTALRADAR);

            RadarInfo[TOTALRADAR][rMapIcon] = CreateDynamicMapIcon(fX,fY,fZ, 34, -1, 0, -1, -1, 100.0);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `radars` (`rX`, `rY`, `rZ`, `rRZ`, `rSpeed`, `rRadius`) VALUES ('%f', '%f', '%f', '%f', %d, %d)",
                fX, fY, fZ, fRotZ, RadarInfo[TOTALRADAR][rSpeed], RadarInfo[TOTALRADAR][rRadius]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "Радар №%d\nОграничение скорости: %d KM/H", RadarInfo[TOTALRADAR][rID], RadarInfo[TOTALRADAR][rSpeed]);
            RadarInfo[TOTALRADAR][r3DText] = CreateDynamic3DTextLabel(STRING_GLOBAL, COLOR_MAIN, RadarInfo[TOTALRADAR][rX], RadarInfo[TOTALRADAR][rY], RadarInfo[TOTALRADAR][rZ], 20.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, streamer_TESTLOL, -1, -1, -1);

            DeletePVar(playerid, "addrad");
            DeletePVar(playerid, "speed");
            DeletePVar(playerid, "radius");
        }
    }
    else if(response == EDIT_RESPONSE_CANCEL){// player cancelled (ESC)
        //if(p_temp[playerid][tl_id] != -1) p_temp[playerid][tl_id] = -1;
        DestroyObject(objectid);
        if(GetPVarInt(playerid, "addrad") > 0) {
            TOTALRADAR--;
            DeletePVar(playerid, "addrad");
            DeletePVar(playerid, "speed");
            DeletePVar(playerid, "radius");
        }
    }
    else if(response == EDIT_RESPONSE_UPDATE){// player moved the object (edition did not stop at all)
        SetObjectPos(objectid, fX, fY, fZ);
        SetObjectRot(objectid, fRotX, fRotY, fRotZ);
    }
    return 1;
}

static const cmd_white_list[][] =
{
    "report", "time", "me", "todo", "do", "b", "n",
    "fb", "f", "r", "rb", "d", "db",
    "p", "h", "sms", "cctv", "interface"
};
///////////////////////////////////////////////
public OnPlayerCommandText(playerid, cmdtext[]) return 0;
//////////////////////////
public OnPlayerCommandReceived(playerid, cmd[], params[], flags)
{
    //printf("%s OnPlayerCommandReceived(playerid = %i, cmd = %s, params = %s | timestamp %d  | Flood %d", get_name(playerid), playerid, cmd, params, timestamp, GetPVarInt(playerid, "Flood:CMD"));
    //Log(LOG_sscanf, INFO, "%s playerid = %i, cmd = %s, params = %s", get_name(playerid), playerid, cmd, params);

    if(p_info[playerid][loggedIn] != 1) return SendError(playerid, "Вы не авторизованы.") & 0;
    if(p_temp[playerid][TextDrawCaptcha] != 0) return SendError(playerid, "Введите капчу или нажмите отмена.") & 0;
    if(p_temp[playerid][AntiFloodCMD] > timestamp) return SendError(playerid, "Вы не можете так часто использовать команды.") & 0;
    p_temp[playerid][AntiFloodCMD] = timestamp+1;
    if(p_temp[playerid][MDC_BODYCAM] != INVALID_PLAYER_ID) return 0;

    if(GetPVarInt(playerid, "advert_id_to_sending"))
        return SendError(playerid, "У Вас открыто объявление, закройте, отправьте или отклоните его.") & 0;

    new text_cmd = 0;
    if(p_info[playerid][exchangePartner] != INVALID_PLAYER_ID)
    {
        for(new i; i < sizeof(cmd_white_list); i++)
            if(strequals(cmd, cmd_white_list[i])) text_cmd++;
        if(text_cmd) return SendError(playerid, "У Вас неоконченный обмен. Закончите его.") & 0;
        if(!strequals(cmd, "ready") &&
        !strequals(cmd, "stopex") &&
        !strequals(cmd, "bet") &&
        !strequals(cmd, "apanel") &&
        !strequals(cmd, "unbet")) return SendError(playerid, "У Вас неоконченный обмен. Закончите его.") & 0;
    }

    if(GetPVarInt(playerid,"Conv") == 1 || GetPVarInt(playerid, "PlayerCuffed") == 1)
    {
        for(new i; i < sizeof(cmd_white_list); i++)
            if(strequals(cmd, cmd_white_list[i])) text_cmd++;
        if(!text_cmd) return SendError(playerid, "Вы под конвоем.") & 0;
    }

    if((p_info[playerid][pfreeze] == 0 || p_temp[playerid][death_status] == 1) && p_info[playerid][admin] < 1)
    {
        for(new i; i < sizeof(cmd_white_list); i++)
            if(strequals(cmd, cmd_white_list[i])) text_cmd++;
        if(!text_cmd) return SendError(playerid, "Вы заморожены, данное действие невозможно.") & 0;
    }
    if(p_temp[playerid][DuelID] != INVALID_PLAYER_ID)
    {
        if(strequals(cmd, "mask") || strequals(cmd, "go") || strequals(cmd, "gomp"))
            return SendError(playerid, "Вы на дуэли, данное действие невозможно.") & 0;
    }
    if( strfind(params, "`",true) !=-1 ||
        strfind(params, "accounts",true) !=-1 ||
        strfind(params, "delete",true) !=-1 ||
        strfind(params, "update",true) !=-1 ||
        (strfind(params, "{",true) !=-1  && strfind(params, "}",true) !=-1))
        return SendError(playerid, "Вы используете запрещенные символы.") & 0;

    if(admin_acces[playerid] == false && p_info[playerid][admin] > 0) return callcmd::alogin(playerid, "/0") & 0;
    if(CheckBinderCommand(playerid, cmd)) return 0;
    return 1; //
}
public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
    return 1;
}

alias:escape("usekey");
CMD:escape(playerid, params[])
{
    if(p_info[playerid][jail] == 0) return SendError(playerid, "Вы не находитесь в тюрьме.");
    if(p_info[playerid][jail] == 6) return SendError(playerid, "Вы не можете использовать отмычки в деморгане.");
    if(p_info[playerid][jail_time] < 60) return SendError(playerid, "Вам осталось меньше минуты в тюрьме.");
    if(p_temp[playerid][prison_escape] != 0 || p_temp[playerid][prison_escape_time] != 0) return SendError(playerid, "Вы уже взламываете двери камеры.");
    if(p_info[playerid][escape_limit] > 0) return SendError(playerid, "Вы не можете совершить побег еще в течении %d час(-а/-ов).", p_info[playerid][escape_limit]);
    if(!GivePlayerInventory(playerid, 637, -1)) return SendError(playerid, "У Вас нет отмычек.");
    p_temp[playerid][prison_escape] = 1;
    p_info[playerid][escape_limit] = 3;

    p_temp[playerid][mini_games_type] = 1;
    ShowTextDrawForPlayer(playerid, TD_ID_MINI_GAMES);

    SendInfoMessage(playerid, "Вы начали побег из тюрьмы, Вам необходимо пройти мини игру.");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] пытается совершить побег из тюрьмы.", get_name(playerid), playerid);
    SendFractionMessage(POLICE_LS, 0x33CC66FF, STRING_GLOBAL);
    SendFractionMessage(POLICE_SF, 0x33CC66FF, STRING_GLOBAL);
    SendFractionMessage(POLICE_LV, 0x33CC66FF, STRING_GLOBAL);
    SendFractionMessage(PRISON, 0x33CC66FF, STRING_GLOBAL);
    SendFractionMessage(FBI_TEAM, 0x33CC66FF, STRING_GLOBAL);
    SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);
    return 1;
}

CMD:fban(playerid, params[])
{
    if(p_info[playerid][youtube_adm] < 2 && p_info[playerid][youtube_adm] < 3)
        return 1;

    new target, days, reason[144];
    if(sscanf(params, "uis[144]", target, days, reason)) return SendInfo(playerid, "Используйте: /fban [id игрока] [кол-во дней] [причина]");

    if(target == INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок не найден.");

    if(!(1 <= days <= 30))
        return SendError(playerid, "Кол-во дней блокировки должно быть не менее 1 и не более 30.");

    if(p_info[target][admin] >= p_info[playerid][admin] || FD(target))
        return SendError(playerid, "У Вас слишком маленький уровень администратора.");

    if(AdvertisingCheck(reason)) return AdvertisingPunishment(playerid, reason, 0);
    if(IsAAdminAttack(playerid, 7)) return 1;

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Администратор %s [%d] заблокировал %s [%d] на %d %s. Причина: %s", get_name(playerid), playerid, get_name(target), target, days, Declension_ReturnWord(days, "день", "дня", "дней"), reason);
    SendAdminMessageForServer(COLOR_LIGHTRED, STRING_GLOBAL);

    new
        year,
        month,
        day;

    getdate(year, month, day);


    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Внимание! Вас только что {"#cLIGHTRED"}забанили.\n\
        "W"Вас забанил(а): {"#cLIGHTRED"}%s\n\
        "W"Время: {"#cLIGHTRED"}%02d:%02d:%02d\n\
        "W"Дата: {"#cLIGHTRED"}%d.%d.%d\n\
        "W"Причина: {"#cLIGHTRED"}%s\n\
        "W"Разбан через: {"#cLIGHTRED"}%d дней\n\n\
        Форум поддержки: {"#cLIGHTRED"}"FORUM_URL"\n"W"Форум > Жалобы > {"#cLIGHTRED"}Жалобы на администрацию",
        get_name(playerid),
        timestamp_hour, timestamp_minute, timestamp_second,
        year, month, day,
        reason,
        days);

    ShowPlayerDialog(target,D_NULL,DIALOG_STYLE_MSGBOX, ""I"Информация", STRING_GLOBAL,"Закрыть","");
    Kick(target);
    return 1;
}

CMD:yhelp(playerid, params[])
{
    if(p_info[playerid][admin] < 1 && p_info[playerid][youtube_adm] < 1)
        return 1;

    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"YouTube-Admin Helper:",
        ""I"YouTube [1 LVL]:"W"\n\
        /tp - Телепортация по метке.\n\
        /hp - Пополнить ХП себе.\n\
        /gm - Бессмертие.\n\
        /flip - Перевернуть автомобиль.\n\
        /jetpack - Выдать себе Джетпак.\n\
        /int - Телепортация в любой интерьер.\n\
        \n\
        "I"YouTube [2 LVL]:"W"\n\
        /unfreeze(r) - Разморозить игрока(в радиусе).\n\
        /slap - Слапнуть игрока.\n\
        /fixveh(r) - Починить автомобиль себе(в радиусе).\n\
        /goto(/g) - Телепортироватся к игроку.\n\
        \n\
        "I"YouTube [3 LVL]:"W"\n\
        /unfreeze(r) - Разморозить игрока(в радиусе).\n\
        /givegun(r) - Выдать оружие (в радиусе).\n\
        /statmp(/stopmp) - Начать(закончить), мероприятие.\n\
        /setskin - Выдать временный скин игроку.\n\
        /veh(/delveh) - создать/удалить, временный транспорт.\n\
        /fban - Выдать фейковый бан игроку.\n\
        /gethere(/gh) - Телепортировать игрока к себе.\n\
        /ptp - Телепортировать игрока к игроку.\n\
        /getstats - Посмотреть статистику игрока.\n\
        /cmd- Писать от имени другого игрока.\n\n\
        "I"ИСПОЛЬЗОВАНИЕ 'ПРОСТО ТАК' ИЛИ В ЛИЧНЫХ ЦЕЛЯX - УДАЛЕНИЕ АККАУНТА.\n\
        ИСПОЛЬЗУЙТЕ ТОЛЬКО ВО ВРЕМЯ СНЯТИЕ РОЛИКОВ !!!\n\
        ПОМНИТЕ, ЮТУБЕР - RP ПЕРСОНАЖ В ПЕРВУЮ ОЧЕРЕДЬ!!!", "Понял", "");
    return 1;
}


CMD:cmd(playerid, params[])
{
    if(p_info[playerid][admin] < 5 && p_info[playerid][youtube_adm] < 3)
        return 1;
    if(sscanf(params, "us[144]", params[0], params[1])) return SendInfo(playerid, "Используйте: /cmd ID text");
    if(params[0] == INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок не в сети.");
    if(params[0] == playerid) return 1;
    if(!IsPlayerStream(6.0, playerid, params[0]))
        return SendError(playerid, "Игрок слишком далеко.");
    if(strlen(params[1]) < 1 || strlen(params[1]) > 100)
        return SendError(playerid, "Длина текста не меньше 1 и не больше 100 символов.");
    if(AdvertisingCheck(params[1]))
        return AdvertisingPunishment(playerid, params[1], 0);

    OnPlayerText(params[0], params[1]);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] Ютубер %s [%d] написал от имени %s [%d].", get_name(playerid), playerid, get_name(params[0]), params[0]);
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] Текст: %s.", params[1]);
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);
    return 1;
}

CMD:notify(playerid, params[])
{
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `player_notification` WHERE `user_id` = %d LIMIT 7", p_info[playerid][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL, "GetNotify", "i", playerid);
    return 1;
}

CMD:license(playerid, params[])
{
    if(sscanf(params, "u", params[0]))
    {
        params[0] = playerid;
        SendInfo(playerid, "Используйте: /license [id игрока]");
    }
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не найден.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");

    if(GetPVarType(params[0],"BoneStol_ID") == PLAYER_VARTYPE_INT)
        return 1;

    if(params[0] == playerid)
    {
        ShowLicense(playerid, playerid);
        MeAction(playerid, "достал(-а) лицензии и рассматривает их");
    }
    else
    {
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL, ""W"Вы хотите предложить "I"%s "W"посмотреть Ваши лицензии.", get_name(params[0]));
        ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"Лицензии", STRING_GLOBAL, "Далее", "Отмена");
        SetOfferData(playerid, params[0], OFFER_ID_SHOW_LICENSE);
    }
    return 1;
}
alias:license("lic");

alias:lights("light", "l");
CMD:lights(playerid, params[])
{
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
    new vehicleid = GetPlayerVehicleID(playerid);
    veh_info[vehicleid][v_light] ^= 1;
    new string[48];
    if(veh_info[vehicleid][v_light] == 0)
    {
        format(string, sizeof(string),"%s выключил(а) фары", get_name(playerid));
        distance_chat(playerid,10.0,0xDE92FFFF,string);
    }
    else
    {
        format(string, sizeof(string),"%s включил(а) фары", get_name(playerid));
        distance_chat(playerid,10.0,0xDE92FFFF,string);
    }
    SetVehicleParamsVEx(vehicleid, veh_info[vehicleid][v_engine], veh_info[vehicleid][v_light], alarm, veh_info[vehicleid][v_lock], bonnet, boot, objective);
    OnPlayerUpdateVehicleInfo(playerid, SPEEDO_LIGHT);
    return 1;
}

CMD:dutydm(playerid, params[])
{
    if(p_info[playerid][admin] < 1) return 1;
    p_temp[playerid][avto_dm_check] = !p_temp[playerid][avto_dm_check];
    SendAccess(playerid, "Вы %s авто репорт DM.", p_temp[playerid][avto_dm_check] ? "включили":"выключили");
    return 1;
}

CMD:akl(playerid, params[])
{
    if(p_info[playerid][admin] < 1) return 1;
    p_temp[playerid][show_killlist] = !p_temp[playerid][show_killlist];
    SendAccess(playerid, "Вы  %s показ KillList.", p_temp[playerid][show_killlist] ? "включили":"выключили");
    return 1;
}

CMD:vksend(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10) return 1;
    SendVK(params);
    SendInfo(playerid, "[SMS]: %s", params);
    return 1;
}

CMD:todo(playerid, params[])
{
    if(strlen(params) > 95) return SendError(playerid, "Вы ввели слишком длинный текст.");
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "У Вас кляп.");
    if(p_info[playerid][mute] > 0) return SendError(playerid, "У Вас блокировка чата.");
    if(GetPVarInt(playerid,"BoneStol_ID")) return 1;
    new message[144], action[144];
    if(sscanf(params, "p<*>s[144]s[144]", message, action)) return SendInfo(playerid, "Используйте: /todo [текст*действие]");
    if(strlen(message) < 2 || strlen(action) < 2) return SendInfo(playerid, "Используйте: /todo [текст*действие]");
    if(AdvertisingCheck(message)) return AdvertisingPunishment(playerid, message, 1);
    if(AdvertisingCheck(action)) return AdvertisingPunishment(playerid, action, 1);
    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "- '%s' - {DE92FF}сказал(-а) %s, %s", message, get_name(playerid), action);
    SendStreamMessage(10.0, playerid, STRING_GLOBAL, COLOR_WHITE);
    return 1;
}

CMD:statsradio(playerid, params[])
{
    new n_count[4];
    foreach(new i: Player)
    {
        if(!p_info[i][loggedIn]) continue;
        if(p_info[i][news] == RADIO_LS) n_count[0]++;
        if(p_info[i][news] == RADIO_SF) n_count[1]++;
        if(p_info[i][news] == RADIO_LV) n_count[2]++;
        if(p_info[i][news] == 0) n_count[3]++;
    }
    SendInfo(playerid, "Радиоцентр \"Los Santos\": %d | Радиоцентр \"San Fierro\": %d | Радиоцентр \"Las Venturas\": %d | Выключено: %d.", n_count[0], n_count[1], n_count[2], n_count[3]);
    return 1;
}

CMD:changevehnum(playerid, params[])
{
    new vehicleid = GetPlayerOwnerNearestVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "Вы слишком далеко от своего транспортного средства.");
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "Используйте: /changevehnum [id игрока] [кол-во денежных средств]");
    if(params[0] == INVALID_PLAYER_ID || params[0] == playerid)
        return SendError(playerid, "Игрок не найден.");
    new target_vehicle = GetPlayerOwnerNearestVehicleID(params[0]);
    if(target_vehicle == INVALID_VEHICLE_ID) return SendError(playerid, "Около игрока нет рядом транспортного средства.");
    if(params[1] < 1 || params[1] > 10_000_000)
        return SendError(playerid, "Стоимость должна быть не менее 1$ и не более 10 000 000$.");
    if(strequals(veh_info[vehicleid][v_number], "NULL"))
        return SendError(playerid, "У Вас нет номеров на данном транспортном средстве.");
    if(params[0] == INVALID_PLAYER_ID || !IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
    if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");
    if(strequals(veh_info[target_vehicle][v_number], "NULL"))
        return SendError(playerid, "У игрока нет номеров транспортном средстве.");
    //GetVehiclePos(target_vehicle, POS[0], POS[1], POS[2]);
    //if(!IsPlayerInRangeOfPoint(playerid, 8,  POS[0], POS[1], POS[2])) return SendError(playerid, "Транспорт на который Вам предлагают обмен, здесь нет.");
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
    "W"Вы хотите предложить "I"%s"W" обменять Ваш номер транспортного средства "I"%s"W" на "I"%s."W"\n\n\
    С доплатой Вам: "I"%d$.", get_name(params[0]), veh_info[vehicleid][v_number], veh_info[target_vehicle][v_number], params[1]);
    ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"Обмен номерами транспортного средства", STRING_GLOBAL, "Далее", "Отмена");
    SetOfferData(playerid, params[0], OFFER_ID_CHANGE_VEH_NUMBER, params[1]);

    p_temp[playerid][p_listitem][40] = vehicleid;
    p_temp[playerid][p_listitem][41] = target_vehicle;
    return 1;
}

CMD:sellvehnum(playerid, params[])
{
    new vehicleid = GetPlayerOwnerNearestVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID)
        return SendError(playerid, "Около Вас нет рядом транспортного средства.");
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "Используйте: /sellvehnum [id игрока] [стоимость]");
    if(params[0] == INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок не найден.");
    if(params[0] == playerid)
        return SendError(playerid, "Вы ввели свой ID.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(params[1] < 1 || params[1] > 10_000_000)
        return SendError(playerid, "Стоимость должна быть не менее 1$ и не более 10000000$.");
    if(strequals(veh_info[vehicleid][v_number], "NULL"))
        return SendError(playerid, "У Вас нет номеров на данном транспортном средстве.");

    SendAccess(playerid, "Вы предложили %s [%d] купить номер Т/С %s за %d$.", get_name(params[0]), params[0], veh_info[vehicleid][v_number], params[1]);
    SendInfo(params[0], "%s [%d] предложил Вам купить номер Т/С %s за %d$.", get_name(playerid), playerid, veh_info[vehicleid][v_number], params[1]);

    SetFreeSlotOffer(params[0], playerid, OFFER_ID_SELL_VEH_NUMBER, params[1]);

    p_temp[playerid][p_listitem][40] = vehicleid;
    return 1;
}

CMD:carpass(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Вы должны находиться в транспортном средстве.");
    if(sscanf(params, "u", params[0]))
    {
        params[0] = playerid;
        SendInfo(playerid, "Используйте: /carpass [id игрока]");
    }
    if(playerid != params[0] && (!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID)) return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не найден.");
    if(params[0] == playerid) ShowCarPass(playerid, playerid);
    else
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
        "W"Вы хотите предложить показать тех. паспорт "I"%s", get_name(params[0]));
        ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"Тех. паспорт", STRING_GLOBAL, "Далее", "Отмена");
        SetOfferData(playerid, params[0], OFFER_ID_CAR_PASS);
    }
    return 1;
}

ShowCarPass(playerid, targetid)
{
    if(!IsPlayerInAnyVehicle(targetid)) return SendError(targetid, "Вы должны находиться в транспортном средстве.");
    new vehicleid = GetPlayerVehicleID(targetid);
    if(vehicleid == 0) return SendError(playerid, "Вы должны находиться в транспортном средстве.");
    STRING_GLOBAL[0] = EOS;
    strcat(STRING_GLOBAL, ""W"Технический паспорт:\n\n");
    f(STRING_GLOBAL, "%sМодель: %s\n", STRING_GLOBAL, GetVehicleName(vehicleid));

    if(veh_info[vehicleid][v_npoType] == NPO_PLAYERCAR && veh_info[vehicleid][v_owner_id] != INVALID_MYSQL_ID)
    {
        new onwer_veh_id = INVALID_PLAYER_ID;
        if(veh_info[vehicleid][v_owner_id] == p_info[playerid][ID]) onwer_veh_id = playerid;
        else {
            foreach(new i: Player)
            {
                if(!p_info[i][loggedIn]) continue;
                if(IsPlayerOwnerVehicle(i, vehicleid))
                {
                    onwer_veh_id = i;
                    break;
                }
            }
        }
        if(onwer_veh_id != INVALID_PLAYER_ID) f(STRING_GLOBAL, "%sВладелец: %s\n", STRING_GLOBAL, get_name(onwer_veh_id));

        if(strequals(veh_info[vehicleid][v_number], "NULL")) strcat(STRING_GLOBAL, "Номерной знак: {"#cLIGHTRED"}Нет"W"\n");
        else f(STRING_GLOBAL, "%sНомерной знак: {"#cGREEN"}%s"W"\n", STRING_GLOBAL, veh_info[vehicleid][v_number]);

        new insurance_info[64];
        if(veh_info[vehicleid][v_insurance] == 0) insurance_info = "{"#cLIGHTRED"}Нет"W"";
        else format(insurance_info, sizeof(insurance_info), "{"#cGREEN"}Есть"W" [%d час(-а/-ов)]", veh_info[vehicleid][v_insurance_time]);

        f(STRING_GLOBAL, "%sСтраховка: %s", STRING_GLOBAL, insurance_info);
    }
    else
    {
        if(veh_info[vehicleid][v_npoType] == NPO_FACTION)
        {
            if(veh_info[vehicleid][v_npoId] >= MAX_FRACTIONS) printf("CRASHED: %d, %s %s", veh_info[vehicleid][v_npoId], GetPlayerFractionRangName(targetid), GetFractionName(p_info[targetid][member]));
            else f(STRING_GLOBAL, "%sВладелец: %s", STRING_GLOBAL, GetFractionName(veh_info[vehicleid][v_npoId]));
        }
        if(veh_info[vehicleid][v_npoType] == NPO_JOB && veh_info[vehicleid][v_npoId] != JOB_TC_TRUCK && veh_info[vehicleid][v_npoId] != JOB_TC_TAXI) strcat(STRING_GLOBAL, "Владелец: Гос-во\n");
        if(veh_info[vehicleid][v_npoType] == NPO_JOB && (veh_info[vehicleid][v_npoId] == JOB_TC_TRUCK || veh_info[vehicleid][v_npoId] == JOB_TC_TAXI))
        {
            new tcid = veh_info[vehicleid][v_tc];
            f(STRING_GLOBAL, "\
                %sВладелец: %s %s [%d]", STRING_GLOBAL, bizz_type_name[b_info[tcid][_tip]], b_info[tcid][_name], b_info[tcid][b_mysql_id]);
        }
        if(veh_info[vehicleid][v_npoType] == NPO_FAMILY && veh_info[vehicleid][v_family_id] != -1)
        {
            f(STRING_GLOBAL, "\
            %sВладелец семья: %s\n\
            Номерной знак: GOS %04d\n\
            Страховка автомобиля: {"#cGREEN"}Есть"W"", STRING_GLOBAL, FamilyData[veh_info[vehicleid][v_family_id]][fName], vehicleid);
        }
    }
    f(STRING_GLOBAL, "%s\n\n\
        Технические характеристики:\n\n\
        Подвеска: %d из 3\n\
        Трансмиссия: %d из 3\n\
        Турбонаддув: %d из 3\n\
        Двигатель: %d из 3\n\n\
        Состояние стартера: %.1f\n\
        Состояние аккумулятора: %.1f\n\
        Состояние топливной системы: %.1f\n\
        Состояние сцепления: %.1f\n\
        Состояние двигателя: %.1f\n\n\
        Макс. скорость: %d KM/H\n\
        Макс. скорость с тюнингом: %d KM/H\n\n\
        Премиум: %s", STRING_GLOBAL,
        veh_info[vehicleid][v_twinturbo_data][tt_suspension], veh_info[vehicleid][v_twinturbo_data][tt_transmission],
        veh_info[vehicleid][v_twinturbo_data][tt_turbocharging], veh_info[vehicleid][v_twinturbo_data][tt_engine],
        veh_info[vehicleid][v_details][0], veh_info[vehicleid][v_details][1], veh_info[vehicleid][v_details][2],
        veh_info[vehicleid][v_details][3], veh_info[vehicleid][v_details][4], floatround(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_SPEED)),
        GetVehicleMaxSpeed(vehicleid), (veh_info[vehicleid][v_premium] == 1) ? ("{"#cGREEN"}Есть"W"") : ("{"#cLIGHTRED"}Нет"W""));
    if(veh_info[vehicleid][v_sell_block] != 0) strcat(STRING_GLOBAL, "\n\n{"#cLIGHTRED"}Данное транспортное средство подарочное и продажа государству возможна за 0$!"W"");
    if(veh_info[vehicleid][v_bonus] != 0) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s\n\nТранспортное средство будет удалено через {"#cLIGHTRED"}%s"W".", STRING_GLOBAL, ConvertTime(veh_info[vehicleid][v_bonus]-timestamp));
    ShowPlayerDialog(targetid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Тех. паспорт", STRING_GLOBAL, "ОК", "");

    new str[144];
    str = "достал(-а) документы из бардачка";
    if(targetid != playerid) format(str, sizeof(str), "%s и показал(-а) их %s", str, get_name(targetid));
    MeAction(playerid, str);
    return 1;
}


CMD:setmbiz(playerid, params[])
{
    if(p_info[playerid][admin] < 4)
        return 1;

    new bizid, mafia_id;
    if(sscanf(params, "ii", bizid, mafia_id)) return SendInfo(playerid, "Используйте: /setmbiz [id бизнеса] [id фракции]");

    if(!(0 <= bizid < totalbizz))
        return SendError(playerid, "Неверный ID бизнеса.");
    if(b_info[bizid][b_mysql_id] == INVALID_MYSQL_ID)
        return SendError(playerid, "Неверный ID бизнеса.");
    if(!(MAFIA_RM <= mafia_id <= MAFIA_YAKUDZA) && mafia_id != BIKER && mafia_id != MAFIA_IRAN && mafia_id != 0)
        return SendError(playerid, "Неверный ID мафии.");

    if(b_info[bizid][b_mafia] == mafia_id)
        return SendError(playerid, "Данная мафия итак является крышей этого бизнеса.");

    if(b_info[bizid][b_mafia] != 0) MafiaCountBizz(b_info[bizid][b_mafia], -1);
    if(mafia_id != 0) MafiaCountBizz(mafia_id, 1);

    b_info[bizid][b_mafia] = mafia_id;
    save_bizz(bizid);
    update_bizz(bizid);

    SendAccess(playerid, "Вы изменили контроль над бизнесом.");

    Log(LOG_player, INFO, "%s[%d](%s %s) установил контроль над бизнесом %s(%d): %s | #AdminLogs",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        b_info[bizid][_name], bizid, GetFractionName(mafia_id));
    return 1;
}
CMD:paint(playerid, params[])
{
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || !IsPlayerOwnerVehicle(playerid, GetPlayerVehicleID(playerid)))
        return SendError(playerid, "Вы должны находиться за рулем своего транспортного средства.");

    if(p_info[playerid][paintball] < 1)
        return SendError(playerid, "У Вас нет баллончика с краской.");

    p_temp[playerid][paint_veh_go] = 1;
    STRING_GLOBAL[0] = EOS;
    STRING_GLOBAL = "{E5D81E}Выберите цвета через запятую:\n\nПример: "I"3, 0\n\n";

    for(new i; i < 127; i++)
    {
        if(i%20 == 0)
            strcat(STRING_GLOBAL,"\n");

        format(STRING_GLOBAL, sizeof STRING_GLOBAL, "%s{%06x} %d ", STRING_GLOBAL, VehicleColoursTableRGBA[i] >>> 8, i);
    }
    ShowPlayerDialog(playerid, D_CHANGE_VEHICLE_COLOR, DIALOG_STYLE_INPUT, ""I"Покраска транспорта", STRING_GLOBAL, "Далее", "Отмена");
    return 1;
}

CMD:vtc(playerid, params[])
{
    if(p_info[playerid][admin] < 10) return 1;
    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "Используйте: /vtc [кол-во]");
    if(!(2 <= params[0] <= 12)) return SendInfo(playerid, "Используйте: /vtc [кол-во]");
    //SetPVarInt(playerid,"BoneStol_SET", params[0]);
    UpdateBone(GetPVarInt(playerid,"BoneStol_ID")-1);
    return 1;
}

cmd:apromo(playerid, params[])
{
    if(p_info[playerid][admin] > 4)
    {
        ShowPlayerDialog(playerid, D_PROMO, DIALOG_STYLE_LIST, ""I"Меню промомокодов","\
        "I"[1]"W" Создать промокод \n\
        "I"[2]"W" Действующие промокоды \n\
        "I"[3]"W" Активированные промокоды \n\
        "I"[4]"W" Заблокированные промокоды \n\
        "I"[5]"W" Заблокировать промокод \n\
        "I"[6]"W" Удалить промокод","Далее","Выход");
    }
    return 1;
}

CMD:az(playerid, params[])
{
    if(1 <= p_info[playerid][admin] <= 10)
    {
        SetPlayerPos(playerid, 545.63,-195.34,7.8);
        SetPlayerFacingAngle(playerid, 11.6399);
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
    }
    return 1;
}

CMD:changeskin(playerid, params[])
{
    if(p_info[playerid][rang] < 9)
        return SendError(playerid, "Вы не можете пользоваться этой командой.");

    new targetid;
    if(sscanf(params, "u", targetid)) return SendInfo(playerid, "Используйте: /changeskin [id игрока]");

    if(targetid == INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок не найден.");

    if(p_info[targetid][member] != p_info[playerid][member])
        return SendError(playerid, "Игрок не состоит во фракции.");

    if(!IsPlayerStream(5.0, playerid, targetid) || pSpectateId[targetid] != INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок слишком далеко от Вас.");

    if(p_info[targetid][rang] >= p_info[playerid][rang] && targetid != playerid)
        return SendError(playerid, "У Вас слишком маленький ранг во фракции.");
    for(new i = 10; i != -1; i--) p_temp[playerid][p_listitem][i] = -1;
    p_temp[playerid][p_listitem_int] = targetid;
    ShowPlayerListTD(playerid, LIST_TD_ID_FRACTION_CHANGE_SKIN);
    return 1;
}

CMD:givegun(playerid, params[])
{
    if(p_info[playerid][admin] < 4 && p_info[playerid][youtube_adm] < 3)
        return 1;
    if(sscanf(params, "uii", params[0], params[1], params[2])) return SendInfo(playerid, "Используйте: /givegun [id игрока] [id оружия] [патроны]");
    if(params[0] == INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок не найден.");
    if(p_info[params[0]][level] < 2)
        return SendError(playerid, "У игрока нет 2-ого уровня.");
    if(SRV_ID != 0 && (params[1] >= 35 && params[1] <= 40 || params[1] >= 44 && params[1] <= 46))
        return SendError(playerid, "Вы ввели запрещенный ID оружия.");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] выдал %s [%d] оружие %d, патронов %d.", get_name(playerid), playerid, get_name(params[0]), params[0], params[1], params[2]);
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

    SendAccess(playerid, "Вы выдали %s [%d] оружие %d, патронов %d.", get_name(params[0]), params[0], params[1], params[2]);
    SendInfo(params[0], "Администратор %s [%d] выдал Вам оружие %d, патронов %d.", get_name(playerid), playerid, params[1], params[2]);

    GivePlayerWeapon(params[0], params[1], params[2]);

    Log(LOG_player, INFO, "%s[%d](%s %s) выдал %s[%d](%s %s) оружие (%d) с %d патронов | #AdminLogs",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC", params[1], params[2]);
    return 1;
}

CMD:givegunr(playerid, params[]) {
    if(p_info[playerid][admin] < 3 && p_info[playerid][youtube_adm] < 3) return 1;
    if(sscanf(params, "iii", params[0], params[1], params[2])) return SendInfo(playerid, "Используйте: /givegunr [id оружия] [патроны] [радиус]");

    if(params[0] >= 35 && params[0] <= 40 || params[0] >= 44 || params[0] < 1)
        return SendError(playerid, "Вы ввели запрещенный ID оружия.");

    if(params[2] > 100.0 || params[2] < 1.0) return SendError(playerid, "Радиус должен быть не менее 1 и не более 100.");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] выдал оружие %d, патронов %d в радиусе %0.2f.", get_name(playerid), playerid, params[0], params[1], params[2]);
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

    foreach(new i: Player) {
        if(!p_info[i][loggedIn]) continue;
        if(IsPlayerStream(params[2], playerid, i) && p_info[i][level] > 1) {
            SendInfo(i, "Администратор %s [%d] выдал Вам оружие %d, патронов %d.", get_name(playerid), playerid, params[0], params[1]);
            GivePlayerWeapon(i, params[0], params[1]);
        }
    }
    SendAccess(playerid, "Вы выдали игрокам оружие %d, патронов %d в радиусе %d.", params[0], params[1], params[2]);
    return 1;
}

CMD:resetgun(playerid, params[]) {
    if(p_info[playerid][admin] < 3) return 1;
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /resetgun [id игрока]");

    if(params[0] == INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок не найден.");

    SendAccess(playerid, "Вы забрали у %s [%d] оружие.", get_name(params[0]), params[0]);
    SendInfo(params[0], "Администратор %s [%d] забрал у Вас оружие.", get_name(playerid), playerid);

    f_ResetPlayerWeapons(params[0]);
    return 1;
}

CMD:resetgunr(playerid, params[]) {
    if(p_info[playerid][admin] < 3) return 1;
    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "Используйте: /resetgunr [радиус]");
    if(params[0] > 100 || params[0] < 1) return SendError(playerid, "Радиус должен быть не менее 1 и не более 100.");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] забрал оружие в радиусе %d.", get_name(playerid), playerid, params[0]);
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

    foreach(new i: Player) {
        if(!p_info[i][loggedIn]) continue;
        if(IsPlayerStream(params[0], playerid, i)) {
            SendInfo(i, "Администратор %s [%d] забрал у Вас оружие.", get_name(playerid), playerid);
            ResetPlayerWeapons(i);
        }
    }
    SendAccess(playerid, "Вы забрали оружие у игроков в радиусе %d.", params[0]);
    return 1;
}

alias:w("whisper");
CMD:w(playerid, params[])
{
    if(p_info[playerid][mute] > 0) return SendError(playerid, "У Вас блокировка чата.");
    else if(isnull(params) || strlen(params) > 100) return SendInfo(playerid, "Используйте: /w [текст]");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);
    new string[144];
    format(string, sizeof(string), "%s [%d] шепчет: %s", get_name(playerid), playerid, params);
    SendStreamMessage(2.0, playerid, string, 0x6E6E6E6E);
    SetPlayerChatBubble(playerid, params, COLOR_MAIN, 20.0, 10000);
    return 1;
}

CMD:networkstats(playerid, params[])
{
    if(p_info[playerid][admin] < 1) return 1;
    STRING_GLOBAL[0] = EOS;
    GetNetworkStats(STRING_GLOBAL, sizeof(STRING_GLOBAL)); // get the servers networkstats
    STRING_MIN[0] = EOS;
    format(STRING_MIN, sizeof(STRING_MIN), "\nMySQL unprocessed pool: %d.", mysql_unprocessed_queries());
    strcat(STRING_GLOBAL, STRING_MIN);
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Server Network Stats", STRING_GLOBAL, "Close", "");
    return 1;
}

CMD:ghelp(playerid, params[])
{
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Помощь по гаражу",
    ""I"Гараж: "W"Даст возможность владельцу парковать личную машину в нем.\n\
    Так же арендатору (в том случае, если есть на это разрешение).\n\
    Количество мест в гараже ограничено по классу дома.\n\
    Машина, находящаяся в гараже при выезде на ней переходит в состояние - "A"используется.\n\
    "W"При этом выгнать две и более машины одновременно нельзя!\n\
    "I"/cars "W"даст выгрузить другую, в случае, если используемая находиться в гараже.","Понял","");
    return 1;
}

CMD:ahistory(playerid, params[])
{
    if(p_info[playerid][admin] < 3) return 1;
    if(!(3 <= strlen(params) <= 24)) return SendError(playerid, "Длина введеного текста должна быть не менее 3 и не более 24 символов.");

    format(p_temp[playerid][PlayerHistory], 24, "%s", params);
    new count = 1;

    STRING_GLOBAL[0] = EOS;
    for(new i; i < TYPE_LOG_ALL-1; i++)
    {
        if(i == 2) continue;
        f(STRING_GLOBAL, "%s"I"[%d] "W"%s\n", STRING_GLOBAL, count, NameTypeHistoryPunishment[i]);
        count++;
    }
    ShowPlayerDialog(playerid, D_PLAYER_HISTORY, DIALOG_STYLE_LIST, ""I"История наказаний", STRING_GLOBAL, "Выбрать", "Отмена");
    return 1;
}

CMD:history(playerid, params[])
{
    format(p_temp[playerid][PlayerHistory], 24, "%s", get_name(playerid));

    new count = 1;

    STRING_GLOBAL[0] = EOS;
    for(new i; i < TYPE_LOG_ALL-1; i++)
    {
        if(i == 2) continue;
        f(STRING_GLOBAL, "%s"I"[%d] "W"%s\n", STRING_GLOBAL, count, NameTypeHistoryPunishment[i]);
        count++;
    }
    ShowPlayerDialog(playerid, D_PLAYER_HISTORY, DIALOG_STYLE_LIST, ""I"История наказаний", STRING_GLOBAL, "Выбрать", "Отмена");
    return 1;
}

CMD:hint(playerid, params[])
{
    new h = GetPlayerHouseID(playerid);
    if(GetPlayerVirtualWorld(playerid) != h+50 || p_temp[playerid][h_buy_int] == -1) return 1;
    new int_id = p_temp[playerid][h_buy_int];
    if(int_id < 0) return SendError(playerid, "Что-то пошло не так, попробуйте заново или обновите версию клиента.");
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы действительно хотите купить данный интерьер? Цена: "I"%d$\n\n"W"Для отмены покупки и возврата назад нажмите 'Отмена'", interior_price[int_id]*h_info[h][h_squar]);
    ShowPlayerDialog(playerid, D_HOUSE_CHANGE_INT_BUY, DIALOG_STYLE_MSGBOX, ""I"Смена интерьера", STRING_GLOBAL,"Купить","Отмена");
    return 1;
}

CMD:switchskin(playerid, params[])
{
    if(!mafia(playerid) && !gang(playerid) && !biker(playerid)) return SendError(playerid, "Вы не состоите в нелегальной организации.");
    if(p_info[playerid][army_skin] == 0) return SendError(playerid, "У Вас нет формы.");
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return SendError(playerid, "В данный момент Вы не можете надеть форму.");
    SetPlayerSkin(playerid, 287);
    p_info[playerid][army_skin] = 0;
    SendAccess(playerid, "Вы надели форму армейца.");
    return 1;
}

CMD:sellskin(playerid, params[])
{
    if(p_info[playerid][member] != NATIONAL_GUARD || p_info[playerid][rang] < 6) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "Используйте: /sellskin [id игрока] [стоимость]");
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не найден.");
    if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(params[1] < 1 || params[1] > 50000) return SendError(playerid, "Стоимость должна быть не менее 1$ и не более 50000$.");
    if(!mafia(params[0]) && !gang(params[0]) && !biker(params[0])) return SendError(playerid, "Игрок не состоит в нелегальной организации.");

    SendAccess(playerid, "Вы предложили %s [%d] приобрести форму за %d$.", get_name(params[0]), params[0], params[1]);
    SendInfo(params[0], "%s [%d] предложил Вам приобрести форму за %d$.", get_name(playerid), playerid, params[1]);

    SetFreeSlotOffer(params[0], playerid, OFFER_ID_BUY_ARMY_SKIN, params[1]);
    return 1;
}

CMD:getgun(playerid, params[])
{
    if(!(p_info[playerid][member] != 0 && p_info[playerid][fwork] == true)) return 1;

    new id = p_info[playerid][member];
    if(GetFactionCategory(id) != FACTION_CATEGORY_PD &&
        GetFactionCategory(id) != FACTION_CATEGORY_FBI &&
        GetFactionCategory(id) != FACTION_CATEGORY_ARMY &&
        GetFactionCategory(id) != FACTION_CATEGORY_MAYOR &&
        GetFactionCategory(id) != FACTION_CATEGORY_PRISON) return 1;

    if(GetPlayerInterior(playerid) != FractionsData[id][fBaseField][fInterior]) return 1;

    if((p_info[playerid][rang] < 2 && GetFactionCategory(id) != FACTION_CATEGORY_ARMY) &&
       (p_info[playerid][rang] < 2 && GetFactionCategory(id) != FACTION_CATEGORY_MAYOR))
        return SendError(playerid, "Вы не охранник.");

    if(!IsPlayerInRangeOfPoint(playerid, 15.0, FractionsData[id][fWarehousePos][0], FractionsData[id][fWarehousePos][1], FractionsData[id][fWarehousePos][2])) return 1;
    if(!GetFractionSettings(id, fWareHouseStatus) && p_info[playerid][rang] != 10) return SendError(playerid, "Лидер закрыл склад.");

    if(GetFactionCategory(id) == FACTION_CATEGORY_MAYOR)
    {
        if(p_info[playerid][rang] > 2)
            return SendError(playerid, "Вы не охранник.");
        if(GetFractionWarehouse(id, fwPatron) < 25) {
            SendError(playerid, "На складе недостаточно патронов.");
            return 1;
        }
        if(GetFractionWarehouse(id, fwMate) < 50) {
            SendError(playerid, "На складе недостаточно материалов.");
            return 1;
        }

        new weapon, ammo;
        GetPlayerWeaponData(playerid, WEAPON_Slot[WEAPON_DEAGLE], weapon, ammo);
        if((weapon == WEAPON_DEAGLE) && (ammo >= 10)) return SendError(playerid, "У Вас уже есть оружие данного типа.");

        SetFractionWarehouse(MAYOR_LS, fwMate, -50);
        SetFractionWarehouse(MAYOR_LS, fwPatron, -25);

        f_GivePlayerWeapon(playerid, WEAPON_DEAGLE, 25);

        SendInfo(playerid, "Вам выдан бронежилет и Desert Eagle с %d патронами.", 25);

        SetPlayerArmour(playerid, 100.0);

        SendInfo(playerid, "Что бы снять бронижелет введите: /unarm");
        return 1;
    }

    new i;
    STRING_GLOBAL[0] = EOS;
    if(GetFactionCategory(id) == FACTION_CATEGORY_PD){
        for (new j = sizeof(pdWEAPON); i < j; i++) {
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" %s (патрон - %i, матов - %i)\n", STRING_GLOBAL, i+1, WEAPON_Name[pdWEAPON[i][g_Id]], pdWEAPON[i][g_Patr], pdWEAPON[i][g_Matr]);
        }
    } else if(GetFactionCategory(id) == FACTION_CATEGORY_FBI) {
        for (new j = sizeof(fbiWEAPON); i < j; i++) {
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" %s (патрон - %i, матов - %i)\n", STRING_GLOBAL, i+1, WEAPON_Name[fbiWEAPON[i][g_Id]], fbiWEAPON[i][g_Patr], fbiWEAPON[i][g_Matr]);
        }
    } else if(GetFactionCategory(id) == FACTION_CATEGORY_ARMY) {
        for (new j = sizeof(armyWEAPON); i < j; i++) {
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" %s (патрон - %i, матов - %i)\n", STRING_GLOBAL, i+1, WEAPON_Name[armyWEAPON[i][g_Id]], armyWEAPON[i][g_Patr], armyWEAPON[i][g_Matr]);
        }
    } else if(GetFactionCategory(id) == FACTION_CATEGORY_PRISON) {
        for (new j = sizeof(prisonWEAPON); i < j; i++) {
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" %s (патрон - %i, матов - %i)\n", STRING_GLOBAL, i+1, WEAPON_Name[prisonWEAPON[i][g_Id]], prisonWEAPON[i][g_Patr], prisonWEAPON[i][g_Matr]);
        }
    }
    ShowPlayerDialog(playerid, D_GET_GUN, DIALOG_STYLE_LIST, ""I"Выберите оружие", STRING_GLOBAL, "Выбрать", "Выход");
    new Float:p_armour;
    GetPlayerArmour(playerid, p_armour);
    if(p_armour <= 90.0) {
        SetPlayerArmour(playerid, 100.0);
        SendInfo(playerid, "Вам выдан бронежилет.");
        SendInfo(playerid, "Что бы снять бронижелет введите: /unarm");
    }
    return 1;
}

CMD:de(playerid, params[])
{
    new patrons;
    if(sscanf(params, "i", patrons)) return SendInfo(playerid, "Используйте: /de [патрон]");
    FastMakeGun(playerid, WEAPON_DEAGLE, patrons);
    return 1;
}

CMD:m4(playerid, params[])
{
    new patrons;
    if(sscanf(params, "i", patrons)) return SendInfo(playerid, "Используйте: /m4 [патрон]");
    FastMakeGun(playerid, WEAPON_M4, patrons);
    return 1;
}

CMD:ak47(playerid, params[])
{
    new patrons;
    if(sscanf(params, "i", patrons)) return SendInfo(playerid, "Используйте: /ak47 [патрон]");
    FastMakeGun(playerid, WEAPON_AK47, patrons);
    return 1;
}

CMD:mp5(playerid, params[])
{
    new patrons;
    if(sscanf(params, "i", patrons)) return SendInfo(playerid, "Используйте: /mp5 [патрон]");
    FastMakeGun(playerid, WEAPON_MP5, patrons);
    return 1;
}

GetWeaponListID(category, weaponid)
{
    switch(category)
    {
        case FACTION_CATEGORY_MAFIA:
        {
            for (new j = sizeof(mafiaWEAPON), i; i < j; i++) {
                if(mafiaWEAPON[i][g_Id] == weaponid) return i;
            }
        } 
        case FACTION_CATEGORY_BIKER:
        {
            for (new j = sizeof(bikerWEAPON), i; i < j; i++) {
                if(bikerWEAPON[i][g_Id] == weaponid) return i;
            }
        }
       case FACTION_CATEGORY_GANG:
        {
            for (new j = sizeof(gangWEAPON), i; i < j; i++) {
                if(gangWEAPON[i][g_Id] == weaponid) return i;
            }
        }
    }
    return -1;
}

stock FastMakeGun(playerid, weaponid, patrons)
{
    new gangzone = GetGangZoneID(playerid),
        familyzone = GetFamilyZoneID(playerid),
        family_idx = GetPlayerFamilyID(playerid),
        category = GetFactionCategory(p_info[playerid][member]);

    if(category != FACTION_CATEGORY_MAFIA && category != FACTION_CATEGORY_GANG && category != FACTION_CATEGORY_BIKER && family_idx == -1)
        return SendError(playerid, "Доступно только криминальным структурам и семьям.");
    if(p_info[playerid][jail_time] > 0)
        return SendError(playerid, "Вы находитесь в тюрьме.");
    if(!(1 <= patrons <= GetInventoryAmount(playerid, 628)))
        return SendError(playerid, "У Вас нет столько патронов.");
    new gunid;
    if(GetPlayerInterior(playerid) == FractionsData[p_info[playerid][member]][fBaseField][fInterior] || 
        (category == FACTION_CATEGORY_GANG && gangzone != INVALID_CRIMINAL_ZONE_ID && GangZone_Info[gangzone][g_Fraction] == p_info[playerid][member]))
    {
        gunid = GetWeaponListID(category, weaponid);
        if(gunid != -1)
        {
            switch(category)
            {
                case FACTION_CATEGORY_MAFIA:
                {
                    if(!GivePlayerInventory(playerid, 627, -mafiaWEAPON[gunid][g_Matr]))
                        return SendError(playerid, "В инвентаре нет достаточно материалов.");
                    f_GivePlayerWeapon(playerid, mafiaWEAPON[gunid][g_Id], patrons);
                } 
                case FACTION_CATEGORY_GANG:
                {
                    if(!GivePlayerInventory(playerid, 627, -gangWEAPON[gunid][g_Matr]))
                        return SendError(playerid, "В инвентаре нет достаточно материалов.");
                    f_GivePlayerWeapon(playerid, gangWEAPON[gunid][g_Id], patrons);
                }
                case FACTION_CATEGORY_BIKER:
                {
                    if(!GivePlayerInventory(playerid, 627, -bikerWEAPON[gunid][g_Matr]))
                        return SendError(playerid, "В инвентаре нет достаточно материалов.");
                    f_GivePlayerWeapon(playerid, bikerWEAPON[gunid][g_Id], patrons);
                }
            }
            SendAccess(playerid, "Вы скрафтили %s с %d патрон.", WEAPON_Name[weaponid], patrons);
            return 1;
        }
    }
    if(family_idx != -1)
    {
        new fhouse_id = FamilyData[family_idx][fHouseID];
        if((familyzone != INVALID_CRIMINAL_ZONE_ID && FamilyZone_Info[familyzone][fFamilyOwner] == FamilyData[family_idx][fMysqlID]) || 
            (fhouse_id != INVALID_HOUSE_ID && IsPlayerInRangeOfPoint(playerid, 50.0, h_info[fhouse_id][h_enter][0],h_info[fhouse_id][h_enter][1], h_info[fhouse_id][h_enter][2])) ||
            (fhouse_id != INVALID_HOUSE_ID && GetPlayerVirtualWorld(playerid) == fhouse_id+50))
        {
            gunid = GetWeaponListID(FACTION_CATEGORY_GANG, weaponid);
            if(gunid != -1)
            {
                if(!GivePlayerInventory(playerid, 627, -gangWEAPON[gunid][g_Matr]))
                    return SendError(playerid, "В инвентаре нет достаточно материалов.");
                f_GivePlayerWeapon(playerid, gangWEAPON[gunid][g_Id], patrons);
                SendAccess(playerid, "Вы скрафтили %s с %d патрон.", WEAPON_Name[weaponid], patrons);
                return 1;
            }
        }
    }
    if(gunid == -1) return SendError(playerid, "Вам не доступно это оружие для крафта.");
    SendError(playerid, "Вы должны находится на базе своей фракции/семьи или своей территории.");
    return 1;
}

CMD:makegun(playerid)
{
    if(p_info[playerid][jail_time] > 0)
        return SendError(playerid, "Вы находитесь в тюрьме.");
    new gangzone = GetGangZoneID(playerid),
        familyzone = GetFamilyZoneID(playerid),
        family_idx = GetPlayerFamilyID(playerid),
        category = GetFactionCategory(p_info[playerid][member]);
    
    if(category != FACTION_CATEGORY_MAFIA && category != FACTION_CATEGORY_GANG && category != FACTION_CATEGORY_BIKER && family_idx == -1)
        return SendError(playerid, "Доступно только криминальным структурам и семьям.");

    STRING_GLOBAL[0] = EOS;
    if(GetPlayerInterior(playerid) == FractionsData[p_info[playerid][member]][fBaseField][fInterior] || 
        (category == FACTION_CATEGORY_GANG && gangzone != INVALID_CRIMINAL_ZONE_ID && GangZone_Info[gangzone][g_Fraction] == p_info[playerid][member]))
    {
        new i;
        switch(category)
        {
            case FACTION_CATEGORY_MAFIA:
            {
                for (new j = sizeof(mafiaWEAPON); i < j; i++)
                    f(STRING_GLOBAL, "%s"I"[%d]"W" %s (матов - %i)\n", STRING_GLOBAL, i+1, WEAPON_Name[mafiaWEAPON[i][g_Id]], mafiaWEAPON[i][g_Matr]);
            }
            case FACTION_CATEGORY_GANG:
            {
                for (new j = sizeof(gangWEAPON); i < j; i++)
                    f(STRING_GLOBAL, "%s"I"[%d]"W" %s (матов - %i)\n", STRING_GLOBAL, i+1, WEAPON_Name[gangWEAPON[i][g_Id]], gangWEAPON[i][g_Matr]);
            }
            case FACTION_CATEGORY_BIKER:
            {
                for (new j = sizeof(bikerWEAPON); i < j; i++) 
                    f(STRING_GLOBAL, "%s"I"[%d]"W" %s (матов - %i)\n", STRING_GLOBAL, i+1, WEAPON_Name[bikerWEAPON[i][g_Id]], bikerWEAPON[i][g_Matr]);
            }
        }
    }
    if(family_idx != -1)
    {
        new fhouse_id = FamilyData[family_idx][fHouseID];
        if((familyzone != INVALID_CRIMINAL_ZONE_ID && FamilyZone_Info[familyzone][fFamilyOwner] == FamilyData[family_idx][fMysqlID]) || 
            (fhouse_id != INVALID_HOUSE_ID && IsPlayerInRangeOfPoint(playerid, 50.0, h_info[fhouse_id][h_enter][0],h_info[fhouse_id][h_enter][1], h_info[fhouse_id][h_enter][2])) ||
            (fhouse_id != INVALID_HOUSE_ID && GetPlayerVirtualWorld(playerid) == fhouse_id+50))
        {
            for(new i, j = sizeof(gangWEAPON); i < j; i++)
                f(STRING_GLOBAL, "%s"I"[%d]"W" %s (матов - %i)\n", STRING_GLOBAL, i+1, WEAPON_Name[gangWEAPON[i][g_Id]], gangWEAPON[i][g_Matr]);
        }
    }
    if(!strlen(STRING_GLOBAL))
        return SendError(playerid, "Вы должны находится на базе своей фракции/семьи или своей территории.");
    ShowPlayerDialog(playerid, D_MAKE_GUN, DIALOG_STYLE_LIST, ""I"Создать оружие", STRING_GLOBAL, "Выбрать", "Выход");
    return 1;
}
alias:makegun("fmakegun");

CMD:sellgunlic(playerid, params[])
{
    if(!IsPlayerFractionPolice(playerid) || p_info[playerid][rang] < 3) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /sellgunlic [id игрока]");
    if(!IsPlayerConnected(params[0])) return true;
    if(!IsPlayerStream(3.0, playerid, params[0])) return true;
    if(p_info[params[0]][Lic][LIC_WEAPON] == 2) return SendError(playerid, "У игрока черный список лицензии на \"%s\".", name_license[LIC_WEAPON]);
    if(p_info[params[0]][Lic][LIC_WEAPON] == 1) return SendError(playerid, "У игрока уже есть лицензия на оружие.");
    if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");
    if(GetPVarInt(params[0],"BoneStol_ID")) return 1;
    if(p_info[params[0]][level] < 3) return SendError(playerid, "У игрока нет 3-его уровня.");

    SendAccess(playerid, "Вы предложили %s [%d] приобрести лицензию на оружие за %d$.", get_name(params[0]), params[0], price_license[LIC_WEAPON]);
    SendInfo(params[0], "%s [%d] предложил Вам приобрести лицензию на оружие за %d$.", get_name(playerid), playerid, price_license[LIC_WEAPON]);

    SetFreeSlotOffer(params[0], playerid, OFFER_ID_BUY_GUN_LIC, price_license[LIC_WEAPON]);
    return 1;
}

CMD:ram(playerid, params[])
{
    if(IsPlayerFractionPolice(playerid) && p_info[playerid][rang] > 4 || p_info[playerid][admin] >= 1)
    {
        new h_class, int_id;
        for(new i; i < totalhouses; i++)
        {
            if(h_info[i][h_mysql_id] == INVALID_MYSQL_ID) continue;
            if(h_info[i][h_delete] == 1) continue;
            if(PlayerToPoint(3.0, playerid, h_info[i][h_enter][0], h_info[i][h_enter][1], h_info[i][h_enter][2]))
            {
                h_class = h_info[i][h_squar]-1;
                int_id = h_info[i][h_int];
                MeAction(playerid, "взломал(-а) замок в двери дома");
                SetPlayerHousePos(playerid, i, h_class, int_id);

                SetTimerEx("house_lock", 30000, 0, "iiiii", i, h_info[i][h_lock], h_info[i][h_garage_lock], h_info[i][h_attic_lock], h_info[i][h_underground_lock]);
                h_info[i][h_lock] =
                h_info[i][h_garage_lock] =
                h_info[i][h_attic_lock] =
                h_info[i][h_underground_lock] = 0;
                break;
            }
        }
    }
    return true;
}
forward house_lock(houseID, house_door, garage_door, attic_door, underground_door);
public house_lock(houseID, house_door, garage_door, attic_door, underground_door)
{
    h_info[houseID][h_lock] = house_door;
    h_info[houseID][h_garage_lock] = garage_door;
    h_info[houseID][h_attic_lock] = attic_door;
    h_info[houseID][h_underground_lock] = underground_door;
    return 1;
}

CMD:take(playerid, params[])
{
    if(((!IsPlayerFractionPolice(playerid) && p_info[playerid][member] != PRISON) || p_info[playerid][rang] < 4) && p_info[playerid][admin] < 4)
        return SendError(playerid, "Вы не можете пользоваться этой командой.");

    ShowPlayerDialog(playerid, D_TAKE_LIST, DIALOG_STYLE_LIST, ""I"Изъять", "\
    "I"[1]"W" Лицензия на наземный транспорт\n\
    "I"[2]"W" Лицензия на мото-транспорт\n\
    "I"[3]"W" Лицензия на водный транспорт\n\
    "I"[4]"W" Лицензия на воздушный транспорт\n\
    "I"[5]"W" Лицензия на оружие\n\
    "I"[6]"W" Материалы\n\
    "I"[7]"W" Патроны\n\
    "I"[8]"W" Наркотики\n\
    "I"[9]"W" Оружие", "Готово", "Отмена");
    return true;
}

CMD:gettax(playerid, params[])
{
    if(p_info[playerid][admin] < 4)
        return 1;

    if(isnull(params))
        return SendInfo(playerid, "Используйте: /gettax [id фракции]");

    new
        fraction = strval(params);

    if(!(1 <= fraction <= 21))
        return SendError(playerid, "Неверный ID фракции.");

    SendInfo(playerid, "На балансе \"%s\" %d$.", GetFractionName(fraction), GetFractionWarehouse(fraction, fwMoney));
    return 1;
}

CMD:asettax(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10)
        return 1;

    new fraction, money;
    if(sscanf(params, "ii", fraction, money)) return SendInfo(playerid, "Используйте: /asettax [id фракции] [кол-во]");

    if(!(1 <= fraction <= 21))
        return SendError(playerid, "Неверынй ID фракции.");

    SetFractionWarehouse(fraction, fwMoney, money);

    SendAccess(playerid, "Вы добавили на баланс \"%s\" %d$.", GetFractionName(fraction), money);
    SendInfo(playerid, "На балансе \"%s\" %d$.", GetFractionName(fraction), GetFractionWarehouse(fraction, fwMoney));
    return 1;
}

CMD:setaware(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 4)
        return 1;

    if(sscanf(params, "ii", params[0], params[1]))
        return SendInfo(playerid, "Используйте: /setaware [ID] [кол-во]");

    if(params[1] < 0) return SendError(playerid, "Материалов должно быть не менее 0.");
    if(!(1 <= params[0] < MAX_FRACTIONS)) return SendInfo(playerid, "Используйте: /setaware [ID] [кол-во]");

    SetFractionWarehouse(params[0], fwMate, params[1]);
    SetFractionWarehouse(params[0], fwPatron, params[1]);

    SendAccess(playerid, "Вы установили %d материалов для склада %s. (Если больше лимита - лимит).", params[1], GetFractionName(params[0]));
    return 1;
}

CMD:frisk(playerid, params[])
{
    if((!IsPlayerFractionPolice(playerid) && p_info[playerid][member] != PRISON) || p_info[playerid][rang] < 3) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /frisk [id игрока]");
    if(!IsPlayerConnected(params[0])) return true;
    if(!IsPlayerStream(3.0, playerid, params[0])) return true;
    if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "Перчатки лежат в кармане.");
        MeAction(playerid, "засунул правую руку в карман, после чего нащупав перчатки...");
        MeAction(playerid, "...достал их и одел на руки");
        MeAction(playerid, "медленно провел руками в области карманов, туловища...");
        MeAction(playerid, "...бедер и ног пытаясь хоть что-то найти");
    }

    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "обыскал(-а) %s", get_name(params[0]));
    MeAction(playerid, STRING_GLOBAL);

    SendInfo(playerid, "Вещи %s.", get_name(params[0]));
    SendInfo(playerid, "%s", (GetInventoryAmount(params[0], 629)) ? ("Наркотики.") : ("Пустой карман."));
    SendInfo(playerid, "%s", (GetInventoryAmount(params[0], 627)) ? ("Материалы.") : ("Пустой карман."));
    SendInfo(playerid, "%s", (GetInventoryAmount(params[0], 628)) ? ("Патроны.") : ("Пустой карман."));

    SetPlayerSpecialAction(params[0], SPECIAL_ACTION_HANDSUP);

    p_info[playerid][fracdata][6]++;
    SaveFracData(playerid);

    CheckPlayerMission(playerid, POLICE_FRISK);

    p_info[playerid][ftop_frisk]++;
    MysqlUpdatePlayerInt(playerid, "ftop_frisk", p_info[playerid][ftop_frisk]);
    return 1;
}

CMD:unmask(playerid, params[])
{
    if(!IsPlayerFractionPolice(playerid) || p_info[playerid][rang] < 3) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /unmask [id игрока]");
    if(!IsPlayerConnected(params[0])) return true;
    if(!IsPlayerStream(3.0, playerid, params[0])) return true;
    if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");
    if(!p_temp[params[0]][UseMaskFix]) return SendError(playerid, "Данный игрок не в маске.");

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "Перчатки лежат в кармане.");
        MeAction(playerid, "засунул правую руку в карман, после чего нащупав перчатки...");
        MeAction(playerid, "...достал их и одел на руки");
        MeAction(playerid, "протянул руку, затем снял маску");
    }

    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "снял(-а) маску с %s", get_name(params[0]));
    MeAction(playerid, STRING_GLOBAL);

    maskOFF(params[0]);
    return 1;
}

CMD:healaddict(playerid, params[])
{
    if(!IsPlayerFractionMedic(playerid)) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(p_info[playerid][rang] < 5) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(sscanf(params, "u", params[0]))  return SendInfo(playerid, "Используйте: /healaddict [id игрока]");
    if( !IsPlayerInRangeOfPoint(playerid, 50.0, 185.5570,-1681.7745,1007.4592) &&
        !IsPlayerInRangeOfPoint(playerid, 50.0, 230.4494,-1688.0889,2007.4280)) return SendError(playerid, "Вы не в больнице.");
    if(params[0] == INVALID_PLAYER_ID) return true;
    if(p_info[params[0]][d_addiction] < 1000) return SendError(playerid, "У игрока менее 1000 зависимости.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");

    SendAccess(playerid, "Вы предложили %s [%d] вылечиться от наркозависимости за 10000$.", get_name(params[0]), params[0]);
    SendInfo(params[0], "%s [%d] предложил Вам вылечиться от наркозависимости за 10000$.", get_name(playerid), playerid);

    SetFreeSlotOffer(params[0], playerid, OFFER_ID_BUY_HEAL_ADDICT, 10000);
    return true;
}

CMD:healdisease(playerid, params[])
{
    if(!IsPlayerFractionMedic(playerid)) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(p_info[playerid][rang] < 7) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(sscanf(params, "u", params[0]))  return SendInfo(playerid, "Используйте: /healdisease [id игрока]");
    if(params[0] == INVALID_PLAYER_ID) return true;
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");

    new diseasename[6][24] = {"ОРВИ", "Диарея", "СПИД", "Рак легких", "Рак желудка", "Туберкулез"}, diseaseprice[6] = {2500, 10000, 25000, 50000, 100000, 50000};
    STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;
    for(new i; i < 6; i++)
    {
        if(p_info[params[0]][Disease][i] == 0)
        {
            f(STRING_MIN, ""I"[%d]"W" %s (Нет)\n", i + 1, diseasename[i]);
            strcat(STRING_GLOBAL, STRING_MIN);
        }
        else
        {
            f(STRING_MIN, ""I"[%d]"W" %s (Есть, стоимость лечения %d$)\n", i + 1, diseasename[i], diseaseprice[i] * p_info[params[0]][Disease][i]);
            strcat(STRING_GLOBAL, STRING_MIN);
        }
    }

    STRING_MIN[0] = EOS;
    f(STRING_MIN, "Лечение %s", get_name(params[0]));
    ShowPlayerDialog(playerid, D_HOSPITAL_MED_DISEASE, DIALOG_STYLE_LIST, STRING_MIN, STRING_GLOBAL, "Далее", "Отмена");
    SetPVarInt(playerid, "HospitalDisease:scdplayerid", params[0]);
    SetPVarInt(playerid, "HospitalDisease:id", p_info[params[0]][ID]);
    return 1;
}

CMD:reanimate(playerid, params[])
{
    if(sscanf(params, "u", params[0]))  return SendInfo(playerid, "Используйте: /reanimate [id игрока]");
    if(params[0] == INVALID_PLAYER_ID) return 1;
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(!p_info[playerid][p_vip] && params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");
    if(p_temp[params[0]][death_status] == 0) return SendError(playerid, "Игрок не находится в бессознательном состоянии.");

    if(GetInventoryAmount(playerid, 683) <= 0)
        return SendError(playerid, "У Вас нет укола адреналина.");
    
    GivePlayerInventory(playerid, 683, -1);
    
    p_temp[params[0]][death_status] = 0;
    p_temp[params[0]][death_timer] = 0;
    p_temp[params[0]][death_anim] = 0;

    Fix_TogglePlayerControllable(params[0], 1);
    ClearAnimations(params[0]);

    SendAccess(playerid, "Вы реанимировали %s [%d].", get_name(params[0]), params[0]);
    SendInfo(params[0], "%s [%d] реанимировал(-а) Вас.", get_name(playerid), playerid);

    if(IsPlayerFractionMedic(playerid))
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[R] %s [%d] реанимировал(-а) %s [%d].", get_name(playerid), playerid, get_name(params[0]), params[0]);
        SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
    }
    return 1;
}

alias:usedrugs("drugs");
CMD:usedrugs(playerid, params[])
{
    if(p_temp[playerid][fix_shot] > timestamp) return SendError(playerid, "Воспользоваться наркотиками можно через %d секунд.", p_temp[playerid][fix_shot] - timestamp);
    if(RegisterPaintBall[playerid] == 2) return SendError(playerid, "Во время пейнтбола запрещено пользоваться наркотиками.");
    if(p_temp[playerid][cossack_robbers_register] == 2) return SendError(playerid, "Во время Казаков-разбойников запрещено пользоваться наркотиками.");
    if(player_lobby_status[playerid] == true) return SendError(playerid, "Находясь в лобби запрещено пользоваться наркотиками.");
    if(p_info[playerid][satiety] < 20) return SendError(playerid, "Сначала нужно поесть, иначе Вы отравитесь.");
    if(p_temp[playerid][SparringID] != -1) return SendError(playerid, "В спарринге не доступно.");
    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "Используйте: /usedrugs [кол-во]");

    if(params[0] < 1) return SendError(playerid, "Кол-во грамм должно быть не менее 1.");

    /* zalupaaaaaaaaa
    if(gang(playerid) && GetPlayerStatusCapture(playerid) == CAPTURE_ID_GANG)
    {
        new gangzone = GetGangZoneID(playerid);
        if(gAreaInfo[areaid][area_subtype] == AREA_SUBTYPE_GANG_ZONE && gang(playerid) && IsGangSpawnKill(playerid) != p_info[playerid][member] && GetPlayerStatusCapture(playerid) == CAPTURE_ID_GANG)
            {
                new faction_playerid = p_info[playerid][member], faction_target = GangZone_Info[p_temp[playerid][CriminalZoneID]][g_Fraction];
                if(faction_playerid != faction_target)
                {
                    new id = GetCaptureID(faction_playerid, faction_target);
                    if(id != -1 && (Capture_Info[id][gTime] > 190 || Capture_Info[id][gStatus] == GANG_ZONE_PREPARATION))
                    {


        (IsGangSpawnKill(playerid) == p_info[playerid][member] || IsGangSpawnKill(playerid) == GangZone_Info[GetGangZone(playerid)][g_Fraction])
   
   
        IsGangSpawnKill(playerid) != p_info[playerid][member] && )
            {
                new faction_playerid = p_info[playerid][member], faction_target = GangZone_Info[p_temp[playerid][CriminalZoneID]][g_Fraction];
                if(faction_playerid != faction_target)
                {
                    new id = GetCaptureID(faction_playerid, faction_target);
    {
        if(id != -1 && (Capture_Info[id][gTime] > 190 || Capture_Info[id][gStatus] == GANG_ZONE_PREPARATION))
        {
            STRING_GLOBAL[0] = EOS;
            new diff = Capture_Info[id][gStatus] == GANG_ZONE_PREPARATION ? 20*60 : 0;
            f(STRING_GLOBAL, "~r~Spawn use drugs is blocked %s", ConvertTime(diff+Capture_Info[id][gTime]-190, 1));
            GameTextForPlayer(playerid, STRING_GLOBAL, 1000, 3);
            return 0;
        }
    }
    */

    new Float:fHealth;
    GetPlayerHealth(playerid, fHealth);

    if(GetInventoryAmount(playerid, 629) < params[0]) return SendError(playerid, "У Вас нет столько наркотиков.");

    if(p_info[playerid][d_addiction] < 2000 && params[0] > 5) return SendError(playerid, "Кол-во грамм должно быть не более 5.");
    else if(p_info[playerid][d_addiction] < 5000 && params[0] > 10) return SendError(playerid, "Кол-во грамм должно быть не более 10.");
    else if(params[0] > 15) return SendError(playerid, "Кол-во грамм должно быть не более 15.");

    if(p_info[playerid][d_addiction] < 2000 && fHealth + 10 * params[0] > 120)
    {
        SendInfo(playerid, "Здоровье пополнено до 120.");
        SetPlayerHealth(playerid, p_info[playerid][pHealth] = 120.0);
        SetPlayerTime(playerid, 17, 0);
        SetPlayerWeather(playerid, -67);

        p_temp[playerid][AddictionFix] = 1;
        p_temp[playerid][AddictionTimerFix] = timestamp + 10;
    }
    else if(p_info[playerid][d_addiction] < 5000 && fHealth + 10 * params[0] > 140)
    {
        SendInfo(playerid, "Здоровье пополнено до 140.");
        SetPlayerHealth(playerid, p_info[playerid][pHealth] = 140.0);
    }
    else if(p_info[playerid][d_addiction] > 5000 && fHealth + 10 * params[0] > 160)
    {
        SendInfo(playerid, "Здоровье пополнено до 160.");
        SetPlayerHealth(playerid, p_info[playerid][pHealth] = 160.0);
    }
    else
    {
        SendInfo(playerid, "Здоровье пополнено до %.0f.", fHealth + 10 * params[0]);
        SetPlayerHealth(playerid, p_info[playerid][pHealth] = (fHealth + 10 * params[0]));
        if(p_info[playerid][d_addiction] < 2000)
        {
            SetPlayerTime(playerid, 17, 0);
            SetPlayerWeather(playerid, -68);
            p_temp[playerid][AddictionFix] = 1;
            p_temp[playerid][AddictionTimerFix] = timestamp + 30;
        }
    }

    if(p_info[playerid][d_addiction] >= 5000)
    {
        if(GetPlayerDisease(playerid, 2, 10, 3) == 1) // Шанс 30 процентов;
        {
            p_info[playerid][Disease][2]++;
            SendInfo(playerid, "У Вас появилось новое заболевание - СПИД %d степени.", p_info[playerid][Disease][2]);
        }
    }

    //p_temp[playerid][fix_shot] = timestamp+10;

    p_info[playerid][d_demolition] = 0;
    GivePlayerInventory(playerid, 629, -params[0]);
    ApplyAnimation(playerid,"SMOKING","M_smk_drag",4.1,0,0,0,0,0,1);
    SetPlayerChatBubble(playerid, "Употребил(-а) наркотик", COLOR_MAIN, 5.0, 10000);
    MeAction(playerid, "употребил(-a) наркотик");

    p_info[playerid][d_addiction] += 4*params[0];

    if(p_info[playerid][d_start_addiction] == 1)
    {
        p_info[playerid][d_start_addiction] = 0;
        ApplyAnimation(playerid,"SMOKING","M_smk_drag",4.1,0,0,0,0,0,1);
        p_info[playerid][d_demolition] = 0;
    }
    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "Банка с таблетками в кармане.");
        MeAction(playerid, "засунул правую руку в карман, после чего нащупав банку достал ее");
        MeAction(playerid, "открыл и высыпал пару таблеток на ладонь, после чего закинул их в рот");
        DoAction(playerid, "Таблетка во рту.");
    }
    return 1;
}

CMD:myskill(playerid, params[])
{
    SendInfo(playerid, "При достижении максимального навыка теперь автоматически выдается уникальный аксессуар.");
    STRING_GLOBAL = "[#] Название\tНавык\tАксессуар\tПрогресс\n";
    for(new i; i < MAX_SERVER_WORK; i ++)
    {
        f(STRING_GLOBAL, "%s"I"[%d]"W" %s\t%d\t%s\t%d из %d\n", STRING_GLOBAL, i+1, SkillData[i][sName], p_info[playerid][job_skill][i], ItemsInfo[SkillData[i][sAccessories]][iName], p_info[playerid][job_skill_count][i], SkillData[i][sCount]);
    }
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, ""I"Навыки", STRING_GLOBAL, "Далее", "Отмена");
    return 1;
}

CMD:hi(playerid, params[])
{
    if(IsPlayerInAnyVehicle(playerid))
        return SendError(playerid, "Вы находитесь в транспортном средстве.");
    if(sscanf(params, "u", params[0]))
        return SendInfo(playerid, "Используйте: /hi [id игрока]");
    if(params[0] == INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок не найден.");
    if(params[0] == playerid)
        return SendError(playerid, "Вы ввели свой ID.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(IsPlayerInAnyVehicle(params[0]))
        return SendError(playerid, "Игрок находится в транспортном средстве.");
    if(GetPVarInt(params[0],"BoneStol_ID"))
        return 1;
    if(GetPVarInt(playerid, "PlayerCuffed") == 1)
        return SendError(playerid, "Вы в наручниках.");

    SetFreeSlotOffer(params[0], playerid, OFFER_ID_HI);
    return 1;
}

CMD:key(playerid, params[])
{
    new vehicleid = GetPlayerOwnerNearestVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "Около Вас нет рядом транспортного средства.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /key [id игрока]");
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не найден.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
    veh_info[vehicleid][v_used_key_ID] = params[0];
    SendAccess(playerid, "Вы выдали %s [%d] ключи от \"%s\".", get_name(params[0]), params[0], GetVehicleName(vehicleid));
    SendInfo(params[0], "%s [%d] выдал Вам ключи от \"%s\".", get_name(playerid), playerid, GetVehicleName(vehicleid));
    return true;
}

CMD:limit(playerid, params[])
{
    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "Используйте: /limit [скорость]");
    if(params[0] < 0 || params[0] > 140) return SendError(playerid, "Скорость должна быть не менее 0 и не более 140.");
    p_info[playerid][p_carlimit] = params[0];
    SendAccess(playerid, "Вы изменили настройки лимита.");
    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) OnPlayerUpdateVehicleInfo(playerid, SPEEDO_LIMITE);
    return true;
}
CMD:addradar(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10) return true;
    if(sscanf(params, "ii", params[0], params[1])) return SendInfo(playerid, "Используйте: /addradar [скорость] [радиус]");
    if(!(40 <= params[0] <= 140)) return SendInfo(playerid, "Скорость должна быть не менее 40 и не более 140.");
    if(!(10 <= params[1] <= 90)) return SendInfo(playerid, "Радиус должен быть не менее 10 и не более 90.");
    new Float:pX, Float:pY, Float:pZ;
    SetPVarInt(playerid, "addrad", 1);
    SetPVarInt(playerid, "speed", params[0]);
    SetPVarInt(playerid, "radius", params[1]);
    GetPlayerPos(playerid, pX, pY, pZ);
    TOTALRADAR++;
    RadarInfo[TOTALRADAR][rObj] = CreateObject(18880, pX+1, pY+1, pZ, 0.0,0.0,0.0);
    EditObject(playerid, RadarInfo[TOTALRADAR][rObj]);
    return true;
}

CMD:acheck(playerid, params[])
{
    if(p_info[playerid][admin] < 1) return 1;
    if(isnull(params))
    {
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `admin_logs` WHERE `name` = '%e'",
        get_name(playerid));
        mysql_tquery(con_bd, STRING_GLOBAL, "OnCheckStatsAdmin", "is", playerid, get_name(playerid));
    }
    else if(p_info[playerid][admin] > 4)
    {
        if(!(3 <= strlen(params) <= 24)) return SendError(playerid, "Длина введеного текста должна быть не менее 1 и не более 24 символов.");
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `admin_logs` WHERE `name` = '%e'", params);
        mysql_tquery(con_bd, STRING_GLOBAL, "OnCheckStatsAdmin", "is", playerid, params);
    }
    return 1;
}

forward OnCheckStatsAdmin(playerid, const name_admin[]);
public OnCheckStatsAdmin(playerid, const name_admin[])
{
    if(0 == cache_num_rows())
        return SendError(playerid, "Игрок не найден в базе данных.");

    new
        string[256],
        check_online_allday[2],
        check_online[7],
        check_afk[7], _ans, _kick, _jail, _warn, _mute, _ban, _offban, _offjail, _offwarn, _offmute, _rep;

    cache_get_value_name_int(0, "a_ans", _ans); //+
    cache_get_value_name_int(0, "a_kick", _kick); //+
    cache_get_value_name_int(0, "a_jail", _jail);//+
    cache_get_value_name_int(0, "a_warn", _warn);//++
    cache_get_value_name_int(0, "a_mute", _mute);//++
    cache_get_value_name_int(0, "a_ban", _ban);//++
    cache_get_value_name_int(0, "a_offban", _offban);//+
    cache_get_value_name_int(0, "a_offjail", _offjail);//+
    cache_get_value_name_int(0, "a_offwarn", _offwarn);//+
    cache_get_value_name_int(0, "a_offmute", _offmute);//+
    cache_get_value_name_int(0, "a_rep", _rep);//++

    cache_get_value_name_int(0, "a_day_0", check_online[0]);
    cache_get_value_name_int(0, "a_day_1", check_online[1]);
    cache_get_value_name_int(0, "a_day_2", check_online[2]);
    cache_get_value_name_int(0, "a_day_3", check_online[3]);
    cache_get_value_name_int(0, "a_day_4", check_online[4]);
    cache_get_value_name_int(0, "a_day_5", check_online[5]);
    cache_get_value_name_int(0, "a_day_6", check_online[6]);

    cache_get_value_name_int(0, "a_afk_0", check_afk[0]);
    cache_get_value_name_int(0, "a_afk_1", check_afk[1]);
    cache_get_value_name_int(0, "a_afk_2", check_afk[2]);
    cache_get_value_name_int(0, "a_afk_3", check_afk[3]);
    cache_get_value_name_int(0, "a_afk_4", check_afk[4]);
    cache_get_value_name_int(0, "a_afk_5", check_afk[5]);
    cache_get_value_name_int(0, "a_afk_6", check_afk[6]);

    STRING_GLOBAL[0] = EOS;
    strcat(STRING_GLOBAL, "{FF9900}Статистика недели:\n\n");
    format(string, sizeof(string), ""W"Ответов репорта:\t\t{3399FF}%d"W" [Репутация: {3399FF}%d"W"]\n", _ans, _rep);
    strcat(STRING_GLOBAL, string);
    format(string, sizeof(string), ""W"Kick:\t\t{3399FF}%d"W" | \t\tJail: {3399FF}%d\n", _kick, _jail);
    strcat(STRING_GLOBAL, string);
    format(string, sizeof(string), ""W"Warn:\t\t{3399FF}%d"W" | \t\tBan: {3399FF}%d\n", _warn, _ban);
    strcat(STRING_GLOBAL, string);
    format(string, sizeof(string), ""W"Mute:\t\t{3399FF}%d"W" | \t\tOffBan: {3399FF}%d\n", _mute, _offban);
    strcat(STRING_GLOBAL, string);
    format(string, sizeof(string), ""W"OffJail:\t\t{3399FF}%d"W" | \t\tOffWarn: {3399FF}%d\n", _kick, _offwarn);
    strcat(STRING_GLOBAL, string);

    strcat(STRING_GLOBAL, "{FF9900}Недельный онлайн:\n\n");
    format(string, sizeof(string), ""W"Понедельник:\t\t{3399FF}%s"W" [AFK: {3399FF}%s"W"]\n", ConvertTime(check_online[4]), ConvertTime(check_afk[4]));
    strcat(STRING_GLOBAL, string);
    format(string, sizeof(string), ""W"Вторник:\t\t{3399FF}%s"W" [AFK: {3399FF}%s"W"]\n", ConvertTime(check_online[5]), ConvertTime(check_afk[5]));
    strcat(STRING_GLOBAL, string);
    format(string, sizeof(string), ""W"Среда:\t\t\t{3399FF}%s"W" [AFK: {3399FF}%s"W"]\n", ConvertTime(check_online[6]), ConvertTime(check_afk[6]));
    strcat(STRING_GLOBAL, string);
    format(string, sizeof(string), ""W"Четверг:\t\t{3399FF}%s"W" [AFK: {3399FF}%s"W"]\n", ConvertTime(check_online[0]), ConvertTime(check_afk[0]));
    strcat(STRING_GLOBAL, string);
    format(string, sizeof(string), ""W"Пятница:\t\t{3399FF}%s"W" [AFK: {3399FF}%s"W"]\n", ConvertTime(check_online[1]), ConvertTime(check_afk[1]));
    strcat(STRING_GLOBAL, string);
    format(string, sizeof(string), ""W"Суббота:\t\t{3399FF}%s"W" [AFK: {3399FF}%s"W"]\n", ConvertTime(check_online[2]), ConvertTime(check_afk[2]));
    strcat(STRING_GLOBAL, string);
    format(string, sizeof(string), ""W"Воскресенье:\t\t{3399FF}%s"W" [AFK: {3399FF}%s"W"]\n", ConvertTime(check_online[3]), ConvertTime(check_afk[3]));
    strcat(STRING_GLOBAL, string);

    check_online_allday[0] = check_online[0] + check_online[1] + check_online[2] + check_online[3] + check_online[4] + check_online[5] + check_online[6];
    check_online_allday[1] = check_afk[0] + check_afk[1] + check_afk[2] + check_afk[3] + check_afk[4] + check_afk[5] + check_afk[6];

    format(string, sizeof(string), "\n{AFAFAF}Общий онлайн(недельный):\t{DD90FF}%s {AFAFAF}| AFK: {DD90FF}%s", ConvertTime(check_online_allday[0]), ConvertTime(check_online_allday[1]));
    strcat(STRING_GLOBAL, string);

    new
        str[20 - 2 + MAX_PLAYER_NAME];

    format(str, sizeof(str), ""I"ADMIN cтатистикa: %s", name_admin);
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, str, STRING_GLOBAL, "OK", "");
    return 1;
}


CMD:givearmykey(playerid, params[])
{
    if(p_info[playerid][member] != NATIONAL_GUARD || p_info[playerid][rang] < 5) return true;
    new targetid;
    if(sscanf(params, "u", targetid)) return SendInfo(playerid, "Используйте: /givearmykey [id игрока]");
    if(targetid == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не найден.");
    if(!IsPlayerStream(5.0, playerid, targetid) || pSpectateId[targetid] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");

    SendAccess(playerid, "Вы передали %s [%d] ключи от \"%s\".", get_name(targetid), targetid, GetFractionName(p_info[playerid][member]));
    SendInfo(targetid, "%s [%d] передал Вам ключи от \"%s\".", get_name(playerid), playerid, GetFractionName(p_info[playerid][member]));

    p_temp[targetid][keys_door] = p_info[playerid][member];

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "Пропуск лежит в кармане.");
        MeAction(playerid, "засунул правую руку в карман, после чего нащупав пропуск достал его");
        MeAction(playerid, "достав пропуск протянул его человеку на против");
    }
    return 1;
}

