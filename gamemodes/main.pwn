CMD:id(playerid, params[])
{
    new
        target = INVALID_PLAYER_ID;

    sscanf(params, "i", target);
    if(IsPlayerConnected(target) && target != INVALID_PLAYER_ID)
    {
        new
            string[25 - 6 + MAX_PLAYER_NAME + 5 + 9]; // 9 = 8 + 1 (� �������, �� ������ ������).

        if(p_info[target][p_afkTime] > 2)
            format(string, sizeof(string), "* �����: %s [%d] [AFK: %s]", get_name(target), target, ConvertTime(p_info[target][p_afkTime] - 2, 1));
        else
            format(string, sizeof(string), "* �����: %s [%d]", get_name(target), target);

        return SendMes(playerid, COLOR_GRAY, string);
    }
    else
    {
        if(isnull(params))
            return SendInfo(playerid, "�����������: /id [id ������ ��� ����� ��������]");

        new
            string[29 - 8 + 3 + MAX_PLAYER_NAME + 5 + 9], // 9 = 8 + 1 (� �������, �� ������ ������).
            count = 0;

        foreach(new i: Player)
        {
            if(count >= 5) break;
            if(strfind(get_name(i), params, true) != -1)
            {
                if(p_info[i][p_afkTime] > 2)
                    format(string, sizeof(string), "* %d. �����: %s [%d] [AFK: %s]", ++count, get_name(i), i, ConvertTime(p_info[i][p_afkTime] - 2, 1));
                else
                    format(string, sizeof(string), "* %d. �����: %s [%d]", ++count, get_name(i), i);

                SendMes(playerid, COLOR_GRAY, string);
            }
        }

        if(count == 0)
            return SendError(playerid, "�� ������� ��� ������� �� ������ ������.");
    }
    return 1;
}


CMD:clist(playerid, params[])
{
    if(GetPlayerStatusCapture(playerid)) return SendError(playerid, "�������� ���� �� ����� �������� ���������� � �������� ���������.");
    if(p_info[playerid][member] <= 0 && p_info[playerid][admin] <= 0) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(isnull(params))
    {
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL,""I"[0]"W" ��������� ����\n"I"[1]"W" �������\n"I"[2]"W" ������ �������\n"I"[3]"W" ���� �������\n"I"[4]"W" ���������\n"I"[5]"W" �����-�������\n"I"[6]"W" �����-�������\n"I"[7]"W" ����-�������\n"I"[8]"W" �������\n"I"[9]"W" ����-�������\n"I"[10]"W" ���������\n"I"[11]"W" ����������\n"I"[12]"W" �����-�������\n"I"[13]"W" C���-�������\n"I"[14]"W" �����-���������\n"I"[15]"W" ���������\n"I"[16]"W" �������\n"I"[17]"W" �����\n"I"[18]"W" �������\n"I"[19]"W" ����� �����\n"I"[20]"W" ����-�������\n"I"[21]"W" �����-�����\n"I"[22]"W" ����������\n"I"[23]"W" ������\n"I"[24]"W" ����-�����\n"I"[25]"W" ������\n"I"[26]"W" ����������\n"I"[27]"W" �������\n"I"[28]"W" ������");
        return ShowPlayerDialog(playerid,D_CLIST,DIALOG_STYLE_LIST, ""I"����",STRING_GLOBAL,"�������","������");
    }
    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "�����������: /clist [id �����]");
    switch(params[0]+1)
    {
        case 0: SetPlayerColor(playerid,0xFFFFFF20);
        case 1: SetPlayerColor(playerid,0x089401FF);
        case 2: SetPlayerColor(playerid,0x56FB4EFF);
        case 3: SetPlayerColor(playerid,0x49E789FF);
        case 4: SetPlayerColor(playerid,0x2A9170FF);
        case 5: SetPlayerColor(playerid,0x9ED201FF);
        case 6: SetPlayerColor(playerid,0x279B1EFF);
        case 7: SetPlayerColor(playerid,0x51964DFF);
        case 8: SetPlayerColor(playerid,0xFF0606FF);
        case 9: SetPlayerColor(playerid,0xF68F67FF);
        case 10: SetPlayerColor(playerid,0xF45000FF);
        case 11: SetPlayerColor(playerid,0xBE8A01FF);
        case 12: SetPlayerColor(playerid,0xB30000FF);
        case 13: SetPlayerColor(playerid,0x954F4FFF);
        case 14: SetPlayerColor(playerid,0xE7961DFF);
        case 15: SetPlayerColor(playerid,0xE6284EFF);
        case 16: SetPlayerColor(playerid,0xFF9DB6FF);
        case 17: SetPlayerColor(playerid,0x110CE7FF);
        case 18: SetPlayerColor(playerid,0x0CD7E7FF);
        case 19: SetPlayerColor(playerid,0x139BECFF);
        case 20: SetPlayerColor(playerid,0x2C9197FF);
        case 21: SetPlayerColor(playerid,0x114D71FF);
        case 22: SetPlayerColor(playerid,0x8813E7FF);
        case 23: SetPlayerColor(playerid,0xB313E7FF);
        case 24: SetPlayerColor(playerid,0x758C9DFF);
        case 25: SetPlayerColor(playerid,0xFFDE24FF);
        case 26: SetPlayerColor(playerid,0xFFEE8AFF);
        case 27: SetPlayerColor(playerid,0xDDB201FF);
        case 28: SetPlayerColor(playerid,0x313131AA);
    }
    return 1;

}

CMD:stats(playerid, params[])
{
    if(p_info[playerid][admin] < 1 && p_info[playerid][youtube_adm] < 3)
        return player_stats(playerid, playerid);
    if(p_info[playerid][helper] == 1) return SendError(playerid, "������� ���������� ��� ��������.");

    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "�����������: /stats [id ������]");

    if(params[0] == INVALID_PLAYER_ID || !IsPlayerConnected(params[0]))
        return SendError(playerid, "����� �� ������.");

    player_stats(playerid, params[0]);

    Log(LOG_player, INFO, "%s[%d](%s %s) ��������� ���������� %s online | #AdminCheck",
    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
    get_name(params[0]));
    return 1;
}
alias:stats("getstats");

CMD:sellsim(playerid, params[])
{
    if(!PlayerToPoint(100.0, playerid, 2290.1907,-55.2788,1070.2646)) return SendError(playerid, "�� ������ ���������� � �����.");

    if(!p_info[playerid][phone_number]) return SendError(playerid, "� ��� ��� ������ ��������.");
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "�����������: /sellsim [id ������] [���������]");
    if(params[1] < 100 || params[1] > 10_000_000) return SendError(playerid, "��������� ������ ���� �� ����� 100$ � �� ����� 10 000 000$.");
    if(params[0] == INVALID_PLAYER_ID ||  params[0] == playerid) return SendError(playerid, "����� �� ������.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "����� ������� ������ �� ���.");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
    "W"�� ������ ���������� "I"%s"W" ������ ��� ����� �������� "I"%d"W" �� "I"%d$.", get_name(params[0]), p_info[playerid][phone_number], params[1]);
    ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"������� ������ ��������", STRING_GLOBAL, "�����", "������");
    SetOfferData(playerid, params[0], OFFER_ID_SELL_SIM_PHONE, params[1]);
    return 1;
}

CMD:changesim(playerid, params[])
{
    if(!PlayerToPoint(100.0, playerid, 2290.1907,-55.2788,1070.2646)) return SendError(playerid, "�� ������ ���������� � �����.");

