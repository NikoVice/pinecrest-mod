    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "�����������: /changesim [id ������] [���������]");
    if(params[1] < 100 || params[1] > 10_000_000) return SendError(playerid, "��������� ������ ���� �� ����� 100$ � �� ����� 10 000 000$.");
    if(params[0] == INVALID_PLAYER_ID ||  params[0] == playerid) return SendError(playerid, "����� �� ������.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "����� ������� ������ �� ���.");
    if(!p_info[params[0]][phone_number]) return SendError(playerid, "� ������ ��� ������ ��������.");

