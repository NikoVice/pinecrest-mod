public FIXCONNECT_MOBILE(playerid)
{
    SetSpawnInfo(playerid, 255, 79, 2404.1870,1554.4166,43.8807, 1.0, -1, -1, -1, -1, -1, -1);
    SpawnPlayer(playerid);
}

cmd:iim(playerid, params[])
{
    if(IsPlayerMobile(playerid)) SendAccess(playerid, "Вы с мобилы");
    else SendAccess(playerid, "Вы с ПК");
    return 1;
}

stock OnValidPlayerConnected(playerid, szSerial[], szLibraries[])
{
    #pragma unused szSerial
    #pragma unused szLibraries
    return 1;
}
stock OnInvalidPlayerConnected(playerid)
{
    #pragma unused playerid
    return 1;
}

// [logs] Для системы логов надо получать ещё и статус "Offline" если игрок не в сети
// Чтобы было: Mobile, PC, Offline
// Например реализовав функцию: GetPlayerConnectionType()

public OnPlayerDisconnect(playerid, reason)
{
    for(new i = TD_ID_ALL-1; i != -1; i--) HideTextDrawForPlayer(playerid, i);
    DI_OnPlayerDisconnect(playerid);
    HideMapZone(playerid, true);

    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && p_temp[playerid][LastDriverVehicleIDx] != INVALID_VEHICLE_ID)
    {
        new scdvehicleid = p_temp[playerid][LastDriverVehicleIDx];
        if(!strequals(veh_info[scdvehicleid][v_radio_url], "") && veh_info[scdvehicleid][v_radio] == 1)
        {
            format(veh_info[scdvehicleid][v_radio_url], 128, "");
            veh_info[scdvehicleid][v_radio] = 0;
            for(new i = 0, scdplayerid; i < 8; i++)
            {
                scdplayerid = veh_info[scdvehicleid][v_passenger][i];
                if(!IsPlayerConnected(scdplayerid)) continue;
                if(!IsPlayerInAnyVehicle(scdplayerid)) continue;
                if(GetPlayerVehicleID(scdplayerid) != scdvehicleid) continue;
                if(p_info[scdplayerid][p_settings][STATUS_RADIO] != 0) continue;
                if(GetPVarInt(scdplayerid, "UseMusic") != 0) continue;
                DeletePVar(scdplayerid, "UseMusicVehicle");
                StopAudioStreamForPlayer(scdplayerid);
            }
        }
    }

    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER || GetPlayerState(playerid) == PLAYER_STATE_PASSENGER)
    {
        for(new i = 0, vehicleid = GetPlayerVehicleID(playerid); i < 8; i++)
        {
            if(veh_info[vehicleid][v_passenger][i] == playerid)
                veh_info[vehicleid][v_passenger][i] = INVALID_PLAYER_ID;
        }
    }

    ClearChangeNick(playerid);
    br_system_PlayerDisconnect(playerid);
    if(p_temp[playerid][army_post] != -1) Post_System_LeaveArea(playerid, p_temp[playerid][army_post]);
    //if(p_temp[playerid][rappelling] == true) HideRope(playerid);
    EndPlayerJob(playerid);
    if(p_temp[playerid][music_area] != -1) PickUpBoombox(playerid);
    ExitSlotMachine(playerid);
    Durak_LeaveTable(playerid);
    EndBones(playerid); // end game dice
    ClearHookah(playerid, 1);
    if(p_temp[playerid][bonfire_timer] != 0) DestroyBonfire(playerid);
    DeletePlayerAirBalloon(playerid);
    UpdateFamilyLabel(playerid, false);
    PlayerPame_Update(playerid, false);
    ClearPlayerMarketUse(playerid);
    BJ_OnPlayerDisconnect(playerid);

    if(p_temp[playerid][rob_house_idx] != -1)
    {
        new idx = p_temp[playerid][rob_house_idx];
        for(new i = 0; i < MAX_ROBBERY_HOUSE_PLAYER; i++)
        {
            if(RobberyHouseContract[idx][rhcPlayerID][i] == playerid)
            {
                RobberyHouseContract[idx][rhcPlayerID][i] = INVALID_PLAYER_ID;
                RobberyHouseContract[idx][rhcSkin][i] = 0;
            }
        }
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL, "[ROBBERY] %s [%d] не в игре.", get_name(playerid), playerid);
        SendRobberyHouseMessage(idx, 0xDEB887FF, STRING_GLOBAL);
    }

    if(p_temp[playerid][rob_bank_idx] != -1)
    {
        new idx = p_temp[playerid][rob_bank_idx];
        for(new i = 0; i < MAX_ROBBERY_BANK_PLAYER; i++)
        {
            if(RobberyBankContract[idx][rbcPlayerID][i] == playerid)
            {
                RobberyBankContract[idx][rbcPlayerID][i] = INVALID_PLAYER_ID;
            }
        }
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL, "[ROBBERY] %s [%d] не в игре.", get_name(playerid), playerid);
        SendRobberyBankMessage(idx, 0xDEB887FF, STRING_GLOBAL);
    }

    if(p_temp[playerid][rob_fuel_idx] != -1)
    {
        new idx = p_temp[playerid][rob_fuel_idx];
        for(new i = 0; i < MAX_ROBBERY_FUEL_PLAYER; i++)
        {
            if(RobberyFuelContract[idx][rfcPlayerID][i] == playerid)
            {
                RobberyFuelContract[idx][rfcPlayerID][i] = INVALID_PLAYER_ID;
            }
        }
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL, "[ROBBERY] %s [%d] не в игре.", get_name(playerid), playerid);
        SendRobberyFuelMessage(idx, 0xDEB887FF, STRING_GLOBAL);
    }

    if(p_temp[playerid][freelance_idx] != -1)
    {
        new idx = p_temp[playerid][freelance_idx];
        if(FreelanceContract[idx][fcAccountID] == p_info[playerid][ID]) FreelanceContract[idx][fcOwnerID] = INVALID_PLAYER_ID;
    }

    if(p_temp[playerid][GunFactoryLocat])
    {
        GunFactoryWorkTableStat[p_temp[playerid][GunFactoryLocat]-1] = false;
        p_temp[playerid][GunFactoryLocat] = 0;
    }

    if(p_temp[playerid][RailwayLocat])
    {
        RailwayWorkTableStat[p_temp[playerid][RailwayLocat]-1] = false;
        p_temp[playerid][RailwayLocat] = 0;
    }

    new sparring_id = p_temp[playerid][SparringID];
    if(sparring_id != -1)
    {
        if(SparringData[sparring_id][sRound] == 0) CancelSparring(sparring_id);
        else
        {
            new i = SparringData[sparring_id][sPlayerID][0] == playerid ? 1 : 0;
            SparringData[sparring_id][sCount][i] = 100500;
            EndSparring(sparring_id);
        }
    }

    if(p_temp[playerid][h_repair_txtid] != -1)
        OnHouseMappingBack(playerid, GetPlayerHouseID(playerid), p_temp[playerid][h_repair_txtid], p_temp[playerid][h_repair_old], 3);

    if(p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID)
    {
        new vehicleid = p_temp[playerid][rented_veh];
        if(IsPlayerRentedVehicle(playerid, vehicleid))
        {
            DestroyVehicleVEx(vehicleid);
            if(veh_info[vehicleid][v_temp_job])
            {
                veh_info[vehicleid][v_temp_job] = 0;
                new scdplayerid = veh_info[vehicleid][v_used_key_ID];
                if(scdplayerid != INVALID_PLAYER_ID) EndPlayerJob(scdplayerid);
            }
            veh_info[vehicleid][v_rented_ID] = INVALID_MYSQL_ID;
            veh_info[vehicleid][v_used_key_ID] = INVALID_PLAYER_ID;
        }
        p_temp[playerid][rented_veh] = INVALID_VEHICLE_ID;
    }

    if( p_temp[playerid][hospital_bed_id] != -1)
        ClearHospitalBed(playerid);

    if(p_temp[playerid][calling] != INVALID_PLAYER_ID)
    {
        SendError(p_temp[playerid][calling], "Игрок не найден.");
        callcmd::h(playerid, "/0");
    }

    if(DriveTime[playerid] >= 0)
    {
        GangZoneHideForPlayer(playerid, Zone_Drive);
        if(DriveAuto[playerid] != INVALID_VEHICLE_ID) DestroyVehicleVEx(DriveAuto[playerid]);
        DriveAuto[playerid] = INVALID_VEHICLE_ID;
        DriveTime[playerid] = -1;
    }

    p_info[playerid][time_exit_game] = timestamp;
    new player_state = GetPlayerState(playerid);
    if(player_state != PLAYER_STATE_SPECTATING && player_state != PLAYER_STATE_WASTED &&
        //p_info[playerid][p_countUseCheat] == 0 &&
        (GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0)
        && p_info[playerid][loggedIn] != 0 && RegisterDerby[playerid] == 0 &&
        RegisterPaintBall[playerid] == 0 && p_temp[playerid][cossack_robbers_register] == 0 &&
        player_lobby_status[playerid] == false &&
        p_temp[playerid][DuelID] == INVALID_PLAYER_ID && p_temp[playerid][death_status] == 0 &&
        _:p_temp[playerid][pos_Y] == 0 && _:p_temp[playerid][pos_Z] == 0)
    {
        GetPlayerPos(playerid, p_info[playerid][spawn_pos_x], p_info[playerid][spawn_pos_y], p_info[playerid][spawn_pos_z]);
        if(p_info[playerid][spawn_pos_z] < 0.3) 
            p_info[playerid][spawn_pos_z] = 0.3;
        GetPlayerFacingAngle(playerid, p_info[playerid][spawn_pos_r]);
        
    }
    else
    {
        p_info[playerid][spawn_pos_x] =
        p_info[playerid][spawn_pos_y] =
        p_info[playerid][spawn_pos_z] = 0.0;
    }

    DestroyTheftCarVehicle(playerid);
    ClearTheftCar(playerid, TYPE_THEFT_CAR_VEHICLE);
    ClearPlayerHunting(playerid, HUNTING_TYPE_CLEAR_FINISH);

    new playerSpectatorId = pSpectatorId[playerid];
    if(playerSpectatorId != INVALID_PLAYER_ID)
        UpdateSpectatingStatus(playerSpectatorId, playerid);

    if(GetPVarInt(playerid,"BoneStol_ID"))
        ExitBone(playerid, GetPVarInt(playerid,"BoneStol_ID") - 1, 1);
    
    new duel_id = p_temp[playerid][DuelID];
    if(duel_id != INVALID_PLAYER_ID)
    {
        if(DuelData[duel_id][dGameState] == 0)
            ClearDuel(duel_id, playerid);
        if(DuelData[duel_id][dGameState] == 1)
        {
            new duel_command[2];
            for(new i; i < 10; i++)
            {
                if(DuelData[duel_id][dCommand1][i] == playerid)
                {
                    p_temp[DuelData[duel_id][dCommand1][i]][DuelID] = INVALID_PLAYER_ID;
                    DuelData[duel_id][dCommand1][i] = INVALID_PLAYER_ID;
                }
                if(DuelData[duel_id][dCommand2][i] == playerid)
                {
                    p_temp[DuelData[duel_id][dCommand2][i]][DuelID] = INVALID_PLAYER_ID;
                    DuelData[duel_id][dCommand2][i] = INVALID_PLAYER_ID;
                }
                if(DuelData[duel_id][dCommand1][i] != INVALID_PLAYER_ID) duel_command[0]++;
                if(DuelData[duel_id][dCommand2][i] != INVALID_PLAYER_ID) duel_command[1]++;
            }
            if(!duel_command[0] || !duel_command[1])
            {
                if(!duel_command[0]) {
                    DuelData[duel_id][dGameCommand1Kill] = -1;
                    DuelData[duel_id][dGameRound] = DuelData[duel_id][dRound]+1;
                }
                if(!duel_command[1])
                {
                    DuelData[duel_id][dGameCommand2Kill] = -1;
                    DuelData[duel_id][dGameRound] = DuelData[duel_id][dRound]+1;
                }
                for(new i; i < 10; i++)
                {
                    if(DuelData[duel_id][dCommand1][i] != INVALID_PLAYER_ID)
                    {
                        if(GetPlayerState(DuelData[duel_id][dCommand1][i]) == PLAYER_STATE_SPECTATING) TogglePlayerSpectating(DuelData[duel_id][dCommand1][i], 0);
                        else if(GetPlayerState(DuelData[duel_id][dCommand1][i]) == PLAYER_STATE_ONFOOT) SpawnPlayer(DuelData[duel_id][dCommand1][i]);
                    }
                    if(DuelData[duel_id][dCommand2][i] != INVALID_PLAYER_ID) {
                        if(GetPlayerState(DuelData[duel_id][dCommand2][i]) == PLAYER_STATE_SPECTATING) TogglePlayerSpectating(DuelData[duel_id][dCommand2][i], 0);
                        else if(GetPlayerState(DuelData[duel_id][dCommand2][i]) == PLAYER_STATE_ONFOOT) SpawnPlayer(DuelData[duel_id][dCommand2][i]);
                    }
                }
            }
        }
    }
    p_temp[playerid][DuelID] = INVALID_PLAYER_ID;

    EndExchange(playerid);
    maskOFF(playerid);
    OnPlayerLeaveFromMarket(playerid);
    UnloadUndergroundBots(playerid);

    if(RegisterRace[playerid])
    {
        RegisterRace[playerid] = 0;
        for(new i; i < MAX_RACE_PLAYERS; i++)
        {
            if(RacePlayers[i] == playerid)
            {
                RacePlayers[i] = INVALID_PLAYER_ID;
                if(RaceVehicles[i] != INVALID_VEHICLE_ID) DestroyVehicleVEx(RaceVehicles[i]);
                RaceVehicles[i] = INVALID_VEHICLE_ID;
            }
        }
    }
    if(RegisterDerby[playerid])
    {
        RegisterDerby[playerid] = 0;
        for(new i; i < MAX_DERBY_PLAYERS; i++)
        {
            if(DerbyPlayers[i] == playerid)
            {
                DerbyPlayers[i] = INVALID_PLAYER_ID;
                if(DerbyVehicles[i] != INVALID_VEHICLE_ID) DestroyVehicleVEx(DerbyVehicles[i]);
                DerbyVehicles[i] = INVALID_VEHICLE_ID;
            }
        }
    }
    if(RegisterPaintBall[playerid])
    {
        if(PaintBallLeaderID == playerid)
        {
            PaintBallLeaderID = INVALID_PLAYER_ID, PaintBallLeaderKills = 0;
        }
        RegisterPaintBall[playerid] = 0;
        PaintBallWeaponID[playerid] = 0;
        for(new i; i < MAX_PAINTBALL_PLAYERS; i++)
        {
            if(PaintBallPlayers[i] == playerid)
            {
                PaintBallPlayers[i] = INVALID_PLAYER_ID;
                break;
            }
        }
    }
    if(p_temp[playerid][cossack_robbers_register])
    {
        new team = p_temp[playerid][cossack_robbers_team];
        if(CossackRobbersLeaders[team] == playerid)
        {
            CossackRobbersLeaders[team] = INVALID_PLAYER_ID, CossackRobbersLeadersKills[team] = 0;
        }
        p_temp[playerid][cossack_robbers_register] = 0;
        p_temp[playerid][cossack_robbers_team] = 0;
        p_temp[playerid][cossack_robbers_kills] = 0;
        p_temp[playerid][cossack_robbers_deaths] = 0;
        p_temp[playerid][cossack_robbers_give] = 0.0;
        p_temp[playerid][cossack_robbers_take] = 0.0;
        for(new i = 0, x = 0; i < MAX_COSSACK_ROBBERS_TEAM; i++)
        {
            for(x = 0; x < MAX_COSSACK_ROBBERS_PLAYERS; x++)
            {
                if(CossackRobbersPlayers[i][x] == playerid)
                {
                    CossackRobbersPlayers[i][x] = INVALID_PLAYER_ID;
                    break;
                }
            }
        }
    }

    Iter_Remove(gFactionPlayers[p_info[playerid][member]], playerid);
    Iter_Remove(gJobPlayers[p_info[playerid][job]], playerid);
    Iter_Remove(gAdmins, playerid);

    if(GetPVarType(playerid, !"repair_mechanicId") == PLAYER_VARTYPE_INT)
    {
        new
            mechanic_id = GetPVarInt(playerid, !"repair_mechanicId");

        DeletePVar(playerid, !"repair_mechanicId");

        if(GetPVarType(playerid, !"repair_price") == PLAYER_VARTYPE_INT)
            DeletePVar(playerid, !"repair_price");

        SendError(mechanic_id, "Игрок не найден.");
        DeletePVar(playerid, !"repair_targetid_vehicleid");
    }

    ClearFish(playerid);
    ClearPlayerHunting(playerid, HUNTING_TYPE_CLEAR_FINISH);

    if(tipsterplayer == playerid)
    {
        SendFractionMessage(FBI_TEAM, 0x33CC66FF, "[F] Игрок вышел из игры. Жучок потерян.");
        tipsteron = -1;
        tipsterplayer = -1;
    }
    if(GetPVarInt(playerid, "report_id_to_answer"))
    {
        aReportInfo[GetPVarInt(playerid, "report_id_to_answer")][rIsTooked] = false;
    }
    if(GetPVarInt(playerid, "report_id")-1 != -1)
    {
        new report_id = GetPVarInt(playerid, "report_id")-1;

        aReportInfo[report_id][rID] = report_id;
        aReportInfo[report_id][rPlayerID] = INVALID_PLAYER_ID;
        aReportInfo[report_id][rText][0] = EOS;
        aReportInfo[report_id][rWhenWroted_Time] = -1;
        aReportInfo[report_id][rIsTooked] = false;
        aReportInfo[report_id][rWhenWroted_Text][0] = EOS;
    }
    if(GetPVarInt(playerid, "advert_id_to_sending"))
    {
        AdvertInfo[GetPVarInt(playerid, "advert_id_to_sending") - 1][aIsTooked] = false;
    }
    if(GetPVarInt(playerid,"Conv"))// если под конвоем был, оповещаем копа
    {
        DeletePVar(GetPVarInt(playerid,"Ved"), "Convoy");
        SendError(GetPVarInt(playerid,"Ved"), "Игрок умер.");
        SendInfo(GetPVarInt(playerid,"Ved"), "Конвой завершен.");
        SetPVarInt(playerid,"Ved",0);
        SetPVarInt(playerid,"Conv",0);
        ClearAnimations(playerid);
    }
    if(GetPlayerState(playerid) == PLAYER_STATE_PASSENGER)
    {
        new vehicleid = GetPlayerVehicleID(playerid);
        foreach(new i: Player) // TODO: лютый пиздец, исправить(!)
        {
            if(!p_info[i][loggedIn]) continue;
            if(IsPlayerInVehicle(i, vehicleid) && GetPlayerState(i) == 2 && ((veh_info[vehicleid][v_job] == JOB_TC_TAXI && IsPlayerOwnerVehicle(i, vehicleid)) || veh_info[vehicleid][v_npoType] == NPO_JOB && veh_info[vehicleid][v_npoId] == JOB_TC_TAXI) && p_temp[i][Work_ID] == TAXI_WORK)
            {
                if(GetPVarInt(i,"@passenger")-1 == playerid)
                {
                    if(!IsPlayerOwnerVehicle(i, vehicleid) && IsPlayerInRangeOfPoint(playerid, 100.0, p_temp[playerid][TaxiFix][0], p_temp[playerid][TaxiFix][1], p_temp[playerid][TaxiFix][2]) == 0 && p_info[playerid][TaxiTime] < timestamp)
                    {
                        p_info[playerid][TaxiTime] = timestamp + 180;
                        UpdatePlayerWorkSkill(i, 8);

                        CheckPlayerMission(i, START_TAXI);
                        CheckPlayerMission(i, DAILY_TAXI);
                        CheckPlayerMission(i, ACHIEVEMENT_TAXI);

                        CheckPlayerFreelance(i, FREELANCE_TAXI);
                        CheckPlayerBattlePass(i, BATTLEPASS_TAXI);

                        UpdateFamilyLevel(i);
                        UpdateFamilyContract(i, CONTRACT_FAMILY_ID_TAXI); // Контракты: Водитель такси
                    }

                    if(p_info[playerid][cash] >= floatround(p_temp[i][taxi_zp]))
                    {
                        SetPlayerMoney(playerid, -floatround(p_temp[i][taxi_zp]), true, "проезд в такси");

                        if(GetPVarInt(i,"PayDayCashJob") > timestamp) {}
                        else
                        {
                            new reason_money = GetPlayerMoneySkill(i, GetBizPercent(i, TYPE_TC_TAXI, floatround(p_temp[i][taxi_zp])), 8);
                            SetPlayerMoney(i, reason_money, false, "зарплата таксиста");
                            OnServerInfoForMoney[17] += reason_money;
                            SetPVarInt(i,"PayDayCashJob",timestamp + 30);
                            TransferBizMoney(i, TYPE_TC_TAXI, p_temp[i][fix_bug_biz_tc_salary]);
                        }
                    }
                    else
                    {
                        SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                        SendError(i, "У игрока нет столько денег.");
                    }

                    p_temp[i][fix_flood] = INVALID_PLAYER_ID;
                    SendInfo(i, "Пассажир вышел из транспортного средства.");

                    p_temp[i][taxi_zp] = 0.0;
                    p_temp[i][taxi_enter] = 0;
                    DeletePVar(i,"@passenger");

                    foreach(new id: Player)
                    {
                        if(IsPlayerInVehicle(id, vehicleid) && id != i && id != playerid)
                        {
                            SendInfo(i, "%s [%d] сел в Ваше такси.", get_name(id), id);
                            //SendInfo(i, "Довезите игрока и поездка будет оплачена государством.");

                            p_temp[i][taxi_enter] = timestamp + 120;

                            SetPVarInt(i,"@passenger",id+1);
                            SetPVarInt(i,"@passenger_count",GetPVarInt(i,"@passenger_count")+1);
                            break;
                        }
                    }
                }
            }
        }
    }

    if(p_temp[playerid][chase_targetId] != INVALID_PLAYER_ID)
    {
        new targetID = p_temp[playerid][chase_targetId];
        p_temp[playerid][chase_targetId] =
        p_temp[targetID][chase_followerId] = INVALID_PLAYER_ID;

        if(IsPlayerConnected(targetID))
        {
            SendAccess(playerid, "Вы прекратили погоню за %s [%d].", get_name(targetID), targetID);
            SendInfo(targetID, "%s [%d] прекратил погоню за Вами.", get_name(playerid), playerid);
        }

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] прекратил погоню за %s [%d].", get_name(playerid), playerid, get_name(targetID), targetID);
        SendFractionMessage(POLICE_LS, 0x33CC66FF, STRING_GLOBAL);
        SendFractionMessage(POLICE_SF, 0x33CC66FF, STRING_GLOBAL);
        SendFractionMessage(POLICE_LV, 0x33CC66FF, STRING_GLOBAL);
        SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);
    }

    if(p_temp[playerid][chase_followerId] != INVALID_PLAYER_ID)
    {
        new followerId = p_temp[playerid][chase_followerId];
        p_temp[playerid][chase_followerId] =
        p_temp[followerId][chase_targetId] = INVALID_PLAYER_ID;
        

        if(IsPlayerConnected(followerId))
        {
            DisablePlayerCheckpoint(followerId);
            SendInfo(followerId, "Игрок вышел из игры.");
        }

        p_info[playerid][jail_time] += (600 * p_info[playerid][wanted]) + 300;
        if(p_info[playerid][jail_time] <= 1200) p_info[playerid][jail] = random(3) + 1;
        else p_info[playerid][jail] = 5;
        p_info[playerid][wanted] = 0;

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] выход при приследовании (+5 мин. к заключению).", get_name(playerid), playerid);
        SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
        SendFractionMessage(POLICE_LS, 0x33CC66FF, STRING_GLOBAL);
        SendFractionMessage(POLICE_SF, 0x33CC66FF, STRING_GLOBAL);
        SendFractionMessage(POLICE_LV, 0x33CC66FF, STRING_GLOBAL);
        SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);
    }

    if(GetPVarInt(playerid,"PlayerCuffed") == 1) //выход при арресте
    {
        p_info[playerid][jail_time] += (600 * p_info[playerid][wanted]) + 600;
        if(p_info[playerid][jail_time] <= 1200) p_info[playerid][jail] = random(3) + 1;
        else p_info[playerid][jail] = 5;
        p_info[playerid][wanted] = 0;

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] выход при аресте (+10 мин. к заключению).", get_name(playerid), playerid);
        SendFractionMessage(POLICE_LS, 0x33CC66FF, STRING_GLOBAL);
        SendFractionMessage(POLICE_SF, 0x33CC66FF, STRING_GLOBAL);
        SendFractionMessage(POLICE_LV, 0x33CC66FF, STRING_GLOBAL);
        SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);
    }
    UnLoadPlayerVehicle(playerid);

    if(player_lobby_status[playerid] == true && player_lobby_idx[playerid] != -1)
    {
        OnPlayerLeaveLobby(playerid, player_lobby_idx[playerid], "Выход из игры.");
    }

    if(p_temp[playerid][billboard_status] == true)
    {
        p_temp[playerid][billboard_status] = false;
        p_temp[playerid][billboard_timer] = 0;
    }
    count_player--;
    Logotype_SetOnline();

    ClearPlayerCreateBoxInfo(playerid);

    // Save Accounts: Exit Server
    if(p_info[playerid][loggedIn] != 0)
    {
        save_player(playerid);
        p_info[playerid][online] = 0;
        MysqlUpdatePlayerInt(playerid, "online", p_info[playerid][online]);
    }
    /*
    new year,month,day;
    getdate(year, month, day);
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `online` = 0, `lastenter` = '%02d/%02d/%04d' WHERE `id` = %d", day, month, year, p_info[playerid][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL);
    */

    // Ivan_Ivanov[1](127.0.0.1 PC/0.3.7-R2) отключился от сервера (<причина>)
    // [logs] реализовать получение версии клиента
    // [logs] добавить логирование инфы о количестве: денег, FM, домов, ТС, скинов, оружия и тд
    
    new Logger:logger_id;
    if(p_info[playerid][loggedIn]) logger_id = LOG_player;
    else logger_id = LOG_connect;

    new szDisconnectReason[5][] =
    {
        "Таймаут/Вылет",
        "Выход(/q)",
        "Кик",
        "Предупреждение",
        "Бан"
    };
    new game_time = timestamp-p_temp[playerid][time_auth];
    if(p_temp[playerid][dissconect_id] == -1)
    {
        Log(logger_id, INFO, "%s[%d](%s %s) отключился от сервера %s отыграв (%s)<%d>",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", szDisconnectReason[reason], ConvertTime(game_time), game_time);
    }
    else
    {
        reason = p_temp[playerid][dissconect_id];
        if(reason >= 3000)
        {
            Log(logger_id, INFO, "%s[%d](%s %s) отключился от сервера <Античит - %d> отыграв (%s)<%d>", get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_temp[playerid][dissconect_id], ConvertTime(game_time), game_time);
        }
        else
        {
            reason = DISSCONNECT_ID_KICK_or_BAN+p_temp[playerid][dissconect_id];
            if(reason > 3000) return print("bagulya kek");
            Log(logger_id, INFO, "%s[%d](%s %s) отключился от сервера <Администрация - %s> отыграв (%s)<%d>", get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", szDisconnectReason[reason], ConvertTime(game_time), game_time);
        }
    }

    if(p_temp[playerid][is_doss_attack]) Log(LOG_connect, INFO, "ID: <%d> | IP: %s | DISCONNECT", playerid, p_temp[playerid][session_IP]);
    p_info[playerid][ID] = -1;
    return 1;
}

PayDay(i)
{
    if(!IsPlayerConnected(i)) return 1;
    if(p_info[i][loggedIn] != 1) return 1;

    if(GetPlayerDisease(i, 0, 10, 5) == 1) // Шанс 50 процентов;
    {
        p_info[i][Disease][0]++;
        SendInfo(i, "У Вас появилось новое заболевание - ОРВИ %d степени.", p_info[i][Disease][0]);
    }

    if(p_info[i][Disease][1] == 3 && GetPlayerDisease(i, 4, 10, 2) == 1) // Шанс 20 процентов;
    {
        p_info[i][Disease][4]++;
        SendInfo(i, "У Вас появилось новое заболевание - Рак желудка %d степени.", p_info[i][Disease][4]);
    }

    if(p_info[i][Disease][2] > 0 && GetPlayerDisease(i, 5, 10, 1) == 1) // Шанс 10 процентов;
    {
        p_info[i][Disease][5]++;
        SendInfo(i, "У Вас появилось новое заболевание - Туберкулез %d степени.", p_info[i][Disease][5]);
    }

    p_temp[i][CaptureBizWarInfoInt][0] = 0;
    p_temp[i][CaptureBizWarInfoInt][1] = 0;
    p_temp[i][CaptureBizWarInfoFloat][0] = 0.0;
    p_temp[i][CaptureBizWarInfoFloat][1] = 0.0;

    for(new j = MAX_SERVER_WORK-1; j != -1; j--) p_info[i][job_skill_salary][j] = 0;

    if(p_info[i][passport] != 0 && p_info[i][passport_time] != 0)
    {
        p_info[i][passport_time]--;
        if(p_info[i][passport_time] == 0)
        {
            SendInfo(i, "Срок действия Вашего паспорта истек.");

            p_info[i][passport] = 0;
            p_info[i][passport_time] = 0;
        }
    }
    if(p_info[i][med_card] != 0 && p_info[i][med_card_time] != 0)
    {
        p_info[i][med_card_time]--;
        if(p_info[i][med_card_time] == 0)
        {
            SendInfo(i, "Срок действия Вашей мед. карты истек.");

            p_info[i][med_card] = 0;
            p_info[i][med_card_time] = 0;
        }
    }

    CheckLicense(i);

    p_info[i][payday_oil_count] = 0;

    new
        checks,
        Float:check_deposit,
        deposit,
        pension,
        reason_money,
        inv_items,
        idx,
        count;

    if(p_info[i][p_time_payday] >= 1200)
    {
        if(p_info[i][level] <= 3 && ServerInfo[Experian] < 2) idx = 2;
        else idx = ServerInfo[Experian];

        if(p_info[i][p_vip])
        {
            count = p_info[i][p_vip] + 1;
            if(p_info[i][p_vip] == 3 && p_info[i][p_add_vip] == 1) count = 5;
        }

        p_info[i][exp] += idx + count;

        if(p_info[i][p_vip] && p_info[i][jail_time] == 0)
        {
            if(p_info[i][p_vip] == 3 && p_info[i][p_add_vip] == 1) count--;
            p_info[i][flinmoney] += count;
        }

        PlayerLevelUpdateCheck(i);

        if(p_info[i][check_active_time] >= 300)
        {
            CheckPlayerMission(i, DAILY_PAYDAY);
            CheckPlayerMission(i, ACHIEVEMENT_PAYDAY);
        }

        if(p_info[i][wanted] >= 1) p_info[i][wanted]--;

        // Если (игрок в фракции И начал рабочий день) ИЛИ состоит в криминале (иначе говоря не гражданский) то считаем ему зп:
        if(((p_info[i][member] != 0 && p_info[i][fwork] == true)) && p_info[i][admin] == 0 && p_info[i][check_active_time] >= 300)
        {
            reason_money = gang(i) ? (GetGangTerritory(p_info[i][member]) * 100) + (GetGangGraffiti(p_info[i][member]) * 50) + GetFractionPay(i) : GetFractionPay(i);

            if(ServerInfo[Salary] != 1) reason_money = reason_money * ServerInfo[Salary];
            else
            {
                if(p_info[i][p_vip])
                {
                    if(p_info[i][p_vip] == 3 && p_info[i][p_add_vip] == 1) reason_money = reason_money * 3;
                    else
                    {
                        switch(p_info[i][p_vip])
                        {
                            case 1: reason_money += (reason_money / 100) * 25;
                            case 2: reason_money += (reason_money / 100) * 50;
                            case 3: reason_money += reason_money;
                        }
                    }
                }
            }

            if(p_info[i][fwarn] > 0) reason_money = (reason_money/100) * (100-(p_info[i][fwarn]*15));
            if(p_info[i][member] != 0 && p_info[i][fwork] == true && !gang(i) && !mafia(i) &&
                timestamp_hour >= 22 && timestamp_hour <= 8) reason_money += (reason_money/100) * 20;
            checks += reason_money;
        }
        if(p_info[i][admin] > 0)
        {
            checks += p_info[i][admin] * 10000;
            if(p_info[i][p_time_payday] >= 2400 && timestamp_hour >= 8 && timestamp_hour <= 22)
            {
                if(p_info[i][admin] < 6)
                    p_info[i][flinmoney] += p_info[i][admin] * 2;
                else
                    p_info[i][flinmoney] += 10;
            }
        }
        new family_idx = GetPlayerFamilyID(i);
        if(family_idx != -1 && p_info[i][family_id] != -1 && p_info[i][check_active_time] >= 300)
        {
            new family_salary = FamilyData[family_idx][fSalaryRang][p_info[i][family_rang]-1],
                bool:family_status = false;
            if(family_salary > 0)
            {
                if(FamilyData[family_idx][fMoney] >= family_salary)
                {
                    FamilyData[family_idx][fMoney] -= family_salary;
                    checks += family_salary;
                    family_status = true;
                }
                if(family_status == false) SendInfoMessage(i, "Вы не получили зарплату с семьи. Причина: недостаточно денег.");
            }
        }
        p_info[i][bank] += checks;
        OnServerInfoForMoney[8] += checks;

        if(timestamp_hour >= 6 && timestamp_hour <= 22)
        {
            check_deposit = deposit_percent;
            if(p_info[i][p_vip])
            {
                if(p_info[i][p_vip] == 3 && p_info[i][p_add_vip] == 1) check_deposit = check_deposit * 3;
                else
                {
                    switch(p_info[i][p_vip])
                    {
                        case 1: check_deposit = check_deposit + (check_deposit * 0.25);
                        case 2: check_deposit = check_deposit + (check_deposit * 0.50);
                        case 3: check_deposit = check_deposit * 2;
                    }
                }
            }
        }

        deposit = floatround(p_info[i][bank_deposit] * check_deposit);
        if(p_info[i][bank_deposit]+deposit > max_deposit)
        {
            p_info[i][bank_deposit] = max_deposit;
            SendInfo(i, "Депозит достиг своего придела снимите деньги, чтобы получать проценты.");
        }
        else p_info[i][bank_deposit] += deposit;

        OnServerInfoForMoney[33] += deposit;

        if(p_info[i][bank_deposit_limit_take]) p_info[i][bank_deposit_limit_take]--;

        if(p_info[i][level] >= 20 && p_info[i][bank_pension_status] == 1 && p_info[i][check_active_time] >= 300)
        {
            if(p_info[i][level] < 80) pension = 200 * (p_info[i][level] - 19);
            else pension = 12000;

            if(GetFractionWarehouse(MAYOR_LS, fwMoney) < pension)
            {
                pension = 0;
                SendInfo(i, "В казне штата нет денег для начисления пенсии.");
            }
            else
            {
                p_info[i][bank] += pension;
                OnServerInfoForMoney[34] += pension;

                SetFractionWarehouse(MAYOR_LS, fwMoney, -pension);
            }
        }

        p_info[i][p_time_payday] = 0;

        if(p_info[i][level] >= 3 && p_info[i][check_active_time] >= 300)
        {
            if(p_info[i][p_vip])
            {
                if(p_info[i][p_vip] == 3 && p_info[i][p_add_vip] == 1) inv_items = 5;
                else inv_items = p_info[i][p_vip] + 1;
            }
            GivePlayerInventory(i, 641, inv_items);
            if(GetPlayerFamilyID(i) != -1 && p_info[i][family_id] != -1)
                GivePlayerInventory(i, 645, inv_items);
        }

        #if GIFT_STATUS == 1
            if(p_info[i][level] >= 3) GivePlayerInventory(i, 894, 1);
        #endif

        if(p_info[i][level] >= 5 && random(2) == 0)
        {
            if(p_info[i][member])
            {
                if(gos(i) || GetFactionType(p_info[i][member]) == FACTION_TYPE_SNN) GivePlayerCasket(i, 718);
                if(gang(i) || mafia(i) || biker(i)) GivePlayerCasket(i, 719);
            }
            if(GetPlayerFamilyID(i) != -1 && p_info[i][family_id] != -1) GivePlayerCasket(i, 723);
        }
        if(p_info[i][p_vip] == 3 && p_info[i][p_add_vip] == 1) GivePlayerCasket(i, -1);

        if((p_info[i][member] == MEDIC_LS || p_info[i][member] == MEDIC_SF || p_info[i][member] == MEDIC_LV) && p_info[i][rang] >= 3)
        {
            GivePlayerInventory(i, 683, 1);
        }

        GivePlayerPropertyPayDay(i);

        if(p_info[i][billet_cop] != 1 && (GetFactionCategory(p_info[i][member]) == FACTION_CATEGORY_PD ||
            GetFactionCategory(p_info[i][member]) == FACTION_CATEGORY_PD))
        {
            if(++p_info[i][billet_exp] >= 24)
            {
                p_info[i][billet_exp] = 0;
                p_info[i][billet_cop] = 1;
                SendAccess(i, "Поздравляем, Вы получили полицейский билет.");
            }
        }
        if(p_info[i][billet_army] != 1 && GetFactionCategory(p_info[i][member]) == FACTION_CATEGORY_ARMY)
        {
            if(++p_info[i][billet_exp] >= 24)
            {
                p_info[i][billet_exp] = 0;
                p_info[i][billet_army] = 1;
                SendAccess(i, "Поздравляем, Вы получили военный билет.");
            }
        }

        if(p_info[i][escape_limit]) p_info[i][escape_limit]--;
        if(p_info[i][commit_a_robbery]) p_info[i][commit_a_robbery]--;
        if(p_info[i][robbed]) p_info[i][robbed]--;
    }
    else SendError(i, "Чтобы получить зарплату, необходимо отыграть на сервере 20 минут.");
    SendMes(i, 0xDDA701FF, "---=== [ Выписка из банка San Andreas ] ===---");
    SendMes(i, 0xA3A3A3FF, "Заработано: "W"$%d.", checks);
    SendMes(i, 0xA3A3A3FF, "На банк. счете: "W"$%d.", p_info[i][bank]);
    if(p_info[i][bank_deposit]) SendMes(i, 0xA3A3A3FF, "Банковский вклад: "W"$%d.", p_info[i][bank_deposit]);
    if(p_info[i][bank_pension_status]) SendMes(i, 0xA3A3A3FF, "Пенсия: "W"$%d.", pension);
    SendMes(i, 0xA3A3A3FF, "Время: "W"%02d:%02d.", timestamp_hour, timestamp_minute);
    SendMes(i, 0xDDA701FF, "==============================================");

    if(p_info[i][med_insurance] == 1)
    {
        if(p_info[i][med_insurance_time] > 0) p_info[i][med_insurance]--;
        if(p_info[i][med_insurance_time] <= 0)
        {
            p_info[i][med_insurance] = 0;
            SendInfo(i, "У Вас закончилось мед. страхование.");
        }
    }

    if(p_info[i][check_active_time] < 300)
    {
        SendInfo(i, "Вы проявляли мало активности за этот час, Вам не начислена:");
        SendInfo(i, "зарплата, пенсия и депозит. Кроме этого, Вам не засчитано:");
        SendInfo(i, "ежедневное задание - отыграть 4 часа и достижение - отыграть 360 часов.");
        SendInfo(i, "Помимо всего вышеперечисленного, Вам не выдана гражданская и семейная монета.");
    }

    p_info[i][check_active_time] = 0;

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL),
        "UPDATE `accounts` SET `bank` = %d, `bank_deposit` = %d, `bank_deposit_limit_take` = %d, \
        `billet_army` = %d,  `billet_cop` = %d, `billet_exp` = %d, `passport` = %d, `passport_time` = %d, \
        `Lic` = '%i|%i|%i|%i|%i|%i|%i|%i|%i', `Lic_Warn` = '%i|%i|%i|%i|%i|%i|%i|%i|%i', `Lic_Time` = '%i|%i|%i|%i|%i|%i|%i|%i|%i', \
        `job_skill_salary_new` = '%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d', `payday_oil_count` = %d, `flinmoney` = %d WHERE `id` = %d",
    p_info[i][bank], p_info[i][bank_deposit], p_info[i][bank_deposit_limit_take],
    p_info[i][billet_army], p_info[i][billet_cop], p_info[i][billet_exp], p_info[i][passport], p_info[i][passport_time],
    p_info[i][Lic][LIC_CAR], p_info[i][Lic][LIC_MOTO], p_info[i][Lic][LIC_BOAT], p_info[i][Lic][LIC_PLANE],
    p_info[i][Lic][LIC_WEAPON], p_info[i][Lic][LIC_FISHING], p_info[i][Lic][LIC_HUNTER], p_info[i][Lic][LIC_TAXI], p_info[i][Lic][LIC_LAWYER],
    p_info[i][Lic_Warn][LIC_CAR], p_info[i][Lic_Warn][LIC_MOTO], p_info[i][Lic_Warn][LIC_BOAT], p_info[i][Lic_Warn][LIC_PLANE], p_info[i][Lic_Warn][LIC_WEAPON],
    p_info[i][Lic_Warn][LIC_FISHING], p_info[i][Lic_Warn][LIC_HUNTER], p_info[i][Lic_Warn][LIC_TAXI], p_info[i][Lic_Warn][LIC_LAWYER], p_info[i][Lic_Time][LIC_CAR],
    p_info[i][Lic_Time][LIC_MOTO], p_info[i][Lic_Time][LIC_BOAT], p_info[i][Lic_Time][LIC_PLANE], p_info[i][Lic_Time][LIC_WEAPON], p_info[i][Lic_Time][LIC_FISHING],
    p_info[i][Lic_Time][LIC_HUNTER], p_info[i][Lic_Time][LIC_TAXI], p_info[i][Lic_Time][LIC_LAWYER],
    p_info[i][job_skill_salary][0], p_info[i][job_skill_salary][1], p_info[i][job_skill_salary][2], p_info[i][job_skill_salary][3], p_info[i][job_skill_salary][4],
    p_info[i][job_skill_salary][5], p_info[i][job_skill_salary][6], p_info[i][job_skill_salary][7], p_info[i][job_skill_salary][8], p_info[i][job_skill_salary][9],
    p_info[i][job_skill_salary][10], p_info[i][job_skill_salary][11], p_info[i][job_skill_salary][12], p_info[i][job_skill_salary][13], p_info[i][job_skill_salary][14],
    p_info[i][job_skill_salary][15], p_info[i][job_skill_salary][16], p_info[i][job_skill_salary][17], p_info[i][job_skill_salary][18], p_info[i][job_skill_salary][19],
    p_info[i][job_skill_salary][20], p_info[i][job_skill_salary][21], p_info[i][job_skill_salary][22], p_info[i][payday_oil_count], p_info[i][flinmoney], p_info[i][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL);
    return 1;
}

CMD:goreg(playerid)
{
    SetPlayerPos(playerid, 2404.1870,1554.4166,43.8807);
    return 1;
}

forward FixObjectAuthorization(playerid);
public FixObjectAuthorization(playerid)
{
    if(p_info[playerid][loggedIn]) return 1;
    Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
    if(IsPlayerMobile(playerid))
    {
        SetPlayerCameraPos(playerid, 2402.652099, 1558.192504, 43.922470);
        SetPlayerCameraLookAt(playerid, 2401.405029, 1553.350708, 43.884616);
    }
    else
    {
        SetPlayerCameraPos(playerid, 2404.197265, 1557.408081, 44.273761);
        SetPlayerCameraLookAt(playerid, 2402.134033, 1552.859008, 44.051177);
    }
    ApplyAnimationFix(playerid, "ON_LOOKERS","wave_loop", 4.1);
    return 1;
}

public OnPlayerSpawn(playerid)
{
    if(GetPVarInt(playerid, #PLAYER_CONNECT))
    { // authorization
        SendInfo(playerid, "Добро пожаловать на сервер "I""SERVER""W" [Server: "I"%02d"W"].", SRV_ID);
        if(SRV_ID) PlayerPlaySound(playerid, 1097, 0.0, 0.0, 0.0);

        SetPlayerPos(playerid, 2404.1870,1554.4166,43.6807);
        SetPlayerFacingAngle(playerid, 20.2419);
        SetPlayerVirtualWorld(playerid, playerid+1001);
        SetPlayerInterior(playerid, 0);

        Streamer_Update(playerid, STREAMER_TYPE_OBJECT);

        if(IsPlayerMobile(playerid))
        {
            SetPlayerCameraPos(playerid, 2402.652099, 1558.192504, 43.922470);
            SetPlayerCameraLookAt(playerid, 2401.405029, 1553.350708, 43.884616);
        }
        else
        {
            SetPlayerCameraPos(playerid, 2404.197265, 1557.408081, 44.273761);
            SetPlayerCameraLookAt(playerid, 2402.134033, 1552.859008, 44.051177);
        }
        if(19 <= timestamp_hour <= 23) SetPlayerTime(playerid, 13, 0);

        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id`, `password`, `google_code`,  `google_auth`, `vk_userid`, `vk_confirmed`, `vk_auth`, `tg_userid`, `tg_confirmed`, `tg_auth`, `lastip`, `lastUID`, `usepassword`, `sex`, `member`, `fwork`, `fskin`, `inv_slots`, `family_id`, `family_rang`, `costume`, `costume_use` FROM `accounts` WHERE `name` = '%e' LIMIT 1", get_name(playerid));
        mysql_pquery(con_bd, STRING_GLOBAL, "FindPlayerAccount", "iis", playerid, p_temp[playerid][session_PORT], p_temp[playerid][session_IP]);

        DeletePVar(playerid, #PLAYER_CONNECT);
        ApplyAnimationFix(playerid, "ON_LOOKERS","wave_loop", 4.1);
        SetTimerEx("FixObjectAuthorization", 750, false, "i", playerid);
        Fix_TogglePlayerControllable(playerid, false);
        return 1;
    }
    if(!p_info[playerid][loggedIn]) return 1;
    //DamageFeedUpdate(playerid);
    if(p_temp[playerid][army_post] != -1) Post_System_LeaveArea(playerid, p_temp[playerid][army_post]);
    PlayerPlaySound(playerid, 1184, 0.0, 0.0, 0.0);
    SetCameraBehindPlayer(playerid);

    if(pSpectatorId[playerid] != INVALID_PLAYER_ID)
        UpdateSpectatingStatus(pSpectatorId[playerid], playerid);

    if(pSpectateId[playerid] != INVALID_PLAYER_ID)
    {
        pSpectatorId[pSpectateId[playerid]] = INVALID_PLAYER_ID;
        pSpectateId[playerid] = INVALID_PLAYER_ID;
    }

    new playerSpectatorId = pSpectatorId[playerid];
    if(playerSpectatorId != INVALID_PLAYER_ID)
        UpdateSpectatingStatus(playerSpectatorId, playerid);

    if( p_temp[playerid][sitdown_id] != -1 && p_temp[playerid][sitdown_place] != -1 &&
        SitDown_Data[p_temp[playerid][sitdown_id]][sd_Status][p_temp[playerid][sitdown_place]] == playerid)
        SitDown_Clear(playerid, p_temp[playerid][sitdown_id], p_temp[playerid][sitdown_place]);

    if(p_info[playerid][pstyle][0]) SetPlayerFightingStyle(playerid, p_info[playerid][pstyle][0]);
    else SetPlayerFightingStyle(playerid, 4);

    SetPlayerHealth(playerid,70+random(30)); // Выдача жизни 20+ рандом от 0 до 30

    EndExchange(playerid);
    if(p_temp[playerid][h_repair_txtid] != -1)
        OnHouseMappingBack(playerid, GetPlayerHouseID(playerid), p_temp[playerid][h_repair_txtid], p_temp[playerid][h_repair_old], 1);

    ExitSlotMachine(playerid);
    Durak_LeaveTable(playerid);
    EndBones(playerid); // конец игры /dice
    ClearFish(playerid);
    ClearPlayerHunting(playerid, HUNTING_TYPE_CLEAR_FINISH);

    if(p_temp[playerid][Work_ID] != NONE_WORK) EndPlayerJob(playerid, 1);

    if(p_temp[playerid][billboard_status] == true)
    {
        p_temp[playerid][billboard_status] = false;
        p_temp[playerid][billboard_timer] = 0;
    }
    if(p_info[playerid][pHealth] <= 2) p_info[playerid][pHealth] = 50+random(30);
    SetPlayerHealth(playerid, p_info[playerid][pHealth]);
    // ----------------------- SPAWN SELECT --------------------------
    new sparring_id = p_temp[playerid][SparringID];
    if(sparring_id != -1)
    {
        if(SparringData[sparring_id][sRound] == 0) CancelSparring(sparring_id);
        else
        {
            if(SparringData[sparring_id][sRound] >= SparringData[sparring_id][sCountRound]) EndSparring(sparring_id);
            SparringData[sparring_id][sRound]++;
            StartSparringRound(sparring_id, SparringData[sparring_id][sRound]);
        }
        return 1;
    }
    
    new duelid = p_temp[playerid][DuelID];
    if(duelid != INVALID_PLAYER_ID && DuelData[duelid][dGameState] == 1)
    {
        if(DuelData[duelid][dGameRound] <= DuelData[duelid][dRound])
        {
            if(p_temp[playerid][dSpectateId] != INVALID_PLAYER_ID)
            {
                //SetPlayerPos(playerid, DuelSpawn[0][duel_map_id][0], DuelSpawn[0][duel_map_id][1], DuelSpawn[0][duel_map_id][2]);
                SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(p_temp[playerid][dSpectateId]));
                SetPlayerInterior(playerid, GetPlayerInterior(p_temp[playerid][dSpectateId]));
                TogglePlayerSpectating(playerid, 1);
                PlayerSpectatePlayer(playerid, p_temp[playerid][dSpectateId], SPECTATE_MODE_NORMAL);
                return 1;
            }
            else
            {
                new str[MAX_PLAYER_NAME], duel_map_id = DuelData[duelid][dMap];
                format(str, sizeof(str), "~r~Round %d/%d", DuelData[duelid][dGameRound], DuelData[duelid][dRound]);
                GameTextForPlayer(playerid, str, 1000, 3);
                for(new i; i < 10; i++)
                {
                    if(DuelData[duelid][dCommand1][i] == playerid)
                    {
                        if(DuelData[duelid][dGameRound]%2 == 0) // command 1
                        {
                            SetPlayerPos(DuelData[duelid][dCommand1][i], DuelSpawn[0][duel_map_id][0], DuelSpawn[0][duel_map_id][1], DuelSpawn[0][duel_map_id][2]);
                            SetPlayerFacingAngle(DuelData[duelid][dCommand1][i], DuelSpawn[0][duel_map_id][3]);
                        }
                        else
                        {
                            SetPlayerPos(DuelData[duelid][dCommand1][i], DuelSpawn[1][duel_map_id][0], DuelSpawn[1][duel_map_id][1], DuelSpawn[1][duel_map_id][2]);
                            SetPlayerFacingAngle(DuelData[duelid][dCommand1][i], DuelSpawn[1][duel_map_id][3]);
                        }
                        break;
                    }
                    if(DuelData[duelid][dCommand2][i] == playerid)
                    {
                        if(DuelData[duelid][dGameRound]%2 == 0) // command 2
                        {
                            SetPlayerPos(DuelData[duelid][dCommand2][i], DuelSpawn[1][duel_map_id][0], DuelSpawn[1][duel_map_id][1], DuelSpawn[1][duel_map_id][2]+0.3);
                            SetPlayerFacingAngle(DuelData[duelid][dCommand1][i], DuelSpawn[1][duel_map_id][3]);
                        }
                        else
                        {
                            SetPlayerPos(DuelData[duelid][dCommand2][i], DuelSpawn[0][duel_map_id][0], DuelSpawn[0][duel_map_id][1], DuelSpawn[0][duel_map_id][2]+0.3);
                            SetPlayerFacingAngle(DuelData[duelid][dCommand2][i], DuelSpawn[0][duel_map_id][3]);
                        }
                        break;
                    }
                }
                SetPlayerVirtualWorld(playerid, duelid + 500);
                SetPlayerHealth(playerid, 100.0);
                SetPlayerInterior(playerid, duelid + 1000);
                SetPlayerArmour(playerid, 0.0);

                ResetPlayerWeapons(playerid);
                GivePlayerWeapon(playerid, DuelData[duelid][dGun], 250);
                p_info[playerid][pHealth] = 100;
                SetPlayerHealth(playerid, 100.0);

                Fix_TogglePlayerControllable(playerid, 0);
                p_temp[playerid][UnFreezeFix] = 1;
                p_temp[playerid][UnFreezeTimerFix] = timestamp+2;
            }
        }
        if(DuelData[duelid][dGameRound] > DuelData[duelid][dRound])
        { // the end duel
            new duel_command[2], duelbet[2];
            for(new i; i < 10; i++)
            {
                if(DuelData[duelid][dCommand1][i] != INVALID_PLAYER_ID) duel_command[0]++;
                if(DuelData[duelid][dCommand2][i] != INVALID_PLAYER_ID) duel_command[1]++;
            }
            if(!duel_command[0]) duel_command[0] = 1;
            if(!duel_command[1]) duel_command[1] = 1;

            duelbet[0] = DuelData[duelid][dBank]/duel_command[0];
            duelbet[1] = DuelData[duelid][dBank]/duel_command[1];

            for(new i; i < 10; i++)
            {
                if(DuelData[duelid][dCommand1][i] == playerid)
                {
                    SetPlayerPos(DuelData[duelid][dCommand1][i], 1027.9156+random(1), 1861.6172+random(1), 1515.8678);
                    SetPlayerFacingAngle(DuelData[duelid][dCommand1][i], 0.0000);
                    if(DuelData[duelid][dGameCommand1Kill] > DuelData[duelid][dGameCommand2Kill])
                    {
                        SendInfo(playerid, "Ваша команда выиграла в дуэли.");
                        SetPlayerMoney(playerid, ((duelbet[0] * 2) / 100) * 80, true, "победа в дуэли");
                        if(DuelData[duelid][dFamilyStatus] == 1) UpdateFamilyLevel(playerid);
                    }
                    else if(DuelData[duelid][dGameCommand1Kill] == DuelData[duelid][dGameCommand2Kill])
                    {
                        SendInfo(playerid, "По итогам дуэли никто не выиграл.");
                        SetPlayerMoney(playerid, duelbet[0], true, "возврат ставки за дуэль");
                    }
                    else SendInfo(playerid, "По итогам дуэли Ваша команда проиграла.");
                    break;
                }
                if(DuelData[duelid][dCommand2][i] == playerid)
                {
                    SetPlayerPos(DuelData[duelid][dCommand2][i], 1027.9170+random(1), 1867.4957+random(1), 1515.8678);
                    SetPlayerFacingAngle(DuelData[duelid][dCommand2][i], 180.0000);
                    if(DuelData[duelid][dGameCommand2Kill] > DuelData[duelid][dGameCommand1Kill])
                    {
                        SendInfo(playerid, "Ваша команда выиграла в дуэли.");
                        SetPlayerMoney(playerid, ((duelbet[1] * 2) / 100) * 80, true, "победа в дуэли");
                        if(DuelData[duelid][dFamilyStatus] == 1) UpdateFamilyLevel(playerid);
                    }
                    else if(DuelData[duelid][dGameCommand1Kill] == DuelData[duelid][dGameCommand2Kill])
                    {
                        SendInfo(playerid, "По итогам дуэли никто не выиграл.");
                        SetPlayerMoney(playerid, duelbet[1], true, "возврат ставки за дуэль");
                    }
                    else SendInfo(playerid, "По итогам дуэли Ваша команда проиграла.");
                    break;
                }
            }
            p_temp[playerid][DuelID] = INVALID_PLAYER_ID;
            Fix_TogglePlayerControllable(playerid, 0);
            p_temp[playerid][UnFreezeFix] = 1;
            p_temp[playerid][UnFreezeTimerFix] = timestamp+1;

            p_info[playerid][pHealth] = 100.0;
            SetPlayerHealth(playerid, 100.0);
            SetPlayerVirtualWorld(playerid, 1);
            SetPlayerInterior(playerid, 1);

            ResetPlayerWeapons(playerid);
            for (new i; i < MAX_WEAPONS; i++) GivePlayerWeapon(playerid, p_info[playerid][Weapon][i], p_info[playerid][Ammo][i]);
            SetPlayerArmedWeapon(playerid, 0);
            SetPlayerColor(playerid,  fraction_color[p_info[playerid][member]]);
        }
        return 1;
    }

    if(GetPVarInt(playerid, #registered_now))
    {
        if(GetPlayerGameVersion(playerid) >= CLIENT_VERSION_052021 || IsPlayerMobile(playerid))
        {
            p_info[playerid][p_settings][INTERFACE] = 1;
            p_info[playerid][p_settings][LOGO_ID] = 1;

            Logotype_Show(playerid);
            Logotype_Time(playerid);
            UpdatePlayerSetting(playerid);
        }
        DeletePVar(playerid, #registered_now);

        new skin_id;
        if(p_info[playerid][sex] == 2) skin_id = skinMan[random(6)][0];
        else skin_id = skinMan[6+random(6)][0];

        GivePlayerInventory(playerid, skin_id, .status_use = 1);

        ShowPlayerDialog(playerid, D_WELCOME, DIALOG_STYLE_MSGBOX, ""I"Добро пожаловать на "SERVER"!", ""W"\
            Вы успешно прошли регистрацию, примите наши поздравления! Теперь Вы - полноценный игрок "I""SERVER"."W"\n\n\
            Если Вы задаетесь вопросом, как правильно начать игру, что значит тот или иной термин, и что тут вообще\n\
            делать, то специально для Вас мы подготовили множество вариантов обучения игре.\n\n\
            Общая информация о проекте, игре и всех сопутствующих ресурсах представлена в меню "I"\"Помощь по игре\"."W"\n\
            Чтобы ознакомиться с ней, введите в чате /mm, и выберите соответствующий пункт.\n\n\
            На "I"GPS навигаторе"W" отмечено место "I"начала квестов,"W" с помощью которых можно "I"ознакомиться с сервером.", "Закрыть", "");
    }

    if(p_info[playerid][admin] > 0) SetPlayerColor(playerid, 0xFFFFFF00);

    if(RegisterPaintBall[playerid] == 2)
    {
        new idx;
        for(new i; i < MAX_PAINTBALL_PLAYERS; i++)
        {
            if(PaintBallPlayers[i] == playerid)
            {
                idx = random(16);
                p_temp[PaintBallPlayers[i]][UnFreezeFix] = 1;
                Fix_TogglePlayerControllable(PaintBallPlayers[i], 0);
                p_temp[PaintBallPlayers[i]][UnFreezeTimerFix] = timestamp + 1;
                SetPlayerPos(PaintBallPlayers[i], PaintBallPlayersCoord[EventMap][idx][0], PaintBallPlayersCoord[EventMap][idx][1], PaintBallPlayersCoord[EventMap][idx][2]+0.1);
                SetPlayerFacingAngle(PaintBallPlayers[i], PaintBallPlayersCoord[EventMap][idx][3]);
                SetCameraBehindPlayer(PaintBallPlayers[i]);
                if(EventMap == 0) SetPlayerInterior(PaintBallPlayers[i], 1);
                else SetPlayerInterior(PaintBallPlayers[i], 0);
                SetPlayerVirtualWorld(PaintBallPlayers[i], 500);
                p_info[playerid][pHealth] = 100.0;
                SetPlayerHealth(playerid, p_info[playerid][pHealth]);
                SetPlayerColor(PaintBallPlayers[i], 0xFF0000FF);

                new random_weapon = random(9);
                PaintBallWeaponID[PaintBallPlayers[i]] = PaintBallWeapon[random_weapon];
                GivePlayerWeapon(PaintBallPlayers[i], PaintBallWeaponID[PaintBallPlayers[i]], 99999);
                return 1;
            }
        }
    }
    if(p_temp[playerid][cossack_robbers_register] == 2)
    {
        p_temp[playerid][UnFreezeFix] = 1;
        Fix_TogglePlayerControllable(playerid, 0);
        p_temp[playerid][UnFreezeTimerFix] = timestamp + 1;

        new team = p_temp[playerid][cossack_robbers_team], idx = random(MAX_COSSACK_ROBBERS_POS);

        SetPlayerSkin(playerid, CossackRobbersSkin[team]);
        SetPlayerPos(playerid, CossackRobbersPos[CossackRobbersMap][team][idx][0] + random(1), CossackRobbersPos[CossackRobbersMap][team][idx][1] + random(1), CossackRobbersPos[CossackRobbersMap][team][idx][2]);
        SetPlayerFacingAngle(playerid, CossackRobbersPos[CossackRobbersMap][team][idx][3]);
        SetCameraBehindPlayer(playerid);

        SetPlayerInterior(playerid, CossackRobbersMap);
        SetPlayerVirtualWorld(playerid, 250);

        p_info[playerid][pHealth] = 100.0;
        SetPlayerHealth(playerid, 100.0);

        SetPlayerColor(playerid, team == 0 ? COLOR_RED : COLOR_BLUE);

        GivePlayerWeapon(playerid, CossackRobbersWeapon, 9999);
        return 1;
    }
    if(player_lobby_status[playerid] == true && player_lobby_idx[playerid] != -1)
    {
        switch(player_lobby_type[playerid])
        {
            case LOBBY_TYPE_DEATHMATCH:
            {
                ResetPlayerWeapons(playerid);
                new idx = player_lobby_idx[playerid], sidx = random(20), type = LobbyInfo[idx][LobbyType] - 1, map = LobbyInfo[idx][LobbyMap], interior_map[5] = {1, 1, 0, 0, 0};
                SetPlayerInterior(playerid, interior_map[map]);
                SetPlayerVirtualWorld(playerid, idx + 1);
                SetPlayerPos(playerid, LobbyPos[type][map][sidx][0], LobbyPos[type][map][sidx][1], LobbyPos[type][map][sidx][2]);
                SetPlayerFacingAngle(playerid, LobbyPos[type][map][sidx][3]);
                SetCameraBehindPlayer(playerid);
                p_info[playerid][pHealth] = 100.0;
                SetPlayerHealth(playerid, 100.0);
                SetPlayerColor(playerid, 0xFF0000FF);
                GivePlayerWeapon(playerid, LobbyInfo[idx][LobbySubject], 9999);
            }
            case LOBBY_TYPE_RACE:
            {
                new idx = player_lobby_idx[playerid];
                OnPlayerLeaveLobby(playerid, idx, "Спавн.");
            }
            case LOBBY_TYPE_DERBY:
            {
                new idx = player_lobby_idx[playerid];
                OnPlayerLeaveLobby(playerid, idx, "Спавн.");
            }
            case LOBBY_TYPE_STUNT:
            {
                new idx = player_lobby_idx[playerid];
                OnPlayerLeaveLobby(playerid, idx, "Спавн.");
            }
            case LOBBY_TYPE_PARKOUR:
            {
                ResetPlayerWeapons(playerid);
                new idx = player_lobby_idx[playerid], sidx = random(20), type = LobbyInfo[idx][LobbyType] - 1, map = LobbyInfo[idx][LobbyMap];
                SetPlayerInterior(playerid, 1);
                SetPlayerVirtualWorld(playerid, idx);
                SetPlayerSkin(playerid, LobbyInfo[idx][LobbySubject]);
                SetPlayerPos(playerid, LobbyPos[type][map][sidx][0], LobbyPos[type][map][sidx][1], LobbyPos[type][map][sidx][2]);
                SetPlayerFacingAngle(playerid, LobbyPos[type][map][sidx][3]);
                SetCameraBehindPlayer(playerid);
                p_info[playerid][pHealth] = 100.0;
                SetPlayerHealth(playerid, 100.0);
                SetPlayerColor(playerid, 0xFF0000FF);
            }
        }
        return 1;
    }
    if(RegisterRace[playerid] == 2)
    {
        for(new i; i < MAX_RACE_PLAYERS; i++)
        {
            if(RacePlayers[i] == playerid)
            {
                RegisterRace[RacePlayers[i]] = 0;
                RacePlayers[i] = INVALID_PLAYER_ID;
                if(RaceVehicles[i] != INVALID_VEHICLE_ID) DestroyVehicleVEx(RaceVehicles[i]);
                RaceVehicles[i] = INVALID_VEHICLE_ID;
                SendInfo(playerid, "Вы были дисквалифицированны с гонки.");
                DisablePlayerRaceCheckpoint(playerid);
            }
        }
    }
    if(RegisterDerby[playerid] == 2)
    {
        for(new i; i < MAX_DERBY_PLAYERS; i++)
        {
            if(DerbyPlayers[i] == playerid)
            {
                RegisterDerby[DerbyPlayers[i]] = 0;
                DerbyPlayers[i] = INVALID_PLAYER_ID;
                if(DerbyVehicles[i] != INVALID_VEHICLE_ID) DestroyVehicleVEx(DerbyVehicles[i]);
                DerbyVehicles[i] = INVALID_VEHICLE_ID;
                SendInfo(playerid, "Вы были дисквалифицированны с дерби.");
            }
        }
    }
    // reset weapons
    ResetPlayerWeapons(playerid);
    for (new i; i < MAX_WEAPONS; i++)
    {
        if(p_info[playerid][Weapon][i] == 42)
        {
            p_info[playerid][Weapon][i] = 0;
            p_info[playerid][Ammo][i] = 0;
            p_temp[playerid][FireAmmo] = 0;
            p_temp[playerid][mechanic_ammo] = 0;
            continue;
        }
        GivePlayerWeapon(playerid, p_info[playerid][Weapon][i], p_info[playerid][Ammo][i]);
    }
    SetPlayerArmedWeapon(playerid, 0);

    if(GetPVarInt(playerid, !"spawn_after_spectate_mode"))
    {
        SetPlayerInterior(playerid, pInteriorBeforeSpectate[playerid]);
        SetPlayerVirtualWorld(playerid, pVirtualWorldBeforeSpectate[playerid]);
        SetPlayerPos(playerid, pPosBeforeSpectateX[playerid], pPosBeforeSpectateY[playerid], pPosBeforeSpectateZ[playerid]+0.2);

        Fix_TogglePlayerControllable(playerid, 1);

        DeletePVar(playerid, !"spawn_after_spectate_mode");
        return 1;
    }

    if(p_info[playerid][jail_time] != 0)
    {
        SetPlayerVirtualWorld(playerid, 1);
        DeletePVar(playerid,"PlayerCuffed");
        SetPlayerCuffed(playerid, false);
        Fix_TogglePlayerControllable(playerid, 1);
        p_info[playerid][wanted] = 0;
        SetPlayerWantedLevel(playerid, 0);
        switch(p_info[playerid][jail])
        {
            case 1:
            {
                SetPlayerInterior(playerid, 1);
                SetPlayerVirtualWorld(playerid, 1);
                switch(random(5))
                {
                    case 0: SetPlayerPos(playerid, 2594.8792,2120.9707,1048.2335), SetPlayerFacingAngle(playerid, 269.1924);
                    case 1: SetPlayerPos(playerid, 2594.5432,2124.9297,1048.2335), SetPlayerFacingAngle(playerid, 267.9159);
                    case 2: SetPlayerPos(playerid, 2594.8469,2128.9121,1048.2335), SetPlayerFacingAngle(playerid, 269.5059);
                    case 3: SetPlayerPos(playerid, 2594.8542,2132.9133,1048.2335), SetPlayerFacingAngle(playerid, 268.2526);
                    case 4: SetPlayerPos(playerid, 2598.8616,2136.0291,1048.2335), SetPlayerFacingAngle(playerid, 177.6983);
                }
            }
            case 2:
            {
                SetPlayerInterior(playerid, 1);
                SetPlayerVirtualWorld(playerid, 2);
                switch(random(5))
                {
                    case 0: SetPlayerPos(playerid, 2594.8792,2120.9707,1048.2335), SetPlayerFacingAngle(playerid, 269.1924);
                    case 1: SetPlayerPos(playerid, 2594.5432,2124.9297,1048.2335), SetPlayerFacingAngle(playerid, 267.9159);
                    case 2: SetPlayerPos(playerid, 2594.8469,2128.9121,1048.2335), SetPlayerFacingAngle(playerid, 269.5059);
                    case 3: SetPlayerPos(playerid, 2594.8542,2132.9133,1048.2335), SetPlayerFacingAngle(playerid, 268.2526);
                    case 4: SetPlayerPos(playerid, 2598.8616,2136.0291,1048.2335), SetPlayerFacingAngle(playerid, 177.6983);
                }
            }
            case 3:
            {
                SetPlayerInterior(playerid, 1);
                SetPlayerVirtualWorld(playerid, 3);
                switch(random(5))
                {
                    case 0: SetPlayerPos(playerid, 2594.8792,2120.9707,1048.2335), SetPlayerFacingAngle(playerid, 269.1924);
                    case 1: SetPlayerPos(playerid, 2594.5432,2124.9297,1048.2335), SetPlayerFacingAngle(playerid, 267.9159);
                    case 2: SetPlayerPos(playerid, 2594.8469,2128.9121,1048.2335), SetPlayerFacingAngle(playerid, 269.5059);
                    case 3: SetPlayerPos(playerid, 2594.8542,2132.9133,1048.2335), SetPlayerFacingAngle(playerid, 268.2526);
                    case 4: SetPlayerPos(playerid, 2598.8616,2136.0291,1048.2335), SetPlayerFacingAngle(playerid, 177.6983);
                }
            }
            case 4:
            {
                SetPlayerInterior(playerid, 1);
                SetPlayerVirtualWorld(playerid, 4);
                switch(random(5))
                {
                    case 0: SetPlayerPos(playerid, 2594.8792,2120.9707,1048.2335), SetPlayerFacingAngle(playerid, 269.1924);
                    case 1: SetPlayerPos(playerid, 2594.5432,2124.9297,1048.2335), SetPlayerFacingAngle(playerid, 267.9159);
                    case 2: SetPlayerPos(playerid, 2594.8469,2128.9121,1048.2335), SetPlayerFacingAngle(playerid, 269.5059);
                    case 3: SetPlayerPos(playerid, 2594.8542,2132.9133,1048.2335), SetPlayerFacingAngle(playerid, 268.2526);
                    case 4: SetPlayerPos(playerid, 2598.8616,2136.0291,1048.2335), SetPlayerFacingAngle(playerid, 177.6983);
                }
            }
            case 5:
            {
                switch(random(20))
                {
                    case 0: SetPlayerPos(playerid, -290.3106,1446.4735,2059.8970), SetPlayerFacingAngle(playerid, 90.0);
                    case 1: SetPlayerPos(playerid, -290.9531,1451.7333,2059.8970), SetPlayerFacingAngle(playerid, 90.0);
                    case 2: SetPlayerPos(playerid, -290.8775,1441.4392,2059.8970), SetPlayerFacingAngle(playerid, 90.0);
                    case 3: SetPlayerPos(playerid, -290.5377,1436.1212,2059.8970), SetPlayerFacingAngle(playerid, 90.0);
                    case 4: SetPlayerPos(playerid, -290.6931,1430.8903,2059.8970), SetPlayerFacingAngle(playerid, 90.0);
                    case 5: SetPlayerPos(playerid, -291.3389,1431.0447,2063.7981), SetPlayerFacingAngle(playerid, 90.0);
                    case 6: SetPlayerPos(playerid, -290.5602,1436.4681,2063.7981), SetPlayerFacingAngle(playerid, 90.0);
                    case 7: SetPlayerPos(playerid, -291.4744,1441.0315,2063.7981), SetPlayerFacingAngle(playerid, 90.0);
                    case 8: SetPlayerPos(playerid, -290.4511,1446.5818,2063.7981), SetPlayerFacingAngle(playerid, 90.0);
                    case 9: SetPlayerPos(playerid, -291.1503,1451.2728,2063.7981), SetPlayerFacingAngle(playerid, 90.0);
                    case 10: SetPlayerPos(playerid, -313.5172,1451.4846,2063.7981), SetPlayerFacingAngle(playerid, 270.0);
                    case 11: SetPlayerPos(playerid, -313.2840,1446.0396,2063.7981), SetPlayerFacingAngle(playerid, 270.0);
                    case 12: SetPlayerPos(playerid, -312.9621,1441.4635,2063.7981), SetPlayerFacingAngle(playerid, 270.0);
                    case 13: SetPlayerPos(playerid, -313.0929,1436.0870,2063.7981), SetPlayerFacingAngle(playerid, 270.0);
                    case 14: SetPlayerPos(playerid, -313.6022,1431.1603,2063.7981), SetPlayerFacingAngle(playerid, 270.0);
                    case 15: SetPlayerPos(playerid, -312.9706,1431.0535,2059.7068), SetPlayerFacingAngle(playerid, 270.0);
                    case 16: SetPlayerPos(playerid, -313.4001,1436.0679,2059.7068), SetPlayerFacingAngle(playerid, 270.0);
                    case 17: SetPlayerPos(playerid, -313.0207,1440.9998,2059.7068), SetPlayerFacingAngle(playerid, 270.0);
                    case 18: SetPlayerPos(playerid, -313.2628,1446.3082,2059.7068), SetPlayerFacingAngle(playerid, 270.0);
                    case 19: SetPlayerPos(playerid, -313.5764,1451.3854,2059.7068), SetPlayerFacingAngle(playerid, 270.0);
                    default: SetPlayerPos(playerid, -290.3106,1446.4735,2059.8970), SetPlayerFacingAngle(playerid, 90.0);
                }
                SetPlayerInterior(playerid, 1);
                SetPlayerVirtualWorld(playerid, 1);
            }
            case 6:
            {
                SetPlayerPos(playerid, 288.6758,-135.2414,1004.0625), SetPlayerFacingAngle(playerid, 90.4716);
                SetPlayerInterior(playerid, 7);
                SetPlayerVirtualWorld(playerid, 1);
            }
        }
    }
    else
    {
        if(p_temp[playerid][spawn_exit] == false)
        {
            if(p_temp[playerid][dead_status] == true && !GetPlayerStatusCapture(playerid))
            {
                p_temp[playerid][dead_status] = false;
                if(p_temp[playerid][dead_acc_wear] < timestamp)
                {
                    CheckPlayerAccessories(playerid);
                    p_temp[playerid][dead_acc_wear] = timestamp + 60;
                }
                if(p_temp[playerid][dead_skin_wear] < timestamp)
                {
                    CheckPlayerSkins(playerid);
                    p_temp[playerid][dead_skin_wear] = timestamp + 60;
                }
                if(!gang(playerid) && !mafia(playerid) && !biker(playerid))
                {
                    if(army(playerid) && p_info[playerid][fwork] == true) return SetPlayerFractionSpawn(playerid);
                    else
                    {
                        if(p_temp[playerid][death_status] == 1)
                        {
                            if(GetPVarInt(playerid, "advert_id_to_sending"))
                            {
                                AdvertInfo[GetPVarInt(playerid, "advert_id_to_sending")-1][aIsTooked] = false;
                                DeletePVar(playerid, "advert_id_to_sending");
                            }

                            SetPlayerHealth(playerid, 100.0);
                            SetPlayerInterior(playerid, 0);
                            SetPlayerVirtualWorld(playerid, 0);
                            SetPlayerPos(playerid, p_temp[playerid][death_pos][0], p_temp[playerid][death_pos][1], p_temp[playerid][death_pos][2]);
                            SetPlayerFacingAngle(playerid, p_temp[playerid][death_pos][3]);
                            Fix_TogglePlayerControllable(playerid, 0);
                            if(p_info[playerid][p_vip] != 0)
                                f(STRING_GLOBAL, ""I"[1]"W" Появиться на месте спавна\n"I"[2]"W" Вызвать врачей (5 мин.)\n"I"[3]"W" Использовать: укол адреналина.");
                            else 
                                f(STRING_GLOBAL, ""I"[1]"W" Появиться в больнице\n"I"[2]"W" Вызвать врачей (5 мин.)");
                            ShowPlayerDialog(playerid, D_DEATH, DIALOG_STYLE_LIST, ""I"Выберите действие", STRING_GLOBAL, "Далее", "Отмена");
                            return 1;
                        }
                        SetPlayerInterior(playerid, 1);
                        SetPlayerVirtualWorld(playerid, GetPlayerPositionCity(playerid));
                        if(random(2) == 0)
                        {
                            SetPlayerPos(playerid, 199.6279+random(1),-1694.7915+random(1),1007.4633);
                            SetPlayerFacingAngle(playerid, 180.0000);
                        }
                        else
                        {
                            SetPlayerPos(playerid, 212.1570+random(1),-1694.7915+random(1),1007.4633);
                            SetPlayerFacingAngle(playerid, 180.0000);
                        }
                    }

                    p_info[playerid][in_hospital] = true;
                    p_info[playerid][pHealth] = 10.0;
                    SetPlayerHealth(playerid, p_info[playerid][pHealth]);
                    SetCameraBehindPlayer(playerid);
                    SendInfo(playerid, "Вы оказались в больнице на лечение.");
                    return 1;
                }
            }
            if(GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_ARMY && p_info[playerid][rang] < 3)
            {
                p_info[playerid][spawn] = SPAWN_FRACTION;
                p_info[playerid][fwork] = true;
                MysqlUpdatePlayerInt(playerid, "fwork", _:p_info[playerid][fwork]);
            }
            switch(p_info[playerid][spawn])
            {
                case SPAWN_HOUSE:
                {
                    new h = GetPlayerHouseID(playerid);
                    if(p_info[playerid][key_h_rent] != INVALID_HOUSE_ID)
                    {
                        h = p_info[playerid][key_h_rent];
                        SetPlayerHousePos(playerid, h, h_info[h][h_squar]-1, h_info[h][h_int]);
                    }
                    else
                    {
                        h = GetPlayerHouseID(playerid, p_info[playerid][spawn_house_id]);
                        if(h == INVALID_HOUSE_ID)
                        {
                            if(p_temp[playerid][fix_logged_house] == 1) p_info[playerid][spawn] = SPAWN_DEFAULT;
                            p_temp[playerid][fix_logged_house_check]++;//переписать эту залупу
                            if(p_temp[playerid][fix_logged_house_check] == 5) p_info[playerid][spawn] = SPAWN_DEFAULT;
                            SpawnPlayer(playerid);
                            return 1;
                        }
                        else
                        {
                            new h_class = h_info[h][h_squar]-1;
                            new int_id = h_info[h][h_int];
                            SetPlayerHousePos(playerid, h, h_class, int_id);
                        }
                    }
                }
                case SPAWN_HOTEL:
                {
                    new hotel_id = GetPlayerHotelID(playerid, 0), hotel_room = GetPlayerHotelID(playerid, 1);
                    if(hotel_id == -1 || hotel_room == -1) 
                    {
                        p_info[playerid][spawn] = SPAWN_DEFAULT;
                        SpawnPlayer(playerid);
                        return 1;
                    }
                    else
                    {
                        new biz_idx = -1;
                        for(new i; i < totalbizz; i++)
                        {
                            if(b_info[i][b_mysql_id] == INVALID_MYSQL_ID) continue;
                            if(b_info[i][b_mysql_id] == hotel_id)
                            {
                                biz_idx = i;
                                break;
                            }
                        }
                        if(biz_idx == -1)
                        {
                            p_info[playerid][spawn] = SPAWN_DEFAULT;
                            SpawnPlayer(playerid);
                            return 1;
                        }
                        SetPlayerPos(playerid, 2198.4780, -1160.3774, 1029.7969);
                        SetPlayerFacingAngle(playerid, 358.3456);
                        SetPlayerInterior(playerid, b_info[biz_idx][_int]);
                        SetPlayerVirtualWorld(playerid, biz_idx * 12 + hotel_room);
                        SetPVarInt(playerid, "bID", biz_idx);
                        SetPVarInt(playerid, "hrID", hotel_room);
                        Fix_TogglePlayerControllable(playerid, 0);
                        p_temp[playerid][UnFreezeFix] = 1;
                        p_temp[playerid][UnFreezeTimerFix] = timestamp + 2;
                    }
                }
                case SPAWN_FRACTION:
                {
                    if(p_info[playerid][member] == 0)
                    {
                        p_info[playerid][spawn] = SPAWN_DEFAULT;
                        SpawnPlayer(playerid);
                        return 1;
                    }
                    else SetPlayerFractionSpawn(playerid);
                }
                case SPAWN_FAMILY:
                {
                    new family_idx = GetPlayerFamilyID(playerid);
                    if(family_idx == -1 || p_info[playerid][family_id] == -1 || FamilyData[family_idx][fHouseID] == INVALID_HOUSE_ID)
                    {
                        p_info[playerid][spawn] = SPAWN_DEFAULT;
                        SpawnPlayer(playerid);
                        return 1;
                    }
                    else
                    {
                        new h = FamilyData[family_idx][fHouseID];
                        if(h_info[h][h_family_id] == -1)
                        {
                            p_info[playerid][spawn] = SPAWN_DEFAULT;
                            SpawnPlayer(playerid);
                            return 1;
                        }
                        else
                        {
                            new h_class = h_info[h][h_squar]-1,
                                int_id = h_info[h][h_int];

                            SetPlayerHousePos(playerid, h, h_class, int_id);
                        }
                    }
                }
                case SPAWN_TREILER:
                {
                    if(!GetPlayerCheckTreiler(p_info[playerid][ID]))
                    {
                        p_info[playerid][spawn] = SPAWN_DEFAULT;
                        SpawnPlayer(playerid);
                        return 1;
                    }
                    else
                    {
                        new vehicleid, bool:spawn_trailer = false;
                        for(new i; i < MAX_PLAYER_VEHICLES; i++)
                        {
                            vehicleid = GetPlayerVehicleIDEx(playerid, i);
                            if(vehicleid != INVALID_VEHICLE_ID && GetVehicleModelEx(vehicleid) == 508)
                            {
                                SpawnToTreiler(playerid, vehicleid);
                                spawn_trailer = true;
                                break;
                            }
                        }
                        if(!spawn_trailer)
                        {
                            if(GetFreeSlotVehicle(playerid) != ALL_BUSY_SLOT_VEHICLE)
                            {
                                p_temp[playerid][in_enter_vehicle] = 3000;
                                STRING_GLOBAL[0] = EOS;
                                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `vehicle` WHERE `v_model` = 508 AND `v_owner_id` = %d LIMIT 1", p_info[playerid][ID]);
                                mysql_tquery(con_bd, STRING_GLOBAL, "LoadPlayerVehicle", "i", playerid);
                            }
                            else
                            {
                                p_info[playerid][spawn] = SPAWN_DEFAULT;
                                SpawnPlayer(playerid);
                                SendError(playerid, "Вы не можете появиться в трейлере, т.к. он не загружен.");
                                return 1;
                            }
                        }
                    }
                }
                default: // Спавн (вокзал)
                {
                    if(p_info[playerid][spawn] != SPAWN_DEFAULT)
                        p_info[playerid][spawn] = SPAWN_DEFAULT;
                    SetPlayerInterior(playerid,0);
                    SetPlayerVirtualWorld(playerid,0);

                    if(p_info[playerid][level] == 1)
                    {
                        SetPlayerPos(playerid, 545.63,-195.34,7.8);
                        SetPlayerFacingAngle(playerid, 88.4563);
                        if(!p_info[playerid][admin])
                        {
                            SendInfo(playerid, "На GPS навигаторе отображено местоположения начала квестов.");
                            SetPlayerGPS(playerid, 1768.7162,-1898.0386,13.5746, 2.5);
                        }
                    }
                    else if(p_info[playerid][level] >= 2 && p_info[playerid][level] <= 3)
                    {
                        SetPlayerPos(playerid, 545.63,-195.34,7.8);
                        SetPlayerFacingAngle(playerid, 88.4563);
                        if(!p_info[playerid][admin])
                        {
                            SendInfo(playerid, "На GPS навигаторе отображено местоположения начала квестов.");
                            SetPlayerGPS(playerid, 1157.8712,-1752.9755,13.6065, 2.5);
                        }
                    }
                    else if(p_info[playerid][level] >= 4 && p_info[playerid][level] <= 5)
                    {
                        SetPlayerPos(playerid, 545.63,-195.34,7.8);
                        SetPlayerFacingAngle(playerid, 88.4563);
                        if(!p_info[playerid][admin])
                        {
                            SendInfo(playerid, "На GPS навигаторе отображено местоположения начала квестов.");
                            SetPlayerGPS(playerid, -1963.5011,121.6856,27.6875, 2.5);
                        }
                    }
                    else
                    {
                        SetPlayerPos(playerid, 545.63,-195.34,7.8);
                        SetPlayerFacingAngle(playerid, 88.4563);
                        if(!p_info[playerid][admin])
                        {
                            SendInfo(playerid, "На GPS навигаторе отображено местоположения начала квестов.");
                            SetPlayerGPS(playerid, 2842.7937,1287.2238,11.3906, 2.5);
                        }
                    }
                    SetCameraBehindPlayer(playerid);

                    if(1 <= p_info[playerid][admin] <= 10)
                        callcmd::az(playerid, "/0");
                }
            }
        }

        if(p_temp[playerid][spawn_exit] == true)
        {
            p_temp[playerid][spawn_exit] = false;
            if(p_info[playerid][spawn_pos_x] == 0.0 && p_info[playerid][spawn_pos_y] == 0.0 || p_info[playerid][spawn_pos_z] > 500.0)
            {
                SendInfo(playerid, "Произошла ошибка при считывании координат последнего выхода.");
                SendAccess(playerid, "Вы отправлены на стандартное место появления.");
            }
            else
            {
                SetPlayerInterior(playerid, 0);
                SetPlayerVirtualWorld(playerid,0);

                SetPlayerPos(playerid, p_info[playerid][spawn_pos_x], p_info[playerid][spawn_pos_y], p_info[playerid][spawn_pos_z]);
                SetPlayerFacingAngle(playerid, p_info[playerid][spawn_pos_r]);
                SetCameraBehindPlayer(playerid);

                p_info[playerid][spawn_pos_x] =
                p_info[playerid][spawn_pos_y] =
                p_info[playerid][spawn_pos_z] = 0.0;
            }
        }
    }

    Fix_TogglePlayerControllable(playerid, 0);
    p_temp[playerid][UnFreezeFix] = 1;
    p_temp[playerid][UnFreezeTimerFix] = timestamp + GetPlayerPing(playerid) < 200 ? 3 : 5;

    SetPlayerTime(playerid, timestamp_hour, timestamp_minute);
    if(p_temp[playerid][load_anims] == false)
    {
        p_temp[playerid][load_anims] = true;
        PreloadAllAnims(playerid); // Загружаем анимации;
    }

    if(p_info[playerid][fwork] == true && !(1 <= p_info[playerid][admin] <= 10))
        SetPlayerColor(playerid, fraction_color[p_info[playerid][member]]);
    else 
    {
        if(p_info[playerid][admin] > 0 && admin_acces[playerid] == false) 
            callcmd::alogin(playerid, "/0");
        SetPlayerColor(playerid, fraction_color[0]);
    }

    p_temp[playerid][anti_flood] += timestamp+1; // не менять!
    return 1;
}

Float:GetDistance(Float:x1, Float:y1, Float:z1, Float:x2, Float:y2, Float:z2)
{
    return VectorSize(x1-x2, y1-y2, z1-z2);
}

GetPlayerPositionCity(playerid, Float:x = 0.0, Float:y = 0.0, Float:z = 0.0)
{
    if(!(1 <= p_temp[playerid][city_id] <= 3) || x != 0.0 && y != 0.0 && z != 0.0)
    {
        new Float: dist1, Float:dist2, Float:dist3;
        if(x == 0.0 && y == 0.0 && z == 0.0)
            GetPlayerPos(playerid, x, y, z);
        dist1 = GetDistance(x, y, z, 1172.6527,-1323.2075,15.4027);
        dist2 = GetDistance(x, y, z, 1607.4236,1815.2452,10.8203);
        dist3 = GetDistance(x, y, z, -2655.0583,640.1632,14.4545);

        if(dist1 < dist2 && dist1 < dist3) p_temp[playerid][city_id] = 1;
        if(dist3 < dist1 && dist3 < dist2) p_temp[playerid][city_id] = 2;
        if(dist2 < dist1 && dist2 < dist3) p_temp[playerid][city_id] = 3;
    }
    return p_temp[playerid][city_id];
}

public OnPlayerDeath(playerid, killerid, reason)
{
    //SendDeathMessage(killerid, playerid, reason);
    //SendMesAll(-1, "OnPlayerDeath playerid = %d RegisterPaintBall[playerid] = %d killerid = %d RegisterPaintBall[killerid] = %d reason = %d", playerid, RegisterPaintBall[playerid], killerid, RegisterPaintBall[killerid], reason);
    //if(p_temp[playerid][rappelling] == true) HideRope(playerid);

    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER || GetPlayerState(playerid) == PLAYER_STATE_PASSENGER)
        for(new i = 0, vehicleid = GetPlayerVehicleID(playerid); i < 8; i++)
            if(veh_info[vehicleid][v_passenger][i] == playerid) veh_info[vehicleid][v_passenger][i] = INVALID_PLAYER_ID;

    if( p_temp[playerid][sitdown_id] != -1 && p_temp[playerid][sitdown_place] != -1 &&
        SitDown_Data[p_temp[playerid][sitdown_id]][sd_Status][p_temp[playerid][sitdown_place]] == playerid)
        SitDown_Clear(playerid, p_temp[playerid][sitdown_id], p_temp[playerid][sitdown_place]);

    ClearPlayerMarketUse(playerid);

    if(p_temp[playerid][TextDrawInventory] == true)
    {
        if(p_temp[playerid][InterfaceID] == EQUIPMENT_INVENTORY_BOOT ||
            p_temp[playerid][InterfaceID] == EQUIPMENT_INVENTORY_HOUSE ||
            p_temp[playerid][InterfaceID] == EQUIPMENT_INVENTORY_TRASHBOX ||
            p_temp[playerid][InterfaceID] == EQUIPMENT_INVENTORY_FAMILY)
            HideTextDrawForPlayer(playerid, TD_ID_INVENTORY_OTHER);
        if(p_temp[playerid][InterfaceID] == EQUIPMENT_INVENTORY_PLAYER)
            HideTextDrawForPlayer(playerid, TD_ID_INVENTORY_PLAYER);
    }

    if(p_info[playerid][exchangePartner] != INVALID_PLAYER_ID)
        EndExchange(playerid);

    if(GetPVarInt(playerid, "UseAnim") == 1) DeletePVar(playerid, "UseAnim");

    if(p_temp[playerid][rob_house_idx] != -1)
    {
        if(p_temp[playerid][rob_house_backup] && GetFreeRobHouseObject(playerid) != MAX_ROBBERY_HOUSE_PLAYER_ITEMS)
        {
            if(p_temp[playerid][rob_house_backup_pickup] != -1) DestroyDynamicPickup(p_temp[playerid][rob_house_backup_pickup]);
            if(p_temp[playerid][rob_house_backup_area] != -1) DestroyDynamicArea(p_temp[playerid][rob_house_backup_area]);

            new Float:x, Float:y, Float:z, virt_world = GetPlayerVirtualWorld(playerid);

            GetPlayerPos(playerid, x, y, z);

            p_temp[playerid][rob_house_backup_pickup] = CreateDynamicPickup(11745, 23, x, y, z, virt_world);
            p_temp[playerid][rob_house_backup_area] = CreateDynamicSphere(x, y, z, 2.5, virt_world, GetPlayerInterior(playerid), -1);
            UpdateAreaInfo(p_temp[playerid][rob_house_backup_area], TYPE_ROB_HOUSE, AREA_SUBTYPE_ROB_HOUSE_BACKUP, playerid);
            p_temp[playerid][rob_house_backup_pos][0] = x;
            p_temp[playerid][rob_house_backup_pos][1] = y;
            p_temp[playerid][rob_house_backup_pos][2] = z;

            SendInfo(playerid, "Вы потеряли сумку с предметами, найти ее можно с помощью команды /robbing");
            SendInfo(playerid, "Поспешите, в любой момент ее могут забрать.");

            p_temp[playerid][rob_house_backup_items][3] = p_temp[playerid][rob_house_backup_items][0];
            p_temp[playerid][rob_house_backup_items][4] = p_temp[playerid][rob_house_backup_items][1];
            p_temp[playerid][rob_house_backup_items][5] = p_temp[playerid][rob_house_backup_items][2];

            p_temp[playerid][rob_house_backup] = 0;
            p_temp[playerid][rob_house_backup_items][0] =
            p_temp[playerid][rob_house_backup_items][1] =
            p_temp[playerid][rob_house_backup_items][2] = -1;
        }
        else p_temp[playerid][rob_house_backup_items][0] = -1;
    }
    if(p_temp[playerid][rob_bank_idx] != -1)
    {
        if(p_temp[playerid][rob_bank_backup] && (p_temp[playerid][rob_bank_backup_items][0] != 0 || p_temp[playerid][rob_bank_backup_items][1] != 0))
        {
            if(p_temp[playerid][rob_bank_backup_pickup] != -1) DestroyDynamicPickup(p_temp[playerid][rob_bank_backup_pickup]);
            if(p_temp[playerid][rob_bank_backup_area] != -1) DestroyDynamicArea(p_temp[playerid][rob_bank_backup_area]);

            new Float:x, Float:y, Float:z, virt_world = GetPlayerVirtualWorld(playerid);

            GetPlayerPos(playerid, x, y, z);

            p_temp[playerid][rob_bank_backup_pickup] = CreateDynamicPickup(11745, 23, x, y, z, virt_world);
            p_temp[playerid][rob_bank_backup_area] = CreateDynamicSphere(x, y, z, 2.5, virt_world, GetPlayerInterior(playerid), -1);
            UpdateAreaInfo(p_temp[playerid][rob_bank_backup_area], TYPE_ROB_BANK, AREA_SUBTYPE_ROB_BANK_BACKUP, playerid);
            p_temp[playerid][rob_bank_backup_pos][0] = x;
            p_temp[playerid][rob_bank_backup_pos][1] = y;
            p_temp[playerid][rob_bank_backup_pos][2] = z;

            SendInfo(playerid, "Вы потеряли сумку с предметами, найти ее можно с помощью команды /robbing");
            SendInfo(playerid, "Поспешите, в любой момент ее могут забрать.");

            p_temp[playerid][rob_bank_backup_items][2] = p_temp[playerid][rob_bank_backup_items][0];
            p_temp[playerid][rob_bank_backup_items][3] = p_temp[playerid][rob_bank_backup_items][1];

            p_temp[playerid][rob_bank_backup] = 0;
            p_temp[playerid][rob_bank_backup_items][0] =
            p_temp[playerid][rob_bank_backup_items][1] = 0;
        }
    }
    if(p_temp[playerid][rob_fuel_idx] != -1)
    {
        if(p_temp[playerid][rob_fuel_backup] && p_temp[playerid][rob_fuel_backup_items][0] != 0)
        {
            if(p_temp[playerid][rob_fuel_backup_pickup] != -1) DestroyDynamicPickup(p_temp[playerid][rob_fuel_backup_pickup]);
            if(p_temp[playerid][rob_fuel_backup_area] != -1) DestroyDynamicArea(p_temp[playerid][rob_fuel_backup_area]);

            new Float:x, Float:y, Float:z, virt_world = GetPlayerVirtualWorld(playerid);

            GetPlayerPos(playerid, x, y, z);

