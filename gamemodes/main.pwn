getDayEx()
{
    return ((timestamp/86400)%7);
}


//����
forward get_vehicle_id(playerid, vehicleid);
public get_vehicle_id(playerid, vehicleid)
{
    veh_info[vehicleid][v_mysql_id] = cache_insert_id();
    if(playerid == INVALID_PLAYER_ID) return 1;
    if(IsPlayerOwnerVehicle(playerid, vehicleid))
    {
        if(GetFreeSlotVehicle(playerid) == ALL_BUSY_SLOT_VEHICLE)
            DestroyPlayerVehicle(playerid, GetPlayerVehicleIDEx(playerid, 0));
        SetFreeSlotVehicle(playerid, vehicleid);
    }
    // printf("mysql �������� vehicle: %s", veh_info[i][v_owner]);
    return 1;
}

forward ShowDialogBizBuyVehicle(playerid, i);
public ShowDialogBizBuyVehicle(playerid, i)
{
    veh_info[i][v_mysql_id] = cache_insert_id();
    return 1;
}

