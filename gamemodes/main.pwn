AntiDMZone(playerid, bool:isCop = false)
{
    if(p_temp[playerid][DuelID] != INVALID_PLAYER_ID && GetPlayerVirtualWorld(playerid) != 0)
        return 0;
    if(isCop == true && (IsPlayerFractionPolice(playerid) || p_info[playerid][member] == PRISON) && p_info[playerid][fwork] == true)
        return 0;
    if(p_temp[playerid][FireStatus] > 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && GetPlayerWeapon(playerid) == 42)
        return 0;
    if(p_temp[playerid][mechanic_idx] > 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && GetPlayerWeapon(playerid) == 42)
        return 0;
    if(p_temp[playerid][green_zone] == -1)
    {
        for(new i = count_antidm-1; i != -1; i--)
        {
            if(IsPlayerInDynamicArea(playerid, AntiDMInfo[i][dmArea]))
            {
                p_temp[playerid][green_zone] = i;
                break;
            }
        }
    }
    if(p_temp[playerid][green_zone] != -1)
    {
        ResetPlayerWeapons(playerid);
        for (new i; i < MAX_WEAPONS; i++)
        {
            if(p_info[playerid][Weapon][i] == 42)
            {
                p_info[playerid][Weapon][i] = 0;
                p_info[playerid][Ammo][i] = 0;
                p_temp[playerid][FireAmmo] = 0;
                p_temp[playerid][mechanic_ammo] = 0;
                continue;
            }
            GivePlayerWeapon(playerid, p_info[playerid][Weapon][i], p_info[playerid][Ammo][i]);
        }
        SetPlayerArmedWeapon(playerid, 0);

        ShowTextDrawForPlayer(playerid, TD_ID_GREEN_ZONE);
        return 1;
    }
    return 0;
}

#define PRESSED(%0) \
    (((newkeys & (%0)) == (%0)) && ((oldkeys & (%0)) != (%0)))

#define HOLDING(%0) \
    ((newkeys & (%0)) == (%0))

#define RELEASED(%0) \
    (((newkeys & (%0)) != (%0)) && ((oldkeys & (%0)) == (%0)))

public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
    if(p_info[playerid][loggedIn] != 1) return 0;
    //if(!SRV_ID) SendDebug(playerid, "newkeys %d, oldkeys %d", newkeys, oldkeys);
    if((newkeys & KEY_FIRE) || ((newkeys & 128) && (oldkeys & 128) && (newkeys & KEY_SECONDARY_ATTACK) ) || newkeys & KEY_FIRE || (newkeys & KEY_SPRINT && newkeys & KEY_SECONDARY_ATTACK) || (newkeys & 128) || (newkeys & KEY_SPRINT && newkeys & KEY_FIRE))
    {
        if((AntiDMZone(playerid, true) || p_info[playerid][jail_time] > 0 || p_info[playerid][p_game_time] < 3600) && p_info[playerid][admin] < 10)
        //if((AntiDMZone(playerid, true) || p_info[playerid][jail_time] > 0 || p_info[playerid][p_game_time] < 3600) && p_temp[playerid][Work_ID] == NONE_WORK)
        {
            if(IsPlayerInAnyVehicle(playerid)) return true;
            if(p_info[playerid][p_game_time] < 3600) ShowPlayerDialog(playerid, D_DM_ZONE, DIALOG_STYLE_MSGBOX, ""I"������� ����", ""W"������ ��� ���� �� ������� ��������� �������!", "��", "");
            else ShowPlayerDialog(playerid, D_DM_ZONE, DIALOG_STYLE_MSGBOX, ""I"������� ����", ""W"�� ���������� � {"#cGREEN"}\"������� ����\""W", ����� ��������� �������!", "��", "");
            if(p_temp[playerid][LaboratoryTimer] == 0 && RegisterRace[playerid] != 2 && RegisterDerby[playerid] != 2 && RegisterPaintBall[playerid] != 2 && p_temp[playerid][cossack_robbers_register] != 2 && p_temp[playerid][rob_house_idx] == -1 && p_temp[playerid][rob_bank_idx] == -1)
            {
                SendMes(playerid, COLOR_DARKORANGE, "�� ���������� �� 5 ���. �� ��.");
                p_temp[playerid][dm_zone_timer] = 5;
                Fix_TogglePlayerControllable(playerid, false);
            }
            ClearAnimations(playerid);
            ApplyAnimation(playerid,"MISC","plyr_shkhead",4.0,0,0,0,0,0,1);
            return 0;
        }
    }
    else
    {
        if(p_info[playerid][exchangePartner] != INVALID_PLAYER_ID) return SendError(playerid, "� ��� �� ����������� �����.");
    }
    new vehicleid = GetPlayerVehicleID(playerid),
        playerState = GetPlayerState(playerid);
    if(IsPlayerMobile(playerid) && (newkeys == 144 || newkeys == 128)) newkeys = KEY_FIRE;

    if(p_info[playerid][p_settings][STATUS_WALK_STYLE] && playerState == PLAYER_STATE_ONFOOT && !p_info[playerid][d_start_addiction])
    {
        if((PRESSED(KEY_JUMP) && PRESSED(KEY_WALK) && !IsPlayerMobile(playerid)) ||
            (IsPlayerMobile(playerid) && PRESSED(KEY_JUMP)))
        {
            Fix_TogglePlayerControllable(playerid, false);
            Fix_TogglePlayerControllable(playerid, true);
            ClearAnimations(playerid);
            ApplyAnimation(playerid,"FAT","IDLE_tired", 4.0, 0, 0, 0, 0, 1);
        }
        else if(!IsPlayerMobile(playerid)) PressKeyWalk(playerid, newkeys, oldkeys); // ����� �������
    }
    if(PRESSED(KEY_ACTION))
    {
        if(playerState == PLAYER_STATE_DRIVER)
        {
            callcmd::en(playerid);
        }
    }
    if(PRESSED(KEY_WALK) || (PRESSED(KEY_ANALOG_DOWN) && IsPlayerMobile(playerid)) || PRESSED(KEY_FIRE) || RELEASED(KEY_FIRE)) // ALT (KEY_WALK - ��� ������������� �������� | KEY_FIRE - � ������������ ��������)
    {
        if(GetPVarInt(playerid, "UseAnim") == 1) StopLoopingAnim(playerid);
        #if EVENT_HALLOWEEN == 1
            if(IsPlayerInDynamicArea(playerid, gift_area)) // �������� ����;
            {
                if(playerState == PLAYER_STATE_ONFOOT) ShowPlayerDialog(playerid, D_HALLOWEEN, DIALOG_STYLE_LIST, ""I"������������ Halloween", ""I"[1]"W" ����������� �����\n"I"[2]"W" �������� �����\n"I"[3]"W" ���������� � ������������ � ����� ����\n"I"[4]"W" ������ �������", "�����", "������");
            }
        #endif
        #if NEWYEAR_STATUS == 1
            if(IsPlayerInDynamicArea(playerid, gift_area)) // �������� �������;
            {
                if(playerState == PLAYER_STATE_ONFOOT) ShowPlayerDialog(playerid, D_NEWYEAR, DIALOG_STYLE_LIST, ""I"������������ ������ ����", ""I"[1]"W" �������� ������\n"I"[2]"W" ���������� � ������������ � ����� �������\n"I"[3]"W" ������ �������", "�����", "������");
            }
        #endif
         #if EASTER_STATUS == 1
            if(IsPlayerInDynamicArea(playerid, gift_area)) // �������� ���;
            {
                if(playerState == PLAYER_STATE_ONFOOT) ShowPlayerDialog(playerid, D_EASTER, DIALOG_STYLE_LIST, ""I"������������ �����", ""I"[1]"W" ����������� �����\n"I"[2]"W" �������� ����\n"I"[3]"W" ���������� � ������������ � ����� ���\n"I"[4]"W" ������ �������", "�����", "������");
            }
        #endif

        #if EVENT_HALLOWEEN == 1
        if(IsPlayerInDynamicArea(playerid, HalloweenQuest_Area[0]))
        {
            if(p_info[playerid][halloween_id] == 5 && p_info[playerid][halloween_progress] <= 1)
            {
                SetPlayerPos(playerid, 1149.2605,-2213.9792,1022.6520);
                SetPlayerFacingAngle(playerid, 180.0);
                SetPlayerVirtualWorld(playerid, playerid+1000);
                SetPlayerInterior(playerid, 1);
                SetCameraBehindPlayer(playerid);

                p_info[playerid][halloween_progress] = 1;
                MysqlUpdatePlayerInt(playerid, "halloween_progress", p_info[playerid][halloween_progress]);
                HalloweenQuest_Check(playerid);
            } else SendError(playerid, "�� �� ���������� ������ �����, ���� ��� ��������� ���.");
        }
        if(IsPlayerInDynamicArea(playerid, HalloweenQuest_Area[1]))
        {
            if(p_info[playerid][halloween_id] == 5 && p_info[playerid][halloween_progress] == 1)
            {
                SetPlayerPos(playerid, -385.0632,-1469.8419,25.7266);
                SetPlayerFacingAngle(playerid, 180.0);
                SetPlayerVirtualWorld(playerid, 0);
                SetPlayerInterior(playerid, 0);
                SetCameraBehindPlayer(playerid);

                p_info[playerid][halloween_progress] = 2;
                MysqlUpdatePlayerInt(playerid, "halloween_progress", p_info[playerid][halloween_progress]);
                HalloweenQuest_Check(playerid);
            } else SendError(playerid, "�� �� ���������� ������ �����, ���� ��� ��������� ���.");
        }
        #endif
        if(playerState == PLAYER_STATE_DRIVER)
        {
            if(p_temp[playerid][service_idx] != -1 && IsPlayerInDynamicArea(playerid, b_info[p_temp[playerid][service_idx]][b_area_enter]))
            {
                Service_Enter(playerid);
                return 1;
            }
            if(p_temp[playerid][p_house_id] != INVALID_HOUSE_ID && p_temp[playerid][p_house_area] == AREA_SUBTYPE_HOUSE_G_ENTER)
                return ShowPlayerDialog(playerid, D_GARAGE_AREA, DIALOG_STYLE_MSGBOX, ""I"������� � �����?",""W"�� ������ ������� � �����?","��","���");
        }
        if(p_temp[playerid][parking_id] != -1 && IsPlayerInDynamicArea(playerid, ParkData[p_temp[playerid][parking_id]][p_area_enter])
            && (playerState == PLAYER_STATE_ONFOOT || playerState == PLAYER_STATE_DRIVER))
        {
            new park_id = p_temp[playerid][parking_id];
            if(playerState == PLAYER_STATE_DRIVER)
            {
                new vehicleid = GetPlayerVehicleID(playerid);
                if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) >= VEHICLE_STATE_BOAT) return 1;
                TeleportVehicleToPos(vehicleid, 1625.9551,2201.6763,1022.0529+0.2, 270.0, park_id+5000, park_id+5000);
            }
            else
            {
                SetPlayerPos(playerid, 1634.0942,2201.4160,1022.3360); //�����
                SetPlayerFacingAngle(playerid, 90.0);
                SetPlayerInterior(playerid, park_id+5000);
                SetPlayerVirtualWorld(playerid, park_id+5000);
            }
            return 1;
        }
        if(playerState == PLAYER_STATE_ONFOOT)
        {
            if(p_temp[playerid][trash_id] != -1 &&
                IsPlayerInDynamicArea(playerid, TrashInfo[p_temp[playerid][trash_id]][tArea]))
            {
                return ShowPlayerDialog(playerid, D_TRASH, DIALOG_STYLE_MSGBOX, ""I"�������� ���", ""W"�� ������� ���������� ���������� ������� ��������� ����?", "��", "���");
            }
            /*
            if(SRV_ID != 2)
            {
                if(IsPlayerInDynamicArea(playerid, ghetto_bots[0]) || IsPlayerInDynamicArea(playerid, ghetto_bots[1]))
                {
                    ShowPlayerDialog(playerid, D_GHETTOWAR, DIALOG_STYLE_MSGBOX, "���������� � Ghetto War", 
                        ""W"������ ������� �����, ��������� ���� �� ��� ������� ������ � 12.06 �� 18.06\n\
                        �� ������� �������� "I"5.000 ������ "W"����� ������ ����� � ��������� ����! "I"(/gangtop)\n\
                        "W"�������� �����:\n\
                        1 - "I"5000 ������"W"\n\
                        2 - "I"3000 ������"W"\n\
                        3 - "I"1000 ������"W"\n\
                        4-10 ����� ������� �� "I"500 ������.\n\
                        \n\
                        "W"���-�� ���� �� ����� ����� � ��� ������� ����� ����� � ���� ������ (vk.com/flin_dev) �� �������.\n\
                        \n\
                        ���-�� ������� �������� ���������/����� �� ������ ������ �������!", "��������", "�������");
                    return 1;
                }
            }
            */
            if(p_temp[playerid][container_id] != -1 &&
                IsPlayerInDynamicArea(playerid, ContainersInfo[p_temp[playerid][container_id]][cArea]))
            {
                ShowContainersDialog(playerid, p_temp[playerid][container_id]);
                return 1;
            }
            
            new tableID = GetNearestPlayerBlackjackTable(playerid);
            if(tableID != -1) 
            {
                if(p_info[playerid][level] < 5)
                    return SendError(playerid, "BlackJack �������� � 5 ������.");
                
                SendInfo(playerid, "������ �� ����: /bjhelp.");
                return AttachPlayerToBlackjackTable(playerid, tableID);
            }
            if(p_temp[playerid][EventPickupID] != -1)
                OnPlayerCheckDynamicPickup(playerid, p_temp[playerid][EventPickupID]);

            if(p_temp[playerid][sitdown_id] != -1 && p_temp[playerid][sitdown_place] != -1)
            {
                new id = p_temp[playerid][sitdown_id],
                    place_id = p_temp[playerid][sitdown_place];
                if(IsPlayerInDynamicArea(playerid, SitDown_Data[id][sd_ObjectZone][place_id]))
                {
                    SitDown_UpdatePlace(playerid);
                    return 1;
                }
            }

            if(IsPlayerInDynamicArea(playerid, rob_fuel_area[0])) // ���������;
            {
                if(GetPlayerFamilyID(playerid) == -1 && !gang(playerid) && !mafia(playerid) && !biker(playerid)) return SendError(playerid, "�� �� �������� � ����� ��� ����������� �����������.");
                if(gos(playerid)) return SendError(playerid, "�� �� ��������� ������� ����.");
                if(p_info[playerid][level] < 20) return SendError(playerid, "����������� � ����������� ����� � 20-��� ������.");
