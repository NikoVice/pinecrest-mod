                    ShowPlayerDialog(playerid, D_BATTLEPASS_BUY_PREMIUM, DIALOG_STYLE_MSGBOX, ""I"Battle Pass:"W" Покупка Premium", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 1:
