                    return 1;
                }

                new weapon, ammo;
                GetPlayerWeaponData(playerid, WEAPON_Slot[pdWEAPON[listitem][g_Id]], weapon, ammo);
                switch(weapon)
                {
                    case WEAPON_NITESTICK:
                        if(ammo >= 1) return SendError(playerid, "� ��� ��� ���� ������ ������� ����.");
                    case WEAPON_TEARGAS:
                        if(ammo >= 5) return SendError(playerid, "� ��� ��� ���� ������ ������� ����.");
                    case WEAPON_COLT45, WEAPON_DEAGLE:
                        if(ammo >= 50) return SendError(playerid, "� ��� ��� ���� ������ ������� ����.");
                    case WEAPON_SHOTGUN:
                        if(ammo >= 30) return SendError(playerid, "� ��� ��� ���� ������ ������� ����.");
                    case WEAPON_M4, WEAPON_AK47:
                        if(ammo >= 300) return SendError(playerid, "� ��� ��� ���� ������ ������� ����.");
                    case WEAPON_UZI, WEAPON_MP5:
                        if(ammo >= 150) return SendError(playerid, "� ��� ��� ���� ������ ������� ����.");
                }
                f_GivePlayerWeapon(playerid, pdWEAPON[listitem][g_Id], pdWEAPON[listitem][g_Patr]);

                SetFractionWarehouse(id, fwMate, -pdWEAPON[listitem][g_Matr]);
                SetFractionWarehouse(id, fwPatron, -pdWEAPON[listitem][g_Patr]);
            }
