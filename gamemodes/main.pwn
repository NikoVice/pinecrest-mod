            if(strlen(nickname) < 3 || strlen(nickname) > 22) return ShowPlayerDialog(playerid, D_BL_ADD, DIALOG_STYLE_INPUT, ""I"������� � ������ ������", ""W"������� ��� ������ � ������� ����� �������:", "�����", "������"), SendError(playerid, "��� ������ ���� �� ����� 3 � �� ����� 22 ��������.");
            if(strlen(reason) < 3) return ShowPlayerDialog(playerid, D_BL_ADD, DIALOG_STYLE_INPUT, ""I"������� � ������ ������", ""W"������� ��� ������ � ������� ����� �������:", "�����", "������"), SendError(playerid, "������� ������ ���� �� ����� 3 ��������.");
            if(AdvertisingCheck(reason)) return AdvertisingPunishment(playerid, reason, 0);
            if(GetPlayerID(nickname) == INVALID_PLAYER_ID)
            {
                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id` FROM `accounts` WHERE `name` = '%e' LIMIT 1",
