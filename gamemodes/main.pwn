                BreakObject[playerid][i] = CreateDynamicObject(idx, PlPos[0]+floatcos(PlPos[3]+90, degrees), PlPos[1]+floatsin(PlPos[3]+90, degrees), PlPos[2] - BreakListCoord[listitem], 0, 0, PlPos[3]+90, -1, -1, -1, 120.00, 120.00);
                if(idx == 2899)
