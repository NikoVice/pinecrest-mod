////////////////////////////////////////////////////////////////////////////////

GetPlayerFractionType(playerid) {
    if(p_info[playerid][member] == 0) return 0;
    switch(p_info[playerid][member])
    {
        case 19: return 1;
        case 1, 2, 3, 4, 25: return 2;
        case 5, 20: return 3;
        case 15, 16, 17: return 4;
        case 6, 18, 24: return 5;
        case 10, 11, 12, 13, 14: return 6;
        case 7, 8, 9, 26: return 7;
        case 21: return 8;
        case 22: return 9;
        case 23: return 10;
        default: return 0;
    }
    return 0;
}

