new SAMPInfoList[][] = {
    {""W"SA-MP - платформа на базе знакомой всем с детства GTA: San Andreas, в которую теперь можно играть\n"},
    {"по сети. Однако же теперь не нужно следовать какому-то сюжету и бесконечно выполнять миссии - только\n"},
    {"Вы решаете, как правильно строить свою игру!\n\n"},
    {"SA-MP довольно-таки неприхотлив в техническом плане и, именно поэтому он полюбился многим ценителям\n"},
    {"мультиплеерных игр. Однако стоит отметить, что полноценно на данный момент игра доступна пользователям\n"},
    {"устройств на платформе Android, а также игрокам с персональных компьютеров."}
};

new FlinMobileInfoList[][] = {
    {""W"В SA-MP существует множество разных серверов с отличными друг от друга режимами. Исходные файлы игры дают\n"},
    {"необходимую базу и игровую карту, а разработчики проекта, в свою очередь, создают его неповторимый облик и\n"},
    {"сами решают, каким он будет выглядеть и что на нем можно будет делать.\n\n"},
    {"Среди всего этого множества проектов лишь немногие являются действительно уникальными и интересными для игроков\n"},
    {"площадками. Один из таких проектов - наш.\n\n"},
    {"Наш игровой мод проверен временем и стабилен, а главное, разнообразен. Мы продумали все - на "SERVER" существует\n"},
    {"множество интересных, увлекательных работ, разнообразные квесты и ежедневные задания, благодаря которым можно не\n"},
    {"только лучше узнать наш сервер, но и быстрее прокачать своего персонажа.\n"},
    {"Помимо \"начинки\" сервера в виде его мода, мы позаботились о его внешнем виде. Именно поэтому каждая организация\n"},
    {"(полиция, больница, мафии и т.п.) и важное общественное место (банк, автошкола и т.п.) имеют свой собственный\n"},
    {"красивый интерьер. Также мы создали функциональный и яркий сайт проекта, с которым Вы еще познакомитесь в процессе игры.\n\n"},
    {"Нельзя и не упомянуть, что мы - первый проект, чей лаунчер официально доступен для скачивания в Google Play Market,\n"},
    {"и имеет там более 1000 оценок пользователей."}
};

new FAQInfoList[][] = {
    {""W"FAQ - самые популярные вопросы и ответы на них. Здесь вы, скорее всего, найдете ответ и на свой вопрос.\n\n"},
    {"[1] Какая самая прибыльная работа на сервере? - Все работы примерно одинаково прибыльные. Попробуйте каждую,\n"},
    {"найдите самую удобную.\n\n"},
    {"[2] Кто создал данный сервер? - "SERVER" создан опытной командой в сфере разработки серверов.\n\n"},
    {"[3] Можете скинуть ссылку на сайт и форум? - Адрес форума "FORUM_URL", сайта "SITE_URL"\n\n"},
    {"[4] Ваш проект является нубо рп? - Нет, к созданию нашего проекта подошли с большим вниманием, дотошностью.\n\n"},
    {"[5] В игре я встретил странные аббревиатуры, что такое RP, MG, TK и т.д.? - Эти термины означают внутриигровые\n"},
    {"условности. Посетите страницу термины, там вы найдете все.\n\n"},
    {"[6] Почему мне говорят в игре, что я брежу (говорю бред)? - Видимо, вы не соблюдаете правил сервера. (MG, см. Термины)\n\n"},
    {"[7] Где искать команды? - /mm - Команды.\n\n"},
    {"[8] Что такое /me, /do, /try? - Это команды, позволяющие передать действия/состояния. \"/me хлопнул по животу\" значит,\n"},
    {"что вы хлопнули поживоту, \"/do На столе лежит клюшка\" означает, что на столе рядом лежит клюшка, \"/try выстрелил в\n"},
    {"мишень\" (удачно или неудачно) скажет, что вы попытались попасть в мишень, удачно или неудачно, зависит от случайности.\n\n"},
    {"[9] На что влияет уровень (лвл/lvl/level)? - Он влияет на доступность Вам некоторых работ/фракций. Он нужен, чтобы\n"},
    {"новые игроки не запутались в многообразии функционала сервера и постепенно освоили его."}
};

new RolePlayInfoList[][] = {
    {""W"Играя на "SERVER", Вы часто будете видеть в названиях проектов словосочетание RolePlay (RP). Что же это значит?\n"},
    {"Ответ прост - ролевая игра. Каждый игрок сам выбирает себе роль и старается развивать своего персонажа, соответствуя ей.\n\n"},
    {"Например, один игрок решит стать сначала полицейским, а потом и вовсе лидером полиции, поэтому будет вынужден вести себя\n"},
    {"как настоящий лидер полиции.\n\n"},
    {"Второй игрок может быть вообще не устроен в организациях и иметь свой бизнес, зарабатывая приличные деньги - это также его роль.\n\n"},
    {"На нашем сервере, как и в реальной жизни, за нарушение правил с последует наказание. Простой пример: если Вы в реальной жизни\n"},
    {"вдруг ударите человека, то будете наказаны.\n\n"},
    {"Наказания делятся на внутриигровые и серверные. В одном случае, например, за убийство другого игрока во время перестрелки или\n"},
    {"торговлю наркотиками Вас будет искать полиция, и Вас могут поместить в тюрьму. Если же произойдет более серьезное нарушение,\n"},
    {"то наказывать за него будут не полицейские (игроки), а непосредственно модераторы сервера. Такими наказаниями, к примеру,\n"},
    {"являются: читерство, оскорбление родных игроков, использование багов, наносящее ущерб серверу и т.п.\n\n"},
    {"Подробнее о правилах и нормативах наказаний читайте на нашем форуме: "FORUM_URL"."}
};

new TermsInfoList[][] = {
    {""W"Важно понимать, что при ролевом режиме игры она становится реалистичнее, поэтому в обычный чат нельзя писать вещи, не относящиеся\n"},
    {"к игре и Вашему персонажу (IC), пример: Привет, я Коля, мне 15 лет, живу в Питере.\n\n"},
    {"Все это относится к реальной жизни, и именно для этой информации (ООС) существует отдельный чат, писать в который можно с помощью\n"},
    {"команды: /n\n\n"},
    {"Таким образом, если Вас в обычный чат спрашивают, сколько Вам лет, то речь идет не о Вас как игроке, а о Вашем персонаже, возраст\n"},
    {"которого должен соответствовать информации в его паспорте.\n\n"},
    {"При устройстве в организацию Вы часто можете слышать вопросы с различными терминами. Например, что такое ДМ (DM), МГ (MG) и т.д.?\n"},
    {"Все это - RP-термины, прочитать про каждый из которых можно на нашем форуме: "FORUM_URL".\n\n"},
    {"Помните, что в игре есть IC (игровой мир) и OOC (реальный мир) информация, и если в обычный чат Вас спрашивают, что такое DM, то\n"},
    {"сразу нужно вспомнить, что в IC не существует никакого DM, RolePlay и прочего, ведь это аналог реального мира, в котором мы тоже\n"},
    {"не знаем, что такое, например, DB.\n\n"},
    {"Соответственно, Ваш ответ должен быть таким: наверное, марка автомобиля. Если же подобный вопрос прозвучит в ООС чате, то смело\n"},
    {"отвечайте, что DM - убийство/урон без причины.\n\n"},
    {"Есть также и другие немаловажные термины, которые обязательно встретятся Вам по игре:\n"},
    {"RP (РП) - RolePlay, Ролевая игра (игра по ролям). Этот термин означает полноценную игру по ролям, такую, когда играющие\n"},
    {"соблюдают все правила.\n\n"},
    {"NonRP (НонРП) - Non RolePlay, антагонист правильной игры (не ролевая игра). В принципе, он означает любое отхождение от RP.\n\n"},
    {"DM (ДМ) - DeathMatch, убийство/попытка убийства без внутриигровой причины.\n\n"},
    {"MG (МГ) - MetaGaming, МетаГейминг. Этот термин означает смешивание игровой и неигровой информации.\n\n"},
    {"PG (ПГ) - PowerGaming, ПаверГейминг. Когда вы в одиночку деретесь с 20-ю полицейскими, это PG. То есть, PG - это когда вы\n"},
    {"превышаете человеческие возможности в своем персонаже.\n\n"},
    {"DB (ДБ) - DriveBy, ДрайвБай. Когда вы убиваете человека, наехав на него машиной, это DB. На самом деле, убийство таким способом\n"},
    {"происходит из-за недоработки Сан Андреас, поэтому его использование неправильно.\n\n"},
    {"SK (СК) - SpawnKill, СпавнКилл. Когда вы убиваете только что заспавшившегося (появившегося) противника, это SK. Ведь в\n"},
    {"реальности нет спавна.\n\n"},
    {"TK (ТК) - TeamKill, ТимКилл. Это убийство дружественного Вам персонажа без причины. Так, например, если Вам станет скучно и вы\n"},
    {"решите убить напарника в полиции, это будет TK.\n\n"},
    {"RK (РК) - RepeatKill, РэпиатКилл. Когда вы убиваете дважды одного персонажа, это RK. Ведь нельзя дважды кого-то убить."}
};

new ResourcesInfoList[][] = {
    {""W"У нашего проекта существуют собственные информационные ресурсы: сайт, форум, группы VK. Разберемся, зачем же они нужны.\n\n"},
    {"Наш сайт - не только красивый и функциональный, но и очень полезный ресурс. Во-первых, оттуда можно скачать все необходимые\n"},
    {"для игры файлы и ознакомиться с общей информацией. Там расположены удобные ссылки на все наши ресурсы, а также мониторинг\n"},
    {"онлайна на сервере в режиме реального времени. Также именно на сайте можно пополнить свой донат-счет, чтобы получать уникальные\n"},
    {"возможности и имущество в игре, быстрее прокачивая своего персонажа.\n\n"},
    {"Форум проекта - неотъемлемая часть игрового процесса. Именно на форуме производится тщательный разбор жалоб на игроков, пишутся\n"},
    {"заявки на лидерство и проводятся разнообразные конкурсы, создаются семьи и выполняется отчет о выполненной во фракции работе для\n"},
    {"повышения должности. Если вдруг Вам нужно узнать какую-либо информацию об игре или ее режиме - зайдите на форум, наверняка, там\n"},
    {"Вы найдете все необходимое.\n\n"},
    {"Всего у "SERVER" существует 4 официальных сообщества [В]Контакте: официальное сообщество, свободное сообщество, техническая\n"},
    {"поддержка и блог разработчиков.\n\n"},
    {"Расскажем о них подробнее:\n"},
    {"В официальном сообществе можно посмотреть все обновления и поучаствовать в различных конкурсах.\n"},
    {"В свободном сообществе можно пообщаться с игроками и приобрести или продать игровое имущество.\n"},
    {"В технической поддержке можно получить ответы на различные технические вопросы.\n"},
    {"В блоге разработчиков можно посмотреть все будущие обновления до их появления в официальном сообществе."}
};

new StartInfoList[][] = {
    {""W"Мы советуем Вам начать с прохождения наших квестов, которые помогут освоиться Вам на сервере. По мере\n"},
    {"движения сюжетных линий, Вы получите необходимые ресурсы и знания, чтобы двигаться дальше.\n\n"},
    {"Когда все квесты будут пройдены, Вы можете действовать по своему усмотрению, базируясь на полученных\n"},
    {"знаниях - например, приобрести бизнес, работать таксистом или даже попытаться стать лидером фракции.\n\n"},
    {"Важно помнить - соблюдайте RP-режим и пользуйтесь системами ежедневных заданий, наград и достижений для\n"},
    {"быстрой прокачки своего персонажа."}
};

new HelpInfoList[][] = {
    {""W"Случаются ситуации, в которых Вам необходима помощь администрации, будь то какая-то подсказка или телепортация\n"},
    {"Вас при застревании в объектах.\n\n"},
    {"Задать вопрос или отправить жалобу администрации Вы можете с помощью команды: /ask (вопрос) и /report (жалоба),\n"},
    {"специалисты постараются быстро найти решение для Вашего обращения.\n\n"},
    {"Если же дело касается игрового нарушения, жалобы на игрока или обжалования собственного наказания, то необходимо\n"},
    {"перейти на форум и оставить жалобу в соответствующем разделе по необходимой форме и со всеми доказательствами.\n\n"},
    {"Важно помнить - администраторы очень заняты контролем игрового процесса, поэтому пишите в репорт только по делу\n"},
    {"и не просите администратора, к примеру, телепортироваться к Вам, чтобы просто пообщаться."}
};

new FractionJobInfoList[][] = {
    {""W"Фракции (организации) и работы сильно отличаются друг от друга. На работах (начальных и основных) Вы просто зарабатываете\n"},
    {"деньги, выполняя определенные действия, тут нет должностей и отделов, каждый работает на себя.\n\n"},
    {"Проще говоря, работы - нечто вроде серверной системы, где Вы просто получаете деньги.\n\n"},
    {"Если говорить о фракциях, это совершенно другая структура. У каждой организации есть персональный интерьер, функционал\n"},
    {"и лидер, полностью отвечающий за ее работу и состояние.\n\n"},
    {"Фракции - аналог настоящих работ, где можно получить повышение за проделанную работу (повышение происходит через форум,\n"},
    {"где оставляются отчеты о проделанной работе в виде скриншотов). Фракции бывают государственными (армия, полиция, правительство и т.д.)\n"},
    {"и нелегальными (банды, мафии, байкеры).\n\n"},
    {"Отметим, что все эти две системы задают темп жизни на сервере. Так, если бы не было развозчиков продуктов, бизнесы были бы\n"},
    {"пусты, а при отсутствии СМИ игроки бы не смогли предоставлять или заказывать разные предметы и услуги. Как ни крути, важен\n"},
    {"каждый работник.\n\n"},
    {"Независимо от того, заняты ли Вы на общественной работе или трудоустроены во фракции, необходимо соответствовать своей роли."}
};

new LeadersAdminsInfoList[][] = {
    {""W"Для стабильной работы всего сервера важен каждый игрок, но в особенности - администрация и лидеры организаций.\n\n"},
    {"Лидеры возглавляют фракции и полностью управляют их работой. Именно от этих людей зависят многие вещи: будет ли\n"},
    {"соблюдаться режим игры сотрудниками, по каким критериям пройдут наборы в организации, как именно фракции будут\n"},
    {"участвовать в жизни сервера. Стать лидером можно в случае, если Вы подходите под определенные критерии, написав\n"},
    {"заявку на форуме проекта и пройдя обзвон на соответствующий пост. Если лидер показывает себя достойным и ответственным\n"},
    {"человеком, то он может претендовать на пост администратора.\n\n"},
    {"Администрация контролирует существование сервера и соблюдение режима игры. В отличие от лидеров, администраторы - не\n"},
    {"игровые персонажи, а значит, контакт с ними происходит в особом порядке. Администрация занимается выдачей наказаний,\n"},
    {"проведением мероприятий, организацией слаженной работы фракций и контролем за комфортом каждого игрока."}
};

new EventInfoList[][] = {
    {""W"На "SERVER" существует много видов развлечений, благодаря которым Вы можете разнообразить свой игровой процесс и заработать\n"},
    {"игровую валюту.\n\n"},
    {"Охота и рыбалка доступны каждому игроку. Для осуществления любого из этих занятий необходимо наличие определенных предметов\n"},
    {"(удочка для рыбалки, винтовка - для охоты). Для поиска ближайшего места проведения охоты или рыбалки воспользуйтесь GPS и\n"},
    {"следуйте полученным инструкциям. Добычу можно либо продать в заведения общепита, либо употребить самому.\n\n"},
    {"Еще один вид развлечений - мероприятия. Они бывают системными и проводимыми администрацией.\n\n"},
    {"В любом из этих случаев в чате Вы увидите инструкции для телепортации на место сбора. Победители мероприятий, как правило,\n"},
    {"выигрывают немало денег.\n\n"},
    {"Остальные виды развлечений связаны с бизнесами. Так, Вы можете попытать свою удачу в роскошном казино, или же как следует\n"},
    {"оторваться в ближайшем баре."}
};

new BusInfoList[][] = {
    {""W"Работа шофером автобуса - это труд, позволяющий людям посещать главные объекты в штате.\n"},
    {"Автобусы следуют лишь по городам, поэтому нет междугородних рейсов. Чтобы стать водителем,\n"},
    {"автобуса посети правительство.\n\n"},
    {"Если ты уже водитель автобуса, следуй к автостоянке автобусов. Арендуй себе рабочий транспорт,\n"},
    {"выбери рейс и поезжай в работу.\n\n"},
    {"Во время работы будь внимателен с правилами ПДД. Помни, что ты можешь перевозить лишь до 7\n"},
    {"человек сразу, уважай своих коллег.\n\n"},
    {"Останавливайся на остановках так, чтобы никому не мешать."}
};

new TaxiInfoList[][] = {
    {""W"Работа таксистом - это служба на благо людей всех слоев. Если хочешь \"бомбить\" на такси, но еще не работаешь\n"},
    {"водителем, езжай в службу такси и устройся ( /gps > [9] Службы такси ).\n\n"},
    {"Если ты уже кучер, ступай к автостоянке таксистов и арендуй транспорт для работы.\n\n"},
    {"Далее действуй на свое усмотрение. Проезд в такси оплачивает государство, поэтому ты легко найдешь себе\n"},
    {"клиента. Чем быстрее будешь работать, тем больше получишь."}
};

new MechanicInfoList[][] = {
    {""W"Работа автомехаником - это халтура, позволяющая людям выбраться из затруднительного положения, когда их авто\n"},
    {"сильно поломано.\n\n"},
    {"Если хочешь поработать им, ступай для устройства в правительство.\n\n"},
    {"Если твои руки уже в машинном масле и ты автомеханик, следуй к автостоянке механиков. Там арендуй специальное\n"},
    {"авто. Название поможет тебе привлечь клиентов.\n\n"},
    {"Ты можешь просто чинить бедолаг за небольшую сумму денег, а можешь подписать контракт с какой-нибудь АЗС и\n"},
    {"поставлять клиентам бензин.\n\n"},
    {"Не будь слишком навязчивым, не пропускай вызовы, тогда твой сервис будет популярен."}
};

new TruckInfoList[][] = {
    {""W"Работа дальнобойщиком - это сложное, нервное дело. Вы должны поставлять ресурсы с заводов в порты. Если хочешь стать дальнобойщиком,\n"},
    {"устройся им в транспортной компании.\n\n"},
    {"Если ты уже дальний путник, поезжай к автостоянке дальнобойщиков. Там арендуй себе транспорт и поезжай к заводам ( /gps > [10] Транспортные компании ).\n\n"},
    {"Ты должен быстро, но не нарушая ПДД, перевозить поставки от заводов в порты. Таким образом ты поможешь государству\n"},
    {"создать больше продукции для граждан."}
};

new TrainInfoList[][] = {
    {""W"Работа машинист поезда - это важное занятие, которое позволяет людям добираться из одного города в другой.\n"},
    {"Если хочешь помогать таким образом людям, но ещё не устроился, езжай в правительство.\n\n"},
    {"Если ты уже машинист поезда, добирайся до ЖД-ЛС. Там арендуй свободный поезд и можешь приступать к работе.\n"},
    {"По мере продвижения по путям собирай чекпоинты. Помни, что разгоняться свыше 60 KM/H на трамвае не стоит: у него\n"},
    {"гигантская масса, он очень долго тормозит. Поэтому в случае превышения планки тебя оштрафуют на 1000$, а при отсутствии\n"},
    {"денег попросту уволят. Останавливаться нужно на остановках и для предотвращения ДТП."}
};

new TramInfoList[][] = {
    {""W"Работа водитель трамвая - это важное занятие, которое позволяет людям добираться до работы и домой.\n"},
    {"Если хочешь помогать таким образом людям, но ещё не устроился, езжай в правительство.\n\n"},
    {"Если ты уже водитель трамвая, добирайся до трамвайного депо. Там тебе выдадут трамвай и ты можешь приступать\n"},
    {"к работе.\n\n"},
    {"По мере продвижения по путям собирай чекпоинты. Помни, что разгоняться свыше 60 KM/H на трамвае не стоит: у него\n"},
    {"гигантская масса, он очень долго тормозит. Поэтому в случае превышения планки тебя оштрафуют на 1000$, а при отсутствии\n"},
    {"денег попросту уволят. Останавливаться нужно на остановках и для предотвращения ДТП."}
};

new PilotInfoList[][] = {
    {""W"Работа пилотом - это обслуживание важных персон бизнес-класса. Если вы хотите обслуживать богатых людей,\n"},
    {"но не являетесь пилотом, получите лицензию пилота и устройтесь в мэрии.\n\n"},
    {"Если уже являетесь пилотом, ступайте в аэропорт. Пройдите чуть по нему в поиске самолета. Аренда авиа-судна\n"},
    {"обойдется в 5000$.\n\n"},
    {"В самолете выберите один из рейсов. Следуйте по чекпоинтам согласно указаниям к ним. Аккуратно пролетайте\n"},
    {"их, ведь разворачивать самолет достаточно долго."}
};

new PanelInfoList[][] = {
    {""W"Ремонтник панелей - важная работа, без которой энергодобывающее оборудование на домах игроков не сможет\n"},
    {"функционировать.\n\n"},
    {"Если хочешь попробовать себя в этой роли - устраивайся на работу в правительстве. Как только будешь трудоустроен,\n"},
    {"езжай на служебную стоянку и бери в аренду один из автомобилей, после чего станут доступны заказы на ремонт солнечных\n"},
    {"панелей.\n\n"},
    {"Обрати внимание, что для качественной работы необходим специальный набор инструментов. Приобрести его можно в магазине\n"},
    {"солнечных панелей.\n\n"},
    {"Получив заказ, необходимо отправиться к дому клиента и отремонтировать солнечную панель путём включения всех преобразователей\n"},
    {"энергии. После успешного выполнения задания ты получишь оплату. Удачной работы!"}
};

new GreenHousesInfoList[][] = {
    {""W"Работник теплицы - интересная и востребованная работа, ведь именно благодаря ей каждый сможет получить красители\n"},
    {"для покраски своих аксесуаров.\n\n"},
    {"Если хочешь попробовать себя в этой роли - приходи в тепличный комплекс, начинай смену, переодевайся и приступай к работе.\n"},
    {"Твоей основной задачей станет сбор цветов и их перенос на склад. В процессе работы тебе могут выпасть даже очень редкие \n"},
    {"красители, поэтому будь усерден!\n\n"},
    {"Новые цветы будут вырастать каждые 5 минут, поэтому если теплица пуста - стоит просто немного подождать. Удачной работы!"}
};

new PizzaboyInfoList[][] = {
    {""W"Работа развозчиком пиццы - это работа по доставке еды. Вы должны доставлять заказы с \"Cluckin Bell\" в дома.\n"},
    {"Если хочешь заняться этим, устройся на работу в мэрии.\n\n"},
    {"Если ты уже развозчик пиццы, ступай к \"Cluckin Bell\" и арендуй транспорт для работы. Это обойдется тебе в 250$.\n\n"},
    {"После аренды бери заказы и начинай выполнять их."}
};

new CollectorInfoList[][] = {
    {""W"Работа инкассатором - это работа по доставке денежных средств. Вы должны доставлять денежные средства из банка в банкоматы.\n\n"},
    {"Перевозку денежных средств можно осуществлять как в одиночку, так и командой в 4 человека. Один из инкассаторов должен арендовать\n"},
    {"транспорт и пригласить остальных присоединиться к команде (/party).\n\n"},
    {"Когда команда сформирована, водитель команды должен взять заказ на перевозку, после чего отобразится склад, с которого необходимо\n"},
    {"переносить кейс с деньгами в багажник, затем соответствующий банкомат отобразится у всех на карте. Если же водитель сначала возьмет\n"},
    {"заказ, а потом пригласит игроков в команду (/party), то у них не будет отображаться выбранный банкомат, значит, что и ограбить они\n"},
    {"его не смогут, и будут вынуждены ждать, пока водитель сам выполнит этот заказ. Чтобы покинуть команду, введите (/leaveparty).\n\n"},
    {"Когда инкассаторы доберутся до нужного банкомата, им нужно будет перетащить в банкомат 10 кейсов с деньгами.\n\n"},
    {"Когда все кейсы с деньгами окажутся в банкомате, инкассаторам необходимо отправиться за зарплатой и, соответственно, взять новый\n"},
    {"заказ.\n\n"},
    {"Деньги в банкоматах, требуются через каждые 10 минут. Это значит, что если вы пополнили определенный банкомат, то повторить работу\n"},
    {"с этим же банкоматом не получится, и надо браться за другие заказы.\n\n"},
    {"Оплата за работу напрямую зависит от количества участников перевозки и количества перенесенных кейсов с деньгами. Как не странно,\n"},
    {"работать одному не так выгодно, ведь даже несмотря на то, что оплата достанется одному человеку, за одно и то же время перетащить\n"},
    {"кейсов с деньгами он сможет намного меньше, чем трое или четверо инкассаторов.\n\n"},
    {"Распределение оплаты на работе:\n"},
    {"1 грабитель = стандартная оплата работы\n"},
    {"2 грабителя = стандартная оплата + 10 процентов бонус\n"},
    {"3 грабителя = стандартная оплата + 20 процентов  бонус\n"},
    {"4 грабителя = стандартная оплата + 30 процентов  бонус"}
};

new ElectricInfoList[][] = {
    {""W"Работа электриком - интересная и востребованная работа, которая делится на два типа: легальный - ремонт ЛЭП и нелегальный - ограбление ЛЭП.\n\n"},
    {"Выполнение поставленных задач можно осуществлять как в одиночку, так и командой в 4 человека. Один из электриков должен арендовать транспорт\n"},
    {"и пригласить остальных присоединиться к команде (/party).\n\n"},
    {"Когда команда сформирована, водитель должен подписать контракт с ЛЭП, после чего отобразится ЛЭП, на которой необходимо выполнять задачи, затем\n"},
    {"соответствующая ЛЭП отобразится у всех на карте. Если же водитель сначала возьмет заказ, а потом пригласит игроков в команду (/party), то у них\n"},
    {"не будет отображаться выбранная ЛЭП значит, что и выполнить задачи они не смогут, и будут вынуждены ждать, пока водитель сам выполнит задачи.\n"},
    {"Чтобы покинуть команду, введите (/leaveparty).\n\n"},
    {"Когда электрики доберутся до нужной ЛЭП, им нужно будет в зависимости от выбранного типа работы, осуществить подключение или отключение проводов.\n\n"},
    {"При ограблении ЛЭП, после отключения проводов, необходимо переносить ящики с металлоломом в багажник.\n\n"},
    {"Когда все ящики с металлоломом окажутся в банкомате, электрикам необходимо будет разгрузить их на склад и отправиться за зарплатной и, соответственно,\n"},
    {"взять новый контракт.\n\n"},
    {"Ремонт и ограбления ЛЭП можно осуществлять раз в час. Это значит, что если вы выполнили контракт, то выполнить контракт с этой ЛЭП снова не получится,\n"},
    {"и надо браться за другие контракты.\n\n"},
    {"Оплата за работу напрямую зависит от количества участников перевозки и количества перенесенных ящиков с металлоломом. Как не странно, работать одному\n"},
    {"не так выгодно, ведь даже несмотря на то, что оплата достанется одному человеку, за одно и то же время отремонтировать ЛЭП или ограбить её он может\n"},
    {"намного меньше, чем трое или четверо электриков.\n\n"},
    {"Распределение оплаты на работе:\n"},
    {"1 электрик = стандартная оплата работы\n"},
    {"2 электрика = стандартная оплата + 10 процентов бонус\n"},
    {"3 электрика = стандартная оплата + 20 процентов  бонус\n"},
    {"4 электрика = стандартная оплата + 30 процентов  бонус"}
};

new OilInfoList[][] = {
    {""W"Работа нефтяником - интересная и высокооплачиваемая работа, на которой можно заработать большое состояние.\n"},
    {"Вам необходимо закупить бочки с нефтью по низкой цене и загрузить их в транспортное средство, затем разгрузить\n"},
    {"их и продать на нефтезаводе по высокой цене.\n\n"},
    {"Для закупки бочек с нефтью существует 3 нефтяные вышки, а для продажи бочек с нефтью существует 1 нефтезавод.\n\n"},
    {"С помощью команды /oil можно начать процесс загрузки и разгрузки и посмотреть список нефтяных вышек.\n\n"},
    {"С повышением навыка открываются новые транспортное средства, с помощью которых можно перевозить в несколько раз\n"},
    {"больше бочек с нефтью.\n\n"},
    {"{"#cLIGHTRED"}Обратите внимание! За час можно перевозить не более 25 бочек с нефтью, но если приобрести VIP Gold, в час можно\n"},
    {"перевозить 50 бочек с нефтью."}
};

new TreasureHunterInfoList[][] = {
    {""W"Кладоискатель - одна из самых высокооплачиваемых и интересных профессий на сервере.\n\n"},
    {"Ваша основная задача заключается в поиске сокровищ на специально отведенной территории,\n"},
    {"которая отобразится на карте после начала работы. Находясь на ней, справа на экране\n"},
    {"отобразится расстояние до местоположения клада. Вам предстоит передвигаться по территории\n"},
    {"в правильном направлении в поисках необходимого места. Как только расстояние достигнет 3-х\n"},
    {"метров или меньше, необходимо воспользоваться командой /tr\n\n"},
    {"На экране отобразится интерфейс, на котором необходимо последовательно открывать квадраты\n"},
    {"в которых можно найти сокровища или динамит. При нахождении динамите все начинается сначала,\n"},
    {"а при нахождении сокровища выдаются денежные средства и с небольшим шансом различные\n"},
    {"предметы."}
};

new FiremanInfoList[][] = {
    {""W"Работа пожарным - это важнейшая должность по предотвращению катастроф. Если хочешь спасать государство от огня,\n"},
    {"но не знаешь как, сначала проследуй к мэрии и устройся пожарным там.\n\n"},
    {"Если ты уже доблестный огнеборец, пройди в пожарную часть. Там тебе выдадут огнеупорную одежду и огнетушитель.\n"},
    {"Арендуй пожарную машину и жди тревожных вызовов от диспетчера.\n\n"},
    {"На месте бедствия выйди из автомобиля и устраняй возгорания по очереди. Обычно всего 5 источников огня, каждый имеет\n"},
    {"свою \"живучесть\" (прогресс 0 из 5 - это сильный пожар, 5 из 5 - потушенный).\n\n"},
    {"После победы над огнем отправляйся в машину и ожидай следующих вызовов."}
};

new RoadmanInfoList[][] = {
    {""W"Работа ремонтником дорог - интересная и хорошо оплачиваемая работа, на которой можно заработать хорошие деньги.\n\n"},
    {"Вам необходимо арендовать транспортное средство и воспользоваться командой /road для поиска дорожных работ.\n\n"},
    {"Приехав на место проведения дорожных работ, с помощью команды /road необходимо начать загрузку мешков с мусором,\n"},
    {"собирать их и загружать в транспортное средство.\n\n"},
    {"Заполнив транспортное средство нужным количеством мешков, необходимо воспользоваться командой /road для поиска\n"},
    {"свалок."},
    {"Приехав к одной из свалок, с помощью команды /road необходимо начать разгрузку мешков с мусором и разгружать их\n"},
    {"на свалку."}
};

new FishInfoList[][] = {
    {""W"Рыбалка - полезное хобби, которое обеспечит тебя сытной пищей и неплохим доходом.\n\n"},
    {"Для начала в магазине рыба купи удочку, несколько катушек, немного лески, крючков и червяков.\n"},
    {"Рыбачить разрешено лишь у пирса. Он всего 1, найти можно в навигаторе ( /gps > [13] Рыбалка ).\n"},
    {"Там введи команду /fish для начала рыбалки. В процессе нужно будет нажимать заданные кнопки,\n"},
    {"когда рыба клюнет, чтобы вытащить ее. Количество улова и снастей можешь найти в инвентаре.\n\n"},
    {"Кроме обычной рыбалки, ты можешь приобрести и установить сети, затем собрать с них улов.\n\n"},
    {"Рыбу можно кушать, но не спеши съедать всю, ведь ее покупают на пирсе. Там ты можешь\n"},
    {"продать часть своих запасов.\n\n"},
    {"Кроме команды /fish есть еще некоторые команды, подробнее в меню. ( /mn > [5] Команды сервера )"}
};

new DrugdenInfoList[][] = {
    {""W"Гровер - достаточно опасный вид деятельности, но с его помощью можно зарабатывать\n"},
    {"большие деньги.\n\n"},
    {"Для выращивания наркотиков необходимо купить семена, грунт и удобрения в наркопритоне.\n"},
    {"Найти наркопритон можно в навигаторе ( /gps > [5] Для фракций > [6] Наркопритон )\n"},
    {"Выращивать наркотики можно только на территориях своей банды.\n\n"},
    {"Посадить семена можно с помощью команды /cdrugs, а собрать с помощью команды /ddrugs\n"},
    {"В любой момент можно найти кусты, которые ты посадил, сделать это можно с помощью\n"},
    {"команды /sdrugs\n\n"},
    {"После сбора наркотиков их можно использовать или продать на центральном рынке."}
};

new HuntingInfoList[][] = {
    {""W"Охота - полезное хобби, которое обеспечит тебя сытной пищей и неплохим доходом.\n\n"},
    {"Для начала в хижине возьми разрешение на охоту, садись в машину и ожидай информации о местоположении\n"},
    {"оленя. По приезду на место останется выйти из машины и нейтрализовать оленя в течение 3-ех минут.\n"},
    {"Будь аккуратен, подойдя слишком близко, ты можешь его спугнуть.\n\n"},
    {"Тело оленя необходимо положить в багажник транспортного средства, в который поместится до 5 туш.\n"},
    {"Продать их можно в любой момент на территории охотничьего лагеря."}
};

new RailwayFactoryInfoList[][] = {
    {""W"Эта работа заключается в изготовлении рельс, которые обеспечивают бесперебойное движение поездов\n"},
    {"и трамваев по всему штату.\n\n"},
    {"Для начала выполнения работы, Вам необходимо определиться с профессией и начать рабочий день.\n\n"},
    {"Всего доступно 3 професии: Грузчик, Водитель груподъемника и Сварщик. Каждая профессия отличается\n"},
    {"своими поставленными задачами. Грузчик разгружает прицепы с металлом и древесиной. Водитель\n"},
    {"грузоподъемника занимается тем же, но с применением транспортного средства. Сварщик изготавливает\n"},
    {"рельсы из металла и древесины.\n\n"},
    {"Для устройства на некоторые профессии есть критерий в виде навыка, ведь с его повышением, заработная\n"},
    {"плата повышается в несколько раз.\n\n"},
    {"Чтобы начать, выберите профессию, наденьте рабочую форму и следуйте указаниям."}
};

new CarFactoryInfoList[][] = {
    {""W"Ежедневно в нашем штате происходит оборот транспортных средств, а для его поддержания их необходимо собирать.\n\n"},
    {"Транспортное средство собирается в несколько этапов: сборка ходовой, двигателя, кузова, покраска и установка тюнинга.\n\n"},
    {"Для начала выполнения работы, Вам необходимо начать рабочий день, определиться с этапом сборки транспортного средства,\n"},
    {"взять для него специальные запчасти, после чего подойти к полосе передвижения транспортного средства, дождаться его и\n"},
    {"начать процесс выполнения работы с мини-игрой Y/N.\n\n"},
    {"За каждое верное действие в мини-игре, Вам начисляется прогресс в виде 5 единиц, а в случае неверного действия - прогресс\n"},
    {"отнимается в том же количестве. Чтобы транспортное средство перешло на следующий этап, прогресс должен быть равен 100 единицам.\n\n"},
    {"После завершения всех этапов сборки, транспортное средство отправляется в автосалон и его можно приобрести."}
};

new FarmInfoList[][] = {
    {""W"Именно благодаря фермерам на наших столах всегда есть свежий хлеб и вкусное молоко. Работа фермером\n"},
    {"включает в себя 5 профессий: сборщик апельсинов, дояр, водитель трактора, водитель комбайна и развозчик\n"},
    {"продуктов.\n\n"},
    {"На данной работе, как и на всех остальных, имеются навыки. Для сборщика апельсинов навык не требуется, для\n"},
    {"дояра - требуется навык 5 уровня, для водителя трактора - 10 уровня, для водителя кобмайна - 20 уровня\n"},
    {"и для развозчика продуктов - 30 уровня.\n\n"},
    {"Чтобы начать, наденьте рабочую форму и следуйте указаниям."}
};

new ConstructionInfoList[][] = {
    {""W"Урбанизация нашего округа идет небывалыми темпами, каждый день где-то строится новое здание. На этом можно хорошо\n"},
    {"заработать!\n\n"},
    {"Вашей задачей станет осуществление разнообразных строительных работ. Для трудоустройства на выбор доступно 3 профессии:\n"},
    {"грузчик и водитель грузоподъёмника.\n\n"},
    {"На данной работе, как и на всех остальных, имеются навыки. Для работы грузчиком навык не требуется и для\n"},
    {"водителя грузоподъёмника - требуется навык 15 уровня.\n\n"},
    {"Чтобы начать, наденьте рабочую форму и следуйте указаниям."}
};

new SpaceInfoList[][] = {
    {""W"Космическая программа нашего стата развивается очень стремительно, поэтому к полетам допускаются не только профессиональные\n"},
    {"астронавты, но и рядовые добровольцы, желающие покорить эти бескрайние просторы.\n\n"},
    {"Вам необходимо зарегистрироваться на полет, дождаться вылета ракеты, а по прибытию на инопланетную станцию приступить к добыче\n"},
    {"ископаемых и исследованию поверхности.\n\n"},
    {"Чтобы начать, наденьте рабочую форму и следуйте указаниям."}
};

new RobberInfoList[][] = {
    {""W"Работа грабителя - один из вариантов заработка. Несмотря на то, что работа достаточно опасна и криминальна, она может приносить\n"},
    {"хороший доход.\n\n"},
    {"Ограбления можно осуществлять как в одиночку, так и командой в 4 человека. Один из грабителей должен арендовать транспорт и\n"},
    {"пригласить остальных присоединиться к команде (/party).\n\n"},
    {"Когда команда сформирована, водитель команды должен взять заказ на грабеж, после чего соответствующий дом отобразится у всех\n"},
    {"на карте. Если же водитель сначала возьмет заказ, а потом пригласит игроков в команду (/party), то у них не будет отображаться\n"},
    {"выбранный дом, значит, что и ограбить они его не смогут, и будут вынуждены ждать, пока водитель сам выполнит этот заказ. Чтобы\n"},
    {"покинуть команду, введите (/leaveparty).\n\n"},
    {"Когда грабители доберутся до нужного здания, им нужно попасть вовнутрь и перетащить в транспорт 10 предметов, за которые можно\n"},
    {"получить деньги: бытовая техника, предметы роскоши и т.п.\n\n"},
    {"Когда все награбленное окажется в транспорте, грабителям необхобимо отправиться в точку сбыта и, соответственно, получить деньги\n"},
    {"за работу.\n\n"},
    {"Предметы в домах, доступных для ограбления, респавнятся каждый час после PayDay. Это значит, что если вы ограбили определенный\n"},
    {"дом, то повторить работу с этим же домом не получится, и надо браться за другие заказы.\n\n"},
    {"Оплата за работу напрямую зависит от количества участников ограбления и количества украденных предметов. Как не странно, работать\n"},
    {"одному не так выгодно, ведь даже несмотря на то, что оплата достанется одному человеку, за одно и то же время перетащить предметов\n"},
    {"он сможет намного меньше, чем трое или четверо грабителей.\n\n"},
    {"Распределение оплаты на работе:\n"},
    {"1 грабитель = стандартная оплата работы\n"},
    {"2 грабителя = стандартная оплата + 10 процентов бонус\n"},
    {"3 грабителя = стандартная оплата + 20 процентов  бонус\n"},
    {"4 грабителя = стандартная оплата + 30 процентов  бонус"}
};

new TheftCarInfoList[][] = {
    {""W"Наш штат очень славится криминальными заработками и в дополнение ко всем остальным заработкам появится возможность угона\n"},
    {"автомобилей.\n\n"},
    {"Для начала работы, Вам необходимо запустить рабочий день, выбрать класс автомобиля, который желаете угнать и отправиться\n"},
    {"на место, где последний раз был замечен данный автомобиль. После прибытия на место, Вам необходимо взломать замок, сесть\n"},
    {"в автомобиль и доставить его в определенное место.\n\n"},
    {"На данной работе, как и на всех остальных, имеются навыки. Для угона автомобиля Nope-класса навык не требуется, для\n"},
    {"C-класса - требуется навык 15 уровня, B-класса - 30 уровня и A-класса - 50 уровня.\n\n"},
    {"За каждый класс автомобиля начисляется разная заработная плата: Nope-класс - 2500$, C-класс - 5000$, B-класс - 7500$\n"},
    {"и A-класс - 10000$.\n\n"},
    {"За каждый успешный угон автомобиля, прогресс навыков увеличивается, а за неудачный - снижается."}
};

enum F_INFO
{
    fStatus,
    fObject[5],
    Float:fPos[5 * 3],
    fCity[18]
};

