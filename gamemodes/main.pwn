            {
                if(p_info[i][phone_number] == AdvertInfo[idx][aPhone])
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[Пресса] %s %s [%d] отклонил Ваше объявление. Причина: %s", GetPlayerFractionRangName(playerid), get_name(playerid), playerid, text);
                    SendInfo(i, STRING_GLOBAL);
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[Пресса] Объявление: %s.", AdvertInfo[idx][aText]);
                    SendInfo(i, STRING_GLOBAL);
                    break;
                }
