CMD:go(playerid, params[])
{
    if(p_temp[playerid][h_buy_int] != -1)
        return SendError(playerid, "�� � ������ ����� ���������. ������� �� ����, ����� �������� ������.");
    if(p_temp[playerid][h_repair_txtid] != -1)
        return SendError(playerid, "�� � ������ �������. ������� �� ����, ����� �������� ������.");
    if(TeleportInMP == false) return SendError(playerid, "�� ������ ������ ������������ �� ����������� �������.");
    if(p_info[playerid][jail] != 0 || p_info[playerid][jail_time] != 0) return SendError(playerid, "������ ����������������� �� ������.");
    if(p_temp[playerid][BeingInSpace] == true || p_temp[playerid][SpaceFlightStatus] == true) return SendError(playerid, "������ ����������������� �� �������.");
    if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "�� ���������� � ������������ ��������.");
    if(p_temp[playerid][tTied]) return SendError(playerid, "�� �������.");
    if(GetPVarInt(playerid, "PlayerCuffed") == 1) return SendError(playerid, "�� � ����������.");

    if(RegisterRace[playerid] == 2) return SendError(playerid, "�� ����� ����� ��������� ����������������� �� �����������.");
    if(RegisterDerby[playerid] == 2) return SendError(playerid, "�� ����� ����� ��������� ����������������� �� �����������.");
    if(RegisterPaintBall[playerid] == 2) return SendError(playerid, "�� ����� ��������� ��������� ����������������� �� �����������.");
    if(p_temp[playerid][cossack_robbers_register] == 2) return SendError(playerid, "�� ����� �������-����������� ��������� ����������������� �� �����������.");
    if(player_lobby_status[playerid] == true) return SendError(playerid, "�������� � ����� ��������� ����������������� �� �����������.");
    if(p_temp[playerid][chase_followerId] != INVALID_PLAYER_ID) return SendError(playerid, "�� ����� ������ ��������� ����������������� �� �����������.");

    SetPlayerPos(playerid, 1421.7180,-1623.7816,13.5469);
    SetPlayerFacingAngle(playerid, -90.0074);
    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, 0);
    SetCameraBehindPlayer(playerid);
    SendAccess(playerid, "�� ����������������� �� �����������.");
    SendInfo(playerid, "��� ����������� �� ����������� ������� � �������� � �����������������.");
    return 1;
}

ClearDuel(duel_id, playerid)
{
    new bool:bClear = false;
    if(DuelData[duel_id][dCommand1][0] == playerid || DuelData[duel_id][dCommand2][0] == playerid) bClear = true;
    for(new i; i < 10; i++)
    {
        if((bClear && DuelData[duel_id][dCommand1][i] != INVALID_PLAYER_ID) || DuelData[duel_id][dCommand1][i] == playerid)
        {
            SendInfo(DuelData[duel_id][dCommand1][i], "%s", bClear ? "��������� ����� ������ ��." : "�������� ������� �����.");
            p_temp[DuelData[duel_id][dCommand1][i]][DuelID] = INVALID_PLAYER_ID;
            DuelData[duel_id][dCommand1][i] = INVALID_PLAYER_ID;
        }
        if((bClear && DuelData[duel_id][dCommand2][i] != INVALID_PLAYER_ID) || DuelData[duel_id][dCommand2][i] == playerid)
        {
            SendInfo(DuelData[duel_id][dCommand2][i], "%s", bClear ? "��������� ����� ������ ��." : "�������� ������� �����.");
            p_temp[DuelData[duel_id][dCommand2][i]][DuelID] = INVALID_PLAYER_ID;
            DuelData[duel_id][dCommand2][i] = INVALID_PLAYER_ID;
        }
    }
}

