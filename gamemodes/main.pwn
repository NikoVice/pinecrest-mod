forward OnLoadStatsBizz(playerid, bizz_id, type);
public OnLoadStatsBizz(playerid, bizz_id, type)
{
    STRING_GLOBAL[0] = EOS;
    if(type)
    {
        f(STRING_GLOBAL, ""W"\
            Номер бизнеса: %d\n\
            Название бизнеса: %s\n\
            Тип бизнеса: %s\n\
            Стоимость бизнеса: %d$\n\n", bizz_id, b_info[bizz_id][_name], bizz_type_name[b_info[bizz_id][_tip]], b_info[bizz_id][_price]);
    }

    if(cache_num_rows())
    {
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{FFA500}Статистика доходов за последние 7 дней:\n\n", STRING_GLOBAL);

        static const
            month_names[12][9] =
            {
                "января", "февраля", "марта", "апреля", "мая", "июня",
                "июля", "августа", "сентября", "октября", "ноября", "декабря"
            },
            month_days[12] ={31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};

        new year, month, day, total_buff;
        getdate(year, month, day);

        if(day >= 7)
        {
            for(new i, buff; i < 7; i++)
            {
                cache_get_value_index_int(0, i+1, buff);
                total_buff += buff;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}%02d %s %04d\t\t{00FF00}%d$\n", STRING_GLOBAL, day-7+i + 1, month_names[month-1], year, buff);
            }
        }
        else
        {
            if(month != 1) month -= 1;
            else
            {
                month = 12;
                year-=1;
            }

            new i = 0,
                d = month_days[month-1] + day-7 + 1,
                last_iter = month_days[month-1]+1,
                buff;

            for(; d < last_iter; i++, d++)
            {
                cache_get_value_index_int(0, i+1, buff);
                total_buff += buff;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}%02d %s %04d\t\t{00FF00}%d$\n", STRING_GLOBAL, d, month_names[month-1], year, buff);//6+2+sizeof(month_names[])-1+4+11
            }

            if(month == 12)
            {
                year++;
                month = 1;
            }
            else month++;
            d = 1;
            last_iter = day;
            for(; d <= last_iter; i++, d++)
            {
                cache_get_value_index_int(0, i+1, buff);
                total_buff += buff;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}%02d %s %04d\t\t{00FF00}%d$\n", STRING_GLOBAL, d, month_names[month-1], year, buff);//6+2+sizeof(month_names[])-1+4+11
            }
        }
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s\nВсего: %d$", STRING_GLOBAL, total_buff);
    }
    else strcat(STRING_GLOBAL, "Статистики нет.");
    if(!type) ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Статистика доходов за неделю", STRING_GLOBAL, "Закрыть", "");
    else ShowPlayerDialog(playerid, D_EXCHANGE_PREVIEW_INFO, DIALOG_STYLE_MSGBOX, ""I"Бизнес", STRING_GLOBAL, "Назад", "");
    return 1;
}

ConvertNumber(input_value)
{
    new string_value[64], billions, millions, thousand, units;
    string_value = "ERROR INPUT VALUE";
    if(input_value < -1_999_999_999 || input_value > 1_999_999_999) return string_value;
    if(input_value >= 1_000_000_000)  billions = input_value/1_000_000_000;
    if(input_value >= 1_000_000)      millions = (input_value-billions*1_000_000_000)/1_000_000;
    if(input_value >= 1_000)          thousand = (input_value-(billions*1_000_000_000)-(millions*1_000_000))/1_000;
    units = (input_value-(billions*1_000_000_000)-(millions*1_000_000)-(thousand*1_000));
    if(billions > 0) f(string_value, "%d млрд %d млн %d тыс. %d$ (%d)", billions, millions, thousand, units, input_value);
    else if(millions > 0) f(string_value, "%d млн %d тыс. %d$ (%d$)", millions, thousand, units, input_value);
    else if(thousand > 0) f(string_value, "%d тыс. %d$ (%d$)", thousand, units, input_value);
    else f(string_value, "%d$", units);
    return string_value;
}

