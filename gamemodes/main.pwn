CMD:startmp(playerid, params[])
{
    if(p_info[playerid][admin] < 2 && p_info[playerid][youtube_adm] < 3) return 1;
    if(sscanf(params, "is[144]", params[0], params[1])) return SendInfo(playerid, "�����������: /startmp [���-�� �������] [�������� �����������]");
    if(AidPlayers > 0) return SendError(playerid, "� ������ ������ ��� ���� ���� ������� �� �����������.");
    if(params[0] < 1 || params[0] > 100) return SendError(playerid, "���-�� ������� ������ ���� �� ����� 1 � �� ����� 100.");
    if(strlen(params[1]) < 3) return SendError(playerid, "�������� ������ ���� �� ����� 3 ��������.");
    AidPlayers = params[0];
    MP_PARAMS[1] = GetPlayerInterior(playerid);
    MP_PARAMS[0] = GetPlayerVirtualWorld(playerid);
    GetPlayerPos(playerid,MP_POS[0],MP_POS[1],MP_POS[2]);

    SendMesAll(0xFFD700FF, "������������� %s [%d] ������� ����������� \"%s\".", get_name(playerid), playerid, params[1]);
    SendMesAll(0xFFD700FF, "������������ ���������� �������: %d.", params[0]);
    SendMesAll(0xFFD700FF, "������� /gomp, ����� ������� ������� � �����������.");

    SendInfo(playerid, "��������� ���� ������� �� �����������: /stopmp");
    return 1;
}
CMD:stopmp(playerid, params[])
{
    if(p_info[playerid][admin] < 2 && p_info[playerid][youtube_adm] < 3) return 1;
    if(!AidPlayers) return SendError(playerid, "� ������ ������ ��� ����� ������� �� �����������.");
    MP_PARAMS[0] = 0;
    MP_PARAMS[1] = 0;
    AidPlayers = 0;
    MP_POS[0] =
    MP_POS[1] =
    MP_POS[2] = 0.0;
    SendMesAll(0xFFD700FF, "������������� %s [%d] �������� ���� ������� �� �����������.", get_name(playerid), playerid);
    return 1;
}
CMD:gomp(playerid, params[])
{
    if(p_temp[playerid][h_buy_int] != -1)
        return SendError(playerid, "�� � ������ ����� ���������. ������� �� ����, ����� �������� ������.");
    if(p_temp[playerid][h_repair_txtid] != -1)
        return SendError(playerid, "�� � ������ �������. ������� �� ����, ����� �������� ������.");
    if(AidPlayers == 0) return SendError(playerid, "� ������ ������ ��� ����� ������� �� �����������.");
    if(p_info[playerid][jail] != 0 || p_info[playerid][jail_time] != 0) return SendError(playerid, "������ ����������������� �� ������.");
    if(p_temp[playerid][BeingInSpace] == true || p_temp[playerid][SpaceFlightStatus] == true) return SendError(playerid, "������ ����������������� �� �������.");
    if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "�� ���������� � ������������ ��������.");
    if(p_temp[playerid][tTied]) return SendError(playerid, "�� �������.");
    if(GetPVarInt(playerid, "PlayerCuffed") == 1) return SendError(playerid, "�� � ����������.");

    if(RegisterRace[playerid] == 2) return SendError(playerid, "�� ����� ����� ��������� ����������������� �� �����������.");
    if(RegisterDerby[playerid] == 2) return SendError(playerid, "�� ����� ����� ��������� ����������������� �� �����������.");
    if(RegisterPaintBall[playerid] == 2) return SendError(playerid, "�� ����� ��������� ��������� ����������������� �� �����������.");
    if(p_temp[playerid][cossack_robbers_register] == 2) return SendError(playerid, "�� ����� �������-����������� ��������� ����������������� �� �����������.");
    if(player_lobby_status[playerid] == true) return SendError(playerid, "�������� � ����� ��������� ����������������� �� �����������.");
    if(GetPVarInt(playerid, "UseGOMP") > timestamp) return SendError(playerid, "�� �� ������ ��� ����� ������������ ������ ��������.");
    SetPVarInt(playerid, "UseGOMP", timestamp+30);
    SetPlayerPos(playerid,MP_POS[0]+random(5),MP_POS[1]+random(5),MP_POS[2]+0.1);
    SetPlayerVirtualWorld(playerid, MP_PARAMS[0]);
    SetPlayerInterior(playerid, MP_PARAMS[1]);
    SetCameraBehindPlayer(playerid);
    SendAccess(playerid, "�� ���� ��������������� �� �����������, �������� �������� �������������.");
    if(AidPlayers == 1)
    {
        SendMesAll(0xFFD700FF, "�������� �� ����������� ��������.");

        MP_PARAMS[0] = 0;
        MP_PARAMS[1] = 0;
        MP_POS[0] =
        MP_POS[1] =
        MP_POS[2] = 0.0;
    }
    AidPlayers--;
    if(AidPlayers <= 0) AidPlayers = 0;
    return 1;
}

CMD:eject(playerid, params[])
{
    if(0 == IsPlayerInAnyVehicle(playerid))
        return SendError(playerid, "�� ������ ���������� � ������������ ��������.");

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return SendError(playerid, "�� ������ ���������� �� ����� ������������� ��������.");

    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "�����������: /eject [id ������]");

    if(params[0] == INVALID_PLAYER_ID || params[0] == playerid)
        return SendError(playerid, "����� �� ������.");

    if(0 == IsPlayerInVehicle(params[0], GetPlayerVehicleID(playerid)))
        return SendError(playerid, "����� �� ��������� � ����� ������������ ��������.");

    SendAccess(playerid, "�� ��������� %s [%d] �� ������������� ��������.", get_name(params[0]), params[0]);

    RemovePlayerFromVehicle(params[0]);
    Fix_TogglePlayerControllable(params[0], 1);

    if(GetPVarType(params[0], "PlayerCuffed") == PLAYER_VARTYPE_INT)
    {
        SendInfo(params[0], "%s [%d] �������� ��� �� ������������� �������� � ��� ������� ��������� ���������.", get_name(playerid), playerid);

        SetPlayerSpecialAction(params[0], SPECIAL_ACTION_NONE);
        DeletePVar(params[0], "PlayerCuffed");
    }
    else SendInfo(params[0], "%s [%d] �������� ��� �� ������������� ��������.", get_name(playerid), playerid);

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "����� ������ �������.");
        MeAction(playerid, "������ ����� ���������� ��������� �� ��������...");
        MeAction(playerid, "����� ��������� ��� �� ���������� ������ �� ����� �����");
    }
    return 1;
}
CMD:ceject(playerid, params[])
{
    if(!IsPlayerFractionPolice(playerid))
        return SendError(playerid, "�� �� ������ ������������ ���� ��������.");

    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "�����������: /ceject [id ������]");

    if(params[0] == INVALID_PLAYER_ID || params[0] == playerid)
        return SendError(playerid, "����� �� ������.");

    new
        player_state = GetPlayerState(playerid);

    if(player_state == PLAYER_STATE_WASTED || GetPlayerState(params[0]) == PLAYER_STATE_WASTED)
        return 1;

    if(player_state != PLAYER_STATE_ONFOOT)
        return SendError(playerid, "�� ������ ���������� �� �����, ����� ��������� ������ ��������.");

    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID)
        return SendError(playerid, "����� ������� ������ �� ���.");

    if(0 == IsPlayerInAnyVehicle(params[0]))
        return SendError(playerid, "����� �� � ����������� ��������.");

    new
        string[60 - 4 + MAX_PLAYER_NAME*2];

    format(string, sizeof(string), "{B17FC8}����������� %s ������� %s �� ������������� ��������.", get_name(playerid), get_name(params[0]));
    SendDistanceChat(playerid, 20.0, string);

    GameTextForPlayer(params[0], "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~EJECTED", 3000, 3);
    RemovePlayerFromVehicle(params[0]);

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "����� ������ �������.");
        MeAction(playerid, "������ ����� ���������� ��������� �� ����������...");
        MeAction(playerid, "...����� ��������� ��� �� ���������� ������ �� ����� �����");
    }
    return 1;
}

//alias:shout("s");
CMD:s(playerid, params[])
{
    if(p_info[playerid][mute] > 0)
    {
        SendError(playerid, "� ��� ���������� ����.");
        return 0;
    }
    else if(isnull(params) || strlen(params) > 100) return SendInfo(playerid, "�����������: /s [�����]");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s [%d] �������: %s", get_name(playerid),playerid,params);
    ProxDetector(30.0, playerid, STRING_GLOBAL, COLOR_GREEN, COLOR_GREEN, COLOR_GREEN, COLOR_GREEN, COLOR_GREEN);
    SetPlayerChatBubble(playerid, STRING_GLOBAL, COLOR_GREEN, 60.0, 10000);
    if(GetPlayerStatusUseAnim(playerid))
    {
        ApplyAnimationFix(playerid, "ON_LOOKERS", "shout_01", 4.1);
        p_temp[playerid][ClearAnimFix] = 1;
        p_temp[playerid][ClearAnimTimerFix] = timestamp + 5;
    }
    return 1;
}

CMD:time(playerid, params[])
{
    sscanf(params, "i", params[0]);
    if(params[0] < 0 || params[0] > 1) return SendError(playerid, "��� ������ ���� �� ����� 0 � �� ����� 1.");
    if(params[0] == 1 && GetPVarInt(playerid, "PlayerCuffed") == 1) return SendError(playerid, "�� � ����������, �����������: /time");
    if(p_info[playerid][mute] > 0) SendInfo(playerid, "�� ��������� ���������� ����: %s.", ConvertTime(p_info[playerid][mute]));
    if(p_info[playerid][jail_time] > 0) SendInfo(playerid, "�� ��������� ��������� �����: %s.", ConvertTime(p_info[playerid][jail_time]));
    if(p_info[playerid][rmute] > 0) SendInfo(playerid, "�� ��������� ���������� �������: %s.", ConvertTime(p_info[playerid][rmute]));
    if(p_info[playerid][family_mute] > 0)
    {
        if(GetPlayerFamilyID(playerid) == -1) p_info[playerid][family_mute] = 0;
        else SendInfo(playerid, "�� ��������� ���������� ���� �����: %s.", ConvertTime(p_info[playerid][family_mute]));
    }

    new tdate[32], time[32];
    new year, month, day;
    getdate(year, month, day);
    new month_name[12][12] = {"������", "�������", "�����", "������", "���", "����", "����", "�������", "��������", "�������", "������", "�������"};
    format(tdate, sizeof(tdate), "%d %s %d �", day, month_name[month-1], year);
    if(timestamp_minute < 10) format(time, sizeof(time), "%d:0%d", timestamp_hour, timestamp_minute);
    else format(time, sizeof(time), "%d:%d", timestamp_hour, timestamp_minute);
    new day_name[7][12] = {"�������", "�������", "�������", "�����������", "�����������", "�������", "�����"};

    #if ACTION_100_HOUR == 1
        SendMes(playerid, COLOR_DARKORANGE, "[����� �� 100 ����� ����]: �������� "W"Silver VIP �� 14 ���� � Nissan 370Z (RealCars). {FF6600}��������: %s.", ConvertTime(p_info[playerid][gift_promocode_time]));
    #endif

    if(params[0] == 1)
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
        ����������� ����: {"#cGREEN"}%s"W"\n\
        ���� ������: {"#cGREEN"}%s"W"\n\
        ������� �����: {"#cBLUE"}%s"W"\n\n\
        ����� � ���� �� ���: {"#cGREEN"}%d ���"W"\n\
        ����� � ���� �� �������: {"#cYELLOW"}%s"W"\n\
        ����� � ���� �� �����: {"#cYELLOW"}%s"W"\n\n\
        AFK �� �������: "I"%s"W"\n\
        AFK �� �����: "I"%s"W"\n\n\
        �������� �����: {"#cLIGHTRED"}%s"W"\n\n\
        �� ��������� ���������� �������: {"#cGREEN"}%s",
        tdate, day_name[getDayEx()], time,
        p_info[playerid][p_time_payday]/60,
        ConvertTime(p_info[playerid][p_time_today]),
        ConvertTime(p_info[playerid][p_time_yesterday]),
        ConvertTime(p_info[playerid][p_afk_today]),
        ConvertTime(p_info[playerid][p_afk_yesterday]),
        ConvertTime(p_info[playerid][p_game_time]),
        ConvertTime(GetPlayerRouletteTime(playerid) - p_info[playerid][free_roulette_time]));
        ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"�����", STRING_GLOBAL, "��", "");
    }
    else SendInfo(playerid, "��� ��������� ���������� �����������: /time 1");

    new string[144];
    format(string, sizeof(string), "~y~%d:%02d ~n~~b~%02d-%d-%d", timestamp_hour, timestamp_minute, day, month, year);
    GameTextForPlayer(playerid, string, 5000, 1);
    MeAction(playerid, "��������(�) �� ����.");

    if(GetPlayerStatusUseAnim(playerid))
    {
        ApplyAnimation(playerid,"COP_AMBIENT","Coplook_watch", 4.0, 0, 1, 1, 1, 1);
        p_temp[playerid][ClearAnimFix] = 1;
        p_temp[playerid][ClearAnimTimerFix] = timestamp + 5;
    }
    return 1;
}

CMD:alogin(playerid, params[])
{
