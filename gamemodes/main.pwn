                SendInfo(playerid, "[13] Автосервис | [14] Ларек с едой | [15] Магазин рыбака");
                SendInfo(playerid, "[16] Рекламное агентство | [17] Мастерская одежды | [18] Магазин солнечных панелей");
                SendInfo(playerid, "[19] Магазин видеокарт | [20] Электростанция | [21] Биржа труда");
                SendInfo(playerid, "[22] Тюнинг центр | [23] Таксопарк | [24] Транспортная компания");
