CMD:rstats(playerid, params[])
{
    if(p_info[playerid][member] != RADIO_LS && p_info[playerid][member] != RADIO_SF && p_info[playerid][member] != RADIO_LV) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(p_info[playerid][rang] < 9)
    {
        ShowFinancStatDialog(playerid, playerid);
        return 1;
    }
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "�����������: /rstats [id ������]");
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "����� �� ������.");
    if(IsPlayerConnected(params[0]) == 0) return SendError(playerid, "����� �� ������.");
    if(distance(playerid, params[0]) > 3.0 || GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING) return SendError(playerid, "����� ������ �� ���.");

    ShowFinancStatDialog(playerid, params[0]);
    return 1;
}

ShowFinancStatDialog(playerid, targetid)
{
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `edit_advertise` WHERE `user_id` = %d LIMIT 1",
        p_info[playerid][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL, "FinancStatsSNN", "ii", playerid, targetid);
    return 1;
}

forward FinancStatsSNN(playerid, targetid);
public FinancStatsSNN(playerid, targetid)
{
    if(!cache_num_rows())
        return 0;

    static const
    month_names[12][9] =
    {
        "������", "�������", "�����", "������", "���", "����",
        "����", "�������", "��������", "�������", "������", "�������"
    },
    month_days[12] =
    {
        31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31
    };

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "���������� ���������� ���: %s\n", get_name(playerid));
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%s\n", STRING_GLOBAL, GetFractionName(p_info[playerid][member]));
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s���������: %s [%d]\n\n\n", STRING_GLOBAL, GetPlayerFractionRangName(playerid), p_info[playerid][rang]);

    new year, month, day, total_buff;
    getdate(year, month, day);

    if(day >= 7)
    {
        for(new i, buff; i < 7; i++)
        {
            cache_get_value_index_int(0, i+1, buff);
            total_buff += buff;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}%02d %s %04d:\t\t{00FF00}%d\n", STRING_GLOBAL, day-7+i + 1, month_names[month-1], year, buff);
        }
    }
    else
    {
        if(month != 1) month-=1;
        else
        {
            month = 12;
            year-=1;
        }

        new i,
            d = month_days[month-1] + day-7 + 1,
            last_iter = month_days[month-1]+1,
            buff;

        for(; d < last_iter; i++, d++)
        {
            cache_get_value_index_int(0, i+1, buff);
            total_buff += buff;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}%02d %s %04d:\t\t{00FF00}%d\n", STRING_GLOBAL, d, month_names[month-1], year, buff);
        }

        if(month == 12)
        {
            year++;
            month = 1;
        }
        else month++;
        d = 1;
        last_iter = day;
        for(; d <= last_iter; i++, d++)
        {
            cache_get_value_index_int(0, i+1, buff);
            total_buff += buff;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}%02d %s %04d:\t\t{00FF00}%d\n", STRING_GLOBAL, d, month_names[month-1], year, buff);
        }
    }
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s\n����� ���������������: %d", STRING_GLOBAL, total_buff);
    ShowPlayerDialog(targetid, 0, DIALOG_STYLE_MSGBOX, ""I"����������", STRING_GLOBAL, "��", "");
    return 1;
}

forward OnMemoryCheckPlayerID(playerid);
