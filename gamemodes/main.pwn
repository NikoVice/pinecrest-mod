                return SendError(playerid, "Приобретение номеров доступно только на личном транспортном средстве.");
            if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_MOTO && GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_CAR)
                return SendError(playerid, "Приобретение номеров доступно только на мотоциклах и автомобилях.");
            format(veh_info[vehicleid][v_number], 16, "SA %d %s", veh_number, size_veh_num == 3 ? "S" : size_veh_num == 4 ? "A" : "D");
            SaveVehicle(vehicleid);
