                            strcat(STRING_GLOBAL, "/sellgunlic - продать лицензию на оружие\n");
                            strcat(STRING_GLOBAL, "/udo - показать удостоверение\n");
                            strcat(STRING_GLOBAL, "/cuff - надеть наручники на игрока\n");
                            strcat(STRING_GLOBAL, "/uncuff - снять наручники с игрока\n");
