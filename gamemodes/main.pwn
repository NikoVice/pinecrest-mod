}

forward MysqlCheckPhoneNumber(playerid);
public MysqlCheckPhoneNumber(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(rows) return SendError(playerid, "������ ����� �������� �����."), ShowPlayerDialog(playerid,44,1,""I"�������� ����� ��������",""W"������� ����� ����� ��������:\n\n{"#cLIGHTRED"}�������� ��������! ����� �������� ������ �������� �� 6 ����.","�����","������"), DeletePVar(playerid, "NumberPhone"), PhoneBuyNumber = false;

    new number = GetPVarInt(playerid, "NumberPhone");
    DeletePVar(playerid, "NumberPhone");

    p_info[playerid][phone_number] = number;
    MysqlUpdatePlayerInt(playerid, "phone_number", p_info[playerid][phone_number]);

    SendAccess(playerid, "�� ��������� ����� �������� %d.", p_info[playerid][phone_number]);

    new bizid = GetPVarInt(playerid, "bID"), till = b_info[bizid][_till];

    new price = 1000 * till, prod = price / 100;
    if(b_info[bizid][_prod] >= prod)
    {
        b_info[bizid][_prod] -= prod;
        b_info[bizid][_bank] += (price / 100) * 90;
        AddMafiaBank(bizid, price/10);

        biz_finka[bizid] += (price / 100) * 90;
        UpdateIntForFinanceBiz(bizid, (price / 100) * 90);
    }
    OnServerInfoForMoney[10] += price;
    SetPlayerMoney(playerid, -price, true, "����� ��������/����� �������� (%d)", p_info[playerid][phone_number]);

    PhoneBuyNumber = false;
    return 1;
}

forward MysqlCheckPhoneNumberDonate(playerid);
public MysqlCheckPhoneNumberDonate(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(rows) return ShowPlayerDialog(playerid, D_DONATE_BUY_NUMBER, DIALOG_STYLE_INPUT, ""I"����� ��������", ""W"������� ����� �������� �� "I"3"W" �� "I"6"W" ����:\n\n{"#cLIGHTRED"}�������� ��������! �� ���������� ���������� ���� ������� ��������� ������ ��������.", "�����", "������"), SendError(playerid, "������ ����� �������� �����.");
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"�� ������� ���������� ����� "I"%d"W" ���������� "I"%d Pinecrest Money?", GetPVarInt(playerid, "DonateNumberPhone"), GetPVarInt(playerid, "DonateNumberPhonePrice"));
    ShowPlayerDialog(playerid, D_DONATE_BUY_NUMBER_ACT, DIALOG_STYLE_MSGBOX, ""I"����� ��������", STRING_GLOBAL, "��", "���");
    return 1;
}

public OnDynamicObjectMoved(objectid)
{
    for(new i = 0; i < totalsmachines; i++)
    {
        for(new f = 1; f <= 3; f++)
        {
            if(objectid == SlotMachine[i][sm_Objects][f])
            {
                SlotMachine[i][sm_objStop]++;
                if(SlotMachine[i][sm_objStop] == 3 && SlotMachine[i][sm_userID] != -1)
                {
                    new playerid = SlotMachine[i][sm_userID], str[128];
                    if(SlotMachine[i][sm_comb] == 0)
                    {
                        SendInfo(playerid, "�� ���������: $%d.", SlotMachine[i][sm_bet]);
                        format(str, sizeof(str), "$%d", SlotMachine[i][sm_bet]);
                        SetPlayerChatBubble(playerid, str, COLOR_RED, 20.0, 10000);
                    }
                    else
                    {
                        new winMoney = SlotMachine[i][sm_bet] * SlotMachine[i][sm_comb];
                        SendInfo(playerid, "�� ��������: $%d.", winMoney);
                        format(str, sizeof(str), "$%d", winMoney);
                        SetPlayerChatBubble(playerid, str, COLOR_GREEN, 20.0, 10000);
                        PlayerPlaySound(playerid, 4201, 0.0, 0.0, 0.0);
                        SetPlayerMoney(playerid, winMoney, true, "������� � ������� ��������");
                        format(str, sizeof(str), "~w~BALANCE: ~g~$%d.~n~~w~RATE: ~y~$%d.", p_info[playerid][cash], SlotMachine[i][sm_bet]);
                        PlayerTextDrawSetString(playerid, SlotMScoreTD[playerid], str);
                        PlayerTextDrawShow(playerid, SlotMScoreTD[playerid]);
                    }
                }
                return 1;
            }
        }
    }
    return 1;
}
public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
    if(p_temp[playerid][TextDrawPinCode] == true || p_temp[playerid][TextDrawCaptcha]) return Captcha_OnPlayerClickTextDraw(playerid, clickedid);
    if(p_info[playerid][loggedIn] != 1) return 0;
    if(p_info[playerid][exchangePartner] != INVALID_PLAYER_ID && p_temp[playerid][TextDrawTrade] == false && (
        p_temp[playerid][TextDrawShopUse] == true ||
        p_temp[playerid][TextDrawCasinoUse] == true ||
        p_temp[playerid][TextDrawInventory] == true ||
        p_temp[playerid][TextDrawCraft] == true ||
        p_temp[playerid][TextDrawBattlePass] == true ||
        p_temp[playerid][TextDrawDaily] == true ||
        p_temp[playerid][TextDrawMarket] == true ||
