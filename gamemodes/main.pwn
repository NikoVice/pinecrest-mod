TeleportVehicleToPos(vehicleid, Float:x, Float:y, Float:z, Float:angle, tv_interior = 0, tv_world = 0, bool:with_players = true)
{
    if(!IsValidVehicle(vehicleid))
        return 0;

    SetVehiclePos(vehicleid, x, y, z);
    SetVehicleZAngle(vehicleid, angle);

    LinkVehicleToInterior(vehicleid, tv_interior);
    SetVehicleVirtualWorld(vehicleid, tv_world);

    new trailerid = GetVehicleTrailer(vehicleid);
    if(trailerid != 0)
    {
        SetVehiclePos(trailerid, x, y, z);
        SetVehicleZAngle(trailerid, angle);
        LinkVehicleToInterior(trailerid, tv_interior);
        SetVehicleVirtualWorld(trailerid, tv_world);

        AttachTrailerToVehicle(trailerid, vehicleid);
    }

    if(with_players)
    {
        foreach (new playerid: Player)
        {
            if(!IsPlayerInVehicle(playerid, vehicleid))
                continue;

            SetPlayerVirtualWorld(playerid, tv_world);
            SetPlayerInterior(playerid, tv_interior);
        }
    }
    return 1;
}
forward OnMailScriptResponse(iIndex, iResponseCode, const szData[ ]);
public OnMailScriptResponse(iIndex, iResponseCode, const szData[ ])
{
    if(SRV_ID == 0)
    {
        printf("iResponseCode %d", iResponseCode);
        if(szData[0])
            printf("Mailer script says: %s", szData);
    }
}

GetPlayerStatusCapture(playerid)
{
    new frac_id = p_info[playerid][member];
    if(gang(playerid))
    {
        if(Capture_Info[0][gFaction][0] == frac_id ||
        Capture_Info[0][gFaction][1] == frac_id ||
        Capture_Info[1][gFaction][0] == frac_id ||
        Capture_Info[1][gFaction][1] == frac_id) return CAPTURE_ID_GANG;
    }
    if(biker(playerid) || mafia(playerid))
    {
        if(BizWar_Info[bMafia][0] == frac_id ||
            BizWar_Info[bMafia][1] == frac_id) return CAPTURE_ID_MAFIA;
    }
    new family_idx = GetPlayerFamilyID(playerid);
    if(family_idx != -1)
    {
        if(GetSlotFamilyCapture(family_idx, -1) != -1)
            return CAPTURE_ID_FAMILY;
    }
    for(new i; i < MAX_PAINTBALL_PLAYERS; i++)
    {
        if(PaintBallPlayers[i] == playerid)
        {
            return CAPTURE_ID_PAINTBALL;
        }
    }
    for(new i = 0, x = 0; i < MAX_COSSACK_ROBBERS_TEAM; i++)
    {
        for(x = 0; x < MAX_COSSACK_ROBBERS_PLAYERS; x++)
        {
            if(CossackRobbersPlayers[i][x] == playerid) return CAPTURE_ID_COSSACK_ROBBERS;
        }
    }
    return CAPTURE_ID_NONE;
}


forward fraction_blacklist_search(playerid);
public fraction_blacklist_search(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(rows == 0) return SendError(playerid, "Ничего не найдено.");
    new PlayerName[MAX_PLAYER_NAME], TargetName[MAX_PLAYER_NAME], blDate[24], blReason[42];

    cache_get_value_name(0, "f_bl_player_name", PlayerName);
    cache_get_value_name(0, "f_bl_target_name", TargetName);
    cache_get_value_name(0, "f_bl_date", blDate);
    cache_get_value_name(0, "f_bl_reason", blReason);

    format(STRING_GLOBAL, sizeof(STRING_GLOBAL),
        ""W"Черный список: "I"%s\n\n\
        "W"Добавил: "I"%s\n\
        "W"Игрок: "I"%s\n\
        "W"Дата: "I"%s\n\
        "W"Причина: "I"%s", GetFractionName(p_info[playerid][member]), PlayerName, TargetName, blDate, blReason);
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Черный список", STRING_GLOBAL, "Принять", "Отмена");
    return 1;
}

CMD:asetweaponskill(playerid, params[])
{
    if (p_info[playerid][admin] < 1)
        return 1;

    new targetid, skillid, value;
    if(sscanf(params, "uii", targetid, skillid, value))
    {
        SendInfo(playerid, "Использование: /asetweaponskill [ID игрока/часть ника] [ID навыка (0-9)] [уровень (0-999)]");
        SendInfo(playerid, "Навыки: 0 - Кольт .45, 1 - Кольт .45 с глуш., 2 - Desert Eagle, 3 - дробовик, 4 - обрез");
        return SendInfo(playerid, "Навыки: 5 - SPAS-12, 6 - Микро-Узи, 7 - МП5, 8 - АК-47, 9 - М4");
    }
    if (skillid < WEAPONSKILL_PISTOL || skillid > WEAPONSKILL_M4)
        return SendError(playerid, "Неправильный ID навыка.");
    if (value < 0 || value > 999)
        return SendError(playerid, "Неправильный уровень навыка.");
    return SetPlayerSkillLevel(targetid, skillid, value);
}


