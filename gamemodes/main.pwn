                        TakePlayerAttachedCostume(playerid, GetPlayerAttachedCostume(playerid), false);
                    }
                    else RemovePlayerAccessories(playerid, false);
                    return 1;
                }
                case OFFER_ID_PROPOSE:
                {
                    if(IsPlayerInRangeOfPoint(seller_id, 10.0, -1989.9000, 1117.8800, 54.4700) == 0) return SendError(seller_id, "Вы слишком далеко от церкви.");
                    if(IsPlayerInRangeOfPoint(playerid, 10.0, -1989.9000, 1117.8800, 54.4700) == 0) return SendError(playerid, "Вы слишком далеко от церкви.");
                    if(strlen(p_info[seller_id][Partner]) >= 5) return SendError(playerid, "У Вас уже есть муж или жена.");
                    if(strlen(p_info[playerid][Partner]) >= 5) return SendError(playerid, "У Вас уже есть муж или жена.");
                    if(p_info[playerid][sex] == p_info[seller_id][sex])
                    {
                        SendError(seller_id, "В штате запрещены однополные браки.");
                        SendError(playerid, "В штате запрещены однополные браки.");
                        return 1;
                    }
                    if(p_info[seller_id][cash] < 50000) return SendError(seller_id, "У Вас нет столько денег. Используйте /donate");
                    if(p_info[playerid][cash] < 50000) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                    if(strequals(p_info[seller_id][Partner], get_name(playerid))) return SendError(playerid, "Вы уже женаты.");
                    SetPlayerMoney(seller_id, -50000, true, "свадьба");
                    SetPlayerMoney(playerid, -50000, true, "свадьба");

                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Внимание! "W"%s [%d] и %s [%d] теперь муж и жена!", get_name(playerid), playerid, get_name(seller_id), seller_id);
                    SendMesAll(0xFFD700FF, STRING_GLOBAL);

                    strmid(p_info[playerid][Partner], get_name(seller_id), 0, strlen(get_name(seller_id)));
                    strmid(p_info[seller_id][Partner], get_name(playerid), 0, strlen(get_name(playerid)));

                    SendAccess(seller_id, "%s согласил(-ся/-ась) на бракосочетание за 50000$.", get_name(playerid));
                    SendInfo(playerid, "Вы согласились на бракосочетание с %s за 50000$.", get_name(seller_id));
                    return 1;
                }
                default: return SendError(playerid, "Нет предложений.");
            }

            return 1;
        }
        case D_BL_MENU:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0:
                {
                    if(p_info[playerid][rang] < 9) return SendError(playerid, "Вы не можете пользоваться этой командой.");
                    ShowPlayerDialog(playerid, D_BL_ADD, DIALOG_STYLE_INPUT, ""I"Занести в черный список", ""W"Введите ник игрока и причину через запятую:", "Далее", "Отмена");
                }
                case 1:
                {
                    if(p_info[playerid][rang] < 9) return SendError(playerid, "Вы не можете пользоваться этой командой.");
                    ShowPlayerDialog(playerid, D_BL_DELETE, DIALOG_STYLE_INPUT, ""I"Вынести из черного списка", "Введите ник игрока:", "Далее", "Отмена");
                }
                case 2: ShowPlayerList(playerid, LIST_ID_FRACTION_BLACKLIST);
                case 3: ShowPlayerDialog(playerid, D_BL_SEARCH, DIALOG_STYLE_INPUT, ""I"Поиск в чёрном списке", "Введите ник игрока:", "Далее", "Отмена");
            }
            return 1;
        }
        case D_BL_SEARCH:
        {
            if(!response) return 1;
            if(strlen(inputtext) < 2 || strlen(inputtext) > 32)
            {
                SendError(playerid, "Ник должен быть не менее 2 и не более 32 символов.");
                return ShowPlayerDialog(playerid, D_BL_SEARCH, DIALOG_STYLE_INPUT, ""I"Поиск в чёрном списке", ""W"Введите ник игрока:", "Далее", "Отмена");
            }
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL),
                "SELECT accounts.name AS f_bl_player_name, (SELECT name FROM `accounts` WHERE `id` = fraction_blacklist.f_bl_target_id) AS f_bl_target_name, fraction_blacklist.* FROM accounts \
                INNER JOIN fraction_blacklist ON accounts.id=fraction_blacklist.f_bl_player_id WHERE fraction_blacklist.f_bl_frac = %d AND f_bl_target_id = (SELECT id FROM `accounts` WHERE `name` = '%s');",
                p_info[playerid][member], inputtext);
            mysql_tquery(con_bd, STRING_GLOBAL, "fraction_blacklist_search", "d", playerid);
            return 1;
        }
        case D_BL_ADD:
        {
            if(!response) return callcmd::blacklist(playerid, "/0");
            new nickname[MAX_PLAYER_NAME], reason[144];
            if(sscanf(inputtext, "p<,>s[24]s[144]", nickname, reason)) return ShowPlayerDialog(playerid, D_BL_ADD, DIALOG_STYLE_INPUT, ""I"Занести в черный список", ""W"Введите ник игрока и причину через запятую:", "Далее", "Отмена"), SendError(playerid, "Вы ничего не ввели.");
            if(strlen(nickname) < 3 || strlen(nickname) > 22) return ShowPlayerDialog(playerid, D_BL_ADD, DIALOG_STYLE_INPUT, ""I"Занести в черный список", ""W"Введите ник игрока и причину через запятую:", "Далее", "Отмена"), SendError(playerid, "Ник должна быть не менее 3 и не более 22 символов.");
            if(strlen(reason) < 3) return ShowPlayerDialog(playerid, D_BL_ADD, DIALOG_STYLE_INPUT, ""I"Занести в черный список", ""W"Введите ник игрока и причину через запятую:", "Далее", "Отмена"), SendError(playerid, "Причина должна быть не менее 3 символов.");
            if(AdvertisingCheck(reason)) return AdvertisingPunishment(playerid, reason, 0);
            if(GetPlayerID(nickname) == INVALID_PLAYER_ID)
            {
                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id` FROM `accounts` WHERE `name` = '%e' LIMIT 1",
                nickname);
                mysql_tquery(con_bd, STRING_GLOBAL, "fraction_blacklist", "ddss", playerid, 1, nickname, reason);
            }
            else
            {
                new scdplayerid = GetPlayerID(nickname);
                p_temp[scdplayerid][bl_fraction][p_info[playerid][member]] = true;

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `fraction_blacklist` (`f_bl_frac`, `f_bl_player_id`, `f_bl_target_id`, `f_bl_date`, `f_bl_reason`) VALUES (%d, %d, %d, NOW(), '%s')",
                p_info[playerid][member], p_info[playerid][ID], p_info[scdplayerid][ID], reason);
                mysql_tquery(con_bd, STRING_GLOBAL);

                format(p_temp[scdplayerid][bl_reason][p_info[playerid][member]], 32, "%s", reason);
                SendInfo(scdplayerid, "%s внес Вас в черный список \"%s\".", get_name(playerid), GetFractionName(p_info[playerid][member]));
                SendAccess(playerid, "Вы внесли %s в черный список \"%s\".", get_name(scdplayerid), GetFractionName(p_info[playerid][member]));
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] внес %s [%d] в черный список \"%s\". Причина: %s", get_name(playerid), playerid, get_name(scdplayerid), scdplayerid, GetFractionName(p_info[playerid][member]), reason);
                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
            }
        }
        case D_BL_DELETE:
        {
            if(!response) return callcmd::blacklist(playerid, "/0");
            new nickname[MAX_PLAYER_NAME];
            if(sscanf(inputtext, "s[24]", nickname)) return ShowPlayerDialog(playerid, D_BL_DELETE, DIALOG_STYLE_INPUT, ""I"Вынести из черного списка", ""W"Введите ник игрока:", "Далее", "Отмена"), SendError(playerid, "Вы ничего не ввели.");
            if(GetPlayerID(nickname) == INVALID_PLAYER_ID)
            {
                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id` FROM `accounts` WHERE `name` = '%e' AND `member` = %d LIMIT 1",
                nickname, p_info[playerid][member]);
                mysql_tquery(con_bd, STRING_GLOBAL, "fraction_blacklist", "dds", playerid, 2, nickname);
            }
            else
            {
                new scdplayerid = GetPlayerID(nickname);
                if(p_temp[scdplayerid][bl_fraction][p_info[playerid][member]] == false) return ShowPlayerDialog(playerid, D_BL_DELETE, DIALOG_STYLE_INPUT, ""I"Вынести из черного списка", ""W"Введите ник игрока:", "Далее", "Отмена"), SendError(playerid, "Игрок не в чёрном списке.");
                p_temp[scdplayerid][bl_fraction][p_info[playerid][member]] = false;

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `fraction_blacklist` WHERE `f_bl_target_id` = %d AND `f_bl_frac` = %d",
                p_info[scdplayerid][ID], p_info[playerid][member]);
                mysql_tquery(con_bd, STRING_GLOBAL);

                format(p_temp[scdplayerid][bl_reason][p_info[playerid][member]], 32, "None");
                SendInfo(scdplayerid, "%s вынес Вас из черного списка \"%s\".", get_name(playerid), GetFractionName(p_info[playerid][member]));
                SendAccess(playerid, "Вы вынесли %s из черного списка \"%s\".", get_name(scdplayerid), GetFractionName(p_info[playerid][member]));
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] вынес %s [%d] из черного списка \"%s\".", get_name(playerid), playerid, get_name(scdplayerid), scdplayerid, GetFractionName(p_info[playerid][member]));
                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
            }
        }
        case D_DM_ZONE:
        {
            if(GetPVarInt(playerid, "advert_id_to_sending"))
            {
                AdvertInfo[GetPVarInt(playerid, "advert_id_to_sending") - 1][aIsTooked] = false;
                DeletePVar(playerid, "advert_id_to_sending");
            }
            if(p_temp[playerid][dm_zone_timer] <= 0 && p_temp[playerid][LaboratoryTimer] <= 0) Fix_TogglePlayerControllable(playerid, true);
            return 1;
        }
        case D_DAMAGE_1LVL:
        {
            Fix_TogglePlayerControllable(playerid, true);
            return 1;
        }
        case D_OBJECTS:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0: ShowPlayerDialog(playerid, D_OBJECTS_ADD, DIALOG_STYLE_INPUT, ""I"Редактор", ""W"Используйте ID объекта:", "Готово", "Отмена");
                case 1: SelectObject(playerid);
            }
        }
        case D_OBJECTS_ADD:
        {
            if(response)
            {
                if(!response) return callcmd::object(playerid, "/0");
                //printf("[OBJECT] USE NICK %s", get_name(playerid) );
                new model_obj = strval(inputtext);
                if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_OBJECTS_ADD, DIALOG_STYLE_INPUT, ""I"Редактор", ""W"Используйте ID объекта:", "Готово", "Назад");
                if(strlen(inputtext) > 5) return ShowPlayerDialog(playerid, D_OBJECTS_ADD, DIALOG_STYLE_INPUT, ""I"Редактор", ""W"Используйте ID объекта:", "Готово", "Назад");
                new
                    Float:pos_PLAYER[3],
                    Float:pos_A;

                GetPlayerPos(playerid, pos_PLAYER[0], pos_PLAYER[1], pos_PLAYER[2]);

                GetPlayerFacingAngle(playerid, pos_A);
                new objectid = CreateDynamicObject(model_obj,
                    pos_PLAYER[0] + (1.0 * floatsin(-pos_A, degrees)),
                    pos_PLAYER[1] + (1.0 * floatcos(-pos_A, degrees)),
                    pos_PLAYER[2], 0.0, 0.0, 0.0, -1, -1, -1, 120.0, 120.0);
                SetPVarInt(playerid,"SelectedObject",objectid);
                EditDynamicObject(playerid, objectid);
            }
            return 1;
        }
        case D_OBJECTS_ADD_SELECT:
        {
            if(response)
                EditDynamicObject(playerid, GetPVarInt(playerid, "SelectedObject"));
            else
            {
                if(IsValidDynamicObject(GetPVarInt(playerid, "SelectedObject"))) DestroyDynamicObject(GetPVarInt(playerid, "SelectedObject"));
                SelectObject(playerid);
            }
            return 1;
        }
        case D_THEFT_CAR:
        {
            if(!response) return 1;
            if(TheftCarIDx[playerid] != -1)
            {
                if(p_info[playerid][job_skill_count][6] > 0)
                {
                    p_info[playerid][job_skill_count][6]--;
                    SavePlayerWorkSkill(playerid);
                }
                else if(p_info[playerid][job_skill][6] > 1 && p_info[playerid][job_skill_count][6] == 0)
                {
                    p_info[playerid][job_skill][6]--;
                    p_info[playerid][job_skill_count][6] = 24;
                    SavePlayerWorkSkill(playerid);
                }
                SendMes(playerid, COLOR_BLUE, "Вы отменили контракт.");
                DestroyTheftCarVehicle(playerid);
                ClearTheftCar(playerid, TYPE_THEFT_CAR_VEHICLE);
                return 1;
            }
            if(p_temp[playerid][Work_ID] != THEFT_CAR_WORK) return StartPlayerJob(playerid, THEFT_CAR_WORK);
            if(p_temp[playerid][Work_ID] == THEFT_CAR_WORK && listitem == 4) return EndPlayerJob(playerid);
            if(p_temp[playerid][Work_ID] != THEFT_CAR_WORK) return SendError(playerid, "Вы не начали рабочий день.");
            if(!(0 <= listitem <= 3)) return SendError(playerid, "Что-то пошло не так, попробуйте заново или обновите версию клиента.");
            static v_skills[] = {0, 15, 30, 50};
            if(p_info[playerid][job_skill][6] < v_skills[listitem]) {
                SendError(playerid, "У Вас слишком маленький скилл.");
                SendMes(playerid, COLOR_LIME, "Требуется не менее %d скилла.", v_skills[listitem]);
                return 1;
            }
            p_temp[playerid][Work_ID] = THEFT_CAR_WORK;
            ClearTheftCar(playerid, TYPE_THEFT_CAR_VEHICLE);
            CreateTheftCarVehicle(playerid, listitem);
            return 1;
        }
        //=============
        case D_EXIT_SPAWN:
        {
            if(!response) p_temp[playerid][spawn_exit] = false;
            else p_temp[playerid][spawn_exit] = true;
            //TogglePlayerSpectating(playerid, false);
            SpawnPlayer(playerid);
            return 1;
        }
        case D_AUCTION_BIZZ:
        {
            if(!response) return 1;
            new b = p_temp[playerid][p_listitem][listitem];
            p_temp[playerid][p_listitem][listitem] = -1;
            p_temp[playerid][p_listitem_int] = b;
            if(b > totalbizz) return 1;
            if(b == -1) return 1;
            if(b_info[b][b_auction_bet] == 0) return 1;
            if((b_info[b][_tip] == B_TAXI || b_info[b][_tip] == B_TRUCKER) && 
                IsPlayerOwnerBizzType(playerid, b_info[b][_tip]))
                    return SendError(playerid, "У Вас уже есть %s.", b_info[b][_tip] == B_TRUCKER ? "транспортная компания":"таксопарк");
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, ""W"\
            Название бизнеса: %s\n\
            Тип бизнеса: %s\n\n\
            Текущая ставка: Скрыта\n\
            Ваша ставка должна быть больше минимум на 10 процентов.\n\
            Если Вашу ставку перебьют, Вам вернется 90 процентов от Вашей ставки.\n\n\
            До конца аукциона: %d час(-а/-ов)\n\n\
            Введите ставку:", b_info[b][_name], bizz_type_name[b_info[b][_tip]], b_info[b][b_auction_time]);//, b_info[b][b_auction_bet]);
            ShowPlayerDialog(playerid, D_AUCTION_BIZZ_BET, DIALOG_STYLE_INPUT, ""I"Аукцион бизнесов", STRING_GLOBAL, "Далее", "GPS");
            return 1;
        }
        case D_AUCTION_HOUSE:
        {
            if(!response) return 1;
            if(!(0 <= listitem <= 30)) return SendError(playerid, "Нужно вводить цифру пункта.");
            new h = p_temp[playerid][p_listitem][listitem];
            p_temp[playerid][p_listitem][listitem] = -1;
            p_temp[playerid][p_listitem_int] = h;
            if(h > totalhouses) return 1;
            if(h == INVALID_HOUSE_ID) return 1;
            if(h_info[h][h_auction_bet] == 0) return 1;
            if(h_info[h][h_delete] == 1) return 1;
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, ""W"\
            Номер дома: %d\n\
            Класс дома: %d\n\n\
            Текущая ставка: Скрыта\n\
            Ваша ставка должна быть больше минимум на 10 процентов.\n\
            Если Вашу ставку перебьют, Вам вернется 90 процентов от Вашей ставки.\n\n\
            До конца аукциона: %d час(-а/-ов)\n\n\
            Введите ставку:", h, house_class[h_info[h][h_squar]-1], h_info[h][h_auction_time]);// h_info[h][h_auction_bet]);
            ShowPlayerDialog(playerid, D_AUCTION_HOUSE_BET, DIALOG_STYLE_INPUT, ""I"Аукцион домов", STRING_GLOBAL, "Далее", "GPS");
            return 1;
        }
        case D_AUCTION_BIZZ_BET:
        {
            if(GetFreeSlotBizz(playerid) == ALL_BUSY_SLOT_BIZZ) return SendError(playerid, "У Вас нет свободного слота для бизнеса.");
            new b = p_temp[playerid][p_listitem_int];
            if(!response)
            {
                if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                SetPlayerGPS(playerid, b_info[b][b_enter][0], b_info[b][b_enter][1], b_info[b][b_enter][2], 5.0);
                return SendAccess(playerid, "Бизнес обозначен на GPS навигаторе.");
            }
            else
            {
                new fix_listitem;
                if(sscanf(inputtext, "i", fix_listitem) || !(0 <= fix_listitem <= 999_999_999))
                {
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, ""W"\
                    Название бизнеса: %s\n\
                    Тип бизнеса: %s\n\n\
                    Текущая ставка: Скрыта\n\
                    Ваша ставка должна быть больше минимум на 10 процентов.\n\
                    Если Вашу ставку перебьют, Вам вернется 90 процентов от Вашей ставки.\n\n\
                    До конца аукциона: %d час(-а/-ов)\n\n\
                    Введите ставку:", b_info[b][_name], bizz_type_name[b_info[b][_tip]], b_info[b][b_auction_time]);//, b_info[b][b_auction_bet]);
                    ShowPlayerDialog(playerid, D_AUCTION_BIZZ_BET, DIALOG_STYLE_INPUT, ""I"Аукцион бизнесов", STRING_GLOBAL, "Далее", "GPS");
                    return 1;
                }
                if(fix_listitem < b_info[b][b_auction_bet]+(b_info[b][b_auction_bet]/10) || fix_listitem > p_info[playerid][cash])
                {
                    if(fix_listitem > p_info[playerid][cash]) SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, ""W"\
                    Название бизнеса: %s\n\
                    Тип бизнеса: %s\n\n\
                    Текущая ставка: Скрыта\n\
                    Ваша ставка должна быть больше минимум на 10 процентов.\n\
                    Если Вашу ставку перебьют, Вам вернется 90 процентов от Вашей ставки.\n\n\
                    До конца аукциона: %d час(-а/-ов)\n\n\
                    Введите ставку:", b_info[b][_name], bizz_type_name[b_info[b][_tip]], b_info[b][b_auction_time]);//, b_info[b][b_auction_bet]);
                    ShowPlayerDialog(playerid, D_AUCTION_BIZZ_BET, DIALOG_STYLE_INPUT, ""I"Аукцион бизнесов", STRING_GLOBAL, "Далее", "GPS");
                    return 1;
                }

                for(new i = 0; i < totalbizz; i++)
                {
                    if(b_info[i][b_mysql_id] == INVALID_MYSQL_ID) continue;
                    if(b_info[i][b_auction_user_id] == p_info[playerid][ID]) return SendError(playerid, "У Вас уже установлена ставка на один из бизнесов.");
                }

                if(b_info[b][b_auction_time] != 0 && b_info[b][b_auction_user_id] != INVALID_MYSQL_ID)
                {
                    new i = GetPlayerUserID(b_info[b][b_auction_user_id]);
                    if(i != INVALID_PLAYER_ID)
                    {
                        Log(LOG_player, INFO, "%s[%d](%s %s)[%d$] получил %d$ за возврат ставки с аукциона бизнеса %s[%d] | #Auction",
                            get_name(i), p_info[i][ID], p_temp[i][session_IP], IsPlayerMobile(i) ? "Mobile": "PC",
                            p_info[i][bank], b_info[b][b_auction_bet]-(b_info[b][b_auction_bet]/10), b_info[b][_name], b_info[b][b_mysql_id]);

                        p_info[i][bank] += b_info[b][b_auction_bet]-(b_info[b][b_auction_bet]/10);
                        MysqlUpdatePlayerInt(i, "bank", p_info[i][bank]);
                        SendInfo(i, "Один из игроков перебил Вашу ставку.");
                        /*SendInfo(i, "%s установил ставку %d$ и перебил Вашу.", get_name(playerid), fix_listitem);*/
                        SendInfo(i, "Вам возвращено %d$ с послед. ставки(в банк).", b_info[b][b_auction_bet]-(b_info[b][b_auction_bet]/10));
                    }
                    else
                    {
                        Log(LOG_player, INFO, "NickName[%d](Offline) получил %d$ за возврат ставки с аукциона бизнеса [%d] | #Auction",
                            b_info[b][b_auction_user_id], b_info[b][b_auction_bet]-(b_info[b][b_auction_bet]/10), b_info[b][b_mysql_id]);

                        STRING_GLOBAL[0] = EOS;
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank` = `bank` + %d WHERE `id` = %d",
                        b_info[b][b_auction_bet]-(b_info[b][b_auction_bet]/10), b_info[b][b_auction_user_id]);
                        mysql_tquery(con_bd, STRING_GLOBAL);
                    }
                }
                OnServerInfoForMoney[37] += (b_info[b][b_auction_bet]/10);

                SetFractionWarehouse(MAYOR_LS, fwMoney, (b_info[b][b_auction_bet]/10));

                #if AUCTION_BIZZ == 0
                b_info[b][b_auction_time] = 3;
                #endif

                b_info[b][b_auction_user_id] = p_info[playerid][ID];
                b_info[b][b_auction_bet] = fix_listitem;
                save_bizz(b);

                SetPlayerMoney(playerid, -fix_listitem, true, "поставил ставку на бизнес <%s>(%d)[%d]", bizz_type_name[b_info[b][_tip]], b, b_info[b][b_mysql_id]);
                //p_info[playerid][bank] -= fix_listitem;
                //MysqlUpdatePlayerInt(playerid, "bank", p_info[playerid][bank]);
                SendAccess(playerid, "Вы установили ставку %d$ на этот бизнес.", fix_listitem);

                #if AUCTION_BIZZ == 0
                SendInfo(playerid, "Если Ваша ставка останется первой в течении трех часов, Вы станете владельцем бизнеса.");
                #else
                SendInfo(playerid, "Результаты будут известны через %d час(-а/-ов).", b_info[b][b_auction_time]);
                #endif
            }
            return 1;
        }
        case D_AUCTION_HOUSE_BET:
        {
            if(GetFreeSlotHouse(playerid) == ALL_BUSY_SLOT_HOUSE || p_info[playerid][key_h_rent] != INVALID_HOUSE_ID)
                return SendError(playerid, "У Вас уже есть дом или Вы подселены.");

            new h = p_temp[playerid][p_listitem_int];
            if(!response)
            {
                if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                SetPlayerGPS(playerid, h_info[h][h_enter][0], h_info[h][h_enter][1], h_info[h][h_enter][2],5.0);
                return SendAccess(playerid, "Дом обозначен на GPS навигаторе.");
            }
            else
            {
                new fix_listitem;
                if(sscanf(inputtext, "i", fix_listitem) || !(0 <= fix_listitem <= 999_999_999))
                {
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, ""W"\
                    Номер дома: %d\n\
                    Класс дома: %d\n\n\
                    Текущая ставка: Скрыта\n\
                    Ваша ставка должна быть больше минимум на 10 процентов.\n\
                    Если Вашу ставку перебьют, Вам вернется 90 процентов от Вашей ставки.\n\n\
                    До конца аукциона: %d час(-а/-ов)\n\n\
                    Введите ставку:", h, house_class[h_info[h][h_squar]-1], h_info[h][h_auction_time]);// h_info[h][h_auction_bet]);
                    ShowPlayerDialog(playerid, D_AUCTION_HOUSE_BET, DIALOG_STYLE_INPUT, ""I"Аукцион домов", STRING_GLOBAL, "Далее", "GPS");
                    return 1;
                }
                if(fix_listitem < (h_info[h][h_auction_bet]+(h_info[h][h_auction_bet]/10)) || fix_listitem > p_info[playerid][cash])
                {
                    if(fix_listitem > p_info[playerid][cash]) SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, ""W"\
                    Номер дома: %d\n\
                    Класс дома: %d\n\n\
                    Текущая ставка: Скрыта\n\
                    Ваша ставка должна быть больше минимум на 10 процентов.\n\
                    Если Вашу ставку перебьют, Вам вернется 90 процентов от Вашей ставки.\n\n\
                    До конца аукциона: %d час(-а/-ов)\n\n\
                    Введите ставку:", h, house_class[h_info[h][h_squar]-1], h_info[h][h_auction_time]);// h_info[h][h_auction_bet]);
                    ShowPlayerDialog(playerid, D_AUCTION_HOUSE_BET, DIALOG_STYLE_INPUT, ""I"Аукцион домов", STRING_GLOBAL, "Далее", "GPS");
                    return 1;
                }

                if(h_info[h][h_auction_time] != 0 && h_info[h][h_auction_user_id] != INVALID_MYSQL_ID)
                {
                    new i = GetPlayerUserID(h_info[h][h_auction_user_id]);
                    if(i != INVALID_PLAYER_ID)
                    {
                        Log(LOG_player, INFO, "%s[%d](%s %s)[%d$] получил %d$ за возврат ставки с аукциона дома [%d] | #Auction",
                            get_name(i), p_info[i][ID], p_temp[i][session_IP], IsPlayerMobile(i) ? "Mobile": "PC",
                            p_info[i][bank], h_info[h][h_auction_bet]-(h_info[h][h_auction_bet]/10), h_info[h][h_mysql_id]);

                        p_info[i][bank] += h_info[h][h_auction_bet]-(h_info[h][h_auction_bet]/10);
                        MysqlUpdatePlayerInt(i, "bank", p_info[i][bank]);
                        SendInfo(i, "Один из игроков перебил Вашу ставку.");
                        /*SendInfo(i, "%s установил ставку %d$ и перебил Вашу.", get_name(playerid), fix_listitem);*/
                        SendInfo(i, "Вам возвращено %d$ с послед. ставки(в банк).", h_info[h][h_auction_bet]-(h_info[h][h_auction_bet]/10));
                    }
                    else
                    {
                        Log(LOG_player, INFO, "NickName[%d](Offline) получил %d$ за возврат ставки с аукциона дома [%d] | #Auction",
                            h_info[h][h_auction_user_id], h_info[h][h_auction_bet]-(h_info[h][h_auction_bet]/10), h_info[h][h_mysql_id]);

                        STRING_GLOBAL[0] = EOS;
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank` = `bank` + %d WHERE `id` = %d",
                        h_info[h][h_auction_bet]-(h_info[h][h_auction_bet]/10), h_info[h][h_auction_user_id]);
                        mysql_tquery(con_bd, STRING_GLOBAL);
                    }
                }
                OnServerInfoForMoney[37] += h_info[h][h_auction_bet]/10;

                SetFractionWarehouse(MAYOR_LS, fwMoney, h_info[h][h_auction_bet]/10);

                if(h_info[h][h_boat_status] != 1) h_info[h][h_auction_time] = 3;
                h_info[h][h_auction_user_id] = p_info[playerid][ID];
                h_info[h][h_auction_bet] = fix_listitem;
                save_house(h);

                SetPlayerMoney(playerid, -fix_listitem, true, "поставил ставку на дом (%d)[%d]", h, h_info[h][h_mysql_id]);
                //p_info[playerid][bank] -= fix_listitem;
                //MysqlUpdatePlayerInt(playerid, "bank", p_info[playerid][bank]);
                SendAccess(playerid, "Вы установили ставку %d$ на этот дом.", fix_listitem);
                SendInfo(playerid, "Если Ваша ставка останется первой в течении трех часов, Вы станете владельцем дома.");
            }
            return 1;
        }
        case D_AUCTION_HOUSE_CANCEL:
        {
            if(!response) return 1;
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return 1;
            new forfeit = (h_info[h][h_auction_bet]/100)*2;
            if(p_info[playerid][bank] < forfeit)
                return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            if(h_info[h][h_auction_user_id] != INVALID_MYSQL_ID)
            {
                new p_id = GetPlayerUserID(h_info[h][h_auction_user_id]);
                if(p_id != INVALID_PLAYER_ID)
                {
                    Log(LOG_player, INFO, "%s[%d](%s %s)[%d$] получил %d$ за возврат ставки с аукциона дома [%d] | #Auction",
                        get_name(p_id), p_info[p_id][ID], p_temp[p_id][session_IP], IsPlayerMobile(p_id) ? "Mobile": "PC",
                        p_info[p_id][bank], h_info[h][h_auction_bet]-(h_info[h][h_auction_bet]/10), h_info[h][h_mysql_id]);

                    SendAccess(p_id, "Вам возвращено %d$ с послед. ставки.", h_info[h][h_auction_bet]-(h_info[h][h_auction_bet]/10));
                    p_info[p_id][bank] += h_info[h][h_auction_bet]-(h_info[h][h_auction_bet]/10);
                    MysqlUpdatePlayerInt(p_id, "bank",  p_info[p_id][bank]);
                }
                else
                {
                    Log(LOG_player, INFO, "NickName[%d](Offline) получил %d$ за возврат ставки с аукциона дома [%d] | #Auction",
                        h_info[h][h_auction_user_id], h_info[h][h_auction_bet]-(h_info[h][h_auction_bet]/10), h_info[h][h_mysql_id]);

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank` = `bank` + %d WHERE `id` = %d",
                    h_info[h][h_auction_bet]-(h_info[h][h_auction_bet]/10), h_info[h][h_auction_user_id]);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                }
            }
            p_info[playerid][bank] -= forfeit;
            MysqlUpdatePlayerInt(playerid, "bank", p_info[playerid][bank]);

            h_info[h][h_auction_bet] =
            h_info[h][h_auction_time] = 0;
            h_info[h][h_auction_user_id] = INVALID_MYSQL_ID;
            save_house(h);
            return 1;
        }
        case D_AUCTION_BIZZ_CANCEL:
        {
            if(!response) return 1;
            new b = GetPlayerBizzID(playerid);
            if(b == INVALID_BIZZ_ID) return 1;
            new forfeit = (b_info[b][b_auction_bet]/100)*2;
            if(p_info[playerid][bank] < forfeit)
                return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            if(b_info[b][b_auction_user_id] != INVALID_MYSQL_ID)
            {
                new p_id = GetPlayerUserID(b_info[b][b_auction_user_id]);
                if(p_id != INVALID_PLAYER_ID)
                {
                    Log(LOG_player, INFO, "%s[%d](%s %s)[%d$] получил %d$ за возврат ставки с аукциона бизнеса %s[%d] | #Auction",
                        get_name(p_id), p_info[p_id][ID], p_temp[p_id][session_IP], IsPlayerMobile(p_id) ? "Mobile": "PC",
                        p_info[p_id][bank], b_info[b][b_auction_bet]-(b_info[b][b_auction_bet]/10), b_info[b][_name], b_info[b][b_mysql_id]);

                    SendAccess(p_id, "Вам возвращено %d$ с послед. ставки.", b_info[b][b_auction_bet]-(b_info[b][b_auction_bet]/10));
                    p_info[p_id][bank] += b_info[b][b_auction_bet]-(b_info[b][b_auction_bet]/10);
                    MysqlUpdatePlayerInt(p_id, "bank", p_info[p_id][bank]);
                }
                else
                {
                    Log(LOG_player, INFO, "NickName[%d](Offline) получил %d$ за возврат ставки с аукциона бизнеса %s[%d] | #Auction",
                        b_info[b][b_auction_user_id], b_info[b][b_auction_bet]-(b_info[b][b_auction_bet]/10), b_info[b][_name], b_info[b][b_mysql_id]);

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank` = `bank` + %d WHERE `id` = %d",
                    b_info[b][b_auction_bet]-(b_info[b][b_auction_bet]/10), b_info[b][b_auction_user_id]);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                }
            }
            p_info[playerid][bank] -= forfeit;
            MysqlUpdatePlayerInt(playerid, "bank", p_info[playerid][bank]);

            b_info[b][b_auction_bet] =
            b_info[b][b_auction_time] = 0;
            b_info[b][b_auction_user_id] = INVALID_MYSQL_ID;

            save_bizz(b);



            return 1;
        }
        case D_EXCHANGE_CANCEL:
        {
            if(!response) return 1;
            return callcmd::stopex(playerid, "/0");
        }
        case D_EXCHANGE_BET:
        {
            DeletePVar(playerid, #EQ_CONTROL_BLOCK);
            if(!response)
                return 1;

            if(p_info[playerid][exchangePartner] == INVALID_PLAYER_ID)
                return SendError(playerid, "Вы не участвуете в обмене.");

            switch(listitem)
            {
                case 0:
                {
                    SetPVarInt(playerid,  #EQ_CONTROL_BLOCK, true);
                    ShowBetMoney(playerid);
                }
                case 1: Interface_Show(playerid, EQUIPMENT_TRADE_BET_CAR);
                case 2:
                {
                    Interface_Show(playerid, EQUIPMENT_TRADE_BET_HOUSE);
                }
                case 3:
                {
                    Interface_Show(playerid, EQUIPMENT_TRADE_BET_BIZ);
                }
                case 4: Interface_Show(playerid, EQUIPMENT_TRADE_BET_INVENTORY);
                case 5:
                {
                    new family_idx = p_temp[playerid][family_game_id];
                    if(p_info[playerid][family_id] == -1 || family_idx == -1 ||
                        FamilyData[family_idx][fOwnerID] != p_info[playerid][ID])
                        return SendError(playerid, "Вы не являетесь владельцем семьи.");
                    AddExchangeBet(playerid, BET_FAMILY, family_idx);
                }
                case 6:
                {
                    SetPVarInt(playerid,  #EQ_CONTROL_BLOCK, true);
                    STRING_GLOBAL = ""W"Название\t"W"Наличие\t"W"Статус\n";
                    for(new i; i < MAX_COSTUME; i++)
                    {
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" %s\t%s\t%s\n", STRING_GLOBAL, i+1, CostumeName[i], (!p_info[playerid][costume][i]) ? ("{"#cLIGHTRED"}Нет"W"") : ("{"#cGREEN"}Есть"W""), (!p_info[playerid][costume_use][i]) ? ("{"#cLIGHTRED"}Не используется"W"") : ("{"#cGREEN"}Используется"W""));
                    }
                    ShowPlayerDialog(playerid, D_EXCHANGE_BET_COSTUME, DIALOG_STYLE_TABLIST_HEADERS, ""I"Костюмы", STRING_GLOBAL, "Далее", "Отмена");
                }
            }

            return 1;
        }
        case D_EXCHANGE_BET_INVENTORY:
        {
            DeletePVar(playerid, #EQ_CONTROL_BLOCK);
            new slot_id = GetPVarInt(playerid, #EQ_SELECT_SLOT)-1;
            DeletePVar(playerid, #EQ_SELECT_SLOT);
            if(!response || slot_id == -1)
                return 1;
            if(p_info[playerid][exchangePartner] == INVALID_PLAYER_ID)
                return SendError(playerid, "Вы не участвуете в обмене.");
            new value;
            if(sscanf(inputtext, "i", value))
                return SendError(playerid, "Введите число.");
            new itemID = InventoryPlayer[playerid][slot_id][inv_item_id],
                itemType = ItemsInfo[itemID][iType],
                max_value = GetInventoryAmount(playerid, itemID);
            if(itemType == TYPE_ITEMS_INVENTORY && (itemID == 679 && TentIDx[playerid] == 679 || itemID == 680 && TentIDx[playerid] == 680))
                return SendError(playerid, "Для начала необходимо забрать свой переносной ларек.");
            if(!(1 <= value <= max_value))
                return SendError(playerid, "Кол-во должно быть не менее 1 шт. и не более %d шт.", max_value);
            if(max_value < value)
                return SendError(playerid, "У Вас нет такого количества данного предмета.");
            AddExchangeBet(playerid, BET_INVENTORY, itemID, value);
            return 1;
        }
        case D_EXCHANGE_BET_COSTUME:
        {
            DeletePVar(playerid, #EQ_CONTROL_BLOCK);
            if(!response)
                return 1;
            if(p_info[playerid][exchangePartner] == INVALID_PLAYER_ID)
                return SendError(playerid, "Вы не участвуете в обмене.");
            if(!p_info[playerid][costume][listitem])
                return SendError(playerid, "У Вас нет этого костюма.");
            AddExchangeBet(playerid, BET_COSTUME, listitem);
        }
        case D_EXCHANGE_BET_MONEY:
        {
            DeletePVar(playerid, #EQ_CONTROL_BLOCK);
            if(!response)
                return 1;
            if(p_info[playerid][exchangePartner] == INVALID_PLAYER_ID)
                return SendError(playerid, "Вы не участвуете в обмене.");
            new sum;
            if(sscanf(inputtext, "i", sum))
                return SendError(playerid, "Введите число.");
            if(!(1000 <= sum <= 500_000_000))
                return SendError(playerid, "Сумма должна быть не менее 1000$ и не более 500 000 000$.");
            if(p_info[playerid][bank] < sum)
                return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            AddExchangeBet(playerid, BET_MONEY, .value = sum);
            return 1;
        }
        case D_EXCHANGE_BET_CAR:
        {
            if(!response)
                return 1;
            if(p_info[playerid][exchangePartner] == INVALID_PLAYER_ID)
                return SendError(playerid, "Вы не участвуете в обмене.");

            new mysql_vehicle_id = p_temp[playerid][p_listitem_cars][listitem];
            p_temp[playerid][p_listitem_cars][listitem] = -1;

            if(GetPlayerVehicleMySQLID(playerid, mysql_vehicle_id) != -1)
                return SendError(playerid, "Вы не выгрузили транспортное средство.");

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `v_mysql_id`, `v_model`, `v_twinturbo`, `v_insurance`, `v_number` FROM `vehicle` WHERE `v_mysql_id` = %d AND `v_owner_id` = %d", mysql_vehicle_id, p_info[playerid][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL, "LoadBetCar", "i", playerid);
            return 1;
        }
        case D_EXCHANGE_UNBET:
        {
            if(!response)
                return 1;
            if(p_info[playerid][exchangePartner] == INVALID_PLAYER_ID)
                return SendError(playerid, "Вы не участвуете в обмене.");
            if(GetPVarInt(playerid, "EXCHANGE:ready"))
                return SendError(playerid, "Когда Вы готовы, Вам запрещено изменять вклад.");

            new fix_listitem = p_temp[playerid][p_listitem][listitem];

            ExchangeUnBet(playerid, fix_listitem);
            return 1;
        }
        case D_EXCHANGE_READY:
        {
            if(p_info[playerid][exchangePartner] == INVALID_PLAYER_ID)
                return SendError(playerid, "Вы не участвуете в обмене.");

            if(!response)
            {
                SetPVarInt(p_info[playerid][exchangePartner], "EXCHANGE:confirmed", false);
                SetPVarInt(playerid, "EXCHANGE:ready", false);
                SetPVarInt(p_info[playerid][exchangePartner], "EXCHANGE:ready", false);
                UpdateExchangeText(playerid);

                ShowPlayerDialog(p_info[playerid][exchangePartner], D_NULL, DIALOG_STYLE_MSGBOX, ""I"Обмен", ""W"Игрок отказался от обмена.", "ОК", "");
                SendAccess(playerid, "Вы отказались от обмена.");

                EndExchange(playerid);
                return 1;
            }
            if(!IsPlayerStream(5.0, playerid, p_info[playerid][exchangePartner]))
                return SendError(playerid, "Игрок слишком далеко от Вас.");
            SetPVarInt(playerid, "EXCHANGE:confirmed", true);

            if(GetPVarInt(p_info[playerid][exchangePartner], "EXCHANGE:confirmed")) return ProccessExchange(playerid);
            SendAccess(playerid, "Вы подтвердили обмен.");
            SendInfo(playerid, "Ожидайте подтверждения от другого участника.");
            return 1;
        }
        case D_EXCHANGE_PREVIEW_INFO:
        {
            if( p_temp[playerid][pos_X] != 0.0 &&
                p_temp[playerid][pos_Y] != 0.0 &&
                p_temp[playerid][pos_Z] != 0.0)
            {
                Fix_TogglePlayerControllable(playerid, true);
                SetPlayerInterior(playerid, p_temp[playerid][pos_INT]);
                SetPlayerVirtualWorld(playerid, p_temp[playerid][pos_VW]);
                SetPlayerPos(playerid, p_temp[playerid][pos_X], p_temp[playerid][pos_Y], p_temp[playerid][pos_Z]);
                SetCameraBehindPlayer(playerid);

                p_temp[playerid][pos_X] =
                p_temp[playerid][pos_Y] =
                p_temp[playerid][pos_Z] = 0.0;
                p_temp[playerid][pos_VW] =
                p_temp[playerid][pos_INT] = -1;
                if(p_info[playerid][exchangePartner] != INVALID_PLAYER_ID)
                {
                    ShowTextDrawForPlayer(playerid, TD_ID_TRADE);
                    Interface_Show(playerid, GetPVarInt(playerid, "EXCHANGE:ready") ? EQUIPMENT_TRADE_READY : EQUIPMENT_TRADE);
                }
            }
            return 1;
        }

        case D_AC_PANEL:
        {
            if(!response)
                return 1;

            ShowCheatList(playerid, listitem ? D_AC_MAXWARNS : D_AC_ONOFF);
            return 1;
        }
        case D_AC_ONOFF:
        {
            if(!response)
                return ShowCheatList(playerid, D_AC_PANEL);

            AntiCheat[listitem][acValue] = !AntiCheat[listitem][acValue];
            SaveAntiCheat(listitem);
            ShowCheatList(playerid, D_AC_ONOFF);
            return 1;
        }
        case D_AC_MAXWARNS:
        {
            if(!response)
                return ShowCheatList(playerid, D_AC_PANEL);

            SetPVarInt(playerid, "ACPANEL:CHEAT", listitem);
            ShowSetMaxWarns(playerid, listitem);
            return 1;
        }
        case D_AC_SETMAXWARNS:
        {
            if(!response)
            {
                DeletePVar(playerid, "ACPANEL:CHEAT");
                return ShowCheatList(playerid, D_AC_MAXWARNS);
            }

            new cheat = GetPVarInt(playerid, "ACPANEL:CHEAT");
            new maxwarns = strval(inputtext);
            if(maxwarns == 0)
                return ShowSetMaxWarns(playerid, cheat);

            AntiCheat[cheat][acMaxWarns] = maxwarns;
            SaveAntiCheat(cheat);
            ShowCheatList(playerid, D_AC_MAXWARNS);
            return 1;
        }
        case D_BUY_VEHICLE_INSURANCE_NUMBER:
        {
            if(!response) return 1;
            new vehicleid = GetPlayerVehicleID(playerid), vehicle_model = GetVehicleModelEx(vehicleid);
            if(GetVehicleData(vehicle_model, E_VD_TYPE) != VEHICLE_STATE_VELO_MOPED && GetVehicleData(vehicle_model, E_VD_TYPE) != VEHICLE_STATE_MOTO && GetVehicleData(vehicle_model, E_VD_TYPE) != VEHICLE_STATE_CAR)
                return SendError(playerid, "Приобретение страховок и номеров доступно только на велосипедах, мотоциклах и автомобилях.");
            switch(listitem)
            {
                case 0:
                {
                    if(GetVehicleData(vehicle_model, E_VD_TYPE) != VEHICLE_STATE_VELO_MOPED && GetVehicleData(vehicle_model, E_VD_TYPE) != VEHICLE_STATE_MOTO && GetVehicleData(vehicle_model, E_VD_TYPE) != VEHICLE_STATE_CAR)
                        return SendError(playerid, "Приобретение страховок доступно только на велосипедах, мотоциклах и автомобилях.");
                    if(veh_info[vehicleid][v_insurance] == 1) return SendError(playerid, "На данном транспортном средстве уже есть страховка.");

                    new total = 0;
                    foreach(new i:Player)
                    {
                        if(IsPlayerInRangeOfPoint(i, 100.0, -2107.8877,-121.1346,1055.1475) && GetPlayerVirtualWorld(i) == 1 && p_info[i][p_afkTime] < 2)
                        {
                            if(p_info[i][member] == LICENSE && p_info[i][rang] >= 7 && p_info[i][fwork] == true)
                            {
                                total++;
                                break;
                            }
                        }
                    }
                    if(total != 0) return SendError(playerid, "В здании автошколы есть сотрудник, обратитесь к нему.");

                    new price = GetPriceInsurance(vehicle_model);
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    Вы действительно желаете приобрести страховку на "I"\"%s\""W" за "I"%d$?", GetVehicleName(vehicleid), price);
                    ShowPlayerDialog(playerid, D_BUY_VEHICLE_INSURANCE, DIALOG_STYLE_MSGBOX, ""I"Приобретение страховки", STRING_GLOBAL, "Да", "Нет");
                }
                case 1:
                {
                    if(GetVehicleData(vehicle_model, E_VD_TYPE) != VEHICLE_STATE_MOTO && GetVehicleData(vehicle_model, E_VD_TYPE) != VEHICLE_STATE_CAR)
                        return SendError(playerid, "Приобретение номеров доступно только на мотоциклах и автомобилях.");
                    ShowPlayerDialog(playerid, D_BUY_VEH_NUMBER_STEP1, DIALOG_STYLE_INPUT, ""I"Приобретение номера", ""W"\
                    Введите номер, который желаете приобрести на данное транспортное средство:\n\n\
                    Стоимость:\n\n\
                    \tТрехзначный - от "I"500000$"W" до "I"2500000$"W"\n\
                    \tЧетырехзначный - от "I"100000$"W" до "I"500000$"W"\n\
                    \tПятизначный - от "I"10000$"W" до "I"100000$", "Далее", "Отмена");
                }
            }
            return 1;
        }
        case D_BUY_VEHICLE_INSURANCE:
        {
            if(!response) return 1;
            new vehicleid = GetPlayerVehicleID(playerid), vehicle_model = GetVehicleModelEx(vehicleid);
            if(GetVehicleData(vehicle_model, E_VD_TYPE) != VEHICLE_STATE_VELO_MOPED && GetVehicleData(vehicle_model, E_VD_TYPE) != VEHICLE_STATE_MOTO && GetVehicleData(vehicle_model, E_VD_TYPE) != VEHICLE_STATE_CAR)
                return SendError(playerid, "Приобретение страховок доступно только на велосипедах, мотоциклах и автомобилях.");
            if(veh_info[vehicleid][v_insurance] == 1) return SendError(playerid, "На данном транспортном средстве уже есть страховка.");
            if(veh_info[vehicleid][v_bonus] != 0) return SendError(playerid, "На бонусное транспортное средство нельзя установить страховку.");
            new price = GetPriceInsurance(vehicle_model);
            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            SendAccess(playerid, "Вы приобрели страховку на \"%s\" за %d$.", GetVehicleName(vehicleid), price);
            OnServerInfoForMoney[40] += price;

            SetPlayerMoney(playerid, -price, true, "купил страховку на транспортное средство");

            SetFractionWarehouse(LICENSE, fwMoney, (price / 100) * 5);

            veh_info[vehicleid][v_insurance] = 1;
            veh_info[vehicleid][v_insurance_time] = 336;
            SaveVehicle(vehicleid);
            return 1;
        }
