        hb_id = -1;
    for(new i; i < 3; i++)
    {
        if(HospitalBedInfo[bed_id][hb_Busy][i] == playerid)
        {
            hb_id = i;
            HospitalBedInfo[bed_id][hb_Busy][hb_id] = INVALID_PLAYER_ID;
