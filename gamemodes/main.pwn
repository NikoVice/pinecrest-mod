        SetPVarInt(playerid, "AC:FLOOD", timestamp + 10);

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] возможно использует читы. Причина: %s. Код: %d.", get_name(playerid), playerid, AntiCheat[code][acName], code);
        SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL, false);
        return 1;
    }
    else
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] кикнут за подозрение в читерстве. Код: %d.", get_name(playerid), playerid, code);
        SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL, false);
        AntiCheatKick(playerid, code);
    }
    return 1;
}
*/

getDayEx()
{
    return ((timestamp/86400)%7);
}


//Авто
forward get_vehicle_id(playerid, vehicleid);
public get_vehicle_id(playerid, vehicleid)
{
    veh_info[vehicleid][v_mysql_id] = cache_insert_id();
    if(playerid == INVALID_PLAYER_ID) return 1;
    if(IsPlayerOwnerVehicle(playerid, vehicleid))
    {
        if(GetFreeSlotVehicle(playerid) == ALL_BUSY_SLOT_VEHICLE)
            DestroyPlayerVehicle(playerid, GetPlayerVehicleIDEx(playerid, 0));
        SetFreeSlotVehicle(playerid, vehicleid);
    }
    // printf("mysql Создание vehicle: %s", veh_info[i][v_owner]);
    return 1;
}

forward ShowDialogBizBuyVehicle(playerid, i);
public ShowDialogBizBuyVehicle(playerid, i)
{
    veh_info[i][v_mysql_id] = cache_insert_id();
    return 1;
}

//Фрак. авто
forward FractionVehicle_Buy(playerid, i, price);
public FractionVehicle_Buy(playerid, i, price)
{
    veh_info[i][v_mysql_id] = cache_insert_id();

    // [logs] реализовать получение версии клиента
    // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2)[$112345] купил из госа фрак. транспорт <Infernus>(411)[4333] за 100$
    Log(LOG_player, INFO, "%s[%d](%s %s)[%d$] купил из госа фрак. транспорт <%s>(%d)[%d] за %d",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
        GetVehicleName(i), GetVehicleModelEx(i), veh_info[i][v_mysql_id], price);

    SetPlayerMoney(playerid, -price, true, "");
    return 1;
}

UpdateAreaInfo(const areaid, const AREA_TYPE, const AREA_SUBTYPE, const AREA_OBJECT_ID = -1, const AREA_IDX = -1)
{
    if(areaid >= MAX_SERVER_AREAS) printf("pizda areas");
    gAreaInfo[areaid][area_type] = AREA_TYPE;
    gAreaInfo[areaid][area_subtype] = AREA_SUBTYPE;
    gAreaInfo[areaid][area_object_id] = AREA_OBJECT_ID;
    gAreaInfo[areaid][area_idx] = AREA_IDX;
}

SaveVehicle(i)
{
    if(i == INVALID_VEHICLE_ID) return 1;
    if(veh_info[i][v_mysql_id] == INVALID_MYSQL_ID) return 1;

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `vehicle` SET \
    `v_owner_id` = %d, `v_model` = %d, `v_premium` = %d, `v_bonus` = %d, \
    `v_sell_block` = %d, `v_lock` = %d, `v_fuel` = '%f', `v_number` = '%e', \
    `v_insurance` = %d, `v_insurance_time` = %d, `v_color_0` = %d, `v_color_1` = %d, \
    `v_family_rang` = %d, `v_int` = %d, `v_virt` = %d, `v_wanted` = %d, `v_impound` = %d WHERE `v_mysql_id` = %d",
    veh_info[i][v_owner_id], GetVehicleModelEx(i), veh_info[i][v_premium], veh_info[i][v_bonus],
    veh_info[i][v_sell_block], veh_info[i][v_lock], veh_info[i][v_fuel], veh_info[i][v_number],
    veh_info[i][v_insurance], veh_info[i][v_insurance_time], veh_info[i][v_color][0], veh_info[i][v_color][1],
    veh_info[i][v_family_rang], veh_info[i][v_int], veh_info[i][v_virt], veh_info[i][v_wanted],
    veh_info[i][v_impound], veh_info[i][v_mysql_id]);
    mysql_tquery(con_bd, STRING_GLOBAL);
    if(GetSlotVehicleMarket(veh_info[i][v_mysql_id]) == -1)
    {
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `vehicle` SET \
        `v_pos_0` = %f, `v_pos_1` = %f, `v_pos_2` = %f, `v_pos_3` = %f WHERE `v_mysql_id` = %d",
        veh_info[i][v_pos][0], veh_info[i][v_pos][1], veh_info[i][v_pos][2], veh_info[i][v_pos][3], veh_info[i][v_mysql_id]);
        mysql_tquery(con_bd, STRING_GLOBAL);
    }
    return 1;
}

SaveVehicleTuning(i)
{
    if(i == INVALID_VEHICLE_ID) return 1;
    if(veh_info[i][v_mysql_id] == 0) return 1;

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `vehicle` SET \
    `v_tun_0` = %d, `v_tun_1` = %d, `v_tun_2` = %d, `v_tun_3` = %d, `v_tun_4` = %d, \
    `v_tun_5` = %d, `v_tun_6` = %d, `v_tun_7` = %d, `v_tun_8` = %d, `v_tun_9` = %d, \
    `v_tun_10` = %d, `v_tun_11` = %d, `v_tun_12` = %d, `v_twinturbo` = %d, `v_twinturbo_data` = '%d|%d|%d|%d' WHERE `v_mysql_id` = %d",
    veh_info[i][v_tune][v_hydraulics], veh_info[i][v_tune][v_nitro], veh_info[i][v_tune][v_wheels], veh_info[i][v_tune][v_front_bumper], veh_info[i][v_tune][v_pear_bumper],
    veh_info[i][v_tune][v_spoiler], veh_info[i][v_tune][v_paintjob], veh_info[i][v_tune][v_lamps], veh_info[i][v_tune][v_exhausts], veh_info[i][v_tune][v_roofs],
    veh_info[i][v_tune][v_hoods], veh_info[i][v_tune][v_sideskirt], veh_info[i][v_tune][v_vents], veh_info[i][v_twinturbo], veh_info[i][v_twinturbo_data][0],
    veh_info[i][v_twinturbo_data][1], veh_info[i][v_twinturbo_data][2], veh_info[i][v_twinturbo_data][3], veh_info[i][v_mysql_id]);
    mysql_tquery(con_bd, STRING_GLOBAL);
    return 1;
}

SaveVehicleDetails(i)
{
    if(i == INVALID_VEHICLE_ID) return 1;
    if(veh_info[i][v_mysql_id] == 0) return 1;

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof STRING_GLOBAL, "UPDATE `vehicle` SET `v_details` = '%f|%f|%f|%f|%f' WHERE `v_mysql_id` = %d",
    veh_info[i][v_details][0], veh_info[i][v_details][1], veh_info[i][v_details][2], veh_info[i][v_details][3], veh_info[i][v_details][4],
    veh_info[i][v_mysql_id]);
    mysql_tquery(con_bd, STRING_GLOBAL);
    return 1;
}

forward LoadPlayerVehicle(playerid);
public LoadPlayerVehicle(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(!rows)
        return 1;//SendError(playerid, "Транспортные средства не найдены, обратитесь в тех. раздел.");

    new iCountVehicle = GetFreeSlotVehicle(playerid);
    if(iCountVehicle == ALL_BUSY_SLOT_VEHICLE)
        return SendError(playerid, "Максимально загруженных транспортных средств: %d.", p_info[playerid][p_vip] == 3 && p_info[playerid][p_add_vip] == 1 ? MAX_PLAYER_VEHICLES : 2);

    new temp_v_mysql_id, temp_v_premium, temp_v_insurance,
        temp_v_virt, temp_v_int,
        model,
        Float:vpos[4],
        v_color1,
        v_color2,
        data[256],
        count,
        price_veh_spawn,
        restore_count_cars;

    for(new idx; idx < rows; idx++)
    {
        if(count >= iCountVehicle)
        {
            SendError(playerid, "Нет свободных слотов, всего создано %d транспортных средств.", count);
            break;
        }
        cache_get_value_name_int(idx, "v_mysql_id",temp_v_mysql_id);
        cache_get_value_name_int(idx, "v_virt", temp_v_virt);
        cache_get_value_name_int(idx, "v_int", temp_v_int);

        if(GetPlayerVehicleMySQLID(playerid, temp_v_mysql_id) != -1) continue;

        cache_get_value_name_int(idx, "v_model", model);
        cache_get_value_name_float(idx, "v_pos_0", vpos[0]);
        cache_get_value_name_float(idx, "v_pos_1", vpos[1]);
        cache_get_value_name_float(idx, "v_pos_2", vpos[2]);
        cache_get_value_name_float(idx, "v_pos_3", vpos[3]);
        cache_get_value_name_int(idx, "v_color_0", v_color1);
        cache_get_value_name_int(idx, "v_color_1", v_color2);
        cache_get_value_name_int(idx, "v_premium", temp_v_premium);
        cache_get_value_name_int(idx, "v_insurance", temp_v_insurance);

        if(temp_v_virt > 0 && temp_v_virt < 5000)
        {
            if(h_info[temp_v_virt-50][h_user_id] != p_info[playerid][ID] &&
                p_info[playerid][key_h_rent]+50 != temp_v_virt)
            {
                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `v_mysql_id`, `v_model` FROM `vehicle` WHERE `v_mysql_id` = %d", temp_v_mysql_id);
                mysql_tquery(con_bd, STRING_GLOBAL, "restore_cars", "i", INVALID_VEHICLE_ID);
                restore_count_cars++;
                continue;
            }
        }
        else
        {
            if(temp_v_virt == 0)
            {
                price_veh_spawn = temp_v_insurance == 1 ? 125 : 250;
                if(temp_v_premium) price_veh_spawn /= 2;
                if(temp_v_virt >= 5000) price_veh_spawn /= 2;
                price_veh_spawn = (((MAX_PLAYER_VEHICLES-GetFreeSlotVehicle(playerid))+1)*price_veh_spawn);
                if(p_info[playerid][cash] < price_veh_spawn && p_temp[playerid][in_enter_vehicle] != 3000)
                    return SendError(playerid,  "У Вас нет столько денег. Используйте /donate");
            }
        }

        new vehicleid = CreateVehicleVEx(NPO_PLAYERCAR, NPO_NONE, model, vpos[0], vpos[1], vpos[2], vpos[3], v_color1, v_color2, 1800);

        SetFreeSlotVehicle(playerid, vehicleid);

        if(p_temp[playerid][in_enter_vehicle] == 3000 && model == 508 && p_info[playerid][spawn] == SPAWN_TREILER)
            SpawnToTreiler(playerid, vehicleid);
        else
        {
            if(!temp_v_virt) SetPlayerMoney(playerid, -price_veh_spawn, true, "доставка транспорта");
        }

        veh_info[vehicleid][v_virt] = temp_v_virt;
        veh_info[vehicleid][v_int] = temp_v_int;
        veh_info[vehicleid][v_mysql_id] = temp_v_mysql_id;
        veh_info[vehicleid][v_premium] = temp_v_premium;
        veh_info[vehicleid][v_insurance] = temp_v_insurance;

        cache_get_value_name_int(idx, "v_bonus", veh_info[vehicleid][v_bonus]);
        cache_get_value_name_int(idx, "v_sell_block", veh_info[vehicleid][v_sell_block]);
        //cache_get_value_name(idx, "v_owner", veh_info[vehicleid][v_owner],24);
        cache_get_value_name_int(idx, "v_owner_id", veh_info[vehicleid][v_owner_id]);
        cache_get_value_name_int(idx, "v_lock", veh_info[vehicleid][v_lock]);
        cache_get_value_name_float(idx, "v_fuel", veh_info[vehicleid][v_fuel]);
        cache_get_value_name_int(idx, "v_twinturbo", veh_info[vehicleid][v_twinturbo]);

        cache_get_value_name(idx, "v_twinturbo_data", data); // 0|0|0|0
        sscanf(data, "p<|>a<i>[4]", veh_info[vehicleid][v_twinturbo_data]);

        cache_get_value_name(idx, "v_number", veh_info[vehicleid][v_number], 16);

        if(!strequals(veh_info[vehicleid][v_number], "NULL"))
        {
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%s", veh_info[vehicleid][v_number]);
            veh_info[vehicleid][v_number_text] = CreateDynamic3DTextLabel(STRING_GLOBAL, COLOR_GRAY, vpos[0], vpos[1], vpos[2], 20.0, INVALID_PLAYER_ID, vehicleid);
        } 
        else veh_info[vehicleid][v_number_text] = CreateDynamic3DTextLabel("TRANSIT", COLOR_GRAY, vpos[0], vpos[1], vpos[2], 20.0, INVALID_PLAYER_ID, vehicleid);

        cache_get_value_name(idx, "v_details", data); // 100.0|100.0|100.0|100.0|100.0
        sscanf(data, "p<|>a<f>[5]", veh_info[vehicleid][v_details]);

        cache_get_value_name_int(idx, "v_insurance_time", veh_info[vehicleid][v_insurance_time]);
        cache_get_value_name_int(idx, "v_wanted", veh_info[vehicleid][v_wanted]);
        cache_get_value_name_int(idx, "v_impound", veh_info[vehicleid][v_impound]);

        veh_info[vehicleid][v_lock] = 0;
        ///tuning
        cache_get_value_name_int(idx, "v_tun_0", veh_info[vehicleid][v_tune][v_hydraulics]);
        cache_get_value_name_int(idx, "v_tun_1", veh_info[vehicleid][v_tune][v_nitro]);
        cache_get_value_name_int(idx, "v_tun_2", veh_info[vehicleid][v_tune][v_wheels]);
        cache_get_value_name_int(idx, "v_tun_3", veh_info[vehicleid][v_tune][v_front_bumper]);
        cache_get_value_name_int(idx, "v_tun_4", veh_info[vehicleid][v_tune][v_pear_bumper]);
        cache_get_value_name_int(idx, "v_tun_5", veh_info[vehicleid][v_tune][v_spoiler]);
        cache_get_value_name_int(idx, "v_tun_6", veh_info[vehicleid][v_tune][v_paintjob]);
        cache_get_value_name_int(idx, "v_tun_7", veh_info[vehicleid][v_tune][v_lamps]);
        cache_get_value_name_int(idx, "v_tun_8", veh_info[vehicleid][v_tune][v_exhausts]);
        cache_get_value_name_int(idx, "v_tun_9", veh_info[vehicleid][v_tune][v_roofs]);
        cache_get_value_name_int(idx, "v_tun_10", veh_info[vehicleid][v_tune][v_hoods]);
        cache_get_value_name_int(idx, "v_tun_11", veh_info[vehicleid][v_tune][v_sideskirt]);
        cache_get_value_name_int(idx, "v_tun_12", veh_info[vehicleid][v_tune][v_vents]);

        cache_get_value_name(idx, "v_attach_data", data); // -1|-1|-1|-1|-1|-1|-1|-1
        sscanf(data, "p<|>a<i>[8]", veh_info[vehicleid][v_attach_data]);

        //SetTimerEx("LoadVehicleTuneObject", 1500, false, "iii", playerid, vehicleid, 1);
        //visual tuning
        cache_get_value_name_int(idx, "v_wheel_width", veh_info[vehicleid][v_wheel_width]);
        cache_get_value_name_float(idx, "v_wheel_size", veh_info[vehicleid][v_wheel_size]);
        cache_get_value_name_int(idx, "v_wheel_offset_x_0", veh_info[vehicleid][v_wheel_offset_x][0]);
        cache_get_value_name_int(idx, "v_wheel_offset_x_1", veh_info[vehicleid][v_wheel_offset_x][1]);
        cache_get_value_name_int(idx, "v_wheel_alignment_0", veh_info[vehicleid][v_wheel_alignment][0]);
        cache_get_value_name_int(idx, "v_wheel_alignment_1", veh_info[vehicleid][v_wheel_alignment][1]);
        cache_get_value_name_int(idx, "v_lights_color_0", veh_info[vehicleid][v_lights_color][0]);
        cache_get_value_name_int(idx, "v_lights_color_1", veh_info[vehicleid][v_lights_color][1]);
        cache_get_value_name_int(idx, "v_lights_color_2", veh_info[vehicleid][v_lights_color][2]);
        cache_get_value_name_int(idx, "v_toner", veh_info[vehicleid][v_toner]);
        if(veh_info[vehicleid][v_wheel_width] != 0) SetVehicleWheelWidth(vehicleid, veh_info[vehicleid][v_wheel_width]);
        if(veh_info[vehicleid][v_wheel_size] != 0.0) SetVehicleWheelSize(vehicleid, veh_info[vehicleid][v_wheel_size]);
        if(veh_info[vehicleid][v_wheel_offset_x][0] != 0) SetVehicleWheelOffsetX(vehicleid, 0, veh_info[vehicleid][v_wheel_offset_x][0]);
        if(veh_info[vehicleid][v_wheel_offset_x][1] != 0) SetVehicleWheelOffsetX(vehicleid, 1, veh_info[vehicleid][v_wheel_offset_x][1]);
        if(veh_info[vehicleid][v_wheel_alignment][0] != 0) SetVehicleWheelAngle(vehicleid, 0, veh_info[vehicleid][v_wheel_alignment][0]);
        if(veh_info[vehicleid][v_wheel_alignment][1] != 0) SetVehicleWheelAngle(vehicleid, 1, veh_info[vehicleid][v_wheel_alignment][1]);
        if(veh_info[vehicleid][v_lights_color][0] != 0 || veh_info[vehicleid][v_lights_color][1] != 0 || veh_info[vehicleid][v_lights_color][2] != 0)
            SetVehicleLightsColors(vehicleid, veh_info[vehicleid][v_lights_color][0], veh_info[vehicleid][v_lights_color][1], veh_info[vehicleid][v_lights_color][2]);
        if(veh_info[vehicleid][v_toner] != 0)
            SetVehicleToner(vehicleid, veh_info[vehicleid][v_toner]);

        if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_CAR)
        {
            for (new i; i < v_all-1; i++){
                if(veh_info[vehicleid][v_tune][i] !=0) {
                    VEx_AddVehicleComponent (vehicleid, veh_info[vehicleid][v_tune][i]);
                    if(i == v_sideskirt || i == v_vents) VEx_AddVehicleComponent (vehicleid, veh_info[vehicleid][v_tune][i]);
                }
            }
            if(veh_info[vehicleid][v_tune][v_paintjob] != 0) ChangeVehiclePaintjob(vehicleid, veh_info[vehicleid][v_tune][v_paintjob]-1);
        }

        LoadVehicleAccessories(playerid, vehicleid);

        if(temp_v_virt != 0 || temp_v_int != 0)
        {
            LinkVehicleToInterior(vehicleid, veh_info[vehicleid][v_int]);
            SetVehicleVirtualWorld(vehicleid, veh_info[vehicleid][v_virt]);
        }
        else
        {
            SendAccess(playerid, "Ваше транспортное средство создано.");
            SendInfo(playerid, "Найти транспортное средство: /findcar");
            SendInfo(playerid, "Управление вашими Т/С: /cars");

            new tickets = CountVehicleTickets(vehicleid);
            if(tickets) SendInfo(playerid, "У Вашего транспортного средства имеются неоплаченные штрафы - %i.", count);
        }
        count++;
    }
    if(restore_count_cars) SendInfo(playerid, "Всего восстановленных транспортных средств всего %d. Для загрузки введите /cars.", restore_count_cars);
    return 1;
}

LoadPlayerCarsGarage(playerid)
{
    if(GetPlayerVirtualWorld(playerid) != GetPlayerHouseID(playerid)+50)
        return 1;
    if(p_info[playerid][key_h_rent] != INVALID_HOUSE_ID && p_info[playerid][h_r_settings][R_GARAGE] == 0)
        return 1;
    p_temp[playerid][p_garage_use] = true;

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `vehicle` WHERE `v_owner_id` = %d AND `v_virt` > 0 AND `v_virt` < 5000 AND `v_int` > 0 LIMIT %d",
        p_info[playerid][ID], p_info[playerid][p_vip] == 3 && p_info[playerid][p_add_vip] == 1 ? MAX_PLAYER_VEHICLES : 2);
    mysql_tquery(con_bd, STRING_GLOBAL, "LoadPlayerVehicle", "i", playerid);
    return 1;
}

LoadUnPlayerCarsGarage(playerid, house_id = -1)
{
    p_temp[playerid][p_garage_use] = false;
    if(house_id != -1)
    {
        new h = GetPlayerHouseID(playerid);
        if(house_id != h) return 1;
        if(p_info[playerid][key_h_rent] == h && p_info[playerid][h_r_settings][R_GARAGE] == 0) return 1;
    }
    new vehicleid;
    for(new i; i < MAX_PLAYER_VEHICLES; i++)
    {
        vehicleid = GetPlayerVehicleIDEx(playerid, i);
        if( vehicleid != INVALID_VEHICLE_ID &&
            1 <= veh_info[vehicleid][v_virt] < 5000 &&
            veh_info[vehicleid][v_int] == HOUSE_INT_ID_REPAIR &&
            GetVehicleVirtualWorld(vehicleid) == veh_info[vehicleid][v_virt])
        {
            DestroyPlayerVehicle(playerid, vehicleid);
        }
    }
    return 1;
}


CMD:restorecars(playerid, params[])
{
    new max_count = p_info[playerid][p_vip] == 3 && p_info[playerid][p_add_vip] == 1 ? MAX_PLAYER_VEHICLES : 2;
    if(GetFreeSlotVehicle(playerid) != max_count)
    {
        SendError(playerid, "У Вас есть загруженные транспортные средства.");
        SendInfo(playerid, "Загрузить или выгрузить транспортное средство: /cars");
        return 1;
    }

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `v_mysql_id`, `v_model` FROM `vehicle` WHERE `v_owner_id` = %d",
        p_info[playerid][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL, "restore_cars", "i", playerid);
    return 1;
}

forward restore_cars(playerid);
public restore_cars(playerid)
{
    new rows = cache_num_rows();
    if(!rows)
    {
        if(playerid != INVALID_PLAYER_ID) SendError(playerid, "Ничего не найдено.");
        return 1;
    }
    new temp_v_mysql_id, temp_v_model, v_count, Float:veh_pos[4];
    for(new idx; idx < rows; idx++)
    {
        cache_get_value_name_int(idx, "v_mysql_id", temp_v_mysql_id);
        cache_get_value_name_int(idx, "v_model", temp_v_model);

        switch(GetVehicleData(temp_v_model, E_VD_TYPE))
        {
            case VEHICLE_STATE_MOTO, VEHICLE_STATE_VELO_MOPED:
            {
                veh_pos[0] = 2136.9063, veh_pos[1] = -1146.9723, veh_pos[2] = 24.1492, veh_pos[3] = 360.0;
            }
            case VEHICLE_STATE_CAR:
            {
                switch(random(3))
                {
                    case 0: veh_pos[0] = 2148.7544, veh_pos[1] = 1397.9063, veh_pos[2] = 10.5574, veh_pos[3] = 180.0;
                    case 1: veh_pos[0] = 2142.4277, veh_pos[1] = 1397.9630, veh_pos[2] = 10.5574, veh_pos[3] = 180.0;
                    case 2: veh_pos[0] = 2135.9500, veh_pos[1] = 1398.2472, veh_pos[2] = 10.5574, veh_pos[3] = 180.0;
                }
            }
            case VEHICLE_STATE_BOAT:
            {
                switch(random(3))
                {
                    case 0: veh_pos[0] = 132.1968, veh_pos[1] = -1800.3795, veh_pos[2] = -0.0, veh_pos[3] = 138.1145;
                    case 1: veh_pos[0] = 118.8191, veh_pos[1] = -1800.5955, veh_pos[2] = -0.0, veh_pos[3] = 45.4816;
                    case 2: veh_pos[0] = 123.3519, veh_pos[1] = -1793.6954, veh_pos[2] = -0.0, veh_pos[3] = 45.4816;
                }
            }
            case VEHICLE_STATE_PLANE:
            {
                veh_pos[0] = 1573.4407, veh_pos[1] = 1542.0071, veh_pos[2] = 10.9790, veh_pos[3] = 40.6912;
            }
        }

        if(GetVehicleData(temp_v_model, E_VD_TYPE) != VEHICLE_STATE_TRAIN)
        {
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `vehicle` SET `v_pos_0` = '%f', `v_pos_1` = '%f', `v_pos_2` = '%f', `v_pos_3` = '%f', `v_int` = 0, `v_virt` = 0 WHERE `v_mysql_id` = %d",
            veh_pos[0], veh_pos[1], veh_pos[2], veh_pos[3], temp_v_mysql_id);
            mysql_tquery(con_bd, STRING_GLOBAL);
            v_count++;
        }
    }
    if(playerid != INVALID_PLAYER_ID) SendInfo(playerid, "Всего восстановленных транспортных средств всего %d.", v_count);
    return 1;
}

