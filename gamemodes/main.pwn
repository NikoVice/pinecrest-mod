CMD:pay(playerid,params[])
{
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "�����������: /pay [id ������] [���-�� �������� �������]");
    if(p_info[playerid][level] < 3) return SendError(playerid, "� ��� ��� 3-��� ������.");
    if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return SendError(playerid, "����� �� ������.");
    new max_pay = 250000;
    if(p_info[playerid][p_vip] == 3 && p_info[playerid][p_add_vip] == 1) max_pay = 500000;
    if(params[1] < 1 || params[1] > max_pay) return SendError(playerid, "���-�� �������� ������� ������ ���� �� ����� 1$ � �� ����� %d$.", max_pay);
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID || !p_info[params[0]][loggedIn]) return SendError(playerid, "����� ������� ������ �� ���.");
    if(p_info[playerid][cash] < params[1]) return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");
    if(params[0] == playerid) return SendError(playerid, "�� ����� ���� ID.");

    SetPlayerMoney(playerid, -params[1], true,"������� /pay � %s[%d](%s %s)[%d$]", get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC", p_info[params[0]][cash]);
    SetPlayerMoney(params[0], params[1], true, "������� /pay �� %s[%d](%s %s)[%d$]", get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash]);

    SendAccess(playerid, "�� �������� %s [%d] %d$.", get_name(params[0]), params[0], params[1]);
    SendInfo(params[0], "%s [%d] ������� ��� %d$.", get_name(playerid), playerid, params[1]);

    ApplyAnimation(playerid,"DEALER","shop_pay",4.1, 0,0,0,0,0,1);

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "������� � �������� � ������ ������� ����.");
        MeAction(playerid, "������� ������ ���� � ������ ������, ����� ���� ������� �� ���� �������");
        MeAction(playerid, "������� ������� �� ������� ������ ���, ����� ����...");
        MeAction(playerid, "...������ ���� ����� ������� �� �������� �������� ");
    }
    return 1;
}

