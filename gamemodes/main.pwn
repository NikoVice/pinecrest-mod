        case D_RENT_WORK_CAR:
        {
            if(!IsPlayerInAnyVehicle(playerid)) return 1;
            new vehicleid = GetPlayerVehicleID(playerid);
            if(!response)
            {
                DeletePVar(playerid, "ARENDA:FIX");
                DeletePVar(playerid, "ARENDA:PRICE");
                if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_TRAIN || GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_BOAT)
                {
                    new Float:slx, Float:sly, Float:slz;
                    GetPlayerPos(playerid, slx, sly, slz);
                    SetPlayerPos(playerid, slx, sly, slz + 5.0);
                    SetCameraBehindPlayer(playerid);
                    return 1;
                }
                else RemovePlayerFromVehicle(playerid);
                return 1;
            }
            new price = p_info[playerid][p_vip] == 3 ? 0 : GetPVarInt(playerid, "ARENDA:PRICE");
            DeletePVar(playerid, "ARENDA:FIX");
            DeletePVar(playerid, "ARENDA:PRICE");
            if(p_info[playerid][cash] < price)
            {
                SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_TRAIN || GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_BOAT)
                {
                    new Float:slx, Float:sly, Float:slz;
                    GetPlayerPos(playerid, slx, sly, slz);
                    SetPlayerPos(playerid, slx, sly, slz + 5.0);
                    SetCameraBehindPlayer(playerid);
                    return 1;
                }
                else RemovePlayerFromVehicle(playerid);
                return 1;
            }

            OnServerInfoForMoney[18] += price;
            SetPlayerMoney(playerid, -price, true, "арендовал т/с для работы <%s>", job_name_list[p_info[playerid][job]]);

            p_temp[playerid][rented_veh] = vehicleid;

            SendMes(playerid, COLOR_LGREEN, "Вы арендовали транспортное средство за {"#cLEMON"}%d$.", price);
            SendMes(playerid, COLOR_BLUE, "Для отмены аренды транспортного средства: "W"/unrent");
            SendMes(playerid, COLOR_LIME, "Команды транспортных средств: {"#cLYELLOW"}/mm > [5] Команды сервера > [3] Команды транспорта");

            veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];

            switch(veh_info[vehicleid][v_npoId])
            {
                case JOB_ROBBER: RobberVehicleIDx[playerid] = vehicleid;
                case JOB_BUS: StartPlayerJob(playerid, BUS_WORK);
                case JOB_MECHANIC: StartPlayerJob(playerid, MECHANIC_WORK);
                case JOB_COLLECTOR: CollectorVehicleIDx[playerid] = vehicleid;
                case JOB_ROADMAN:
                {
                    SendMes(playerid, COLOR_LIME, "Вам необходимо отправиться к месту проведения дорожных работ и собирать мешки с мусором.");
                    SendMes(playerid, COLOR_LIME, "Загружайте мешки с мусором в транспортное средство и разгрузите их на ближайшей свалке.");
                    SendMes(playerid, COLOR_BLUE, "Общее меню работы: "W"/road");
                }
                case JOB_FIREMAN:
                {
                    p_temp[playerid][FireStatus] = 0;
                    p_temp[playerid][FireTimer] = RandomEx(30, 60);
                    SendMes(playerid, COLOR_BLUE, "Ожидайте вызова от диспетчера.");
                }
                case JOB_TRAIN: StartPlayerJob(playerid, TRAIN_WORK);
                case JOB_PILOT: StartPlayerJob(playerid, PILOT_WORK);
                case JOB_ELECTRIC:
                {
                    ElectricVehicleIDx[playerid] = vehicleid;
                    if(ElectricType[playerid] == 0) SendMes(playerid, COLOR_LIME, "Вам необходимо отправиться к одной из ЛЭП для проведения ремонтных работ и подключить провода.");
                    else SendMes(playerid, COLOR_LIME, "Вам необходимо отправиться к одной из ЛЭП для ограбления и отключите провода.");
                    SendMes(playerid, COLOR_BLUE, "Список ЛЭП: "W"/pl");
                }
                case JOB_OIL:
                {
                    SendMes(playerid, COLOR_LIME, "Вам необходимо отправиться к одной из нефтяных вышек для покупки и дальнейшей загрузки бочек с нефтью.");
                    SendMes(playerid, COLOR_BLUE, "Общее меню работы: "W"/oil");
                }
            }
            return 1;
        }
        case 49:
        {
            if(!response) return 1;
            EndPlayerJob(playerid);
        }
        case D_BANK_MENU:
        {
            if(!response) return 1;
            STRING_GLOBAL[0] = EOS;
            switch(listitem)
            {
                case 0:
                {
                    f(STRING_GLOBAL, ""W"\
                    Чтобы {"#cLIGHTRED"}снять"W" или {"#cGREEN"}положить"W" деньги, введите количество:\n\n\
                    Состояние банковского счета: "I"$%d.",p_info[playerid][bank]),
                    ShowPlayerDialog(playerid, 60, 1, ""I"Операция со счетом", STRING_GLOBAL, "Положить", "Снять");
                }
                case 1:
                {
                    if(p_info[playerid][level] < 2) return SendError(playerid, "У Вас нет 2-ого уровня.");
                    f(STRING_GLOBAL, ""W"\
                    Чтобы "I"перевести"W" деньги, введите ID игрока:\n\n\
                    Состояние банковского счета: "I"$%d.", p_info[playerid][bank]);
                    ShowPlayerDialog(playerid, 61, 1, ""I"Перевести деньги", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 2:
                {
                    if(GetFreeSlotHouse(playerid) == p_info[playerid][house_slots] && p_info[playerid][key_h_rent] == INVALID_HOUSE_ID) return SendError(playerid, "У Вас нет дома или Вы не подселены в него.");
                    if(p_info[playerid][key_h_rent] != INVALID_HOUSE_ID)
                    {
                        new h_a_price, r_id, h = p_info[playerid][key_h_rent];
                        for(new i; i <= h_info[h][h_squar]; i++)
                        {
                            if(p_info[playerid][ID] == h_info[h][h_r_user_id][i])
                            {
                                h_a_price = h_info[h][h_r_price][i];
                                r_id = i;
                                break;
                            }
                        }
                        f(STRING_GLOBAL, ""W"\
                        Чтобы "I"оплатить"W" дом, введите количество дней:\n\n\
                        Дом оплачен на "I"%d"W" дн(-я/-ей) ["I"%d"W" ча(-а/-ов)].\n\n\
                        Стоимость оплаты в день: "I"$%d.", h_info[h][h_r_days][r_id]/24, h_info[h][h_r_days][r_id], h_a_price);
                        ShowPlayerDialog(playerid, D_HOUSE_RENT, DIALOG_STYLE_INPUT, ""I"Оплатить дом", STRING_GLOBAL, "Далее", "Отмена");
                    }
                    else HousePlayerList(playerid, HOUSE_ID_RENT);
                }
                case 3: BizzPlayerList(playerid, BIZZ_ID_RENT);
                case 4:
                {
                    if(!GetInventoryAmount(playerid, p_info[playerid][active_phone_id]))
                    {
                        SendError(playerid, "Вы не можете пополнить баланс телефона, причин может быть несколько:");
                        SendError(playerid, "1. У Вас нет телефона;");
                        SendError(playerid, "2. У Вас не выбран активный телефон с помощью команды /phone;");
                        return 1;
                    }
                    if(!p_info[playerid][phone_number]) return SendError(playerid, "У Вас нет номера телефона.");
                    if(p_info[playerid][phone_balance] >= 500) return SendError(playerid, "Максимальный баланс телефона 500$.");
                    f(STRING_GLOBAL, ""W"\
                    Чтобы "I"пополнить"W" баланс телефона, введите количество:\n\n\
                    Баланс телефона: "I"$%d.", p_info[playerid][phone_balance]);
                    ShowPlayerDialog(playerid, D_PHONE_BALANCE_ADD, DIALOG_STYLE_INPUT, ""I"Пополнить баланс телефона", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 5: ShowBankDeposit(playerid);
                case 6:
                {
                    if(p_info[playerid][level] < 20) return SendError(playerid, "У Вас нет 20-ого уровня.");
                    new max_pension = 200 * (p_info[playerid][level] - 19);
                    if(p_info[playerid][level] >= 80) max_pension = 12000;
                    f(STRING_GLOBAL, ""W"\
                    Пенсия — ежечасная выплата лицам, достигшим пенсионного возраста.\n\n\
                    Пенсионное накопление: "I"$%d."W"\n\n\
                    Дополнительная информация:\n\n\
                    \t— Пенсионное накопление начинает действовать с 20 лет в штате и прибавляется по $200 каждый год;\n\
                    \t— Пенсионное накопление не повышается начиная с 80 лет в штате.\n\n\
                    Вы хотите %s документы на получение пенсии?", max_pension, p_info[playerid][bank_pension_status] == 0 ? "{"#cGREEN"}подписать"W"" : "{"#cLIGHTRED"}расторгнуть"W"");
                    ShowPlayerDialog(playerid, D_BANK_PENSION, DIALOG_STYLE_MSGBOX, ""I"Пенсия", STRING_GLOBAL, "Да", "Нет");
                }
                case 7:
                {
                    p_temp[playerid][ATM_STATUS] = true;
                    p_temp[playerid][p_listitem][45] = 0;
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT SUM(amount) AS all_amount FROM tickets WHERE userid = %d AND paid = 0 LIMIT %d;", p_info[playerid][ID], MAX_PLAYER_FINE);
                    mysql_tquery(con_bd, STRING_GLOBAL, "GetTicketsInfo_Callback", "i", playerid);
                }
                case 8: ShowVideoCards(playerid, VIDEO_CARDS_TYPE_BANK);
            }
        }
        case D_PLAYER_FINES_MENU:
        {
            if(!response) return ShowPlayerDialog(playerid, D_BANK_MENU, DIALOG_STYLE_LIST, ""I"Банковские услуги", ""I"[1]"W" {"#cLIGHTRED"}Снять"W" или {"#cGREEN"}положить"W" деньги\n"I"[2]"W" Перевести деньги\n"I"[3]"W" Оплатить дом\n"I"[4]"W" Оплатить бизнес\n"I"[5]"W" Пополнить баланс телефона\n"I"[6]"W" Банковский вклад\n"I"[7]"W" Пенсия\n"I"[8]"W" Штрафы\n{"#cLIGHTRED"}[9] Bitcoin", "Далее", "Отмена");
            if(!listitem)
            {
                STRING_GLOBAL[0] = EOS;
                f(STRING_GLOBAL, ""W"Сумма всех штрафов составляет: "I"%d$"W". Вы готовы оплатить?", p_temp[playerid][p_listitem][45]);
                ShowPlayerDialog(playerid, D_PLAYER_FINES_ALL_PAYMENT, DIALOG_STYLE_MSGBOX, ""I"Штрафы", STRING_GLOBAL, "Оплатить", "Отмена");
            }
            if(listitem == 1)
            {
                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `tickets` WHERE `userid`= %i AND `paid` =0 ORDER BY `id` DESC LIMIT %i", p_info[playerid][ID], MAX_TICKETS);
                mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayersTickets", "ii", playerid, 0);
            }
            return 1;
