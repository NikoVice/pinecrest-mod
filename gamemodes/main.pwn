    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"�� ������������� ������ ������ ������ ��������? ����: "I"%d$\n\n"W"��� ������ ������� � �������� ����� ������� '������'", interior_price[int_id]*h_info[h][h_squar]);
    ShowPlayerDialog(playerid, D_HOUSE_CHANGE_INT_BUY, DIALOG_STYLE_MSGBOX, ""I"����� ���������", STRING_GLOBAL,"������","������");
