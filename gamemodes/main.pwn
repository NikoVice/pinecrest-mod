CMD:vacancy(playerid, params[])
{
    new total = 0, idx = 0;
    STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;
    for(new i = 1; i < MAX_FRACTIONS; i++)
    {
        if(Vacancy[i] == 0) continue;
        format(STRING_MIN, sizeof(STRING_MIN), ""I"[%d]"W" %s\n", idx + 1, GetFractionName(i));
        strcat(STRING_GLOBAL, STRING_MIN);
        total++;
        p_temp[playerid][p_listitem][idx] = i;
        idx++;
    }
    if(total == 0) return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"��������", ""W"�� ������ ������ ��� ��������.", "������", "");
    ShowPlayerDialog(playerid, D_VACANCY, DIALOG_STYLE_LIST, ""I"��������", STRING_GLOBAL, "�����", "������");
    return 1;
}

GetPlayerTaxiDriver(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(!IsValidVehicle(vehicleid)) return 1;
    if(veh_info[vehicleid][v_npoType] == NPO_JOB && (veh_info[vehicleid][v_npoId] == JOB_TC_TAXI || veh_info[vehicleid][v_job] == JOB_TC_TAXI))
    {
        foreach(new driverid: Player)
        {
            if(GetPlayerVehicleSeat(driverid) == 0 && GetPlayerVehicleID(driverid) == vehicleid && (IsPlayerOwnerVehicle(driverid, vehicleid) || IsPlayerRentedVehicle(driverid, vehicleid)) && p_temp[driverid][Work_ID] == TAXI_WORK) return driverid;
        }
    }
    return INVALID_PLAYER_ID;
}

forward ShowPlayerMessages(playerid);
public ShowPlayerMessages(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(!rows) return SendError(playerid, "� ��� ��� ���������.");

    new NickPlayer[MAX_PLAYER_NAME],
        status_read, time, time_str[48], time_back;

    STRING_GLOBAL[0] = EOS;
    for(new i; i < rows; i++)
    {
        cache_get_value_name(i, "NickPlayer", NickPlayer, MAX_PLAYER_NAME);
        //cache_get_value_name(i, "NickTarget", NickTarget, MAX_PLAYER_NAME);
        //cache_get_value_name(i, 2, text, 256);
        cache_get_value_name_int(i, "Read", status_read);
        cache_get_value_name_int(i, "Time", time);


        /*if(strequals(NickTarget, get_name(playerid)) owner_mess = "{73B461}[�������]"W"";
        else owner_mess = "{85FC65}[��]"W"";*/

        time_back = timestamp-time;

        if(time_back>24*3600) f(time_str, "[{00FF00}%d"W" ����(�) �����]", floatround(time_back/(24*3600)));
        else if(time_back>3600) f(time_str, "[{00FF00}%d"W" ���(��) �����]", floatround(time_back/3600));
        else if(time_back>60) f(time_str, "[{00FF00}%d"W" �����(�) �����]", floatround(time_back/60));
        else if(time_back>1) f(time_str, "[{00FF00}%d"W" ������(�) �����]", time_back);
        format(STRING_GLOBAL,sizeof(STRING_GLOBAL),"%s"I"[%d]"W" ��: {00FF00}%s"W" \t%s.. %s%s\n", STRING_GLOBAL, i + 1, NickPlayer, time_str, status_read == 1 ?  "{2BC12D}[NEW]"W"" : "{9E8F91}[���������]"W"");


        format(Phone_NickName[playerid][i], 24, "%s", NickPlayer);
    }
    ShowPlayerDialog(playerid, D_PHONE_MESSAGES, DIALOG_STYLE_LIST, ""I"���������",STRING_GLOBAL,"�����","������");
    return 1;
}

forward ShowPlayerMessage(playerid);
public ShowPlayerMessage(playerid)
{
    new rows;
    cache_get_row_count(rows);
    STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;

    format(STRING_MIN, sizeof(STRING_MIN), ""I"%s", p_temp[playerid][Phone_NickTarget]);

    if(!rows)
        return ShowPlayerDialog(playerid, D_PHONE_MESSAGE, DIALOG_STYLE_INPUT, STRING_MIN,
            ""W"��������� ���.\n\n"W"������� ���� ��������� ���� � ���� �����:\n��������: �����! ��� ����?\n\n\
            "I"����������! � ��������� c ������� ����� ������������\n������ "A"20 "I"��������� ���������", "���������","������");
    else
    {
        new /*NickPlayer[MAX_PLAYER_NAME],*/ NickTarget[MAX_PLAYER_NAME],
            time, time_str[48], time_back, text_mess[256];

        for(new i; i < rows; i++)
        {
            cache_get_value_name(i, "NickTarget", NickTarget, MAX_PLAYER_NAME);
            cache_get_value_name(i, "Text", text_mess, 256);
            cache_get_value_name_int(i, "Time", time);
            time_back = timestamp-time;

            if(time_back>24*3600) f(time_str, "[{00FF00}%d"W" ����(�) �����]", floatround(time_back/(24*3600)));
            else if(time_back>3600) f(time_str, "[{00FF00}%d"W" ���(��) �����]", floatround(time_back/3600));
            else if(time_back>60) f(time_str, "[{00FF00}%d"W" �����(�) �����]", floatround(time_back/60));
            else if(time_back>1) f(time_str, "[{00FF00}%d"W" ������(�) �����]", time_back);
            else if(time_back == 0) f(time_str,"[{00FF00}������ ���"W"]");

            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%s - %s%s\n", STRING_GLOBAL, time_str,
                strequals(NickTarget, get_name(playerid)) > 0 ? "{73B461}[�������]"W"" : "{85FC65}[��]"W"", text_mess);
        }
    }
    ShowPlayerDialog(playerid, D_PHONE_MESSAGE, DIALOG_STYLE_INPUT, STRING_MIN, STRING_GLOBAL, "��","������");
    return 1;
}

forward MysqlShowContacts(playerid);
public MysqlShowContacts(playerid)
{
    new rows;
    cache_get_row_count(rows);

    new NickTarget[MAX_PLAYER_NAME], missed_calls,
        p_online, p_number, blacklist_status;
    STRING_GLOBAL = ""I"[1]"W" �������� �������\n"I"[2]"W" ����� ��������������� �����\n";
    for(new i; i < rows; i++)
    {
        if(rows < sizeof(Phone_NickName))
        {
            cache_get_value_name(i, "NickTarget", NickTarget, MAX_PLAYER_NAME);
            cache_get_value_name_int(i, "phone_number", p_number);
            cache_get_value_name_int(i, "MissedCalls",missed_calls);
            cache_get_value_name_int(i, "online",p_online);
            cache_get_value_name_int(i, "BlackList", blacklist_status);

            f(STRING_GLOBAL, "%s"I"[%d]"W" %s %s%s, �����: %d, �����������: %d\n",
                STRING_GLOBAL, i + 1, NickTarget, p_online != 0 ? "[{41BE13}ON"W"]" : "[{00FF00}OFF"W"]", blacklist_status == 1 ? "[��]" : "", p_number, missed_calls);

            format(Phone_NickName[playerid][i], 24, "%s", NickTarget);
        }
    }
    ShowPlayerDialog(playerid, D_PHONE_CONTACTS, DIALOG_STYLE_LIST, ""I"��������", STRING_GLOBAL,"�������","������");
    return 1;
}

