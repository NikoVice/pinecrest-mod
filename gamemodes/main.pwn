            SetPlayerMoney(playerid, price, true, "продал рыбу <%s>", ItemsInfo[type][iName]);
            SendAccess(playerid, "Вы продали %d ед. \"%s\" за %d$.", fix_listitem, ItemsInfo[type][iName], price);
