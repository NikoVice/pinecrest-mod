            new fraction_id = p_temp[playerid][p_listitem_int],
                modelid, rangid, count;
            if(sscanf(inputtext, "p<,>iii", modelid, rangid, count)) return SendError(playerid, "���-�� �� ���, ���������� ��� ���.");
            if(modelid < 400 && modelid != 0) return SendError(playerid, "���-�� �� ���, ���������� ��� ���.");
            if(!(1 <= rangid <= MAX_FRACTIONS_RANGS)) return SendError(playerid, "���-�� �� ���, ���������� ��� ���.");
            if(!(1 <= count <= 10)) return SendError(playerid, "���-�� �� ���, ���������� ��� ���.");
            new idx = GetSlotFractionVehicle(fraction_id, modelid);
