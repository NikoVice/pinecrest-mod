            new tax = UndergroundBotsInfo[idx][ubTax];
            if(tax <= 0) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx), SendError(playerid, "Данный рабочий ещё не обладает налогом.");
            if(p_info[playerid][cash] < tax) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx), SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            UndergroundBotsInfo[idx][ubTax] = 0;
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `underground` SET `tax` = 0 WHERE `id` = %d",
            UndergroundBotsInfo[idx][ubMySQLIDx]);
            mysql_tquery(con_bd, STRING_GLOBAL);
            new biz_id = UndergroundBotsInfo[idx][ubBizIDx];
            if(b_info[biz_id][_prod] >= ((tax / 100) * 20) / 100)
            {
                b_info[biz_id][_prod] -= ((tax / 100) * 20) / 100;
                b_info[biz_id][_bank] += ((tax / 100) * 20) - ((tax / 100) * 2);
                AddMafiaBank(biz_id, (tax / 100) * 2);

                biz_finka[biz_id] += ((tax / 100) * 20) - ((tax / 100) * 2);
                UpdateIntForFinanceBiz(biz_id, ((tax / 100) * 20) - ((tax / 100) * 2));
            }
            SendAccess(playerid, "Вы оплатили налог на электричество в размере %d$.", tax);
            SetPlayerMoney(playerid, -tax, true, "оплатил налог на электричество");
            ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx);
            return 1;
        }
        case D_UNDERGROUND_SALARY:
        {
            new idx = p_temp[playerid][underground_idx];
            if(!response) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx);
            if(UndergroundBotsInfo[idx][ubBizIDx] == 0) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx), SendError(playerid, "У данного рабочего нет договора с электростанцией.");
            new salary = UndergroundBotsInfo[idx][ubSalary];
            if(salary <= 0) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx), SendError(playerid, "Данный рабочий ещё не обладает заработной платой.");
            if(p_info[playerid][cash] < salary) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx), SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            UndergroundBotsInfo[idx][ubSalary] = 0;
            new bizz_id = FREELANCE_BIZZ_ID;
            if(b_info[bizz_id][_prod] >= salary / 100)
            {
                b_info[bizz_id][_prod] -= salary / 100;
                b_info[bizz_id][_bank] += salary / 5;
                AddMafiaBank(bizz_id, (salary / 5) / 10);

                biz_finka[bizz_id] += salary / 5;
                UpdateIntForFinanceBiz(bizz_id, salary / 5);
            }
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `underground` SET `salary` = 0 WHERE `id` = %d",
            UndergroundBotsInfo[idx][ubMySQLIDx]);
            mysql_tquery(con_bd, STRING_GLOBAL);
            SendAccess(playerid, "Вы оплатили заработную плату в размере %d$.", salary);
            SetPlayerMoney(playerid, -salary, true, "оплатил заработную плату");
            ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx);
            return 1;
        }
        case D_UNDERGROUND_POWER_STATION:
        {
            new idx = p_temp[playerid][underground_idx];
            if(!response) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx);
            new temp_idx = p_temp[playerid][p_listitem][listitem];
            for(new i = 0; i < 100; i++) p_temp[playerid][p_listitem][i] = -1;
            if(temp_idx == -1) return SendError(playerid, "Что-то пошло не так, попробуйте заново или обновите версию клиента.");
            if(UndergroundBotsInfo[idx][ubTax] != 0) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx), SendError(playerid, "У данного рабочего есть налог, оплатите его.");
            UndergroundBotsInfo[idx][ubBizIDx] = temp_idx;
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `underground` SET `biz` = %d WHERE `id` = %d",
            UndergroundBotsInfo[idx][ubBizIDx], UndergroundBotsInfo[idx][ubMySQLIDx]);
            mysql_tquery(con_bd, STRING_GLOBAL);
            SendAccess(playerid, "Вы изменили электростанцию на %s.", b_info[temp_idx][_name]);
            ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx);
            return 1;
        }
        case D_UNDERGROUND_UPGRADE:
        {
            new idx = p_temp[playerid][underground_idx];
            if(!response) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx);
            new temp_education = UndergroundBotsInfo[idx][ubEducation];
            if(temp_education == 3) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx), SendError(playerid, "Данная рабочий имеет \"%s\" образование.", UndergroundBotsName[temp_education - 1]);
            if(!GetInventoryAmount(playerid, 710)) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx), SendError(playerid, "У Вас нет микросхемы для станка.");
            new price = UNDERGROUND_BOTS_EDUCATION_PRICE * temp_education;
            if(p_info[playerid][cash] < price) return ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx), SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            GivePlayerInventory(playerid, 710, -1);
            SetPlayerMoney(playerid, -price, true, "под. помещение: повышение образование");
            new vc_upgrade_percent[2] = {50, 25};
            if(random(100) < vc_upgrade_percent[UndergroundBotsInfo[idx][ubEducation] - 1])
            {
                UndergroundBotsInfo[idx][ubEducation]++;
                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `underground` SET `education` = %d WHERE `id` = %d",
                UndergroundBotsInfo[idx][ubEducation], UndergroundBotsInfo[idx][ubMySQLIDx]);
                mysql_tquery(con_bd, STRING_GLOBAL);
                SendAccess(playerid, "Вы повысили образование рабочего до \"%s\".", UndergroundBotsName[UndergroundBotsInfo[idx][ubEducation] - 1]);
                ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx);
            } else ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx), SendError(playerid, "У Вас не получилось повысить образование рабочего.");
            return 1;
        }
        case D_UNDERGROUND_HELP:
        {
            new idx = p_temp[playerid][underground_idx];
            if(idx == -1) return 1;
            ShowUndergroundBots(playerid, UNDERGROUND_B_TYPE_CONTROL, idx);
            return 1;
        }
        case D_UNDERGROUND_NPC:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0:
                {
                    ShowPlayerDialog(playerid, D_UNDERGROUND_INFO, DIALOG_STYLE_MSGBOX, ""I"Владелец рынка вещей Ара", ""W"\
                    Привет! Меня зовут "I"Ара,"W" я — "I"владелец рынка вещей,"W" который продает материалы для изготовления\n\
                    вещей и приобретает ящики с вещами.\n\n\
                    После приобретения материалов для изготовления вещей, их можно изготовить в "I"подпольном помещении"W"\n\
                    в каждом доме.\n\n\
                    Изготовленные вещи помещаются в ящики, которые делятся на 3 класса — "I"обычный, средний и элитный."W"\n\
                    Чем выше класс — тем "I"дороже ящик."W"\n\n\
                    Ознакомиться с подробным описанием изготовления вещей можно в меню: "I"/mn > Помощь по игре > Подпольные\n\
                    помещения.", "Закрыть", "");
                }
                case 1:
                {
                    STRING_GLOBAL[0] = EOS;
                    for(new i; i < sizeof(UndergroundBotsInfoList); i++) strcat(STRING_GLOBAL, UndergroundBotsInfoList[i]);
                    ShowPlayerDialog(playerid, D_UNDERGROUND_INFO, DIALOG_STYLE_MSGBOX, ""I"Информация об подпольном помещении", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 2: ShowUndergroundBots(playerid, UNDERGROUND_TYPE_NPC_BUY);
                case 3: ShowUndergroundBots(playerid, UNDERGROUND_TYPE_NPC_SELL);
                case 4:
                {
                    ShowPlayerList(playerid, LIST_ID_ARA_SELL_ITEMS);
                }
            }
            return 1;
        }
        case D_UNDERGROUND_NPC_BUY:
        {
            if(!response) return ShowUndergroundBots(playerid, UNDERGROUND_TYPE_NPC);
            new price = ItemsInfo[717][iPrice];
            if(p_info[playerid][cash] < price) return ShowUndergroundBots(playerid, UNDERGROUND_TYPE_NPC), SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            if(!GivePlayerInventory(playerid, 717, 1)) return ShowUndergroundBots(playerid, UNDERGROUND_TYPE_NPC), SendError(playerid, "В инвентаре нет столько места.");
            SetPlayerMoney(playerid, -price, true, "купил материалы для рабочих");
            SendAccess(playerid, "Вы приобрели \"%s\".", ItemsInfo[717][iName]);
            ShowUndergroundBots(playerid, UNDERGROUND_TYPE_NPC_BUY);
            return 1;
        }
        case D_UNDERGROUND_NPC_SELL:
        {
            if(!response) return ShowUndergroundBots(playerid, UNDERGROUND_TYPE_NPC);
            new items_idx = underground_items[listitem], count = GetInventoryAmount(playerid, items_idx);
            if(count == 0) return ShowUndergroundBots(playerid, UNDERGROUND_TYPE_NPC_SELL), SendError(playerid, "У Вас нет \"%s\".", ItemsInfo[items_idx][iName]);
            GivePlayerInventory(playerid, items_idx, -count);
            new price = ItemsInfo[items_idx][iPrice] * count;
            SetPlayerMoney(playerid, price, true, "продал предметы на складе вещей");
            SendAccess(playerid, "Вы продали \"%s\" в количестве %d шт. за %d$.", ItemsInfo[items_idx][iName], count, price);
            Log(LOG_player, INFO, "%s[%d](%s %s) продал <%s> в кол-ве %d шт. за %d$ | #SellUndergroundItems",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
            ItemsInfo[items_idx][iName], count, price);
            ShowUndergroundBots(playerid, UNDERGROUND_TYPE_NPC_SELL);
            return 1;
        }
        case D_UNDERGROUND_INFO: return ShowUndergroundBots(playerid, UNDERGROUND_TYPE_NPC);
        case D_ANIMLIST:
        {
            if(!response) return 1;
            GivePlayerAnim(playerid, listitem);
            return 1;
        }
        case D_ADVERTISE:
        {
            if(!response) return 1;
            if(!strlen(inputtext)) return SendAdvertDialog(playerid);
            if(strlen(inputtext) > 96) return SendAdvertDialog(playerid);
            if(p_info[playerid][p_add_vip] == 0 && p_info[playerid][cash] < ADVERT_PRICE) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            new total = -1;
            for(new i; i < MAX_NEWS_ADS; i++)
            {
                if(AdvertInfo[i][aPhone] == p_info[playerid][phone_number])
                {
                    total = i;
                    break;
                }
            }
            if(total != -1) return SendError(playerid, "В радиоцентрах уже есть Ваше объявление.");
            new idx = -1;
            for(new i; i < MAX_NEWS_ADS; i++)
            {
                if(AdvertInfo[i][aStatus] == 0)
                {
                    idx = i;
                    break;
                }
            }
            if(idx == -1) return SendError(playerid, "В радиоцентрах нет свободных мест для объявлений.");
            format(AdvertInfo[idx][aSender], MAX_PLAYER_NAME, get_name(playerid));
            format(AdvertInfo[idx][aText], 128, inputtext);
            AdvertInfo[idx][aPhone] = p_info[playerid][phone_number];
            AdvertInfo[idx][aStatus] = 1;
            AdvertInfo[idx][aVIP] = p_info[playerid][p_vip] == 0 ? false : true;
            if(p_info[playerid][p_add_vip] == 0) SetPlayerMoney(playerid, -ADVERT_PRICE, true, "отправил объявление");
            SendAccess(playerid, "Вы подали объявление, ожидайте его публикации.");
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] подал объявление. Используйте /edit для редактирования объявления.", get_name(playerid), playerid);
            SendFractionMessage(RADIO_LS, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(RADIO_SF, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(RADIO_LV, 0x33CC66FF, STRING_GLOBAL);
            return 1;
        }
        case D_ADVERTISE_LIST:
        {
            if(!response) return 1;
            ChoosenAdvert[playerid] = listitem;
            if(AdvertInfo[listitem][aStatus] == 0) return AdvertList(playerid);
            if(AdvertInfo[listitem][aAlreadyEdited] == 1 && strcmp(AdvertInfo[listitem][aEdited], get_name(playerid), true) && p_info[playerid][rang] < 9) return SendError(playerid, "Данное объявление уже отредактировано."), AdvertList(playerid);
            if(AdvertInfo[listitem][aIsTooked] == true) return SendError(playerid, "Данное объявление уже проверяется."), AdvertList(playerid);
            SetPVarInt(playerid, "advert_id_to_sending", listitem + 1);
            AdvertInfo[listitem][aIsTooked] = true;
            STRING_MIN[0] = EOS;
            format(STRING_MIN, sizeof(STRING_MIN), ""I"%s", AdvertInfo[listitem][aText]);
            ShowPlayerDialog(playerid, D_ADVERTISE_LIST_ACT, DIALOG_STYLE_LIST, STRING_MIN, ""I"[1]"W" Недвижимость\n"I"[2]"W" Предприятие\n"I"[3]"W" Транспорт\n"I"[4]"W" Аксессуар\n"I"[5]"W" Ресурс\n"I"[6]"W" Скин\n"I"[7]"W" Редактировать", "Далее", "Отмена");
            return 1;
        }
        case D_ADVERTISE_LIST_ACT:
        {
            if(!response)
            {
                AdvertInfo[GetPVarInt(playerid, "advert_id_to_sending") - 1][aIsTooked] = false;
                DeletePVar(playerid, "advert_id_to_sending");
                return AdvertList(playerid);
            }
            new idx = ChoosenAdvert[playerid];
            if(AdvertInfo[idx][aStatus] == 0)
            {
                AdvertInfo[GetPVarInt(playerid, "advert_id_to_sending") - 1][aIsTooked] = false;
                DeletePVar(playerid, "advert_id_to_sending");
                return AdvertList(playerid);
            }
            if(p_info[playerid][mute] > 0)
            {
                SendError(playerid, "У Вас блокировка чата.");
                AdvertInfo[GetPVarInt(playerid, "advert_id_to_sending") - 1][aIsTooked] = false;
                DeletePVar(playerid, "advert_id_to_sending");
                return AdvertList(playerid);
            }
            STRING_MIN[0] = EOS;
            format(STRING_MIN, sizeof(STRING_MIN), ""I"%s", AdvertInfo[idx][aText]);
            switch(listitem)
            {
                case 0: ShowPlayerDialog(playerid, D_ADVERTISE_HOUSE, DIALOG_STYLE_LIST, STRING_MIN, ""I"[1]"W" Продажа дома\n"I"[2]"W" Покупка дома\n"I"[3]"W" Сдача комнаты\n"I"[4]"W" Аренда комнаты", "Далее", "Отмена");
                case 1: ShowPlayerDialog(playerid, D_ADVERTISE_BIZ, DIALOG_STYLE_LIST, STRING_MIN, ""I"[1]"W" Продажа бизнеса\n"I"[2]"W" Покупка бизнеса", "Далее", "Отмена");
                case 2: ShowPlayerDialog(playerid, D_ADVERTISE_CAR, DIALOG_STYLE_LIST, STRING_MIN, ""I"[1]"W" Продажа транспорта\n"I"[2]"W" Покупка транспорта\n"I"[3]"W" Покупка любого транспорта\n"I"[4]"W" Обмен транспорта", "Далее", "Отмена");
                case 3: ShowPlayerDialog(playerid, D_ADVERTISE_ACC, DIALOG_STYLE_LIST, STRING_MIN, ""I"[1]"W" Продажа аксессуара\n"I"[2]"W" Покупка аксессуара\n"I"[3]"W" Обмен аксессуара", "Далее", "Отмена");
                case 4: ShowPlayerDialog(playerid, D_ADVERTISE_RES, DIALOG_STYLE_LIST, STRING_MIN, ""I"[1]"W" Продажа ресурса\n"I"[2]"W" Покупка ресурса", "Далее", "Отмена");
                case 5: ShowPlayerDialog(playerid, D_ADVERTISE_SKIN, DIALOG_STYLE_LIST, STRING_MIN, ""I"[1]"W" Продажа скина\n"I"[2]"W" Покупка скина\n"I"[3]"W" Обмен скина", "Далее", "Отмена");
                case 6:
                {
                    new str[32];
                    if(AdvertInfo[idx][aAlreadyEdited] == 1) format(str, sizeof(str), "%s", AdvertInfo[idx][aEdited]);
                    else format(str, sizeof(str), "Нет");
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    Отправил(-а): "I"%s"W"\n\
                    Проверил(-а): "I"%s"W"\n\n\
                    Текст: "I"%s"W"\n\n\
                    Введите текст или поставьте знак - для отклонения объявления\n\
                    или знак + для отправки объявления:", AdvertInfo[idx][aSender], str, AdvertInfo[idx][aText]);
                    ShowPlayerDialog(playerid, D_ADVERTISE_EDIT, DIALOG_STYLE_INPUT, ""I"Редактирование объявления", STRING_GLOBAL, "Далее", "Отмена");
                }
            }
            return 1;
        }
        case D_ADVERTISE_EDIT:
        {
            if(!response)
            {
                AdvertInfo[GetPVarInt(playerid, "advert_id_to_sending") - 1][aIsTooked] = false;
                DeletePVar(playerid, "advert_id_to_sending");
                return AdvertList(playerid);
            }
            new idx = ChoosenAdvert[playerid];
            if(AdvertInfo[idx][aStatus] == 0)
            {
                AdvertInfo[GetPVarInt(playerid, "advert_id_to_sending") - 1][aIsTooked] = false;
                DeletePVar(playerid, "advert_id_to_sending");
                return AdvertList(playerid);
            }
            if(p_info[playerid][mute] > 0)
            {
                SendError(playerid, "У Вас блокировка чата.");
                AdvertInfo[GetPVarInt(playerid, "advert_id_to_sending") - 1][aIsTooked] = false;
                DeletePVar(playerid, "advert_id_to_sending");
                return AdvertList(playerid);
            }
            if(!strlen(inputtext))
            {
                new str[32];
                if(AdvertInfo[idx][aAlreadyEdited] == 1) format(str, sizeof(str), "%s", AdvertInfo[idx][aEdited]);
                else format(str, sizeof(str), "Нет");
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                Отправил(-а): "I"%s"W"\n\
                Проверил(-а): "I"%s"W"\n\n\
                Текст: "I"%s"W"\n\n\
                Введите текст или поставьте знак - для отклонения объявления\n\
                или знак + для отправки объявления:", AdvertInfo[idx][aSender], str, AdvertInfo[idx][aText]);
                return ShowPlayerDialog(playerid, D_ADVERTISE_EDIT, DIALOG_STYLE_INPUT, ""I"Редактирование объявления", STRING_GLOBAL, "Далее", "Отмена");
            }
            if(strlen(inputtext) > 96)
            {
                new str[32];
                if(AdvertInfo[idx][aAlreadyEdited] == 1) format(str, sizeof(str), "%s", AdvertInfo[idx][aEdited]);
                else format(str, sizeof(str), "Нет");
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                Отправил(-а): "I"%s"W"\n\
                Проверил(-а): "I"%s"W"\n\n\
                Текст: "I"%s"W"\n\n\
                Введите текст или поставьте знак - для отклонения объявления\n\
                или знак + для отправки объявления:", AdvertInfo[idx][aSender], str, AdvertInfo[idx][aText]);
                return ShowPlayerDialog(playerid, D_ADVERTISE_EDIT, DIALOG_STYLE_INPUT, ""I"Редактирование объявления", STRING_GLOBAL, "Далее", "Отмена");
            }
            if(!strcmp(inputtext, "-", true))
            {
                new str[32];
                if(AdvertInfo[idx][aAlreadyEdited] == 1) format(str, sizeof(str), "%s", AdvertInfo[idx][aEdited]);
                else format(str, sizeof(str), "Нет");
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                Отправил(-а): "I"%s"W"\n\
                Проверил(-а): "I"%s"W"\n\n\
                Текст: "I"%s"W"\n\n\
                Для отклонения объявления необходимо написать причину:", AdvertInfo[idx][aSender], str, AdvertInfo[idx][aText]);
                return ShowPlayerDialog(playerid, D_ADVERTISE_DELETE, DIALOG_STYLE_INPUT, ""I"Отклонение объявления", STRING_GLOBAL, "Далее", "Отмена");
            }
            if(p_info[playerid][mute] > 0) return SendError(playerid, "У Вас блокировка чата.");
            if(strcmp(inputtext, "+", true)) format(AdvertInfo[idx][aText], 128, inputtext);
            format(AdvertInfo[idx][aEdited], MAX_PLAYER_NAME, get_name(playerid));
            if(AdvertInfo[idx][aAlreadyEdited] != 1)
            {
                AdvertInfo[idx][aAlreadyEdited] = 1;
                AdvertInfo[idx][aQueue] = AdvertSendingInfo[2];
                AdvertSendingInfo[2]++;
                if(AdvertSendingInfo[2] >= MAX_NEWS_ADS) AdvertSendingInfo[2] = 0;
                SendAccess(playerid, "Вы отправили объявление. К Вашей зарплате добавлено: %d$.", ADVERT_PRICE / 2);
                SetPlayerMoney(playerid, ADVERT_PRICE / 2, true, "отредактировал объявление");
                SetFractionWarehouse(p_info[playerid][member], fwMoney, ADVERT_PRICE/2);

                AdvertList(playerid);
                p_info[playerid][fracdata][17]++;
                SaveFracData(playerid);
                CheckPlayerMission(playerid, NEWS_EDIT);
                UpdateFamilyLevel(playerid);
                p_info[playerid][ftop_edit]++;
                MysqlUpdatePlayerInt(playerid, "ftop_edit", p_info[playerid][ftop_edit]);

                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `user_id` FROM `edit_advertise` WHERE `user_id` = %d",
                p_info[playerid][ID]);
                mysql_tquery(con_bd, STRING_GLOBAL, "OnMemoryCheckPlayerID", "i", playerid);
            }
            else SendAccess(playerid, "Вы отредактировали объявление.");
