this::CheckedIsPC(playerid)
{
    if(IsPlayerMobile(playerid))
    {
        printf("CHEAT_LOG: not PC - %s", get_name(playerid));
        p_temp[playerid][mobile_version] = -1;

        new nick_name[MAX_PLAYER_NAME];
        f(nick_name, "%s%s[PC]", get_name(playerid));
        SetPlayerName(playerid, nick_name);
    }
    p_temp[playerid][is_mobile] = false;
    
    return 1;
}

ShowDialogAraSellItems(playerid, slot_id)
{
    STRING_GLOBAL[0] = EOS;
    new itemID = InventoryPlayer[playerid][slot_id][inv_item_id],
        dialog_stype = DIALOG_STYLE_MSGBOX;
    if(ItemsInfo[itemID][iType] == TYPE_ITEMS_INVENTORY)
    {
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"������� ���-�� \"%s\" ���� �� 1�� %d$:", ItemsInfo[itemID][iName], ItemsInfo[itemID][iStateCost]);
        dialog_stype = DIALOG_STYLE_INPUT;
    }
    else if(ItemsInfo[itemID][iType] == TYPE_ITEMS_ACCESSORIES ||
        ItemsInfo[itemID][iType] == TYPE_ITEMS_SKINS ||
        ItemsInfo[itemID][iType] == TYPE_ITEMS_VEHICLE_TUNE)
    {
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"��������� \"%s\" �� 1 ��. %d$", ItemsInfo[itemID][iName], ItemsInfo[itemID][iStateCost]);
    }
    else return SendError(playerid, "������ ���� ��������� ���� �� �����������.");
    ShowPlayerDialog(playerid, D_ARA_SELL_ITEM, dialog_stype, ""I"��������� ������", STRING_GLOBAL, "�����", "������");
    return 1;
}

