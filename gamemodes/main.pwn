                {
                    if(p_temp[playerid][bonfire_object] == INVALID_OBJECT_ID) return SendError(playerid, "Сначало зажгите костер.");
                    new Float:object_pos[3];
                    Streamer_GetFloatData(STREAMER_TYPE_OBJECT, p_temp[playerid][bonfire_object], E_STREAMER_X, object_pos[0]);
