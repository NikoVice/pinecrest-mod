}

CMD:switchskin(playerid, params[])
{
    if(!mafia(playerid) && !gang(playerid) && !biker(playerid)) return SendError(playerid, "�� �� �������� � ����������� �����������.");
    if(p_info[playerid][army_skin] == 0) return SendError(playerid, "� ��� ��� �����.");
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return SendError(playerid, "� ������ ������ �� �� ������ ������ �����.");
    SetPlayerSkin(playerid, 287);
    p_info[playerid][army_skin] = 0;
    SendAccess(playerid, "�� ������ ����� �������.");
    return 1;
}

CMD:sellskin(playerid, params[])
{
    if(p_info[playerid][member] != NATIONAL_GUARD || p_info[playerid][rang] < 6) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "�����������: /sellskin [id ������] [���������]");
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "����� �� ������.");
    if(params[0] == playerid) return SendError(playerid, "�� ����� ���� ID.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "����� ������� ������ �� ���.");
    if(params[1] < 1 || params[1] > 50000) return SendError(playerid, "��������� ������ ���� �� ����� 1$ � �� ����� 50000$.");
    if(!mafia(params[0]) && !gang(params[0]) && !biker(params[0])) return SendError(playerid, "����� �� ������� � ����������� �����������.");

    SendAccess(playerid, "�� ���������� %s [%d] ���������� ����� �� %d$.", get_name(params[0]), params[0], params[1]);
    SendInfo(params[0], "%s [%d] ��������� ��� ���������� ����� �� %d$.", get_name(playerid), playerid, params[1]);

    SetFreeSlotOffer(params[0], playerid, OFFER_ID_BUY_ARMY_SKIN, params[1]);
    return 1;
}

CMD:getgun(playerid, params[])
{
    if(!(p_info[playerid][member] != 0 && p_info[playerid][fwork] == true)) return 1;

    new id = p_info[playerid][member];
    if(GetFactionCategory(id) != FACTION_CATEGORY_PD &&
        GetFactionCategory(id) != FACTION_CATEGORY_FBI &&
        GetFactionCategory(id) != FACTION_CATEGORY_ARMY &&
        GetFactionCategory(id) != FACTION_CATEGORY_MAYOR &&
        GetFactionCategory(id) != FACTION_CATEGORY_PRISON) return 1;

    if(GetPlayerInterior(playerid) != FractionsData[id][fBaseField][fInterior]) return 1;

    if((p_info[playerid][rang] < 2 && GetFactionCategory(id) != FACTION_CATEGORY_ARMY) &&
       (p_info[playerid][rang] < 2 && GetFactionCategory(id) != FACTION_CATEGORY_MAYOR))
        return SendError(playerid, "�� �� ��������.");

    if(!IsPlayerInRangeOfPoint(playerid, 15.0, FractionsData[id][fWarehousePos][0], FractionsData[id][fWarehousePos][1], FractionsData[id][fWarehousePos][2])) return 1;
    if(!GetFractionSettings(id, fWareHouseStatus) && p_info[playerid][rang] != 10) return SendError(playerid, "����� ������ �����.");

    if(GetFactionCategory(id) == FACTION_CATEGORY_MAYOR)
    {
        if(p_info[playerid][rang] > 2)
            return SendError(playerid, "�� �� ��������.");
        if(GetFractionWarehouse(id, fwPatron) < 25) {
            SendError(playerid, "�� ������ ������������ ��������.");
            return 1;
        }
        if(GetFractionWarehouse(id, fwMate) < 50) {
            SendError(playerid, "�� ������ ������������ ����������.");
            return 1;
        }

        new weapon, ammo;
        GetPlayerWeaponData(playerid, WEAPON_Slot[WEAPON_DEAGLE], weapon, ammo);
        if((weapon == WEAPON_DEAGLE) && (ammo >= 10)) return SendError(playerid, "� ��� ��� ���� ������ ������� ����.");

        SetFractionWarehouse(MAYOR_LS, fwMate, -50);
        SetFractionWarehouse(MAYOR_LS, fwPatron, -25);

        f_GivePlayerWeapon(playerid, WEAPON_DEAGLE, 25);

        SendInfo(playerid, "��� ����� ���������� � Desert Eagle � %d ���������.", 25);

        SetPlayerArmour(playerid, 100.0);

        SendInfo(playerid, "��� �� ����� ���������� �������: /unarm");
        return 1;
    }

    new i;
    STRING_GLOBAL[0] = EOS;
    if(GetFactionCategory(id) == FACTION_CATEGORY_PD){
        for (new j = sizeof(pdWEAPON); i < j; i++) {
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" %s (������ - %i, ����� - %i)\n", STRING_GLOBAL, i+1, WEAPON_Name[pdWEAPON[i][g_Id]], pdWEAPON[i][g_Patr], pdWEAPON[i][g_Matr]);
        }
    } else if(GetFactionCategory(id) == FACTION_CATEGORY_FBI) {
        for (new j = sizeof(fbiWEAPON); i < j; i++) {
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" %s (������ - %i, ����� - %i)\n", STRING_GLOBAL, i+1, WEAPON_Name[fbiWEAPON[i][g_Id]], fbiWEAPON[i][g_Patr], fbiWEAPON[i][g_Matr]);
        }
    } else if(GetFactionCategory(id) == FACTION_CATEGORY_ARMY) {
        for (new j = sizeof(armyWEAPON); i < j; i++) {
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" %s (������ - %i, ����� - %i)\n", STRING_GLOBAL, i+1, WEAPON_Name[armyWEAPON[i][g_Id]], armyWEAPON[i][g_Patr], armyWEAPON[i][g_Matr]);
        }
    } else if(GetFactionCategory(id) == FACTION_CATEGORY_PRISON) {
        for (new j = sizeof(prisonWEAPON); i < j; i++) {
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" %s (������ - %i, ����� - %i)\n", STRING_GLOBAL, i+1, WEAPON_Name[prisonWEAPON[i][g_Id]], prisonWEAPON[i][g_Patr], prisonWEAPON[i][g_Matr]);
        }
    }
    ShowPlayerDialog(playerid, D_GET_GUN, DIALOG_STYLE_LIST, ""I"�������� ������", STRING_GLOBAL, "�������", "�����");
    new Float:p_armour;
    GetPlayerArmour(playerid, p_armour);
    if(p_armour <= 90.0) {
        SetPlayerArmour(playerid, 100.0);
        SendInfo(playerid, "��� ����� ����������.");
        SendInfo(playerid, "��� �� ����� ���������� �������: /unarm");
    }
    return 1;
}

