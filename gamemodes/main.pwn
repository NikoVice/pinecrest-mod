            new fix_listitem;
            if(sscanf(inputtext, "i", fix_listitem))
            {
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы желаете выставить на аукцион бизнес?\n\nВведите стоимость от половины гос. стоимости до полной:\n\nГос. стоимость: %d$.", b_info[b][_price]);
                ShowPlayerDialog(playerid, D_BIZZ_SELL_AUCTION,DIALOG_STYLE_INPUT, ""I"Выставить на аукцион", STRING_GLOBAL, "Далее", "Отмена");
