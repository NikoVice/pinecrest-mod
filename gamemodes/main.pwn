                if(CheckPlayerMaxSalarySkill(playerid, 15, reason_money))
                {
                    SetPlayerMoney(playerid, reason_money, false, "зарплата машинист поезда");
                    OnServerInfoForMoney[17] += reason_money;

                    p_info[playerid][job_skill_salary][15] += reason_money;
                }
                else SendError(playerid, "За последний час игры было заработано максимальное количество денежных средств.");

                p_temp[playerid][pPressed]++;
                new idx = p_temp[playerid][pPressed];
                if(Train[idx][trainStop] == 1) SetPlayerRaceCheckpoint(playerid, 1, Train[idx][trainPosX], Train[idx][trainPosY], Train[idx][trainPosZ]-1.5, 0, 0, 0, 3.0), p_temp[playerid][TrainStop] = true;
                else SetPlayerRaceCheckpoint(playerid, 0, Train[idx][trainPosX], Train[idx][trainPosY], Train[idx][trainPosZ]-1.5, Train[idx+1][trainPosX], Train[idx+1][trainPosY], Train[idx+1][trainPosZ]-1.5, 3.0);
            }
