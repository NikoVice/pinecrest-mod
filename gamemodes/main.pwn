                case 23:
                {
                    ShowPlayerDialog(playerid, D_HELP_BACK, DIALOG_STYLE_MSGBOX, ""I"Ларцы", ""W"\
                    Ларец — предмет инвентаря, открыв который, можно получить "I"уникальные транспортные средства, скины и\n\
                    аксессуары."W"\n\n\
                    Ларцы делятся на типы, всего их 11. Каждый ларец отличается списком наград и способом получения:\n\n\
                    "I"1."W" Ларец гос. служащего - "I"выдается случайным образом в PayDay находясь в гос. организации."W"\n\
                    "I"2."W" Нелегальный ларец - "I"выдается случайным образом в PayDay находясь в нелегальной организации."W"\n\
                    "I"3."W" Ларец новичка - "I"выдается с шансом 5 процентов на первоначальных работах."W"\n\
                    "I"4."W" Развлекательный ларец - "I"выдается с шансом 5 процентов участвуя в мероприятиях."W"\n\
                    "I"5."W" Семейный ларец - "I"выдается случайным образом в PayDay находясь в семье."W"\n\
                    "I"6."W" Ларец освоившегося, "I"7."W" Start Car Box, "I"8."W" Medium Car Box,\n\
                    "I"9."W" Super Car Box, "I"10."W" Ларец с аксессуарами, "I"11."W" Ларец со скинами -\n\
                    "I"выдается с шансом 5 процентов: на основных работах, при выполнении начальных заданий,\n\
                    ежедневных заданий, фракционных заданий и достижений, при выполнении заданий на бирже\n\
                    труда и при выполнении заданий Battle Pass."W"\n\n\
                    {"#cLIGHTRED"}Обратите внимании:"W"\n\n\
                    \t"I"—"W" На работе ремонтника дорог получить ларец можно при каждом разгруженном мешке с мусором на свалку.\n\
                    \t"I"—"W" На работе инкассатора получить ларец можно при каждом перенесенном кейсе с деньгами.\n\
                    \t"I"—"W" На работе пожарного получить ларец можно при ликвидации каждого очага возгорания.\n\
                    \t"I"—"W" На работе электрика получить ларец можно при каждом перенесенном ящике с металлоломом на свалке.\n\
                    \t"I"—"W" На работе нефтяника получить ларец можно при каждой продаже бочки с нефтью.\n\n\
                    Кроме этого, ларцы можно приобрести в "I"донате"W" и на центральном рынке.\n\n\
                    {"#cLIGHTRED"}Обратите внимании:"W"\n\n\
                    "I"—"W" С VIP Gold или ADD VIP больше шанс получения уникальной награды.\n\
                    "I"—"W" На работе нефтяника при продаже каждой бочки ларцы выдаются с шансом 10 процентов.", "Далее", "Отмена");
                }
                case 24:
                {
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, ""W"\
                    На сервере есть "I"%d"W" автосалонов, каждые "I"%d"W" час(-а/-ов) в них появляются транспортные средства.\n\n\
                    После поступления транспортного средства в автосалон, для приобретения оно будет доступно в течении "I"%d"W" час(-а/-ов).\n\
                    По истечению времени оно будет удалено из автосалона, а на его место поступит новое транспортное средство.\n\n\
                    Ближайшее поступление через "I"%d"W" час(-а/-ов):", MAX_CAR_SHOP, MAX_PAY_DAY_CAR_SHOP, MAX_PAY_DAY_CAR_SHOP_DELETE, new_car_payday);
                    new vehicle_model;
                    for(new i = 0; i < MAX_CAR_SHOP; i++)
                    {
                        vehicle_model = new_car_list[i];
                        if(vehicle_model != -1)
                        {
                            f(STRING_GLOBAL, "%s\n\n%s - %s [ID: "I"%d"W"]", STRING_GLOBAL, car_shop_name[i], GetVehicleName(INVALID_VEHICLE_ID, vehicle_model), vehicle_model);
                        }
                    }
                    strcat(STRING_GLOBAL, "\n\n{"#cLIGHTRED"}Обратите внимание! Если на территории автосалона не будет хватать места под новое транспортное средство, оно не появится!");
                    ShowPlayerDialog(playerid, D_HELP_BACK, DIALOG_STYLE_MSGBOX, ""I"Автосалоны", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 25:
                {
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, ""W"\
                    На сервере есть возможность арендовать транспортное средство. Всего существует "I"%d"W" бизнеса,\n\
                    предоставляющих транспортные средства для аренды. В каждом городе расставлены будки для аренды\n\
                    транспортных средств. Найти ближайшее место для аренды: "W"/gps > [18] Ближайшая аренда транспорта"W"\n\n\
                    Стоимость аренды транспортных средств по классам:\n\n\
                    \tNope - 2500$;\n\
                    \tC - 5000$;\n\
                    \tB - 7500$;\n\
                    \tA - 10000$.\n\n\
                    Список мест и количество транспортных мест:\n\n\
                    Los-Santos:\n\n\
                    \tПравительство (3 шт)\n\
                    \tБиржа труда (3 шт)\n\
                    \tАвторынок (3 шт)\n\
                    \tВоенкомат (3 шт)\n\
                    \tЦентральный рынок, больница (7 шт)\n\
                    \tАукцион контейнеров (3 шт)\n\
                    \tФерма (3 шт)\n\
                    \tБанк, центра развлечений (3 шт)\n\
                    \tАренда (12 шт)\n\n\
                    San-Fierro:\n\n\
                    \tАвтошкола (3 шт)\n\
                    \tАвтовокзал (7 шт)\n\
                    \tШахта (3 шт)\n\
                    \tБанк (3 шт)\n\
                    \tБольница (6 шт)\n\
                    \tАренда (6 шт)\n\n\
                    Las-Venturas:\n\n\
                    \tАвтовокзал (7 шт)\n\
                    \tБанк (3 шт)\n\
                    \tБольница (7 шт)\n\
                    \tCasino Four Dragons (5 шт)\n\
                    \tCasino Caligula (3 шт)\n\
                    \tАренда (5 шт)", 3, 40);
                    ShowPlayerDialog(playerid, D_HELP_BACK, DIALOG_STYLE_MSGBOX, ""I"Аренда транспорта", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 26:
                {
                    ShowPlayerDialog(playerid, D_HELP_BACK, DIALOG_STYLE_MSGBOX, ""I"Аренда транспорта", ""W"\
                    На сервере есть авторынок, на котором можно приобрести и/или продать транспортное средство.\n\n\
                    Найти авторынок: "I"/gps > [1] Общественные места > [7] Авторынок"W"\n\n\
                    С помощью команды "I"/use"W" необходимо арендовать место и настроить параметры продажи транспортного\n\
                    средства. Для аренды доступно 24 места, стоимость аренды составляет "I"0.05 проц."W" от стоимости транспортного\n\
                    средства. Арендовав место, можно отправиться заниматься своими делами, а транспортное средство\n\
                    останется на авторынке до его выгрузки с сервера и/или продажи.", "Далее", "Отмена");
                }
                case 27:
                {
                    ShowPlayerDialog(playerid, D_HELP_BACK, DIALOG_STYLE_MSGBOX, ""I"Аукцион контейнеров", ""W"\
                    Контейнеры делятся на типы, всего их 3: Bronze, Silver и Gold. Награды отличаются в зависимости от\n\
                    типа - базовые в бронзовом варианте, а самые крутые - в золотом.\n\n\
                    Список наград контейнера Bronze типа:\n\n\
                    1. Очки опыта от 10 до 15;\n\
                    2. Деньги от 200.000$ до 400.000$ или Pinecrest Money от 50 до 100 с шансом 50%%;\n\
                    3. Транспортное средство Nope-класса;\n\
                    4. Аксессуары стоимостью от 50.000$ до 250.000$;\n\
                    5. Скины из магазина одежды стоимостью от 25.000$ до 75.000$;\n\
                    6. Игровая рулетка Silver или Gold с шансом 50%%.\n\n\
                    Список наград контейнера Silver типа:\n\n\
                    1. Очки опыта от 20 до 30;\n\
                    2. Деньги от 400.000$ до 800.000$ или Pinecrest Money от 100 до 200 с шансом 50%%;\n\
                    3. Транспортное средство C или B-класса с шансом 50%%;\n\
                    4. Аксессуары стоимостью от 250.000$ до 500.000$;\n\
                    5. Скины из магазина одежды стоимостью от 75.000$ до 125.000$;\n\
                    6. Игровая рулетка Silver или Gold с шансом 50%%.\n\n\
                    Список наград Gold типа:\n\n\
                    1. Очки опыта от 30 до 45;\n\
                    2. Деньги от 800.000$ до 1.600.000$ или Pinecrest Money от 200 до 400 с шансом 50%%;\n\
                    3. Транспортное средство A-класса или Unique-класса с шансом 30%%;\n\
                    4. Аксессуары стоимость от 500.000$ до 2.500.000$;\n\
                    5. Скины из магазина одежды стоимостью от 125.000$ до 645.000$;\n\
                    6. Игровая рулетка Silver или Gold с шансом 50%% или уникальный скин с шансом 30%%.\n\n\
                    Награды из контейнера можно продавать игрокам или выбрасывать в мусорки.\n\n\
                    Найти аукцион контейнеров: "I"/gps > [1] Общественные места > [7] Аукцион контейнеров", "Далее", "Отмена");
                }
                case 28:
                {
                    // Dialog_Show(playerid, Dialog:BLACKJACK_HELP_INFO);
                }
            }
            return 1;
