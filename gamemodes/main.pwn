                        }
                        if(DuelData[duelid][dCommand2][i] != INVALID_PLAYER_ID && GetPlayerState(DuelData[duelid][dCommand2][i]) == PLAYER_STATE_ONFOOT)
                        {
                            p_temp[playerid][dSpectateId] = DuelData[duelid][dCommand2][i];
                            PlayerSpectatePlayer(playerid, DuelData[duelid][dCommand2][i], SPECTATE_MODE_NORMAL);
                        }
                    }
                }
                new comd1, comd2;
