            new step[144];
            if(sscanf(inputtext, "s[144]", step)) return ShowPlayerDialog(playerid, D_EDITOR_STEP, DIALOG_STYLE_INPUT, ""I"Изменить шаг", ""W"Введите желаемый шаг для изменения координат:\n\nПример: "I"0.02", "Далее", "Отмена"), SendError(playerid, "Вы ничего не ввели.");
            if(floatstr(step) < 0.02 || floatstr(step) > 10.0) return ShowPlayerDialog(playerid, D_EDITOR_STEP, DIALOG_STYLE_INPUT, ""I"Изменить шаг", ""W"Введите желаемый шаг для изменения координат:\n\nПример: "I"0.02", "Далее", "Отмена"), SendError(playerid, "Шаг должен быть не менее 0.02 и не более 1.000000.");
            ObjectInfo[playerid][oStep] = floatstr(step);
            if(ObjectInfo[playerid][oStep] < 0.02) ObjectInfo[playerid][oStep] = 0.02;
            if(ObjectInfo[playerid][oStep] > 10.0) ObjectInfo[playerid][oStep] = 10.0;
            SendAccess(playerid, "Вы изменили шаг на %.4f.", ObjectInfo[playerid][oStep]);
            UpdatePlayerEditorInfo(playerid);
            return 1;
        }
        case D_HOOKAH:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0:
                {
                    if(HookahArea[playerid] != -1) return SendError(playerid, "Вы уже установили кальян, теперь можете курить его.");
                    new Float:PlPos[4];
                    GetPlayerPos(playerid, PlPos[0], PlPos[1], PlPos[2]);
                    GetPlayerFacingAngle(playerid, PlPos[3]);
                    SetupHookah(playerid, PlPos[0]+floatcos(PlPos[3]+90, degrees), PlPos[1]+floatsin(PlPos[3]+90, degrees), PlPos[2]-2.8, PlPos[3]+90, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
                }
                case 1:
                {
                    if(HookahArea[playerid] == -1) return SendError(playerid, "Сначала установите свой кальян.");
                    if(IsPlayerInRangeOfPoint(playerid, 5.0, HookahPos[playerid][0], HookahPos[playerid][1], HookahPos[playerid][2])) ClearHookah(playerid, 2);
                    else SendError(playerid, "Вы должны находиться рядом со своим кальяном.");
                }
            }
            return 1;
        }
        case D_TENT:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0:
                {
                    STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;
                    for(new i = 0; i < sizeof(tent_idx); i++)
                    {
                        format(STRING_MIN, sizeof(STRING_MIN), ""I"[%d]"W" %s\t[%s]\n", i + 1, ItemsInfo[tent_idx[i]][iName], GetInventoryAmount(playerid, tent_idx[i]) == 0 ? "{"#cLIGHTRED"}Нет"W"" : "{"#cGREEN"}Есть"W"");
                        strcat(STRING_GLOBAL, STRING_MIN);
                    }
                    ShowPlayerDialog(playerid, D_TENT_LIST, DIALOG_STYLE_TABLIST, ""I"Переносной ларек", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 1:
                {
                    if(TentIDx[playerid] == -1 || TentObjectIDx[playerid] == INVALID_OBJECT_ID) return SendError(playerid, "Сначала установите свой переносной ларек.");
                    if(IsPlayerInRangeOfPoint(playerid, 3.0, TentPos[playerid][0], TentPos[playerid][1], TentPos[playerid][2]))
                        OnPlayerLeaveFromMarket(playerid);
                    else SendError(playerid, "Вы должны находиться рядом со своим переносном ларьком.");
                }
            }
            return 1;
        }
        case D_TENT_LIST:
        {
            if(!response) return callcmd::tent(playerid, "/0");
            if(!GetInventoryAmount(playerid, tent_idx[listitem])) return SendError(playerid, "У Вас нет %s.", ItemsInfo[tent_idx[listitem]][iName]);
            if(p_info[playerid][admin] > 0 && p_info[playerid][admin] < 10) return SendError(playerid, "Вы администратор, действие невозможно.");
            if(p_temp[playerid][market_arend] != -1) return SendError(playerid, "У Вас уже есть арендованная палатка или установленный переносной ларек.");
            if(TentIDx[playerid] != -1) return SendError(playerid, "Вы уже установили переносной ларек.");
            new Float:PlPos[4];
            GetPlayerPos(playerid, PlPos[0], PlPos[1], PlPos[2]);
            GetPlayerFacingAngle(playerid, PlPos[3]);
            SetupTent(playerid, listitem == 0 ? 1340 : 3039, PlPos[0]+floatcos(PlPos[3]+90, degrees), PlPos[1]+floatsin(PlPos[3]+90, degrees), PlPos[2], PlPos[3], GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
            return 1;
        }
        case D_GARDEN:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0: HousePlayerList(playerid, HOUSE_ID_GARDEN);
                case 1: BizzPlayerList(playerid, BIZZ_ID_GARDEN);
            }
            return 1;
        }
        case D_GARDEN_HOUSE:
        {
            if(!response) return 1;
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return SendError(playerid, "У Вас нет дома.");
            if(!IsPlayerInRangeOfPoint(playerid, 25.0, h_info[h][h_enter][0], h_info[h][h_enter][1], h_info[h][h_enter][2])) return SendError(playerid, "Вы слишком далеко от дома.");

            ShowGarden(playerid, listitem);
            return 1;
        }
        case D_GARDEN_BIZ:
        {
            if(!response) return 1;
            new bizz_id = GetPlayerBizzID(playerid);
            if(bizz_id == INVALID_BIZZ_ID) return SendError(playerid, "У Вас нет бизнеса.");
            if(!IsPlayerInRangeOfPoint(playerid, 25.0, b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2])) return SendError(playerid, "Вы слишком далеко от бизнеса.");

            ShowGarden(playerid, listitem+2);
            return 1;
        }
        case D_GARDEN_CREATE:
        {
            new type = GetPVarInt(playerid, "Garden:type")-1;
            DeletePVar(playerid, "Garden:type");
            if(!response) return callcmd::garden(playerid);
            if(type == -1) return SendError(playerid, "Вы не можете создать данный объект. Причина: не определен Garden Type.");
            switch(type)
            {
                case TYPE_GARDEN_HOUSE:
                {
                    new h = GetPlayerHouseID(playerid);
                    if(h == INVALID_HOUSE_ID) return SendError(playerid, "У Вас нет дома.");
                    if(h_info[h][h_garden_items][listitem] == 0) return SendError(playerid, "На складе нет данного объекта.");
                    if(!IsPlayerInRangeOfPoint(playerid, 25.0, h_info[h][h_enter][0], h_info[h][h_enter][1], h_info[h][h_enter][2])) return SendError(playerid, "Вы слишком далеко от дома.");
                    if(GetGardenObject(TYPE_GARDEN_HOUSE, h) >= GetMaxGardenObject(TYPE_GARDEN_HOUSE, h)) return SendError(playerid, "На территории сада нет свободного места под объект.");
                }
                case TYPE_GARDEN_BIZ:
                {
                    new b = GetPlayerBizzID(playerid);
                    if(b == INVALID_BIZZ_ID) return SendError(playerid, "У Вас нет бизнеса.");
                    if(b_info[b][b_garden_items][listitem] == 0) return SendError(playerid, "На складе нет данного объекта.");
                    if(!IsPlayerInRangeOfPoint(playerid, 25.0, b_info[b][b_enter][0], b_info[b][b_enter][1], b_info[b][b_enter][2])) return SendError(playerid, "Вы слишком далеко от бизнеса.");
                    if(GetGardenObject(TYPE_GARDEN_BIZ, b) >= GetMaxGardenObject(TYPE_GARDEN_BIZ, b)) return SendError(playerid, "На территории сада нет свободного места под объект.");
                }
                default: return 1;
            }
            totalgarden++;
            SendInfo(playerid, "С помощью кнопки ALT установите объект в желаемом месте.");
            GardenInfo[totalgarden][gObject][1] = CreateObject(GardenCenter[listitem][GardenCenterObject], 0, 0, 0, 0, 0, 0);
            AttachObjectToPlayer(GardenInfo[totalgarden][gObject][1], playerid, 0, 1, -1.0, 0, 0, 90);
            SetPVarInt(playerid, "LoadGarden", totalgarden + 1);
            SetPVarInt(playerid, "LoadGardenListitem", listitem);
            SetPVarInt(playerid, "GardenObject", GardenCenter[listitem][GardenCenterObject]);
            SetPVarInt(playerid, "LoadGardenType", type + 1);
            return 1;
        }
        case D_GARDEN_DESTROY:
        {
            new type = GetPVarInt(playerid, "Garden:type")-1;
            DeletePVar(playerid, "Garden:type");
            new idx = p_temp[playerid][p_listitem][listitem];
            for(new i; i < 100; i++) p_temp[playerid][p_listitem][i] = -1;
            if(!response) return callcmd::garden(playerid);
            if(type == -1) return SendError(playerid, "Вы не можете удалить данный объект. Причина: не определен Garden Type.");
            switch(type)
            {
                case TYPE_GARDEN_HOUSE:
                {
                    new h = GetPlayerHouseID(playerid);
                    if(h == INVALID_HOUSE_ID) return SendError(playerid, "У Вас нет дома.");
                    if(!IsPlayerInRangeOfPoint(playerid, 25.0, h_info[h][h_enter][0], h_info[h][h_enter][1], h_info[h][h_enter][2])) return SendError(playerid, "Вы слишком далеко от дома.");
                    if(GardenInfo[idx][gHouseIDx] != h) return SendError(playerid, "Вы не можете удалить данный объект. Причина: объект не закреплен за Вашим домом.");
                }
                case TYPE_GARDEN_BIZ:
                {
                    new b = GetPlayerBizzID(playerid);
                    if(b == INVALID_BIZZ_ID) return SendError(playerid, "У Вас нет бизнеса.");
                    if(!IsPlayerInRangeOfPoint(playerid, 25.0, b_info[b][b_enter][0], b_info[b][b_enter][1], b_info[b][b_enter][2])) return SendError(playerid, "Вы слишком далеко от бизнеса.");
                    if(GardenInfo[idx][gBizIDx] != b) return SendError(playerid, "Вы не можете удалить данный объект. Причина: объект не закреплен за Вашим бизнесом.");
                }
            }

            if(GardenInfo[idx][gMySQLIDx] == 0) return SendError(playerid, "Вы не можете удалить данный объект. Причина: не определен MySQL ID.");
            if(GardenInfo[idx][gObject][0] == 0) return SendError(playerid, "Вы не можете удалить данный объект. Причина: не определен ID объекта.");
            if(!IsValidDynamicObject(GardenInfo[idx][gObject][1])) return SendError(playerid, "Вы не можете удалить данный объект. Причина: объект не создано.");

            SendAccess(playerid, "Вы удалили объект \"%s\".", GardenCenter[GardenInfo[idx][gType]][GardenCenterName]);

            DestroyGarden(idx);
            return 1;
        }
        case D_PANEL:
        {
            if(!response) return 1;
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return SendError(playerid, "У Вас нет дома.");
            if(!IsPlayerInRangeOfPoint(playerid, 25.0, h_info[h][h_enter][0], h_info[h][h_enter][1], h_info[h][h_enter][2])) return SendError(playerid, "Вы слишком далеко от дома.");

            ShowHousePanel(playerid, listitem);
            return 1;
        }
        case D_PANEL_DESTROY:
        {
            if(!response)
            {
                for(new i; i < 100; i++) p_temp[playerid][p_listitem][i] = -1;
                callcmd::panel(playerid, "/0");
                return 1;
            }
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return SendError(playerid, "У Вас нет дома.");
            if(!IsPlayerInRangeOfPoint(playerid, 25.0, h_info[h][h_enter][0], h_info[h][h_enter][1], h_info[h][h_enter][2])) return SendError(playerid, "Вы слишком далеко от дома.");

            new idx = p_temp[playerid][p_listitem][listitem];
            for(new i; i < 100; i++) p_temp[playerid][p_listitem][i] = -1;

            if(PanelHouseInfo[idx][PanelHouseMySQLIDx] == 0) return SendError(playerid, "Вы не можете удалить данную панель. Причина: не определен MySQL ID.");
            if(!IsValidDynamicObject(PanelHouseInfo[idx][PanelHouseObject])) return SendError(playerid, "Вы не можете удалить данную панель. Причина: объект не создано.");
            if(PanelHouseInfo[idx][PanelHouseIDx] != h) return SendError(playerid, "Вы не можете удалить данную панель. Причина: объект не закреплен за Вашим домом.");

            SendAccess(playerid, "Вы удалили панель.");

            DestroyPanel(idx);
            return 1;
        }
        case D_PANEL_CONTROL:
        {
            if(!response)
            {
                for(new i; i < 100; i++) p_temp[playerid][p_listitem][i] = -1;
                callcmd::panel(playerid, "/0");
                DeletePVar(playerid, "PANEL:idx");
                return 1;
            }
            if(listitem > 99) return SendError(playerid, "Что-то пошло не так, попробуйте заново или обновите версию клиента.");
            new idx = p_temp[playerid][p_listitem][listitem];
            for(new i; i < 100; i++) p_temp[playerid][p_listitem][i] = -1;
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
            [#] Название\tПараметр\n\
            "I"[1]"W" Заказать ремонт\t%s\n\
            "I"[2]"W" Забрать деньги\t%d$\n\
            "I"[3]"W" Оплатить налог\t%d$", PanelHouseInfo[idx][PanelHouseBreaking] == 0 ? "{"#cGREEN"}Исправна"W"" : "{"#cLIGHTRED"}Требуется ремонт"W"", PanelHouseInfo[idx][PanelHouseMoney], PanelHouseInfo[idx][PanelHouseTax]);
            ShowPlayerDialog(playerid, D_PANEL_CONTROL_MENU, DIALOG_STYLE_TABLIST_HEADERS, ""I"Управление панелью", STRING_GLOBAL, "Далее", "Отмена");
            SetPVarInt(playerid, "PANEL:idx", idx);
            return 1;
        }
        case D_PANEL_CONTROL_MENU:
        {
            if(!response) return ShowHousePanel(playerid, PANEL_TYPE_CONTROL);
            new idx = GetPVarInt(playerid, "PANEL:idx");
            switch(listitem)
            {
                case 0:
                {
                    if(PanelHouseInfo[idx][PanelHouseBreaking] == 0) return SendError(playerid, "Данная солнечная панель не нуждается в ремонте.");
                    if(PanelHouseInfo[idx][PanelHouseRepair] == 1) return SendError(playerid, "Вы уже оформили заказ на ремонт этой солнечной панели.");
                    if(PanelHouseInfo[idx][PanelHouseTax] != 0) return SendError(playerid, "Данная солнечная панель обладает налогом, оплатите его и после закажите ремонт.");

                    SendAccess(playerid, "Вы оформили заказ на ремонт солнечной панели.");
                    SendInfo(playerid, "Ремонт солнечной панели осуществляется ремонтниками солнечных панелей.");

                    PanelHouseInfo[idx][PanelHouseRepair] = 1;
                    MysqlUpdatePanelInt(PanelHouseInfo[idx][PanelHouseMySQLIDx], "repair", PanelHouseInfo[idx][PanelHouseRepair]);
                }
                case 1:
                {
                    if(PanelHouseInfo[idx][PanelHouseTax] != 0) return SendError(playerid, "Данная солнечная панель обладает налогом, оплатите его и после снимите деньги.");
                    new temp_money = PanelHouseInfo[idx][PanelHouseMoney];
                    if(temp_money <= 0) return SendError(playerid, "Данная панель ещё не принесла денег, либо Вы их уже забрали.");

                    SendAccess(playerid, "Вы сняли %d$ с панели.", temp_money);
                    //OnServerInfoForMoney[40] += temp_money;

                    SetPlayerMoney(playerid, temp_money, true, "снял деньги с панели");

                    PanelHouseInfo[idx][PanelHouseMoney] = 0;
                    MysqlUpdatePanelInt(PanelHouseInfo[idx][PanelHouseMySQLIDx], "money", PanelHouseInfo[idx][PanelHouseMoney]);
                }
                case 2:
                {
                    new temp_tax = PanelHouseInfo[idx][PanelHouseTax];
                    if(temp_tax <= 0) return SendError(playerid, "Данная панель ещё не обладает налогом.");
                    if(p_info[playerid][cash] < temp_tax) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

                    SendAccess(playerid, "Вы оплатили налог на панель в размере %d$.", temp_tax);
                    //OnServerInfoForMoney[40] += temp_tax;

                    SetPlayerMoney(playerid, -temp_tax, true, "оплатил налог на панель");

                    PanelHouseInfo[idx][PanelHouseTax] = 0;
                    MysqlUpdatePanelInt(PanelHouseInfo[idx][PanelHouseMySQLIDx], "tax", PanelHouseInfo[idx][PanelHouseTax]);
                }
            }
            return 1;
        }
        case D_PANEL_LIST:
        {
            if(!response) return 1;
            new idx = p_temp[playerid][p_listitem][listitem];
            for(new i; i < 100; i++) p_temp[playerid][p_listitem][i] = -1;

            if(idx < 0) return SendError(playerid, "Что-то пошло не так, попробуйте заново или обновите версию клиента.");

            if(PanelHouseInfo[idx][PanelHouseBreaking] == 0) return SendError(playerid, "Данная соолнечная панель не нуждается в ремонте."), ShowHousePanel(playerid, PANEL_TYPE_LIST);
            if(PanelHouseInfo[idx][PanelHouseRepair] == 0) return SendError(playerid, "Владелец данной солнечной панели не оформлял заказ на её ремонт."), ShowHousePanel(playerid, PANEL_TYPE_LIST);
            if(PanelHouseInfo[idx][PanelHouseRepairPlayerID] != INVALID_PLAYER_ID) return SendError(playerid, "Данный заказ уже выполняется."), ShowHousePanel(playerid, PANEL_TYPE_LIST);

            new Float:distance = GetPlayerDistanceFromPoint(playerid, PanelHouseInfo[idx][PanelHousePos][0], PanelHouseInfo[idx][PanelHousePos][1], PanelHouseInfo[idx][PanelHousePos][2]);
            if(AntiCheatWarningTime[playerid][0] > timestamp) return SendError(playerid, "Вы не можете брать заказы так часто, подождите."), ShowHousePanel(playerid, PANEL_TYPE_LIST);

            new time = floatround(distance) / 500 * 30;
            AntiCheatWarningTime[playerid][0] = timestamp + time;
            AntiCheatWarningTime[playerid][1] = time;

            PanelHouseInfo[idx][PanelHouseRepairPlayerID] = playerid;

            SendMes(playerid, COLOR_BLUE, "Вы начали выполнение задания по ремонту солнечной панели #%d.", idx);
            SendMes(playerid, COLOR_LIME, "Приобетите инструменты в магазине солнечных панелей, если ещё не сделали это.");
            SendMes(playerid, COLOR_SEA_WAVE, "Отправляйтесь на место, отмеченное на GPS навигаторе и отремонтируйте солнечную панель.");
            SetPlayerGPS(playerid, PanelHouseInfo[idx][PanelHousePos][0], PanelHouseInfo[idx][PanelHousePos][1], PanelHouseInfo[idx][PanelHousePos][2], 5.0);

            p_temp[playerid][PanelIDx] = idx;

            new salary = 0;

            if(distance < 500.0) salary = 1249;
            else if(distance > 500.0 && distance < 1000.0) salary = 2004;
            else if(distance > 1000.0 && distance < 1500.0) salary = 2753;
            else if(distance > 1500.0 && distance < 2000.0) salary = 3510;
            else if(distance > 2000.0 && distance < 2500.0) salary = 4260;
            else if(distance > 2500.0 && distance < 3000.0) salary = 5017;
            else if(distance > 3000.0 && distance < 3500.0) salary = 5768;
            else if(distance > 3500.0) salary = 6526;

            p_temp[playerid][PanelSalary] = salary;

            new vehicleid = GetPlayerVehicleID(playerid);
            p_temp[playerid][PanelObject][0] = CreateDynamicObject(1697, 0, 0, 0, 0, 0, 0);
            AttachDynamicObjectToVehicle(p_temp[playerid][PanelObject][0], vehicleid, 0.000, 0.552, 1.310, 0.000, 0.000, 180.000);
            p_temp[playerid][PanelObject][1] = CreateDynamicObject(1697, 0, 0, 0, 0, 0, 0);
            AttachDynamicObjectToVehicle(p_temp[playerid][PanelObject][1], vehicleid, 0.000, -3.591, 1.310, 0.000, 0.000, -180.000);
            return 1;
        }
        case D_PHONE_CONTACTS_ADD:
        {
            if(response)
            {
                if(strlen(inputtext) < 4) return ShowPlayerDialog(playerid, D_PHONE_CONTACTS_ADD, DIALOG_STYLE_INPUT, ""I"Добавить контакт",""W"Введите номер телефона:","Далее","Отмена");
                new id = -1;
                new number = strval(inputtext);
                foreach(new i: Player)
                {
                    if(!p_info[i][loggedIn]) continue;
                    if(number == p_info[i][phone_number]) {
                        id=i;
                        break;
                    }
                }
                if(id == -1) return ShowPlayerDialog(playerid, D_PHONE_CONTACTS_ADD, DIALOG_STYLE_INPUT, ""I"Добавить контакт", ""W"Введите номер телефона:","Далее","Отмена");

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT COUNT(*) FROM `phone_contacts` WHERE `NickPlayer` = '%s' AND `NickTarget` = '%s'",
                get_name(playerid), get_name(id));
                mysql_tquery(con_bd, STRING_GLOBAL, "MysqlAddContact", "dd", playerid, id);
            }
            return 1;
        }
        case D_PHONE_MESSAGES:
        {
            if(response)
            {
                format(p_temp[playerid][Phone_NickTarget], MAX_PLAYER_NAME, "%s", Phone_NickName[playerid][listitem]);

                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `phone_messages` WHERE (`NickPlayer` = '%e' AND `NickTarget` = '%e') OR (`NickTarget` = '%e' AND `NickPlayer` = '%e') ORDER BY `Time` DESC LIMIT 0, 20",
                get_name(playerid), p_temp[playerid][Phone_NickTarget], get_name(playerid), p_temp[playerid][Phone_NickTarget]);
                mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayerMessage", "d", playerid);

                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `phone_messages` SET `Read` = 0 WHERE `NickTarget` = '%e' AND NickPlayer = '%e'",
                get_name(playerid), p_temp[playerid][Phone_NickTarget]);
                mysql_tquery(con_bd, STRING_GLOBAL);
            }
            return 1;
        }
        case D_PHONE_MESSAGE:
        {
            if(!response) return 1;
            if(p_temp[playerid][anti_flood] > timestamp) return SendError(playerid, "Отправлять сообщения можно раз в 5 секунд.");
            if(strlen(inputtext)> 0)
            {
                if(strlen(inputtext) > 30) return SendError(playerid, "Длина сообщения не может быть более 30 символов.");
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `BlackList` FROM `phone_contacts` WHERE `NickTarget` = '%s' AND `NickPlayer` = '%s' LIMIT 0, 20",
                get_name(playerid), p_temp[playerid][Phone_NickTarget]);
                mysql_tquery(con_bd, STRING_GLOBAL, "MysqlCheckSMS", "ds", playerid, inputtext);
                return 1;
            }
            p_temp[playerid][anti_flood] = timestamp+5;

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL,sizeof(STRING_GLOBAL), "UPDATE `phone_messages` SET `Read` = 0 WHERE `NickTarget` = '%e' AND NickPlayer = '%e'",
            get_name(playerid),p_temp[playerid][Phone_NickTarget]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `phone_messages` WHERE (`NickPlayer` = '%e' AND `NickTarget` = '%e') OR (`NickTarget` = '%e' AND `NickPlayer` = '%e') ORDER BY `Time` DESC LIMIT 0, 20",
            get_name(playerid), p_temp[playerid][Phone_NickTarget], get_name(playerid), p_temp[playerid][Phone_NickTarget]);
            mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayerMessage", "d", playerid);
            return 1;
        }
        case D_PHONE_CONTACTS:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0: return ShowPlayerDialog(playerid, D_PHONE_CONTACTS_ADD, DIALOG_STYLE_INPUT, ""I"Добавить контакт", ""W"Введите номер телефона:","Далее","Отмена");
                case 1: {
                    ShowPlayerDialog(playerid, D_PHONE_CALL, DIALOG_STYLE_INPUT, ""I"Позвонить", ""W"\
                    Введите номер гос. службы:\n\n\
                    Полиция - "I"10"W"\n\
                    Скорая помощь - "I"11"W"\n\
                    Такси - "I"12"W"\n\
                    Автомеханик - "I"13"W"\n\
                    Радиоцентр [LS] - "I"14"W"\n\
                    Радиоцентр [SF] - "I"15"W"\n\
                    Радиоцентр [LV] - "I"16"W"\n\
                    Мобильный банк - "I"17"W"\n\
                    Баланс телефона - "I"18", "Далее", "Отмена");
                }
                default:
                {
                    new black_list;
                    format(p_temp[playerid][Phone_NickTarget], MAX_PLAYER_NAME, "%s", Phone_NickName[playerid][listitem-2]);

                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `BlackList` FROM `phone_contacts` WHERE `NickPlayer` = '%s' AND `NickTarget` = '%s'",
                    get_name(playerid), p_temp[playerid][Phone_NickTarget]);
                    new Cache:result = mysql_query(con_bd, STRING_GLOBAL, true);
                    cache_get_value_name_int(0, "BlackList", black_list);
                    cache_delete(result);

                    f(STRING_GLOBAL, ""I"[1]"W" Открыть переписку\n"I"[2]"W" Позвонить\n"I"[3]"W" Пополнить счет\n"I"[4]"W" Попросить перезвонить\n\
                        "I"[5]"W" %s\n"I"[6]"W" Удалить из контактов", (black_list == 0)?("Добавить в черный список"):("Удалить из черного списка"));
                    ShowPlayerDialog(playerid, D_PHONE_CONTACTS_MENU, DIALOG_STYLE_LIST, ""I"Выбор действия", STRING_GLOBAL,"Принять","Отмена");
                }
            }
            return 1;
        }
        case D_PHONE_CONTACTS_MENU:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0://показываем список сообщений.
                {
                    new id;
                    sscanf(p_temp[playerid][Phone_NickTarget], "i", id);
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `phone_messages` WHERE (`NickPlayer` = '%s' AND `NickTarget` = '%s') OR (`NickTarget` = '%s' AND `NickPlayer` = '%s') ORDER BY `time` DESC LIMIT 0, 20",
                    get_name(playerid), p_temp[playerid][Phone_NickTarget], get_name(playerid), p_temp[playerid][Phone_NickTarget]);
                    mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayerMessage", "d", playerid);
                }
                case 1:
                {
                    new  targetid;
                    sscanf(p_temp[playerid][Phone_NickTarget], "i", targetid);
                    if(p_temp[playerid][calling] != INVALID_PLAYER_ID) return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Ошибка", ""W"Вы уже кому-то звоните","Закрыть","");
                    if(p_info[playerid][phone_balance] < 15) return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Ошибка", ""W"У Вас на балансе недостаточно средств для того чтобы вести разговор!\nПополнить баланс телефона можно у любого банкомата штата или\nвы можете выслать *130* своему другу с просьбой перезвонить!","Закрыть","");
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `BlackList` FROM `phone_contacts` WHERE `NickTarget` = '%s' AND `NickPlayer` = '%s' LIMIT 0, 20",
                    get_name(playerid),  get_name(targetid));
                    mysql_tquery(con_bd, STRING_GLOBAL, "MysqlCheckCall", "d", playerid);
                }
                case 2:
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL,sizeof(STRING_GLOBAL),""W"Введите сумму которую хотите пополнить на мобильный счет %s:\n\n{"#cLIGHTRED"}Обратите внимание: Деньги спишутся с Вашего мобильного телефона.",p_temp[playerid][Phone_NickTarget]);
                    ShowPlayerDialog(playerid, D_PHONE_BALANCE_GIVE, DIALOG_STYLE_INPUT, ""I"Пополнить баланс",STRING_GLOBAL,"Принять","Отмена");
                }
                case 3:
                {
                    new id;
                    sscanf(p_temp[playerid][Phone_NickTarget], "i", id);
                    if(!IsPlayerConnected(id)) return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Ошибка", ""W"Игрок которому вы хотите выслать *130* ,оффлайн!","Закрыть","");
                    if(p_temp[id][offphone] == true) return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Ошибка", ""W"Ваш абонент вне зоны действия сети!","Закрыть","");
                    if(p_info[playerid][phone_number] < 1) return false;
                    SendInfo(id, "%s [т. %d] (Этот абонент просит Вам перезвонить ему)", get_name(playerid), p_info[playerid][phone_number]);
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL,sizeof(STRING_GLOBAL), ""W"Вы успешно отправили сообщение о просьбе перезвонить игроку: "I"%s"W" на номер: %d", get_name(id),p_info[id][phone_number]);
                    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Сообщение отправлено",STRING_GLOBAL,"Принять","");
                }
                case 4:
                {
                    STRING_GLOBAL[0] = EOS;
                    new bl;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `BlackList` FROM `phone_contacts` WHERE `NickPlayer` = '%s' AND `NickTarget` = '%s'",
                    get_name(playerid), p_temp[playerid][Phone_NickTarget]);
                    new Cache:result = mysql_query(con_bd, STRING_GLOBAL, true);
                    cache_get_value_index_int(0,0,bl);
                    cache_delete(result);

                    mysql_format(con_bd, STRING_GLOBAL,sizeof(STRING_GLOBAL), "UPDATE `phone_contacts` SET `BlackList` = %d WHERE `NickPlayer` = '%e' AND `NickTarget` = '%e'",
                    !bl, get_name(playerid),p_temp[playerid][Phone_NickTarget]);
                    mysql_tquery(con_bd, STRING_GLOBAL, "MysqlChencheGroup", "d", playerid);
                }
                case 5:
                {
                    new id;
                    sscanf(p_temp[playerid][Phone_NickTarget], "i", id);

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL,sizeof(STRING_GLOBAL), "DELETE FROM `phone_contacts` WHERE `NickPlayer` = '%s' AND `NickTarget` = '%s'",
                    get_name(playerid), p_temp[playerid][Phone_NickTarget]);
                    mysql_tquery(con_bd, STRING_GLOBAL);

                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL,sizeof(STRING_GLOBAL),""W"Вы успешно удалили из контактов игрока "I"%s",p_temp[playerid][Phone_NickTarget]);
                    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Удаление контакта",STRING_GLOBAL,"Принять","");

                    if(IsPlayerConnected(id)) SendInfo(id, "%s удалил Вас из контактов.", get_name(playerid));
                }
            }
            return 1;
        }
        case D_PHONE_BALANCE_GIVE:
        {
            if(!response) return 1;

            new value;
            if(sscanf(inputtext, "i", value)) {
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL,sizeof(STRING_GLOBAL),""W"Введите сумму которую хотите пополнить на мобильный счет %s:\n\n{"#cLIGHTRED"}Обратите внимание: Деньги спишутся с Вашего мобильного телефона.",p_temp[playerid][Phone_NickTarget]);
                ShowPlayerDialog(playerid, D_PHONE_BALANCE_GIVE, DIALOG_STYLE_INPUT, ""I"Пополнить баланс",STRING_GLOBAL,"Принять","Отмена");
                return 1;
            }

            if(!(1 <= value <= p_info[playerid][phone_balance])) {
                SendError(playerid, "Кол-во денежных средств должно быть не менее 1.");
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL,sizeof(STRING_GLOBAL),""W"Введите сумму которую хотите пополнить на мобильный счет %s:\n\n{"#cLIGHTRED"}Обратите внимание: Деньги спишутся с Вашего мобильно телефона.",p_temp[playerid][Phone_NickTarget]);
                ShowPlayerDialog(playerid, D_PHONE_BALANCE_GIVE, DIALOG_STYLE_INPUT, ""I"Пополнить баланс",STRING_GLOBAL,"Принять","Отмена");
                return 1;
            }

            new id = GetPlayerID(p_temp[playerid][Phone_NickTarget]);
            if(id == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не найден.");

            new tax = GetTaxCount(playerid, value, TAX_PHONE_BALANCE_GIVE);

            p_info[playerid][phone_balance] -= value;
            p_info[id][phone_balance] += value - tax;

            SendAccess(playerid, "Вы пополнили %s баланс телефона на %d$. Налог: %d$.", get_name(id), value, tax);
            SendInfo(id, "%s пополнил Вам баланс телефона на %d$. Налог: %d$.", get_name(playerid), value, tax);

            SetFractionWarehouse(MAYOR_LS, fwMoney, tax);
            return 1;
        }
        case D_PHONE:
        {
            if(!response) return 1;
            if(!p_info[playerid][phone_number]) return SendError(playerid, "У Вас нет номера телефона.");
            switch(listitem)
            {
                case 0:
                {
                    if(p_temp[playerid][offphone] == true) return SendError(playerid, "У Вас выключен телефон, включите его.");

                    ShowPlayerDialog(playerid, D_PHONE_CALL, DIALOG_STYLE_INPUT, ""I"Позвонить", ""W"\
                    Введите номер гос. службы:\n\n\
                    Полиция - "I"10"W"\n\
                    Скорая помощь - "I"11"W"\n\
                    Такси - "I"12"W"\n\
                    Автомеханик - "I"13"W"\n\
                    Радиоцентр [LS] - "I"14"W"\n\
                    Радиоцентр [SF] - "I"15"W"\n\
                    Радиоцентр [LV] - "I"16"W"\n\
                    Мобильный банк - "I"17"W"\n\
                    Баланс телефона - "I"18", "Далее", "Отмена");
                }
                case 1:
                {
                    if(p_temp[playerid][offphone] == true) return SendError(playerid, "У Вас выключен телефон, включите его.");

                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT t.`NickPlayer`, t.`NickTarget`, t.`Text`, t.`Read`, t.`Time` FROM `phone_messages` AS t JOIN (SELECT `NickPlayer`, `Text`, max(`Time`) as `mtime` FROM `phone_messages` WHERE `NickTarget` = '%s' GROUP BY `NickPlayer`, `NickTarget`, `Text`, `Read`, `Time`) as t1 ON t.NickPlayer= t1.NickPlayer AND t.`Time` = t1.`mtime` ORDER BY t.`Time` DESC LIMIT 20",
                    get_name(playerid));
                    mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayerMessages", "d", playerid);
                }
                case 2:
                {
                    if(p_temp[playerid][offphone] == true) return SendError(playerid, "У Вас выключен телефон, включите его.");

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `phone_contacts`.`NickTarget`, `phone_contacts`.`MissedCalls`, `accounts`.`phone_number`, `accounts`.`online`, `phone_contacts`.`BlackList` FROM `phone_contacts`, `accounts` WHERE `phone_contacts`.`NickPlayer` = '%s' AND `accounts`.`name` = `phone_contacts`.`NickTarget` ORDER BY `phone_contacts`.`BlackList` DESC LIMIT 20",
                    get_name(playerid));
                    mysql_tquery(con_bd, STRING_GLOBAL, "MysqlShowContacts", "d", playerid);
                }
                case 3: callcmd::togphone(playerid, "/0");
            }
            return 1;
        }
        case D_CAR_MENU:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0: callcmd::en(playerid);
                case 1: callcmd::lights(playerid, "/0");
                case 2: callcmd::lock(playerid, "/0");
            }
            return 1;
        }
        case D_OFFER_PLAYER:
        {
            new buyer_id = p_temp[playerid][offer_info][0],
                price = p_temp[playerid][offer_info][1];

            if(!IsPlayerConnected(buyer_id))
                return SendError(playerid, "Игрок не найден.");
            if(!response)
                return SendAccess(playerid, "Вы отказались от предложения.");
            if(buyer_id == INVALID_PLAYER_ID)
                return SendError(playerid, "Предложений нет.");
            if(!IsPlayerStream(5.0, playerid, buyer_id) || pSpectateId[buyer_id] != INVALID_PLAYER_ID)
                return SendError(playerid, "Игрок слишком далеко от Вас.");
            if(p_info[buyer_id][cash] < price)
                return SendError(playerid, "У игрока нет столько денег.");

            new offer_idx;
            for(new i; i < MAX_OFFER_PLAYER; i++)
            {
                offer_idx = GetPlayerOfferID(buyer_id, i);
                if(offer_idx == playerid)
                    return SendError(playerid, "Вы уже отправляли предложение этому игроку.");
            }
            if(GetFreeSlotOffer(buyer_id) == ALL_BUSY_SLOT_OFFER)
                return SendError(playerid, "У игрока нет возможности принять предложение, повторите позже.");

            p_temp[playerid][offer_info][0] = INVALID_PLAYER_ID;
            p_temp[playerid][offer_info][1] = 0;
            p_temp[playerid][offer_info][3] = 0;
            p_temp[playerid][offer_info][4] = 0;
            switch(p_temp[playerid][offer_info][2])
            {
                case OFFER_ID_INVITE:
                {
                    SendAccess(playerid, "Вы предложили %s [%d] вступить во фракцию \"%s\".", get_name(buyer_id), buyer_id, GetFractionName(p_info[playerid][member]));
                    SendInfo(buyer_id, "%s [%d] предложил Вам вступить во фракцию \"%s\".", get_name(playerid), playerid, GetFractionName(p_info[playerid][member]));

                    SetFreeSlotOffer(buyer_id, playerid, OFFER_ID_INVITE);
                }
                case OFFER_ID_INVITE_FAMILY:
                {
                    new family_idx = GetPlayerFamilyID(playerid);
                    if(family_idx == -1) return SendError(playerid, "Вы не состоите в семьи.");

                    SendAccess(playerid, "Вы предложили %s[%d] вступить в семью \"%s\".", get_name(buyer_id), buyer_id, FamilyData[family_idx][fName]);
                    SendInfo(buyer_id, "%s[%d] предложил Вам вступить в семью \"%s\".", get_name(playerid), playerid, FamilyData[family_idx][fName]);

                    SetFreeSlotOffer(buyer_id, playerid, OFFER_ID_INVITE_FAMILY);
                }
                case OFFER_ID_SHOW_LICENSE:
                {
                    SendAccess(playerid, "Вы предложили %s [%d] посмотреть лицензии.", get_name(buyer_id), buyer_id);
                    SendInfo(buyer_id, "%s [%d] предложил Вам посмотреть лицензии.", get_name(playerid), playerid);

                    SetFreeSlotOffer(buyer_id, playerid, OFFER_ID_SHOW_LICENSE);
                }
                case OFFER_ID_SHOW_CERTIFICATE:
                {
                    SendAccess(playerid, "Вы предложили %s [%d] посмотреть удостоверение.", get_name(buyer_id), buyer_id);
                    SendInfo(buyer_id, "%s [%d] предложил Вам посмотреть удостоверение.", get_name(playerid), playerid);

                    SetFreeSlotOffer(buyer_id, playerid, OFFER_ID_SHOW_CERTIFICATE);
                }
                case OFFER_ID_SHOW_MED_CARD:
                {
                    SendAccess(playerid, "Вы предложили %s [%d] посмотреть мед. карту.", get_name(buyer_id), buyer_id);
                    SendInfo(buyer_id, "%s [%d] предложил Вам посмотреть мед. карту.", get_name(playerid), playerid);

                    SetFreeSlotOffer(buyer_id, playerid, OFFER_ID_SHOW_MED_CARD);
                }
                case OFFER_ID_SHOW_WBOOK:
                {
                    SendAccess(playerid, "Вы предложили %s [%d] посмотреть трудовую книгу.", get_name(buyer_id), buyer_id);
                    SendInfo(buyer_id, "%s [%d] предложил Вам посмотреть трудовую книгу.", get_name(playerid), playerid);

                    SetFreeSlotOffer(buyer_id, playerid, OFFER_ID_SHOW_WBOOK);
                }
                case OFFER_ID_SHOW_PASS:
                {
                    SendAccess(playerid, "Вы предложили %s [%d] посмотреть паспорт.", get_name(buyer_id), buyer_id);
                    SendInfo(buyer_id, "%s [%d] предложил Вам посмотреть паспорт.", get_name(playerid), playerid);

                    SetFreeSlotOffer(buyer_id, playerid, OFFER_ID_SHOW_PASS);
                }
                case OFFER_ID_START_SPARRING:
                {
                    SendAccess(playerid, "Вы предложили %s [%d] начать бой, ставка %d$.", get_name(buyer_id), buyer_id, SparringData[p_temp[playerid][SparringID]][sBet]);
                    SendInfo(buyer_id, "%s [%d] начать бой.", get_name(playerid), playerid);

                    SetFreeSlotOffer(buyer_id, playerid, OFFER_ID_START_SPARRING);
                }
                case OFFER_ID_SPARRING:
                {
                    SendAccess(playerid, "Вы предложили %s [%d] провести бой.", get_name(buyer_id), buyer_id);
                    SendInfo(buyer_id, "%s [%d] провести бой.", get_name(playerid), playerid);

                    SetFreeSlotOffer(buyer_id, playerid, OFFER_ID_SPARRING);
                }
                case OFFER_ID_SELL_SIM_PHONE:
                {
                    SendAccess(playerid, "Вы предложили %s [%d] купить Ваш номер телефона \"%d\" за %d$.", get_name(buyer_id), buyer_id, p_info[playerid][phone_number], price);
                    SendInfo(buyer_id, "%s [%d] предложил Вам купить его номер телефона \"%d\" за %d$.", get_name(playerid), playerid, p_info[playerid][phone_number], price);

                    SetFreeSlotOffer(buyer_id, playerid, OFFER_ID_SELL_SIM_PHONE, price);
                }
                case OFFER_ID_CHANGE_SIM_PHONE:
                {
                    SendAccess(playerid, "Вы предложили %s [%d] обменять Ваш номер телефона \"%d\" на \"%d\" с его доплатой %d$.", get_name(buyer_id), buyer_id, p_info[playerid][phone_number], p_info[buyer_id][phone_number], price);
                    SendInfo(buyer_id, "%s [%d] предложил Вам обменять Ваш номер телефона \"%d\" на \"%d\" с Вашей доплатой %d$.", get_name(playerid), playerid, p_info[buyer_id][phone_number], p_info[playerid][phone_number], price);

                    SetFreeSlotOffer(buyer_id, playerid, OFFER_ID_CHANGE_SIM_PHONE, price);
                }
                case OFFER_ID_HI:
                {
                    SendAccess(playerid, "Вы предложили %s [%d] пожать руку.", get_name(buyer_id), buyer_id);
                    SendInfo(buyer_id, "%s [%d] пожать руку.", get_name(playerid), playerid);

                    SetFreeSlotOffer(buyer_id, playerid, OFFER_ID_HI);
                }
                case OFFER_ID_CAR_PASS:
                {
                    SendAccess(playerid, "Вы предложили %s [%d] показать тех. паспорт.", get_name(buyer_id), buyer_id);
                    SendInfo(buyer_id, "%s [%d] показать тех. паспорт.", get_name(playerid), playerid);

                    SetFreeSlotOffer(buyer_id, playerid, OFFER_ID_CAR_PASS);
                }
                case OFFER_ID_TRADE:
                {
                    SendAccess(playerid, "Вы предложили %s [%d] провести трейд.", get_name(buyer_id), buyer_id);
                    SendInfo(buyer_id, "%s [%d] предложил Вам провести трейд.", get_name(playerid), playerid);

                    SetFreeSlotOffer(buyer_id, playerid, OFFER_ID_TRADE);
                }
                case OFFER_ID_SELL_VEH_NUMBER:
                {
                    new player_vehicle = p_temp[playerid][p_listitem][40];
                    if(!IsPlayerOwnerVehicle(playerid, player_vehicle))
                        return SendError(playerid, "Произошла не известная ошибка:  PV-1708-6 | Сообщите на форум!");
                    SendAccess(playerid, "Вы предложили %s [%d] купить Ваш номер транспортного средства %s за %d$.", get_name(buyer_id), buyer_id, veh_info[player_vehicle][v_number], price);
                    SendInfo(buyer_id, "%s [%d] предложил Вам купить номер транспортного средства %s за %d$.", get_name(playerid), playerid, veh_info[player_vehicle][v_number], price);

                    SetFreeSlotOffer(buyer_id, playerid, OFFER_ID_SELL_VEH_NUMBER, price);
                }
                case OFFER_ID_CHANGE_VEH_NUMBER:
                {
                    new player_vehicle = p_temp[playerid][p_listitem][40],
                        offer_vehicle = p_temp[playerid][p_listitem][41];
                    if(!IsPlayerOwnerVehicle(buyer_id, offer_vehicle))
                        return SendError(playerid, "Произошла не известная ошибка:  PV-1708-4 | Сообщите на форум!");
                    if(!IsPlayerOwnerVehicle(playerid, player_vehicle))
                        return SendError(playerid, "Произошла не известная ошибка:  PV-1708-5 | Сообщите на форум!");

                    SendAccess(playerid, "Вы предложили %s [%d] обменять номер транспортного средства %s на %s с его доплатой %d$.", get_name(buyer_id), buyer_id, veh_info[player_vehicle][v_number], veh_info[offer_vehicle][v_number], price);
