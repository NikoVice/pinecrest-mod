            if(btc < 1) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_CONTROL, idx), SendError(playerid, "Количество BTC должно быть не менее 1.");
            new max_btc = MAX_PLAYER_BITCOIN - p_info[playerid][bitcoin];
            if(btc > max_btc) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_CONTROL, idx), SendError(playerid, "Количество Bitcoin не может быть более %d.", max_btc);
            VideoCardsInfo[idx][vcBitcoin] -= float(btc);
            p_info[playerid][bitcoin] += btc;
