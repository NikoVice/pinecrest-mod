            new slot_id = GetPVarInt(playerid, "INSTALL_PREMIUM_ACC:idx")-1;
            DeletePVar(playerid, "INSTALL_PREMIUM_ACC:idx");
            if(slot_id == -1) return 1;
            if(InventoryPlayer[playerid][slot_id][inv_acc_premium] == 1) return SendError(playerid, "Данный аксессуар итак является Premium.");
            new item_id = InventoryPlayer[playerid][slot_id][inv_item_id];

