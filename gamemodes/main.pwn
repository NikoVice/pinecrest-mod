            new vehicleid = GetPlayerVehicleID(playerid);
            if(!IsPlayerOwnerVehicle(playerid, vehicleid) && veh_info[vehicleid][v_family_id] == -1) return Service_Error(playerid, "������������ �������� �������������� ����� �� ������ � �������� ������������ ��������.");
            switch(listitem)
            {
                case 0:
                {
                    new till = Service_GetTill(playerid);
                    if(till == -1) return Service_Error(playerid, "�� ������ ID �����������, �������������� �������� ����������� ��������.");
                    p_temp[playerid][paint_veh_go] = 0;
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"��������� ��������� �����: $%d.\n\n�������� ���� ����� �������:\n\n������: 1, 0\n\n", 5000 * till);
                    for(new i; i < 127; i++)
                    {
                        if(i%20 == 0) strcat(STRING_GLOBAL,"\n");
                        format(STRING_GLOBAL, sizeof STRING_GLOBAL, "%s{%06x} %d ", STRING_GLOBAL, VehicleColoursTableRGBA[i] >>> 8, i);
                    }
                    ShowPlayerDialog(playerid,D_CHANGE_VEHICLE_COLOR,DIALOG_STYLE_INPUT, ""I"�������� ���� ������������� ��������",STRING_GLOBAL,"�����", "������");
                }
                case 1:
                {
                    if(!IsPlayerOwnerVehicle(playerid, vehicleid) && veh_info[vehicleid][v_family_id] == -1) return Service_Error(playerid, "������������ �������� �������������� ����� �� ������ � �������� ������������ ��������.");
                    if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_CAR) return Service_Error(playerid, "������������ �������� �������������� ����� ������ �� �����������.");
                    ShowDialogTuneDefault(playerid);
                }
                case 2: ShowDialogTuneOther(playerid);
                case 3:
                {
                    STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;
                    for(new i, j = sizeof(info_details); i < j; i++)
                    {
                        format(STRING_MIN, sizeof(STRING_MIN), "%s\n", info_details[i]);
                        strcat(STRING_GLOBAL, STRING_MIN);
