CMD:ftazer(playerid, params[])
{
    if(p_info[playerid][member] != FBI_TEAM) return 1;
    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "�����������: /ftazer [���]");
    if(!(1 <= params[0] <= 3)) return SendError(playerid, "��� ������ ���� �� ����� 1 � �� ����� 3.");

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "�� ����� ����� ������� �������.");
        MeAction(playerid, "���� ������� ������� � �����, ����� ���� � ������ ������� �� �����");
        DoAction(playerid, "������� ������� ������������� ���������� �� �����, ������� ����.");
    }

    if(params[0] == 1)
    {
        foreach(new targetid : Player)
        {
            if(IsPlayerStream(15.0, playerid, targetid) && targetid != playerid)
            {
                if(p_info[targetid][p_afkTime] > 2) continue;
                SendInfo(targetid, "�� ���������� �� 10 ������.");
                SetPlayerSpecialAction(targetid, SPECIAL_ACTION_HANDSUP);
                Fix_TogglePlayerControllable(targetid, 0);
                p_temp[targetid][UnFreezeFix] = 1;
                p_temp[targetid][UnFreezeTimerFix] = timestamp + 15;
            }
        }
    }
    else if(params[0] == 2)
    {
        foreach(new targetid : Player)
        {
            if(IsPlayerStream(15.0, playerid, targetid) && targetid != playerid && GetFactionType(targetid) == FACTION_TYPE_GOS)
            {
                if(p_info[targetid][p_afkTime] > 2) continue;
                SendInfo(targetid, "�� ���������� �� 10 ������.");
                SetPlayerSpecialAction(targetid, SPECIAL_ACTION_HANDSUP);
                Fix_TogglePlayerControllable(targetid, 0);
                p_temp[targetid][UnFreezeFix] = 1;
                p_temp[targetid][UnFreezeTimerFix] = timestamp + 15;
            }
        }
    }
    else if(params[0] == 3)
    {
        foreach(new targetid : Player)
        {
            if(IsPlayerStream(15.0, playerid, targetid) && targetid != playerid && p_info[playerid][member] == NONE_FRACTION)
            {
                if(p_info[targetid][p_afkTime] > 2) continue;
                SendInfo(targetid, "�� ���������� �� 10 ������.");
                SetPlayerSpecialAction(targetid, SPECIAL_ACTION_HANDSUP);
                Fix_TogglePlayerControllable(targetid, 0);
                p_temp[targetid][UnFreezeFix] = 1;
                p_temp[targetid][UnFreezeTimerFix] = timestamp + 15;
            }
        }
    }
    return 1;
}
CMD:repaircar(playerid, params[])
{
    if(RegisterDerby[playerid] == 2) return SendError(playerid, "�� ����������� ��������� ������������ ���. ��������.");
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return SendError(playerid, "�� ������ ���������� �� �����.");
    new vehicleid = GetPlayerNearestVehicleID(playerid, 7.0);
    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "����� � ���� ��� ������������� ��������.");
    new Float:x, Float:y, Float:z;
    GetCoordBonnetVehicle(vehicleid, x, y, z);
    if(!IsPlayerInRangeOfPoint(playerid, 7.5, x, y, z)) return SendError(playerid, "�� ������ �� ������.");
    if(!GivePlayerInventory(playerid, 631, -1)) return SendError(playerid, "� ��� ��� ���. ���������.");

    GameTextForPlayer(playerid, "~r~repair vehicle 5 seconds", 1000, 1);
    p_temp[playerid][repair_timer] = 5;
    ApplyAnimation(playerid, "INT_SHOP", "shop_cashier", 4.1, 1, 0, 0, 1, 1);
    p_temp[playerid][ClearAnimFix] = 1;
    p_temp[playerid][ClearAnimTimerFix] = timestamp + 5;
    SetPVarInt(playerid, #VEHICLE_ID_REPAIR, vehicleid);
    return 1;
}
alias:repaircar("rc","rcar");

CMD:pour(playerid, params[])
{
    new vehicleid = GetPlayerNearestVehicleID(playerid, 5.0);
    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "����� � ���� ��� ������������� ��������.");
    if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_VELO_MOPED) return 1;
    if(veh_info[vehicleid][v_fuel] >= GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_FUEL)) return SendError(playerid, "� ��� ������ ���.");
    if(!(GivePlayerInventory(playerid, 630, -1))) return SendError(playerid, "� ��� ��� ��������.");

    veh_info[vehicleid][v_fuel] += 5.0;
    if(veh_info[vehicleid][v_fuel] > GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_FUEL)) veh_info[vehicleid][v_fuel] = GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_FUEL);
    GameTextForPlayer(playerid, "~b~+ 5 ~w~Fuel", 1000, 1);
    SendAccess(playerid, "�� ��������������� ���������.");
    return 1;
}

CMD:carmenu(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || vehicleid == 0)
        return SendError(playerid, "�� �� �� ����� ������������� ��������.");
    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "\
        "I"[1]"W" ��������� (%s)\n\
        "I"[2]"W" ���� (%s)\n\
        "I"[3]"W" ����� (%s)",
        veh_info[vehicleid][v_engine] == 1 ? ("{33CC66}�������"W"") : ("{"#cLIGHTRED"}��������"W""),
        veh_info[vehicleid][v_light] == 1 ? ("{33CC66}��������"W"") : ("{"#cLIGHTRED"}���������"W""),
        veh_info[vehicleid][v_lock] == 1 ? ("{"#cLIGHTRED"}�������"W"") : ("{33CC66}�������"W""));
    ShowPlayerDialog(playerid, D_CAR_MENU, DIALOG_STYLE_LIST, ""I"���� ������������� ��������", STRING_GLOBAL, "�����", "������");
    return 1;
}

CMD:cars(playerid, params[])
{
    ShowPlayerDialog(playerid, D_CARS_LIST, DIALOG_STYLE_LIST, ""I"���������", ""I"[1]"W" �����\n"I"[2]"W" ����\n"I"[3]"W" ����������\n"I"[4]"W" ������\n"I"[5]"W" ���������", "�������", "������");
    return 1;
}
alias:cars("vehicles", "vehs");

forward list_player_vehicle(playerid, veh_type, type_select);
public list_player_vehicle(playerid, veh_type, type_select)
{
    if(!(0 <= veh_type <= 5) || !(0 <= type_select <= 1)) return SendError(playerid, "��� ������: 1008 (���������� � �������������)");

    new rows = cache_num_rows();

    new status_used[36],
        modelid,
        fmt_str[144],
        twinturbo,
        premium,
        bonus, count_veh, sell_block;
    static const twinturbo_status[][] = {"", "[{ffff00}TT"W"]"};
    static const premium_status[][] = {"", "[{ffff00}PREMIUM"W"]"};
    STRING_GLOBAL[0] = EOS;
    if(rows)
    {
        for(new idx; idx < rows; idx++)
        {
            if(count_veh >= 30) break;

            p_temp[playerid][p_listitem_cars][count_veh] = -1;
            cache_get_value_name_int(idx, "v_model", modelid);
            if(GetVehicleData(modelid, E_VD_TYPE) != veh_type) continue;
            cache_get_value_name_int(idx, "v_mysql_id", p_temp[playerid][p_listitem_cars][count_veh]);
            
            if(type_select)
                p_temp[playerid][p_listitem][count_veh] = modelid;

            cache_get_value_name_int(idx, "v_twinturbo", twinturbo);
            cache_get_value_name_int(idx, "v_premium", premium);
            cache_get_value_name_int(idx, "v_bonus", bonus);
            cache_get_value_name_int(idx, "v_sell_block", sell_block);

            if(GetSlotVehicleMarket(p_temp[playerid][p_listitem_cars][count_veh]) != -1) format(status_used, sizeof status_used, ""A"[�� ���������]");
            else format(status_used, sizeof status_used, "%s", GetPlayerVehicleMySQLID(playerid, p_temp[playerid][p_listitem_cars][count_veh]) != -1 ? "[{ffcc00}������������"W"]" : "[{669900}�� ������������"W"]");
            f(STRING_GLOBAL, "%s"I"[%d]"W" %s %s %s \t%s%s%s\n", STRING_GLOBAL, count_veh+1, GetVehicleName(INVALID_VEHICLE_ID, modelid), twinturbo_status[twinturbo], premium_status[premium], status_used, bonus == 0 ? "" : "[{ffff00}BONUS"W"]", sell_block == 0 ? "" : "[{"#cLIGHTRED"}���������� �/�, ������� �� 0$"W"]");
            count_veh++;
        }
    }
    if(count_veh < GetPlayerLimiteCars(playerid, veh_type))
    {
        for(new idx = count_veh; idx < GetPlayerLimiteCars(playerid, veh_type); idx++)
        {
            p_temp[playerid][p_listitem_cars][idx] = -1;
            f(STRING_GLOBAL, "%s"I"[%d]"W" ���� ���������\n", STRING_GLOBAL, idx+1);
        }
    }
    p_temp[playerid][loadcar_max] = count_veh;
    p_temp[playerid][p_listitem_int] = veh_type;
    if(!type_select)
    {
        if(count_veh <= 30) f(STRING_GLOBAL, "%s"I"[%d]"W" ������ �������������� ����\t ", STRING_GLOBAL, GetPlayerLimiteCars(playerid, veh_type)+1);
        f(fmt_str, ""I"%s | �����: %d/%d", vehicle_type_name[veh_type], count_veh, GetPlayerLimiteCars(playerid, veh_type));
        ShowPlayerDialog(playerid, D_LOAD_CAR, DIALOG_STYLE_TABLIST, fmt_str, STRING_GLOBAL, "�����", "������");
    }
    else 
    {
        f(fmt_str, ""I"%s", vehicle_type_name[veh_type]);
        ShowPlayerDialog(playerid, D_FAMILY_TRANSFER_VEHICLE_MENU, DIALOG_STYLE_TABLIST, fmt_str, STRING_GLOBAL, "�����", "������");
    }
    return 1;
}

CMD:unrent(playerid, params[])
{
    new vehicleid = p_temp[playerid][rented_veh];
    if(!IsPlayerRentedVehicle(playerid, vehicleid)) 
        return SendError(playerid, "�� �� ��������� �/�.");
    if(GetPlayerVehicleID(playerid) == vehicleid)
    {
        new Float:POS[3];
        GetVehiclePos(vehicleid, POS[0], POS[1], POS[2]);
        SetPlayerPos(playerid, POS[0]+1, POS[1]+1, POS[2]+0.3);
    }
    if(veh_info[vehicleid][v_npoType] == NPO_JOB) EndPlayerJob(playerid);
    else
    {
        if(veh_info[vehicleid][v_temp_job])
        {
            veh_info[vehicleid][v_temp_job] = 0;
            new scdplayerid = veh_info[vehicleid][v_used_key_ID];
            if(scdplayerid != INVALID_PLAYER_ID) EndPlayerJob(scdplayerid);
        }
        veh_info[vehicleid][v_rented_ID] = INVALID_MYSQL_ID;
        veh_info[vehicleid][v_used_key_ID] = INVALID_PLAYER_ID;
        p_temp[playerid][rented_veh] = INVALID_VEHICLE_ID;

        if(veh_info[vehicleid][v_npoType] != NPO_PLAYERCAR) 
            DestroyVehicleVEx(vehicleid);
    }
    SendMes(playerid, COLOR_BLUE, "�� ���������� �� ������ ������������� ��������.");
    return 1;
}

CMD:fixcar(playerid, params[])
{
    VehiclePlayerList(playerid, VEHICLE_ID_DELIVERY);
    return 1;
}

CMD:findcar(playerid, params[])
{
    VehiclePlayerList(playerid, VEHICLE_ID_FIND);
    return 1;
}

VehiclePlayer_Delivery(playerid, vehicleid)
{
    if(AntiDMZone(playerid)) return SendError(playerid, "�� �� ������ ��������� ������������ �������� � \"������� ����\".");
    if(GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0) return SendError(playerid, "�� �� ������ ��������� ������������ �������� � ���������.");
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return SendError(playerid, "�� ������ ���������� �� � ������������ ��������.");
    new vehtype = GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE);
    if(vehtype == VEHICLE_STATE_TRAIN)
        return 1;
    if(SRV_ID && veh_info[vehicleid][v_insurance] == 0 &&
        veh_info[vehicleid][v_bonus] == 0 &&
        (vehtype == VEHICLE_STATE_VELO_MOPED || 
        vehtype == VEHICLE_STATE_MOTO || 
        vehtype == VEHICLE_STATE_CAR))
        return SendError(playerid, "�� ������������ �������� ������ ���� ���������.");
    new price_veh_spawn = 5000;
    if(veh_info[vehicleid][v_premium]) price_veh_spawn = price_veh_spawn / 2;
    if(p_info[playerid][cash] < price_veh_spawn) return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");
    if(IsVehicleOccupied(vehicleid)) return SendError(playerid, "������������ �������� ������������.");
    if(GetSlotVehicleMarket(veh_info[vehicleid][v_mysql_id]) != -1)
        return SendError(playerid, "�������������� � ������������ �������� ����������, ��� ��������� �� ���������.");
    new Float:POS[3];
    GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
    if(POS[2] > 0.3 && vehtype == VEHICLE_STATE_BOAT)
        return SendError(playerid, "�� �� ���������� � ����.");
    if(POS[2] < 0.3 && vehtype != VEHICLE_STATE_BOAT)
        return SendError(playerid, "�� ���������� � ����.");

    SetPlayerMoney(playerid, -price_veh_spawn, true, "������� fixcar <%s>(%d)[%d]", GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id]);

    if(vehtype == VEHICLE_STATE_BOAT)
    {
        SetVehiclePos(vehicleid, POS[0], POS[1], POS[2]+0.3);
        PutPlayerInVehicle(playerid, vehicleid, 0);
    }
    else
        SetVehiclePos(vehicleid, POS[0]+1+random(2), POS[1]+1+random(2), POS[2]+0.3);

    LinkVehicleToInterior(vehicleid, 0);
    SetVehicleVirtualWorld(vehicleid, 0);
    SendAccess(playerid, "�� ��������� ������������ ��������.");
    return 1;
}

VehiclePlayer_Find(playerid, vehicleid)
{
    if(IsGPSVisable(playerid) != -1) return 1;

    new Float:POS[3];
    new id_parking = GetVehicleVirtualWorld(vehicleid)-5000;
    if(id_parking >= 0 && id_parking < MAX_PARKING)
    {
        POS[0] = ParkData[id_parking][p_enter][0];
        POS[1] = ParkData[id_parking][p_enter][1];
        POS[2] = ParkData[id_parking][p_enter][2];
        SendInfo(playerid, "���� �/� ��������� �� �������� #%d.", id_parking);
    }
    else GetVehiclePos(vehicleid, POS[0], POS[1], POS[2]);

    new Float:distance = GetPlayerDistanceFromPoint(playerid, POS[0], POS[1], POS[2]);
    if(p_temp[playerid][TaxiGPS] == true)
    {
        if(GetPlayerTaxiDriver(playerid) == INVALID_PLAYER_ID) return SendError(playerid, "� ����� ��� ��������.");

        new driverid = GetPlayerTaxiDriver(playerid);
        p_temp[playerid][TaxiGPS] = false;
        SetPlayerGPS(driverid, POS[0], POS[1], POS[2],5.0);

        SendInfo(driverid, "%s ��������� ����� ����������. ����������: %.0f ������.", get_name(playerid), distance);
        return 1;
    }
    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);

    SetPlayerGPS(playerid, POS[0], POS[1], POS[2],5.0);
    SendInfo(playerid, "\"���������\" ������� �� GPS ����������. ����������: %.0f ������.", distance);
    return 1;
}

CMD:ipremium(playerid, params[])
{
    if(GetInventoryAmount(playerid, 681) <= 0) return SendError(playerid, "� ��� ��� Premium �� �/�.");
    if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "�� ������ ���������� � ������������ ��������.");
    new vehicleid = GetPlayerNearestVehicleID(playerid, 5.0);
    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "����� � ���� ��� ������������� ��������.");
    if(!IsPlayerOwnerVehicle(playerid, vehicleid) && veh_info[vehicleid][v_family_id] == -1) return SendError(playerid, "�� ������ ���������� � ����� ������ ������������ ��������.");
    if(veh_info[vehicleid][v_bonus] != 0) return SendError(playerid, "�� �������� ������������ �������� ������ ���������� Premium.");
    if(veh_info[vehicleid][v_premium] == 1) return SendError(playerid, "������ ������������ �������� ���� �������� Premium.");
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"�� ������������� ������ ���������� \"Premium\" �� \"%s\"?", GetVehicleName(vehicleid));
    ShowPlayerDialog(playerid, D_INSTALL_PREMIUM_CAR, DIALOG_STYLE_MSGBOX, ""I"Premium �� ������������ ��������", STRING_GLOBAL, "��", "���");
    return 1;
}

CMD:park(playerid, params[])
{
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "�� ������ ���������� �� ����� ������������� ��������.");
    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID ||
        !IsPlayerOwnerVehicle(playerid, vehicleid)) return SendError(playerid, "�� ������� ������ �� ������ ������������� ��������.");
    if(AntiDMZone(playerid)) return SendError(playerid, "�� �� ������ ������������ ������������ �������� � \"������� ����\".");

    new Float:POS[3];
    GetVehiclePos(vehicleid, POS[0], POS[1], POS[2]);

    if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_BOAT && POS[2] < 0.2) return SendError(playerid, "�� �� ������ ������������ ������������ �������� � ����.");
    if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_PLANE)
    {
        new aero_check;
        if((IsPlayerInRangeOfPoint(playerid, 150.0, 1499.3673,1526.0774,10.9874) ||
            IsPlayerInRangeOfPoint(playerid, 100.0, -1299.7699,-155.4822,14.148) ||
            IsPlayerInRangeOfPoint(playerid, 100.0, 1944.9186,-2324.0544,13.5469)) && POS[2] < 16.9874) aero_check++;

        new h;
        for(new i; i < p_info[playerid][house_slots]; i++)
        {
            h = GetPlayerHouseID(playerid, i);
            if(h != INVALID_HOUSE_ID && IsPlayerInRangeOfPoint(playerid, 25.0, h_info[h][h_enter][0],h_info[h][h_enter][1], h_info[h][h_enter][2])) aero_check++;
        }
        if(aero_check == 0) return SendError(playerid, "������������ ������������ �������� ����� ������ �� ���������� ���������� � ����� ����.");
    }
    if(gang(playerid) && GetVehicleModelEx(vehicleid) == 508 && GetPlayerStatusCapture(playerid) == CAPTURE_ID_GANG)
    {
        new i = -1;
        if(Capture_Info[0][gFaction][0] == p_info[playerid][member] || Capture_Info[0][gFaction][1] == p_info[playerid][member])
            i = 0;
        else if(Capture_Info[1][gFaction][0] == p_info[playerid][member] || Capture_Info[1][gFaction][1] == p_info[playerid][member])
            i = 1;
        
        if(i != -1 && Capture_Info[i][gGangZoneID] != INVALID_CRIMINAL_ZONE_ID)
        {
            new gangzone = Capture_Info[i][gGangZoneID];
            if(IsPlayerCaptureZone(playerid, GangZone_Info[gangzone][gCoords][0], GangZone_Info[gangzone][gCoords][1], GangZone_Info[gangzone][gCoords][2], GangZone_Info[gangzone][gCoords][3]))
                return SendError(playerid, "������ ��������� �/� � ���� ������� ���������.");
        }
    }
    if(GetPlayerVirtualWorld(playerid) > 0 && GetPlayerVirtualWorld(playerid) < 5000)
    {
        new h = GetHouseGameID(playerid);
        if(p_info[playerid][key_h_rent] == h || h_info[h][h_user_id] == p_info[playerid][ID])
        {
            if(GetPlayerVirtualWorld(playerid) != h+50)
                return SendError(playerid, "������������ ������������ �������� ����� ������ � ����� ������.");
            if(p_info[playerid][key_h_rent] == h && p_info[playerid][h_r_settings][R_GARAGE] == 0)
                return SendError(playerid, "� ��� ��� ���������� ����� ������������ ���� ������������ �������� � ������.");
            if(GetVehicleModelEx(vehicleid) == 508)
                return SendError(playerid, "�� �� ������ ������������ ������� � ������.");
        }
    }
    new Float:zange;
    GetVehicleZAngle(vehicleid, zange);
    veh_info[vehicleid][v_pos][0] = POS[0];
    veh_info[vehicleid][v_pos][1] = POS[1];
    veh_info[vehicleid][v_pos][2] = POS[2];
    veh_info[vehicleid][v_pos][3] = zange;

    veh_info[vehicleid][v_int] = GetPlayerInterior(playerid);
    veh_info[vehicleid][v_virt] = GetPlayerVirtualWorld(playerid);
    SaveVehicle(vehicleid);
    return SendAccess(playerid, "�� ������������ ������������ ��������.");
}

CMD:buycan(playerid, params[])
{
    new bizz_id = GetPVarInt(playerid, "bID");
    if(b_info[bizz_id][_tip] != B_FUEL ||
        !IsPlayerInRangeOfPoint(playerid, 7.5, b_info[bizz_id][b_enter][0],b_info[bizz_id][b_enter][1],b_info[bizz_id][b_enter][2]))
        return SendError(playerid, "�� ������� ������ �� ��������.");
    p_temp[playerid][p_shop_biz_item] = 630;
    ShowPlayerDialog(playerid, D_BUY_SHOP_ITEM, DIALOG_STYLE_INPUT, ""I"��������",  ""W"������� ����������, ������� ������ ����������:", "������", "������");
    return 1;
}

CMD:fuel(playerid, params[])
{
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return 1;

    new
        vehicleid = GetPlayerVehicleID(playerid);

    if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_VELO_MOPED)
        return 1;

    if(sscanf(params, "i", params[0]))
        return SendInfo(playerid, "�����������: /fuel [���-��]");

    if(params[0] < 5 || params[0] > 200)
        return SendError(playerid, "���������� ������ ������ ���� �� ����� 5 � �� ����� 200.");

    new max_litres = GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_FUEL);

    for(new idx; idx < totalbizz; idx++)
    {
        if(b_info[idx][b_mysql_id] == INVALID_MYSQL_ID) continue;
        if(IsPlayerInRangeOfPoint(playerid,5.0,b_info[idx][b_enter][0],b_info[idx][b_enter][1],b_info[idx][b_enter][2]) )
        {
            if(/*b_info[idx][b_user_id] != INVALID_MYSQL_ID && */b_info[idx][_tip] == 4)
            {
                if(veh_info[vehicleid][v_fuel] < 0.0) veh_info[vehicleid][v_fuel] = 0.0;

                if(veh_info[vehicleid][v_fuel] + params[0] > max_litres)
                    return SendError(playerid, "�� �� ������ ��������� ������������ �������� ����� %d ������.", floatround(max_litres-veh_info[vehicleid][v_fuel], floatround_ceil));

                new price = BIZZ_FILL_PRICE * params[0] * b_info[idx][_till];

                new list_percent[3] = {90, 80, 70}, vip_idx = p_info[playerid][p_vip];
                if(vip_idx) price = ((price / 100) * list_percent[vip_idx - 1]);

                if(price < 50 || price > 50000)
                    return SendError(playerid, "��������� ������ (Fuel - #1). �������� � ���. ������.");

                if(p_info[playerid][cash] < price)
                    return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");

                SendAccess(playerid, "�� ��������� ������������ �������� �� %d ������ �� %d$.", params[0], price);

                if(b_info[idx][_prod] >= params[0])
                {
                    b_info[idx][_prod] -= params[0];
                    b_info[idx][_bank] += (price / 100) * 90;
                    AddMafiaBank(idx, price/10);

                    biz_finka[idx] += (price / 100) * 90;
                    UpdateIntForFinanceBiz(idx, (price / 100) * 90);
                }

                OnServerInfoForMoney[10] += price;
                SetPlayerMoney(playerid, -price, true, "�������� ����������");
                veh_info[vehicleid][v_fuel] += float(params[0]);
                if(veh_info[vehicleid][v_mysql_id] != INVALID_MYSQL_ID) SaveVehicle(vehicleid);
                return 1;
            }
        }
    }
    SendError(playerid, "�� ������� ������ �� ��������.");
    return 1;
}

////////////////////////////////////////////////////////////////////////////////
CMD:bizlist(playerid, params[])
{
    if(!mafia(playerid) && !biker(playerid)) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    new count_business,
        fracid = -1;
    switch(p_info[playerid][member])
    {
        case MAFIA_RM: fracid = BANK_RM;
        case MAFIA_LCN: fracid = BANK_LCN;
        case MAFIA_YAKUDZA: fracid = BANK_YAKUZA;
        case BIKER: fracid = BANK_BIKER;
        case MAFIA_IRAN: fracid = BANK_IRAN;
    }
    STRING_GLOBAL[0] = EOS;
    STRING_GLOBAL = "�. �������� + ����� ������� �� ��������� ���\n\n";
    for(new i; i< totalbizz; i++)
    {
        if(b_info[i][b_mysql_id] == INVALID_MYSQL_ID) continue;
        if(b_info[i][b_mafia] != p_info[playerid][member]) continue;
        if(fracid == -1) continue;
        if(count_business == 50) break;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%i. %s [ID: %d] + {77FF1B}%d$"W"\n",STRING_GLOBAL, count_business, b_info[i][_name], i, gBankMafia[fracid][i]);
        count_business++;
    }
    if(count_business < 50) ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"������� ����� � ��������", STRING_GLOBAL, "�����", "");
    else if(!count_business) ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"������� ����� � ��������", "�������� �� �������", "��", "");
    else ShowPlayerDialog(playerid, D_BIZ_LIST, DIALOG_STYLE_MSGBOX, ""I"������� ����� � ��������", STRING_GLOBAL, "�����", "�������");
    return 1;
}

CMD:cput(playerid, params[])
{
    if(!IsPlayerFractionPolice(playerid) && !mafia(playerid) && !gang(playerid) && !biker(playerid)) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(mafia(playerid) && p_info[playerid][rang] < 5) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(gang(playerid) && p_info[playerid][rang] < 7) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(biker(playerid) && p_info[playerid][rang] < 7) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "�����������: /cput [id ������]");
    if(params[0] == INVALID_PLAYER_ID || params[0] == playerid) return SendError(playerid, "����� �� ������.");
    if(IsPlayerInAnyVehicle(params[0])) return SendError(playerid, "����� ��� ��������� � ������������ ��������.");
    if(gang(playerid) && !p_temp[params[0]][tTied]) return SendError(playerid, "����� ������ ���� ������.");
    if(mafia(playerid) && !p_temp[params[0]][tTied]) return SendError(playerid, "����� ������ ���� ������.");
    if(biker(playerid) && !p_temp[params[0]][tTied]) return SendError(playerid, "����� ������ ���� ������.");
    if(IsPlayerFractionPolice(playerid) && GetPVarInt(params[0],"PlayerCuffed") == 0) return SendError(playerid, "����� ������ ���� � ����������.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "����� ������� ������ �� ���.");
    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID)
    {
        vehicleid = INVALID_VEHICLE_ID;
        new Float:POS[3];
        foreach(new i: Vehicle)
        {
            GetVehiclePos(i, POS[0], POS[1], POS[2]);
            if(IsPlayerInRangeOfPoint(playerid,3.0, POS[0], POS[1], POS[2]))
            {
                vehicleid = i;
                break;
            }
        }
        if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "�� ������� ������ �� ������������� ��������.");
    }
    if(vehicleid != INVALID_VEHICLE_ID)
    {
        new bool:seat[4], passanger_id = -1;
        for(new i = 0; i < 8; i++)
        {
            if(veh_info[vehicleid][v_passenger][i] != INVALID_PLAYER_ID) 
            {
                if(GetPlayerVehicleSeat(veh_info[vehicleid][v_passenger][i]) == 1) seat[0] = true;
                else if(GetPlayerVehicleSeat(veh_info[vehicleid][v_passenger][i]) == 2) seat[1] = true;
                else if(GetPlayerVehicleSeat(veh_info[vehicleid][v_passenger][i]) == 3) seat[2] = true;
                else if(4 <= GetPlayerVehicleSeat(veh_info[vehicleid][v_passenger][i]) <= 8) seat[3] = true;
            }
        }
        for(new i; i < 4; i++)
        {
            if(!seat[i])
            {
                passanger_id = i+1;
                break;
            }
        }
        if(!(1 <= passanger_id <= 4)) return SendError(playerid, "� ������������ �������� ��� ����.");
        PutPlayerInVehicle(params[0], vehicleid, passanger_id);
        Fix_TogglePlayerControllable(params[0], 0);

        if(p_info[playerid][p_settings][ROLEPLAY] == 1)
        {
            DoAction(playerid, "����� ������ �������.");
            MeAction(playerid, "������ ����� ���������� ��������� ���������� ������, ����� ���� ������ �����");
        }
        return true;
    }
    return 1;
}

CMD:tie(playerid, params[])
{
    if(!mafia(playerid) && !biker(playerid)) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(p_info[playerid][rang] < 6) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(GetInventoryAmount(playerid, 636) <= 0) return SendError(playerid, "� ��� ��� �������.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "�����������: /tie [id ������]");
    if(AntiDMZone(playerid)) return SendError(playerid, "�� �� ������ ������� \"������� ����\".");
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "����� �� ������.");
    if(p_temp[playerid][tTied])  return SendError(playerid, "�� �������.");
    if(p_temp[params[0]][tTied]) return SendError(playerid, "����� ��� ������.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "����� ������� ������ �� ���.");
    if(params[0] == playerid) return SendError(playerid, "�� ����� ���� ID.");
    if(p_info[params[0]][p_afkTime] > 2) return SendError(playerid, "������ ����� � AFK.");

    new string[128];
    format(string, sizeof(string), "%s ������(-�) %s", get_name(playerid), p_info[params[0]][name]);
    SendStreamMessage(30.0, playerid, string, 0xE75480FF);
    Fix_TogglePlayerControllable(params[0], 0);
    p_temp[params[0]][tTied] = true;

    GivePlayerInventory(playerid, 636, -1);

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "������� ����� � �������.");
        MeAction(playerid, "������� ������ ���� � ������, ����� ���� ������� ������� ������ ��");
        MeAction(playerid, "������ ������� ������ �������� �� ������");
    }
    return 1;
}
