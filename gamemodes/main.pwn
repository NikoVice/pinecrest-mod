            return 1;
        }
        case D_MISSION_DAILY_TASK_INFO:
        {
            if(!response) return ShowPlayerMission(playerid, MISSION_TYPE_DAILY_TASK, MissionDialogListitem[playerid][0] == 0 ? 33 : 48);
            return 1;
        }
        case D_MISSION_ACHIEVEMENT_INFO:
        {
            if(!response) return ShowPlayerMission(playerid, MISSION_TYPE_ACHIEVEMENT, MissionDialogListitem[playerid][0] == 0 ? 102 : 117);
            return 1;
        }
        case D_MISSION_DAILY_FRACTION:
        {
            if(!response) return callcmd::mission(playerid, "/0");
            if(p_temp[playerid][p_listitem][listitem] == -1) return SendError(playerid, "Что-то пошло не так, попробуйте заново или обновите версию клиента.");
            ShowPlayerMission(playerid, MISSION_INFO_DAILY_FRACTION, p_temp[playerid][p_listitem][listitem]);
            for(new i; i < 100; i++) p_temp[playerid][p_listitem][i] = -1;
            return 1;
        }
        case D_MISSION_DAILY_FRACTION_INFO:
        {
            if(!response) return ShowPlayerMission(playerid, MISSION_TYPE_DAILY_FRACTION, MissionDialogListitem[playerid][0] == 0 ? 33 : 48);
            return 1;
        }
