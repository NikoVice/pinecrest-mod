                        hx = b_info[bizz_id][b_enter][0] + 1.0 * floatsin(-ha, degrees); //смещение от Х вперед!
                        hy = b_info[bizz_id][b_enter][1] + 1.0 * floatcos(-ha, degrees); //смещение от Y вперед! в сторону куда смотрим(!)
                        hz = b_info[bizz_id][b_enter][2]+0.5;

                        hx2 = hx - 12.0 * floatsin(ha, degrees);
                        hy2 = hy + 6.0 * floatcos(ha, degrees);

                        InterpolateCameraPos(playerid,hx,hy,hz,hx2,hy2,hz+2.2, 3500);
                        InterpolateCameraLookAt(playerid,hx,hy,hz, hx,hy,hz, 3500);

                        SetTimerEx("fixCameraProperty", 3510, 0, "iiifff", 1, playerid, bizz_id, hx2,hy2,hz+2.2);
                    }
                    else
                    {
                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, ""W"\
                        Номер бизнеса: %d\n\
                        Название бизнеса: %s\n\
                        Тип бизнеса: %s\n\
                        Стоимость бизнеса: %d$", bizz_id, b_info[bizz_id][_name], bizz_type_name[b_info[bizz_id][_tip]], b_info[bizz_id][_price]);
                        ShowPlayerDialog(playerid, D_REALTOR_BIZZ_INFO, DIALOG_STYLE_MSGBOX, ""I"Бизнес", STRING_GLOBAL, "GPS", "Отмена");
                    }
                }
                case REALTOR_TYPE_HOUSE_FREE_SOON, REALTOR_TYPE_BIZZ_FREE_SOON, REALTOR_TYPE_TC_FREE_SOON: return callcmd::realtor(playerid, "/0");
            }
            return 1;
        }
        case D_REALTOR_BIZZ_INFO:
        {
            if(GetPlayerVirtualWorld(playerid) == GetPVarInt(playerid, "bID") && GetPlayerVirtualWorld(playerid) != 0)
            {
                Fix_TogglePlayerControllable(playerid, true);
                SetCameraBehindPlayer(playerid);
                SetPlayerInterior(playerid, 10);
                SetPlayerVirtualWorld(playerid, GetPVarInt(playerid, "bID"));
                SetPlayerPos(playerid, -1161.2366, 640.4775, 1052.3817);
            }
            if(!response)
            {
                if(p_info[playerid][Update][3] == 0) callcmd::realtor(playerid, "/0");
                else callcmd::thetablet(playerid, "/0");
                return 1;
            }
            new bizz_id = p_temp[playerid][p_biz_id];
            SetPlayerGPS(playerid, b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2], 4.0);
            SendAccess(playerid, "Бизнес обозначен на GPS навигаторе.");
            p_temp[playerid][p_biz_id] = -1;
            return 1;
        }
        case D_REALTOR_HOUSE_INFO:
        {
            if(GetPlayerVirtualWorld(playerid) == GetPVarInt(playerid, "bID") && GetPlayerVirtualWorld(playerid) != 0)
            {
                Fix_TogglePlayerControllable(playerid, true);
                SetCameraBehindPlayer(playerid);
                SetPlayerInterior(playerid, 10);
                SetPlayerVirtualWorld(playerid, GetPVarInt(playerid, "bID"));
                SetPlayerPos(playerid, -1161.2366, 640.4775, 1052.3817);
            }
            if(!response)
            {
                if(p_info[playerid][Update][3] == 0) callcmd::realtor(playerid, "/0");
                else callcmd::thetablet(playerid, "/0");
                return 1;
            }
            new h_id = p_temp[playerid][p_house_id];
            SetPlayerGPS(playerid, h_info[h_id][h_enter][0], h_info[h_id][h_enter][1], h_info[h_id][h_enter][2], 4.0);
            SendAccess(playerid, "Дом обозначен на GPS навигаторе.");
            p_temp[playerid][p_house_id] = INVALID_HOUSE_ID;
            return 1;
        }
        case D_ADD_NEW_TRANSPORT:
        {
            new v_model_ID = p_temp[playerid][p_listitem_int],
                type_id = p_temp[playerid][p_listitem][0],
                price = p_temp[playerid][p_listitem][1],
                custom_id = -1;
            if(v_model_ID < 400)
                return SendError(playerid, "Произошла не известная ошибка 2802-3 / Сообщите на форум.");
            if(!(400 <= v_model_ID <= 612))
            {
                custom_id = GetSlotVehicleModelSync(v_model_ID);
                if(custom_id == -1) return SendError(playerid, "Данного автомобиля нет в списке Real Cars");
            }
            if(!response)
            {
                if(type_id == 0)
                {
                    SetPlayerMoney(playerid, GetVehicleData(v_model_ID, E_VD_PRICE)/2, true, "продал %s из рулетки", GetVehicleName(INVALID_VEHICLE_ID, v_model_ID));
                    SendAccess(playerid, "Вы продали транспортное средство за %d$.", GetVehicleData(v_model_ID, E_VD_PRICE)/2);
                }
                else if(type_id == 100000)
                {
                    p_info[playerid][flinmoney] += price;
                    MysqlUpdatePlayerInt(playerid, "flinmoney", p_info[playerid][flinmoney]);
                    SendAccess(playerid, "Вы продали транспортное средство %s за %d Pinecrest Money.", GetVehicleName(INVALID_VEHICLE_ID, v_model_ID), price);
                }
                else if(type_id == 4)
                {
                    SendAccess(playerid, "Данное транспортное средство подарочное, оно продано за 0$.");
                }
                else
                {
                    if(custom_id != -1)
                    {
                        p_info[playerid][flinmoney] += customVehModels[custom_id][ModelPrice];
                        MysqlUpdatePlayerInt(playerid, "flinmoney", p_info[playerid][flinmoney]);
                    }
                    else SetPlayerMoney(playerid, GetVehicleData(v_model_ID, E_VD_PRICE) / 2, true, "продал %s из доната", GetVehicleName(INVALID_VEHICLE_ID, v_model_ID));
                    SendAccess(playerid, "Вы продали транспортное средство %s за %d%s.", GetVehicleName(INVALID_VEHICLE_ID, v_model_ID), custom_id != -1 ? customVehModels[custom_id][ModelPrice] : GetVehicleData(v_model_ID, E_VD_PRICE) / 2, custom_id != -1 ? " Pinecrest Money":"$");
                }
            }
            else
            {
                new temp_v_mysql_id = p_temp[playerid][p_listitem_cars][listitem];
                p_temp[playerid][p_listitem_cars][listitem] = -1;

                new vehicle_slot = GetPlayerVehicleMySQLID(playerid, temp_v_mysql_id);
                if(vehicle_slot != -1)
                    DestroyPlayerVehicle(playerid, GetPlayerVehicleIDEx(playerid, vehicle_slot));

                new Float:veh_pos[4];

                switch(GetVehicleData(v_model_ID, E_VD_TYPE))
                {
                    case VEHICLE_STATE_MOTO, VEHICLE_STATE_VELO_MOPED:
                    {
                        veh_pos[0] = 2136.9063, veh_pos[1] = -1146.9723, veh_pos[2] = 24.1492, veh_pos[3] = 360.0;
                    }
                    case VEHICLE_STATE_CAR:
                    {
                        switch(random(3))
                        {
                            case 0: veh_pos[0] = 2148.7544, veh_pos[1] = 1397.9063, veh_pos[2] = 10.5574, veh_pos[3] = 180.0;
                            case 1: veh_pos[0] = 2142.4277, veh_pos[1] = 1397.9630, veh_pos[2] = 10.5574, veh_pos[3] = 180.0;
                            case 2: veh_pos[0] = 2135.9500, veh_pos[1] = 1398.2472, veh_pos[2] = 10.5574, veh_pos[3] = 180.0;
                        }
                    }
                    case VEHICLE_STATE_BOAT:
                    {
                        switch(random(3))
                        {
                            case 0: veh_pos[0] = 132.1968, veh_pos[1] = -1800.3795, veh_pos[2] = -0.0, veh_pos[3] = 138.1145;
                            case 1: veh_pos[0] = 118.8191, veh_pos[1] = -1800.5955, veh_pos[2] = -0.0, veh_pos[3] = 45.4816;
                            case 2: veh_pos[0] = 123.3519, veh_pos[1] = -1793.6954, veh_pos[2] = -0.0, veh_pos[3] = 45.4816;
                        }
                    }
                    case VEHICLE_STATE_PLANE:
                    {
                        veh_pos[0] = 1573.4407, veh_pos[1] = 1542.0071, veh_pos[2] = 10.9790, veh_pos[3] = 40.6912;
                    }
                }

                new premium = 0;
                if(type_id == 2) premium = 1;
                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL),
                    "UPDATE `vehicle` SET `v_model` = %d, `v_premium` = %d, `v_bonus` = 0, `v_sell_block` = 0,\
                    `v_pos_0` = '%f', `v_pos_1` = '%f', `v_pos_2` = '%f', `v_pos_3` = '%f', `v_int` = 0, `v_virt` = 0, \
                    `v_tun_0` = 0, `v_tun_1` = 0, `v_tun_2` = 0, `v_tun_3` = 0, `v_tun_4` = 0, `v_tun_5` = 0,`v_tun_6` = 0, \
                    `v_tun_7` = 0, `v_tun_8` = 0, `v_tun_9` = 0, `v_tun_10` = 0, `v_tun_11` = 0,`v_tun_12` = 0, \
                    `v_attach_data` = '-1|-1|-1|-1|-1|-1|-1|-1', `v_wheel_width` = 0, `v_wheel_size` = '0', \
                    `v_wheel_offset_x_0` = 0, `v_wheel_offset_x_1` = 0, `v_wheel_alignment_0` = 0, `v_wheel_alignment_1` = 0, \
                    `v_lights_color_0` = 0, `v_lights_color_1` = 0, `v_lights_color_2` = 0, \
                    `v_twinturbo` = 0, `v_twinturbo_data` = '0|0|0|0' WHERE `v_mysql_id` = %d",
                v_model_ID, premium, veh_pos[0], veh_pos[1], veh_pos[2], veh_pos[3], temp_v_mysql_id);
                mysql_tquery(con_bd, STRING_GLOBAL);

                SendAccess(playerid, "Ваше транспортное средство заменено.");
                SendInfo(playerid, "Загрузить или выгрузить транспортное средство: /cars");

                Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] заменил автомобиль на <%s>(%d)[%d] из-за нехватки слотов",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                GetVehicleName(INVALID_VEHICLE_ID, v_model_ID), v_model_ID, temp_v_mysql_id);
            }
            p_temp[playerid][p_listitem_int] = -1;
            return 1;
        }
        case D_SET_SPAWN:
        {
            if(!response) return 1;

            if((GetPlayerUseSkinID(playerid) == 252 || p_info[playerid][fskin] == 252) && listitem == 0)
                return SendError(playerid, "Вы не можете изменить место появления на \"Автовокзал\" без одежды.");

            switch(listitem)
            {
                case SPAWN_DEFAULT: SendInfo(playerid, "Ваше новое место появления \"Автовокзал\".");
                case SPAWN_HOUSE:
                {
                    if(GetFreeSlotHouse(playerid) == p_info[playerid][house_slots] && p_info[playerid][key_h_rent] == INVALID_HOUSE_ID)
                        return SendError(playerid, "У Вас нет дома или Вы не подселены в него.");

                    if(p_info[playerid][key_h_rent] != INVALID_HOUSE_ID)
                        SendInfo(playerid, "Ваше новое место появления \"Дом\".");
                    else
                        HousePlayerList(playerid, HOUSE_ID_SPAWN);
                }
                case SPAWN_FRACTION:
                {
                    if(!p_info[playerid][member])
                        return SendError(playerid, "Вы не состоите во фракции.");
                    SendInfo(playerid, "Ваше новое место появления \"Фракция\".");
                }
                case SPAWN_FAMILY:
                {
                    if(p_info[playerid][family_id] == -1 || GetPlayerFamilyID(playerid) == -1)
                        return SendError(playerid, "Вы не состоите в семье.");
                    if(FamilyData[GetPlayerFamilyID(playerid)][fHouseID] == INVALID_HOUSE_ID)
                        return SendError(playerid, "У семьи нет дома.");
                    SendInfo(playerid, "Ваше новое место появления \"семейный дом\".");
                }
                case SPAWN_HOTEL:
                {
                    if(GetPlayerHotelID(playerid, 0) == -1 || GetPlayerHotelID(playerid, 1) == -1)
                        return SendError(playerid, "У Вас нет номера в отеле.");
                    SendInfo(playerid, "Ваше новое место появления \"Отель\".");
                }
                case SPAWN_TREILER:
                {
                    if(!GetPlayerCheckTreiler(p_info[playerid][ID]))
                        return SendError(playerid, "У Вас нет трейлера.");
                    SendInfo(playerid, "Ваше новое место появления \"Трейлер\".");
                }
            }

            p_info[playerid][spawn] = listitem;
            return 1;
        }
        case D_PROMO:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0: ShowPlayerDialog(playerid,D_PROMO_CREATE,DIALOG_STYLE_INPUT, ""I"Создание промокода | Шаг: 1",""W"Вам необходимо придумать промокод\nДлина промокода должна быть от 3 до 12 символов, состоящая из цифр и букв латинского алфавита\n\nВведите промокод в строчку ниже:","Далее","Назад");
                case 1: mysql_tquery(con_bd, "SELECT * FROM `promo` WHERE `activate` = 0 AND `block` = 0", "ShowDPromo", "i", playerid);
                case 2: mysql_tquery(con_bd, "SELECT * FROM `promo` WHERE `activate` = 1", "ShowAPromo", "i", playerid);
                case 3: mysql_tquery(con_bd, "SELECT * FROM `promo` WHERE `block` = 1", "ShowBPromo", "i", playerid);
                case 4: ShowPlayerDialog(playerid,D_PROMO_BLOCK,DIALOG_STYLE_INPUT, ""I"Блокировка промокода",""W"Введите ниже промокод, который хотите заблокировать:","Далее","Назад");
                case 5: ShowPlayerDialog(playerid,D_PROMO_DELETE,DIALOG_STYLE_INPUT, ""I"Удаление промокода",""W"Введите ниже промокод, который хотите удалить:","Далее","Назад");
            }
            return 1;
        }
        case D_PROMO_BLOCK:
