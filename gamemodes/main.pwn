                h_info[totalhouses][h_enter][1] = Pos[1];
                h_info[totalhouses][h_enter][2] = Pos[2];
                h_info[totalhouses][h_enter][3] = Pos[3];
                h_info[totalhouses][h_squar] = params[0];
                h_info[totalhouses][h_value] = params[1];

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `house` (`h_user_id`, `h_int`, `h_value`, `h_owner`,`h_squar`, `h_enterx`, `h_entery`, `h_enterz`, `h_entera`) VALUES ('"#INVALID_MYSQL_ID"', %d, %d, 'The State', %d, '%f', '%f', '%f', '%f')",
                params[2], params[1], params[0], Pos[0], Pos[1], Pos[2], Pos[3]);
                mysql_tquery(con_bd, STRING_GLOBAL, "create_house", "i", totalhouses);

                //if(SRV_ID == 0) WriteLog("zhouse", STRING_GLOBAL);
                f(string,""W"Дом"I" №%d\n"W"Цена:"I" %d$"W"\nГараж: "I"%s",totalhouses,h_info[totalhouses][h_value], h_info[totalhouses][h_squar] > 1 ? "Есть":"Нет");
                h_info[totalhouses][h_text] = CreateDynamic3DTextLabel(string, COLOR_WHITE,h_info[totalhouses][h_enter][0], h_info[totalhouses][h_enter][1], h_info[totalhouses][h_enter][2], 5.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID,streamer_TESTLOL);

                h_info[totalhouses][h_icon] = CreateDynamicMapIcon(h_info[totalhouses][h_enter][0], h_info[totalhouses][h_enter][1], h_info[totalhouses][h_enter][2], 31, -1, 0, -1, -1, 100.0);

                new house_pickup;
                house_pickup = CreateDynamicPickup(1273, 23, h_info[totalhouses][h_enter][0], h_info[totalhouses][h_enter][1], h_info[totalhouses][h_enter][2], -1);
                h_info[totalhouses][h_pickup_enter] = house_pickup;
                UpdatePickupInfo(house_pickup, TYPE_HOUSE, PICKUP_SUBTYPE_HOUSE_ENTER, totalhouses);

                if(h_info[totalhouses][h_squar] > 1)
                {
                    h_info[totalhouses][h_garage_text] = CreateDynamic3DTextLabel(string, COLOR_MAIN,h_info[totalhouses][h_garage_enter][0], h_info[totalhouses][h_garage_enter][1], h_info[totalhouses][h_garage_enter][2],10.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID,streamer_TESTLOL);
                    SendInfo(playerid, "Управление гаражом: /shg");
                }
                SendInfo(playerid, "Установите угол поворота при выходе из дома: /sha");
                SendInfo(playerid, "Добавить ворота: /addhousegate");
                SendInfo(playerid, "Добавить вертолетную площадку и доступ к пирсу : /addhousedops [ТОЛЬКО ДЛЯ PINECREST TOWN!]");

                save_house(totalhouses);
                totalhouses++;
                return 1;
        }
        case D_GARAGE_AREA:
        {
            if(!response) return 1;
            new vehicleid = GetPlayerVehicleID(playerid);
            if(vehicleid == INVALID_VEHICLE_ID || !IsValidVehicle(vehicleid))
                return 1;
            if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
                return 1;

            new h = p_temp[playerid][p_house_id];
            if(h == INVALID_HOUSE_ID) return 1;
            new h_class = h_info[h][h_squar]-2;

            p_temp[playerid][p_house_id] = INVALID_HOUSE_ID;
            p_temp[playerid][p_house_area] =
            p_temp[playerid][p_listitem_int] = -1;

            if(IsPlayerInRangeOfPoint(playerid, 3.0, h_info[h][h_garage_enter][0], h_info[h][h_garage_enter][1],h_info[h][h_garage_enter][2]))
            {
                if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) >= VEHICLE_STATE_BOAT) return 1;
                if(IsKeyHouseDoor(playerid, h) != 1 && h_info[h][h_garage_lock] != 0) return SendError(playerid, "У Вас нет ключей от этих дверей.");
                SetPlayerHouseActive(playerid, h);
                TeleportVehicleToPos(vehicleid, g_info[h_class][g_vX],g_info[h_class][g_vY],g_info[h_class][g_vZ]+0.2, g_info[h_class][g_pR], HOUSE_INT_ID_REPAIR, h+50);
                LoadPlayerCarsGarage(playerid);
                SetCameraBehindPlayer(playerid);
                SendMes(playerid, COLOR_LIME, "Помощь по гаражам: {"#cLYELLOW"}/ghelp");
                return 1;
            }

            if(IsPlayerInRangeOfPoint(playerid, 3.0, g_info[h_class][g_vX],g_info[h_class][g_vY],g_info[h_class][g_vZ]))
            {
                TeleportVehicleToPos(vehicleid, h_info[h][h_garage_enter][0], h_info[h][h_garage_enter][1],h_info[h][h_garage_enter][2]+0.2, h_info[h][h_garage_enter][3], 0,0);
                SetCameraBehindPlayer(playerid);

                LoadUnPlayerCarsGarage(playerid, h);
            }
            return 1;
        }

        case D_GARAGE_DOOR:
        {
            if(!response) {
                p_temp[playerid][p_house_id] = INVALID_HOUSE_ID;
                return 1;
            }
            new h = p_temp[playerid][p_house_id];
            p_temp[playerid][p_house_id] = INVALID_HOUSE_ID;

            new h_class = h_info[h][h_squar]-1;
            new int_id = h_info[h][h_int];

            new player_state = GetPlayerState(playerid);
            if(IsPlayerInRangeOfPoint(playerid, 2.0, g_info[h_class-1][g_pX], g_info[h_class-1][g_pY], g_info[h_class-1][g_pZ])
                && player_state == PLAYER_STATE_ONFOOT)
            {
                switch(listitem) {
                    case 0: {
                        SetPlayerInterior(playerid,0);
                        SetPlayerVirtualWorld(playerid,0);
                        SetPlayerPos(playerid,h_info[h][h_enter][0], h_info[h][h_enter][1], h_info[h][h_enter][2]);
                        SetPlayerFacingAngle(playerid, h_info[h][h_enter][3]);
                        LoadUnPlayerCarsGarage(playerid, h);
                        return 1;
                    }
                    case 1: {
                        if(IsKeyHouseDoor(playerid, h) != 1 && h_info[h][h_lock] != 0) return SendError(playerid, "У Вас нет ключей от этих дверей.");
                        SetPlayerHousePos(playerid, h, h_class, int_id);
                        return 1;
                    }
                    case 2:
                    {
                        if(h_info[h][h_improve][BASEMENT] == 0) return SendError(playerid, "В доме нет подвала, приобрести его можно в улучшениях.");
                        if(IsKeyHouseDoor(playerid, h) != 1 && h_info[h][h_attic_lock] != 0) return SendError(playerid, "У Вас нет ключей от этих дверей.");
                        SetPlayerPos(playerid, 1835.9211,1567.0966,1010.9188);
                        SetPlayerFacingAngle(playerid, 90.0000);
                        SetPlayerVirtualWorld(playerid,h+50);
                        SetPlayerInterior(playerid,h_ints[h_class][int_id][i_int]);
                        return 1;
                    }
                    case 3:
                    {
                        if(h_info[h][h_improve][UNDERGROUND] == 0) return SendError(playerid, "В доме нет подпольного помещения, приобрести его можно в улучшениях.");
                        if(IsKeyHouseDoor(playerid, h) != 1 && h_info[h][h_underground_lock] != 0) return SendError(playerid, "У Вас нет ключей от этих дверей.");
                        if(!LoadUndergroundBots(playerid, h)) return SendError(playerid, "В подпольном помещении максимальное количество людей, зайдите позже.");
                        SetPlayerPos(playerid, 329.6736,1863.6843,1010.9078);
                        SetPlayerFacingAngle(playerid, 0.0000);
                        SetPlayerVirtualWorld(playerid,h+50);
                        SetPlayerInterior(playerid,h_ints[h_class][int_id][i_int]);
                        return 1;
                    }
                }
            }
            return 1;
        }
        case D_REFERALS:
        {
            if(response) p_temp[playerid][FirstReferal] += 10;
            else
            {
                if(p_temp[playerid][FirstReferal] >= 10) p_temp[playerid][FirstReferal] -= 10;
                else return true;
            }

            new Level, Name_tmp[MAX_PLAYER_NAME];

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name`, `level` FROM `accounts` WHERE `referral` = %d ORDER BY `level` DESC LIMIT %i, 10",
            p_info[playerid][ID], p_temp[playerid][FirstReferal]);
            new Cache:result = mysql_query(con_bd, STRING_GLOBAL);

            new rows;
            cache_get_row_count(rows);

            if(rows)
            {
                STRING_GLOBAL[0] = EOS;
                for(new i; i < rows; i ++)
                {
                    cache_get_value_name(i, "name", Name_tmp, MAX_PLAYER_NAME);
                    cache_get_value_name_int(i, "level",Level);

                    if(Level < 3) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{FF0000}%i."W" %s - {FFFF00}%d LEVEL\n", STRING_GLOBAL, i+p_temp[playerid][FirstReferal]+1, Name_tmp, Level);
                    else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{FF0000}%i."W" %s - {FFFF00}%d LEVEL\n", STRING_GLOBAL, i+p_temp[playerid][FirstReferal]+1, Name_tmp, Level);
                }
                if(!ShowPlayerDialog(playerid, D_REFERALS, 0, "Приглашенные", STRING_GLOBAL, "Далее", "Назад")) SendError(playerid, "Ничего не найдено.");
            }
            else SendError(playerid, "Больше Вас никто не указывал как пригласившего на сервер.");
            cache_delete(result);
        }
        case D_EVENT:
        {
            if(!response) return 1;
            for(new i; i < MAX_RACE_PLAYERS; i++) if(RacePlayers[i] == playerid) return SendError(playerid, "Вы уже зарегистрированы на участие в мероприятии.");
            for(new i; i < MAX_DERBY_PLAYERS; i++) if(DerbyPlayers[i] == playerid) return SendError(playerid, "Вы уже зарегистрированы на участие в мероприятии.");
            for(new i; i < MAX_PAINTBALL_PLAYERS; i++) if(PaintBallPlayers[i] == playerid) return SendError(playerid, "Вы уже зарегистрированы на участие в мероприятии.");
            for(new i = 0, x = 0; i < MAX_COSSACK_ROBBERS_TEAM; i++)
            {
                for(x = 0; x < MAX_COSSACK_ROBBERS_PLAYERS; x++)
                {
                    if(CossackRobbersPlayers[i][x] == playerid) return SendError(playerid, "Вы уже зарегистрированы на участие в мероприятии.");
                }
            }
            switch(listitem)
            {
                case 0:
                {
                    if(p_info[playerid][Lic][LIC_CAR] != 1) return SendError(playerid, "У Вас нет лицензии на \"%s\".", name_license[LIC_CAR]);
                    if(EventTime && RaceStarted == true)
                    {
                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                        Открыта регистрация на мероприятие "I"\"Гонки\"."W"\n\n\
                        Приз за 1-ое место: "I"%d$."W"\n\
                        Приз за 2-ое место: "I"%d$."W"\n\
                        Приз за 3-е место: "I"%d$."W"\n\n\
                        Свободных мест: "I"%d."W"\n\n\
                        Вы желаете зарегистрироваться?", RACE_PRIZ_ONE, RACE_PRIZ_TWO, RACE_PRIZ_THREE, MAX_RACE_PLAYERS - EventPlayersCount(0));
                        ShowPlayerDialog(playerid, D_EVENT_RACE, DIALOG_STYLE_MSGBOX, ""I"Гонки", STRING_GLOBAL, "Да", "Нет");
                        return 1;
                    }
                    else return SendError(playerid, "В данный момент регистрация на мероприятие закрыта.");
                }
                case 1:
                {
                    if(p_info[playerid][Lic][LIC_CAR] != 1) return SendError(playerid, "У Вас нет лицензии на \"%s\".", name_license[LIC_CAR]);
                    if(EventTime && DerbyStarted == true)
                    {
                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                        Открыта регистрация на мероприятие "I"\"Дерби\"."W"\n\n\
                        Приз: "I"%d$."W"\n\n\
                        Свободных мест: "I"%d."W"\n\n\
                        Вы желаете зарегистрироваться?", DERBY_PRIZ, MAX_DERBY_PLAYERS - EventPlayersCount(0));
                        ShowPlayerDialog(playerid, D_EVENT_DERBY, DIALOG_STYLE_MSGBOX, ""I"Дерби", STRING_GLOBAL, "Да", "Нет");
                        return 1;
                    }
                    else return SendError(playerid, "В данный момент регистрация на мероприятие закрыта.");
                }
                case 2:
                {
                    if(EventTime && PaintBallStarted == true)
                    {
                        if(p_info[playerid][level] < 2) return SendError(playerid, "У Вас нет 2-ого уровня.");
                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                        Открыта регистрация на мероприятие "I"\"Пейнтбол\"."W"\n\n\
                        Приз: "I"%d$."W"\n\n\
                        Свободных мест: "I"%d."W"\n\n\
                        Вы желаете зарегистрироваться?", PAINTBALL_PRIZ, MAX_PAINTBALL_PLAYERS - EventPlayersCount(1));
                        ShowPlayerDialog(playerid, D_EVENT_PAINT, DIALOG_STYLE_MSGBOX, ""I"Пейнтбол", STRING_GLOBAL, "Да", "Нет");
                    }
                    else return SendError(playerid, "В данный момент регистрация на мероприятие закрыта.");
                }
                case 3: ShowLobby(playerid);
                case 4: OnServerShowDialogDuelMenu(playerid);
                case 5:
                {
                    if(EventTime && CossackRobbersStart == true)
                    {
                        if(p_info[playerid][level] < 2) return SendError(playerid, "У Вас нет 2-ого уровня.");
                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                        Открыта регистрация на мероприятие "I"\"Казаки-разбойники\"."W"\n\n\
                        Приз (на всех): "I"%d$."W"\n\n\
                        Свободных мест в команде красных: "I"%d."W"\n\
                        Свободных мест в команде синих: "I"%d."W"\n\n\
                        Вы желаете зарегистрироваться?", PRIZE_COSSACK_ROBBERS, MAX_COSSACK_ROBBERS_PLAYERS - CheckPlayersCountCossackRobbers(CHECK_COSSACK_ROBBERS_ALL, TEAM_COSSACK_ROBBERS_RED), MAX_COSSACK_ROBBERS_PLAYERS - CheckPlayersCountCossackRobbers(CHECK_COSSACK_ROBBERS_ALL, TEAM_COSSACK_ROBBERS_BLUE));
                        ShowPlayerDialog(playerid, D_COSSACK_ROBBERS, DIALOG_STYLE_MSGBOX, ""I"Казаки-разбойники", STRING_GLOBAL, "Да", "Нет");
                    }
                    else return SendError(playerid, "В данный момент регистрация на мероприятие закрыта.");
                }
            }
            return 1;
        }
        case D_EVENT_RACE:
        {
            if(!response) return 1;
            if(EventTime && RaceStarted == true) AddPlayerToEvent(0, playerid);
            return 1;
        }
        case D_EVENT_DERBY:
        {
            if(!response) return 1;
            if(EventTime && DerbyStarted == true) AddPlayerToEvent(1, playerid);
            return 1;
        }
        case D_EVENT_PAINT:
        {
            if(!response) return 1;
            if(EventTime && PaintBallStarted == true) AddPlayerToEvent(2, playerid);
            return 1;
        }
        case D_COSSACK_ROBBERS:
        {
            if(!response) return 1;
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "\
            [#] Название команды\tСвободных мест\n\
            "I"[1]"W" Команда красных\t%d\n\
            "I"[2]"W" Команда синих\t%d", MAX_COSSACK_ROBBERS_PLAYERS - CheckPlayersCountCossackRobbers(CHECK_COSSACK_ROBBERS_ALL, TEAM_COSSACK_ROBBERS_RED), MAX_COSSACK_ROBBERS_PLAYERS - CheckPlayersCountCossackRobbers(CHECK_COSSACK_ROBBERS_ALL, TEAM_COSSACK_ROBBERS_BLUE));
            ShowPlayerDialog(playerid, D_COSSACK_ROBBERS_TEAM, DIALOG_STYLE_TABLIST_HEADERS, ""I"Выбор команды", STRING_GLOBAL, "Далее", "Отмена");
            return 1;
        }
        case D_COSSACK_ROBBERS_TEAM:
        {
            if(!response) return 1;
            if(CheckPlayersCountCossackRobbers(CHECK_COSSACK_ROBBERS_ALL, listitem) == MAX_COSSACK_ROBBERS_PLAYERS) return SendError(playerid, "В данной команде нет свободных мест.");
            AddPlayerCossackRobbers(playerid, listitem);
            return 1;
        }
        case D_START_WORK:
        {
            if(!response) return 1;
            if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "Вы должны находиться в транспортном средстве.");
            new vehicleid = GetPlayerVehicleID(playerid), vehicle_model = GetVehicleModelEx(vehicleid);
            if(!IsPlayerOwnerVehicle(playerid, vehicleid)) return SendError(playerid, "Вы должны находиться в личном транспортном средстве.");
            if(IsPlayerRentedVehicle(playerid, p_temp[playerid][rented_veh])) callcmd::unrent(playerid, "/0");
            switch(listitem)
            {
                case 0:
                {
                    if(p_info[playerid][job] != JOB_BUS) return SendError(playerid, "Вы не работаете водителем автобуса.");
                    if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != BUS_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
                    if(p_temp[playerid][Work_ID] == BUS_WORK) return EndPlayerJob(playerid);
                    if(vehicle_model != 431 && vehicle_model != 437) return SendError(playerid, "Вы должны быть в транспортном средстве Bus или Coach.");
                    veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];
                    veh_info[vehicleid][v_used_key_ID] = playerid;
                    p_temp[playerid][rented_veh] = vehicleid;
                    veh_info[vehicleid][v_temp_job] = JOB_BUS;
                    return StartPlayerJob(playerid, BUS_WORK);
                }
                case 1:
                {
                    if(p_info[playerid][job] != JOB_MECHANIC) return SendError(playerid, "Вы не работаете автомехаником.");
                    if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != MECHANIC_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
                    if(p_temp[playerid][Work_ID] == MECHANIC_WORK) return EndPlayerJob(playerid);
                    if(vehicle_model != 525) return SendError(playerid, "Вы должны быть в транспортном средстве Towtruck.");
                    veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];
                    veh_info[vehicleid][v_used_key_ID] = playerid;
                    p_temp[playerid][rented_veh] = vehicleid;
                    veh_info[vehicleid][v_temp_job] = JOB_MECHANIC;
                    return StartPlayerJob(playerid, MECHANIC_WORK);
                }
                case 2:
                {
                    if(p_info[playerid][job] != JOB_COLLECTOR) return SendError(playerid, "Вы не работаете инкассатором.");
                    if(p_temp[playerid][Work_ID] == COLLECTOR_WORK)
                    {
                        if(p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID) return EndPlayerJob(playerid);
                        if(vehicle_model != 428) return SendError(playerid, "Вы должны быть в транспортном средстве Securicar.");
                        veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];
                        veh_info[vehicleid][v_used_key_ID] = playerid;
                        p_temp[playerid][rented_veh] = vehicleid;
                        veh_info[vehicleid][v_temp_job] = JOB_COLLECTOR;
                        CollectorVehicleIDx[playerid] = vehicleid;
                        return SendMes(playerid, COLOR_BLUE, "Отправляйтесь на место загрузки денежных средств.");
                    } else return SendError(playerid, "Вы должны начать рабочий день на работе инкассатора.");
                }
                case 3:
                {
                    if(p_info[playerid][job] != JOB_FIREMAN) return SendError(playerid, "Вы не работаете пожарным.");
                    if(p_temp[playerid][Work_ID] == FIREMAN_WORK)
                    {
                        if(p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID) return EndPlayerJob(playerid);
                        if(vehicle_model != 407 && vehicle_model != 544) return SendError(playerid, "Вы должны быть в транспортном средстве Firetruck или Firetruck LA.");
                        veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];
                        veh_info[vehicleid][v_used_key_ID] = playerid;
                        p_temp[playerid][rented_veh] = vehicleid;
                        p_temp[playerid][FireStatus] = 0;
                        p_temp[playerid][FireTimer] = RandomEx(30, 60);
                        veh_info[vehicleid][v_temp_job] = JOB_FIREMAN;
                        return SendMes(playerid, COLOR_BLUE, "Ожидайте вызова от диспетчера.");
                    } else return SendError(playerid, "Вы должны начать рабочий день на работе пожарного.");
                }
                case 4:
                {
                    if(p_info[playerid][job] != JOB_PILOT) return SendError(playerid, "Вы не работаете пилотом.");
                    if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != PILOT_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
                    if(p_temp[playerid][Work_ID] == PILOT_WORK) return EndPlayerJob(playerid);
                    if(vehicle_model != 519) return SendError(playerid, "Вы должны быть в транспортном средстве Shamal.");
                    veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];
                    veh_info[vehicleid][v_used_key_ID] = playerid;
                    p_temp[playerid][rented_veh] = vehicleid;
                    veh_info[vehicleid][v_temp_job] = JOB_PILOT;
                    return StartPlayerJob(playerid, PILOT_WORK);
                }
                case 5:
                {
                    if(p_info[playerid][job] != JOB_ELECTRIC) return SendError(playerid, "Вы не работаете электриком.");
                    if(p_temp[playerid][Work_ID] == ELECTRIC_WORK)
                    {
                        if(p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID) return EndPlayerJob(playerid);
                        if(vehicle_model != 552 && ElectricType[playerid] == 0) return SendError(playerid, "Вы должны быть в транспортном средстве Utility Van.");
                        if(vehicle_model != 609 && ElectricType[playerid] == 1) return SendError(playerid, "Вы должны быть в транспортном средстве Boxville.");
                        veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];
                        veh_info[vehicleid][v_used_key_ID] = playerid;
                        p_temp[playerid][rented_veh] = vehicleid;
                        veh_info[vehicleid][v_temp_job] = JOB_ELECTRIC;
                        ElectricVehicleIDx[playerid] = vehicleid;
                        if(ElectricType[playerid] == 0) SendMes(playerid, COLOR_LIME, "Вам необходимо отправиться к одной из ЛЭП для проведения ремонтных работ и подключить провода.");
                        else SendMes(playerid, COLOR_LIME, "Вам необходимо отправиться к одной из ЛЭП для ограбления и отключите провода.");
                        return SendMes(playerid, COLOR_BLUE, "Список ЛЭП: "W"/pl");
                    } else return SendError(playerid, "Вы должны начать рабочий день на работе электрика.");
                }
                case 6:
                {
                    if(p_info[playerid][job] != JOB_PANEL) return SendError(playerid, "Вы не работаете ремонтником панелей.");
                    if(p_temp[playerid][Work_ID] != PANEL_WORK)
                        return SendError(playerid, "Вы должны начать рабочий день на работе ремонтника панелей.");
                    
                    if(p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID) return EndPlayerJob(playerid);
                    if(vehicle_model != 578) return SendError(playerid, "Вы должны быть в транспортном средстве DFT-30.");
                    veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];
                    veh_info[vehicleid][v_used_key_ID] = playerid;
                    p_temp[playerid][rented_veh] = vehicleid;
                    veh_info[vehicleid][v_temp_job] = JOB_PANEL;

                    SendMes(playerid, COLOR_LIME, "Вам необходимо отправиться к списку заказов что бы приступить к работе.");
                    SendMes(playerid, COLOR_LIME, "Команды транспортных средств: {"#cLYELLOW"}/mm > [5] Команды сервера > [3] Команды транспорта");
                }
                case 7:
                {
                    if(p_info[playerid][job] != JOB_OIL) return SendError(playerid, "Вы не работаете нефтяником.");
                    if(p_temp[playerid][Work_ID] == OIL_WORK)
                    {
                        if(p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID) return EndPlayerJob(playerid);
                        if(vehicle_model != 454 && vehicle_model != 472 && vehicle_model != 452 && vehicle_model != 446 && vehicle_model != 493 && vehicle_model != 578) return SendError(playerid, "Вы должны быть в транспортном средстве Tropic, Coastguard, Speeder, Squallo, Jetmax или DFT-30.");
                        veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];
                        veh_info[vehicleid][v_used_key_ID] = playerid;
                        p_temp[playerid][rented_veh] = vehicleid;
                        veh_info[vehicleid][v_temp_job] = JOB_OIL;
                        SendMes(playerid, COLOR_LIME, "Вам необходимо отправиться к одной из нефтяных вышек для покупки и дальнейшей загрузки бочек с нефтью.");
                        return SendMes(playerid, COLOR_BLUE, "Общее меню работы: "W"/oil");
                    } else return SendError(playerid, "Вы должны начать рабочий день на работе нефтяника.");
                }
                case 8:
                {
                    if(p_info[playerid][tc_idx] == 0) return SendError(playerid, "Вы не работаете в транспортной компании.");
                    if(p_temp[playerid][Work_ID] > NONE_WORK && p_temp[playerid][Work_ID] != TRUCK_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
                    if(p_temp[playerid][Work_ID] == TRUCK_WORK) return EndPlayerJob(playerid);
                    if(vehicle_model != 403 && vehicle_model != 514 && vehicle_model != 515) return SendError(playerid, "Вы должны быть в транспортном средстве Linerunner, Tanker или Roadtrain.");
                    veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];
                    veh_info[vehicleid][v_used_key_ID] = playerid;
                    p_temp[playerid][rented_veh] = vehicleid;
                    veh_info[vehicleid][v_temp_job] = JOB_TC_TRUCK;
                    return StartPlayerJob(playerid, TRUCK_WORK);
                }
            }
            return 1;
        }
        #if EVENT_HALLOWEEN == 1
            case D_HALLOWEEN:
            {
                if(!response) return 1;
                switch(listitem)
                {
                    case 0:
                    {
                        if(p_info[playerid][level] < 10) return SendError(playerid, "Выполнение тематических квестов доступно с 10-го уровня.");
                        if(p_info[playerid][halloween_id] == 0)
                        {
                            p_info[playerid][halloween_id] = 1;
                            p_info[playerid][halloween_progress] = 0;

                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof STRING_GLOBAL, "UPDATE `accounts` SET `halloween_id` = %d, `halloween_progress` = %d WHERE `id` = %d",
                            p_info[playerid][halloween_id], p_info[playerid][halloween_progress], p_info[playerid][ID]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                        }
                        if(p_info[playerid][halloween_id] >= MAX_HALLOWEEN_QUEST_ID + 1) return SendError(playerid, "Вы уже прошли все квесты.");
                        HalloweenQuest_Main(playerid);
                    }
                    case 1: ShowGiftChangeCoins(playerid);
                    case 2: ShowInfoGift(playerid);
                    case 3:
                    {
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `accounts` WHERE `gift` != 0 ORDER BY `gift` DESC LIMIT 10");
                        mysql_tquery(con_bd, STRING_GLOBAL, "OnPlayerShowListSearchGift", "d", playerid);
                    }
                }
                return 1;
            }
            case D_HALLOWEEN_QUEST_MAIN:
            {
                if(!response) return 1;
                HalloweenQuest_Check(playerid);
            }
        }
        #endif
        #if NEWYEAR_STATUS == 1
            case D_NEWYEAR:
            {
                if(!response) return 1;
                switch(listitem)
                {
                    case 0: ShowGiftChangeCoins(playerid);
                    case 1: ShowInfoGift(playerid);
                    case 2:
                    {
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `accounts` WHERE `gift` != 0 ORDER BY `gift` DESC LIMIT 10");
                        mysql_tquery(con_bd, STRING_GLOBAL, "OnPlayerShowListSearchGift", "d", playerid);
                    }
                }
                return 1;
            }
        #endif
        #if EASTER_STATUS == 1
            case D_EASTER:
            {
                if(!response) return 1;
                switch(listitem)
                {
                    case 0: SendInfo(playerid, "Подойдите к бабушке Мае для прохождения квеста.");
                    case 1: ShowGiftChangeCoins(playerid);
                    case 2: ShowInfoGift(playerid);
                    case 3:
                    {
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `accounts` WHERE `gift` != 0 ORDER BY `gift` DESC LIMIT 10");
                        mysql_tquery(con_bd, STRING_GLOBAL, "OnPlayerShowListSearchGift", "d", playerid);
                    }
                }
                return 1;
            }
        #endif
        case D_TRASH_BOX:
        {
            if(!response)
            {
                p_temp[playerid][trash_box_use] = -1;
                for(new i; i < 100; i++) p_temp[playerid][p_listitem][i] = -1;
                return 1;
            }
            if(p_temp[playerid][p_listitem][listitem] == -1) return 1;
            new i = p_temp[playerid][p_listitem][listitem], idx = p_temp[playerid][trash_box_use], items_type = TrashBoxInfo[idx][tbItems][i], items_count = TrashBoxInfo[idx][tbItemsCount][i], items_idx = TrashBoxInfo[idx][tbItemsIDx][i];
            if(items_type == 0 || items_count == 0) return SendError(playerid, "Ничего не найдено.");
            for(new i; i < 100; i++) p_temp[playerid][p_listitem][i] = -1;
            TrashBoxInfo[idx][tbItems][i] = 0;
            TrashBoxInfo[idx][tbItemsCount][i] = 0;
            TrashBoxInfo[idx][tbItemsIDx][i] = 0;
            SetPlayerItem(playerid, 11, p_info[playerid][ID], items_type, items_count, items_idx);
            Log(LOG_player, INFO, "%s[%d] получил %s из ящика с предметами | #TrashBox",
            get_name(playerid), p_info[playerid][ID], GetPrizeItemsName(items_type, items_count, items_idx));
            if(DestroyTrashBox(idx) == -1) ShowTrashBoxContent(playerid, idx);
            return 1;
        }
        case D_ANTI_BOT:
        {
            if(p_temp[playerid][antibot_check] == false) return 1;
            if(!response) return ClearBot(playerid, "Вы отменили проверку на активность.");
            if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_ANTI_BOT, DIALOG_STYLE_INPUT, ""I"Проверка на активность", ""W"Какая цифра изображена на экране?", "Далее", "Отмена"), SendError(playerid, "Вы ничего не ввели.");
            if(strval(inputtext) != p_temp[playerid][antibot_number]) return ClearBot(playerid, "Вы ответили неверно.");
            Fix_TogglePlayerControllable(playerid, true);
            p_temp[playerid][antibot_check] = false;
            p_temp[playerid][antibot_number] = 0;
            p_temp[playerid][antibot_time] = 0;
            SendMes(playerid, COLOR_GREEN, "Вы ответили верно, можете продолжать выполнять задачи.");
            for(new i = 20; i != -1; i--)
            {
                if(PTD_AntiBot[playerid][i] != PlayerText:INVALID_TEXT_DRAW)
                {
                    PlayerTextDrawDestroy(playerid, PTD_AntiBot[playerid][i]);
                    PTD_AntiBot[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
                }
            }
            return 1;
        }
        case D_REAL_CARS_ENTER:
        {
            if(!response) return 1;
            if(!(0 <= listitem <= 5)) return 1;
            if(GetPlayerGameVersion(playerid) < CLIENT_VERSION_022023)
            {
                SendInfo(playerid, "Вам скорее всего будут отображаться обычные автомобили.");
                if(IsPlayerMobile(playerid)) SendInfo(playerid, "У вас что-то с файлами игры или клиентом игры, введите /realhelp.");
            }
            SetPlayerPos(playerid, 1306.9766,-50.4123,2002.4978);
            SetPlayerFacingAngle(playerid, 90.0);
            SetPlayerInterior(playerid, 1);
            SetPlayerVirtualWorld(playerid, listitem);
            return 1;
        }
        case D_REAL_CARS_EXIT:
        {
            if(!response) return 1;
            if(!(0 <= listitem <= 6)) return 1;
            if(GetPlayerGameVersion(playerid) < CLIENT_VERSION_022023)
            {
                SendInfo(playerid, "Вам скорее всего будут отображаться обычные автомобили.");
                if(IsPlayerMobile(playerid)) SendInfo(playerid, "У вас что-то с файлами игры или клиентом игры, введите /realhelp.");
            }
            if(listitem == 0)
            {
                SetPlayerPos(playerid, 2172.6907,1398.1908,11.0625);
                SetPlayerFacingAngle(playerid, 90.0);
                SetPlayerInterior(playerid, 0);
                SetPlayerVirtualWorld(playerid, 0);
                return 1;
            }
            SetPlayerPos(playerid, 1306.9766,-50.4123,2002.4978);
            SetPlayerFacingAngle(playerid, 90.0);
            SetPlayerInterior(playerid, 1);
            SetPlayerVirtualWorld(playerid, listitem - 1);
            return 1;
        }
        case D_PLAYER_HISTORY:
        {
            if(!response) return 1;
            if(!(0 <= listitem < TYPE_LOG_ALL-1)) return 1;
            if(listitem >= 2) listitem++;
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT HIGH_PRIORITY * FROM `admin_log` WHERE `PLAYER`= '%s' AND `TYPE` = %d ORDER BY `ID` DESC LIMIT 10",
                p_temp[playerid][PlayerHistory], listitem+1);
            mysql_tquery(con_bd, STRING_GLOBAL, "OnPlayerSelectLogs", "dd", playerid, listitem+1);
            return 1;
        }
        case D_DUEL_MENU:
        {
            if(!response) return 1;
            if(p_temp[playerid][DuelID] == INVALID_PLAYER_ID) return SendError(playerid, "У Вас нет дуэлей.");
            if(DuelData[p_temp[playerid][DuelID]][dGameState] == 1) return 1;
            switch(listitem)
            {
                case 0: ShowPlayerDialog(playerid, D_DUEL_BANK, DIALOG_STYLE_INPUT, ""I"Ставка", ""W"Введите сумму ставки в дуэли:", "Принять", "Отмена");
                case 1: ShowPlayerDialog(playerid, D_DUEL_WEAPON, DIALOG_STYLE_LIST, ""I"Оружие", ""I"[1]"W" Пустынный орел\n"I"[2]"W" Дробовик\n"I"[3]"W" АК-47\n"I"[4]"W" М4\n"I"[5]"W" MP5", "Принять", "Отмена");
                case 2: ShowPlayerDialog(playerid, D_DUEL_ROUND, DIALOG_STYLE_INPUT, ""I"Раунды", ""W"Введите количество раундов для дуэли:\nКоличество раундов не может быть менее 1 и более 10.", "Принять", "Отмена");
                case 3: ShowPlayerDialog(playerid, D_DUEL_MAP, DIALOG_STYLE_LIST, ""I"Карта", ""I"[1]"W" Случайная\n"I"[2]"W" Snow\n"I"[3]"W" Inferno\n"I"[4]"W" Desert\n"I"[5]"W" Wahehouse", "Принять", "Отмена");
                case 4:
                {
                    new duelid = p_temp[playerid][DuelID];
                    if(duelid == INVALID_PLAYER_ID) return 1;
                    STRING_GLOBAL[0] = EOS;
                    for(new i; i < 10; i++)
                    {
                        if(GetRangDuel(playerid) == DUEL_RANK_OWNER_1)
                        {
                            if(DuelData[duelid][dCommand1][i] != INVALID_PLAYER_ID) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" %s%s\n",
                                STRING_GLOBAL, i+1, get_name(DuelData[duelid][dCommand1][i]), i == 0 ? " [Создатель]":"");
                            else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" Слот свободный\n", STRING_GLOBAL, i+1);
                        }
                        else
                        {
                            if(DuelData[duelid][dCommand2][i] != INVALID_PLAYER_ID) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" %s%s\n",
                                STRING_GLOBAL, i+1, get_name(DuelData[duelid][dCommand2][i]), i == 0 ? " [Создатель]":"");
                            else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" Слот свободный\n", STRING_GLOBAL, i+1);
                        }
                    }
                    ShowPlayerDialog(playerid, D_DUEL_MEMBER_LIST, DIALOG_STYLE_LIST, ""I"Список команды", STRING_GLOBAL, "Принять", "Отмена");
                    return 1;
                }
                case 5:
                {
                    new duelid = p_temp[playerid][DuelID], duel_command[2], duelbet, targetid,
                        duel_name_map[][] = {"Случайная", "Snow", "Inferno", "Desert", "Wahehouse"};
                    if(duelid == INVALID_PLAYER_ID) return 1;
                    for(new i; i < 10; i++)
                    {
                        if(DuelData[duelid][dCommand1][i] != INVALID_PLAYER_ID) duel_command[0]++;
                        if(DuelData[duelid][dCommand2][i] != INVALID_PLAYER_ID) duel_command[1]++;
                    }
                    if(GetRangDuel(playerid) == DUEL_RANK_OWNER_1)
                        duelbet = DuelData[duelid][dBank]/duel_command[0], targetid = DuelData[duelid][dCommand2][0];
                    if(GetRangDuel(playerid) == DUEL_RANK_OWNER_2)
                        duelbet = DuelData[duelid][dBank]/duel_command[1], targetid = DuelData[duelid][dCommand1][0];
                    if(targetid == INVALID_PLAYER_ID) return 1;
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL),
                        ""I"%s [%d] "W"предложил начать Вам дуэль!\n\
                        "W"Ставка: "I"%d$ "A"(%d$ с чел.)\n\
                        "W"Оружие: "I"%s\n\
                        "W"Количество раундов: "I"%d\n\
                        "W"Карта: "I"%s\n\
                        "W"Состав команды "I"%s: "A"%d чел.\n\
                        "W"Состав команды "I"%s: "A"%d чел.",
                        get_name(playerid), playerid, DuelData[duelid][dBank],
                        duelbet, WEAPON_Name[DuelData[duelid][dGun]], DuelData[duelid][dRound],
                        duel_name_map[DuelData[duelid][dMap]],
                        get_name(DuelData[duelid][dCommand1][0]), duel_command[0],
                        get_name(DuelData[duelid][dCommand2][0]), duel_command[1]);
                    ShowPlayerDialog(targetid, D_DUEL_START, DIALOG_STYLE_MSGBOX, ""I"Приглашение", STRING_GLOBAL, "Принять", "Отмена");
                }
                case 6:
                {
                    if(p_temp[playerid][DuelID] == INVALID_PLAYER_ID) return SendError(playerid, "У Вас нет созданных дуэлей.");
                    ClearDuel(p_temp[playerid][DuelID], playerid);
                    SendAccess(playerid, "Вы вышли из дуэль.");
                    return 1;
                }
                case 7:
                {
                    new duel_id = p_temp[playerid][DuelID],
                        owner1 = DuelData[duel_id][dCommand1][0],
                        owner2 = DuelData[duel_id][dCommand2][0];
                    if(duel_id == INVALID_PLAYER_ID) return 1;
                    if(DuelData[duel_id][dFamilyStatus] == 0)
                    {
                        if(owner1 == playerid)
                        {
                            if(p_info[playerid][family_id] == -1 || GetPlayerFamilyID(playerid) == -1 ||
                                p_info[owner2][family_id] == -1 || GetPlayerFamilyID(owner2) == -1)
                            return SendError(playerid, "Игрок не состоит в семье."), OnServerShowDialogDuelMenu(playerid);
                            if(GetPlayerFamilyID(playerid) == GetPlayerFamilyID(owner2))
                            return SendError(playerid, "Игрок состоит в Вашей семье."), OnServerShowDialogDuelMenu(playerid);
                        }
                        if(owner2 == playerid)
                        {
                            if(p_info[playerid][family_id] == -1 || GetPlayerFamilyID(playerid) == -1 ||
                                p_info[owner1][family_id] == -1 || p_temp[owner1][family_game_id] == -1)
                            return SendError(playerid, "Игрок не состоит в семье."), OnServerShowDialogDuelMenu(playerid);
                            if(GetPlayerFamilyID(playerid) == p_temp[owner1][family_game_id])
                            return SendError(playerid, "Игрок состоит в Вашей семье."), OnServerShowDialogDuelMenu(playerid);
                        }

                        for(new i = 1; i < 10; i++)
                        {
                            if(DuelData[duel_id][dCommand1][i] != INVALID_PLAYER_ID)
                            {
                                if(p_temp[owner1][family_game_id] != p_temp[DuelData[duel_id][dCommand1][i]][family_game_id])
                                {
                                    SendInfo(DuelData[duel_id][dCommand1][i], "Создатель дуэли сделал ее семейной, а Вы не в его семье.");
                                    p_temp[DuelData[duel_id][dCommand1][i]][DuelID] = INVALID_PLAYER_ID;
                                    DuelData[duel_id][dCommand1][i] = INVALID_PLAYER_ID;
                                }
                            }
                            if(DuelData[duel_id][dCommand2][i] != INVALID_PLAYER_ID)
                            {
                                if(p_temp[owner2][family_game_id] != p_temp[DuelData[duel_id][dCommand2][i]][family_game_id])
                                {
                                    SendInfo(DuelData[duel_id][dCommand2][i], "Создатель дуэли сделал ее семейной, а Вы не в его семье.");
                                    p_temp[DuelData[duel_id][dCommand2][i]][DuelID] = INVALID_PLAYER_ID;
                                    DuelData[duel_id][dCommand2][i] = INVALID_PLAYER_ID;
                                }
                            }
                        }
                    }
                    DuelData[duel_id][dFamilyStatus] = !DuelData[duel_id][dFamilyStatus];
                    if(owner1 == playerid)
                    {
                        SendAccess(playerid, "Вы изменили настройки дуэли.");
                        SendAccess(owner2, "%s [%d] изменил настройки дуэли.", get_name(owner2), owner2);
                    }
                    if(owner2 == playerid)
                    {
                        SendAccess(playerid, "Вы изменили настройки дуэли.");
                        SendAccess(owner1, "%s [%d] изменил настройки дуэли.", get_name(owner1), owner1);
                    }
                    OnServerShowDialogDuelMenu(owner1);
                    OnServerShowDialogDuelMenu(owner2);
                }
            }
            return 1;
        }
        case D_DUEL_CANCEL:
        {
            if(!response) return 1;
            new duel_id = p_temp[playerid][DuelID];

            DuelData[duel_id][dGun] = 24;
            DuelData[duel_id][dRound] = 3;
            DuelData[duel_id][dBank] = 1000;
            ClearDuel(duel_id, playerid);
            return 1;
        }
        case D_DUEL_MAP:
        {

            if(!response) return OnServerShowDialogDuelMenu(playerid);
            new duelid = p_temp[playerid][DuelID],
                duel_name_map[][] = {"Случайная", "Snow", "Inferno", "Desert", "Wahehouse"};
            if(duelid == INVALID_PLAYER_ID) return 1;
            if(DuelData[duelid][dGameState] == 1) return 1;
            for(new i; i < 10; i++)
            {
                if(DuelData[duelid][dCommand1][i] != INVALID_PLAYER_ID)
                    SendAccess(DuelData[duelid][dCommand1][i], "%s установил карту на %s.", get_name(playerid), duel_name_map[listitem]);
                if(DuelData[duelid][dCommand2][i] != INVALID_PLAYER_ID)
                    SendAccess(DuelData[duelid][dCommand2][i], "%s установил карту на %s.", get_name(playerid), duel_name_map[listitem]);
            }
            if(listitem == 0) DuelData[duelid][dMap] = random(MAX_DUEL_MAP-1)+1;
            else DuelData[duelid][dMap] = listitem;

            OnServerShowDialogDuelMenu(playerid);
            return 1;
        }
        case D_DUEL_START:
        {
            if(!response) return OnServerShowDialogDuelMenu(playerid);
            new duelid = p_temp[playerid][DuelID], duel_command[2], duelbet[2], duelnomoney;
            if(duelid == INVALID_PLAYER_ID) return 1;
            for(new i; i < 10; i++)
            {
                if(DuelData[duelid][dCommand1][i] != INVALID_PLAYER_ID) duel_command[0]++;
                if(DuelData[duelid][dCommand2][i] != INVALID_PLAYER_ID) duel_command[1]++;
            }
            if(DuelData[duelid][dFamilyStatus] == 1 && duel_command[0] != duel_command[1])
            {
                OnServerShowDialogDuelMenu(playerid);
                return SendError(playerid, "Количество игроков в семейной схватке должно быть равным.");
            }

            duelbet[0] = DuelData[duelid][dBank]/duel_command[0];
            duelbet[1] = DuelData[duelid][dBank]/duel_command[1];

            for(new i; i < 10; i++)
            {
                if(DuelData[duelid][dCommand1][i] != INVALID_PLAYER_ID && p_info[DuelData[duelid][dCommand1][i]][cash] < duelbet[0]) duelnomoney++;
                if(DuelData[duelid][dCommand2][i] != INVALID_PLAYER_ID && p_info[DuelData[duelid][dCommand2][i]][cash] < duelbet[1]) duelnomoney++;
            }
            if(duelnomoney > 0)
            {
                for(new i; i < 10; i++)
                {
                    if(DuelData[duelid][dCommand1][i] != INVALID_PLAYER_ID)
                        SendError(DuelData[duelid][dCommand1][i], "Кому то из участников не хватает денег на свою долю ставки.");
                    if(DuelData[duelid][dCommand2][i] != INVALID_PLAYER_ID)
                        SendError(DuelData[duelid][dCommand2][i], "Кому то из участников не хватает денег на свою долю ставки.");
                }
                return OnServerShowDialogDuelMenu(playerid);
            }
            else
            {
                DuelData[duelid][dGameState] = 1;
                DuelData[duelid][dGameRound] = 1;
                DuelData[duelid][dGameCommand1Kill] = 0;
                DuelData[duelid][dGameCommand2Kill] = 0;

                DuelData[duelid][dMap]--;
                if(DuelData[duelid][dMap] < 0) DuelData[duelid][dMap] = random(MAX_DUEL_MAP-1)+1;

                new str[MAX_PLAYER_NAME], duel_map_id = DuelData[duelid][dMap];
                format(str, sizeof(str), "~r~Round %d/%d", DuelData[duelid][dGameRound], DuelData[duelid][dRound]);
                for(new i; i < 10; i++)
                {
                    if(DuelData[duelid][dCommand1][i] != INVALID_PLAYER_ID)
                    {
                        ResetPlayerWeapons(DuelData[duelid][dCommand1][i]);
                        SetPlayerMoney(DuelData[duelid][dCommand1][i], -duelbet[0], true, "доля ставки на дуэли");
                        if(DuelData[duelid][dGameRound]%2 == 0) // command 1
                        {
                            SetPlayerPos(DuelData[duelid][dCommand1][i], DuelSpawn[0][duel_map_id][0], DuelSpawn[0][duel_map_id][1], DuelSpawn[0][duel_map_id][2]);
                            SetPlayerFacingAngle(DuelData[duelid][dCommand1][i], DuelSpawn[0][duel_map_id][3]);
                        }
                        else
                        {
                            SetPlayerPos(DuelData[duelid][dCommand1][i], DuelSpawn[1][duel_map_id][0], DuelSpawn[1][duel_map_id][1], DuelSpawn[1][duel_map_id][2]);
                            SetPlayerFacingAngle(DuelData[duelid][dCommand1][i], DuelSpawn[1][duel_map_id][3]);
                        }
                        SetPlayerVirtualWorld(DuelData[duelid][dCommand1][i], duelid+500);
                        SetPlayerHealth(DuelData[duelid][dCommand1][i], 100.0);
                        SetPlayerInterior(DuelData[duelid][dCommand1][i], duelid + 1000);
                        SetPlayerColor(DuelData[duelid][dCommand1][i], 0xFF0000FF);
                        GameTextForPlayer(DuelData[duelid][dCommand1][i], str, 1000, 3);
                        GivePlayerWeapon(DuelData[duelid][dCommand1][i], DuelData[duelid][dGun], 250);
                        p_temp[DuelData[duelid][dCommand1][i]][dSpectateId] = INVALID_PLAYER_ID;
                    }
                    if(DuelData[duelid][dCommand2][i] != INVALID_PLAYER_ID)
                    {
                        ResetPlayerWeapons(DuelData[duelid][dCommand2][i]);
                        SetPlayerMoney(DuelData[duelid][dCommand2][i], -duelbet[1], true, "доля ставки на дуэли");
                        if(DuelData[duelid][dGameRound]%2 == 0)
                        {
                            SetPlayerPos(DuelData[duelid][dCommand2][i], DuelSpawn[1][duel_map_id][0], DuelSpawn[1][duel_map_id][1], DuelSpawn[1][duel_map_id][2]);
                            SetPlayerFacingAngle(DuelData[duelid][dCommand1][i], DuelSpawn[1][duel_map_id][3]);
                        }
                        else
                        {
                            SetPlayerPos(DuelData[duelid][dCommand2][i], DuelSpawn[0][duel_map_id][0], DuelSpawn[0][duel_map_id][1], DuelSpawn[0][duel_map_id][2]);
                            SetPlayerFacingAngle(DuelData[duelid][dCommand2][i], DuelSpawn[0][duel_map_id][3]);
                        }
                        SetPlayerVirtualWorld(DuelData[duelid][dCommand2][i], duelid+500);
                        SetPlayerHealth(DuelData[duelid][dCommand2][i], 100.0);
                        SetPlayerInterior(DuelData[duelid][dCommand2][i], duelid + 1000);
                        SetPlayerColor(DuelData[duelid][dCommand2][i], 0x0000FFFF);
                        GameTextForPlayer(DuelData[duelid][dCommand2][i], str, 1000, 3);
                        GivePlayerWeapon(DuelData[duelid][dCommand2][i], DuelData[duelid][dGun], 250);
                        p_temp[DuelData[duelid][dCommand2][i]][dSpectateId] = INVALID_PLAYER_ID;
                    }
                }
            }
            return 1;
        }
        case D_DUEL_MEMBER_LIST:
        {
            if(!response || !listitem) return OnServerShowDialogDuelMenu(playerid);
            new duelid = p_temp[playerid][DuelID],
                list_id;
            if(GetRangDuel(playerid) == DUEL_RANK_OWNER_1) list_id = DuelData[duelid][dCommand1][listitem];
            else list_id = DuelData[duelid][dCommand2][listitem];
            if(list_id == INVALID_PLAYER_ID)
                ShowPlayerDialog(playerid, D_DUEL_MEMBER_ADD, DIALOG_STYLE_INPUT, ""I"Приглашение", ""W"Введите ID человека которому хотите предложить по участвовать в дуэли в Вашей команде:", "Принять", "Отмена");
            else
            {
                p_temp[playerid][p_listitem_int] = list_id;
                ShowPlayerDialog(playerid, D_DUEL_MEMBER_DELETE, DIALOG_STYLE_INPUT, ""I"Удаление", ""W"Введите ID человека которого хотите из дуэли в Вашей команде:", "Принять", "Отмена");
            }
            return 1;
        }
        case D_DUEL_MEMBER_DELETE:
        {
            if(!response) return OnServerShowDialogDuelMenu(playerid);
            if(strlen(inputtext) <= 0) return ShowPlayerDialog(playerid, D_DUEL_MEMBER_DELETE, DIALOG_STYLE_INPUT, ""I"Удаление", ""W"Введите ID человека которого хотите из дуэли в Вашей команде:", "Принять", "Отмена");
            new targetid = strval(inputtext);
            if(targetid == playerid)
            {
                ShowPlayerDialog(playerid, D_DUEL_MEMBER_DELETE, DIALOG_STYLE_INPUT, ""I"Удаление", ""W"Введите ID человека которого хотите из дуэли в Вашей команде:", "Принять", "Отмена");
                SendError(playerid, "Вы ввели свой ID.");
                return 1;
            }
            if(IsPlayerConnected(targetid) == 0 || targetid == INVALID_PLAYER_ID)
            {
                ShowPlayerDialog(playerid, D_DUEL_MEMBER_DELETE, DIALOG_STYLE_INPUT, ""I"Удаление", ""W"Введите ID человека которого хотите из дуэли в Вашей команде:", "Принять", "Отмена");
                SendError(playerid, "Игрок не найден.");
                return 1;
            }
            if(distance(playerid, targetid) > 10.0 || GetPlayerState(targetid) == PLAYER_STATE_SPECTATING)
            {
                ShowPlayerDialog(playerid, D_DUEL_MEMBER_DELETE, DIALOG_STYLE_INPUT, ""I"Удаление", ""W"Введите ID человека которого хотите из дуэли в Вашей команде:", "Принять", "Отмена");
                SendError(playerid, "Игрок слишком далеко от Вас.");
                return 1;
            }
            if(p_temp[targetid][DuelID] == INVALID_PLAYER_ID)
            {
                ShowPlayerDialog(playerid, D_DUEL_MEMBER_DELETE, DIALOG_STYLE_INPUT, ""I"Удаление", ""W"Введите ID человека которого хотите из дуэли в Вашей команде:", "Принять", "Отмена");
                return SendError(playerid, "У игрока нет предложения участия на дуэль.");
            }
            p_temp[targetid][DuelID] = INVALID_PLAYER_ID;
            new dielid =  p_temp[playerid][DuelID];
            for(new i; i < 10; i++)
            {
                if(DuelData[dielid][dCommand1][i] == playerid)
                {
                    DuelData[dielid][dCommand1][i] = INVALID_PLAYER_ID;
                    break;
                }
                if(DuelData[dielid][dCommand2][i] == playerid)
                {
                    DuelData[dielid][dCommand2][i] = INVALID_PLAYER_ID;
                    break;
                }
            }
            SendInfo(targetid, "%s [%d] выгнал Вас из дуэли", get_name(playerid), playerid);
            return 1;
        }
        case D_DUEL_MEMBER_ADD:
        {
            if(!response) return OnServerShowDialogDuelMenu(playerid);
            if(strlen(inputtext) <= 0) return ShowPlayerDialog(playerid, D_DUEL_MEMBER_ADD, DIALOG_STYLE_INPUT, ""I"Приглашение", ""W"Введите ID человека которому хотите предложить по участвовать в дуэли в Вашей команде:", "Принять", "Отмена");
            new targetid = strval(inputtext);
            if(targetid == playerid)
            {
                ShowPlayerDialog(playerid, D_DUEL_MEMBER_ADD, DIALOG_STYLE_INPUT, ""I"Приглашение", ""W"Введите ID человека которому хотите предложить по участвовать в дуэли в Вашей команде:", "Принять", "Отмена");
                SendError(playerid, "Вы ввели свой ID.");
                return 1;
            }
            if(IsPlayerConnected(targetid) == 0 || targetid == INVALID_PLAYER_ID)
            {
                ShowPlayerDialog(playerid, D_DUEL_MEMBER_ADD, DIALOG_STYLE_INPUT, ""I"Приглашение", ""W"Введите ID человека которому хотите предложить по участвовать в дуэли в Вашей команде:", "Принять", "Отмена");
                SendError(playerid, "Игрок не найден.");
                return 1;
            }
            if(distance(playerid, targetid) > 10.0 || GetPlayerState(targetid) == PLAYER_STATE_SPECTATING)
            {
                ShowPlayerDialog(playerid, D_DUEL_MEMBER_ADD, DIALOG_STYLE_INPUT, ""I"Приглашение", ""W"Введите ID человека которому хотите предложить по участвовать в дуэли в Вашей команде:", "Принять", "Отмена");
                SendError(playerid, "Игрок слишком далеко от Вас.");
                return 1;
            }
            if(DuelData[p_temp[playerid][DuelID]][dFamilyStatus] == 1 && GetPlayerFamilyID(playerid) != p_temp[targetid][family_game_id])
            {
                ShowPlayerDialog(playerid, D_DUEL_MEMBER_ADD, DIALOG_STYLE_INPUT, ""I"Приглашение", ""W"Введите ID человека которому хотите предложить по участвовать в дуэли в Вашей команде:", "Принять", "Отмена");
                SendError(playerid, "Игрок не состоит в Ваше семье.");
                return 1;
            }
            if(p_temp[targetid][DuelID] != INVALID_PLAYER_ID)
            {
                ShowPlayerDialog(playerid, D_DUEL_MEMBER_ADD, DIALOG_STYLE_INPUT, ""I"Приглашение", ""W"Введите ID человека которому хотите предложить по участвовать в дуэли в Вашей команде:", "Принять", "Отмена");
                SendError(playerid, "У игрока уже есть предложение.");
                return 1;
            }
            if(p_temp[targetid][invite_duel] != -1)
            {
                ShowPlayerDialog(playerid, D_DUEL_MEMBER_ADD, DIALOG_STYLE_INPUT, ""I"Приглашение", ""W"Введите ID человека которому хотите предложить по участвовать в дуэли в Вашей команде:", "Принять", "Отмена");
                SendError(playerid, "У игрока уже есть предложение.");
                return 1;
            }
            if(p_info[targetid][level] < 2)
            {
                ShowPlayerDialog(playerid, D_DUEL_MEMBER_ADD, DIALOG_STYLE_INPUT, ""I"Приглашение", ""W"Введите ID человека которому хотите предложить по участвовать в дуэли в Вашей команде:", "Принять", "Отмена");
                SendError(playerid, "У игрока нет 2-ого уровня.");
                return 1;
            }

            p_temp[targetid][invite_duel] = playerid;

            SendAccess(playerid, "Вы предложили %s [%d] дуэль за Вашу команду.", get_name(targetid), targetid);
            SendInfo(targetid, "%s [%d] предложил Вам дуэль за его команду.", get_name(playerid), playerid);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s [%d] предложил Вам участвовать в дуэли за его команду!", get_name(playerid), targetid, DuelData[playerid][dBank], WEAPON_Name[DuelData[playerid][dGun]], DuelData[playerid][dRound]);
            ShowPlayerDialog(targetid, D_DUEL_MEMBER_CALL, DIALOG_STYLE_MSGBOX, ""I"Приглашение", STRING_GLOBAL, "Принять", "Отмена");
            OnServerShowDialogDuelMenu(playerid);
            return 1;
        }
        case D_DUEL_MEMBER_CALL:
        {
            new owner_duel = p_temp[playerid][invite_duel];
            p_temp[playerid][invite_duel] = -1;
            if(!response)
            {
                SendInfo(owner_duel, "%s [%d] отказался от предложения поучаствовать в дуэли.", get_name(playerid), playerid);
                SendAccess(playerid, "Вы отказались от предложения %s [%d] поучаствовать в дуэли.", get_name(owner_duel), owner_duel);
                p_temp[playerid][DuelID] = INVALID_PLAYER_ID;
                return 1;
            }
            if(owner_duel == -1 || p_temp[playerid][DuelID] != INVALID_PLAYER_ID) return SendError(playerid, "Нет предложений.");
            if(!IsPlayerConnected(owner_duel))
            {
                p_temp[playerid][DuelID] = INVALID_PLAYER_ID;
                SendError(playerid, "Игрок не найден");
                return 1;
            }
            for(new i; i < 10; i++)
            {
                DuelData[playerid][dCommand1][i] = INVALID_PLAYER_ID;
                DuelData[playerid][dCommand2][i] = INVALID_PLAYER_ID;
            }

            p_temp[playerid][DuelID] = p_temp[owner_duel][DuelID];
            for(new i = 1; i < 10; i++)
            {
                if(GetRangDuel(owner_duel) == DUEL_RANK_OWNER_1)
                {
                    if(DuelData[owner_duel][dCommand1][i] == INVALID_PLAYER_ID)
                    {
                        DuelData[owner_duel][dCommand1][i] = playerid;
                        break;
                    }
                }
                if(GetRangDuel(owner_duel) == DUEL_RANK_OWNER_2)
                {
                    if(DuelData[p_temp[owner_duel][DuelID]][dCommand2][i] == INVALID_PLAYER_ID)
                    {
                        DuelData[p_temp[owner_duel][DuelID]][dCommand2][i] = playerid;
                        break;
                    }
                }
            }
            SendAccess(playerid, "Вы приняли приглашение %s [%d] поучаствовать в дуэли", get_name(owner_duel), owner_duel);
            SendInfo(owner_duel, "%s [%d] принял приглашение поучаствовать в дуэли.", get_name(playerid), playerid);
            return 1;
        }
