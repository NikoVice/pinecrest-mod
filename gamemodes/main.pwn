                    STRING_GLOBAL[0] = EOS;
                    strcat(STRING_GLOBAL, ""W"/mm (/menu) - общее меню сервера\n/gps - навигатор\n/pay - передать деньги\n/mask - надеть маску\n");
                    strcat(STRING_GLOBAL, "/leavejob - уйти с работы\n/ad - подать объявление\n/healme - использовать аптечку\n/phone - меню телефона\n");
                    strcat(STRING_GLOBAL, "/changephone - сменить активный телефон\n/sms - отправить смс\n/anim - анимации\n/animlist - анимации по категориям(больший выбор)\n/clist - цвет ника\n");
