            if(h <= INVALID_HOUSE_ID) return 1;

            new h_class = h_info[h][h_squar]-1;
            new int_id = h_info[h][h_int];
            if(h_class < 0 || int_id < 0)
                return SendError(playerid, "Что-то пошло не так, попробуйте заново или обновите версию клиента.");

            if(IsPlayerInRangeOfPoint(playerid, 2.0, h_info[h][h_enter][0], h_info[h][h_enter][1], h_info[h][h_enter][2]) && GetPlayerVirtualWorld(playerid) == 0)
            {
                if(h_info[h][h_user_id] == INVALID_MYSQL_ID)
                {
                    if(GetFreeSlotHouse(playerid) == ALL_BUSY_SLOT_HOUSE || p_info[playerid][key_h_rent] != INVALID_HOUSE_ID) return SendError(playerid, "У Вас уже есть дом или Вы подселены.");
                    if(GetPlayerHotelID(playerid, 0) != -1 || GetPlayerHotelID(playerid, 1) != -1) return SendError(playerid, "У Вас уже есть номер в отеле.");
                    new cost_house = h_info[h][h_value], list_percent[3] = {95, 90, 85}, vip_idx = p_info[playerid][p_vip];
                    if(vip_idx) cost_house = ((h_info[h][h_value] / 100) * list_percent[vip_idx - 1]);
                    if(p_info[playerid][cash] < cost_house) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                    if(h_info[h][h_auction_bet] != 0 || h_info[h][h_auction_time] != 0)
                        return SendError(playerid, "Дом находится на аукционе, приобрести его можно в риэлторском агентстве.");
                    if(h_info[h][h_rob_house]) return SendError(playerid, "В данный момент этот дом грабят, дверь сломана.");
                    ShowTextDraw_Captcha(playerid, CAPTCHA_HOUSE_ID);
                    p_temp[playerid][p_listitem_int] = h;
                    return 1;
                }
                else
                {
                    listitem--;
                    if(listitem == -1) return 1;
                    switch(listitem)
                    {
                        case 0: {
                            //SendAccess(playerid, "listitem: %d | Key: %d | Lock: %d", listitem, IsKeyHouseDoor(playerid, h), h_info[h][h_lock]);
                            if(IsKeyHouseDoor(playerid, h) != 1 && h_info[h][h_lock] != 0) return SendError(playerid, "У Вас нет ключей от этих дверей.");
                            SetPlayerHousePos(playerid, h, h_class, int_id);
                            return 1;
                        }
                        case 1:
                        {
                            if(h_info[h][h_improve][BASEMENT] == 0) return SendError(playerid, "В доме нет подвала, приобрести его можно в улучшениях.");
                            if(IsKeyHouseDoor(playerid, h) != 1 && h_info[h][h_attic_lock] != 0) return SendError(playerid, "У Вас нет ключей от этих дверей.");
                            SetPlayerPos(playerid, 1835.9211,1567.0966,1010.9188);
                            SetPlayerFacingAngle(playerid, 90.0000);
                            SetPlayerVirtualWorld(playerid,h+50);
                            SetPlayerInterior(playerid,h_ints[h_class][int_id][i_int]);
                            return 1;
                        }
                        case 2:
                        {
                            if(h_info[h][h_improve][UNDERGROUND] == 0) return SendError(playerid, "В доме нет подпольного помещения, приобрести его можно в улучшениях.");
                            if(IsKeyHouseDoor(playerid, h) != 1 && h_info[h][h_underground_lock] != 0) return SendError(playerid, "У Вас нет ключей от этих дверей.");
                            if(!LoadUndergroundBots(playerid, h)) return SendError(playerid, "В подпольном помещении максимальное количество людей, зайдите позже.");
                            SetPlayerPos(playerid, 329.6736,1863.6843,1010.9078);
                            SetPlayerFacingAngle(playerid, 0.0000);
                            SetPlayerVirtualWorld(playerid,h+50);
                            SetPlayerInterior(playerid,h_ints[h_class][int_id][i_int]);
                            return 1;
                        }
                        case 3:
                        {
                            if(h_info[h][h_squar] == 1) return SendError(playerid, "В вашем доме нет гаража.");
                            if(IsKeyHouseDoor(playerid, h) != 1 && h_info[h][h_garage_lock] != 0) return SendError(playerid, "У Вас нет ключей от этих дверей.");
                            SetPlayerHouseActive(playerid, h);

                            h_class--;
                            SetPlayerPos(playerid,g_info[h_class][g_pX],g_info[h_class][g_pY],g_info[h_class][g_pZ]);
                            SetPlayerFacingAngle(playerid, g_info[h_class][g_pR]);
                            SetPlayerVirtualWorld(playerid,h+50);
                            SetPlayerInterior(playerid, HOUSE_INT_ID_REPAIR);

                            LoadPlayerCarsGarage(playerid);
                            SendMes(playerid, COLOR_LIME, "Помощь по гаражам: {"#cLYELLOW"}/ghelp");
                            return 1;
                        }
                    }
                }
            }

            if(IsPlayerInRangeOfPoint(playerid, 2.0, h_ints[h_class][int_id][i_spawn_pos][0],h_ints[h_class][int_id][i_spawn_pos][1], h_ints[h_class][int_id][i_spawn_pos][2]) && GetPlayerVirtualWorld(playerid) == h+50)
            {
                if(listitem == -1) return 1;
                if(p_temp[playerid][h_repair_txtid] != -1)
                    return SendError(playerid, "Вы в режиме ремонта дома. Выйдите из него чтобы покинуть дом.");
                if(h_info[h][h_squar] == 1 && listitem == 2) listitem = 3;
                /*
                if(h_info[h][h_inventory_use] == playerid)
                {
                    HideTextDrawForPlayer(playerid, TD_ID_INVENTORY_OTHER);
                    h_info[h][h_inventory_use] = INVALID_PLAYER_ID;
                }
                */
                switch(listitem)
                {
                    case 0:
                    {
                        SetPlayerInterior(playerid,0);
                        SetPlayerVirtualWorld(playerid,0);
                        SetPlayerPos(playerid,h_info[h][h_enter][0], h_info[h][h_enter][1], h_info[h][h_enter][2]);
                        SetPlayerFacingAngle(playerid, h_info[h][h_enter][3]);
                        return 1;
                    }
                    case 1:
                    {
                        if(h_info[h][h_improve][BASEMENT] == 0) return SendError(playerid, "В доме нет подвала, приобрести его можно в улучшениях.");
                        if(IsKeyHouseDoor(playerid, h) != 1 && h_info[h][h_attic_lock] != 0) return SendError(playerid, "У Вас нет ключей от этих дверей.");
                        SetPlayerPos(playerid, 1835.9211,1567.0966,1010.9188);
                        SetPlayerFacingAngle(playerid, 90.0000);
                        SetPlayerVirtualWorld(playerid, h+50);
                        SetPlayerInterior(playerid, h_ints[h_class][int_id][i_int]);
                        Fix_TogglePlayerControllable(playerid, 0);
                        p_temp[playerid][UnFreezeFix] = 1;
                        p_temp[playerid][UnFreezeTimerFix] = timestamp + 2;
                        return 1;
                    }
                    case 2:
                    {
                        if(h_info[h][h_improve][UNDERGROUND] == 0) return SendError(playerid, "В доме нет подпольного помещения, приобрести его можно в улучшениях.");
                        if(IsKeyHouseDoor(playerid, h) != 1 && h_info[h][h_underground_lock] != 0) return SendError(playerid, "У Вас нет ключей от этих дверей.");
                        if(!LoadUndergroundBots(playerid, h)) return SendError(playerid, "В подпольном помещении максимальное количество людей, зайдите позже.");
                        SetPlayerPos(playerid, 329.6736,1863.6843,1010.9078);
                        SetPlayerFacingAngle(playerid, 0.0000);
                        SetPlayerVirtualWorld(playerid, h+50);
                        SetPlayerInterior(playerid, h_ints[h_class][int_id][i_int]);
                        Fix_TogglePlayerControllable(playerid, 0);
                        p_temp[playerid][UnFreezeFix] = 1;
                        p_temp[playerid][UnFreezeTimerFix] = timestamp + 2;
                        return 1;
                    }
                    case 3:
                    {
                        if(h_info[h][h_squar] == 1) return SendError(playerid, "В вашем доме нет гаража.");
                        if(IsKeyHouseDoor(playerid, h) != 1 && h_info[h][h_garage_lock] != 0) return SendError(playerid, "У Вас нет ключей от этих дверей.");
                        h_class--;
                        SetPlayerHouseActive(playerid, h);

                        SetPlayerPos(playerid,g_info[h_class][g_pX],g_info[h_class][g_pY],g_info[h_class][g_pZ]);
                        SetPlayerFacingAngle(playerid, g_info[h_class][g_pR]);
                        SetPlayerVirtualWorld(playerid,h+50);
                        SetPlayerInterior(playerid, HOUSE_INT_ID_REPAIR);

                        LoadPlayerCarsGarage(playerid);
                        SendMes(playerid, COLOR_LIME, "Помощь по гаражам: {"#cLYELLOW"}/ghelp");
                        return 1;
                    }
                }
            }
            return 1;
        }
        case D_ATTIC_DOOR:
        {
            if(!response) {
                p_temp[playerid][p_house_id] = INVALID_HOUSE_ID;
                return 1;
            }
            new h = p_temp[playerid][p_house_id];
            p_temp[playerid][p_house_id] = INVALID_HOUSE_ID;

            new h_class = h_info[h][h_squar]-1;
            new int_id = h_info[h][h_int];

            new player_state = GetPlayerState(playerid);
            if((IsPlayerInRangeOfPoint(playerid, 2.5, 1837.7548,1567.0378,1010.9188) || IsPlayerInRangeOfPoint(playerid, 2.5, 329.6453,1859.1782,1013.0838))
                && player_state == PLAYER_STATE_ONFOOT)
            {
                switch(listitem)
                {
                    case 0:
                    {
                        UnloadUndergroundBots(playerid);
                        SetPlayerInterior(playerid,0);
                        SetPlayerVirtualWorld(playerid,0);
                        SetPlayerPos(playerid,h_info[h][h_enter][0], h_info[h][h_enter][1], h_info[h][h_enter][2]);
                        SetPlayerFacingAngle(playerid, h_info[h][h_enter][3]);
                        LoadUnPlayerCarsGarage(playerid, h);
                        return 1;
                    }
                    case 1:
                    {
                        if(IsKeyHouseDoor(playerid, h) != 1 && h_info[h][h_lock] != 0) return SendError(playerid, "У Вас нет ключей от этих дверей.");
                        UnloadUndergroundBots(playerid);
                        SetPlayerHousePos(playerid, h, h_class, int_id);
                        return 1;
                    }
                    case 2:
                    {
                        if(IsPlayerInRangeOfPoint(playerid, 2.5, 1837.7548,1567.0378,1010.9188)) //чел в подвале
                        {
                            if(h_info[h][h_improve][UNDERGROUND] == 0) return SendError(playerid, "В доме нет подпольного помещения, приобрести его можно в улучшениях.");
                            if(IsKeyHouseDoor(playerid, h) != 1 && h_info[h][h_underground_lock] != 0) return SendError(playerid, "У Вас нет ключей от этих дверей.");
                            if(!LoadUndergroundBots(playerid, h)) return SendError(playerid, "В подпольном помещении максимальное количество людей, зайдите позже.");
                            SetPlayerPos(playerid, 329.6736,1863.6843,1010.9078);
                            SetPlayerFacingAngle(playerid, 0.0000);
                            SetPlayerVirtualWorld(playerid,h+50);
                            SetPlayerInterior(playerid,h_ints[h_class][int_id][i_int]);
                            return 1;
                        }
                        if(IsPlayerInRangeOfPoint(playerid, 2.5, 329.6453,1859.1782,1013.0838)) // чел в подпольном помещение
                        {
                            if(h_info[h][h_improve][BASEMENT] == 0) return SendError(playerid, "В доме нет подвала, приобрести его можно в улучшениях.");
                            if(IsKeyHouseDoor(playerid, h) != 1 && h_info[h][h_attic_lock] != 0) return SendError(playerid, "У Вас нет ключей от этих дверей.");
                            SetPlayerPos(playerid, 1835.9211,1567.0966,1010.9188);
                            SetPlayerFacingAngle(playerid, 90.0000);
                            SetPlayerVirtualWorld(playerid,h+50);
                            SetPlayerInterior(playerid,h_ints[h_class][int_id][i_int]);
                            return 1;
                        }
                    }
                    case 3:
                    {
                        if(h_info[h][h_squar] == 1) return SendError(playerid, "В вашем доме нет гаража.");
                        if(IsKeyHouseDoor(playerid, h) != 1 && h_info[h][h_garage_lock] != 0) return SendError(playerid, "У Вас нет ключей от этих дверей.");
                        UnloadUndergroundBots(playerid);
                        h_class--;
                        SetPlayerHouseActive(playerid, h);

                        SetPlayerPos(playerid,g_info[h_class][g_pX],g_info[h_class][g_pY],g_info[h_class][g_pZ]);
                        SetPlayerFacingAngle(playerid, g_info[h_class][g_pR]);
                        SetPlayerVirtualWorld(playerid,h+50);
                        SetPlayerInterior(playerid, HOUSE_INT_ID_REPAIR);

                        LoadPlayerCarsGarage(playerid);
                        SendMes(playerid, COLOR_LIME, "Помощь по гаражам: {"#cLYELLOW"}/ghelp");
                        return 1;
                    }
                }
            }
            return 1;
        }
        case D_HOUSE_INFO:
        {
            if(!response) return 1;
            menu_house_settings(playerid);
            return 1;
        }
        case D_HOUSE_SETTINGS:
        {
            if(!response) return 1;
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return 1;
            if(h == p_info[playerid][key_h_rent] && listitem > 1) return 1;
            if(h_info[h][h_squar] == 1 && listitem > 1) listitem++;
            switch(listitem)
            {
                case 0:
                {
                    if(h == p_info[playerid][key_h_rent])
                        return ShowPlayerDialog(playerid, D_HOUSE_RENT_LEAVE, DIALOG_STYLE_MSGBOX, ""I"Отмена аренды",""W"Вы собираетесь покинуть дом?","Да","Нет");

                    if(h_info[h][h_rob_house]) return SendError(playerid, "В данный момент проходит ограбление Вашего дома, дверь сломана.");

                    if(h_info[h][h_lock]) GameTextForPlayer(playerid, "~g~Unlock  home", 2000, 5);
                    else GameTextForPlayer(playerid, "~r~Lock home", 2000, 5);
                    h_info[h][h_lock] = !h_info[h][h_lock];
                    PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
                    menu_house_settings(playerid);
                    return 1;
                }
                case 1:
                {
                    if(h == p_info[playerid][key_h_rent])
                    {
                        new h_r_id;
                        for(new i; i <= h_info[h][h_squar]; i++)
                        {
                            if(p_info[playerid][ID] == h_info[h][h_r_user_id][i])
                            {
                                h_r_id = i;
                                break;
                            }
                        }
                        static const h_access[][] = {"Нет", "Есть"};
                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, "Оплачено дней: %d\n\n\
                        Разрешения:\n\
                        "I"[1] "W"Возможность парковать в гараже: "A"%s\n\
                        "I"[2] "W"Возможность доступа к подвалу: "A"%s\n\
                        "I"[3] "W"Возможность доступа к подпольному помещению: "A"%s\n",
                        h_info[h][h_r_days][h_r_id],
                        h_access[p_info[playerid][h_r_settings][R_GARAGE]],
                        h_access[p_info[playerid][h_r_settings][R_BASEMENT]],
                        h_access[p_info[playerid][h_r_settings][R_UNDERGROUND]]);
                        ShowPlayerDialog(playerid, D_NULL,DIALOG_STYLE_MSGBOX, ""I"Информация по аренде", STRING_GLOBAL,"Закрыть","");
                        return 1;
                    }
                    if(h_info[h][h_attic_lock]) GameTextForPlayer(playerid, "~g~Unlock  attic", 2000, 5);
                    else GameTextForPlayer(playerid, "~r~Lock attic", 2000, 5);
                    h_info[h][h_attic_lock] = !h_info[h][h_attic_lock];
                    PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
                    menu_house_settings(playerid);
                    return 1;
                }
                case 2: {
                    if(h_info[h][h_underground_lock]) GameTextForPlayer(playerid, "~g~Unlock  underground", 2000, 5);
                    else GameTextForPlayer(playerid, "~r~Lock underground", 2000, 5);
                    h_info[h][h_underground_lock] = !h_info[h][h_underground_lock];
                    PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
                    menu_house_settings(playerid);
                    return 1;
                }
                case 3: {
                    if(h_info[h][h_garage_lock]) GameTextForPlayer(playerid, "~g~Unlock  garage", 2000, 5);
                    else GameTextForPlayer(playerid, "~r~Lock garage", 2000, 5);
                    h_info[h][h_garage_lock] = !h_info[h][h_garage_lock];
                    PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
                    menu_house_settings(playerid);
                    return 1;
                }
                case 4: callcmd::invhouse(playerid);
                case 5: {
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "\
                        "I"[1]"W" Субсидия: %s\n\
                        "I"[2]"W" Подселение: %s\n\
                        "I"[3]"W" Подвал: %s\n\
                        "I"[4]"W" Подпольное помещение: %s\n\
                        "I"[5]"W" Сменить интерьер\n\
                        "I"[6]"W" Ремонт в доме\n\
                        "I"[7]"W" Ремонт в гараже",
                        h_info[h][h_improve][SUBSIDY] == 1 ?  ("{008000}Есть"):("{FF0000}Нет"), h_info[h][h_improve][RENTERS] == 1 ?  ("{008000}Есть"):("{FF0000}Нет"),
                        h_info[h][h_improve][BASEMENT] == 1 ?  ("{008000}Есть"):("{FF0000}Нет"), h_info[h][h_improve][UNDERGROUND] == 1 ?  ("{008000}Есть"):("{FF0000}Нет"));
                    return ShowPlayerDialog(playerid,D_HOUSE_UPGRADE_LIST,DIALOG_STYLE_LIST, ""I"Улучшения дома/гаража", STRING_GLOBAL,"Выбрать","Отмена");
                }
                case 6: {
                    if(h_info[h][h_improve][RENTERS] == 0) return menu_house_settings(playerid), SendError(playerid, "В доме нет приобретенного улучшения \"Подселение\".");
                    new family_idx = GetFamilyIDFromHouseID(h);
                    if(family_idx != -1)
                    {
                        menu_house_settings(playerid);
                        return SendError(playerid, "Дом привязан к семье. Функция недоступна.");
                    }
                    else
                    {
                        if(h_info[h][h_family_id] != -1) printf("FAMILYBUG: HOUSE | h_family_id: %d ", h_info[h][h_family_id]);
                        h_info[h][h_family_id] = -1;
                        save_house(h);
                    }

                    STRING_GLOBAL[0] = EOS;
                    for(new i; i <= h_info[h][h_squar]; i++)
                    {
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%i]"W" Арендатор: %s\n", STRING_GLOBAL, i+1, h_info[h][h_r_user_id][i] != INVALID_MYSQL_ID ? ""A"Есть": ""E"Нет");
                    }
                    ShowPlayerDialog(playerid, D_HOUSE_RENT_LIST, DIALOG_STYLE_LIST, ""I"Место в доме", STRING_GLOBAL, "Выбрать", "Отмена");
                    return 1;
                }
                case 7:
                    ShowPlayerDialog(playerid,D_HOUSE_SELL_GOS,DIALOG_STYLE_LIST, ""I"Продажа имущества",""I"[1]"W" Государству за 50 процентов гос. стоимости\n"I"[2]"W" Выставить на аукцион\n"I"[3]"W" Другому игроку","Выбор","Отмена");
            }
            return 1;
        }
        case D_HOUSE_RENT_LEAVE:
        {
            if(!response) return 1;
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return 1;
            for(new i; i <= h_info[h][h_squar]; i++)
            {
                if(p_info[playerid][ID] == h_info[h][h_r_user_id][i])
                {
                    house_rent_leave(h, i);
                    SendAccess(playerid, "Вы отказались от аренды дома.");

                    Log(LOG_player, INFO, "%s[%d](%s %s) покинул аренду дома (%d)[%d]",
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                        h, h_info[h][h_mysql_id]);
                    break;
                }
            }
            return 1;
        }
        case D_HOUSE_RENT_LIST:
        {
            if(!response) return menu_house_settings(playerid);
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return 1;
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name` FROM `accounts` WHERE `id` = %d",
            h_info[h][h_r_user_id][listitem]);
            mysql_tquery(con_bd, STRING_GLOBAL, "house_rent_user", "dd", playerid, listitem);
            return 1;
        }
        case D_HOUSE_RENT_MENU:
        {
            if(!response) return menu_house_settings(playerid);
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return 1;
            new r_id = p_temp[playerid][p_listitem_int];
            if(r_id == -1) return 1;
            STRING_GLOBAL[0] = EOS;
            switch(listitem)
            {
                case 0:
                {
                    if(h_info[h][h_r_user_id][r_id] == INVALID_MYSQL_ID) return ShowPlayerDialog(playerid,D_HOUSE_RENT_SET,DIALOG_STYLE_INPUT, ""I"Заселение нового сожителя", ""W"Введите ID игрока ниже:", "Ввести","Отмена");
                    else return ShowPlayerDialog(playerid,D_HOUSE_RENT_SET,DIALOG_STYLE_MSGBOX, ""I"Выселение сожителя", ""W"Вы уверены что хотите выселить данного сожителя?", "Да","Отмена");
                }
                case 1:
                {
                    if(h_info[h][h_r_user_id][r_id] == INVALID_MYSQL_ID) {
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name` FROM `accounts` WHERE `id` = %d",
                        h_info[h][h_r_user_id][r_id]);
                        mysql_tquery(con_bd, STRING_GLOBAL, "house_rent_user", "dd", playerid, r_id);
                        return SendError(playerid, "Вы ничего не ввели.");
                    }
                    f(STRING_GLOBAL, ""W"Текущая цена аренды в этом слоте: %d\n\nВведите новую ниже:", h_info[h][h_r_price][r_id]);
                    ShowPlayerDialog(playerid,D_HOUSE_RENT_PRICE,DIALOG_STYLE_INPUT, ""I"Смена цены аренды", STRING_GLOBAL, "Ввести","Отмена");
                }
                case 2:
                {
                    if(h_info[h][h_r_user_id][r_id] == INVALID_MYSQL_ID) {
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name` FROM `accounts` WHERE `id` = %d",
                        h_info[h][h_r_user_id][r_id]);
                        mysql_tquery(con_bd, STRING_GLOBAL, "house_rent_user", "dd", playerid, r_id);
                        return SendError(playerid, "Вы ничего не ввели.");
                    }
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `h_r_settings` FROM `accounts` WHERE `id` = %d",
                    h_info[h][h_r_user_id][r_id]);
                    mysql_tquery(con_bd, STRING_GLOBAL, "house_rent_settings", "dd", playerid, r_id);
                }
            }
            return 1;
        }
        case D_HOUSE_RENT_SETTINGS:
        {
            if(!response) return 1;
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return 1;
            new r_id = p_temp[playerid][p_listitem_int];
            new string[144];
            new targetid = GetPlayerUserID(h_info[h][h_r_user_id][r_id]);
            if(targetid != INVALID_PLAYER_ID)
            {
                p_info[targetid][h_r_settings][listitem] = !p_info[targetid][h_r_settings][listitem];

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%i|%i|%i",
                p_info[targetid][h_r_settings][R_GARAGE], p_info[targetid][h_r_settings][R_BASEMENT], p_info[targetid][h_r_settings][R_UNDERGROUND]);
                MysqlUpdatePlayerStr(targetid, "h_r_settings", STRING_GLOBAL);
            }
            else
            {
                p_temp[playerid][p_listitem][listitem] = !p_temp[playerid][p_listitem][listitem];
                format(string, sizeof(string), "%i|%i|%i",
                p_temp[playerid][p_listitem][R_GARAGE], p_temp[playerid][p_listitem][R_BASEMENT], p_temp[playerid][p_listitem][R_UNDERGROUND]);

                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `h_r_settings` = '%s' WHERE `id` = %d",
                string, h_info[h][h_r_user_id][r_id]);
                mysql_tquery(con_bd, STRING_GLOBAL);
            }
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name` FROM `accounts` WHERE `id` = %d",
            h_info[h][h_r_user_id][r_id]);
            mysql_tquery(con_bd, STRING_GLOBAL, "house_rent_user", "dd", playerid, r_id);
            SendAccess(playerid, "Вы изменили настройки.");
            return 1;
        }
        case D_HOUSE_RENT_PRICE:
        {
            if(!response) return 1;
            new fix_listitem;
            if(sscanf(inputtext, "i", fix_listitem)) return SendError(playerid, "Вы ничего не ввели.");
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return 1;
            if(!(0 <= fix_listitem <= h_info[h][h_squar]*200)) return SendError(playerid, "Стоимость должна быть не менее 0$ и не более %d$.", h_info[h][h_squar]*200);
            new r_id = p_temp[playerid][p_listitem_int];
            h_info[h][h_r_price][r_id] = fix_listitem;
            new targetid = GetPlayerUserID(h_info[h][h_r_user_id][r_id]);
            if(h_info[h][h_r_user_id][r_id] != INVALID_MYSQL_ID && targetid != INVALID_PLAYER_ID)
                SendInfo(targetid, "Владелец дома изменил стоимость аренды на %d$.", h_info[h][h_r_price][r_id]);

            SendAccess(playerid, "Вы изменили стоимость аренды на %d$.", h_info[h][h_r_price][r_id]);
            save_house(h);
            return 1;
        }
        case D_HOUSE_RENT_BUY:
        {
            if(!response) return 1;
            new h = p_temp[playerid][p_listitem][1],
                r_id = p_temp[playerid][p_listitem][0],
                targetid = p_temp[playerid][p_listitem][2];
            p_temp[playerid][p_listitem] = -1;
            if(!IsPlayerStream(8.0, playerid, targetid)) return SendError(playerid, "Вы слишком далеко от игрока.");

            h_info[h][h_r_user_id][r_id] = p_info[playerid][ID];
            p_info[playerid][key_h_rent] = h;
            p_info[playerid][spawn] = SPAWN_HOUSE;
            SendInfo(playerid, "%s подселил Вас в дом.", get_name(targetid));
            SendAccess(targetid, "Вы подселили %s в дом.", get_name(playerid));

            h_info[h][h_r_price][r_id] = h_info[h][h_squar]*200;
            h_info[h][h_r_days][r_id] = 5;
            save_house(h);

            p_info[playerid][h_r_settings][R_GARAGE] =
            p_info[playerid][h_r_settings][R_BASEMENT] =
            p_info[playerid][h_r_settings][R_UNDERGROUND] = 0;

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%i|%i|%i",
            p_info[playerid][h_r_settings][R_GARAGE], p_info[playerid][h_r_settings][R_BASEMENT], p_info[playerid][h_r_settings][R_UNDERGROUND]);
            MysqlUpdatePlayerStr(playerid, "h_r_settings", STRING_GLOBAL);
        }
        case D_HOUSE_RENT_SET:
        {
            if(!response) return 1;
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return 1;
            new r_id = p_temp[playerid][p_listitem_int];
            if(h_info[h][h_r_user_id][r_id] == INVALID_MYSQL_ID) {
                new fix_listitem;
                if(sscanf(inputtext, "i", fix_listitem)) return SendError(playerid, "Вводить нужно только цифру пункта.");
                if(fix_listitem == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не найден.");
                if(!IsPlayerStream(5.0, playerid, fix_listitem) || pSpectateId[fix_listitem] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
                if(GetPlayerHouseID(fix_listitem) != INVALID_HOUSE_ID) return SendError(playerid, "У игрока уже есть дом или он подселен.");
                if(GetPlayerHotelID(fix_listitem, 0) != -1 || GetPlayerHotelID(fix_listitem, 1) != -1) return SendError(playerid, "У игрока уже есть номер в отеле.");

                p_temp[fix_listitem][p_listitem][0] = r_id;
                p_temp[fix_listitem][p_listitem][1] = h;
                p_temp[fix_listitem][p_listitem][2] = playerid;

                new string[144];
                f(string, "%s предлагает Вам арендовать комнату в его доме с оплатой %d$/день", get_name(playerid), h_info[h][h_r_price][r_id]);
                ShowPlayerDialog(fix_listitem, D_HOUSE_RENT_BUY, DIALOG_STYLE_MSGBOX, ""I"Аренда комнаты", string, "Арендовать", "Отмена");
                return 1;
            }
            else {
                new targetid = GetPlayerUserID(h_info[h][h_r_user_id][r_id]);
                if(targetid != INVALID_PLAYER_ID){
                    SendInfo(targetid, "%s выселил Вас из дома.", get_name(playerid));
                    SendAccess(playerid, "Вы выселили %s из дома.", get_name(targetid));
                }
                else SendAccess(playerid, "Вы выселили подселенного из дома.");
                house_rent_leave(h, r_id);
            }
            save_house(h);
            return 1;
        }
        case D_HOUSE_UPGRADE_LIST:
        {
            if(!response) return menu_house_settings(playerid);
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return SendError(playerid, "У Вас нет дома.");
            if(!IsPlayerInRangeOfPoint(playerid, 25.0, h_info[h][h_enter][0], h_info[h][h_enter][1], h_info[h][h_enter][2]) && h+50 != GetPlayerVirtualWorld(playerid))
                return SendError(playerid, "Вы слишком далеко от дома.");
            new h_class = h_info[h][h_squar]-1;
            new int_id = h_info[h][h_int];
            STRING_GLOBAL[0] = EOS;
            if(0 <= listitem <= MAX_HOUSE_UPGRADE-1)
            {
                if(listitem == 2 && h_info[h][h_int] != 4) return menu_house_settings(playerid), SendError(playerid, "Приобрести улучшение \"Подвал\" можно только в домах с элитным интерьером, приобретите его.");
                if(listitem == 3 && h_info[h][h_int] != 4) return menu_house_settings(playerid), SendError(playerid, "Приобрести улучшение \"Подпольное помещение\" можно только в домах с элитным интерьером, приобретите его.");

                if(h_info[h][h_improve][listitem] == 1) return menu_house_settings(playerid), SendError(playerid, "В доме уже есть это улучшение.");

                new name_improve[][] = {"Субсидия", "Подселение", "Подвал", "Подпольное помещение"},
                    price_improve[] = {1000000, 150000, 500000, 500000};
                new price = price_improve[listitem];
                if(listitem == 2 || listitem == 3) price = price * h_info[h][h_squar];
                f(STRING_GLOBAL, ""W"Вы хотите приобрести улучшение "I"'%s' "W"за "I"%d$,"W" вы уверены?", name_improve[listitem], price);
                p_temp[playerid][p_listitem_int] = listitem;
                ShowPlayerDialog(playerid, D_HOUSE_UPGRADE_BUY, DIALOG_STYLE_MSGBOX, ""I"Покупка улучшения", STRING_GLOBAL, "Купить", "Отмена");
            }
            if(listitem == MAX_HOUSE_UPGRADE) {
                if(!IsPlayerInRangeOfPoint(playerid, 50.0, h_ints[h_class][int_id][i_spawn_pos][0],h_ints[h_class][int_id][i_spawn_pos][1],h_ints[h_class][int_id][i_spawn_pos][2]) || h+50 != GetPlayerVirtualWorld(playerid))
                        return SendError(playerid, "Вы слишком далеко от дома.");
                f(STRING_GLOBAL, ""I"[1]"W" Стандарт\t\t"E"Бесплатно\n\
                "I"[2]"W" Начальный\t\t"E"%d$\n\
                "I"[3]"W" Средний\t\t"E"%d$\n\
                "I"[4]"W" Премиум\t\t"E"%d$\n\
                "I"[5]"W" Элитный\t\t"E"%d$", h_info[h][h_squar]*interior_price[1], h_info[h][h_squar]*interior_price[2], h_info[h][h_squar]*interior_price[3], h_info[h][h_squar]*interior_price[4]);
                ShowPlayerDialog(playerid, D_HOUSE_CHANGE_INT, DIALOG_STYLE_LIST, ""I"Смена интерьера", STRING_GLOBAL, "Купить", "Отмена");
            }
            if(listitem == MAX_HOUSE_UPGRADE+1) {
                if(h_ints[h_class][int_id][i_int] != HOUSE_INT_ID_REPAIR)
                {
                    SendError(playerid, "Нужен "I"Элитный "W"интерьер в доме.");
                    return menu_house_settings(playerid);
                }
                if(!IsPlayerInRangeOfPoint(playerid, 50.0, h_ints[h_class][int_id][i_spawn_pos][0],h_ints[h_class][int_id][i_spawn_pos][1],h_ints[h_class][int_id][i_spawn_pos][2]) || h+50 != GetPlayerVirtualWorld(playerid))
                        return SendError(playerid, "Вы слишком далеко от дома.");
                STRING_GLOBAL[0] = EOS;
                switch(h_info[h][h_squar])
                {
                    case 1:
                    {
                        for(new i, j = sizeof(house_repair_name1); i < j; i++)
                            f(STRING_GLOBAL, "%s"I"[%d]"W" %s\n", STRING_GLOBAL, i+1, house_repair_name1[i]);
                    }
                    case 2:
                    {
                        for(new i, j = sizeof(house_repair_name2); i < j; i++)
                            f(STRING_GLOBAL, "%s"I"[%d]"W" %s\n", STRING_GLOBAL, i+1, house_repair_name2[i]);
                    }
                    case 3:
                    {
                        for(new i, j = sizeof(house_repair_name3); i < j; i++)
                            f(STRING_GLOBAL, "%s"I"[%d]"W" %s\n", STRING_GLOBAL, i+1, house_repair_name3[i]);
                    }
                    case 4:
                    {
                        for(new i, j = sizeof(house_repair_name4); i < j; i++)
                            f(STRING_GLOBAL, "%s"I"[%d]"W" %s\n", STRING_GLOBAL, i+1, house_repair_name4[i]);
                    }
                }
                ShowPlayerDialog(playerid, D_HOUSE_REPAIR_LIST, DIALOG_STYLE_LIST, ""I"Ремонт в доме", STRING_GLOBAL, "Выбрать", "Отмена");
            }
            if(listitem == MAX_HOUSE_UPGRADE+2)
            {
                if(h_info[h][h_squar] == 1) return SendError(playerid, "В Вашем доме нет гаража.");
                h_class--;
                if(!IsPlayerInRangeOfPoint(playerid, 50.0, g_info[h_class][g_pX],g_info[h_class][g_pY],g_info[h_class][g_pZ]) || h+50 != GetPlayerVirtualWorld(playerid))
                    return SendError(playerid, "Вы слишком далеко от гаража.");
                ShowPlayerDialog(playerid, D_GARAGE_REPAIR_LIST, DIALOG_STYLE_LIST, ""I"Ремонт в гараже", ""I"[1]"W" Пол\n"I"[2]"W" Стена\n"I"[3]"W" Потолок", "Выбрать", "Отмена");
            }
            return 1;
        }
        case D_GARAGE_REPAIR_LIST:
        {
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return SendError(playerid, "У Вас нет дома.");
            new h_class = h_info[h][h_squar]-2;
            if(!IsPlayerInRangeOfPoint(playerid, 50.0, g_info[h_class][g_pX],g_info[h_class][g_pY],g_info[h_class][g_pZ]) || h+50 != GetPlayerVirtualWorld(playerid))
                return SendError(playerid, "Вы слишком далеко от гаража.");
            if(!response) return menu_house_settings(playerid);

            p_temp[playerid][h_repair_list] = GARAGE_REPAIR_ID;
            p_temp[playerid][h_repair_txtid] = listitem;
            SendInfo(playerid, "Под ремонт выбрано: %s", listitem == G_FOOR ? "Пол" : listitem == G_WALL ?  "Стена" : "Потолок");
            SendInfo(playerid, "У Вас есть 3 минуты, если ничего не купите - ремонт будет отменен.");

            p_temp[playerid][shop_id] = 0;
            new txd_id = p_temp[playerid][h_repair_txtid];
            p_temp[playerid][h_repair_old] = h_info[h][h_garage_id][txd_id];
            h_info[h][h_garage_id][txd_id] = p_temp[playerid][shop_id];
            Garage_Repair(h);

            //SendInfo(playerid, "Далее: /next | Назад: /back | Приобрести: /buy | Отмена: /cancelbuy");

            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL,"%d$", h_info[h][h_squar]*TEXTURE_HOUSE_PRICE);
            ShowTextDrawForPlayer(playerid, TD_ID_SHOP);
            PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], STRING_GLOBAL);

            h_info[h][h_mapping_timer] = SetTimerEx("OnHouseMappingBack", HOUSE_MAPPING_TIME, false, "ddddd", playerid, h, p_temp[playerid][h_repair_txtid], p_temp[playerid][h_repair_old], -1);
            return 1;
        }
        case D_HOUSE_REPAIR_LIST:
        {
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return SendError(playerid, "У Вас нет дома.");
            new h_class = h_info[h][h_squar]-1;
            new int_id = h_info[h][h_int];
            if(!IsPlayerInRangeOfPoint(playerid, 50.0, h_ints[h_class][int_id][i_spawn_pos][0],h_ints[h_class][int_id][i_spawn_pos][1],h_ints[h_class][int_id][i_spawn_pos][2]) || h+50 != GetPlayerVirtualWorld(playerid))
                    return SendError(playerid, "Вы слишком далеко от дома.");
            if(!response) return menu_house_settings(playerid);

            p_temp[playerid][h_repair_list] = listitem;
            p_temp[playerid][h_repair_txtid] = house_idx_repair[h_info[h][h_squar]-1][listitem];
            SendInfo(playerid, "Под ремонт выбрано: %s", h_info[h][h_squar] == 1 ? house_repair_name1[listitem] : h_info[h][h_squar] == 2 ? house_repair_name2[listitem] : h_info[h][h_squar] == 3 ? house_repair_name3[listitem] : house_repair_name4[listitem]);
            SendInfo(playerid, "У Вас есть 3 минуты, если ничего не купите - ремонт будет отменен.");

            p_temp[playerid][shop_id] = 0;
            new txd_id = p_temp[playerid][h_repair_txtid];
            p_temp[playerid][h_repair_old] = h_info[h][h_mapping_id][txd_id];
            h_info[h][h_mapping_id][txd_id] = p_temp[playerid][shop_id];
            House_Repair(h);

            //SendInfo(playerid, "Далее: /next | Назад: /back | Приобрести: /buy | Отмена: /cancelbuy");

            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL,"%d$", h_info[h][h_squar]*TEXTURE_HOUSE_PRICE);
            ShowTextDrawForPlayer(playerid, TD_ID_SHOP);
            PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], STRING_GLOBAL);

            h_info[h][h_mapping_timer] = SetTimerEx("OnHouseMappingBack", HOUSE_MAPPING_TIME, false, "ddddd", playerid, h, p_temp[playerid][h_repair_txtid], p_temp[playerid][h_repair_old], -1);
            return 1;
        }
        case D_HOUSE_CHANGE_INT:
        {
            if(!response) return menu_house_settings(playerid);
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return 1;
            if(h_info[h][h_int] == listitem) return SendError(playerid, "В доме уже есть этот интерьер.");
            p_temp[playerid][h_buy_int] = listitem;

            if(h_ints[h_info[h][h_squar]-1][listitem][i_int] == HOUSE_INT_ID_REPAIR) House_Repair(h);

            new h_class = h_info[h][h_squar]-1;
            SetPlayerInterior(playerid,h_ints[h_class][listitem][i_int]);
            SetPlayerPos(playerid, h_ints[h_class][listitem][i_spawn_pos][0], h_ints[h_class][listitem][i_spawn_pos][1], h_ints[h_class][listitem][i_spawn_pos][2]+0.3);
            Fix_TogglePlayerControllable(playerid, 0);
            p_temp[playerid][UnFreezeFix] = 1;
            p_temp[playerid][UnFreezeTimerFix] = timestamp + 2;
            SetPlayerVirtualWorld(playerid, h+50);
            SendInfo(playerid, "Стоимость интерьера: %d$.", interior_price[listitem]*h_info[h][h_squar]);
            SendInfo(playerid, "Приобрести интерьер или отменить приобретение: /hint");
            return 1;
        }
        case D_HOUSE_CHANGE_INT_BUY:
        {
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return 1;
            new h_class = h_info[h][h_squar]-1;
            new int_id = p_temp[playerid][h_buy_int];
            
            if(!response) {
                new hint_id = h_info[h][h_int];
                SetPlayerHousePos(playerid, h, h_class, hint_id);
            }
            else
            {
                if(int_id == -1) return 1;
                if(p_info[playerid][cash] < interior_price[int_id]*h_info[h][h_squar]) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                p_temp[playerid][h_buy_int] = -1;
                if(h_ints[h_info[h][h_squar]-1][h_info[h][h_int]][i_int] == HOUSE_INT_ID_REPAIR)
                    save_house_interior(h); //обнуление всего при смене инты
                h_info[h][h_int] = int_id;
                update_house(h);
                SetPlayerInterior(playerid,h_ints[h_class][int_id][i_int]);
                SetPlayerPos(playerid, h_ints[h_class][int_id][i_spawn_pos][0], h_ints[h_class][int_id][i_spawn_pos][1], h_ints[h_class][int_id][i_spawn_pos][2]);
                SetPlayerVirtualWorld(playerid, h+50);
                SendAccess(playerid, "Вы изменили интерьер.");

                //if(h_ints[h_class][int_id][i_int] == HOUSE_INT_ID_REPAIR) save_interior(h);
                save_house(h);
                if(int_id != 0) SetPlayerMoney(playerid, -interior_price[int_id]*h_info[h][h_squar], true, "дом: смена интерьера на %d", int_id);
            }
            return 1;
        }
        case D_HOUSE_UPGRADE_BUY:
        {
            if(!response) return menu_house_settings(playerid);
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return 1;
            new fix_listitem = p_temp[playerid][p_listitem_int],
                price_improve[] = {1000000, 150000, 500000, 500000},
                price = price_improve[fix_listitem];
            if(fix_listitem == 2 || fix_listitem == 3) price = price * h_info[h][h_squar];
            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            if(h_info[h][h_improve][fix_listitem] == 1) return 1;
            h_info[h][h_improve][fix_listitem] = 1;
            update_house(h);
            save_house(h);
            static const name_improve[][] = {"Субсидия", "Подселения", "Подвал", "Подпольное помещение"};
            SendAccess(playerid, "Вы приобрели улучшение \"%s\" за %d$.", name_improve[fix_listitem], price);
            SetPlayerMoney(playerid, -price, true, "дом: покупка улучшения %s для (%d)[%d]", name_improve[fix_listitem], h, h_info[h][h_mysql_id]);
            return 1;
        }
        case D_HOUSE_SELL_GOS:
        {
            if(!response) return 1;
            new house_id = GetPlayerHouseID(playerid);
            if(house_id == INVALID_HOUSE_ID) return 1;
            if(listitem == 0)
            {
                if(h_info[house_id][h_user_id] != p_info[playerid][ID]) return 1;
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы продали дом за %d$.", h_info[house_id][h_value]/2);
                SendAccess(playerid, STRING_GLOBAL);
                OnServerInfoForMoney[3] += h_info[house_id][h_value]/2;

                if(GetPlayerVirtualWorld(playerid) == house_id+50) {
                    SetPlayerPos(playerid,h_info[house_id][h_enter][0],h_info[house_id][h_enter][1],h_info[house_id][h_enter][2]);
                    SetPlayerInterior(playerid,0);
                    SetPlayerVirtualWorld(playerid, 0);
                }

                new targetid;
                for(new i; i <= h_info[house_id][h_squar]; i++)
                {
                    if(h_info[house_id][h_r_user_id][i] != INVALID_MYSQL_ID)
                    {
                        targetid = GetPlayerUserID(h_info[house_id][h_r_user_id][i]);
                        house_rent_leave(house_id, i);
                        if(targetid != INVALID_PLAYER_ID) SendInfo(targetid, "Владелец дома продал его.");
                    }
                }

                new family_idx = GetFamilyIDFromHouseID(house_id);
                if(family_idx != -1)
                {
                    DeleteFamilyVehicle(family_idx);

                    FamilyData[family_idx][fHouseID] = INVALID_HOUSE_ID;
                    h_info[house_id][h_family_id] = -1;

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `family` SET `house_id` = -1 WHERE `id` = %d", FamilyData[family_idx][fMysqlID]);
                    mysql_tquery (con_bd, STRING_GLOBAL);
                    update_house(house_id);

                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s[%d] продал семейный дом.", get_name(playerid), playerid);
                    SendFamilyMessage(family_idx, STRING_GLOBAL);
                }
                p_info[playerid][spawn] = SPAWN_DEFAULT;

                ClearOwnerHouse(playerid, house_id);

                //set default house new
                h_info[house_id][h_int] =
                h_info[house_id][h_improve][SUBSIDY] =
                h_info[house_id][h_improve][RENTERS] =
                h_info[house_id][h_improve][BASEMENT] =
                h_info[house_id][h_improve][UNDERGROUND] = 0;
                h_info[house_id][h_family_id] = -1;
                save_house_interior(house_id); // обнуление кастомный инты
                save_garage_interior(house_id);

                ClearInventoryItems(h_info[house_id][h_mysql_id], INVENTORY_OWNER_TYPE_HOUSE);

                h_info[house_id][h_lock] = 1;
                h_info[house_id][h_user_id] = INVALID_MYSQL_ID;

                for(new i = 0; i < 28; i++) h_info[house_id][h_garden_items][i] = 0;
                h_info[house_id][h_panel_items] = 0;
                for(new i = 1; i <= totalgarden; i++)
                {
                    if(GardenInfo[i][gHouseIDx] != house_id) continue;
                    DestroyGarden(i);
                }
                for(new i = 1; i <= totalpanel; i++)
                {
                    if(PanelHouseInfo[i][PanelHouseIDx] != house_id) continue;
                    DestroyPanel(i);
                }
                for(new i = 1; i <= totalvideocards; i++)
                {
                    if(VideoCardsInfo[i][vcHouseIDx] != house_id) continue;
                    DestroyVideoCards(i);
                }
                for(new i = 1; i <= totalundergroundbots; i++)
                {
                    if(UndergroundBotsInfo[i][ubHouseIDx] != house_id) continue;
                    DestroyUndergroundBots(i);
                }
                SetPlayerMoney(playerid, h_info[house_id][h_value]/2, true, "продал дом государству");

                // [logs] реализовать получение версии клиента
                // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) продал дом (%d)[%d] государству за %d$
                Log(LOG_player, INFO, "%s[%d](%s %s) продал в гос дом (%d)[%d] за %d$",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    house_id, h_info[house_id][h_mysql_id], h_info[house_id][h_value]/2);

                update_house(house_id);
                save_house(house_id);
            }
            else if(listitem == 1)
            {
                STRING_GLOBAL[0] = EOS;
                f(STRING_GLOBAL, ""W"Вы собираетесь выставить на аукцион дом?\n\nВведите цену от половины гос. стоимости до полной (ГОС: %d)", h_info[house_id][h_value]);
                ShowPlayerDialog(playerid,D_HOUSE_SELL_AUCTION,DIALOG_STYLE_INPUT, ""I"Выставить на аукцион",STRING_GLOBAL,"Ввести","Отмена");
            }
            else callcmd::sellinfo(playerid, "/0");
            return true;
        }
        case D_HOUSE_SELL_AUCTION:
        {
            if(!response) return 1;
            new fix_listitem;
            new h = GetPlayerHouseID(playerid);
            if(h == INVALID_HOUSE_ID) return 1;
            if(sscanf(inputtext, "i", fix_listitem))
            {
                ShowPlayerDialog(playerid,D_HOUSE_SELL_GOS,DIALOG_STYLE_LIST, ""I"Продажа имущества",""I"[1]"W" Государству за 50 процентов гос. стоимости\n"I"[2]"W" Выставить на аукцион","Выбор","Отмена");
                return 1;
            }
            if(!(h_info[h][h_value]/2 <= fix_listitem <= h_info[h][h_value]))
            {
                ShowPlayerDialog(playerid,D_HOUSE_SELL_GOS,DIALOG_STYLE_LIST, ""I"Продажа имущества",""I"[1]"W" Государству за 50 процентов гос. стоимости\n"I"[2]"W" Выставить на аукцион","Выбор","Отмена");
                return 1;
            }
            h_info[h][h_auction_bet] = fix_listitem;
            h_info[h][h_auction_time] = 0;
            h_info[h][h_auction_user_id] = INVALID_MYSQL_ID;
            save_house(h);
            SendAccess(playerid, "Вы выставили свой дом на аукцион за %d$.", fix_listitem);
            return 1;
        }
        case D_AREND_SCOOTER:
        {
            if(!response) return 1;
            if(p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID)
                return SendError(playerid, "У Вас уже есть арендованное транспортное средство. Найти его можно с помощью команды /afindcar");

            new price_arend = p_info[playerid][level] <= 3 ? 0 : 5000;

            if(p_info[playerid][cash] < price_arend)
                return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            new car_id, biz_id;

            if(IsPlayerInRangeOfPoint(playerid,30.0, 1161.6251,-1748.6222,13.5784))
                car_id = CreateVehicleVEx(NPO_TEMPCAR, NPO_NONE, 462, 1161.7330+random(1), -1748.4937+random(1), 13.1597, 358.7218, 1, 1, 120), biz_id = 116;
            if(IsPlayerInRangeOfPoint(playerid,30.0, 1267.9250,-1349.6674,13.5016))
                car_id = CreateVehicleVEx(NPO_TEMPCAR, NPO_NONE, 462, 1267.8646+random(1), -1349.7939+random(1), 13.0821, 88.8614, 1, 1, 120), biz_id = 116;
            if(IsPlayerInRangeOfPoint(playerid,30.0, -2094.0205,-133.8331,35.7192))
                car_id = CreateVehicleVEx(NPO_TEMPCAR, NPO_NONE, 462, -2092.9221+random(1), -133.7925+random(1), 35.3004, 268.4856, 1, 1, 120), biz_id = 117;
            if(IsPlayerInRangeOfPoint(playerid,30.0, 2435.5652,-2580.9927,13.6804))
                car_id = CreateVehicleVEx(NPO_TEMPCAR, NPO_NONE, 462, 2435.8479+random(1), -2580.9783+random(1), 13.2611, 269.4534, 1, 1, 120), biz_id = 116;
            if(IsPlayerInRangeOfPoint(playerid,30.0, 2412.8127,-2231.5952,13.5469))
                car_id = CreateVehicleVEx(NPO_TEMPCAR, NPO_NONE, 462, 2414.5110+random(1), -2233.4939+random(1), 13.1285, 220.4120, 1, 1, 120), biz_id = 116;
            if(IsPlayerInRangeOfPoint(playerid,30.0, 1053.4656,1060.7467,10.2240))
                car_id = CreateVehicleVEx(NPO_TEMPCAR, NPO_NONE, 462, 1053.8865+random(1), 1059.7244+random(1), 9.8064, 204.5107, 1, 1, 120), biz_id = 118;
            if(IsPlayerInRangeOfPoint(playerid,30.0, 1771.8362,-1902.9224,13.5642))
                car_id = CreateVehicleVEx(NPO_TEMPCAR, NPO_NONE, 462, 1772.0339+random(1), -1902.8624+random(1), 13.1447, 269.5223, 1, 1, 120), biz_id = 116;
            if(IsPlayerInRangeOfPoint(playerid,30.0, -387.8100,-1460.7252,25.7266))
                car_id = CreateVehicleVEx(NPO_TEMPCAR, NPO_NONE, 462, -387.9018+random(1), -1459.4459+random(1), 25.3081, 1.3075, 1, 1, 120), biz_id = 116;
            if(IsPlayerInRangeOfPoint(playerid,30.0, 1187.7388,-1315.5814,13.5648))
                car_id = CreateVehicleVEx(NPO_TEMPCAR, NPO_NONE, 462, 1187.7388+random(1), -1315.5814+random(1), 13.5, 270.0, 1, 1, 120), biz_id = 116;

            if(price_arend > 0 && b_info[biz_id][_prod] >= price_arend / 100)
            {
                b_info[biz_id][_prod] -= price_arend / 100;
                b_info[biz_id][_bank] += (price_arend / 100) * 90;
                AddMafiaBank(biz_id, price_arend/10);

                biz_finka[biz_id] += (price_arend / 100) * 90;
                UpdateIntForFinanceBiz(biz_id, (price_arend / 100) * 90);
            }

            veh_info[car_id][v_lock] = 1;
            veh_info[car_id][v_color] = 1;
            veh_info[car_id][v_model] = 462;
            veh_info[car_id][v_fuel] = GetVehicleData(GetVehicleModelEx(car_id), E_VD_MAX_FUEL);
            for(new i; i < 5; i++) veh_info[car_id][v_details][i] = 100.0;
            format(veh_info[car_id][v_number], 16, "NULL");
            veh_info[car_id][v_int] =
            veh_info[car_id][v_virt] =
            veh_info[car_id][v_insurance] =
            veh_info[car_id][v_insurance_time] = 0;
            veh_info[car_id][v_rented_ID] = p_info[playerid][ID];
            veh_info[car_id][v_used_key_ID] = playerid;

            p_temp[playerid][rented_veh] = car_id;
            PutPlayerInVehicle(playerid, car_id, 0);

            veh_info[car_id][v_engine] = 1;
            OnPlayerUpdateVehicleInfo(playerid, SPEEDO_ENGINE);
            PlayerPlaySound(playerid, 31810, 0.0, 0.0, 0.0);

            MeAction(playerid, "завел(-а) двигатель");
            SetVehicleParamsVEx(car_id, veh_info[car_id][v_engine], veh_info[car_id][v_light], alarm, veh_info[car_id][v_lock], bonnet, boot, objective);

            OnServerInfoForMoney[18] += price_arend;
            SetPlayerMoney(playerid, -price_arend, true, "т/с: аренда <%s>(%d)", GetVehicleName(car_id), GetVehicleModelEx(car_id));

            SendMes(playerid, COLOR_LGREEN, "Вы арендовали транспортное средство {"#cLEMON"}\"%s\"{"#cGREEN"} за {"#cLEMON"}%d$.", GetVehicleName(car_id), price_arend);
            SendMes(playerid, COLOR_BLUE, "Для отмены аренды транспортного средства: "W"/unrent");
            SendMes(playerid, COLOR_LIME, "Команды транспортных средств: {"#cLYELLOW"}/mm > [5] Команды сервера > [3] Команды транспорта");

            SetFractionWarehouse(MAYOR_LS, fwMoney, price_arend);

            if(p_info[playerid][level] >= 1 && p_info[playerid][level] <= 3) callcmd::gps(playerid, "/0");
            return 1;
        }
        case D_AVTOSALON_BUY:
        {
            if(!response) return RemovePlayerFromVehicle(playerid);

            new vehicleid = p_temp[playerid][veh_id_buy];
            if(p_temp[playerid][veh_id_buy] == INVALID_VEHICLE_ID) return 1;

            if(vehicleid != GetPlayerVehicleID(playerid)) return 1;
            new fix_listitem = 1,
                vehicle_model = GetVehicleModelEx(vehicleid),
                car_price = GetVehicleData(vehicle_model, E_VD_PRICE),
                color = random(127),
                car_id, 
                custom_id = -1,
                vehicle_class = GetVehicleData(vehicle_model, E_VD_CLASS);

            if(car_price < 1000) return SendError(playerid, "Не известная ошибка 05.02");
            if(GetVehicleModelEx(vehicleid) == 508 && GetPlayerCheckTreiler(p_info[playerid][ID]))
            {
                RemovePlayerFromVehicle(playerid);
                return SendError(playerid, "У Вас уже есть трейлер.");
            }

            if(vehicle_class == VEHICLE_CLASS_REAL_CARS)
            {
                if(sscanf(inputtext, "i", fix_listitem))
                {
                    RemovePlayerFromVehicle(playerid);
                    return SendError(playerid, "Вводить нужно только цифру пункта.");
                }
                if(!(1 <= fix_listitem <= 2))
                {
                    RemovePlayerFromVehicle(playerid);
                    return SendError(playerid, "Вводить нужно только цифру пункта.");
                }
                custom_id = GetSlotVehicleModelSync(vehicle_model);
                if(custom_id == -1)
                {
                    SendError(playerid, "Произошла неизвестная ошибка: RC3007_2");
                    RemovePlayerFromVehicle(playerid);
                    return 1;
                }
            }

            new npo_type = fix_listitem != 1 ? NPO_TEMPCAR : NPO_PLAYERCAR,
                time_spawn = fix_listitem != 1 ? 120 : -1;

            if(fix_listitem == 1)
            {
                new rows = GetPlayerCountCars(p_info[playerid][ID], GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE)),
                count_limit = GetPlayerLimiteCars(playerid, GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE));
                if(rows >= count_limit)
                {
                    SendError(playerid, "У Вас превышен лимит на данный класс транспортного средства.");
                    RemovePlayerFromVehicle(playerid);
                    return 1;
                }

                if(GetFreeSlotVehicle(playerid) == ALL_BUSY_SLOT_VEHICLE)
                {
                    SendError(playerid, "У Вас уже есть загруженные транспортные средства.");
                    SendInfo(playerid, "Используйте /cars чтобы выгрузить их из сервера.");
                    RemovePlayerFromVehicle(playerid);
                    return 1;
                }
                if(vehicle_class == VEHICLE_CLASS_REAL_CARS)
                {
                    if(custom_id == -1) return SendError(playerid, "Не известная ошибка: RC0709");
                    car_price = customVehModels[custom_id][ModelPrice];
                    if(p_info[playerid][flinmoney] < car_price)
                    {
                        SendError(playerid, "У Вас нет столько Pinecrest Money.");
                        RemovePlayerFromVehicle(playerid);
                        return 1;
                    }
                }
                else
                {
                    new list_percent[3] = {95, 90, 85}, vip_idx = p_info[playerid][p_vip];
                    if(vip_idx) car_price = ((car_price / 100) * list_percent[vip_idx - 1]);

                    if(p_info[playerid][cash] < car_price)
                    {
                        SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                        RemovePlayerFromVehicle(playerid);
                        return 1;
                    }
                }
            }

            if(fix_listitem != 1 && DriveAuto[playerid] != INVALID_VEHICLE_ID) return SendError(playerid, "У Вас уже есть транспортное средство в тест-драйве.");

            if(IsPlayerInRangeOfPoint(playerid, 100.0, 1637.8898,-1150.9169,23.906)) // Nope;
            {
                switch(random(3))
                {
                    case 0: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, 1649.6107, -1111.6072, 23.9033, 90.0000, color, color, time_spawn);
                    case 1: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, 1649.6107, -1107.0872, 23.9033, 90.0000, color, color, time_spawn);
                    default: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, 1649.6107, -1102.6273, 23.9033, 90.0000, color, color, time_spawn);
                }
            }
            else if(IsPlayerInRangeOfPoint(playerid, 100.0, -2696.6658,-45.4692,4.3359)) // C;
            {
                switch(random(3))
                {
                    case 0: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, -2693.2366, -54.9057, 4.3258, 0.0000, color, color, time_spawn);
                    case 1: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, -2689.9165, -54.9057, 4.3258, 0.0000, color, color, time_spawn);
                    default: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, -2686.5967, -54.9057, 4.3258, 0.0000, color, color, time_spawn);
                }
            }
            else if(IsPlayerInRangeOfPoint(playerid, 100.0, -1992.3157,288.1158,33.9196)) // B;
            {
                switch(random(3))
                {
                    case 0: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, -1970.8719, 289.0405, 35.1809, 90.0000, color, color, time_spawn);
                    case 1: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, -1970.8719, 285.0405, 35.1809, 90.0000, color, color, time_spawn);
                    default: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, -1970.8719, 281.0405, 35.1809, 90.0000, color, color, time_spawn);
                }
            }
            else if(IsPlayerInRangeOfPoint(playerid, 100.0, 2160.7366,1839.2948,10.8203)) // A;
            {
                switch(random(3))
                {
                    case 0: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, 2199.1262, 1799.8813, 10.7968, 180.0000, color, color, time_spawn);
                    case 1: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, 2195.1663, 1799.8813, 10.7968, 180.0000, color, color, time_spawn);
                    default: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, 2191.2063, 1799.8813, 10.7968, 180.0000, color, color, time_spawn);
                }
            }
            else if(IsPlayerInRangeOfPoint(playerid, 100.0, 2125.7097,-1121.6216,25.3574)) // Moto;
            {
                switch(random(3))
                {
                    case 0: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, 2122.1223, -1158.9741, 23.6583, 0.0000, color, color, time_spawn);
                    case 1: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, 2119.4424, -1158.9741, 23.7383, 0.0000, color, color, time_spawn);
                    default: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, 2116.8423, -1158.9741, 23.9183, 0.0000, color, color, time_spawn);
                }
            }
            else if(IsPlayerInRangeOfPoint(playerid, 500.0, 396.4527,2531.9768,16.5439)) // Plane;
            {
                car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, 421.7898, 2502.5959, 17.4996, 90.0000, color, color, time_spawn);
            }
            else if(IsPlayerInRangeOfPoint(playerid, 250.0, 154.4826,-1794.5555,3.8627)) // Boats;
            {
                car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, 185.1971, -1951.7487, 0.7428, -90.0000, color, color, time_spawn);
            }
            else if(IsPlayerInRangeOfPoint(playerid, 100.0, 1306.9766,-50.4123,2002.4978)) // Real Cars;
            {
                switch(random(3))
                {
                    case 0: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, 2139.1721, 1427.0000, 10.9000, 360.0000, color, color, time_spawn);
                    case 1: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, 2135.8206, 1427.0000, 10.9000, 360.0000, color, color, time_spawn);
                    default: car_id = CreateVehicleVEx(npo_type, NPO_NONE, vehicle_model, 2130.2495, 1427.0000, 10.9000, 360.0000, color, color, time_spawn);
                }
            }
            else
            {
                SendError(playerid, "Вы должны находиться на территории какого-либо автосалона.");
                RemovePlayerFromVehicle(playerid);
                return 1;
            }

            if(fix_listitem != 1)
            {
                GangZoneShowForPlayer(playerid, Zone_Drive, 0xF5DEB3AA);

                ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Тест-драйв", ""W"\
                    На GPS навигаторе обозначено место для проведения тест-драйва.\n\n\
                    Вам запрещено выезжать за пределы данной зоны, время проведения тест-драйва — 3 минуты.\n\n\
                    Машина ждёт Вас у входа в автосалон.", "Закрыть", "");

                DriveTime[playerid] = 180;
                DriveAuto[playerid] = car_id;

                veh_info[car_id][v_used_key_ID] = playerid;
                veh_info[car_id][v_rented_ID] = p_info[playerid][ID];

                SetVehicleParamsVEx(car_id, true, true, alarm, false, bonnet, boot, objective);
                return 1;
            }

            if(vehicle_class == VEHICLE_CLASS_REAL_CARS)
            {
                if(custom_id == -1) return SendError(playerid, "Не известная ошибка: RC0709");
                p_info[playerid][flinmoney] -= car_price;
                MysqlUpdatePlayerInt(playerid, "flinmoney", p_info[playerid][flinmoney]);
                SendAccess(playerid, "Вы приобрели транспортное средство \"%s\" за %d Pinecrest Money.", GetVehicleName(INVALID_VEHICLE_ID, vehicle_model), car_price);
                Log(LOG_player, INFO, "%s[%d](%s %s) приобретение Real Cars <%s>(%d) за %d FM | #Donate",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    customVehModels[custom_id][ModelName], customVehModels[custom_id][CustomID], car_price);
            }
            else
            {
                new i = veh_info[vehicleid][v_car_shop_idx];

                if(CarShopInfo[i][csVehicleModel] == 0)
                {
                    SendError(playerid, "На складе автосалона нет данного транспортного средства.");
                    RemovePlayerFromVehicle(playerid);
                    return 1;
                }

                new biz_id = CarShopInfo[i][csBizIDx];

                if(biz_id != -1 && biz_id != -2)
                {
                    new price;
                    switch(GetVehicleData(vehicle_model, E_VD_CLASS))
                    {
                        case VEHICLE_CLASS_NOPE: price = (car_price / 100) * 75; // Цены от 50000$ до 100000$. | Мин. прибыль 37500$. Макс прибыль: 75000$. /
                        case VEHICLE_CLASS_C: price = (car_price / 100) * 50; // Цены от 200000$ до 500000$. | Мин. прибыль 100000$. Макс прибыль: 250000$. /
                        case VEHICLE_CLASS_B: price = (car_price / 100) * 35; // Цены от 1000000$ до 2000000$. | Мин. прибыль 350000$. Макс прибыль: 700000$. /
                        case VEHICLE_CLASS_A: price = (car_price / 100) * 25; // Цены от 3000000$ до 5000000$. | Мин. прибыль 750000$. Макс прибыль: 1250000$. /
                    }

                    if(b_info[biz_id][_prod] >= price / 100)
                    {
                        b_info[biz_id][_prod] -= price / 100;
                        b_info[biz_id][_bank] += (price / 100) * 90;
                        AddMafiaBank(biz_id, price/10);

                        biz_finka[biz_id] += (price / 100) * 90;
                        UpdateIntForFinanceBiz(biz_id, (price / 100) * 90);
                    }
                }

                DestroyCarShopVehicle(i);

                OnServerInfoForMoney[2] += car_price;
                SetPlayerMoney(playerid, -car_price, true, "т/с: покупка <%s>(%d)", GetVehicleName(INVALID_VEHICLE_ID, vehicle_model), vehicle_model);
                SendAccess(playerid,  "Вы приобрели транспортное средство \"%s\" за %d$.",  GetVehicleName(INVALID_VEHICLE_ID, vehicle_model), car_price);

                // [logs] реализовать получение версии клиента
                // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) купил <%s>(%d) с госа за %d$
                Log(LOG_player, INFO, "%s[%d](%s %s) купил <%s>(%d) из госа за %d$",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                GetVehicleName(INVALID_VEHICLE_ID, vehicle_model), vehicle_model, car_price);

                SetFractionWarehouse(MAYOR_LS, fwMoney, car_price);
            }

            veh_info[car_id][v_owner_id] = p_info[playerid][ID];

            SendInfo(playerid, "Команды транспортных средств: /mm > Команды > Команды транспорта");
            RemovePlayerFromVehicle(playerid);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `vehicle` \
                (`v_owner_id`, `v_model`, `v_pos_0`, `v_pos_1`, `v_pos_2`, `v_pos_3`, `v_lock`, `v_fuel`, `v_color_0`, `v_color_1`, `v_int`, `v_virt`) VALUES \
                (%d, %d, %f, %f, %f, %f, %d, %f, %d, %d, %d, %d)",
                veh_info[car_id][v_owner_id], veh_info[car_id][v_model], veh_info[car_id][v_pos][0], veh_info[car_id][v_pos][1],
                veh_info[car_id][v_pos][2], veh_info[car_id][v_pos][3], veh_info[car_id][v_lock], veh_info[car_id][v_fuel],
                veh_info[car_id][v_color][0], veh_info[car_id][v_color][1], veh_info[car_id][v_int], veh_info[car_id][v_virt]);
            mysql_tquery(con_bd, STRING_GLOBAL, "get_vehicle_id", "ii", playerid, car_id);

            veh_info[car_id][v_int] =
            veh_info[car_id][v_virt] =
            veh_info[car_id][v_insurance] =
            veh_info[car_id][v_insurance_time] =
            veh_info[car_id][v_premium] =
            veh_info[car_id][v_bonus] =
            veh_info[car_id][v_sell_block] = 0;

            CheckPlayerMission(playerid, START_VEHICLE);
            return 1;
        }
        case D_AREND_VEHICLE_LIST:
        {
            if(!response) return DeletePVar(playerid, #AREND_VEH_ID);
            if(!(0 <= listitem <= sizeof(ArendsVehicleIDs)-1)) return DeletePVar(playerid, #AREND_VEH_ID);
            listitem = p_temp[playerid][p_listitem][listitem];
            if(ArendsVehicleIDs[listitem] == 0) 
            {
                DeletePVar(playerid, #AREND_VEH_ID);
                return SendError(playerid, "Не известная ошибка 1705, повторите действие.");
            }
            new biz_id = 116+GetPlayerPositionCity(playerid)-1;
            if(ArendsVehicleUseCount[biz_id-116][listitem] >= ArendsVehicleMaxCount[biz_id-116][listitem])
            {
                DeletePVar(playerid, #AREND_VEH_ID);
                return SendError(playerid, "Свободных доступных Т/С нет.");
            }

            p_temp[playerid][p_listitem_int] = listitem;
            new class = GetVehicleData(ArendsVehicleIDs[listitem], E_VD_CLASS), price = 2500 * (class + 1);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, ""W"Вы желаете арендовать %s?\n\nСтоимость: %d$.", GetVehicleName(INVALID_VEHICLE_ID, ArendsVehicleIDs[listitem]), price);
            ShowPlayerDialog(playerid, D_AREND_VEHICLE, DIALOG_STYLE_MSGBOX, ""I"Аренда транспорта", STRING_GLOBAL, "Да", "Нет");
            return 1;
        }
        case D_AREND_VEHICLE:
        {
            new id = GetPVarInt(playerid, #AREND_VEH_ID)-1;
            if(id == -1) return 1;
            DeletePVar(playerid, #AREND_VEH_ID);
            listitem = p_temp[playerid][p_listitem_int];
            p_temp[playerid][p_listitem_int] = -1;
            if(!(0 <= listitem <= sizeof(ArendsVehicleIDs)-1)) return 1;
            if(!response) return RemovePlayerFromVehicle(playerid);
            if(p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID)
                return SendError(playerid, "У Вас уже есть арендованное транспортное средство. Найти его можно с помощью команды /afindcar");

            if(IsPlayerInAnyVehicle(playerid)) 
                return SendError(playerid, "Вы должны не находиться в транспортном средстве.");

            new biz_id = 116+GetPlayerPositionCity(playerid)-1,
                modelid = ArendsVehicleIDs[listitem],
                class = GetVehicleData(modelid, E_VD_CLASS), price = 2500 * (class + 1);

            if(ArendsVehicleUseCount[biz_id-116][listitem] >= ArendsVehicleMaxCount[biz_id-116][listitem])
            {
                DeletePVar(playerid, #AREND_VEH_ID);
                return SendError(playerid, "Свободных доступных Т/С нет.");
            }

            if(p_info[playerid][cash] < price)
                return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            new vehicleid = CreateVehicleVEx(NPO_ARENDCAR, NPO_NONE, modelid, ArendsVehicleCoords[id][0], ArendsVehicleCoords[id][1], ArendsVehicleCoords[id][2], ArendsVehicleCoords[id][3], -1, -1, 600);
            ArendsVehicleUseCount[biz_id-116][listitem]++;

            LinkVehicleToInterior(vehicleid, 0);
            SetVehicleVirtualWorld(vehicleid, 0);

            PutPlayerInVehicle(playerid, vehicleid, 0);

            veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];
            veh_info[vehicleid][v_used_key_ID] = playerid;
            veh_info[vehicleid][v_rented_city] = biz_id-116;

            p_temp[playerid][rented_veh] = vehicleid;

            veh_info[vehicleid][v_engine] = 1;
            OnPlayerUpdateVehicleInfo(playerid, SPEEDO_ENGINE);
            PlayerPlaySound(playerid, 31810, 0.0, 0.0, 0.0);

            MeAction(playerid, "завел(-а) двигатель");
            SetVehicleParamsVEx(vehicleid, veh_info[vehicleid][v_engine], veh_info[vehicleid][v_light], alarm, veh_info[vehicleid][v_lock], bonnet, boot, objective);

            OnServerInfoForMoney[10] += price;
            SetPlayerMoney(playerid, -price, true, "т/с: аренда <%s>(%d)", GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid));

            if(b_info[biz_id][_prod] >= (price / 100) * 10)
            {
                b_info[biz_id][_prod] -= (price / 100) * 3;
                b_info[biz_id][_bank] += price - ((price / 100) * 10);
                AddMafiaBank(biz_id, (price / 100) * 10);

                biz_finka[biz_id] += price - ((price / 100) * 10);
                UpdateIntForFinanceBiz(biz_id, price - ((price / 100) * 10));
            }

            SendMes(playerid, COLOR_LGREEN, "Вы арендовали транспортное средство {"#cLEMON"}\"%s\"{"#cGREEN"} за {"#cLEMON"}%d$.", GetVehicleName(vehicleid), price);
            SendMes(playerid, COLOR_BLUE, "Для отмены аренды транспортного средства: "W"/unrent");
            SendMes(playerid, COLOR_LIME, "Команды транспортных средств: {"#cLYELLOW"}/mm > [5] Команды сервера > [3] Команды транспорта");
            return 1;
        }
        case D_SELL_CAR_GOS:
        {
            if(!response) return 1;
            new vehicleid = GetPlayerVehicleID(playerid);
            if(vehicleid == INVALID_VEHICLE_ID || !IsPlayerOwnerVehicle(playerid, vehicleid))
                return SendError(playerid, "Нужно находиться за рулем своего Т/С.");
            new price = GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_PRICE)/4;
            if(veh_info[vehicleid][v_bonus] != 0) return SendError(playerid, "Вы не можете продать бонусное транспортное средство.");
            if(veh_info[vehicleid][v_mysql_id] == INVALID_MYSQL_ID) return SendError(playerid, "Обратитесь в тех. поддержку. Код: 8010.");
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `vehicle` WHERE `v_mysql_id` = %d",
                veh_info[vehicleid][v_mysql_id]);
            mysql_tquery(con_bd, STRING_GLOBAL);
            
            if(veh_info[vehicleid][v_sell_block] != 0) price = 0;

            ClearInventoryItems(veh_info[vehicleid][v_mysql_id], INVENTORY_OWNER_TYPE_VEHICLE);

            OnServerInfoForMoney[4] += price;
            SetPlayerMoney(playerid, price, true, "");
            SendAccess(playerid, "Вы продали транспортное средство за %d$.", price);

            Log(LOG_player, INFO, "%s[%d](%s %s) продал <%s>(%d)[%d] в гос за %d$",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                GetVehicleName(vehicleid), GetVehicleModelEx(vehicleid), veh_info[vehicleid][v_mysql_id], price);

            DestroyPlayerVehicle(playerid, vehicleid);
            return 1;
        }
        case 25:
