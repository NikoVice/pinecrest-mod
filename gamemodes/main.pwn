                                    if(!statusUse) return AccessoriesPlayerList(playerid, ACCESSORIES_ID_EDITOR), SendError(playerid, "������ ��������� �� ������������.");
                                    ShowPlayerDialog(playerid, D_EDITOR_LIST, DIALOG_STYLE_LIST, ""I"��������", ""I"[1]"W" ������������ ����������� �������\n"I"[2]"W" ������������� �������", "�����", "������");
                                    SetPVarInt(playerid, "EDITOR:idx", listitem+1);
                                }
                                case ACCESSORIES_ID_REPAIR:
                                {
