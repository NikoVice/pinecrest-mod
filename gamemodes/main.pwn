CMD:getip(playerid, params[])
{
    if(p_info[playerid][admin] < 3 && p_temp[playerid][premiumgamer] != PREMIUM_GAME) return 1;
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "�����������: /getip [id ������]");
    if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return SendError(playerid, "����� �� ������.");
    if(p_info[playerid][admin] < p_info[params[0]][admin]) return 1;
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "�������: %s | ���. IP: %s | ������. IP: %s", get_name(params[0]), p_info[params[0]][regIP], p_temp[params[0]][session_IP]);
    SendInfo(playerid, STRING_GLOBAL);
    return 1;
}

CMD:slap(playerid, params[])
{
    if(p_info[playerid][admin] < 1 && p_info[playerid][youtube_adm] < 2 && p_temp[playerid][premiumgamer] != PREMIUM_GAME)
        return 1;

    if(p_info[playerid][helper] == 1) return SendError(playerid, "������� ���������� ��� ��������.");


    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "�����������: /slap [id ������]");

    if(params[0] == INVALID_PLAYER_ID)
        return SendError(playerid, "����� �� ������.");

    if(p_info[playerid][admin] < p_info[params[0]][admin])
        return 1;

    if(GetPVarInt(params[0],"BoneStol_ID")) return SendError(playerid, "����� �� ������.");

    new
        Float:slx,
        Float:sly,
        Float:slz;

    GetPlayerPos(params[0], slx, sly, slz);
    SetPlayerPos(params[0], slx, sly, slz + 3.0);

    // PlayerPlaySound(params[0], 1130, slx, sly, slz + 5);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] ��������� %s [%d].", get_name(playerid), playerid, get_name(params[0]), params[0]);
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

    SendAccess(playerid, "�� ���������� %s [%d].", get_name(params[0]), params[0]);
    SendInfo(params[0], "������������� %s [%d] ��������� ���.", get_name(playerid), playerid);

    WriteAdminLog(TYPE_LOG_SLAP, playerid, get_name(params[0]), params[0]);
    return 1;
}

CMD:explodeme(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10)
        return 1;

    new
        Float:x,
        Float:y,
        Float:z;

    GetPlayerPos(playerid, x, y, z);
    Fix_TogglePlayerControllable(playerid, 0);

    CreateExplosion(x, y, z, 7, 10.0);
    CreateExplosion(x, y+4.0, z, 7, 10.0);
    CreateExplosion(x, y-4.0, z, 7, 10.0);
    CreateExplosion(x+4.0, y, z, 7, 10.0);
    CreateExplosion(x-4.0, y, z, 7, 10.0);

    Fix_TogglePlayerControllable(playerid, 1);
    return 1;
}

CMD:sethp(playerid, params[])
{
    if(p_info[playerid][admin] < 3 && p_info[playerid][youtube_adm] < 1)
        return 1;

    new target, Float:health_count;
    if(sscanf(params, "uf", target, health_count)) return SendInfo(playerid, "�����������: /sethp [id ������] [���-�� ��������]");

    if(target == INVALID_PLAYER_ID)
        return SendError(playerid, "����� �� ������.");

    if(!(0.0 <= health_count <= 100.0))
        return SendError(playerid, "���-�� �������� �� ����� ���� ����� 0.0 � �� ����� 100.0.");

    if(p_info[playerid][admin] < p_info[target][admin])
        return 1;

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] ������� �������� %s [%d] �� %.2f.", get_name(playerid), playerid, get_name(target), target, health_count);
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

    SendAccess(playerid, "�� �������� %s [%d] �������� �� %.2f.", get_name(target), target, health_count);
    SendInfo(target, "������������� %s [%d] ������� ��� �������� �� %.2f.", get_name(playerid), playerid, health_count);

    p_info[target][pHealth] = health_count;
    SetPlayerHealth(target, health_count);
    p_info[target][satiety] =
    p_info[target][thirst] = 100.0;

    new str[12];
    format(str, sizeof(str), "%.2f", health_count);
    Log(LOG_player, INFO, "%s[%d](%s %s) ����� %s HP ������ %s[%d](%s %s) | #AdminLogs",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", str,
        get_name(target), p_info[target][ID], p_temp[target][session_IP], IsPlayerMobile(target) ? "Mobile": "PC");
    return 1;
}

CMD:spawn(playerid, params[])
{
    if(p_info[playerid][admin] < 1 && p_info[playerid][youtube_adm] < 3)
        return 1;

    if(p_info[playerid][helper] == 1) {
        if(GetPVarInt(playerid, "BoneStol_ID")) return SendError(playerid, "������ ����� � ������ �� ������, �������� ����������.");


        if(GetPlayerVehicleID(playerid) != 0)
        {
            new Float:P_pos[3];
            GetPlayerPos(playerid, P_pos[0],  P_pos[1],  P_pos[2]);
            SetPlayerPos(playerid, P_pos[0],  P_pos[1],  P_pos[2]+1.5);
        }
        ClearAnimations(playerid, true);
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[H] %s [%d] �������� �� ����� ��������� ������ ����.", get_name(playerid), playerid);
        SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

        SendAccess(playerid, "�� ����������� �� ����� ���������.");
        SpawnPlayer(playerid);

        Log(LOG_player, INFO, "%s[%d](%s %s) ��������� %s[%d](%s %s) | #AdminLogs",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC");

    }
    else {
        if(sscanf(params, "i", params[0])) return SendInfo(playerid, "�����������: /spawn [id ������]");

        if(params[0] == INVALID_PLAYER_ID)
            return SendError(playerid, "����� �� ������.");

        if(p_info[playerid][admin] < p_info[params[0]][admin])
            return 1;

        if(GetPVarInt(params[0], "BoneStol_ID")) return SendError(playerid, "������ ����� � ������ �� ������, �������� ����������.");

        if(GetPlayerVehicleID(params[0]) != 0)
        {
            new Float:P_pos[3];
            GetPlayerPos(params[0], P_pos[0],  P_pos[1],  P_pos[2]);
            SetPlayerPos(params[0], P_pos[0],  P_pos[1],  P_pos[2]+1.5);
        }
        ClearAnimations(params[0], true);
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] �������� �� ����� ��������� %s [%d].", get_name(playerid), playerid, get_name(params[0]), params[0]);
        SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

        SendAccess(playerid, "�� ��������� %s [%d] �� ����� ���������.", get_name(params[0]), params[0]);
        SendInfo(params[0], "������������� %s [%d] �������� ��� �� ����� ���������.", get_name(playerid), playerid);
        SpawnPlayer(params[0]);

        Log(LOG_player, INFO, "%s[%d](%s %s) ��������� %s[%d](%s %s) | #AdminLogs",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
            get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC");
   
    }
    return 1;
}

CMD:number(playerid, params[])
{
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "�����������: /number [id ������]");
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "����� �� ������.");
