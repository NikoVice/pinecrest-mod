forward Timer_Unix();
public Timer_Unix()
{
    timestamp = gettime(timestamp_hour, timestamp_minute, timestamp_second)+10800;//узнаем время.
    if(unix_hour <= timestamp)// прошел час
    {
        unix_hour = timestamp+3600;
        // ВАШ КОД НИЖЕ:
        CheckPowerLines();
        CheckVehicleCarShop();
    }
    if(unix_5_min <= timestamp)//прошло 5 минут
    {
        unix_5_min = timestamp+300;
        // ВАШ КОД НИЖЕ:
        for(new i = 0; i < MAX_FLOWERS_GREEN_HOUSES; i++)
        {
            if(FlowersGreenHousesInfo[i][fRespawn] == 0) CheckFlowers(i);
        }
        CheckFarm(TYPE_FARM_TREE);
        CheckFarm(TYPE_FARM_MILKER);
        CheckFarm(TYPE_FARM_WHEAT);
        CheckFarm(TYPE_FARM_WAREHOUSE);
        CheckResources(RESOURCES_TYPE_MINE);
        CheckResources(RESOURCES_TYPE_FARM);
        if(timestamp_hour == 16 || timestamp_hour == 18 || timestamp_hour == 20)
            CheckTrashBox();
        if(box_pickups_count < MAX_BOX-1)
        {
            for(new i = MAX_BOX-1; i != -1; i--)
            {
                if(BoxInfo[i][boxCoordsMySQLIDx] == INVALID_MYSQL_ID)
                {
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `box_coords` WHERE `status` = 0 ORDER BY RAND() LIMIT 1");
                    mysql_tquery(con_bd, STRING_GLOBAL, "LoadBoxCoords", "i", i);
                    break;
                }
            }
        }
        #if GIFT_STATUS == 1
            new giftspawn;
            if(gift_pickups_count < MAX_GIFT_PICKUP-1)
            {
                for(new i = 0; i < MAX_GIFT_PICKUP; i++)
                {
                    if(GiftInfo[i][gCoordsMySQLIDx] == 0)
                    {
                        STRING_GLOBAL[0] = EOS;
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `box_coords` WHERE `status` = 0 ORDER BY RAND() LIMIT 1");
                        mysql_tquery(con_bd, STRING_GLOBAL, "MySQLLoadGiftCoords", "i", i);
                        giftspawn++;
                        if(giftspawn >= 10) break;
                    }
                }
            }
        #endif
    }
    if(unix_10_min <= timestamp)
    {
        unix_5_min = timestamp+300;
        // ВАШ КОД НИЖЕ:
        CheckATM();
    }
    if(unix_10_min <= timestamp)
    {
        unix_10_min = timestamp+600;
    }
    if(unix_min <= timestamp)//прошла минута
    {
        timer_minute();
        unix_min = timestamp+60;
    }
    if(unix_sec <= timestamp)//прошла секунда
    {
        timer_second();
        unix_sec = timestamp+1;
    }
    if(unix_three_sec <= timestamp)
    {
        unix_three_sec = timestamp + 3;//прошло три секунды
    }
    return 1;
}

timer_minute()
{
    new year, month, day;
    getdate(year, month, day);

    #if OFF_HUD_PC == 0
    new str[128];
    format(str, sizeof(str), "%02d.%02d.%02d / %02d:%02d", day, month, year, timestamp_hour, timestamp_minute);
    TextDrawSetString(TD_Logo_Default[15], str);
    TextDrawSetString(TD_DataTime[1], str);
    #endif

    foreach(new playerid : Player)
    {
        if(p_info[playerid][loggedIn] != 1) continue;
        if(p_temp[playerid][TextDrawPhone] == true) UpdatePlayerPhoneInfo(playerid);
        if(p_temp[playerid][death_status] == 0 && p_info[playerid][admin] == 0)
        {
            if(floatcmp(p_info[playerid][satiety], 0.0) == 1)
            {
                p_info[playerid][satiety] -= 0.5;

                if (p_temp[playerid][satiety_time] < timestamp && floatcmp(p_info[playerid][satiety], 20.0) == -1) {
                    if(p_info[playerid][DonateUpdate][1] == 1 || p_info[playerid][p_add_vip] != 0)
                    {
                        if(!UsePlayerEating(playerid, 0))
                            SendInfo(playerid, "Вы голодны, у вас нет еды для автоматического употребления.");
                    }
                    else SendInfo(playerid, "Вы проголодались.");
                    p_temp[playerid][satiety_time] = (timestamp + (60 * 3) * p_info[playerid][p_vip] > 0 ? p_info[playerid][p_vip] + 1 : 1);
                }
            }
            else
            {
                GetPlayerHealth(playerid, p_info[playerid][pHealth]);
                if(p_temp[playerid][satiety_time] < timestamp && floatcmp(p_info[playerid][pHealth], 10.0) == 1) {
                    GetPlayerHealth(playerid, p_info[playerid][pHealth]);
                    p_info[playerid][pHealth] -= 5.0;
                    SetPlayerHealth(playerid, p_info[playerid][pHealth]);
                    //if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(i, "PED", "IDLE_tired", 4.1, 0, 0, 0, 0, 0, 1);
                    SendInfo(playerid, "Вы проголодались, Ваше здоровье ухудшается.");
                    p_temp[playerid][satiety_time] = (timestamp + (60 * 3) * p_info[playerid][p_vip] > 0 ? p_info[playerid][p_vip] + 1 : 1);
                }
            }

            if(floatcmp(p_info[playerid][thirst], 0.0) == 1)
            {
                p_info[playerid][thirst] -= 0.25;
                if (p_temp[playerid][thirst_time] < timestamp && floatcmp(p_info[playerid][thirst], 20.0) == -1) {
                    if(p_info[playerid][DonateUpdate][1] == 1 || p_info[playerid][p_add_vip] != 0)
                    {
                        if(!UsePlayerEating(playerid, 1))
                            SendInfo(playerid, "Вы голодны, у вас нет напитков для автоматического употребления.");
                    }
                    else SendInfo(playerid, "Вы хотите пить.");
                    p_temp[playerid][thirst_time] = (timestamp + (60 * 5) * p_info[playerid][p_vip] > 0 ? p_info[playerid][p_vip] + 1 : 1);
                }
            }
            else
            {
                GetPlayerHealth(playerid, p_info[playerid][pHealth]);
                if(p_temp[playerid][thirst_time] < timestamp && floatcmp(p_info[playerid][pHealth], 10.0) == 1) {
                    GetPlayerHealth(playerid, p_info[playerid][pHealth]);
                    p_info[playerid][pHealth] -= 2.5;
                    SetPlayerHealth(playerid, p_info[playerid][pHealth]);
                    p_temp[playerid][thirst_time] = (timestamp + (60 * 5) * p_info[playerid][p_vip] > 0 ? p_info[playerid][p_vip] + 1 : 1);
                }
            }
        }
    }

    new id_contr;
    for(new i; i < MAX_FAMILY_CONTRACTS; i++)
    {
        FamilyContractData[i][fTime]--;
        if(FamilyContractData[i][fTime] <= 0)
        {
            if(FamilyContractData[i][fID] != CONTRACT_FAMILY_ID_NONE)
            {
                FamilyDeleteContract(FamilyContractData[i][fID]);
            }
            else
            {
                rerandom:
                id_contr = RandomEx(CONTRACT_FAMILY_ID_NONE+1, CONTRACT_FAMILY_ID_ALL-2);
                for(new idx; idx < MAX_FAMILY_CONTRACTS; idx++)
                {
                    if(FamilyContractData[idx][fID] == id_contr)
                    {
                        goto rerandom;
                        break;
                    }
                }

                FamilyContractData[i][fID] = id_contr;
                FamilyContractData[i][fTime] = CONRACT_FAMILY_INIT[id_contr][fTime];
            }
        }
    }
}

CMD:entercar(playerid, params[])
{
    if(GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0) return SendError(playerid, "Доступно только на улице.");
    new vehicleid = GetPlayerVehicleID(playerid), vehicle_model = GetVehicleModelEx(vehicleid);
    if(vehicleid <= 0) return SendError(playerid, "Доступно только в автомобиле.");
    new Float:veh_Z;
    GetVehiclePos(vehicleid, veh_Z, veh_Z, veh_Z);
    if(veh_Z < 0.3 && GetVehicleData(vehicle_model, E_VD_TYPE) != VEHICLE_STATE_BOAT) return SendError(playerid, "В воде не возможно.");
    switch(veh_info[vehicleid][v_model])
    {
        case 508:
        {
            SetPlayerPos(playerid, 4511.4795,-1729.2078,778.6371);
            SetPlayerFacingAngle(playerid, 20.0);
        }
        case 453, 454, 430, 484, 595:
        {
            SetPlayerPos(playerid, 793.9700,910.3593,-5.7049);
            SetPlayerFacingAngle(playerid, 154.0);
        }
        case 519:
        {
            SetPlayerPos(playerid, 1.4258,23.5096,1199.5938);
            SetPlayerFacingAngle(playerid, 0.0);
        }
        case 427:
        {
            SetPlayerPos(playerid, 1820.8771,-17.4165,998.7266);
            SetPlayerFacingAngle(playerid, 0.0);
        }
        default: return 1;
    }
    SetCameraBehindPlayer(playerid);
    SetPlayerVirtualWorld(playerid, vehicleid);
    SetPlayerInterior(playerid, veh_info[vehicleid][v_model] == 519 ? 1 : vehicleid);
    p_temp[playerid][in_enter_vehicle] = vehicleid;
    return 1;
}
alias:entercar("ecar");

timer_second()
{
    CheckAirDrop();
    CheckWarPlane();
    CheckBarrier();
    CheckHouseGate();
    CheckLobby();
    CheckRobberyHouseContract();
    CheckFreelanceContract();
    CheckRobberyBankContract();
    CheckRobberyFuelContract();

    new year, month, day;
    getdate(year, month, day);

    for(new i = 0; i < MAX_CONTAINERS; i++) CheckContainers(i);

    new house_id;

    if(timestamp_second%10 == 0)
    {
        new File:handle = fopen("healthz.txt", io_readwrite);
        if(handle)
        {
            new tmp_str[16];
            f(tmp_str, "%d", timestamp);
            fwrite(handle, tmp_str);
            fclose(handle);
        }
    }

    if(DonateDiscount > 0) CheckDiscountDonate();

    Durak_Second();

    /*if(timestamp_hour == 18 && timestamp_second == 5) AddPhoneWarehouseInfo();*/

    if(timestamp_hour == 14 && timestamp_minute == 45 && timestamp_second == 00 || timestamp_hour == 17 && timestamp_minute == 45 && timestamp_second == 00 || timestamp_hour == 19 && timestamp_minute == 45 && timestamp_second == 00)
    {
        SendMesAll(COLOR_LIGHTRED, "[СВАЛКА]: "W"С %d:00 до %d:00 на свалках будут появляться ящики с предметами.", timestamp_hour + 1, timestamp_hour + 2);
        SendMesAll(COLOR_LIGHTRED, "[СВАЛКА]: "W"Местоположение: {"#cLIGHTRED"}/gps > [1] Общественные места > [21 - 23] Свалка [LS-SF-LV]");
    }

    /*
    if(timestamp_hour == 12 && timestamp_minute == 0 && timestamp_second == 10 ||
        timestamp_hour == 15 && timestamp_minute == 0 && timestamp_second == 10 ||
        timestamp_hour == 18 && timestamp_minute == 0 && timestamp_second == 10 ||
        timestamp_hour == 21 && timestamp_minute == 0 && timestamp_second == 10)
    {
        SendMesAll(COLOR_LIGHTRED, "[КОНТЕЙНЕРЫ]: "W"Начался аукцион контейнеров. Местоположение: {"#cLIGHTRED"}/gps > [1] Общественные места > [8] Аукцион контейнеров");
        for(new i = 0; i < MAX_CONTAINERS; i++) CreateContainers(i);
    }
    */

    if(timestamp_minute == 10 && timestamp_second == 0 || timestamp_minute == 30 && timestamp_second == 0 || timestamp_minute == 50 && timestamp_second == 0)
    {
        for(new i; i < sizeof(PrisonDoor); i++)
        {
            if(PrisonDoor[i] != INVALID_OBJECT_ID)
            {
                DestroyDynamicObject(PrisonDoor[i]);
                PrisonDoor[i] = INVALID_OBJECT_ID;
            }
        }
    }
    if(timestamp_minute == 00 && timestamp_second == 00 || timestamp_minute == 20 && timestamp_second == 00 || timestamp_minute == 40 && timestamp_second == 00)
    {
        for(new i; i < sizeof(PrisonDoor); i++)
        {
            if(PrisonDoor[i] == INVALID_OBJECT_ID)
                PrisonDoor[i] = CreateDynamicObject(19303, PrisonDoorCoords[i][0], PrisonDoorCoords[i][1], PrisonDoorCoords[i][2], 0.0, 0.0, PrisonDoorCoords[i][3], 1, 1);
        }
        foreach(new i:Player)
        {
            if(p_info[i][jail] != 5) continue;
            if(p_temp[i][prison_escape_time] > 0) continue;
            SpawnPlayer(i);
        }
    }

    if(timestamp_hour == 5 && timestamp_minute == 00 && timestamp_second == 10) 
    {
        foreach(new i:Player)
        {
            SendMes(i, COLOR_DARKORANGE, "Автоматический рестарт сервера. Зайдите через 3 мин.");
            Kick(i);
        }

        SendRconCommand("hostname RESTART... WAIT 3 MIN...");
        SetGameModeText("RESTART... WAIT 3 MIN...");
        SendRconCommand("password VOVA_ONLY");

        SetTimer("start_restart", 10000,0);
    }
        //SetTimer("new_restart",59000,0);

    if(timestamp_minute == 40 && timestamp_second == 3) GiveFamilyPay();

    if(timestamp_hour == 0 && timestamp_minute == 0 && timestamp_second == 01)
    {
        new time_to = getDayEx();
        if(time_to == 2) // Суббота;
        {
            SendMesAll(COLOR_LIGHTRED, "Выходная акция » "W"На сервере стартовала {"#cLIGHTRED"}\"Акция X4\":");
            SendMesAll(COLOR_LIGHTRED, "Выходная акция » "W"X4 донат (пополнение счета) и X3 PayDay.");
            SendMesAll(COLOR_LIGHTRED, "Выходная акция » "W"При пополнении любого количества денежных средств зачисляется в {"#cLIGHTRED"}четыре раза больше.");
            SendMesAll(COLOR_LIGHTRED, "Выходная акция » "W"Срок проведения акции с {"#cLIGHTRED"}суббота и воскресенье.");
            ServerInfo[Experian] = 4, ServerInfo[Salary] = 2, ServerInfo[DonationMultiplier] = 4;
            mysql_tquery(con_bd, "UPDATE `other` SET `Experian` = 4, `Salary` = 2, `DonationMultiplier` = 4 WHERE 1", "");
            UpdateHostname();
        }
        else if(time_to == 4) // Понедельник;
        {
            SendMesAll(COLOR_LIGHTRED, "Выходная акция » "W"На сервере завершилась {"#cLIGHTRED"}\"Акция X4\".");
            ServerInfo[Experian] = 3, ServerInfo[Salary] = 1, ServerInfo[DonationMultiplier] = 3;
            mysql_tquery(con_bd, "UPDATE `other` SET `Experian` = 3, `Salary` = 1, `DonationMultiplier` = 2 WHERE 1", "");
            UpdateHostname();
        }
        CheckBillboard();
    }

    if(timestamp_minute%10 == 0 && timestamp_second == 0) UpdateRocket();
    if(timestamp_minute == 5 && timestamp_second == 0 || timestamp_minute == 15 && timestamp_second == 0 || timestamp_minute == 25 && timestamp_second == 0 || timestamp_minute == 35 && timestamp_second == 0 || timestamp_minute == 45 && timestamp_second == 0 || timestamp_minute == 55 && timestamp_second == 0) UpdateRocket();

    if(rocket_timer_status[0] == 1 && rocket_timer[0] == 450)
    {
        foreach(new i:Player)
        {
            if(p_temp[i][SpaceFlightStatus] == false || p_temp[i][SpaceFlightType] != 1 || p_temp[i][SpaceFlightCheck] != 0 || p_temp[i][SpaceFlightTimer] != 0) continue;
            if(!IsPlayerInRangeOfPoint(i, 100.0, 1074.5447,1063.1207,10.1814) || p_temp[i][Work_ID] > NONE_WORK)
            {
                p_temp[i][SpaceFlightStatus] = false;
                p_temp[i][SpaceFlightType] = 0;
                p_temp[i][SpaceFlightCheck] = 0;
                p_temp[i][SpaceFlightTimer] = 0;
                if(p_temp[i][Work_ID] > NONE_WORK) SendError(i, "Вы не закончили рабочий день на прошлой работе и регистрация на полет была отменена.");
                else SendAccess(i, "Вы отошли слишком далеко от места взлета и регистрация на полет была отменена.");
                continue;
            }
            RemovePlayerAccessories(i, true);
            SetPlayerSkin(i, 278);
            SetPlayerSpaceCostume(i);
            SetPlayerPos(i, 1114.2740+random(2), 1111.6119+random(2), 1086.5599);
            SetPlayerFacingAngle(i, 88.8170);
            SetPlayerInterior(i, 1);
            SetPlayerVirtualWorld(i, 1);
            SetPlayerTime(i, 20, 0);
            SetPlayerWeather(i, 45);
            p_temp[i][SpaceFlightCheck] = 1;
            p_temp[i][SpaceFlightTimer] = 150;
            SendAccess(i, "Вы полетели в космос.");
        }
    }
    if(rocket_timer_status[1] == 1 && rocket_timer[1] == 450)
    {
        foreach(new i:Player)
        {
            if(p_temp[i][SpaceFlightStatus] == false || p_temp[i][SpaceFlightType] != 2 || p_temp[i][SpaceFlightCheck] != 0 || p_temp[i][SpaceFlightTimer] != 0) continue;
            if(!IsPlayerInRangeOfPoint(i, 100.0, 803.0112,1353.6564,1058.5327) || p_temp[i][Work_ID] > NONE_WORK)
            {
                p_temp[i][SpaceFlightStatus] = false;
                p_temp[i][SpaceFlightType] = 0;
                p_temp[i][SpaceFlightCheck] = 0;
                p_temp[i][SpaceFlightTimer] = 0;
                if(p_temp[i][Work_ID] > NONE_WORK) SendError(i, "Вы не закончили рабочий день на прошлой работе и регистрация на полет была отменена.");
                else SendAccess(i, "Вы отошли слишком далеко от места взлета и регистрация на полет была отменена.");
                continue;
            }

            SetPlayerPos(i, 1114.2740+random(2), 1111.6119+random(2), 1086.5599);
            SetPlayerFacingAngle(i, 88.8170);
            SetPlayerInterior(i, 1);
            SetPlayerVirtualWorld(i, 1);
            SetPlayerTime(i, 20, 0);
            SetPlayerWeather(i, 45);
            p_temp[i][SpaceFlightCheck] = 2;
            p_temp[i][SpaceFlightTimer] = 150;
            SendAccess(i, "Вы полетели на землю.");
        }
    }

    if(rocket_timer[0] > 0)
    {
        rocket_timer[0]--;
        if(rocket_timer_status[0] == 1)
        {
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "До прилета ракеты: "W"%02d:%02d", rocket_timer[0] / 60, rocket_timer[0] - ((rocket_timer[0] / 60) * 60));
            UpdateDynamic3DTextLabelText(rocket_text[0], COLOR_MAIN, STRING_GLOBAL);

            if(rocket_timer[0] <= 150)
            {
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "До приземления ракеты: "W"%02d:%02d", rocket_timer[0] / 60, rocket_timer[0] - ((rocket_timer[0] / 60) * 60));
                UpdateDynamic3DTextLabelText(rocket_text[2], COLOR_MAIN, STRING_GLOBAL);
            }
        }
        else
        {
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "До взлета ракеты: "W"%02d:%02d", rocket_timer[0] / 60, rocket_timer[0] - ((rocket_timer[0] / 60) * 60));
            UpdateDynamic3DTextLabelText(rocket_text[0], COLOR_MAIN, STRING_GLOBAL);
        }
        if(rocket_timer[0] == 0)
        {
            rocket_timer_status[0] = 2;
            rocket_timer[0] = 150;
        }
    }
    if(rocket_timer[1] > 0)
    {
        rocket_timer[1]--;
        if(rocket_timer_status[1] == 1)
        {
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "До прилета ракеты: "W"%02d:%02d", rocket_timer[1] / 60, rocket_timer[1] - ((rocket_timer[1] / 60) * 60));
            UpdateDynamic3DTextLabelText(rocket_text[1], COLOR_MAIN, STRING_GLOBAL);

            if(rocket_timer[1] <= 150)
            {
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "До приземления ракеты: "W"%02d:%02d", rocket_timer[1] / 60, rocket_timer[1] - ((rocket_timer[1] / 60) * 60));
                UpdateDynamic3DTextLabelText(rocket_text[2], COLOR_MAIN, STRING_GLOBAL);
            }
        }
        else
        {
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "До взлета ракеты: "W"%02d:%02d", rocket_timer[1] / 60, rocket_timer[1] - ((rocket_timer[1] / 60) * 60));
            UpdateDynamic3DTextLabelText(rocket_text[1], COLOR_MAIN, STRING_GLOBAL);
        }
        if(rocket_timer[1] == 0)
        {
            rocket_timer_status[1] = 2;
            rocket_timer[1] = 150;
        }
    }

    if(Market_Time > 0) Market_Time--;
    if(Market_Time == 0)
    {
        for(new v = 1, j = GetVehiclePoolSize(); v <= j; v++)
        {
            if(IsVehicleOccupied(v)) continue;
            if(GetVehicleDistanceFromPoint(v, 1128.5004,-1413.1503,13.6075) <= 50.0)
            {
                if(veh_info[v][v_npoType] == NPO_JOB && veh_info[v][v_npoId] == JOB_COLLECTOR || veh_info[v][v_temp_job] == JOB_COLLECTOR) continue;
                if(veh_info[v][v_npoType] == NPO_PLAYERCAR && veh_info[v][v_owner_id] != INVALID_MYSQL_ID)
                {
                    SetVehiclePos(v, veh_info[v][v_pos][0], veh_info[v][v_pos][1], veh_info[v][v_pos][2]);
                    SetVehicleZAngle(v, veh_info[v][v_pos][3]);

                    LinkVehicleToInterior(v, veh_info[v][v_int]);
                    SetVehicleVirtualWorld(v, veh_info[v][v_virt]);
                }
                else SetVehicleToRespawn(v);
            }
        }
        Market_Time = 30;
    }
    if(Market_Text != INVALID_3DTEXT_ID)
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Центральный рынок\n\n"W"Здесь запрещено парковать транспортные средства,\nвоспользуйтесь подземным паркингом.\n\n{"#cMAIN"}Транспорт будет отправлен на место спавна через "W"%d{"#cMAIN"} секунд.", Market_Time);
        UpdateDynamic3DTextLabelText(Market_Text, COLOR_MAIN, STRING_GLOBAL);
    }
