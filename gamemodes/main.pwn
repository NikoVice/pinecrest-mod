                    SendAccess(playerid, "Вы арендовали рабочего за %d$.", price);
                    SendInfo(playerid, "Для управления рабочими отправляйтесь в подпольное помещение дома.");
                }
                case B_TUNING, B_TAXI, B_TRUCKER, B_TANK_FARM, B_OIL_RIG, B_CAR_SHOWROOM, B_ARENDS_VEHICLE: return 1;
