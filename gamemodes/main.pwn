            !EtherSms[0] ? ("{63BD4E}[5] �������� ����� ��� � ����") : ("{F04245}[5] ��������� ����� ��� � ����"));
        ShowPlayerDialog(playerid, D_NEWS_PANEL, DIALOG_STYLE_LIST, ""I"��� ������", STRING_GLOBAL, "�������", "������");
