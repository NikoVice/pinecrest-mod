CMD:setvacancy(playerid, params[])
{
    //if(GetFactionType(p_info[playerid][member]) != FACTION_TYPE_GOS && GetFactionType(p_info[playerid][member]) != FACTION_TYPE_SNN) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(p_info[playerid][rang] < 9) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    ShowPlayerDialog(playerid, D_SET_VACANCY, DIALOG_STYLE_LIST, ""I"��������", ""I"[1]"W" �������� �������� �������������\n"I"[2]"W" �������� ���������� � �������������\n"I"[3]"W" �������� ����� �������������", "�����", "������");
