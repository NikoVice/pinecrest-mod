                return ShowPlayerDialog(playerid, D_ADVERTISE_DELETE, DIALOG_STYLE_INPUT, ""I"Отклонение объявления", STRING_GLOBAL, "Далее", "Отмена");
            }
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s %s [%d] отклонил объявление %s. Причина: %s", GetPlayerFractionRangName(playerid), get_name(playerid), playerid, AdvertInfo[idx][aSender], text);
            SendFractionMessage(RADIO_LS, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(RADIO_SF, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(RADIO_LV, 0x33CC66FF, STRING_GLOBAL);
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Объявление: %s.", AdvertInfo[idx][aText]);
            SendFractionMessage(RADIO_LS, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(RADIO_SF, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(RADIO_LV, 0x33CC66FF, STRING_GLOBAL);
