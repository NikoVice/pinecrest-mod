        }
        case D_SELL_LICENSE:
        {
            if(!response) return 1;
            if(listitem == 4 && p_info[playerid][rang] < 5) return SendError(playerid, "У Вас слишком маленький ранг для продажи лицензии на \"%s\".", name_license[listitem]);
            new rang_licence[LIC_ALL - 1] = {2, 3, 5, 5, 6, 4, 4, 6},
                targetid = p_temp[playerid][p_listitem_int];
            if(targetid == INVALID_PLAYER_ID)
                return SendError(playerid, "Игрок не найден.");
            if(p_info[playerid][rang] < rang_licence[listitem])
                return SendError(playerid, "У Вас должен быть %d ранг для продажи лицензии на \"%s\".", rang_licence[listitem], name_license[listitem]);
            if(p_info[targetid][Lic][type_license[listitem]] == 2)
                return SendError(playerid, "У игрока черный список по лицензии на \"%s\".", name_license[listitem]);
            if(p_info[targetid][Lic][type_license[listitem]] == 1)
            {
                if(type_license[listitem] == LIC_CAR) CheckPlayerMission(targetid, START_SCHOOL);
                return SendError(playerid, "У игрока уже есть лицензиня на %s.", name_license[listitem]);
            }
            SetFreeSlotOffer(targetid, playerid, OFFER_ID_SELL_LICENSE, price_license[listitem], listitem);
            return 1;
        }
        case D_AUTOSCHOOL:
        {
            if(!response) return 1;
            new price = price_license[listitem] / 2;
