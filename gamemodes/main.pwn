/// notify system by Vip_Uzer
AddNotify(user_id, text_notify[])
{
    new string[256];
    format(string, sizeof(string), "INSERT INTO `player_notification` (`user_id`, `text_notify`, `date`) VALUES ('%d', '%s', NOW())",
        user_id, text_notify);
    mysql_tquery(con_bd, string, "","");
    return 1;
}

forward GetNotify(playerid);
public GetNotify(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(!rows) return 1;

    new text_notify[256], date_notify[20], id_notify;
    STRING_GLOBAL[0] = EOS;
    for(new i; i < rows; i++)
    {
        cache_get_value_name(i, "text_notify", text_notify);
        cache_get_value_name(i, "date", date_notify);
        cache_get_value_name_int(i, "id", id_notify);

        f(STRING_GLOBAL, "%s"I"============================================= "A"%s\n", STRING_GLOBAL, date_notify);
        f(STRING_GLOBAL, "%s"W"%s\n\n", STRING_GLOBAL, text_notify);

        STRING_MIN[0] = EOS;
        mysql_format(con_bd, STRING_MIN, sizeof(STRING_MIN), "DELETE FROM `player_notification` WHERE `id` = %d", id_notify);
        mysql_tquery(con_bd, STRING_MIN);

        if(i >= 5) break;
    }
    if(rows > 5) ShowPlayerDialog(playerid, D_NOTIFICATION, DIALOG_STYLE_MSGBOX, ""I"����������", STRING_GLOBAL, "�����", "������");
    else ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"����������", STRING_GLOBAL, "������", "");
    return 1;
}

SetHouseCheckpoint(playerid, work, idx = -1)
{
    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
    new houseid = 1 + random(totalhouses);
    if(idx != -1) houseid = idx;
    new Float:distance = GetPlayerDistanceFromPoint(playerid, h_info[houseid][h_enter][0], h_info[houseid][h_enter][1], h_info[houseid][h_enter][2]);
    if(idx == -1)
    {
        if(AntiCheatWarningTime[playerid][2] > timestamp) return SendError(playerid, "�� �� ������ ����� ������ ��� �����, ���������.");

        new salary = 0;

        if(distance < 500.0) salary = 1195;
        else if(distance > 500.0 && distance < 1000.0) salary = 1916;
        else if(distance > 1000.0 && distance < 1500.0) salary = 2631;
        else if(distance > 1500.0 && distance < 2000.0) salary = 3354;
        else if(distance > 2000.0 && distance < 2500.0) salary = 4070;
        else if(distance > 2500.0 && distance < 3000.0) salary = 4793;
        else if(distance > 3000.0 && distance < 3500.0) salary = 5510;
        else if(distance > 3500.0) salary = 6233;

        new time = floatround(distance) / 500 * 25;

        switch(work)
        {
            case 0:
            {
                p_temp[playerid][PizzaboyIDx] = houseid;
                p_temp[playerid][PizzaboySalary] = salary;
                AntiCheatWarningTime[playerid][0] = timestamp + time;
                AntiCheatWarningTime[playerid][1] = time;
            }
        }
    }

    SendMes(playerid, COLOR_WHITE, "\"��� � %d\" {"#cBLUE"}������� �� GPS ����������. ����������: "W"%.0f{"#cBLUE"} ������.", houseid, distance);
    SetPlayerCheckpoint(playerid, h_info[houseid][h_enter][0], h_info[houseid][h_enter][1], h_info[houseid][h_enter][2], 2.5);
    return 1;
}

CreateFire(playerid)
{
    new rand = random(sizeof(FireInfo)), index = -1;
    for(new i, idx = -1; i < sizeof(FireInfo) * 2; i++)
    {
        idx++;
        if(idx >= sizeof(FireInfo)) idx = 0;
        if(FireInfo[idx][fStatus] == 1) continue;
        rand--;
        if(rand <= 0)
        {
            FireInfo[idx][fStatus] = 1;
            for(new x; x < 5; x++)
            {
                if(FireInfo[idx][fObject][x] != -1)
                {
                    DestroyDynamicObject(FireInfo[idx][fObject][x]);
                    FireInfo[idx][fObject][x] = -1;
                }
                if(FireInfo[idx][fPos][x * 3  + 0] == 0.0) continue;
                FireInfo[idx][fObject][x] = CreateDynamicObject(18691, FireInfo[idx][fPos][x * 3  + 0], FireInfo[idx][fPos][x * 3  + 1], FireInfo[idx][fPos][x * 3  + 2] - 1.86, 0.0, 0.0, 0.0);
            }
            index = idx;
            break;
        }
    }
    if(index == -1)
    {
        p_temp[playerid][FireStatus] = 0;
        p_temp[playerid][FireTimer] = 10;
        return 1;
    }
    p_temp[playerid][FireStatus] = index + 1;
    p_temp[playerid][FireTimer] = 900;

    new Float:distance = GetPlayerDistanceFromPoint(playerid, FireInfo[index][fPos][0], FireInfo[index][fPos][1], FireInfo[index][fPos][2]);

    new time = floatround(distance) / 500 * 30;

    AntiCheatWarningTime[playerid][0] = timestamp + time;

    SetPlayerRaceCheckpoint(playerid, 1, FireInfo[index][fPos][0], FireInfo[index][fPos][1], FireInfo[index][fPos][2], 0, 0, 0, 5);
    SendMes(playerid, COLOR_BLUE, "�� ����� �� ����������� � ������ "W"\"%s\"{"#cBLUE"} �����. ����������: "W"%.0f{"#cBLUE"} ������.", FireInfo[index][fCity], distance);
    SendMes(playerid, COLOR_LIME, "�������������� ������ �������� �� ����� GPS ����������.");
    SendMes(playerid, COLOR_SEA_WAVE, "� ��� ���� 15 ����� ����� ��������� �� �������������� ������ � ��������� ���.");
    return 1;
}

DestroyFire(playerid)
{
    if(p_temp[playerid][FireStatus] == 0) return 1;
    new idx = p_temp[playerid][FireStatus] - 1;
    FireInfo[idx][fStatus] = 0;
    for(new i; i < 5; i++)
    {
        if(FireInfo[idx][fObject][i] != -1) DestroyDynamicObject(FireInfo[idx][fObject][i]);
        FireInfo[idx][fObject][i] = -1;
    }
    return 1;
}

CMD:hbject(playerid, params[])
{
    if(SRV_ID) return 1;
    new giveplayerid = -1, slot = -1, objectid = 0, bone = 1, Float:ox = 0.0, Float:oy = 0.0, Float:oz = 0.0, Float:rx = 0.0, Float:ry = 0.0, Float:rz = 0.0, Float:sx = 1.0, Float:sy = 1.0, Float:sz = 1.0;
    sscanf(params, "iiiifffffffff", giveplayerid, slot, objectid, bone, ox, oy, oz, rx, ry, rz, sx, sy, sz);
    if(giveplayerid == -1 || slot == -1) return SendInfo(playerid, "�����������: /hbject [playerid] [���� 0 - 9] [id �������] [����� ����] [x] [y] [z] [rx] [ry] [rz] [sx] [sy] [sz]");
    if(slot < 0 || slot > 9) return SendError(playerid, "���� �� 0 �� 9.");
    if(bone < 1 || bone > 18) return SendError(playerid, "����� ���� �� 1 �� 18.");
    if(IsPlayerAttachedObjectSlotUsed(giveplayerid, slot)) return RemovePlayerAttachedObject(giveplayerid, slot);
    if(!SetPlayerAttachedObject(giveplayerid, slot, objectid, bone, ox, oy, oz, rx, ry, rz, sx, sy, sz)) return SendError(playerid, "��������� ������.");
    ClearAnimations(playerid);
    ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 1, 0, 0, 1, 1);
    //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
    return 1;
}

CMD:aobject(playerid, params[])
{
    if(SRV_ID) return 1;
    if(sscanf(params, "iiii", params[0], params[1], params[2], params[3])) return SendInfo(playerid, "�����������: /aobject [ID �����] [���� 0 - 9] [id �������] [����� ����]");
    if(params[0] < 0 || params[0] > 311) return SendError(playerid, "ID ����� �� 0 �� 311.");
    if(params[1] < 0 || params[1] > 9) return SendError(playerid, "���� �� 0 �� 9.");
    if(params[3] < 1 || params[3] > 18) return SendError(playerid, "����� ���� �� 1 �� 18.");
    if(IsPlayerAttachedObjectSlotUsed(playerid, params[1])) return RemovePlayerAttachedObject(playerid, params[1]);
    SetPlayerSkin(playerid, params[0]);
    SetPlayerAttachedObject(playerid, params[1], params[2], params[3], 0.344000, -0.095000, 0.164999, -3.399999, -5.599998, -0.700000, 1.000000, 1.000000, 1.000000);
    return 1;
}

CMD:aeobject(playerid, params[])
{
    if(SRV_ID) return 1;
    if(sscanf(params, "ii", params[0], params[1])) return SendInfo(playerid, "�����������: /aeobject [ID �����] [���� 0 - 9]");
    if(params[0] < 0 || params[0] > 311) return SendError(playerid, "ID ����� �� 0 �� 311.");
    if(params[1] < 0 || params[1] > 9) return SendError(playerid, "���� �� 0 �� 9.");
    SetPlayerSkin(playerid, params[0]);
    EditAttachedObject(playerid, params[1]);
    return 1;
}

CMD:aremove(playerid, params[])
{
    if(SRV_ID) return 1;
    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "�����������: /aremove [���� 0 - 9]");
    if(params[0] < 0 || params[0] > 9) return SendError(playerid, "���� �� 0 �� 9.");
    RemovePlayerAttachedObject(playerid, params[0]);
    return 1;
}

public OnPlayerEditAttachedObject(playerid, response, index, modelid, boneid, Float:fOffsetX, Float:fOffsetY, Float:fOffsetZ, Float:fRotX, Float:fRotY, Float:fRotZ, Float:fScaleX, Float:fScaleY, Float:fScaleZ)
{
    if(response == EDIT_RESPONSE_UPDATE)
    {
        RemovePlayerAttachedObject(playerid, index);
        SetPlayerAttachedObject(playerid, index, modelid, boneid, fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ);
    }
    if(response == EDIT_RESPONSE_FINAL)
    {
        new str[256];
        format(str, sizeof(str), "{%f, %f, %f, %f, %f, %f, %f, %f, %f}, // %d", fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ, GetPlayerSkin(playerid));
        SendMes(playerid, COLOR_WHITE, str);
        RemovePlayerAttachedObject(playerid, index);
        SetPlayerAttachedObject(playerid, index, modelid, boneid, fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ);
    }
    if(response == EDIT_RESPONSE_CANCEL)
    {
        RemovePlayerAttachedObject(playerid, index);
    }
    return 1;
}

OnPlayerUpdateLicData(playerid)
{
    STRING_GLOBAL[0] = EOS;
