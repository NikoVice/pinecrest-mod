            if(duelid == INVALID_PLAYER_ID) return 1;
            if(DuelData[duelid][dGameState] == 1) return 1;
            if(!response) return OnServerShowDialogDuelMenu(playerid);
            if(strlen(inputtext) == 0) return ShowPlayerDialog(playerid, D_DUEL_BANK, DIALOG_STYLE_INPUT, ""I"Ставка", ""W"Введите сумму ставки в дуэли:", "Принять", "Отмена");
            if(!(1000 <= strval(inputtext) <= 100000))
            {
                ShowPlayerDialog(playerid, D_DUEL_BANK, DIALOG_STYLE_INPUT, ""I"Ставка", ""W"Введите сумму ставки в дуэли:", "Принять", "Отмена");
                SendError(playerid, "Ставка должна быть не менее 1000$ и не более 100000$.");
                return 1;
            }
            DuelData[duelid][dBank] = strval(inputtext);
            for(new i; i < 10; i++)
            {
                if(DuelData[duelid][dCommand1][i] != INVALID_PLAYER_ID)
                    SendAccess(DuelData[duelid][dCommand1][i], "%s [%d] установил ставку %d$ для дуэли.", get_name(playerid), playerid, DuelData[duelid][dBank]);
                if(DuelData[duelid][dCommand2][i] != INVALID_PLAYER_ID)
                    SendAccess(DuelData[duelid][dCommand2][i], "%s [%d] установил ставку %d$ для дуэли.", get_name(playerid), playerid, DuelData[duelid][dBank]);
            }
            OnServerShowDialogDuelMenu(playerid);
            return 1;
        }
        case D_DIR_SHOW:
        {
            if(!response) return 1;
            new count_online = 0;
            STRING_GLOBAL = "[#] Никнейм\tТелефон\n";
            switch(listitem)
            {
                case 0:
                {
                    foreach(new i : gJobPlayers[JOB_MECHANIC])
                    {
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" %s[%d]\t%d\n", STRING_GLOBAL, count_online+1, get_name(i), i, p_info[i][phone_number]);
                        count_online++;
                    }
                    if(count_online == 0) return SendError(playerid, "Механиков нет в игре.");
                    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, ""I"Механики в сети", STRING_GLOBAL, "Закрыть", "");
                    return 1;
                }
                case 1:
                {
                    foreach(new i : Player)
                    {
                        if(!IsPlayerFractionMedic(i) || p_info[i][admin] > 0) continue;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s[%d] %s: %s[%d]\t%d\n", STRING_GLOBAL, count_online+1, GetFractionName(p_info[i][member]), get_name(i), i, p_info[i][phone_number]);
                        count_online++;
                    }
                    if(count_online == 0) return SendError(playerid, "Медиков нет в игре.");
                    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, ""I"Мед. работники в сети", STRING_GLOBAL, "Закрыть", "");
                    return 1;
                }
                case 2:
                {
                    foreach(new i : gFactionPlayers[MAYOR_LS])
                    {
                        if(p_info[i][rang] == 3)
                        {
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" %s[%d]\t%d\n", STRING_GLOBAL, count_online+1, get_name(i), i, p_info[i][phone_number]);
                            count_online++;
                        }
                    }
                    if(count_online == 0) return SendError(playerid, "Адвокатов нет в игре.");
                    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, ""I"Адвокаты в сети", STRING_GLOBAL, "Закрыть", "");
                    return 1;
                }
                case 3:
                {
                    foreach(new i : Player)
                    {
                        if(p_info[i][Lic][LIC_LAWYER] == 1)
                        {
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d]"W" %s[%d]\t%d\n", STRING_GLOBAL, count_online+1, get_name(i), i, p_info[i][phone_number]);
                            count_online++;
                        }
                    }
                    if(count_online == 0) return SendError(playerid, "Частных адвокатов нет в игре.");
                    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, ""I"Частные адвокаты в сети", STRING_GLOBAL, "Закрыть", "");
                    return 1;
                }
            }
            return 1;
