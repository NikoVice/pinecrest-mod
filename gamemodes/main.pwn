                    p_temp[playerid][res_use_idx] = idx;
                    p_temp[playerid][res_use_type] = RESOURCES_TYPE_H_COTTON;
                    SendMes(playerid, COLOR_LEMON, "Для сбора урожая нажмите \"ALT\".");
                }
                case AREA_SUBTYPE_RESOURCES_H_LINEN:
                {
                    if(h_info[ResourcesHouseInfo[idx][rhHouseIDx]][h_user_id] != p_info[playerid][ID]) return SendError(playerid, "Вы не владеете домом, который закреплен за этой грядкой.");
                    p_temp[playerid][res_use_idx] = idx;
                    p_temp[playerid][res_use_type] = RESOURCES_TYPE_H_LINEN;
                    SendMes(playerid, COLOR_LEMON, "Для сбора урожая нажмите \"ALT\".");
                }
            }
            p_temp[playerid][res_extraction_timer] = 0;
            return 1;
        }
        case TYPE_ROB_HOUSE:
        {
            if(player_state != PLAYER_STATE_ONFOOT) return 1;
            new idx = gAreaInfo[areaid][area_object_id];
            switch(gAreaInfo[areaid][area_subtype])
            {
                case AREA_SUBTYPE_ROB_HOUSE_NPC_1:
                {
                    if(GetPlayerFamilyID(playerid) == -1 && !gang(playerid) && !mafia(playerid) && !biker(playerid)) return SendError(playerid, "Вы не состоите в семье или нелегальной организации.");
                    if(gos(playerid)) return SendError(playerid, "Вы не закончили рабочий день.");
                    SendMes(playerid, COLOR_LEMON, "Чтобы поговорить с Вадимом, нажмите \"ALT\".");
                }
                case AREA_SUBTYPE_ROB_HOUSE_NPC_2:
                {
                    if(GetPlayerFamilyID(playerid) == -1 && !gang(playerid) && !mafia(playerid) && !biker(playerid)) return SendError(playerid, "Вы не состоите в семье или нелегальной организации.");
                    if(gos(playerid)) return SendError(playerid, "Вы не закончили рабочий день.");
                    SendMes(playerid, COLOR_LEMON, "Чтобы поговорить с Владимиром, нажмите \"ALT\".");
                }
                case AREA_SUBTYPE_ROB_HOUSE_OBJECT:
                {
                    if(GetPVarInt(playerid, "fse:anti_flood_area") > timestamp) return 1;
                    new sub_idx = gAreaInfo[areaid][area_idx], i = p_temp[playerid][rob_house_idx];
                    if(sub_idx == i)
                    {
                        if(p_temp[playerid][rob_house_backup] == 0) return SendError(playerid, "У Вас нет сумки.");
                        if(GetFreeRobHouseObject(playerid) == 0) return SendError(playerid, "В Вашей сумке нет места.");
                        StartRobbingMiniGame(playerid, ROBBING_TYPE_HOUSE, ROB_HOUSE_ITEMS_OBJECT, 30, idx);
                    }
                }
                case AREA_SUBTYPE_ROB_HOUSE_BACKUP:
                {
                    if(idx == INVALID_PLAYER_ID) return 1;
                    if(!IsPlayerConnected(idx)) return 1;
                    if(p_temp[idx][rob_house_backup_pickup] == -1 || p_temp[idx][rob_house_backup_area] == -1) return 1;
                    new rob_idx = p_temp[playerid][rob_house_idx];
                    if(rob_idx == -1) return SendError(playerid, "Вы не участвуете в ограблении дома.");
                    if(GetFreeRobHouseObject(playerid) != MAX_ROBBERY_HOUSE_PLAYER_ITEMS) return SendError(playerid, "В Вашей сумке есть какие-то предметы, отнесите её %s.", RobberyHouseContract[rob_idx][rhcVehicleIDx] == INVALID_VEHICLE_ID ? "на продажу к Владимиру" : "в транспортное средство");
                    p_temp[playerid][rob_house_backup] = 1;
                    new items_idx, count;
                    for(new i = 3, x = 0; i < MAX_ROBBERY_HOUSE_PLAYER_ITEMS * 2; i++)
                    {
                        items_idx = p_temp[idx][rob_house_backup_items][i];
                        if(items_idx != -1)
                        {
                            for(x = 0; x < MAX_ROBBERY_HOUSE_PLAYER_ITEMS; x++)
                            {
                                if(p_temp[playerid][rob_house_backup_items][x] == -1)
                                {
                                    p_temp[playerid][rob_house_backup_items][x] = items_idx;
                                    p_temp[idx][rob_house_backup_items][i] = -1;
                                    SendAccess(playerid, "Вы взяли предмет \"%s\" из сумки.", RobberyHouseItems[items_idx][rhiName]);
                                    count++;
                                    break;
                                }
                            }
                        }
                    }
                    if(count == 0) SendError(playerid, "В сумке ничего ничего нет.");
                    ClearRobberyHouseBackup(idx, 1);
                }
            }
            return 1;
        }
