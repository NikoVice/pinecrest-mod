                HideTextDrawForPlayer(playerid, TD_ID_CAPTURE);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `log_fraction` (`PlayerID`, `Member`, `Rang`, `Type`, `Reason`) VALUES (%d, %d, %d, '1', '���� �� �/�')",
            p_info[playerid][ID], p_info[playerid][member], p_info[playerid][rang]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            Iter_Remove(gFactionPlayers[p_info[playerid][member]], playerid);
            p_info[playerid][member] = 0;
            p_info[playerid][leader] = 0;
            p_info[playerid][rang] = 0;
            p_info[playerid][fskin] = 0;
            Iter_Add(gFactionPlayers[p_info[playerid][member]], playerid);
            if(GetPlayerHouseID(playerid) != INVALID_HOUSE_ID) p_info[playerid][spawn] = SPAWN_HOUSE;
            else p_info[playerid][spawn] = 0;
            p_info[playerid][fwork] = false;
            SetPlayerSkinEx(playerid);
            SetPlayerColor(playerid, fraction_color[0]);
            if(GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_PD || GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_FBI)
                p_temp[playerid][StatusOnDuty] = 0;
