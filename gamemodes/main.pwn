public OnGameModeInit()
{
    timestamp = gettime(timestamp_hour, timestamp_minute, timestamp_second)+10800; // ��������� timestamp � timestamp_hour, timestamp_minute, timestamp_second
    new syncunix = timestamp; // syncunix ����� timestamp

    syncunix -= timestamp_minute*60; // � syncunix �������� ������
    syncunix -= timestamp_second; // � syncunix �������� ������

    unix_hour = syncunix+3600; // ��������� � unix_h - ��� ����� Timer_Unix �������� ��������� � 00 �����
    unix_5_min = syncunix+300;
    unix_10_min = syncunix+600;
    unix_min = syncunix+60; // ��������� � unix_m - ������ ����� Timer_Unix �������� ��������� � 00 ������
    unix_sec = syncunix;
    unix_three_sec = syncunix+3;

