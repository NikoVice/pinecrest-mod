            }
            new veh_number = strval(inputtext), // S A D
                size_veh_num = strlen(inputtext);
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `v_mysql_id` FROM `vehicle` WHERE `v_number`= 'SA %d %s'",
            veh_number, size_veh_num == 3 ? "S" : size_veh_num == 4 ? "A" : "D");
            mysql_tquery(con_bd, STRING_GLOBAL, "check_used_veh_number", "iii", playerid, veh_number, size_veh_num);
