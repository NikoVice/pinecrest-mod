            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `ftop_gkills_week` = 0, `ftop_gdeaths_week`  = 0, `ftop_gdamagegive_week` = 0.0, `ftop_gdamagetake_week` = 0.0 WHERE `id` = %d", p_info[id_leader][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL);
            */

            Iter_Remove(gFactionPlayers[p_info[id_leader][member]], id_leader);

            p_info[id_leader][leader] = listitem;
            p_info[id_leader][member] = listitem;
            p_info[id_leader][rang] = 10;

            Iter_Add(gFactionPlayers[p_info[id_leader][member]], id_leader);

            p_info[id_leader][spawn] = 3;

            SendInfo(id_leader, "Администратор %s назначил Вас лидером %s.", get_name(playerid), GetFractionName(p_info[id_leader][member]));
            SendInfo(playerid, "Вы назначили %s на должность лидера %s.", get_name(id_leader), GetFractionName(p_info[id_leader][member]));

            if(gang(id_leader))
            {
                if(Capture_Info[0][gGangZoneID] != INVALID_CRIMINAL_ZONE_ID || Capture_Info[1][gGangZoneID] != INVALID_CRIMINAL_ZONE_ID)
                {
                    if((Capture_Info[0][gFaction][0] == p_info[id_leader][member] || Capture_Info[0][gFaction][1] == p_info[id_leader][member]) ||
                        (Capture_Info[1][gFaction][0] == p_info[id_leader][member] || Capture_Info[1][gFaction][1] == p_info[id_leader][member]))
                    {
                        ShowTextDrawForPlayer(id_leader, TD_ID_CAPTURE);
                        CaptureInfoUpdate(id_leader, CAPTURE_ID_GANG);
                    }
                }
            }
            if(mafia(id_leader) || biker(id_leader))
            {
                if(BizWar_Info[bWarTime] > 0)
                {
                    if(BizWar_Info[bMafia][0] == p_info[playerid][member] || BizWar_Info[bMafia][1] == p_info[playerid][member])
                    {
                        ShowTextDrawForPlayer(id_leader, TD_ID_CAPTURE);
                        CaptureInfoUpdate(id_leader, CAPTURE_ID_MAFIA);
                    }
                }
            }

            SetPlayerFractionSkin(id_leader);
            save_player(id_leader);
            SpawnPlayer(id_leader);
            return 1;
        }
        case D_CREATE:
        {
