                if(b_info[bizz_id][b_paydays_received] == -1)
                {
                    SendError(playerid, "Действия над бизнесом заблокированы.");
                    return SendInfo(playerid, "Имущество будет продано в 8 вечера в гос по причине недостаточного Вашего онлайна.");
                }
                */
                switch(p_temp[playerid][p_listitem_int])
                {
                    case BIZZ_ID_SELECT:
                        SendAccess(playerid, "Вы выбрали бизнес: "I"%s "W"(Слот: %d)", b_info[bizz_id][_name], listitem+1);
                    case BIZZ_ID_MENU:
                    {
                        /*
                        if(0 == IsPlayerInRangeOfPoint(playerid, 8.0, b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2]))
                            return SendError(playerid, "Вы слишком далеко от бизнеса.");
                        */

                        if(b_info[bizz_id][b_auction_bet] != 0)
                        {
                            STRING_GLOBAL[0] = EOS;
                            f(STRING_GLOBAL, ""W"\
                            Для управления бизнесом необходимо снять его с аукциона.\n\n\
                            Чтобы снять бизнес с аукциона, Вам необходимо заплатить %d$.\n\n\
                            Вы хотите снять бизнес с аукциона?", (b_info[bizz_id][b_auction_bet]/100)*2);
                            ShowPlayerDialog(playerid, D_AUCTION_BIZZ_CANCEL, DIALOG_STYLE_MSGBOX, ""I"Аукцион бизнесов", STRING_GLOBAL, "Далее", "Отмена");
                            return 1;
                        }
                        else
                        {
                            if(b_info[bizz_id][_bank] > 10000000)
                            {
                                b_info[bizz_id][_bank] = 10000000;
                                SendError(playerid, "Максимальное количество денежных средств на балансе бизнеса 10000000$.");
                                save_bizz(bizz_id);
                            }
                            biz_m(playerid);
                        }
                    }
                    case BIZZ_ID_RENT:
                    {
                        new price_rent = bizz_tax[b_info[bizz_id][_tip]], vip_idx = p_info[playerid][p_vip];
                        if(vip_idx) price_rent = (price_rent / 100) * (100 - (10 * vip_idx));
                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                        Чтобы "I"оплатить"W" бизнес, введите количество дней:\n\n\
                        Бизнес оплачен на "I"%d"W" дн(-я/-ей) ["I"%d"W" ча(-а/-ов)].\n\n\
                        Стоимость оплаты в день: "I"$%d.", b_info[bizz_id][b_rent]/24, b_info[bizz_id][b_rent], price_rent);
                        ShowPlayerDialog(playerid, D_BIZZ_RENT, DIALOG_STYLE_INPUT, ""I"Оплатить бизнес", STRING_GLOBAL, "Далее", "Отмена");
                    }
                    case BIZZ_ID_GPS:
                    {
                        new Float:distance = GetPlayerDistanceFromPoint(playerid, b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2]);
                        if(p_temp[playerid][TaxiGPS] == true)
                        {
                            if(GetPlayerTaxiDriver(playerid) == INVALID_PLAYER_ID) return SendError(playerid, "В такси нет водителя.");

                            new driverid = GetPlayerTaxiDriver(playerid);
                            p_temp[playerid][TaxiGPS] = false;
                            SetPlayerGPS(driverid, b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2],5.0);

                            SendInfo(driverid, "%s обозначил место назначения. Расстояние: %.0f метров.", get_name(playerid), distance);
                            return 1;
                        }

                        if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);

                        SetPlayerGPS(playerid, b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2],5.0);
                        SendInfo(playerid, "\"Бизнес\" отмечен на GPS навигаторе. Расстояние: %.0f метров.", distance);
                    }
                    case BIZZ_ID_GARDEN_CENTER:
                    {
                        new bizid = GetPVarInt(playerid, "bID"), till = b_info[bizid][_till];
                        STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;
                        for(new idx = 0; idx < sizeof(GardenCenter); idx++)
                        {
                            format(STRING_MIN, sizeof(STRING_MIN), ""I"[%d]"W" %s (%d$)\n", idx + 1, GardenCenter[idx][GardenCenterName], GardenCenter[idx][GardenCenterPrice] * till);
                            strcat(STRING_GLOBAL, STRING_MIN);
                        }
                        p_temp[playerid][p_listitem][40] = B_GARDEN_CENTER;
                        ShowPlayerDialog(playerid, D_BUY_MAGAZ, DIALOG_STYLE_LIST, ""I"Покупка", STRING_GLOBAL, "Купить","Отмена");
                        SetPVarInt(playerid, "GardenCenter:type", 2);
                        return 1;
