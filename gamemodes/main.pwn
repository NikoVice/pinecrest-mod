            SendMes(playerid, COLOR_LIME, "Помощь по работе: {"#cLYELLOW"}/mn > [4] Помощь по игре > [13] Основные работы > [5] Инкассатор");
        }
        case FIREMAN_WORK:
        {
            new skin_list[] = {277, 278, 279};
            SetPlayerSkin(playerid, skin_list[random(sizeof(skin_list) - 1)]);
            p_temp[playerid][FireStatus] = 1;
            p_temp[playerid][FireTimer] = 0;
            p_temp[playerid][FireExting] = 0;
