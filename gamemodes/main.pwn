        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][121]) // camera left
    {
        new Float:camera_distance, Float:camera_posZ;
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
            camera_distance = 8.5;
            camera_posZ = 3.0;
        }
        else
        {
            camera_distance = 2.5;
            camera_posZ = 1.5;
        }
        SetCameraForPlayer(playerid, p_temp[playerid][camera_id], camera_distance, camera_posZ, true, TYPE_UPDATE_CAMERA_LEFT);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][126]) // camera right
    {
        new Float:camera_distance, Float:camera_posZ;
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
            camera_distance = 8.5;
            camera_posZ = 3.0;
        }
        else
        {
            camera_distance = 2.5;
            camera_posZ = 1.5;
        }
        SetCameraForPlayer(playerid, p_temp[playerid][camera_id], camera_distance, camera_posZ, true, TYPE_UPDATE_CAMERA_RIGHT);
        return 1;
    }
    for(new i = 4; i != -1; i--)
    {
        if(playertextid == BoxButton[playerid][i])
        {
            new idx = p_temp[playerid][BoxIDx];
            if(!IsPlayerInDynamicArea(playerid, BoxInfo[idx][boxArea])) return SendError(playerid, "�� ������� ������ �� �������.");
            if(BoxInfo[idx][boxItems][i] == 0) return SendError(playerid, "� ������ ����� ������ ���."), ClearBoxItems(playerid, idx, i);
            SetPlayerItem(playerid, 7, p_info[playerid][ID], BoxInfo[idx][boxItems][i], BoxInfo[idx][boxItemsCount][i], BoxInfo[idx][boxItemsIDx][i]);
            ClearBoxItems(playerid, idx, i);
        }
    }
    if(playertextid == BoxButton[playerid][5])
        HidePlayerBox(playerid);
    for(new i = 1; i < 17; i++)
    {
        if(playertextid == PTD_Panel[playerid][i])
        {
            if(p_temp[playerid][Work_ID] != PANEL_WORK) return HideTextDrawForPlayer(playerid, TD_ID_PANEL);
            p_temp[playerid][PanelButton][i - 1] = 1;
            PlayerTextDrawHide(playerid, PTD_Panel[playerid][i]);
            PlayerTextDrawColor(playerid, PTD_Panel[playerid][i], 1182971135);
            PlayerTextDrawSetSelectable(playerid, PTD_Panel[playerid][i], false);
            PlayerTextDrawShow(playerid, PTD_Panel[playerid][i]);
        }
    }
    if(playertextid == PTD_Panel[playerid][17])
    {
        if(p_temp[playerid][Work_ID] != PANEL_WORK) return HideTextDrawForPlayer(playerid, TD_ID_PANEL);
        new count = 0;
        for(new i = 0; i < 16; i++)
        {
            if(p_temp[playerid][PanelButton][i] == 1) count++;
        }
        if(count < 16) return SendError(playerid, "�� �� �������� ��� ���������������.");
        SendMes(playerid, COLOR_BLUE, "�� �������� ��� ���������������.");
        new reason_money = GetPlayerMoneySkill(playerid, p_temp[playerid][PanelSalary], 18);

        if(CheckPlayerMaxSalarySkill(playerid, 18, reason_money))
        {
            SetPlayerMoney(playerid, reason_money, true, "�������� ������ ��������� ������");
            OnServerInfoForMoney[17] += reason_money;
            SendMes(playerid, COLOR_LYELLOW, "� ����� �������� ���������: {"#cLIME"}%d$.", reason_money);

            p_info[playerid][job_skill_salary][18] += reason_money;
        }
        else SendError(playerid, "�� ��������� ��� ���� ���� ���������� ������������ ���������� �������� �������.");

        if(GetPlayerGiveCasket(100, 5) != -1) GivePlayerCasket(playerid, -1);

        SendMes(playerid, COLOR_SEA_WAVE, "������������� �� �����, ���������� �� GPS ���������� � �������� ����� �����.");
        SetPlayerGPS(playerid, 956.7352,-1449.2498,13.5149, 5.0);

        new Float:distance = GetPlayerDistanceFromPoint(playerid, 956.7352,-1449.2498,13.5149);

        new time = floatround(distance) / 500 * 30;
        AntiCheatWarningTime[playerid][0] = timestamp + time;
        AntiCheatWarningTime[playerid][1] = time;

        UpdatePlayerWorkSkill(playerid, 18);

        new idx = p_temp[playerid][PanelIDx];

        PanelHouseInfo[idx][PanelHouseBreaking] = 0;
        PanelHouseInfo[idx][PanelHouseBreakingPayDay] = 0;
        PanelHouseInfo[idx][PanelHouseRepair] = 0;
        PanelHouseInfo[idx][PanelHouseRepairPlayerID] = INVALID_PLAYER_ID;

        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `panel` SET `breaking` = 0, `breakingpayday` = 0, `repair` = 0 WHERE `id` = %d",
        PanelHouseInfo[idx][PanelHouseMySQLIDx]);
        mysql_tquery(con_bd, STRING_GLOBAL);

        UpdatePanel(idx);

        p_temp[playerid][PanelIDx] = -1;
        p_temp[playerid][PanelSalary] = 0;
        for(new i = 0; i < 16; i++) p_temp[playerid][PanelButton][i] = 0;

        CheckPlayerMission(playerid, START_PANEL);
        CheckPlayerMission(playerid, DAILY_PANEL);
        CheckPlayerMission(playerid, ACHIEVEMENT_PANEL);

        CheckPlayerFreelance(playerid, FREELANCE_PANEL);
        CheckPlayerBattlePass(playerid, BATTLEPASS_PANEL);

        UpdateFamilyLevel(playerid);
        UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_PANEL); // ���������: ��������� �������

        HideTextDrawForPlayer(playerid, TD_ID_PANEL);

        for(new i = 0; i < 2; i++)
        {
            if(p_temp[playerid][PanelObject][i] != INVALID_OBJECT_ID)
            {
                DestroyDynamicObject(p_temp[playerid][PanelObject][i]);
                p_temp[playerid][PanelObject][i] = INVALID_OBJECT_ID;
            }
        }
    }
    else if(playertextid == PTD_Panel[playerid][18])
    {
        if(p_temp[playerid][Work_ID] != PANEL_WORK) return HideTextDrawForPlayer(playerid, TD_ID_PANEL);
        for(new i = 0; i < 16; i++) p_temp[playerid][PanelButton][i] = 0;
        SendError(playerid, "�� ���������� �� ��������� ����������������.");
        HideTextDrawForPlayer(playerid, TD_ID_PANEL);
    }
    if(playertextid == PTD_DonateInfo[playerid][33])
    {
        callcmd::donate(playerid, "/0");
        HideTextDrawForPlayer(playerid, TD_ID_DONATE_INFO);
    }
    else if(playertextid == PTD_DonateInfo[playerid][34])
    {
        HideTextDrawForPlayer(playerid, TD_ID_DONATE_INFO);
    }
    return 1;
}
public OnVehicleRespray(playerid, vehicleid, color1, color2)
{
    if(!IsValidVehicle(vehicleid) || p_info[playerid][loggedIn] != 1) return 0;
    return 0;
}

