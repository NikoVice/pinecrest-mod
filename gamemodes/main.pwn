                    {
                        case WEAPON_TEARGAS:
                            if(ammo >= 5) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                        case WEAPON_COLT45, WEAPON_DEAGLE:
                            if(ammo >= 50) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                        case WEAPON_SHOTGUN:
                            if(ammo >= 30) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                        case WEAPON_M4, WEAPON_AK47:
                            if(ammo >= 300) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                        case WEAPON_UZI, WEAPON_MP5:
                            if(ammo >= 150) return SendError(playerid, "У Вас уже есть оружие данного типа.");
                    }
                    GivePlayerInventory(seller_id, 627, -gangWEAPON[id_list][g_Matr]);
                    GivePlayerInventory(seller_id, 628, -count[0]);

                    f_GivePlayerWeapon(playerid, gangWEAPON[id_list][g_Id], count[0]);

                    new tax = GetTaxCount(seller_id, price, TAX_SELL_GUN);

                    // Hardi_Devidson[1](192.168.1.1 M/0.0.1-patch1)[$112345] предложил Jeffrey_Collinz[0](127.0.0.1 PC/0.3.7-R2)[$154321] купить оружие <Rifla>(534)
                    Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] предложил %s[%d](%s %s)[$%d] купить оружие <%s>(%d) за %d$. Налог: %d$",
                        get_name(seller_id), p_info[seller_id][ID], p_temp[seller_id][session_IP], IsPlayerMobile(seller_id) ? "Mobile": "PC", p_info[seller_id][cash],
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                        WEAPON_Name[gangWEAPON[id_list][g_Id]], count[0], price, tax);

                    // Hardi_Devidson[1](192.168.1.1 M/0.0.1-patch1)[$112345] купил у Jeffrey_Collinz[0](127.0.0.1 PC/0.3.7-R2)[$154321] купить оружие <Rifla>(534)
                    Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] купил у %s[%d](%s %s)[$%d] оружие <%s>(%d) за %d$. Налог: %d$",
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                        get_name(seller_id), p_info[seller_id][ID], p_temp[seller_id][session_IP], IsPlayerMobile(seller_id) ? "Mobile": "PC", p_info[seller_id][cash],
                        WEAPON_Name[gangWEAPON[id_list][g_Id]], count[0], price, tax);

                    SendAccess(seller_id, "Вы продали %s оружие %s с %d патронами за %d$. Налог: %d$.", get_name(playerid), WEAPON_Name[gangWEAPON[id_list][g_Id]], count[0], price, tax);
                    SendInfo(playerid, "%s продал Вам оружие %s с %d патронами за %d$. Налог: %d$.", get_name(seller_id), WEAPON_Name[gangWEAPON[id_list][g_Id]], count[0], price, tax);

                    SetPlayerMoney(playerid, -price, true, "");
                    SetPlayerMoney(seller_id, price - tax, true, "");

                    SetFractionWarehouse(MAYOR_LS, fwMoney, tax);
                    return 1;
                }
                case OFFER_ID_CHANGE_VEH_NUMBER:
                {
                    new player_vehicle = p_temp[seller_id][p_listitem][41],
                        seller_id_vehicle = p_temp[seller_id][p_listitem][40];
                    if(!IsPlayerOwnerVehicle(seller_id, seller_id_vehicle))
                        return SendError(playerid, "Произошла не известная ошибка:  PV-1708-4 | Сообщите на форум!");
                    if(!IsPlayerOwnerVehicle(playerid, player_vehicle))
                        return SendError(playerid, "Произошла не известная ошибка:  PV-1708-5 | Сообщите на форум!");
                    //return SendError(playerid, "У игрока нет транспортного средства.");

                    if(strequals(veh_info[player_vehicle][v_number], "NULL"))
                        return SendError(seller_id, "У Вас нет номеров на данном транспортном средстве.");
                    if(strequals(veh_info[seller_id_vehicle][v_number], "NULL"))
                        return SendError(playerid, "У Вас нет номеров на данном транспортном средстве.");

                    new tax = GetTaxCount(seller_id, price, TAX_CHANGE_VEH_NUMBER);

                    SendAccess(seller_id, "Вы обменялись с %s номером на транспортное средство с доплатой %d$. Налог: %d$.", get_name(playerid), price, tax);
                    SendInfo(playerid, "%s обменялся с Вами номером на транспортное средство с доплатой %d$. Налог: %d$.", get_name(seller_id), price, tax);

                    new temphone_number[16];
                    format(temphone_number, 16, "%s", veh_info[player_vehicle][v_number]);
                    format(veh_info[player_vehicle][v_number], 16, "%s", veh_info[seller_id_vehicle][v_number]);
                    format(veh_info[seller_id_vehicle][v_number], 16, "%s", temphone_number);

                    SetPlayerMoney(playerid, -price, true, "");
                    SetPlayerMoney(seller_id, price - tax, true, "");

                    // Обмен номерами транспортного средства
                    // Значения денег указываются ДО проведения операции
                    // [logs] реализовать получение версии клиента
                    // Hardi_Devidson[1](192.168.1.1 M/0.0.1-patch1)[$112345] предложил Jeffrey_Collinz[0](127.0.0.1 PC/0.3.7-R2)[$154321] обменять номер т/с <D 5555 A>(411)[1550] на
                    // <D 3333 A>(454)[13444] за 130000$
                    Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] предложил %s[%d](%s %s)[$%d] обменять номер т/с <%s>(%d)[%d] на <%s>(%d)[%d] за %d$. Налог: %d$",
                        get_name(seller_id), p_info[seller_id][ID], p_temp[seller_id][session_IP], IsPlayerMobile(seller_id) ? "Mobile": "PC", p_info[seller_id][cash],
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                        veh_info[seller_id_vehicle][v_number], GetVehicleModelEx(seller_id_vehicle), veh_info[seller_id_vehicle][v_mysql_id],
                        veh_info[player_vehicle][v_number], GetVehicleModelEx(player_vehicle), veh_info[player_vehicle][v_mysql_id], price, tax);

                    // Hardi_Devidson[1](192.168.1.1 M/0.0.1-patch1)[$112345] предложил Jeffrey_Collinz[0](127.0.0.1 PC/0.3.7-R2)[$154321] обменять номер т/с <%s>(411)[1550] на
                    // <Bobcat>(454)[13444] за 130000$
                    Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] согласился с %s[%d](%s %s)[$%d] обменять номер т/с <%s>(%d)[%d] на <%s>(%d)[%d] за %d$. Налог: %d$",
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                        get_name(seller_id), p_info[seller_id][ID], p_temp[seller_id][session_IP], IsPlayerMobile(seller_id) ? "Mobile": "PC", p_info[seller_id][cash],
                        veh_info[player_vehicle][v_number], GetVehicleModelEx(player_vehicle), veh_info[player_vehicle][v_mysql_id],
                        veh_info[seller_id_vehicle][v_number], GetVehicleModelEx(seller_id_vehicle), veh_info[seller_id_vehicle][v_mysql_id], price, tax);

                    //lastlog(BUY_CAR_PLAYER,"[Пред] обмен номер ТС игроку", GetVehicleModel(player_vehicle), playerid, seller_id, -price);
                    //lastlog(SELL_CAR_PLAYER,"[Cогл] обмен номер ТС у игрока", GetVehicleModel(seller_id_vehicle), seller_id, playerid, price);

                    SaveVehicle(player_vehicle);
                    SaveVehicle(seller_id_vehicle);

                    SetFractionWarehouse(MAYOR_LS, fwMoney, tax);
                    return 1;
                }
                case OFFER_ID_SELL_VEH_NUMBER:
                {
                    new seller_id_vehicle = p_temp[seller_id][p_listitem][40],
                        player_vehicle = GetPlayerOwnerNearestVehicleID(playerid);
                    if(!IsPlayerOwnerVehicle(seller_id, seller_id_vehicle) || GetPlayerOwnerNearestVehicleID(seller_id) != seller_id_vehicle)
                        return SendError(playerid, "Около вас нет транспортного средства.");
                    if(seller_id_vehicle == INVALID_VEHICLE_ID)
                        return SendError(playerid, "У игрока нет транспортного средства.");
                    if(player_vehicle == INVALID_VEHICLE_ID)
                        return SendError(seller_id, "У игрока нет транспортного средства.");

                    new tax = GetTaxCount(seller_id, price, TAX_SELL_VEH_NUMBER);
                    SendAccess(seller_id, "Вы продали %s номер на транспортное средство за %d$. Налог: %d$.", get_name(playerid), price, tax);
                    SendInfo(playerid, "%s продал Вам номер на транспортное средство за %d$. Налог: %d$.", get_name(seller_id), price, tax);

                    format(veh_info[player_vehicle][v_number], 16, "%s", veh_info[seller_id_vehicle][v_number]);
                    format(veh_info[seller_id_vehicle][v_number], 16, "NULL");

                    SaveVehicle(player_vehicle);
                    SaveVehicle(seller_id_vehicle);

                    // Покупка/Продажа номерного знака транспортного средства
                    // Значения денег указываются ДО проведения операции
                    // [logs] реализовать получение версии клиента
                    // Hardi_Devidson[1](192.168.1.1 M/0.0.1-patch1)[$112345] продал Jeffrey_Collinz[0](127.0.0.1 PC/0.3.7-R2)[$154321] номер т/с <D 4441 A>[4] через /sellvehnum за 130000$
                    Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] продал %s[%d](%s %s)[$%d] номер т/с <%s %s>(%d)[%d] через /sellvehnum за %d$. Налог: %d$",
                        get_name(seller_id), p_info[seller_id][ID], p_temp[seller_id][session_IP], IsPlayerMobile(seller_id) ? "Mobile": "PC", p_info[seller_id][cash],
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                        GetVehicleName(player_vehicle), veh_info[player_vehicle][v_number], GetVehicleModelEx(player_vehicle), veh_info[player_vehicle][v_mysql_id], price, tax);
                    // Jeffrey_Collinz[0](127.0.0.1 PC/0.3.7-R2)[$154321] купил у Hardi_Devidson[1](192.168.1.1 Offline)[$112345] номер т/с <D 4441 A>[4] через /sellvehnum за 130000$
                    Log(LOG_player, INFO, "%s[%d](%s %s)[$%d] купил у %s[%d](%s %s)[$%d] номер т/с <%s %s>(%d)[%d] через /sellvehnum за %d$. Налог: %d$",
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash],
                        get_name(seller_id), p_info[seller_id][ID], p_temp[seller_id][session_IP], IsPlayerMobile(seller_id) ? "Mobile": "PC", p_info[seller_id][cash],
                        GetVehicleName(player_vehicle), veh_info[player_vehicle][v_number], GetVehicleModelEx(player_vehicle), veh_info[player_vehicle][v_mysql_id], price, tax);

                    SetPlayerMoney(playerid, -price, true, "");
                    SetPlayerMoney(seller_id, price - tax, true, "");

                    //lastlog(BUY_CAR_PLAYER,"[Пред] продал номер ТС игроку", GetVehicleModel(player_vehicle), playerid, seller_id, -price);
                    //lastlog(SELL_CAR_PLAYER,"[Cогл] купил номер ТС у игрока", GetVehicleModel(seller_id_vehicle), seller_id, playerid, price);

                    SetFractionWarehouse(MAYOR_LS, fwMoney, tax);
                    return 1;
                }
                case OFFER_ID_INVITE:
                {
                    SendAccess(seller_id, "Вы приняли %s в фракцию %s.", get_name(playerid), GetFractionName(p_info[seller_id][member]));
                    SendInfo(playerid, "%s принял Вас в фракцию %s.", get_name(seller_id), GetFractionName(p_info[seller_id][member]));

                    Iter_Remove(gFactionPlayers[p_info[playerid][member]], playerid);

                    p_info[playerid][leader] =
                    p_info[playerid][fwarn] =
                    p_info[playerid][billet_exp] = 0;

                    p_info[playerid][member] = p_info[seller_id][member];
                    Iter_Add(gFactionPlayers[p_info[playerid][member]], playerid);
                    p_info[playerid][rang] = 1;

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `log_fraction` (`PlayerID`, `Member`, `Rang`, `Type`) VALUES (%d, %d, %d, '0')",
                    p_info[playerid][ID], p_info[playerid][member], p_info[playerid][rang]);
                    mysql_tquery(con_bd, STRING_GLOBAL);

                    p_info[playerid][spawn] = SPAWN_FRACTION;

                    SendAccess(playerid, "Вы вступили в \"%s\".", GetFractionName(p_info[playerid][member]));
                    if(p_info[playerid][job] != 0)
                    {
                        Iter_Remove(gJobPlayers[p_info[playerid][job]], playerid);
                        p_info[playerid][job] = 0;
                    }

                    SetPlayerFractionSkin(playerid);
                    if(GetFactionType(p_info[playerid][member]) != FACTION_TYPE_CRIMINAL)
                    {
                        p_info[playerid][fwork] = false;
                        SetPlayerSkinEx(playerid);
                    }

                    if(GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_PD || GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_FBI)
                        p_temp[playerid][StatusOnDuty] = 0;

                    SetPlayerColor(playerid, fraction_color[p_info[playerid][member]]);

                    save_player(playerid);

                    CheckPlayerMission(playerid, START_FRACTION);

                    if(gang(playerid))
                    {
                        /*
                        p_info[playerid][ftop_gkills_week] = 
                        p_info[playerid][ftop_gdeaths_week] = 0;
                        p_info[playerid][ftop_gdamagegive_week] = 
                        p_info[playerid][ftop_gdamagetake_week] = 0;
                        
                        STRING_GLOBAL[0] = EOS;
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `ftop_gkills_week` = 0, `ftop_gdeaths_week`  = 0, `ftop_gdamagegive_week` = 0.0, `ftop_gdamagetake_week` = 0.0 WHERE `id` = %d", p_info[playerid][ID]);
                        mysql_tquery(con_bd, STRING_GLOBAL);
                        */

                        STRING_GLOBAL[0] = EOS;
                        for(new i; i < MAX_FRACTIONS_RANGS-1; i++)
                            f(STRING_GLOBAL, "%s"I"[%d]"W" %s\n", STRING_GLOBAL, i+1, GetFractionRangName(p_info[playerid][member], i+1));
                        ShowPlayerDialog(seller_id, D_FRACTION_GIVERANG, DIALOG_STYLE_LIST, "Выдача ранга", STRING_GLOBAL, "Выбрать", "Отмена");
                        SetPVarInt(seller_id, #GIVE_RANK_ID, playerid);

                        if(Capture_Info[0][gGangZoneID] != INVALID_CRIMINAL_ZONE_ID || Capture_Info[1][gGangZoneID] != INVALID_CRIMINAL_ZONE_ID)
                        {
                            if((Capture_Info[0][gFaction][0] == p_info[playerid][member] || Capture_Info[0][gFaction][1] == p_info[playerid][member]) ||
                                (Capture_Info[1][gFaction][0] == p_info[playerid][member] || Capture_Info[1][gFaction][1] == p_info[playerid][member]))
                            {
                                ShowTextDrawForPlayer(playerid, TD_ID_CAPTURE);
                                CaptureInfoUpdate(playerid, CAPTURE_ID_GANG);
                            }
                        }
                    }
                    if(mafia(playerid) || biker(playerid))
                    {
                        STRING_GLOBAL[0] = EOS;
                        for(new i; i < MAX_FRACTIONS_RANGS-1; i++)
                            f(STRING_GLOBAL, "%s"I"[%d]"W" %s\n", STRING_GLOBAL, i+1, GetFractionRangName(p_info[playerid][member], i+1));
                        ShowPlayerDialog(seller_id, D_FRACTION_GIVERANG, DIALOG_STYLE_LIST, "Выдача ранга", STRING_GLOBAL, "Выбрать", "Отмена");
                        SetPVarInt(seller_id, #GIVE_RANK_ID, playerid);

                        if(BizWar_Info[bWarTime] > 0)
                        {
                            if(BizWar_Info[bMafia][0] == p_info[playerid][member] || BizWar_Info[bMafia][1] == p_info[playerid][member])
                            {
                                ShowTextDrawForPlayer(playerid, TD_ID_CAPTURE);
                                CaptureInfoUpdate(playerid, CAPTURE_ID_MAFIA);
                            }
                        }
                    }

                    Log(LOG_player, INFO, "%s[%d](%s %s) предложил вступить %s[%d](%s %s) в фракцию %s | #Fraction",
                        get_name(seller_id), p_info[seller_id][ID], p_temp[seller_id][session_IP], IsPlayerMobile(seller_id) ? "Mobile": "PC",
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", GetFractionName(p_info[seller_id][member]));

                    Log(LOG_player, INFO, "%s[%d](%s %s) согласился %s[%d](%s %s) вступить в фракцию %s | #Fraction",
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                        get_name(seller_id), p_info[seller_id][ID], p_temp[seller_id][session_IP], IsPlayerMobile(seller_id) ? "Mobile": "PC", GetFractionName(p_info[seller_id][member]));
                    return 1;
                }
                case OFFER_ID_INVITE_FAMILY:
                {
                    new mysql_family_id = p_info[seller_id][family_id],
                        family_idx = GetPlayerFamilyID(seller_id);

                    if(family_idx == -1)
                        return SendError(playerid, "Игрок который пригласил Вас больше не в семье.");

                    SendAccess(seller_id, "Вы приняли %s в семью %s.", get_name(playerid), FamilyData[family_idx][fName]);
                    SendInfo(playerid, "%s принял Вас в семью %s.", get_name(seller_id), FamilyData[family_idx][fName]);

                    p_info[playerid][family_id] = mysql_family_id;
                    p_info[playerid][family_rang] = 1;
                    p_info[playerid][family_mute] =
                    p_info[playerid][family_exp] = 0;
                    p_temp[playerid][family_game_id] = family_idx;

                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s[%d] вступил в семью по приглашению %s[%d].", get_name(playerid), playerid, get_name(seller_id), seller_id);
                    SendFamilyMessage(family_idx, STRING_GLOBAL);

                    FamilyData[family_idx][fMembersCount]++;
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `family` SET `members_count` = %d WHERE `id` = %d",
                        FamilyData[family_idx][fMembersCount], FamilyData[family_idx][fMysqlID]);
                    mysql_tquery(con_bd, STRING_GLOBAL);

                    UpdateFamilyLabel(playerid, true);
                    new year, month, day, tmp_str[16];
                    getdate(year, month, day);
                    format(tmp_str, 16, "%02d/%02d/%d", day, month,year);
                    MysqlUpdatePlayerStr(playerid, "family_enter", tmp_str);

                    SetPlayerSkinEx(playerid);

                    Log(LOG_player, INFO, "%s[%d](%s %s) предложил вступить %s[%d](%s %s) в семью %s | #Family",
                        get_name(seller_id), p_info[seller_id][ID], p_temp[seller_id][session_IP], IsPlayerMobile(seller_id) ? "Mobile": "PC",
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", FamilyData[family_idx][fName]);

                    Log(LOG_player, INFO, "%s[%d](%s %s) согласился %s[%d](%s %s) вступить в семью %s | #Family",
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                        get_name(seller_id), p_info[seller_id][ID], p_temp[seller_id][session_IP], IsPlayerMobile(seller_id) ? "Mobile": "PC", FamilyData[family_idx][fName]);
                    return 1;
                }
                case OFFER_ID_COLLECTOR_PARTY:
                {
                    new idx = -1;
                    for(new i = 0; i < 3; i++)
                    {
                        if(CollectorMembersParty[seller_id][i] != INVALID_PLAYER_ID) continue;
                        idx = i;
                        break;
                    }
                    if(idx == -1)
                    {
                        SendError(seller_id, "Совместно с Вами уже работает максимальное количество человек.");
                        SendError(playerid, "Совместно с %s уже работает максимальное количество человек.", get_name(seller_id));
                        return 1;
                    }

                    CollectorMembersParty[seller_id][idx] = playerid;
                    CollectorParty[playerid] = seller_id;

                    SendAccess(seller_id, "Вы теперь работаете совместно с %s инкассаторами.", get_name(playerid));
                    SendInfo(playerid, "Вы теперь работаете совместно с %s инкассаторами.", get_name(seller_id));
                    return 1;
                }
                case OFFER_ID_ROBBER_PARTY:
                {
                    new idx = -1;
                    for(new i = 0; i < 3; i++)
                    {
                        if(RobberMembersParty[seller_id][i] != INVALID_PLAYER_ID) continue;
                        idx = i;
                        break;
                    }
                    if(idx == -1)
                    {
                        SendError(seller_id, "Совместно с Вами уже работает максимальное количество человек.");
                        SendError(playerid, "Совместно с %s уже работает максимальное количество человек.", get_name(seller_id));
                        return 1;
                    }

                    RobberMembersParty[seller_id][idx] = playerid;
                    RobberParty[playerid] = seller_id;

                    SendAccess(seller_id, "Вы теперь работаете совместно с %s грабителями.", get_name(playerid));
                    SendInfo(playerid, "Вы теперь работаете совместно с %s грабителями.", get_name(seller_id));
                    return 1;
                }
                case OFFER_ID_ELECTRIC_PARTY:
                {
                    new idx = -1;
                    for(new i = 0; i < 3; i++)
                    {
                        if(ElectricMembersParty[seller_id][i] != INVALID_PLAYER_ID) continue;
                        idx = i;
                        break;
                    }
                    if(idx == -1)
                    {
                        SendError(seller_id, "Совместно с Вами уже работает максимальное количество человек.");
                        SendError(playerid, "Совместно с %s уже работает максимальное количество человек.", get_name(seller_id));
                        return 1;
                    }

