    RemoveBuildingForPlayer(playerid, 3425, -370.375, -1446.968, 35.953, 0.250);
    RemoveBuildingForPlayer(playerid, 17298, -366.671, -1422.687, 30.375, 0.250);
    RemoveBuildingForPlayer(playerid, 1454, -372.179, -1434.609, 25.515, 0.250);
    RemoveBuildingForPlayer(playerid, 1454, -369.195, -1434.609, 25.515, 0.250);
    RemoveBuildingForPlayer(playerid, 1454, -366.203, -1434.609, 25.437, 0.250);
    RemoveBuildingForPlayer(playerid, 3276, -362.484, -1446.125, 25.476, 0.250);
    RemoveBuildingForPlayer(playerid, 3276, -361.812, -1407.539, 25.476, 0.250);
    RemoveBuildingForPlayer(playerid, 3276, -360.718, -1435.257, 24.898, 0.250);
    RemoveBuildingForPlayer(playerid, 1454, -363.210, -1434.609, 25.398, 0.250);
    RemoveBuildingForPlayer(playerid, 3276, -358.757, -1423.820, 24.750, 0.250);
    RemoveBuildingForPlayer(playerid, 3276, -356.859, -1412.554, 25.250, 0.250);
    RemoveBuildingForPlayer(playerid, 790, -396.648, -1482.007, 29.648, 0.250);

    Streamer_ToggleAllItems(playerid, STREAMER_TYPE_3D_TEXT_LABEL, true);
    
    Log(LOG_connect, INFO, "%s[-](%s %s) ����� �� ������",
        get_name(playerid), p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC");

    SetPlayerSkin(playerid, 252);

    //if(IsPlayerMobile(playerid)) SetTimerEx("FIXCONNECT_MOBILE", 3000, false, "i", playerid);
    return 1;
}

forward FIXCONNECT_MOBILE(playerid);
