CMD:p(playerid, params[])
{
    if(p_info[playerid][mute] > 0)
        return SendError(playerid, "� ��� ���������� ����.");
    if(p_temp[playerid][tGag] == true)
        return SendError(playerid, "� ��� ����.");
    if(p_temp[playerid][calling] == INVALID_PLAYER_ID)
        return SendError(playerid, "��� ����� �� ������.");

    if(!GetInventoryAmount(playerid, p_info[playerid][active_phone_id]))
    {
        SendError(playerid, "�� �� ������ ������ ��������, ������ ����� ���� ���������:");
        SendError(playerid, "1. � ��� ��� ��������;");
        SendError(playerid, "2. � ��� �� ������ �������� ������� � ������� ������� /phone;");
        return 1;
    }

    if(!p_info[playerid][phone_number]) return SendError(playerid, "� ��� ��� ������ ��������.");

    new id = p_temp[playerid][calling];
    if(id == INVALID_PLAYER_ID) return 1;

    p_temp[id][calling] = playerid;
    p_temp[id][phone_talk] = 1;
    p_temp[playerid][phone_talk] = 1;

    if(GetPVarInt(playerid, "Ether"))
    {
        switch(p_info[playerid][news])
        {
            case RADIO_LS: CallNews[0]++;
            case RADIO_SF: CallNews[1]++;
            case RADIO_LV: CallNews[2]++;
        }
        SetPVarInt(id, "EtherCalled", p_info[playerid][news]);
    }

    SendAccess(playerid, "�� ������� ������ �� %s.", get_name(id));
    SendInfo(id, "%s ������� �� ��� ������.", get_name(playerid));

    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
    SetPlayerChatBubble(playerid, "�������(-�) �� ������", COLOR_MAIN, 20.0, 10000);
    return 1;
}
alias:p("pickup");

CMD:taxi(playerid, params[]) return SendInfo(playerid, "�����������: /call 12");

CMD:smoke(playerid, params[])
{
    if(RegisterPaintBall[playerid] == 2) return SendError(playerid, "�� ����� ��������� ��������� ������������ ����������.");
    if(p_temp[playerid][cossack_robbers_register] == 2) return SendError(playerid, "�� ����� �������-����������� ��������� ������������ ����������.");
    if(player_lobby_status[playerid] == true) return SendError(playerid, "�������� � ����� ��������� ������������ ����������.");
    if(GetPlayerStatusCapture(playerid)) return SendError(playerid, "������������ ���������� �� ����� �������� ���������� � �������� ���������.");
    if(GetInventoryAmount(playerid, 652) == 0) return SendError(playerid, "� ��� ��� ��������.");
    if(p_info[playerid][satiety] < 20) return SendError(playerid, "������� ����� ������, ����� �� ����������.");
    SendAccess(playerid, "�� �������� ��������.");
    SendInfo(playerid, "� ������� ������ ALT ����������� �������.");
    GivePlayerInventory(playerid, 652, -1);
    for(new i = 0; i < 2; i++) p_info[playerid][cigarette_status][i] = 1;
    if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
    SetPlayerAttachedObject(playerid, 1, 1485, 6, 0.015000, -0.035000, 0.006998, -4.199997, 2.700002, 15.899977, 1.000000, 1.000000, 1.000000);
    ApplyAnimation(playerid, "SMOKING", "M_smk_drag", 4.1, 0, 0, 0, 0, 0, 1);
    SetPlayerChatBubble(playerid, "+ 5 HP", COLOR_MAIN, 20.0, 10000);
    GameTextForPlayer(playerid, "~b~+ 5 hp", 1000, 1);
    SendInfo(playerid, "�������� ��������� �� 5.");
    p_info[playerid][pHealth] += 5.0;
    SetPlayerHealth(playerid, p_info[playerid][pHealth]);
    if(p_info[playerid][pHealth] > 100.0)
    {
        p_info[playerid][pHealth] = 100.0;
        SetPlayerHealth(playerid, 100.0);
    }

    if(p_info[playerid][Disease][2] == 3 && GetPlayerDisease(playerid, 3, 10, 1) == 1) // ���� 10 ���������;
    {
        p_info[playerid][Disease][3]++;
        SendInfo(playerid, "� ��� ��������� ����� ����������� - ��� ������ %d �������.", p_info[playerid][Disease][3]);
    }

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "�������� � ������ �������.");
        MeAction(playerid, "������� ������ ���� � ������, ����� ���� ������� �������� � ���������� ������ ��");
        MeAction(playerid, "������� ��������� ������ ���� ����� ��������� � �������� ��������");
        DoAction(playerid, "����������� �������� � ������ ����.");
    }
    return 1;
}

CMD:healme(playerid, params[])
{
    if(RegisterPaintBall[playerid] == 2) return SendError(playerid, "�� ����� ��������� ��������� ������������ ��������.");
    if(p_temp[playerid][cossack_robbers_register] == 2) return SendError(playerid, "�� ����� �������-����������� ��������� ������������ ��������.");
    if(player_lobby_status[playerid] == true) return SendError(playerid, "�������� � ����� ��������� ������������ ��������.");
    if(GetPlayerStatusCapture(playerid)) return SendError(playerid, "������������ �������� �� ����� �������� ���������� � �������� ���������.");
    if(GetInventoryAmount(playerid, 632) == 0) return SendError(playerid, "� ��� ��� �������.");
    if(p_info[playerid][satiety] < 20) return SendError(playerid, "������� ����� ������, ����� �� ����������.");
    if(p_temp[playerid][SparringID] != -1) return SendError(playerid, "� ��������� �� ��������.");
    SetPlayerChatBubble(playerid, "+ 60 HP", COLOR_MAIN, 20.0, 10000);
    GameTextForPlayer(playerid, "~b~+ 60 hp", 1000, 1);
    SendAccess(playerid, "�� ��������������� ��������.");
    SendInfo(playerid, "�������� ��������� �� 60.");
    //SetPVarInt(playerid, "HEAL", GetPVarInt(playerid, "HEAL") -1);
    GivePlayerInventory(playerid, 632, -1);
    GetPlayerHealth(playerid, p_info[playerid][pHealth]);
    p_info[playerid][pHealth] += 60.0;
    if(p_info[playerid][pHealth] > 100.0) p_info[playerid][pHealth] = 100.0;
    SetPlayerHealth(playerid, p_info[playerid][pHealth]);
    ApplyAnimation(playerid,"ped","gum_eat",4.0,0,0,0,0,0,1);

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "������� � �������������� � �������.");
        MeAction(playerid, "������� ������ ���� � ������, ����� ���� ������� ����� ������ ��");
        MeAction(playerid, "������ � ������� ���� �������� �� ������, ����� ���� ������� �� � ���");
        DoAction(playerid, "�������� �� ���.");
    }
    return 1;
}

CMD:mask(playerid, params[])
{
    if(p_temp[playerid][UseMaskFix] == 1) return maskOFF(playerid);
    if(p_info[playerid][p_settings][PACIFIST_MODE])
        return SendError(playerid, "� ������ ��������� ����������. ���������: /pacifistinfo.");
    if(GetInventoryAmount(playerid, 633) == 0) return SendError(playerid, "� ��� ��� �����.");
    SetPlayerChatBubble(playerid, "�����(-�) �����", COLOR_MAIN, 20.0, 10000);
    ApplyAnimation(playerid, "SHOP", "ROB_Shifty", 4.0, 0, 0, 0, 0, 0, 1);
    SetPlayerColor(playerid, 0x4F4F4F00);
    GivePlayerInventory(playerid, 633, -1);
    p_temp[playerid][UseMaskFix] = 1;
    p_temp[playerid][UseMaskTimerFix] = timestamp + 600;
    SendAccess(playerid, "�� ������ �����.");
    SendInfo(playerid, "���� �������������� �� GPS ���������� ������ �� 10 ���.");

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
