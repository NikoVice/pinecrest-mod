            if(sscanf(inputtext, "i", fix_listitem)) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_BANK_SELL), SendError(playerid, "Вводить нужно только цифру пункта.");
            new max_btc = p_info[playerid][bitcoin];
            if(fix_listitem < 1 || fix_listitem > max_btc) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_BANK_SELL), SendError(playerid, "Количество Bitcoin не может быть менее 1 и более %d.", max_btc);
            if(curs_btc == 0) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_BANK_SELL), SendError(playerid, "В данный момент банк не принимает Bitcoin, приходите позднее.");
            p_info[playerid][bitcoin] -= fix_listitem;
            MysqlUpdatePlayerInt(playerid, "bitcoin", p_info[playerid][bitcoin]);
            new actual_curs = floatround(curs_btc * 0.95, floatround_ceil), price = fix_listitem * actual_curs;
            SetPlayerMoney(playerid, price, true, "продал <%d> BTC по курсу <%d$> за <%d$>", fix_listitem, actual_curs, price);

            Log(LOG_player, INFO, "%s[%d](%s %s) продал <%d> BTC по курсу <%d$> за <%d$> | #Bitcoin",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                fix_listitem, actual_curs, price);

            SendAccess(playerid, "Вы продали %d BTC за %d$.", fix_listitem, price);
            ShowVideoCards(playerid, VIDEO_CARDS_TYPE_BANK);
            return 1;
        }
