        return 1;
    }

    else if(pickupid >= help_area[0] && pickupid <= help_area[3])
    {
        if(p_temp[playerid][HelpDialog] != 0) return 1;
        p_temp[playerid][HelpDialog] = 0;
        ShowPlayerDialog(playerid, D_HELP, DIALOG_STYLE_LIST, ""I"Помощь по игре", ""I"[1]"W" Что же такое SA-MP Mobile?\n"I"[2]"W" Что такое Pinecrest Mobile и в чем его плюсы?\n"I"[3]"W" F.A.Q\n"I"[4]"W" Что такое RolePlay и в чем его суть?\n"I"[5]"W" Термины и понятия\n"I"[6]"W" Почему важно использовать ресурсы Pinecrest Mobile?\n"I"[7]"W" Как правильно начать игру и играть дальше?\n"I"[8]"W" Как получить помощь в игре?\n"I"[9]"W" Различия фракций и общественных работ\n"I"[10]"W" Кто такие лидеры и админы?\n"I"[11]"W" Развлечения на сервере\n"I"[12]"W" Первоначальные работы\n"I"[13]"W" Основные работы\n"I"[14]"W" Рыбалка\n"I"[15]"W" Охота\n"I"[16]"W" Ограбление дома\n"I"[17]"W" Ограбление банка\n"I"[18]"W" Ограбление АЗС\n"I"[19]"W" Майнинг ферма\n"I"[20]"W" Биржа труда\n"I"[21]"W" Battle Pass\n"I"[22]"W" Подпольное помещение\n"I"[23]"W" Ежедневные награды\n"I"[24]"W" Ларцы\n"I"[25]"W" Автосалоны\n"I"[26]"W" Аренда транспорта\n"I"[27]"W" Авторынок\n"I"[28]"W" Аукцион контейнеров\n"I"[29]"W" Игра BlackJack", "Далее", "Отмена");
        return 1;
    }
    else if(pickupid >= quest_area[0] && pickupid <= quest_area[3])
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
        Приветствуем тебя, "I"%s,"W" и поздравляем с успешной регистрацией и стартом игры на "I""SERVER"!"W"\n\
        Ты, наверняка, хочешь начать развиваться на сервере и погрузиться в этот красочный разнообразный мир\n\
        с головой, так? Тогда позволь мы поможем тебе и посоветуем, как правильнее начать игру!\n\n\
        Чтобы подзаработать денег и одновременно познакомиться с сервером и его особенностями, мы подготовили\n\
        систему квестов с несколькими сюжетными линиями. Сами задания довольно просты, а по мере их прохождения\n\
        ты будешь получать разные бонусы - от игровой валюты и до уникальных аксессуаров: "I"трость, лопата, клюшка\n\
        для гольфа, кий для бильярда, полицейская дубинка, бита и катана."W"\n\n\
        Помимо квестов на сервере существуют ежедневные задания — мини-поручения, выполняя которые, можно\n\
        подзаработать денег и получить крутые бонусы.\n\n\
        В процессе игры ты познакомишься и с системой достижений, благодаря которой можно получать на работах\n\
        увеличенную зарплату, и с системой ежедневных наград, в рамках которой мы буквально дарим призы за игру.\n\n\
        По всем интересующим тебя вопросам можешь найти ответ в разделе "I"\"Помощь по игре\""W" ("I"/mn > [4] Помощь по\n\
        игре"W") или обратиться к администрации ("I"/ask"W" | "I"/report"W"). Желаем удачи!", p_info[playerid][name]);
        ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"С чего начать?", STRING_GLOBAL, "ОК", "");
        return 1;
    }
    if(pickupid == CREATE_FIMILY)
    {
        p_temp[playerid][TickPickup] = GetTickCount()+7500;
        if(GetPlayerFamilyID(playerid) != -1)
        return SendError(playerid, "Вы уже состоите в семье.");

        if(family_count >= MAX_FAMILY-1)
            return SendError(playerid, "Количество семей превышает лимиты.");

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof STRING_GLOBAL, "\
            "W"Создание семьи стоит: "I"500 Pinecrest Money\n\
            "W"Всего семей: {FF9900}%d\n\
            "W"Введите название семьи:\n\n\
            {AFAFAF}Допустимое значение количества символов от 3 до 20", family_count);

        ShowPlayerDialog(playerid, D_FAMILY_CREATE, DIALOG_STYLE_INPUT, ""I"Создание семьи", STRING_GLOBAL, "Принять", "Назад");
        return 1;
    }
    else if(pickupid == job_invite)
    {
        if(p_temp[playerid][Work_ID] > NONE_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
        STRING_GLOBAL[0] = EOS;

        f(STRING_GLOBAL, "\
            "I"[1]"W" Развозчик пиццы (%d уровень)\n\
            "I"[2]"W" Водитель автобуса (%d уровень)\n\
            "I"[3]"W" Автомеханик (%d уровень)\n\
            "I"[4]"W" Инкассатор (%d уровень)\n\
            "I"[5]"W" Ремонтник дорог (%d уровень)\n\
            "I"[6]"W" Машинист поезда (%d уровень)\n\
            "I"[7]"W" Водитель трамвая (%d уровень)\n\
            "I"[8]"W" Пожарный (%d уровень)\n\
            "I"[9]"W" Пилот (%d уровень)\n\
            "I"[10]"W" Ремонтник панелей (%d уровень)\n\
            "I"[11]"W" Электрик (%d уровень)\n\
            "I"[12]"W" Нефтяник (%d уровень)",
            level_pizzaboy, level_bus, level_mechanic,
            level_collector, level_roadman, level_train,
            level_tram, level_fireman, level_pilot,
            level_panel, level_electric, level_oil);
        ShowPlayerDialog(playerid, D_SELECT_JOB, DIALOG_STYLE_LIST, ""I"Устройство на работу",STRING_GLOBAL, "Далее", "Закрыть");
        return 1;
    }
    else if(pickupid == FamilyPickup[0]) // (Вход);
    {
        if(p_info[playerid][family_id] == -1 ||
            GetPlayerFamilyID(playerid) == -1) return SendError(playerid, "Вы не состоите в семье.");
        if(FamilyData[GetPlayerFamilyID(playerid)][fOffice] != 1) return SendError(playerid, "У Вашей семьи нет офиса.");
        ShowPlayerDialog(playerid, D_FAMILY_ENTER, DIALOG_STYLE_LIST, ""I"Куда выйти?", ""I"[1]"W" Внутрь\n"I"[2]"W" Подземная парковка", "Выбрать", "Отмена");
        return 1;
    }
    else if(pickupid == FamilyPickup[1]) // (Выход);
