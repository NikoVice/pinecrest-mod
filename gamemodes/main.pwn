                    if(iValue < 400 || iValue > 600) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"��������", ""W"������� ID ������������� �������� �� 400 �� 610:", "�����", "������"), SendError(playerid, "ID ������������� �������� ������ ���� �� ����� 400 � �� ����� 611.");
                    if(GetVehicleData(iValue, E_VD_TYPE) == VEHICLE_STATE_BOAT || GetVehicleData(iValue, E_VD_TYPE) == VEHICLE_STATE_PLANE || GetVehicleData(iValue, E_VD_TYPE) == VEHICLE_STATE_TRAIN) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"��������", ""W"������� ID ������������� �������� �� 400 �� 610:", "�����", "������"), SendError(playerid, "�� ����� ����������� ID ����������.");
                    if(iValue == 432 || iValue == 520 || iValue == 425) return ShowPlayerDialog(playerid, D_LOBBY_CREATE_SUBJECT, DIALOG_STYLE_INPUT, ""I"��������", ""W"������� ID ������������� �������� �� 400 �� 610:", "�����", "������"), SendError(playerid, "�� ����� ����������� ID ����������.");
