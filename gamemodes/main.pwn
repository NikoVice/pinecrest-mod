GetMafiaCountBizz(MafiaID)
{
    if(MafiaID == BIKER) return mafia_count[3];
    if(MafiaID == MAFIA_IRAN) return mafia_count[4];
    else return mafia_count[MafiaID-7];
}

MafiaCountBizz(MafiaID, count = -1)
{
    if(MafiaID == BIKER) mafia_count[3] += count;
    else if(MafiaID == MAFIA_IRAN) mafia_count[4] += count;
    else mafia_count[MafiaID-7] += count;
    UpdateInfoFractionWarehouse(MafiaID);
    return 1;
}

