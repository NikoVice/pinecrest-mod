                            {
                                p_temp[playerid][pPressed]++;
                            }
                            new i = p_temp[playerid][pPressed];
                            SetPlayerRaceCheckpoint(playerid,0,BusLSLV[i][0],BusLSLV[i][1],BusLSLV[i][2],BusLSLV[i][3],BusLSLV[i][4],BusLSLV[i][5],7.0);
                            SetPVarInt(playerid, "BusStop", 0);
                        }
                    }
                    else
                    {
                        p_temp[playerid][pPressed]++;
                        new check = 109;
                        if(veh_info[vehicleid][v_temp_job] == JOB_BUS) check = 130;
                        new reason_money = GetPlayerMoneySkill(playerid, check, 10);

                        if(CheckPlayerMaxSalarySkill(playerid, 10, reason_money))
                        {
                            SetPVarInt(playerid, "BusMoney", GetPVarInt(playerid, "BusMoney") + reason_money);
                            SetPlayerMoney(playerid, reason_money, false, "");
                            OnServerInfoForMoney[17] += reason_money;

                            p_info[playerid][job_skill_salary][10] += reason_money;
                        }
                        else SendError(playerid, "За последний час игры было заработано максимальное количество денежных средств.");

                        if(p_temp[playerid][pPressed] == 0 || p_temp[playerid][pPressed] == 10 || p_temp[playerid][pPressed] == 36  || p_temp[playerid][pPressed] == 60 || p_temp[playerid][pPressed] == 69) e_type = 1;
                        else e_type = 0;
                        new i = p_temp[playerid][pPressed];
                        SetPlayerRaceCheckpoint(playerid,e_type,BusLSLV[i][0],BusLSLV[i][1],BusLSLV[i][2],BusLSLV[i][3],BusLSLV[i][4],BusLSLV[i][5],7.0);
                    }
                }
            }
            return 1;
        }
        if(GetPVarInt(playerid, "TypePilot") > 0  && IsPlayerRentedVehicle(playerid, vehicleid) && (veh_info[vehicleid][v_npoId] == JOB_PILOT || veh_info[vehicleid][v_temp_job] == JOB_PILOT))
        {
            new pilot_name[6][32] = {"Los-Santos", "Los-Santos", "San-Fierro", "San-Fierro", "Las-Venturas", "Las-Venturas"}, idx = GetPVarInt(playerid, "TypePilot") - 1;
            switch(p_temp[playerid][pPressed])
            {
                case 0:
                {
                    if(PilotTimer[playerid]) return 1;
                    SendMes(playerid, COLOR_SEA_WAVE, "Производится посадка... Подождите 15 секунд.");
                    Fix_TogglePlayerControllable(playerid, false);
                    PilotTimer[playerid] = SetTimerEx("OnPlayerPilotLoadVehicle", 1000 * 15, true, "i", playerid);
                }
                case 1:
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[Диспетчер]: "W"%s [%d] совершает взлет из аэропорта \"%s\".", get_name(playerid), playerid, pilot_name[idx]);
                    foreach(new i : Player)
