            else return ShowPlayerDialog(playerid, D_BANK_MENU, DIALOG_STYLE_LIST, ""I"Банковские услуги", ""I"[1]"W" {"#cLIGHTRED"}Снять"W" или {"#cGREEN"}положить"W" деньги\n"I"[2]"W" Перевести деньги\n"I"[3]"W" Оплатить дом\n"I"[4]"W" Оплатить бизнес\n"I"[5]"W" Пополнить баланс телефона\n"I"[6]"W" Банковский вклад\n"I"[7]"W" Пенсия\n"I"[8]"W" Штрафы\n{"#cLIGHTRED"}[9] Bitcoin", "Далее", "Отмена");
        }
        case 62:
        {
            if(!response)
                return 1;

            if(!strlen(inputtext))
            {
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                Введите количество денег для перевода "I"%s:"W"\n\n\
                Состояние банковского счета: "I"$%d.", get_name(GetPVarInt(playerid, "ID_TRANS")), p_info[playerid][bank]);
                ShowPlayerDialog(playerid, 62, DIALOG_STYLE_INPUT, ""I"Перевести деньги", STRING_GLOBAL, "Далее", "Отмена");
                return 1;
            }

            new fix_listitem = 0;
            if(sscanf(inputtext, "i", fix_listitem))
            {
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                Введите количество денег для перевода "I"%s:"W"\n\n\
                Состояние банковского счета: "I"$%d.", get_name(GetPVarInt(playerid, "ID_TRANS")), p_info[playerid][bank]);
                ShowPlayerDialog(playerid, 62, DIALOG_STYLE_INPUT, ""I"Перевести деньги", STRING_GLOBAL, "Далее", "Отмена");
                return 1;
            }

            if(!(1000 <= fix_listitem <= 1000000))
            {
                STRING_GLOBAL[0] = EOS;
                SendError(playerid, "Кол-во денежных средств должно быть не менее 1000$ и не более 10000000$.");
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                Введите количество денег для перевода "I"%s:"W"\n\n\
                Состояние банковского счета: "I"$%d.", get_name(GetPVarInt(playerid, "ID_TRANS")), p_info[playerid][bank]);
                ShowPlayerDialog(playerid, 62, DIALOG_STYLE_INPUT, ""I"Перевести деньги", STRING_GLOBAL, "Далее", "Отмена");
                return 1;
            }

            if(p_info[playerid][bank] < fix_listitem)
                return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            new id_trans = GetPVarInt(playerid, "ID_TRANS");
            if(!IsPlayerConnected(id_trans))
                return SendError(playerid, "Игрок не найден.");
            if(id_trans == playerid)
                return SendError(playerid, "Вы ввели свой ID.");
            if(p_info[playerid][p_limite_bank_count]+fix_listitem > 2_500_000)
            {
                SendError(playerid, "Кол-во денежных средств превышает лимит.");
                SendInfo(playerid, "На сегодняшний день для отправки или получения Вам доступно %d$.", 2_500_000-p_info[playerid][p_limite_bank_count]);
                return 1;
            }
            if(p_info[id_trans][p_limite_bank_count]+fix_listitem > 2_500_000)
            {
                SendError(playerid, "Кол-во денежных средств превышает лимит.");
                SendInfo(playerid, "На сегодняшний день для отправки или получения игроку доступно %d$.", 2_500_000-p_info[playerid][p_limite_bank_count]);
                return 1;
            }
            if(p_info[id_trans][loggedIn] != 1)
            {
                SendError(playerid, "Данный игрок не в игре.");
                return 1;
            }

            new tax = GetTaxCount(playerid, fix_listitem, TAX_TRANSFER_BANK);

            p_info[playerid][bank] -= fix_listitem;
            p_info[playerid][p_limite_bank_count] += fix_listitem;

            p_info[id_trans][bank] += fix_listitem - tax;
            p_info[id_trans][p_limite_bank_count] += fix_listitem;

            if(p_info[playerid][bank] < 0 || p_info[id_trans][bank] < 0)
            {
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s[%d] переводил %s[%d]: %d$ | ЗАБАГАЛИ ПЕРЕВОД ДЕНЕГ(!!!)",  get_name(playerid), playerid, get_name(id_trans), id_trans, fix_listitem);
                SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `table_ban` (`Name_Admin`, `Name_Player`, `Ban_Data`, `Unban_Data`, `Ban_Reason`) VALUES ('System', '%e', NOW(), %d, 'Багоюз перевода денег')",
                    get_name(id_trans), timestamp + (365 * 86400));
                mysql_tquery(con_bd, STRING_GLOBAL);

                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `table_ban` (`Name_Admin`, `Name_Player`, `Ban_Data`, `Unban_Data`, `Ban_Reason`) VALUES ('System', '%e', NOW(), %d, 'Багоюз перевода денег')",
                    get_name(playerid), timestamp + (365 * 86400));
                mysql_tquery(con_bd, STRING_GLOBAL);

                Kick(id_trans);
                Kick(playerid);
            }
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank` = %d, `p_limite_bank_count` = %d WHERE `id` = %d",
            p_info[playerid][bank], p_info[playerid][p_limite_bank_count], p_info[playerid][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank` = %d, `p_limite_bank_count` = %d WHERE `id` = %d",
            p_info[id_trans][bank], p_info[id_trans][p_limite_bank_count], p_info[id_trans][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            SendInfo(id_trans, "%s перевел Вам %d$ на банковский счет. Налог: %d$.", get_name(playerid), fix_listitem, tax);
            SendInfo(playerid, "Вы перевели %s %d$ на банковский счет. Налог: %d$.", get_name(id_trans), fix_listitem, tax);

            // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) отправил деньги %s[%d](%s %s) в сумме %d$ через банк
            // [logs] реализовать получение версии клиента
            Log(LOG_player, INFO, "%s[%d](%s %s) отправил через банк деньги %s[%d](%s %s) в сумме %d$. Налог: %d$",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                get_name(id_trans), p_info[id_trans][ID], p_temp[id_trans][session_IP], IsPlayerMobile(id_trans) ? "Mobile": "PC", fix_listitem, tax);

            Log(LOG_player, INFO, "%s[%d](%s %s) получил через банк деньги от %s[%d](%s %s) в сумме %d$. Налог: %d$",
                get_name(id_trans), p_info[id_trans][ID], p_temp[id_trans][session_IP], IsPlayerMobile(id_trans) ? "Mobile": "PC",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", fix_listitem, tax);
                //lastlog(PLAYER_BANK,"отправил деньги [BANK]", -1, playerid, id_trans, fix_listitem);
            SetPVarInt(playerid, "ID_TRANS",INVALID_PLAYER_ID);

            SetFractionWarehouse(MAYOR_LS, fwMoney, tax);

            return 1;
        }

        case D_FRACTION_UNINVITE_OFFLINE:
        {
            if(!response) return 1;
            if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_FRACTION_UNINVITE_OFFLINE, DIALOG_STYLE_INPUT, ""I"ПУ Лидера - Увольнение", ""W"Для увольнения члена Вашей организации введите его имя в поле ниже:", "Уволить", "Закрыть");
            if(GetPlayerID(inputtext) != INVALID_PLAYER_ID) return SendError(playerid, "Игрок в игре.");
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id`, `member`, `rang` FROM `accounts` WHERE `name` = '%e' LIMIT 1", inputtext);
            mysql_tquery(con_bd, STRING_GLOBAL, "leave_offline", "i", playerid);
        }
        case 101:
        {
            new fix_listitem;
            if(sscanf(inputtext, "i", fix_listitem)) return 1;
            if(response)
            {
                if(SRV_ID && 1 <= p_info[playerid][admin] < 7)
                    return SendError(playerid, "Администрации запрещено брать денежные средства с склада.");
                if(p_info[playerid][member] == MAYOR_LS) 
                    return SendError(playerid, "Брать денежные средства с казны штата нельзя.");

                if(fix_listitem < 1 || fix_listitem > 500000) return SendError(playerid, "Денежных средств должно быть не менее 1$ и не более 100000$.");
                if(fix_listitem > GetFractionWarehouse(p_info[playerid][member], fwMoney)) return SendError(playerid, "На складе недостаточно денег.");
                if(p_info[playerid][leader] == 0) return SendError(playerid, "Вы не можете пользоваться этой командой.");
                if(!GetFractionSettings(p_info[playerid][member], fWareHouseStatus) && p_info[playerid][rang] != 10) return SendError(playerid, "Лидер закрыл склад.");
                if(p_info[playerid][p_limite_bank_count] + fix_listitem > 500000) return SendError(playerid, "Вы можете снять %d$.", 100000 - p_info[playerid][p_limite_bank_count]);
                p_info[playerid][p_limite_bank_count] += fix_listitem;
                MysqlUpdatePlayerInt(playerid, "p_limite_bank_count", p_info[playerid][p_limite_bank_count]);

                SetFractionWarehouse(p_info[playerid][member], fwMoney, -fix_listitem);

                SetPlayerMoney(playerid, fix_listitem, true, "");
                SendAccess(playerid, "Вы взяли со склада \"%s\" %d$.", GetFractionName(p_info[playerid][member]), fix_listitem);
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] взял со склада %d$.", get_name(playerid), playerid, fix_listitem);
                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
                //lastlog(PLAYER_MONEY,"[Склад] Снял деньги с казны", -1, playerid, playerid, fix_listitem);

                // [logs] реализовать получение версии клиента
                // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) взял со склада %s %d$
                Log(LOG_player, INFO, "%s[%d](%s %s) взял со склада %s %d$",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    GetFractionName(p_info[playerid][member]), fix_listitem);
            }
            else
            {
                if(fix_listitem < 1) return SendError(playerid, "Денежных средств должно быть не меенее 1$.");
                if(p_info[playerid][cash] < fix_listitem) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                SetFractionWarehouse(p_info[playerid][member], fwMoney, fix_listitem);
                SetPlayerMoney(playerid, -fix_listitem, true, "");
                SendAccess(playerid, "Вы положили на склад \"%s\" %d$.", GetFractionName(p_info[playerid][member]), fix_listitem);
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] положил на склад %d$.", get_name(playerid), playerid, fix_listitem);
                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);


                Log(LOG_player, INFO, "%s[%d](%s %s) положил на склад %s %d$",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    GetFractionName(p_info[playerid][member]), fix_listitem);
            }
        }
