                                    if(statusUse) return AccessoriesPlayerList(playerid, ACCESSORIES_ID_REPAIR), SendError(playerid, "������ ��������� ������������.");
                                    if(InventoryPlayer[playerid][listitem][inv_acc_wear] > 99.8) return AccessoriesPlayerList(playerid, ACCESSORIES_ID_REPAIR), SendError(playerid, "������ ��������� ��� ��� ������������� �������������.");
                                    new biz_id = GetPVarInt(playerid, "bID"), till = b_info[biz_id][_till];
                                    STRING_GLOBAL[0] = EOS;
                                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"�� ������������� ������ ��������������� ��������� \"%s\" �� %d$?", ItemsInfo[itemID][iName], GetPriceRepairAccessories(itemID, InventoryPlayer[playerid][listitem][inv_acc_wear]) * till);
                                    ShowPlayerDialog(playerid, D_RA_REPAIR, DIALOG_STYLE_MSGBOX, ""I"������ ����������", STRING_GLOBAL, "��", "���");
                                    SetPVarInt(playerid, "RA:idx", listitem);
                                }
                                case ACCESSORIES_ID_MATERIAL_COLOR:
                                {
                                    if(!response) return ShowPlayerDialog(playerid, D_RA, DIALOG_STYLE_LIST, ""I"���������� ������", ""I"[1]"W" ��������������� ���������\n"I"[2]"W" �������� ���� ����������\n"I"[3]"W" ������ �� ����������", "�����", "������");
                                    if(statusUse) return AccessoriesPlayerList(playerid, ACCESSORIES_ID_MATERIAL_COLOR), SendError(playerid, "������ ��������� ������������.");
                                    new biz_id = GetPVarInt(playerid, "bID"), till = b_info[biz_id][_till];
                                    STRING_GLOBAL[0] = EOS;
                                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"�� ������������� ������ �������� ���� ���������� \"%s\" �� %d$?", ItemsInfo[itemID][iName], ItemsInfo[itemID][iPrice] / 4 * till);
                                    ShowPlayerDialog(playerid, D_RA_MC, DIALOG_STYLE_MSGBOX, ""I"�������� ���� ����������", STRING_GLOBAL, "��", "���");
                                    SetPVarInt(playerid, "RA:idx", listitem);
                                }
                                case ACCESSORIES_ID_PREMIUM:
                                {
