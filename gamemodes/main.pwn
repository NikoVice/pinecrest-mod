CMD:sellgun(playerid, params[])
{
    if(!gang(playerid)) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    STRING_GLOBAL[0] = EOS;
    for (new j = sizeof(gangWEAPON), i; i < j; i++) {
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%i. %s (матов - %i)\n", STRING_GLOBAL, i+1, WEAPON_Name[gangWEAPON[i][g_Id]], gangWEAPON[i][g_Matr]);
    }
    strcat(STRING_GLOBAL, "\n\n"I"Введите номер пункта, количество патрон, ид игрока, цена\nПример: 1, 100, 3, 5400");
    ShowPlayerDialog(playerid, D_SELL_GUN, DIALOG_STYLE_INPUT, ""I"Продажа оружия", STRING_GLOBAL, "Ввести", "Отмена");
    return 1;
}

GetFractionOnline(Fraction)
{
    new count = 0;
    foreach(new playerid : gFactionPlayers[Fraction])
    {
        if(p_info[playerid][rang] > 4) count ++;
    }
    return count;
}


CMD:clear(playerid, params[])
{
    if((IsPlayerFractionPolice(playerid) && p_info[playerid][rang] >= 3) || p_info[playerid][admin] >= 2)
    {
        if(sscanf(params, "i", params[0])) return SendInfo(playerid, "Используйте: /clear [id игрока]");

        if(params[0] == INVALID_PLAYER_ID)
            return SendError(playerid, "Игрок не найден.");

        if(p_info[params[0]][wanted] == 0)
            return SendError(playerid, "Игрок не находится в розыске.");

        if(GetFractionWarehouse(p_info[playerid][member], fwMate) < 20 && p_info[playerid][admin] < 1)
            return SendError(playerid, "На складе недостаточно материалов.");

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] снял розыск %s [%d].", get_name(playerid), playerid, get_name(params[0]), params[0]);

        SendFractionMessage(POLICE_LS, 0x33CC66FF, STRING_GLOBAL);
        SendFractionMessage(POLICE_SF, 0x33CC66FF, STRING_GLOBAL);
        SendFractionMessage(POLICE_LV, 0x33CC66FF, STRING_GLOBAL);
        SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);

        SendAccess(playerid, "Вы сняли розыск с %s [%d].", get_name(params[0]), params[0]);
        SendInfo(params[0], "%s [%d] снял с Вас розыск.", get_name(playerid), playerid);

        SetFractionWarehouse(p_info[playerid][member], fwPatron, -20);

        SetPlayerWantedLevel(params[0],0);
        p_info[params[0]][wanted] = 0;

        p_info[playerid][fracdata][4]++;
        SaveFracData(playerid);

        CheckPlayerMission(playerid, POLICE_UNSU);

        UpdateFamilyLevel(playerid);

        p_info[playerid][ftop_unsu]++;
        MysqlUpdatePlayerInt(playerid, "ftop_unsu", p_info[playerid][ftop_unsu]);

        if(p_info[playerid][p_settings][ROLEPLAY] == 1)
        {
            DoAction(playerid, "Планшет весит на поясе и он отключен.");
            MeAction(playerid, "вытащил из пояса планшет, затем активировал его");
            DoAction(playerid, "Планшет активирован.");
            MeAction(playerid, "зашел в базу данных Министерства, после ввел данные в базу о нарушителе, закрыл базу");
            DoAction(playerid, "Данные были введены и сохранены.");
        }
    }
    else SendError(playerid, "Вы не можете пользоваться этой командой.");
    return 1;
}



//ЛИДЕР/MEMBER
CMD:storage(playerid, params[])
{
    if(p_info[playerid][rang] < 9) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    SetFractionSettings(p_info[playerid][member], fWareHouseStatus, !GetFractionSettings(p_info[playerid][member], fWareHouseStatus));
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s %s [%d] %s склад.", GetFactionType(p_info[playerid][member]) == FACTION_TYPE_GOS ? "[R]" : "[F]", get_name(playerid), playerid, GetFractionSettings(p_info[playerid][member], fWareHouseStatus) ? "открыл" : "закрыл");
    SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
    return 1;
}

CMD:fcs(playerid, params[])
{
    if(p_info[playerid][rang] < 9) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(GetFactionType(p_info[playerid][member]) == FACTION_TYPE_GOS || GetFactionType(p_info[playerid][member]) == FACTION_TYPE_SNN) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    SetFractionSettings(p_info[playerid][member], fDressingStatus, !GetFractionSettings(p_info[playerid][member], fDressingStatus));
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s %s [%d] %s склад одежды.", GetFactionType(p_info[playerid][member]) == FACTION_TYPE_GOS ? "[R]" : "[F]", get_name(playerid), playerid, GetFractionSettings(p_info[playerid][member], fDressingStatus) ? "открыл" : "закрыл");
    SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
    return 1;
}

CMD:fdoor(playerid, params[])
{
    if(p_info[playerid][rang] < 10) return SendError(playerid, "У Вас нет доступа.");
    new member_id = p_info[playerid][leader];
    if(GetFactionCategory(p_info[member_id][member]) != FACTION_CATEGORY_GANG || GetFactionCategory(p_info[member_id][member]) != FACTION_CATEGORY_SNN)
    {
        new member_id = p_info[playerid][leader];
        SetFractionSettings(member_id, fDoorStatus, !GetFractionSettings(member_id, fDoorStatus));
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] %s дверь фракции.", get_name(playerid), playerid, GetFractionSettings(member_id, fDoorStatus) ? "открыл" : "закрыл");
        SendFractionMessage(member_id, 0x33CC66FF, STRING_GLOBAL);
        callcmd::fraction(playerid, "/0");
    }
    return 1;
}


CMD:fraction(playerid, params[])
{
    if(!p_info[playerid][member])
        return SendError(playerid, "Вы не состоите в фракции.");

    ShowPlayerDialog(playerid, D_FRACTION_MENU, DIALOG_STYLE_LIST, ""I"Меню фракции",
        ""I"[1] "W"Меню управления (7+)\n\
        "I"[2] "W"Состав [online]\n\
        "I"[3] "W"Состав [offline]\n\
        "I"[4] "W"Статистика в фракции\n\
        "I"[5] "E"Уволиться из фракции", "Выбрать", "Отмена");
    return 1;
}
alias:fraction("fr", "fract", "lmenu", "leadermenu");

forward leave_offline(playerid);
public leave_offline(playerid)
{
    new rows, members, rangs, mysql_player_id;
    cache_get_row_count(rows);
    if(!rows) return SendError(playerid, "Ничего не найдено.");
    cache_get_value_name_int(0, "id", mysql_player_id);
    cache_get_value_name_int(0, "member", members);
    cache_get_value_name_int(0, "rang", rangs);
    if(p_info[playerid][rang] <= rangs) return SendError(playerid, "У Вас слишком маленький ранг во фракции.");
    if(p_info[playerid][member] != members) return SendError(playerid, "Игрок не состоит во фракции.");

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `log_fraction` (`PlayerID`, `Member`, `Rang`, `Type`, `Reason`) VALUES (%d, %d, %d, '1', 'Оффлайн увал')", mysql_player_id, members, rangs);
    mysql_tquery(con_bd, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `leader` = 0, `member` = 0, `rang` = 0, `fskin` = 0, `spawn` = 0, `fwork` = 0 WHERE `id` = %d", mysql_player_id);
    mysql_tquery(con_bd, STRING_GLOBAL);

    Log(LOG_player, INFO, "[%d] был уволен %s[%d](%s %s) из %s. Причина: оффлайн | #Fraction",
        mysql_player_id, get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", GetFractionName(p_info[playerid][member]));

    Log(LOG_player, INFO, "%s[%d](%s %s) уволил [%d] из %s. Причина: оффлайн | #Fraction",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", mysql_player_id, GetFractionName(p_info[playerid][member]));

    SendAccess(playerid, "Вы уволили игрока из фракции.");
    return true;
}
CMD:invite(playerid, params[])
{
    if(p_info[playerid][rang] < 9) return SendError(playerid, "Вы не можете пользоваться этой командой.");

    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /invite [id игрока]");
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не найден.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(p_info[params[0]][warn_time] > timestamp) return SendError(playerid, "У игрока есть предупреждение.");
    if(GetPVarInt(params[0],"BoneStol_ID")) return 1;
    if(p_temp[params[0]][bl_fraction][p_info[playerid][member]] == true) return SendError(playerid, "Игрок в чёрном списке фракции.");
    if(p_info[params[0]][level] < 2) return SendError(playerid, "У игрока нет 2 уровня.");
    switch(p_info[playerid][member])
    {
        case POLICE_LS, POLICE_SF, POLICE_LV, POLICE_RC:
        {
            if(!p_info[params[0]][billet_army]) SendInfo(playerid, "Предупреждение, у данного игрока нет военного билета.");
        }
        case FBI_TEAM:
        {
            if(!p_info[params[0]][billet_cop]) SendInfo(playerid, "Предупреждение, у данного игрока нет полицейского билета.");
        }
        default: if(p_info[params[0]][member] != 0) return SendError(playerid, "Игрок состоит во фракции.");
    }
    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, ""W"Вы хотите предложить "I"%s "W"вступить в фракцию \"%s\"", get_name(params[0]), GetFractionName(p_info[playerid][member]));
    ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"Принять в фракцию", STRING_GLOBAL, "Далее", "Отмена");
    SetOfferData(playerid, params[0], OFFER_ID_INVITE);
    return true;
}
CMD:uninvite(playerid, params[])
{
    if(sscanf(params, "us[144]", params[0], params[1])) return SendInfo(playerid, "Используйте: /uninvite [id игрока] [причина]");
    if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не найден.");
    if(p_info[playerid][member] == MAYOR_LS && p_info[params[0]][member] != MAYOR_LS)
    {
        if(p_info[params[0]][leader] != 0) return SendError(playerid, "Игрок лидер фракции.");
        switch(p_info[playerid][rang])
        {
            case 8:
            {
                if(GetFactionCategory(p_info[params[0]][member]) != FACTION_CATEGORY_PD)
                    return SendError(playerid, "Игрок не состоит в полиции.");
            }
            case 7:
            {
                if(GetFactionCategory(p_info[params[0]][member]) != FACTION_CATEGORY_ARMY)
                    return SendError(playerid, "Игрок не состоит в армии.");
            }
            case 6:
            {
                if(GetFactionCategory(p_info[params[0]][member]) != FACTION_CATEGORY_MEDIC)
                    return SendError(playerid, "Игрок не состоит в больнице.");
            }
            case 5:
            {
                if(GetFactionCategory(p_info[params[0]][member]) != FACTION_CATEGORY_SNN)
                    return SendError(playerid, "Игрок не состоит в радиоцентре.");
            }
            default: return SendError(playerid, "Вы не министр.");
        }
    }
    else
    {
        if(p_info[playerid][rang] < 8) return SendError(playerid, "Вы не можете пользоваться этой командой.");
        if(p_info[params[0]][member] != p_info[playerid][member]) return SendError(playerid, "Игрок не состоит во фракции.");
        if(p_info[params[0]][leader] == p_info[playerid][member]) return 1;
        if(p_info[params[0]][rang] >= p_info[playerid][rang]) return 1;
    }
    if(AdvertisingCheck(params[1])) return AdvertisingPunishment(playerid, params[1], 0);
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы уволили %s [%d] из \"%s\". Причина: %s", get_name(params[0]), params[0], GetFractionName(p_info[playerid][member]), params[1]);
    SendAccess(playerid, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s [%d] уволил Вас из \"%s\". Причина: %s", get_name(playerid), playerid, GetFractionName(p_info[playerid][member]), params[1]);
    SendInfo(params[0], STRING_GLOBAL);

    Log(LOG_player, INFO, "%s[%d](%s %s) был уволен %s[%d](%s %s) из %s. Причина: %s | #Fraction",
        get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", GetFractionName(p_info[playerid][member]), params[1]);

    Log(LOG_player, INFO, "%s[%d](%s %s) уволил %s[%d](%s %s) из %s. Причина: %s | #Fraction",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC", GetFractionName(p_info[playerid][member]), params[1]);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `log_fraction` (`PlayerID`, `Member`, `Rang`, `Type`, `Reason`) VALUES (%d, %d, %d, '1', '%s')",
    p_info[params[0]][ID], p_info[params[0]][member], p_info[params[0]][rang], params[1]);
    mysql_tquery(con_bd, STRING_GLOBAL);

    if(GetPlayerStatusCapture(params[0]))
            HideTextDrawForPlayer(params[0], TD_ID_CAPTURE);

    Iter_Remove(gFactionPlayers[p_info[params[0]][member]], params[0]);
    p_info[params[0]][member] = 0;
    p_info[params[0]][rang] = 0;
    p_info[params[0]][fskin] = 0;
    Iter_Add(gFactionPlayers[p_info[params[0]][member]], params[0]);
    if(GetFreeSlotHouse(params[0]) != p_info[params[0]][house_slots] || p_info[params[0]][key_h_rent] != INVALID_HOUSE_ID) p_info[params[0]][spawn] = 2;
    else p_info[params[0]][spawn] = 0;
    p_info[params[0]][fwork] = false;
    SetPlayerSkinEx(params[0]);
    SetPlayerColor(params[0], fraction_color[0]);
    if(GetFactionCategory(p_info[params[0]][member]) == FACTION_CATEGORY_PD || GetFactionCategory(p_info[params[0]][member]) == FACTION_CATEGORY_FBI)
        p_temp[params[0]][StatusOnDuty] = 0;
    save_player(params[0]);
    f_ResetPlayerWeapons(params[0]);

    /*
    p_info[params[0]][ftop_gkills_week] = 
    p_info[params[0]][ftop_gdeaths_week] = 0;
    p_info[params[0]][ftop_gdamagegive_week] = 
    p_info[params[0]][ftop_gdamagetake_week] = 0;
    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `ftop_gkills_week` = 0, `ftop_gdeaths_week`  = 0, `ftop_gdamagegive_week` = 0.0, `ftop_gdamagetake_week` = 0.0 WHERE `id` = %d", p_info[params[0]][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL);
    */
    return true;
}
CMD:offuninvite(playerid, params[])
{
    if(p_info[playerid][member] == 0 || p_info[playerid][rang] < 9) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(isnull(params) || strlen(params) > 20) return SendInfo(playerid, "Используйте: /offuninvite [никнейм]");
    if(GetPlayerID(params) != INVALID_PLAYER_ID) return SendError(playerid, "Игрок в игре.");
    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id`, `member`, `rang` FROM `accounts` WHERE `name` = '%e' LIMIT 1", params);
    mysql_tquery(con_bd, STRING_GLOBAL, "leave_offline", "i", playerid);
    return true;
}

CMD:leavejob(playerid, params[])
{
    if(p_info[playerid][job] <= 0) return SendError(playerid, "Вы нигде не работаете.");
    if(p_temp[playerid][Work_ID] > NONE_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
    SendAccess(playerid, "Вы уволились с работы.");
    Iter_Remove(gJobPlayers[p_info[playerid][job]], playerid);
    p_info[playerid][job] = 0;
    return 1;
}

CMD:leave(playerid, params[])
{
    if(p_info[playerid][Update][0] == 0 && p_info[playerid][p_vip] < 2 && p_info[playerid][admin] < 1) return SendError(playerid, "У Вас нет улучшения \"Решительности\" или \"VIP Silver\" или \"VIP GOLD\".");
    if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Вы находитесь в транспортном средстве.");
    if(p_info[playerid][member] <= 0) return SendError(playerid, "Вы не состоите во фракции.");
    if(p_info[playerid][leader] > 0 && p_info[playerid][admin] < 1) return SendError(playerid, "Вы лидер фракции.");
    ShowPlayerDialog(playerid, D_FRACTION_LEAVE, DIALOG_STYLE_MSGBOX, ""I"Покинуть фракцию", ""W"Вы действительно хотите покинуть фракцию?","Да","Нет");
    return true;
}

CMD:thetablet(playerid, params[])
{
    if(p_info[playerid][Update][3] == 0) return SendError(playerid, "У Вас нет улучшения \"Планшет\".");
    if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0) return SendError(playerid, "Вы не можете пользоваться планшетом в интерьере или вирт. мире.");
    SetPVarInt(playerid, "bID", REALTOR_BIZZ_ID);
    ShowPlayerDialog(playerid, D_REALTOR, DIALOG_STYLE_LIST, ""I"Риэлторское агентство", "\
    "I"[1]"W" Узнать свободные дома (2500$)\n\
    "I"[2]"W" Узнать свободные бизнесы (5000$)\n\
    "I"[3]"W" Узнать дома, которые скоро освободятся (1250$)\n\
    "I"[4]"W" Узнать бизнесы, которые скоро освободятся (2500$)\n\
    "I"[5]"W" Аукцион домов\n\
    "I"[6]"W" Аукцион бизнесов", "Далее", "Отмена");
    return 1;
}

CMD:rb(playerid, params[])
{
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "У Вас кляп.");
    if(!p_info[playerid][p_settings][CHAT_FRACTION]) return SendError(playerid, "У Вас отключен фракционный чат.");
    if(p_info[playerid][mute] > 0) return SendError(playerid, "У Вас блокировка чата.");
    if(!gos(playerid) && p_info[playerid][member] != RADIO_LS && p_info[playerid][member] != RADIO_SF && p_info[playerid][member] != RADIO_LV) return SendError(playerid, "Вы не состоите в гос. организации.");
    if(!(1 <= strlen(params) <= 80)) return SendError(playerid, "Длина введеного текста должна быть не менее 1 и не более 80 символов.");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "(( [R] [%s] %s [%d]: %s ))", GetPlayerFractionRangName(playerid), get_name(playerid), playerid, params);
    SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
    return 1;
}

CMD:r(playerid, params[])
{
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "У Вас кляп.");
    if(!p_info[playerid][p_settings][CHAT_FRACTION]) return SendError(playerid, "У Вас отключен фракционный чат.");
    if(p_info[playerid][mute] > 0) return SendError(playerid, "У Вас блокировка чата.");
    if(!gos(playerid) && p_info[playerid][member] != RADIO_LS && p_info[playerid][member] != RADIO_SF && p_info[playerid][member] != RADIO_LV) return SendError(playerid, "Вы не состоите в гос. организации.");
    if(!(1 <= strlen(params) <= 80)) return SendError(playerid, "Длина введеного текста должна быть не менее 1 и не более 80 символов.");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[R] [%s] %s [%d]: %s", GetPlayerFractionRangName(playerid), get_name(playerid), playerid, params);
    SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
    if(tipsteron == p_info[playerid][member])
    {
        foreach(new i: Player) {
            if(!p_info[i][loggedIn]) continue;
            if(p_info[i][tipsterlisten] == 1) SendMes(i, 0x33CC66FF, STRING_GLOBAL);
        }
    }
    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "На поясном держателе висит портативная рация.");
        MeAction(playerid, "отцепив портативную рацию нажал на кнопку, после чего передал сообщение");
    }
    return 1;
}
CMD:d(playerid, params[])
{
    if(p_info[playerid][rang] < 4) return 1;
    if(!p_info[playerid][p_settings][CHAT_FRACTION]) return SendError(playerid, "У Вас отключен фракционный чат.");
    if(!gos(playerid) && p_info[playerid][member] != RADIO_LS && p_info[playerid][member] != RADIO_SF && p_info[playerid][member] != RADIO_LV) return SendError(playerid, "Вы не состоите в государственной фракции.");
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "У Вас кляп.");
    if(p_info[playerid][mute] > 0) return SendError(playerid, "У Вас блокировка чата.");
    if(GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_MEDIC && p_info[playerid][rang] < 5) return SendError(playerid, "Пользоваться департаментом можно с 5-ого ранга.");
    if(!(1 <= strlen(params) <= 80)) return SendError(playerid, "Длина введеного текста должна быть не менее 1 и не более 80 символов.");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[D] [%s] [%s] %s[%d]: %s", GetFractionName(p_info[playerid][member]), GetPlayerFractionRangName(playerid), get_name(playerid), playerid, params);

    SendFractionMessage(POLICE_LS, COLOR_LIGHTRED, STRING_GLOBAL);
    SendFractionMessage(POLICE_SF, COLOR_LIGHTRED, STRING_GLOBAL);
    SendFractionMessage(POLICE_LV, COLOR_LIGHTRED, STRING_GLOBAL);
    SendFractionMessage(FBI_TEAM, COLOR_LIGHTRED, STRING_GLOBAL);
    SendFractionMessage(POLICE_RC, COLOR_LIGHTRED, STRING_GLOBAL);
    SendFractionMessage(NATIONAL_GUARD, COLOR_LIGHTRED, STRING_GLOBAL);
    SendFractionMessage(MEDIC_LS, COLOR_LIGHTRED, STRING_GLOBAL);
    SendFractionMessage(MEDIC_SF, COLOR_LIGHTRED, STRING_GLOBAL);
    SendFractionMessage(MEDIC_LV, COLOR_LIGHTRED, STRING_GLOBAL);
    SendFractionMessage(MAYOR_LS, COLOR_LIGHTRED, STRING_GLOBAL);
    SendFractionMessage(PRISON, COLOR_LIGHTRED, STRING_GLOBAL);
    SendFractionMessage(LICENSE, COLOR_LIGHTRED, STRING_GLOBAL);
    SendFractionMessage(RADIO_LS, COLOR_LIGHTRED, STRING_GLOBAL);
    SendFractionMessage(RADIO_SF, COLOR_LIGHTRED, STRING_GLOBAL);
    SendFractionMessage(RADIO_LV, COLOR_LIGHTRED, STRING_GLOBAL);

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "На поясном держателе висит портативная рация.");
        MeAction(playerid, "отцепив портативную рацию нажал на кнопку, после чего передал сообщение");
    }
    return 1;
}
