            if(player_state != PLAYER_STATE_ONFOOT) return 1;
            if(p_info[playerid][job] != JOB_ROADMAN) return SendError(playerid, "Вы не работаете ремонтником дорог.");
            if(p_temp[playerid][Work_ID] != ROADMAN_WORK) return SendError(playerid, "Вы не начали рабочий день.");
            new vehicleid = p_temp[playerid][rented_veh];
            if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "У Вас нет арендованного рабочего транспортного средства.");
            if(veh_info[vehicleid][v_npoType] != NPO_JOB || veh_info[vehicleid][v_npoId] != JOB_ROADMAN) return SendError(playerid, "У Вас нет арендованного рабочего транспортного средства.");
            if(p_temp[playerid][roadman_check]) return SendError(playerid, "У Вас уже есть мешок с мусором.");
            new idx = gAreaInfo[areaid][area_object_id];
            p_temp[playerid][roadman_use_idx] = idx;
            p_temp[playerid][roadman_hash_idx] = RoadCrashHash;
            SendMes(playerid, COLOR_LEMON, "Для сбора мусора нажмите \"ALT\".");
            return 1;
        }
        case TYPE_SITDOWN:
        {
            if(player_state != PLAYER_STATE_ONFOOT) return 1;
            p_temp[playerid][sitdown_id] = gAreaInfo[areaid][area_object_id];
            p_temp[playerid][sitdown_place] = gAreaInfo[areaid][area_idx];
            return 1;
        }
        case TYPE_GRAFFITI:
        {
            if(player_state != PLAYER_STATE_ONFOOT) return 1;
            if(gang(playerid))
            {
                p_temp[playerid][GraffitiID] = gAreaInfo[areaid][area_object_id];
                p_temp[playerid][GraffitiExtingCount] = 0;

                new fGun;
                GetPlayerWeaponData(playerid, 9, fGun, p_temp[playerid][GraffitiAmmo]);
            }
            return 1;
        }
    }

    if(GangSpawnKillZone[0] <= areaid <= GangSpawnKillZone[4])
    {
        if(gang(playerid) && GetPlayerStatusCapture(playerid) == CAPTURE_ID_GANG)
        {
            for(new i = 4; i != -1; i--)
            {
                if(areaid == GangSpawnKillZone[i])
                {
                    if(i+10 != p_info[playerid][member])
                    {
                        new id = GetCaptureID(p_info[playerid][member], i+10);
                        if(id != -1 && (Capture_Info[id][gTime] > 190 || Capture_Info[id][gStatus] == GANG_ZONE_PREPARATION))
                            SendInfo(playerid, "Вы зашли в Spawn Kill зону вражеской банды.");
                    }
                    break;
                }
            }
        }
        return 1;
    }
    
    if(areaid == FamilyGarageArea[0])
    {
        if(p_info[playerid][family_id] == -1 ||
            GetPlayerFamilyID(playerid) == -1) return SendError(playerid, "Вы не состоите в семье.");
        if(FamilyData[GetPlayerFamilyID(playerid)][fOffice] != 1) return SendError(playerid, "У Вашей семьи нет офиса.");
        if(player_state == PLAYER_STATE_DRIVER)
            return ShowPlayerDialog(playerid, D_FAMILY_GARAGE_AREA, DIALOG_STYLE_MSGBOX, ""I"Заехать в гараж?",""W"Вы хотите заехать в гараж?","Да","Нет");
    }
    if(areaid == FamilyGarageArea[1])
    {
        if(GetPlayerVirtualWorld(playerid) == p_temp[playerid][parking_id]+5000)
            return ShowPlayerDialog(playerid, D_FAMILY_GARAGE_AREA, DIALOG_STYLE_MSGBOX, ""I"Выехать из парковки?",""W"Вы хотите выехать из парковки?","Да","Нет");
        if(p_info[playerid][family_id] == -1 ||
            GetPlayerFamilyID(playerid) == -1) return SendError(playerid, "Вы не состоите в семье.");
        if(FamilyData[GetPlayerFamilyID(playerid)][fOffice] != 1 ||
            GetPlayerVirtualWorld(playerid) != GetPlayerFamilyID(playerid)) return SendError(playerid, "У Вашей семьи нет офиса.");
        if(player_state == PLAYER_STATE_DRIVER)
            return ShowPlayerDialog(playerid, D_FAMILY_GARAGE_AREA, DIALOG_STYLE_MSGBOX, ""I"Выехать из гаража?",""W"Вы хотите выехать из гаража?","Да","Нет");
    }
    if(areaid == lspd_pickups[9]) // Гараж авто;
    {
        if(GetFactionType(p_info[playerid][member]) != FACTION_TYPE_GOS
            && p_temp[playerid][keys_door] != POLICE_LS && p_info[playerid][member] != FBI_TEAM && p_info[playerid][Lic][LIC_LAWYER] == 0) return SendError(playerid, "У Вас нет ключей от этих дверей.");
        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
        new vehicleid = GetPlayerVehicleID(playerid);
        if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) >= VEHICLE_STATE_BOAT) return 1;
        TeleportVehicleToPos(vehicleid, 1588.7911,-1443.3262,2006.7629+0.2, 270.0, 1, 4);
        SetCameraBehindPlayer(playerid);
        p_temp[playerid][keys_door] = 0;
        return 1;
    }
    if(areaid == lspd_pickups[10]) // гараж улица авто;
    {
        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
        new vehicleid = GetPlayerVehicleID(playerid);
        if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) >= VEHICLE_STATE_BOAT) return 1;
        TeleportVehicleToPos(vehicleid, 1584.3060,-1629.7429,13.0917+0.2, 70.0, 0, 0);
        SetCameraBehindPlayer(playerid);
        return 1;
    }
    if(areaid == p_temp[playerid][TaxiArea])
    {
        if(p_temp[playerid][p_GPS] == true)
        {
            CancelPlayerGPS(playerid);
            SendInfo(playerid, "Вы достигли места назначения.");
            return 1;
        }
    }
    if(areaid == fbi_door[0])
    {
        if(!gos(playerid)) return 1;
        if(GetPlayerState(playerid) == PLAYER_STATE_PASSENGER) return 1;
        if(vehicleid > 0) {
            SetVehiclePos(vehicleid, -2507.6292,522.6860,-20.4324);
            SetVehicleZAngle(vehicleid, 270.0);
        }
        else {
            SetPlayerPos(playerid, -2507.6292,522.6860,-20.4324);
            SetPlayerFacingAngle(playerid,270.0);
        }
        return 1;
    }
    if(areaid == fbi_door[1])
    {
        if(GetPlayerState(playerid) == PLAYER_STATE_PASSENGER) return 1;
        if(vehicleid > 0)
        {
            SetVehiclePos(vehicleid, -2440.4155,512.6406,29.9148);
            SetVehicleZAngle(vehicleid, 180.0);
        }
        else {
            SetPlayerPos(playerid, -2440.4155,512.6406,29.9148);
            SetPlayerFacingAngle(playerid, 180.0);
        }
        return 1;
    }
    if(areaid == exit_trailer || areaid == exit_cater || areaid == exit_shamil || areaid == exit_enforce)
    {
        new vehicleid = GetPlayerVirtualWorld(playerid);
        if(!IsValidVehicle(vehicleid)) return SpawnPlayer(playerid);
        new Float:vX, Float:vY, Float:vZ;
        GetVehiclePos(vehicleid, vX, vY, vZ);
        SetPlayerPos(playerid, vX+3, vY+1, vZ);
        SetPlayerVirtualWorld(playerid,0);
        SetPlayerInterior(playerid, 0);
        p_temp[playerid][in_enter_vehicle] = INVALID_VEHICLE_ID;
        return 1;
    }
    if(areaid == rs_area)
    {
        new str[14];
        SetPlayerSkin(playerid, ItemsInfo[skinDonate[p_temp[playerid][shop_id]][0]][iModel]);
        format(str,sizeof(str),"%d FM", skinDonate[p_temp[playerid][shop_id]][1]);

        ShowTextDrawForPlayer(playerid, TD_ID_SHOP);
        PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], str);

        p_temp[playerid][shop_id] = 0;
    }
    if(areaid == casino_area)
    {
        if(p_temp[playerid][TextDrawCasinoUse] != false) return 1;
        if(p_info[playerid][member] > 0 && gos(playerid) && p_info[playerid][fwork] == true) return SendError(playerid, "Вы состоите во фракции.");
        if(!GetPVarInt(playerid,"CasinoRang"))//crupe
        {
            SetPVarInt(playerid,"CasinoRang", 1);
            SetPlayerSkin(playerid, p_info[playerid][sex] == 2 ? 171 : 172);
            SendAccess(playerid, "Вы начали рабочий день.");
        }
        else
        {
            DeletePVar(playerid,"CasinoRang");
            SetPlayerSkinEx(playerid);
            SendAccess(playerid, "Вы закончили рабочий день.");
        }
        return 1;
    }
    if(areaid == buy_vehicle_insurance_number)
    {
        if(!IsPlayerOwnerVehicle(playerid, vehicleid) || player_state != PLAYER_STATE_DRIVER)
            return SendError(playerid, "Приобретение номеров доступно только на личном транспортном средстве.");
        if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_VELO_MOPED && GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_MOTO && GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_CAR)
            return SendError(playerid, "Приобретение страховок и номеров доступно только на велосипедах, мотоциклах и автомобилях.");

        ShowPlayerDialog(playerid, D_BUY_VEHICLE_INSURANCE_NUMBER, DIALOG_STYLE_LIST, ""I"Приобретение страховок и номеров", ""I"[1]"W" Приобретение страховки\n"I"[2]"W" Приобретение номера", "Далее", "Отмена");
        return 1;
    }
    if(areaid == MARKET_CUBE || areaid == VEHICLE_MARKET_CUBE || areaid == MINE_POLYGON /*|| areaid == FARM_POLYGON*/)
    {
        if(player_state == PLAYER_STATE_DRIVER || player_state == PLAYER_STATE_PASSENGER)
        {
            new vehicleid = GetPlayerVehicleID(playerid);
            SetVehicleToRespawn(vehicleid);
            SendInfo(playerid, "На данной территории запрещено находиться в транспортном средстве.");
            SendInfo(playerid, "Транспортное средство отправлено на место парковки.");
        }
    }
    if(areaid == treasure_hunter_cube)
    {
        if(player_state == PLAYER_STATE_DRIVER || player_state == PLAYER_STATE_PASSENGER)
        {
            new vehicleid = GetPlayerVehicleID(playerid);
            SetVehicleToRespawn(vehicleid);
            SendInfo(playerid, "На данной территории запрещено находиться в транспортном средстве.");
            SendInfo(playerid, "Транспортное средство отправлено на место парковки.");
        }
        else
        {
            if(p_temp[playerid][Work_ID] == TREASURE_HUNTER_WORK)
            {
                if(p_temp[playerid][t_hunter_status] == true)
                {
                    ShowTextDrawForPlayer(playerid, TD_ID_T_HUNTER_GPS);
                    UpdatePlayerTHunter(playerid);
                }
            }
        }
    }
    if(areaid >= laboratory_areas[0] && areaid <= laboratory_areas[1] && p_temp[playerid][Work_ID] == LABORATORY_WORK)
    {
        if(IsPlayerFractionMedic(playerid))
        {
            SendMes(playerid, COLOR_SEA_WAVE, "Нажмите ALT чтобы разработать медикаменты.");
        }
    }
    if((areaid >= GunFactoryAreasUnload[0] && areaid <= GunFactoryAreasUnload[1]) && p_temp[playerid][Work_ID] == GUN_FACTORY_WORK && p_temp[playerid][GunFactoryCheck] == 1)
    {
        p_temp[playerid][GunFactoryCheck] ^= 1;
        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
        DisablePlayerRaceCheckpoint(playerid);
        p_temp[playerid][GunFactoryCount]++;
        SendMes(playerid, COLOR_LYELLOW, "Вы перенесли {"#cLIME"}%d{"#cLYELLOW"} ящиков с оружием.", p_temp[playerid][GunFactoryCount]);

        new reason_money = 150;

        SetPlayerMoney(playerid, reason_money, true, "зарплата в оружейном заводе");
        OnServerInfoForMoney[16] += reason_money;

        p_temp[playerid][GunFactorySalary] += reason_money;
        SendMes(playerid, COLOR_LYELLOW, "К Вашей зарплате добавлено: {"#cLIME"}%d$.{"#cLYELLOW"} Заработано всего: {"#cLIME"}%d$.", reason_money, p_temp[playerid][GunFactorySalary]);

        SetFractionWarehouse(NATIONAL_GUARD, fwMate, 500);
        SetFractionWarehouse(NATIONAL_GUARD, fwPatron, 500);

        UpdateWarehouseInfo(0);

        ClearAnimations(playerid);
        ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);

        STRING_GLOBAL[0] = EOS;
        if(p_info[playerid][p_settings][INTERFACE])
        {
            f(STRING_GLOBAL, "%d", p_temp[playerid][GunFactoryCount]);
            PlayerTextDrawSetString(playerid, PTD_NewSalary[playerid][2], STRING_GLOBAL);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d$", p_temp[playerid][GunFactorySalary]);
            PlayerTextDrawSetString(playerid, PTD_NewSalary[playerid][1], STRING_GLOBAL);
        }
        else
        {
            f(STRING_GLOBAL, "Progress: %d", p_temp[playerid][GunFactoryCount]);
            PlayerTextDrawSetString(playerid, PTD_Salary[playerid][5], STRING_GLOBAL);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d$", p_temp[playerid][GunFactorySalary]);
            PlayerTextDrawSetString(playerid, PTD_Salary[playerid][6], STRING_GLOBAL);
        }

        AntiCheatWarningTime[playerid][0] = timestamp + 3;
    }
    if((areaid >= RailwayAreasUnload[0] && areaid <= RailwayAreasUnload[1]) && p_temp[playerid][Work_ID] == RAILWAY_WORK && p_temp[playerid][RailwayCheck] == 1)
    {
        p_temp[playerid][RailwayCheck] ^= 1;
        if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
        DisablePlayerRaceCheckpoint(playerid);
        p_temp[playerid][RailwayCount][p_temp[playerid][RailwayIDx]]++;
        new count = p_temp[playerid][RailwayCount][p_temp[playerid][RailwayIDx]];
        SendMes(playerid, COLOR_LYELLOW, "Вы перенесли {"#cLIME"}%d{"#cLYELLOW"} рельс.", count);

        new reason_money = GetPlayerMoneySkill(playerid, 175, 0);
        if(CheckPlayerMaxSalarySkill(playerid, 0, reason_money))
        {
            SetPlayerMoney(playerid, reason_money, true, "зарплата жд завод");
            OnServerInfoForMoney[17] += reason_money;
            p_temp[playerid][RailwaySalary] += reason_money;
            SendMes(playerid, COLOR_LYELLOW, "К Вашей зарплате добавлено: {"#cLIME"}%d$.{"#cLYELLOW"} Заработано всего: {"#cLIME"}%d$.", reason_money, p_temp[playerid][RailwaySalary]);

            p_info[playerid][job_skill_salary][0] += reason_money;
        }
        else SendError(playerid, "За последний час игры было заработано максимальное количество денежных средств.");

        if(GetPlayerGiveCasket(200, 5) != -1) GivePlayerCasket(playerid, 720);
        ClearAnimations(playerid);
        ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);

        UpdatePlayerWorkSkill(playerid, 0);

        CheckPlayerMission(playerid, START_RAILWAY);
        CheckPlayerMission(playerid, DAILY_RAILWAY);
        CheckPlayerMission(playerid, ACHIEVEMENT_RAILWAY);

        CheckPlayerFreelance(playerid, FREELANCE_RAILWAY);
        CheckPlayerBattlePass(playerid, BATTLEPASS_RAILWAY);

        UpdateFamilyLevel(playerid);
        UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_RAILWAY); // Контракты: Железнодорожный завод

        STRING_GLOBAL[0] = EOS;
        if(p_info[playerid][p_settings][INTERFACE])
        {
            f(STRING_GLOBAL, "%d", count);
            PlayerTextDrawSetString(playerid, PTD_NewSalary[playerid][2], STRING_GLOBAL);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d$", p_temp[playerid][RailwaySalary]);
            PlayerTextDrawSetString(playerid, PTD_NewSalary[playerid][1], STRING_GLOBAL);
        }
        else
        {
            f(STRING_GLOBAL, "Progress: %d", count);
            PlayerTextDrawSetString(playerid, PTD_Salary[playerid][5], STRING_GLOBAL);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "%d$", p_temp[playerid][RailwaySalary]);
            PlayerTextDrawSetString(playerid, PTD_Salary[playerid][6], STRING_GLOBAL);
        }

        if(random(2) == 0) SetPlayerRaceCheckpoint(playerid, 1, 2460.1770, -2584.1350, 13.6744, 0.0, 0.0, 0.0, 2.5);
        else SetPlayerRaceCheckpoint(playerid, 1, 2460.1689, -2614.2964, 13.6822, 0.0, 0.0, 0.0, 2.5);

        AntiCheatWarningTime[playerid][0] = timestamp + 3;

        CheckPlayerBot(playerid, 5);
    }

    #if EASTER_STATUS == 1
        if(areaid == easter_area[0])//баба Майя
        {
            if(p_info[playerid][event_quest_id] == MAX_EVENT_QUEST)
                return SendError(playerid, "У меня заданий больше для тебя нет.");

            if(p_info[playerid][event_quest_id] < 1)
            {
                p_info[playerid][event_quest_id] = 1;
                p_info[playerid][event_quest_stage] = 0;
            }

            if(p_info[playerid][event_quest_id] == 5)
            {
                p_info[playerid][event_quest_stage] = 1;
                ShowEasterQuest_Check(playerid);
            }
            if(p_info[playerid][event_quest_id] == 9 && GetInventoryAmount(playerid, 694) >= 1)
            {
                GivePlayerInventory(playerid, 694, -1);
                p_info[playerid][event_quest_stage] = 1;
                ShowEasterQuest_Check(playerid);
            }

            if(2 <= p_info[playerid][event_quest_id] <= 4)
            {
                SetPlayerGPS(playerid, -383.5103,-1446.0826,25.7266, 6.0);
                SendError(playerid, "Выполните поручения владельцы фермы тогда возвращайтесь к Мае.");
            }
            else ShowEasterQuest_Main(playerid);
            return 1;
        }
        if(areaid == easter_area[1])// владелец фермы
        {
            if(p_info[playerid][event_quest_id] == MAX_EVENT_QUEST)
                return SendError(playerid, "У меня заданий больше для тебя нет.");

            if(2 <= p_info[playerid][event_quest_id] <= 4)
                ShowEasterQuest_Main(playerid);
            else 
            {
                SetPlayerGPS(playerid, 1103.8134,-299.8510,73.9851, 6.0);
                SendError(playerid, "Отправляйся к бабушке Мае.");
            }
            return 1;
        }
    #endif
    return 1;
}
public OnPlayerLeaveDynamicArea(playerid, areaid)
{
    if(p_info[playerid][loggedIn] != 1) return 1;
    new player_state = GetPlayerState(playerid);
        //vehicleid = GetPlayerVehicleID(playerid);
    switch(gAreaInfo[areaid][area_type])
    {
        case TYPE_HOUSE:
        {
            if(gAreaInfo[areaid][area_subtype] == AREA_SUBTYPE_HOUSE_G_ENTER)
                p_temp[playerid][p_house_area] = -1;
        }
        case TYPE_BUSINESS:
        {
            if(gAreaInfo[areaid][area_subtype] == AREA_SUBTYPE_BUSINESS_ENTER)
            {
                if(b_info[gAreaInfo[areaid][area_object_id]][_tip] == B_TUNING) HideTextDrawForPlayer(playerid, TD_ID_PRESS_ALT);
            }
        }
        case TYPE_FISHING:
        {
            if(player_state != PLAYER_STATE_ONFOOT) return 1;
            if(fPlayer_Areaid[playerid] != -1)
            {
                new index = fPlayer_Areaid[playerid];

                if(fFishing_Status{index} == false) return 1;

                if(fPlayer_Timerid[playerid] != -1)
                {
                    KillTimer(fPlayer_Timerid[playerid]);
                    fPlayer_Timerid[playerid] = -1;
                }

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Место для рыбалки "W"#%d{"#cMAIN"}\nАрендатор: "W"Нет{"#cMAIN"}\n\nДля начала рыбалки введите /fish", index);
                UpdateDynamic3DTextLabelText(fFishing_Label[index], COLOR_MAIN, STRING_GLOBAL);

                fPlayer_Areaid[playerid] = -1;
                fFishing_Status{index} = false;

                StopFish(playerid, TYPE_FISH_AWAY);
            }
        }
        case TYPE_RADAR:
        {
            p_info[playerid][p_radar_id] = -1;
            p_info[playerid][p_radar] = 0;
        }
        case TYPE_MARKET_VEHICLE:
        {
            if(p_temp[playerid][market_vehicle_id] == gAreaInfo[areaid][area_object_id])
                p_temp[playerid][market_vehicle_id] = -1;
        }
        /*
        case TYPE_TRAFFICLIGHTS:
        {
            if(p_temp[playerid][tl_id] == gAreaInfo[areaid][area_object_id])
            {
                new idx = p_temp[playerid][tl_id];
                p_temp[playerid][tl_id] = -1;
                if(player_state != PLAYER_STATE_DRIVER) return 1;
                if(IsPlayerFractionPolice(playerid) || IsPlayerFractionMedic(playerid)) return 1;
                if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_MOTO &&
                    GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_VELO_MOPED &&
                    GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) != VEHICLE_STATE_CAR) return 1;
                new Float:v_x, Float:v_y, Float:v_z;
                GetVehiclePos(vehicleid, v_x, v_y, v_z);

                if(TL_Data[idx][tl_color] == TLC_RED && ((v_x-7.5 <= TL_Data[idx][tl_object_pos][0] <= v_x+7.5) &&
                    (TL_Data[idx][tl_object_pos][3] == 90.0 || TL_Data[idx][tl_object_pos][3] == 270.0) ||
                    ( v_y-7.5 <= TL_Data[idx][tl_object_pos][1] <=  v_y+7.5) &&
                    (TL_Data[idx][tl_object_pos][3] == 360.0 || TL_Data[idx][tl_object_pos][3] == 180.0)))
                {
                    new price = p_info[playerid][level] < 3 ? 1000 : 2500, list_percent[3] = {90, 80, 70}, vip_idx = p_info[playerid][p_vip];
                    if(vip_idx) price = ((price / 100) * list_percent[vip_idx - 1]);
                    SendInfo(playerid, "Вам выписан штраф %d$ за проезд на красный свет светофора.", price);
                    GivePlayerTicket(0, playerid, price, "Проезд на красный свет светофора.", 1);
                }
                p_temp[playerid][tl_id] = -1;
                return 1;
            }
        }
        */
        case TYPE_MARKET:
        {
            if(p_temp[playerid][market_arend] != -1)
            {
                new idx = p_temp[playerid][market_arend];
                if(MarketInfo[idx][mArea] == areaid)
                {
                    SendInfo(playerid, "Вы отошли слишком далеко от палатки, аренда расторгнута.");
                    OnPlayerLeaveFromMarket(playerid);
                    return 1;
                }
            }
        }
        case TYPE_GREENZONE:
        {
            if(p_temp[playerid][green_zone] == gAreaInfo[areaid][area_object_id])
            {
                p_temp[playerid][green_zone] = -1;
                HideTextDrawForPlayer(playerid, TD_ID_GREEN_ZONE);
                return 1;
            }
        }
        case TYPE_ARMY_POST:
        {
            if(army(playerid)) Post_System_LeaveArea(playerid, gAreaInfo[areaid][area_object_id]);
        }
        case TYPE_MUSIC:
        {
            StopStream(playerid);
        }
        case TYPE_HOOKAH_AREA:
        {
            HookahAreaStatus[playerid] = false;
        }
        case TYPE_CAR_FACTORY:
        {
            new i = gAreaInfo[areaid][area_object_id], idx = gAreaInfo[areaid][area_idx];
            if(CarFactory[i][cfPlayerID][idx] == playerid)
            {
                CarFactory[i][cfPlayerID][idx] = INVALID_PLAYER_ID;
                UpdateCarFactoryStatusPos(i, idx);
                CarFactoryIDx[playerid] = -1;
                CarFactoryType[playerid] = -1;
                HidePlayerCarFactory(playerid);
                ClearAnimations(playerid);
            }
            return 1;
        }
        case TYPE_GHETTOWAR:
        {
            HideTextDrawForPlayer(playerid, TD_ID_PRESS_ALT);
            return 1;
        }
        case TYPE_TRASH:
        {
            HideTextDrawForPlayer(playerid, TD_ID_PRESS_ALT);
            new trashbox = p_temp[playerid][trash_id];
            if(trashbox != -1 &&
                gAreaInfo[areaid][area_object_id] == trashbox)//&&
                //TrashInfo[trashbox][tPlayerUse] == playerid)
            {
                //TrashInfo[trashbox][tPlayerUse] = INVALID_PLAYER_ID;
                HideTextDrawForPlayer(playerid, TD_ID_INVENTORY_OTHER);
            }
            p_temp[playerid][trash_id] = -1;
            return 1;
        }
        case TYPE_CRIMINAL_ZONE:
        {
            if(gAreaInfo[areaid][area_subtype] == AREA_SUBTYPE_GANG_ZONE || gAreaInfo[areaid][area_subtype] == AREA_SUBTYPE_FAMILY_ZONE)
                p_temp[playerid][CriminalZoneID] = INVALID_CRIMINAL_ZONE_ID;
            return 1;
        }
        case TYPE_WORK_GUN_FACTORY:
        {
            new locat = gAreaInfo[areaid][area_object_id];
            if(p_temp[playerid][GunFactoryLocat]-1 == locat)
            {
                GunFactoryWorkTableStat[locat] = false;
                p_temp[playerid][GunFactoryLocat] = 0;
            }
            return 1;
        }
        case TYPE_WORK_RAILWAY_FACTORY:
        {
            new locat = gAreaInfo[areaid][area_object_id];
            if(p_temp[playerid][RailwayLocat]-1 == locat)
            {
                RailwayWorkTableStat[locat] = false;
                p_temp[playerid][RailwayLocat] = 0;
            }
            return 1;
        }
        case TYPE_WORK_TRUCKER_LOAD: return 1;
        case TYPE_WORK_FARM_TREE:
        {
            new idx = gAreaInfo[areaid][area_object_id];
            if(FarmTreeInfo[idx][ftPlayerID] == playerid)
            {
                FarmTreeInfo[idx][ftPlayerID] = INVALID_PLAYER_ID;
                UpdateFarm(TYPE_FARM_TREE, idx);
                p_temp[playerid][FarmTreeIDx] = -1;
                ClearAnimations(playerid);
            }
            p_temp[playerid][farm_use_idx] = -1;
            p_temp[playerid][farm_use_type] = -1;
            p_temp[playerid][farm_extraction_timer] = 0;
        }
        case TYPE_WORK_FARM_MILKER:
        {
            new idx = gAreaInfo[areaid][area_object_id];
            if(FarmMilkerInfo[idx][fmPlayerID] == playerid)
            {
                FarmMilkerInfo[idx][fmPlayerID] = INVALID_PLAYER_ID;
                UpdateFarm(TYPE_FARM_MILKER, idx);
                p_temp[playerid][FarmMilkerIDx] = -1;
                ClearAnimations(playerid);
            }
            p_temp[playerid][farm_extraction_timer] = 0;
            p_temp[playerid][farm_use_idx] = -1;
            p_temp[playerid][farm_use_type] = -1;
        }
        case TYPE_WORK_FARM_WHEAT: return 1;
        case TYPE_WORK_FARM_W_TREE: return 1;
        case TYPE_WORK_FARM_W_MILKER: return 1;
        case TYPE_WORK_FARM_W_PRODUCT: return 1;
        case TYPE_BOX: return 1;
        case TYPE_HUNTING: return 1;
        case TYPE_ATM: return 1;
        case TYPE_COLLECTOR: return 1;
        case TYPE_PANEL: return 1;
        case TYPE_GREEN_HOUSES: return 1;
        case TYPE_GIFT: return 1;
        case TYPE_CONTAINERS:
        {
            HideTextDrawForPlayer(playerid, TD_ID_PRESS_ALT);
            if(p_temp[playerid][container_id] == gAreaInfo[areaid][area_object_id])
                p_temp[playerid][container_id] = -1;
            return 1;
        }
        case TYPE_ICE_RINK:
        {
            #if NEWYEAR_STATUS == 1
                if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return 1;
                SetPlayerSkinEx(playerid);
            #endif
            return 1;
        }
        case TYPE_RESOURCES:
        {
            if(p_temp[playerid][res_extraction_timer] != 0)
            {
                ApplyAnimation(playerid, "PED", "IDLE_chat", 4.1, 0, 1, 1, 0, 1);
                SendError(playerid, "Вы отошли слишком далеко от места добычи ресурсов.");
            }
            p_temp[playerid][res_use_idx] = -1;
            p_temp[playerid][res_use_type] = -1;
            p_temp[playerid][res_extraction_timer] = 0;
        }
        case TYPE_ROB_HOUSE: return 1;
        case TYPE_ROB_BANK: return 1;
        case TYPE_ROB_FUEL: return 1;
        case TYPE_FREELANCE: return 1;
        case TYPE_UNDERGROUND: return 1;
        case TYPE_ROADMAN:
        {
            p_temp[playerid][roadman_use_idx] = -1;
            p_temp[playerid][roadman_hash_idx] = -1;
            return 1;
        }
        case TYPE_SITDOWN:
        {
            if(p_temp[playerid][sitdown_id] == gAreaInfo[areaid][area_object_id] && p_temp[playerid][sitdown_place] == gAreaInfo[areaid][area_idx])
                SitDown_Clear(playerid, p_temp[playerid][sitdown_id], gAreaInfo[areaid][area_idx]);
            return 1;
        }
        case TYPE_GRAFFITI:
        {
            if(p_temp[playerid][GraffitiID] != -1)
            {
                p_temp[playerid][GraffitiID] = -1;
                p_temp[playerid][GraffitiExtingCount] =
                p_temp[playerid][GraffitiAmmo] = 0;
            }
            return 1;
        }
    }
    p_temp[playerid][p_in_pickup] = 0;
    if(Cube_Drive[0] <= areaid <= Cube_Drive[4])
    {
        if(DriveTime[playerid] > 0)
        {
            SendError(playerid, "Вы покинули территорию для тест-драйва.");
            if(DriveAuto[playerid] != INVALID_VEHICLE_ID) DestroyVehicleVEx(DriveAuto[playerid]);
            DriveAuto[playerid] = INVALID_VEHICLE_ID;

            DriveTime[playerid] = 0;

            GangZoneHideForPlayer(playerid, Zone_Drive);
            SetPlayerPos(playerid, 2174.3198,1398.2855,11.4234);
            SetPlayerFacingAngle(playerid, 92.4769);
            SetPlayerInterior(playerid, 0);
            SetPlayerVirtualWorld(playerid, 0);
        }
        return 1;
    }
    if(areaid == treasure_hunter_cube)
    {
        if(p_temp[playerid][Work_ID] == TREASURE_HUNTER_WORK)
        {
            HideTextDrawForPlayer(playerid, TD_ID_T_HUNTER_GPS);
        }
        return 1;
    }
    return 1;
}

forward DrugsOff(playerid);
public DrugsOff(playerid)
{
    p_temp[playerid][WorkCountDrug] = 500;
    DisablePlayerCheckpoint(playerid);
    SetPlayerAttachedObject(playerid, 1, 1279, 6, 0.0, 0.10, -0.2, -110.0, 0.0, 78.0, 1.000000, 1.000000, 1.000000);
    ClearAnimations(playerid);
    ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 1, 0, 0, 1, 1);
    //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
    SendInfo(playerid, "Отнесите наркотики в транспортное средство.");
    return 1;
}

GetPlayerUserID(get_p_ID)
{
    new playerid = INVALID_PLAYER_ID;
    foreach(new i: Player)
    {
        if(!p_info[i][loggedIn] || p_info[i][ID] != get_p_ID) continue;
        playerid = i;
        break;
    }
    return playerid;
}

GetPlayerID(const input_name[])
{
    new
        playerid = INVALID_PLAYER_ID;

    foreach(new i: Player)
    {
        if(!p_info[i][loggedIn]) continue;
        if(strcmp(input_name, get_name(i)))
            continue;

        playerid = i;
        break;
    }
    return playerid;
}

public OnPlayerClickMap(playerid, Float:fX, Float:fY, Float:fZ)
{
    if(p_temp[playerid][TaxiCard] == true)
    {
        if(GetPlayerTaxiDriver(playerid) == INVALID_PLAYER_ID) return SendError(playerid, "В такси нет водителя.");

        new driverid = GetPlayerTaxiDriver(playerid);
        p_temp[playerid][TaxiCard] = false;
        p_temp[driverid][TaxiArea] = CreateDynamicCircle(fX, fY, 6.0, -1, -1, -1, 0);
        SetPlayerGPS(driverid, fX, fY, fZ, 5.0);


        SendInfo(driverid, "%s [%d] отметил место на GPS навигаторе.", get_name(playerid), playerid);
        return 1;
    }
    if(p_temp[playerid][biz_war_map] == true)
    {
        if(BizWar_Info[bWarTime] > 0)
        {
            p_temp[playerid][biz_war_map] = false;
            p_temp[playerid][p_listitem_int] = -1;
            SendError(playerid, "Война за бизнес уже началась.");
            return 1;
        }

        if(!available_gz_pos(fX, fY) || fZ < 1.0)
        {
            SendError(playerid, "В данном месте нельзя начать срелу.");
            SendInfo(playerid, "Территория должна быть рядом с пригородом Las-Venturas.");
            return 1;
        }
        if(timestamp_hour < 10 || timestamp_hour > 23) return SendError(playerid, "Проводить захват бизнеса разрешено с 10:00 до 23:00.");
        if(!(0 <= timestamp_minute <= 5)) return SendError(playerid, "Проводить захват территории разрешено с **:00 до **:05.");
        if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Вы находитесь в транспортном средстве.");
        if(Iter_Count(gFactionPlayers[p_info[playerid][member]]) < 3) return SendError(playerid, "У Вашей фракции слишком мало игроков в игре.");
        new bizz_id = p_temp[playerid][p_listitem_int];
        if(GetFractionOnline(b_info[bizz_id][b_mafia]) < 3) return SendError(playerid, "У \"%s\" слишком мало игроков в игре.", GetFractionName(b_info[bizz_id][b_mafia]));
        if(GetPVarInt(playerid, "FLOOD:CAPTURE") > timestamp) return SendError(playerid, "Вы не можете так часто использовать команды.");
        SetPVarInt(playerid, "FLOOD:CAPTURE", timestamp+10);

        p_temp[playerid][p_listitem_int] = -1;
        p_temp[playerid][biz_war_map] = false;

        if(!IsPlayerInRangeOfPoint(playerid,3.0, b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2])) {
            SendError(playerid, "Вы слишком далеко от бизнеса.");
            return 1;
        }
        new zone_name[32];
        GetPlayer2DZone(playerid, zone_name, 32);

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] из \"%s\" начал захват бизнеса \"%s\". Контроль: \"%s\". Территория: %s.", get_name(playerid), playerid, GetFractionName(p_info[playerid][member]), b_info[bizz_id][_name], GetFractionName(b_info[bizz_id][b_mafia]), zone_name);
        SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
        SendFractionMessage(b_info[bizz_id][b_mafia], 0x33CC66FF, STRING_GLOBAL);
        SendFractionMessage(p_info[playerid][member], 0x33CC66FF, "[F] Встреча состоится через 5 минут.");
        SendFractionMessage(b_info[bizz_id][b_mafia], 0x33CC66FF, "[F] Встреча состоится через 5 минут.");

        get_gz_pos(fX, fY, 80.0, BizWar_Info[bWarPos][0], BizWar_Info[bWarPos][1], BizWar_Info[bWarPos][2], BizWar_Info[bWarPos][3]);
        biz_war_gangzone = GangZoneCreate(BizWar_Info[bWarPos][0], BizWar_Info[bWarPos][1], BizWar_Info[bWarPos][2], BizWar_Info[bWarPos][3]);
        GangZoneShowForAll(biz_war_gangzone, 0xB2B2B2AA);
        GangZoneFlashForAll(biz_war_gangzone, COLOR_RED);

        BizWar_Info[bWarTime] = 450;
        BizWar_Info[bMafia][0] = p_info[playerid][member];
        BizWar_Info[bMafia][1] = b_info[bizz_id][b_mafia];
        BizWar_Info[bCount][0] = 0;
        BizWar_Info[bCount][1] = 0;

        InitTopList(p_info[playerid][member], b_info[bizz_id][b_mafia], CAPTURE_ID_MAFIA, 450);

        SetTimerEx("BizWarTimer", 1000,0,"iii", bizz_id, p_info[playerid][member], BizWar_Info[bMafia][1]);

        foreach(new i:Player)
        {
            if(p_info[i][member] == BizWar_Info[bMafia][0] || p_info[i][member] == BizWar_Info[bMafia][1])
            {
                ShowTextDrawForPlayer(i, TD_ID_CAPTURE);
                CaptureInfoUpdate(i, CAPTURE_ID_MAFIA);
            }
        }
        return 1;
    }
    if(p_info[playerid][admin] >= 1 || p_info[playerid][youtube_adm] >= 1)
    {
        new player_vehicle = GetPlayerVehicleID(playerid);
        if(player_vehicle != INVALID_VEHICLE_ID && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
            TeleportVehicleToPos(player_vehicle, fX, fY, fZ, 0.0, 0, 0, true);
        }
        else
        {
            if(GetPlayerInterior(playerid) != 0)
                SetPlayerInterior(playerid, 0);

            if(GetPlayerVirtualWorld(playerid) != 0)
                SetPlayerVirtualWorld(playerid, 0);

            SetPlayerPosFindZ(playerid, fX, fY, 150.0);
        }
        SendInfo(playerid, "Вы телепортировались по метке на карте (X: %.2f, Y: %.2f, Z: %.2f).", fX, fY, fZ);
    }
    return 1;
}

available_gz_pos ( Float:x, Float:y )
{
    if( x < -2860 || x > 881 || y > 2860 || y < 746 || ( y < 2139 && x < -1852 ) || ( y < 1776 && x < -1712 ) || ( y < 1654 && x < -1240 ) || ( y < 1077 && x < -960 ) ||
        (x > -75.0 && x < 436.0 && y > 1641.0 && y < 2141.0 ) ) return 0 ;
    return 1 ;
}
get_gz_pos ( Float:x, Float:y, Float:radius, &Float:minx, &Float:miny, &Float:maxx, &Float:maxy )
{
    minx = x - radius;
    miny = y - radius;
    maxx = x + radius;
    maxy = y + radius;
    return 1;
}

forward BizWarTimer(i, napad, vlad);
public BizWarTimer(i, napad, vlad)
{
    if(BizWar_Info[bWarTime] > 0)
    {
        if(BizWar_Info[bWarTime] == 180)
        {
            SendFractionMessage(vlad, 0x33CC66FF, "[F] У Вас осталось 3 минуты чтобы отстоять бизнес.");
            SendFractionMessage(napad, 0x33CC66FF, "[F] У Вас осталось 3 минуты чтобы захватить бизнес.");
        }
        if(BizWar_Info[bWarTime] == 60)
        {
            SendFractionMessage(vlad, 0x33CC66FF, "[F] У Вас осталось 1 минута чтобы отстоять бизнес.");
            SendFractionMessage(napad, 0x33CC66FF, "[F] У Вас осталось 1 минута чтобы захватить бизнес.");
        }
        BizWar_Info[bWarTime] --;

        foreach(new playerid:Player)
        {
            if(p_info[playerid][member] == vlad || p_info[playerid][member] == napad)
            {
                CaptureInfoUpdate(playerid, CAPTURE_ID_MAFIA, -1, false);
            }
        }

        SetTimerEx("BizWarTimer",1000, 0, "iii", i,napad,vlad);
    }
    else
    {

        foreach(new playerid:Player)
        {
            if(p_info[playerid][member] == vlad || p_info[playerid][member] == napad)
                HideTextDrawForPlayer(playerid, TD_ID_CAPTURE);
        }

        if(BizWar_Info[bCount][1] > BizWar_Info[bCount][0])
        {
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Вы выиграли захват бизнеса \"%s\". Счет: %d - %d.", b_info[i][_name], BizWar_Info[bCount][0], BizWar_Info[bCount][1]);
            SendFractionMessage(vlad, 0x33CC66FF, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Вы проиграли захват бизнеса \"%s\". Счет: %d - %d.", b_info[i][_name], BizWar_Info[bCount][0], BizWar_Info[bCount][1]);
            SendFractionMessage(napad, 0x33CC66FF, STRING_GLOBAL);

            b_info[i][b_mafia] = vlad;
        }
        else if(BizWar_Info[bCount][0] == BizWar_Info[bCount][1])
        {
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Захват бизнеса \"%s\" закончился. Счет: %d - %d.", b_info[i][_name], BizWar_Info[bCount][0], BizWar_Info[bCount][1]);
            SendFractionMessage(vlad, 0x33CC66FF, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Захват бизнеса \"%s\" закончился. Счет: %d - %d.", b_info[i][_name], BizWar_Info[bCount][0], BizWar_Info[bCount][1]);
            SendFractionMessage(napad, 0x33CC66FF, STRING_GLOBAL);

            b_info[i][b_mafia] = vlad;
        }
        else
        {
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Вы проиграли захват бизнеса \"%s\". Счет: %d - %d.", b_info[i][_name], BizWar_Info[bCount][0], BizWar_Info[bCount][1]);
            SendFractionMessage(vlad, 0x33CC66FF, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] Вы выиграли захват бизнеса \"%s\". Счет: %d - %d.", b_info[i][_name], BizWar_Info[bCount][0], BizWar_Info[bCount][1]);
            SendFractionMessage(napad, 0x33CC66FF, STRING_GLOBAL);

            b_info[i][b_mafia] = napad;

            MafiaCountBizz(vlad, -1);
            MafiaCountBizz(napad, 1);
        }
        save_bizz(i);
        update_bizz(i);

        BizWar_Info[bMafia][0] = 0;
        BizWar_Info[bMafia][1] = 0;

        GangZoneStopFlashForAll(biz_war_gangzone);
        GangZoneHideForAll(biz_war_gangzone);
        GangZoneDestroy(biz_war_gangzone);
        biz_war_gangzone = -1;

        BizWar_Info[bWarTime] = 0;
        BizWar_Info[bCount][0] = 0;
        BizWar_Info[bCount][1] = 0;
    }
}

