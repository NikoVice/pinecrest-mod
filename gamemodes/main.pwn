                            else ShowDialogMarketItemsSellTake(playerid, i);
                            return 1;
                        }
                        case LIST_ID_PLAYER_ACCESSORIES:
                        {
                            if(!(0 <= listitem < 25))  return SendError(playerid, "��������� �� ��������� ������. AC-1811");
                            new idx_dialog_acc = GetPVarInt(playerid, "ACCESSORIES_LIST:ID");
                            DeletePVar(playerid, "ACCESSORIES_LIST:ID");
                            listitem = p_temp[playerid][p_listitem][listitem];
                            new itemID = InventoryPlayer[playerid][listitem][inv_item_id],
