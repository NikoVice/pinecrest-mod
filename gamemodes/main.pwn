CMD:blind( playerid )
{
    if(!GetPVarInt(playerid, "Player:Blinded"))
    {
        TextDrawShowForPlayer(playerid, TD_BlindBackground);
        SetPVarInt(playerid, "Player:Blinded", true);
    }
    else
    {
        TextDrawHideForPlayer(playerid, TD_BlindBackground);
        SetPVarInt(playerid, "Player:Blinded", 0);
        GameTextForPlayer(playerid, "Unblind", 2000, 5);
    }
    return 1;
}

CMD:fj(playerid, params[])
{
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "У Вас кляп.");
    if(p_info[playerid][mute] > 0)
    {
        SendError(playerid, "У Вас блокировка чата.");
        return 0;
    }
    if(p_info[playerid][p_settings][CHAT_JOB] == 0) return SendError(playerid, "У Вас отключен рабочий чат.");
    if(p_temp[playerid][JobChatFix] > timestamp) return SendError(playerid, "Отправлять сообщения в рабочий чат можно раз в 30 секунд.");
    if(p_info[playerid][job] < JOB_BUS) return SendError(playerid, "Вы нигде не работаете.");
    if(!(1 <= strlen(params) <= 80)) return SendError(playerid, "Длина введеного текста должна быть не менее 1 и не более 80 символов.");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);

    p_temp[playerid][JobChatFix] = timestamp + 30;

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[Рабочий чат] %s[%d]: %s", get_name(playerid), playerid, params);

    foreach(new i : Player)
    {
        if(p_info[playerid][job] == p_info[i][job] && p_info[i][p_settings][0] == 1)
        {
            SendMes(i, 0xFFFF00FF, STRING_GLOBAL);
        }
    }
    return 1;
}


