            ShowVideoCards(playerid, VIDEO_CARDS_TYPE_CONTROL, idx);
            
            for(new i = 0; i < p_temp[playerid][p_listitem_int]; i++) p_temp[playerid][p_listitem][i] = -1;
            p_temp[playerid][p_listitem_int] = -1;
            return 1;
