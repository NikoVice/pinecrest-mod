CMD:v(playerid, params[])
{
    if(p_info[playerid][p_vip] == 0 && p_info[playerid][admin] < 2) return 1;
    if(p_info[playerid][mute] > 0) return SendError(playerid, "� ��� ���������� ����.");
    if(p_info[playerid][p_settings][CHAT_VIP] == 0) return SendError(playerid, "� ��� �������� VIP ���.");
    if(p_temp[playerid][VipFix] > timestamp) return SendError(playerid, "�� ������� �������� � VIP ��� ����� %d ���.", p_temp[playerid][VipFix] - timestamp);
    if(isnull(params) || strlen(params) > 144) return SendInfo(playerid, "�����������: /v [�����]");

    foreach(new i : Player)
    {
        if((p_info[i][p_vip] > 0 || p_info[i][admin] > 0) && p_info[playerid][admin] != 15 && p_info[i][p_settings][3] == 1)
        {
            SendMes(i, COLOR_LYELLOW, "[VIP]%s%s {"#cLYELLOW"}%s [%d]: %s", p_info[playerid][admin] > 0 ? " {"#cLIGHTRED"}[A]" : "", p_info[playerid][p_add_vip] == 1 ? " {"#cLIGHTRED"}[ADD]" : "", get_name(playerid), playerid, params);
        }
    }
    new max_time = 30;
    if(p_info[playerid][p_vip] == 3 && p_info[playerid][p_add_vip] == 1) max_time = max_time / 2;
    p_temp[playerid][VipFix] = timestamp + max_time;
    return 1;
}


