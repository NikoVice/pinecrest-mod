                    SetPlayerMoney(playerid, b_info[bizz_id][_price]/2+GetPVarInt(playerid, "dopBiz"), true, "");
                    SendAccess(playerid, "Вы продали бизнес.");
                    update_bizz(bizz_id);
                    save_bizz(bizz_id);

                    DeletePVar(playerid, "dopBiz");
                    ClearOwnerBizz(playerid, bizz_id);

                    switch(b_info[bizz_id][_tip])
                    {
                        case B_TAXI:
                        {
                            p_info[playerid][taxi_rank] = 0;
                            p_info[playerid][taxi_idx] = 0;
                            p_info[playerid][taxi_percent] = 0;
                            p_info[playerid][taxi_salary] = 0;
                            p_info[playerid][taxi_salary_all] = 0;
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `taxi` = 0, `taxi_rank` = 0, `taxi_idx` = 0, `taxi_percent` = 0, `taxi_salary` = 0, `taxi_salary_all` = 0 WHERE `id` = %d",
                            p_info[playerid][ID]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                        }
                        case B_TRUCKER:
                        {
                            p_info[playerid][tc_rank] = 0;
