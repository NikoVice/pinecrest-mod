CMD:dir(playerid, params[])
{
    ShowPlayerDialog(playerid, D_DIR_SHOW, DIALOG_STYLE_LIST, ""I"Справочник", ""I"[1]"W" Механики\n"I"[2]"W" Медики\n"I"[3]"W" Адвокаты\n"I"[4]"W" Частные адвокаты", "Принять", "Отмена");
    return 1;
}

CMD:delveh(playerid, params[])
{
    if(p_info[playerid][admin] < 4  && p_info[playerid][youtube_adm] < 3) return true;
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
    new vehicle_id = GetPlayerVehicleID(playerid);
    if(veh_info[vehicle_id][v_admin] != 1) return 1;
    DestroyVehicleVEx(vehicle_id);
    veh_info[vehicle_id][v_admin] = 0;
    veh_info[vehicle_id][v_lock] = 0;
    SendAccess(playerid, "Вы удалили транспортное средство созданное администрацией.");
    return 1;
}

CMD:givemoney(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 7) return 1;
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "Используйте: /givemoney [id игрока] [кол-во денежных средств]");
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
    SetPlayerMoney(params[0], params[1], true, "админ %s[%d](%s %s) выдал %d$", get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile":"PC", params[1]);
    SendAccess(playerid, "Вы выдали %s [%d] %d$.", get_name(params[0]), params[0], params[1]);
    SendInfo(params[0], "Администратор %s [%d] выдал Вам %d$.", get_name(playerid), playerid, params[1]);
    return 1;
}

CMD:giveveh(playerid, params[])
{
    if(SRV_ID && (!FD(playerid) || p_info[playerid][admin] < 7)) return 1;
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "Используйте: /giveveh [id игрока] [id транспорта]");
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
    //if(params[1] < 400 || params[1] > 610) return SendError(playerid, "ID транспорта должен быть не менее 400 и не более 610.");
    new custom_id = -1;
    if(!(400 <= params[1] <= 612))
    {
        custom_id = GetSlotVehicleModelSync(params[1]);
        if(custom_id == -1) return SendError(playerid, "Данного автомобиля нет в списке Real Cars");
    }
    AddVehicleToPlayer(params[0], params[1], 0);

    // Администратор Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) выдал Durel_Pavel[3](127.0.0.1 PC/0.3.7-R2) транспортное средство <Голубая луна>(144)
    Log(LOG_player, INFO, "Администратор %s[%d](%s %s) выдал %s[%d](%s %s) транспортное средство <%s>(%d)",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC",
        GetVehicleName(INVALID_VEHICLE_ID, params[1]), params[1]);

    SendAccess(playerid, "Вы выдали %s [%d] транспортное средство \"%s\".", get_name(params[0]), params[0], GetVehicleName(INVALID_VEHICLE_ID, params[1]));
    SendInfo(params[0], "Администратор %s [%d] выдал Вам транспортное средство \"%s\".", get_name(playerid), playerid, GetVehicleName(INVALID_VEHICLE_ID, params[1]));
    return 1;
}

CMD:givevip(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 7) return 1;
    if(sscanf(params, "uii", params[0], params[1], params[2])) return SendInfo(playerid, "Используйте: /givevip [id игрока] [тип] [кол-во дней]");
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
    if(params[1] < 1 || params[1] > 3) return SendError(playerid, "Тип должен быть не менее 1 и не более 3.");
    if(params[2] < 1 || params[2] > 60) return SendError(playerid, "Кол-во дней должен быть не менее 1 и не более 60.");

    if(p_info[params[0]][p_vip] != params[1]) p_info[params[0]][p_vip_time] = 0;
    p_info[params[0]][p_vip] = params[1];
    if(p_info[params[0]][p_vip_time]) p_info[params[0]][p_vip_time] += (86400 * params[2]);
    else p_info[params[0]][p_vip_time] = (timestamp + (86400 * params[2]));

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `p_vip` = %d, `p_vip_time` = %d WHERE `id` = %d",
    p_info[params[0]][p_vip], p_info[params[0]][p_vip_time], p_info[params[0]][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL);

    // Администратор Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) выдал Durel_Pavel[3](127.0.0.1 PC/0.3.7-R2) VIP на 14 суток
    Log(LOG_player, INFO, "Администратор %s[%d](%s %s) выдал %s[%d](%s %s) VIP %d на %d суток",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC",
        params[1], params[2]);

    //lastlog(TYPE_LOG_GIVE_VIP,"/givevip", 1000, playerid, params[0], params[1]);
    SendAccess(playerid, "Вы выдали %s [%d] VIP привилегии %d типа на %d дн(-я/-ей).", get_name(params[0]), params[0], params[1], params[2]);
    SendInfo(params[0], "Администратор %s [%d] выдал Вам VIP привилегии %d типа на %d дн(-я/-ей).", get_name(playerid), playerid, params[1], params[2]);
    return 1;
}

CMD:givemusic(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 7) return 1;
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "Используйте: /givemusic [id игрока] [кол-во дней]");
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
    if(params[1] < 1 || params[1] > 60) return SendError(playerid, "Кол-во дней должен быть не менее 1 и не более 60.");

    p_info[params[0]][p_flin_music] = 1;
    if(p_info[params[0]][p_flin_music_time]) p_info[params[0]][p_flin_music_time] += (86400 * params[1]);
    else p_info[params[0]][p_flin_music_time] = (timestamp + (86400 * params[1]));

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `p_flin_music` = %d, `p_flin_music_time` = %d WHERE `id` = %d",
    p_info[params[0]][p_flin_music], p_info[params[0]][p_flin_music_time], p_info[params[0]][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL);

    // Администратор Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) выдал Durel_Pavel[3](127.0.0.1 PC/0.3.7-R2) VIP на 14 суток
    Log(LOG_player, INFO, "Администратор %s[%d](%s %s) выдал %s[%d](%s %s) подписку на %d суток",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC",
        params[1]);

    //lastlog(TYPE_LOG_GIVE_VIP,"/givemusic", 1000, playerid, params[0], params[1]);
    SendAccess(playerid, "Вы выдали %s [%d] подписку на музыку на %d дн(-я/-ей).", get_name(params[0]), params[0], params[1]);
    SendInfo(params[0], "Администратор %s [%d] выдал Вам подписку на музыку на %d дн(-я/-ей).", get_name(playerid), playerid, params[1]);
    return 1;
}

CMD:givelic(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 7) return 1;
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /givelic [id игрока]");
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не найден.");

    for(new i; i != LIC_ALL; i++)
    {
        p_info[params[0]][Lic][i] = 1;
        p_info[params[0]][Lic_Warn][i] = 0;
        p_info[params[0]][Lic_Time][i] = 8760;
    }
    OnPlayerUpdateLicData(params[0]);

    // Администратор Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) выдал Durel_Pavel[3](127.0.0.1 PC/0.3.7-R2) VIP на 14 суток
    Log(LOG_player, INFO, "Администратор %s[%d](%s %s) выдал %s[%d](%s %s) все лицензии на 1 год",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC");

    //lastlog(TYPE_LOG_GIVE_VIP,"/givevip", 1000, playerid, params[0], params[1]);
    SendAccess(playerid, "Вы выдали %s [%d] все лицензии на 1 год.", get_name(params[0]), params[0]);
    SendInfo(params[0], "Администратор %s [%d] выдал Вам все лицензии на 1 год.", get_name(playerid), playerid);
    return 1;
}

CMD:giveflin(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 7) return 1;
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "Используйте: /giveflin [id игрока] [кол-во денежных средств]");
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
    p_info[params[0]][flinmoney] += params[1];
    MysqlUpdatePlayerInt(params[0], "flinmoney", p_info[params[0]][flinmoney]);

    // Администратор Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) выдал Durel_Pavel[3](127.0.0.1 PC/0.3.7-R2) 100 FM
    Log(LOG_player, INFO, "Администратор %s[%d](%s %s) выдал %s[%d](%s %s) %d FM",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC",
        params[1]);
    //lastlog(plaeyr_money,"/giveflin", 1001, playerid, params[0], params[1]);
    SendAccess(playerid, "Вы выдали %s [%d] %d Pinecrest Money.", get_name(params[0]), params[0], params[1]);
    SendInfo(params[0], "Администратор %s [%d] выдал Вам %d Pinecrest Money.", get_name(playerid), playerid, params[1]);
    return 1;
}

CMD:setjob(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 7) return true;
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "Используйте: /setjob [id игрока] [id работы]");
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
    if(p_info[params[0]][member] != 0) return SendError(playerid, "Игрок состоит во фракции.");
    if(!(0 <= params[1] < MAX_JOBS)) return 1;

    if(params[1] == 0)
    {
        Iter_Remove(gJobPlayers[p_info[params[0]][job]], params[0]);
    }
    else
    {
        Iter_Add(gJobPlayers[p_info[params[0]][job]], params[0]);
    }

    p_info[params[0]][job] = params[1];

    SendAccess(playerid, "Вы назначили %s [%d] на должность \"%s\".", get_name(params[0]), params[0], job_name_list[p_info[params[0]][job]]);
    SendInfo(params[0], "Администратор %s [%d] назначил Вас на должность \"%s\".", get_name(playerid), playerid, job_name_list[p_info[params[0]][job]]);
    return 1>0;
}

CMD:gpsfhouse(playerid, params[])
{
    if(IsGPSVisable(playerid) != -1) return 1;
    new family_idx = GetPlayerFamilyID(playerid);
    if(family_idx == -1) return SendError(playerid, "У Вас нет семьи.");
    new fhouse_id = FamilyData[family_idx][fHouseID];
    if(fhouse_id == -1) return SendError(playerid, "У Вашей семьи нет дома.");
    new Float:distance = GetPlayerDistanceFromPoint(playerid, h_info[fhouse_id][h_enter][0], h_info[fhouse_id][h_enter][1], h_info[fhouse_id][h_enter][2]);
    if(p_temp[playerid][TaxiGPS] == true)
    {
        if(GetPlayerTaxiDriver(playerid) == INVALID_PLAYER_ID) return SendError(playerid, "В такси нет водителя.");

        new driverid = GetPlayerTaxiDriver(playerid);
        p_temp[playerid][TaxiGPS] = false;
        SetPlayerGPS(driverid, h_info[fhouse_id][h_enter][0], h_info[fhouse_id][h_enter][1], h_info[fhouse_id][h_enter][2],5.0);

        SendInfo(driverid, "%s обозначил место назначения. Расстояние: %.0f метров.", get_name(playerid), distance);
        return 1;
    }
    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
    SetPlayerGPS(playerid, h_info[fhouse_id][h_enter][0], h_info[fhouse_id][h_enter][1], h_info[fhouse_id][h_enter][2],5.0);
    SendInfo(playerid, "\"Дом\" отмечен на GPS навигаторе. Расстояние: %.0f метров.", distance);
    return 1;
}
CMD:gpshouse(playerid, params[])
{
    if(IsGPSVisable(playerid) != -1) return 1;
    HousePlayerList(playerid, HOUSE_ID_GPS);
    return 1;
}

CMD:gpsbiz(playerid, params[])
{
    if(IsGPSVisable(playerid) != -1) return 1;
    BizzPlayerList(playerid, BIZZ_ID_GPS);
    return 1;
}

CMD:afindcar(playerid, params[])
{
    if(p_temp[playerid][rented_veh] == INVALID_VEHICLE_ID) return SendError(playerid, "У Вас нет арендованного транспортного средства.");

    if(IsGPSVisable(playerid) != -1) return 1;

    new Float:POS[3];
    GetVehiclePos(p_temp[playerid][rented_veh], POS[0], POS[1], POS[2]);

    new Float:distance = GetPlayerDistanceFromPoint(playerid, POS[0], POS[1], POS[2]);

    if(p_temp[playerid][TaxiGPS] == true)
    {
        if(GetPlayerTaxiDriver(playerid) == INVALID_PLAYER_ID) return SendError(playerid, "В такси нет водителя.");

        new driverid = GetPlayerTaxiDriver(playerid);
        p_temp[playerid][TaxiGPS] = false;
        SetPlayerGPS(driverid, POS[0], POS[1], POS[2],5.0);

        SendInfo(driverid, "%s обозначил место назначения. Расстояние: %.0f метров.", get_name(playerid), distance);
        return 1;
    }

    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);

    SetPlayerGPS(playerid, POS[0], POS[1], POS[2],5.0);
    SendInfo(playerid, "\"Транспорт\" отмечен на GPS навигаторе. Расстояние: %.0f метров.", distance);
    return 1;
}


CMD:deltune(playerid, params[])
{
    new vehicleid = GetPlayerOwnerNearestVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "Вы слишком далеко от своего транспортного средства.");

    for (new i; i < v_all-1; i++) if(veh_info[vehicleid][v_tune][i] !=0) RemoveVehicleComponent (vehicleid, veh_info[vehicleid][v_tune][i]);
    if(veh_info[vehicleid][v_tune][v_paintjob] != 0){
        veh_info[vehicleid][v_tune][v_paintjob] = 0;
        ChangeVehiclePaintjob(vehicleid, 3);
    }
    SaveVehicleTuning(vehicleid);
    return 1;
}

CMD:lock(playerid, params[])
{
    new vehicleid = INVALID_VEHICLE_ID,
        Float:distance_min = 999.0, Float:w_distance,
        Float:w_pos_x, Float:w_pos_y, Float:w_pos_z;

    foreach(new i: PlayerVehiclesStream[playerid])
    {
        if(!IsPlayerInRangeOfVehicle(playerid, 8.0, i)) continue;
        if(veh_info[i][v_npoType] == NPO_PLAYERCAR && IsPlayerOwnerVehicle(playerid, i) || 
            veh_info[i][v_npoType] == NPO_ARENDCAR && veh_info[i][v_rented_ID] == p_info[playerid][ID] ||
            veh_info[i][v_npoType] == NPO_TEMPCAR && veh_info[i][v_rented_ID] == p_info[playerid][ID] ||
            veh_info[i][v_npoType] == NPO_ROBBERY_HOUSE && veh_info[i][v_rob_house_idx] == p_temp[playerid][rob_house_idx] ||
            veh_info[i][v_npoType] == NPO_ROBBERY_BANK && veh_info[i][v_rob_bank_idx] == p_temp[playerid][rob_bank_idx] ||
            veh_info[i][v_npoType] == NPO_ROBBERY_FUEL && veh_info[i][v_rob_fuel_idx] == p_temp[playerid][rob_fuel_idx] ||
            veh_info[i][v_npoType] == NPO_FACTION && veh_info[i][v_npoId] == p_info[playerid][member] ||
            IsPlayerRentedVehicle(playerid, i) ||
            veh_info[i][v_npoType] == NPO_FAMILY && veh_info[i][v_family_id] == GetPlayerFamilyID(playerid) ||
            SRV_ID && p_info[playerid][admin] > 0)
        {
            GetVehiclePos(i, w_pos_x, w_pos_y, w_pos_z);
            w_distance = GetPlayerDistanceFromPoint(playerid, w_pos_x, w_pos_y, w_pos_z);
            if(w_distance > distance_min)
                continue;
            distance_min = w_distance;
            vehicleid = i;
            continue;
        }
    }
    
    if(vehicleid == INVALID_VEHICLE_ID) return 1;

    if(GetSlotVehicleMarket(veh_info[vehicleid][v_mysql_id]) != -1)
        return SendError(playerid, "Взаимодействие с транспортным средство невозможно, оно находится на авторынке.");

    veh_info[vehicleid][v_lock] = !veh_info[vehicleid][v_lock];

    if(veh_info[vehicleid][v_lock])
    {
        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) 
        {
            f(STRING_GLOBAL, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~%s locked", GetVehicleName(vehicleid));
            GameTextForPlayer(playerid, STRING_GLOBAL, 1000, 3);
        }
        f(STRING_GLOBAL, "%s закрыл(а) %s", get_name(playerid), GetVehicleName(vehicleid));
    }
    else
    {
        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) 
        {
            f(STRING_GLOBAL, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~%s unlocked", GetVehicleName(vehicleid));
            GameTextForPlayer(playerid, STRING_GLOBAL, 1000, 3);
        }
        f(STRING_GLOBAL, "%s открыл(а) %s", get_name(playerid), GetVehicleName(vehicleid));
    }
    
    PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
    distance_chat(playerid,10.0,0xDE92FFFF,STRING_GLOBAL);
    SetVehicleParamsVEx(vehicleid, veh_info[vehicleid][v_engine], veh_info[vehicleid][v_light], alarm, veh_info[vehicleid][v_lock], bonnet, boot, objective);
    PlayerPlaySound(playerid,21001, 0.0, 0.0, 0.0);
    OnPlayerUpdateVehicleInfo(playerid, SPEEDO_DOORS);
    return 1;
}
CMD:changecar(playerid, params[])
{
    SendInfo(playerid, "Используйте: /trade [ID]");
    return 1;
}

cmd:trade(playerid, params[])
{
    if(GetPlayerVirtualWorld(playerid) > 0 || GetPlayerInterior(playerid) > 0)
        return SendError(playerid, "Трейд доступен только на улице.");
    if(p_info[playerid][exchangePartner] != INVALID_PLAYER_ID)
        return SendError(playerid, "Вы уже участвуете в обмене.");
    new targetid;
    if(sscanf(params, "u", targetid))
        return SendError(playerid, "Введите ID игрока.");
    if(playerid == targetid || targetid == INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок не найден.");
    if(!IsPlayerStream(5.0, playerid, targetid) || pSpectateId[targetid] != INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок слишком далеко от Вас.");
    if(GetPlayerVirtualWorld(targetid) > 0 || GetPlayerInterior(targetid) > 0)
        return SendError(playerid, "Игрок не возле вас, трейд доступен только на улице.");
    if(p_temp[playerid][market_arend] != -1) return SendError(playerid, "У Вас есть арендованная палатка.");
    if(p_temp[targetid][market_arend] != -1) return SendError(playerid, "У игрока есть арендованная палатка.");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы хотите предложить "I"%s"W" провести трейд(обмен)?", get_name(targetid));
    ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"Трейдерское агенство", STRING_GLOBAL, "Далее", "Отмена");
    SetOfferData(playerid, targetid, OFFER_ID_TRADE);
    return 1;
}

CMD:sellcar(playerid, params[])
{
    new vehicleid = GetPlayerOwnerNearestVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "Около Вас нет транспортного средства.");
    if(veh_info[vehicleid][v_bonus] != 0) return SendError(playerid, "Вы не можете продать бонусное транспортное средство.");
    if(veh_info[vehicleid][v_insurance] == 0 &&  (GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_CAR ||  GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_MOTO))
        return SendError(playerid, "У Вас нет страховки.");
    STRING_GLOBAL[0] = EOS;
    if(veh_info[vehicleid][v_sell_block] != 0) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы уверены что хотите продать Ваш личный транспорт (%s) государству за 0$\n\n{"#cLIGHTRED"}Данное транспортное средство подарочное, продажа государству возможна за 0$!", GetVehicleName(vehicleid));
    else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы уверены что хотите продать Ваш личный транспорт (%s) государству за %d$ (25 процентов от гос. стоимости)?", GetVehicleName(vehicleid), GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_PRICE)/4);
    ShowPlayerDialog(playerid, D_SELL_CAR_GOS, DIALOG_STYLE_MSGBOX, ""I"Продажа транспорта", STRING_GLOBAL, "Да", "Нет");
    return 1;
}

IsVehicleOccupiedEx(vehicleid)
{
    foreach(new i:Player) if(GetPlayerState(i) == PLAYER_STATE_DRIVER && GetPlayerVehicleID(i) == vehicleid) return 1;
    return 0;
}


public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
    GetPlayerHealth(playerid, p_info[playerid][pHealth]);
    SetPlayerHealth(playerid, p_info[playerid][pHealth]);
    new pos_id = GetSlotVehicleMarket(veh_info[vehicleid][v_mysql_id]);
    if(pos_id != -1)
    {
        if(IsPlayerOwnerVehicle(playerid, vehicleid))
        {
            ShowPlayerDialog(playerid, D_CAR_MARKET_UNBET, DIALOG_STYLE_MSGBOX, ""I"Забрать транспортное средство", ""W"Вы действительно хотите забрать транспортное средство с авторынка?\n\n\
            {"#cLIGHTRED"}Обратите внимание! Денежные средства за аренду места не возвращаются.", "Да", "Нет");
        }
        else
        {
            new vehicleupgrade = veh_info[vehicleid][v_twinturbo_data][tt_suspension] + veh_info[vehicleid][v_twinturbo_data][tt_transmission] + veh_info[vehicleid][v_twinturbo_data][tt_turbocharging] + veh_info[vehicleid][v_twinturbo_data][tt_engine];
            new Float:vehiclemaxspeed = GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_SPEED) * (1.0 + (vehicleupgrade * 0.1));
            if(vehiclemaxspeed > 270.0) vehiclemaxspeed = 270.0;

            new insurance_info[64];
            if(veh_info[vehicleid][v_insurance] == 0) insurance_info = "{"#cLIGHTRED"}Нет"W"";
            else format(insurance_info, sizeof(insurance_info), "{"#cGREEN"}Есть"W" [%d час(-а/-ов)]", veh_info[vehicleid][v_insurance_time]);

            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, ""W"\
                Технический паспорт:\n\n\
                Модель: %s\n\
                Номерной знак: %s\n\
                Страховка: %s", GetVehicleName(vehicleid), veh_info[vehicleid][v_number], insurance_info);
            f(STRING_GLOBAL, "%s\n\n"W"\
                Технические характеристики:\n\n\
                Подвеска: %d из 3\n\
                Трансмиссия: %d из 3\n\
                Турбонаддув: %d из 3\n\
                Двигатель: %d из 3\n\n\
                Состояние стартера: %.1f\n\
                Состояние аккумулятора: %.1f\n\
                Состояние топливной системы: %.1f\n\
                Состояние сцепления: %.1f\n\
                Состояние двигателя: %.1f\n\n\
                Макс. скорость: %d KM/H\n\
                Макс. скорость с тюнингом: %d KM/H\n\
                Премиум: %s\n\n\
                Стоимость: %d$\n\n\
                Вы действительно хотите приобрести данное транспортное средство?", STRING_GLOBAL,
                veh_info[vehicleid][v_twinturbo_data][tt_suspension],veh_info[vehicleid][v_twinturbo_data][tt_transmission],
                veh_info[vehicleid][v_twinturbo_data][tt_turbocharging],veh_info[vehicleid][v_twinturbo_data][tt_engine],
                veh_info[vehicleid][v_details][0], veh_info[vehicleid][v_details][1], veh_info[vehicleid][v_details][2],
                veh_info[vehicleid][v_details][3], veh_info[vehicleid][v_details][4],
                floatround(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_MAX_SPEED)),
                floatround(vehiclemaxspeed), (veh_info[vehicleid][v_premium] == 1) ? ("{"#cGREEN"}Есть"W"") : ("{"#cLIGHTRED"}Нет"W""),
                CarMarketInfo[pos_id][cmPrice]);
            ShowPlayerDialog(playerid, D_CAR_MARKET_BUY, DIALOG_STYLE_MSGBOX, ""I"Покупка транспортного средства", STRING_GLOBAL, "Да", "Нет");
            p_temp[playerid][p_listitem_int] = vehicleid;
        }
        ClearAnimations(playerid, true);
        return 0;
    }
    if(veh_info[vehicleid][v_lock] == 1) return SendError(playerid, "Транспортное средство закрыто."), ClearAnimations(playerid, true);
    if(!ispassenger)
    {
        if(IsVehicleOccupiedEx(vehicleid))
        {
            ClearAnimations(playerid);
            GameTextForPlayer(playerid, "~r~~h~CAR IS USED", 2000, 4);
            return 0;
        }
    }
    if(p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID && ExitCount[playerid] > 0)
    {
        if(IsPlayerRentedVehicle(playerid, vehicleid) && ExitCount[playerid] > 0) { }
        else return SendError(playerid, "Вы не закончили рабочий день.");//Fix_TogglePlayerControllable(playerid,true);
    }
    ResetPlayerWeapons(playerid);
    for (new i; i < MAX_WEAPONS; i++)
    {
        if(p_info[playerid][Weapon][i] == 42)
        {
            p_info[playerid][Weapon][i] = 0;
            p_info[playerid][Ammo][i] = 0;
            p_temp[playerid][FireAmmo] = 0;
            p_temp[playerid][mechanic_ammo] = 0;
            continue;
        }
        GivePlayerWeapon(playerid, p_info[playerid][Weapon][i], p_info[playerid][Ammo][i]);
    }
    SetPlayerArmedWeapon(playerid, 0);
    return 1;
}
public OnPlayerExitVehicle(playerid, vehicleid)
{
    if(p_temp[playerid][veh_id_buy] == vehicleid) p_temp[playerid][veh_id_buy] = INVALID_VEHICLE_ID;

    for(new i = 0; i < 8; i++) if(veh_info[vehicleid][v_passenger][i] == playerid) veh_info[vehicleid][v_passenger][i] = INVALID_PLAYER_ID;

    if(GetPVarInt(playerid, "EKZAMEN") == 1411)
    {
        SendInfo(playerid, "Вы вышли из транспортного средства, экзамен завершен.");
        DisablePlayerRaceCheckpoint(playerid);
        DeletePVar(playerid, "EKZAMEN");
        SetVehicleToRespawn(GetPlayerVehicleID(playerid));
    }
    if(RegisterRace[playerid] == 2)
    {
        for(new i = 0; i < MAX_RACE_PLAYERS; i++)
        {
            if(RacePlayers[i] == playerid)
            {
                SetPlayerVirtualWorld(RacePlayers[i], 0);
                SetPlayerInterior(RacePlayers[i], 0);
                SetPlayerPos(RacePlayers[i], 1421.7180,-1623.7816,13.5469);
                SetPlayerFacingAngle(RacePlayers[i], 270.0);
                RegisterRace[RacePlayers[i]] = 0;
                RacePlayers[i] = INVALID_PLAYER_ID;
                if(RaceVehicles[i] != INVALID_VEHICLE_ID) DestroyVehicleVEx(RaceVehicles[i]);
                RaceVehicles[i] = INVALID_VEHICLE_ID;
                SendInfo(playerid, "Вы были дисквалифицированны с гонки.");
                DisablePlayerRaceCheckpoint(playerid);
            }
        }
    }
    if(RegisterDerby[playerid] == 2)
    {
        for(new i; i < MAX_DERBY_PLAYERS; i++)
        {
            if(DerbyPlayers[i] == playerid)
            {
                SetPlayerVirtualWorld(DerbyPlayers[i], 0);
                SetPlayerInterior(DerbyPlayers[i], 0);
                SetPlayerPos(DerbyPlayers[i], 1421.7180,-1623.7816,13.5469);
                SetPlayerFacingAngle(DerbyPlayers[i], 270.0);
                RegisterDerby[DerbyPlayers[i]] = 0;
                DerbyPlayers[i] = INVALID_PLAYER_ID;
                if(DerbyVehicles[i] != INVALID_VEHICLE_ID) DestroyVehicleVEx(DerbyVehicles[i]);
                DerbyVehicles[i] = INVALID_VEHICLE_ID;
                SendInfo(playerid, "Вы были дисквалифицированны с дерби.");
            }
        }
    }
    if(player_lobby_status[playerid] == true && player_lobby_idx[playerid] != -1 && (player_lobby_type[playerid] >= LOBBY_TYPE_RACE && player_lobby_type[playerid] <= LOBBY_TYPE_STUNT))
    {
        OnPlayerLeaveLobby(playerid, player_lobby_idx[playerid], "Выход из транспортного средства.");
    }

    if(GetPVarInt(playerid, "EtherLive"))
    {
        DeletePVar(playerid, "EtherLive");
        SendInfo(playerid, "Вы вышли из прямого эфира.");
    }

    if(GetPlayerState(playerid) == PLAYER_STATE_PASSENGER)
    {
        new vehicleid = GetPlayerVehicleID(playerid); // TODO: лютый пиздец 2
        foreach(new i: Player)
        {
            if(!p_info[i][loggedIn]) continue;
            if(IsPlayerInVehicle(i, vehicleid) && GetPlayerState(i) == 2 &&
                ((veh_info[vehicleid][v_job] == JOB_TC_TAXI && IsPlayerOwnerVehicle(i, vehicleid)) || veh_info[vehicleid][v_npoType] == NPO_JOB && veh_info[vehicleid][v_npoId] == JOB_TC_TAXI)
                && p_temp[i][Work_ID] == TAXI_WORK)
            {
                if(GetPVarInt(i,"@passenger")-1 == playerid)
                {
                    if(!IsPlayerOwnerVehicle(i, vehicleid) && IsPlayerInRangeOfPoint(playerid, 100.0, p_temp[playerid][TaxiFix][0], p_temp[playerid][TaxiFix][1], p_temp[playerid][TaxiFix][2]) == 0 && p_info[playerid][TaxiTime] < timestamp)
                    {
                        p_info[playerid][TaxiTime] = timestamp + 180;
                        UpdatePlayerWorkSkill(i, 8);

                        CheckPlayerMission(i, START_TAXI);
                        CheckPlayerMission(i, DAILY_TAXI);
                        CheckPlayerMission(i, ACHIEVEMENT_TAXI);

                        CheckPlayerFreelance(i, FREELANCE_TAXI);
                        CheckPlayerBattlePass(i, BATTLEPASS_TAXI);

                        UpdateFamilyLevel(i);
                        UpdateFamilyContract(i, CONTRACT_FAMILY_ID_TAXI); // Контракты: Водитель такси
                    }

                    if(p_info[playerid][cash] >= floatround(p_temp[i][taxi_zp]))
                    {
                        SetPlayerMoney(playerid, -floatround(p_temp[i][taxi_zp]), true, "проезд в такси");

                        if(GetPVarInt(i,"PayDayCashJob") > timestamp) {}
                        else
                        {
                            new reason_money = GetPlayerMoneySkill(i, GetBizPercent(i, TYPE_TC_TAXI, floatround(p_temp[i][taxi_zp])), 8);
                            SetPlayerMoney(i, reason_money, false, "зарплата таксиста");
                            OnServerInfoForMoney[17] += reason_money;
                            SetPVarInt(i,"PayDayCashJob",timestamp + 30);
                            TransferBizMoney(i, TYPE_TC_TAXI, p_temp[i][fix_bug_biz_tc_salary]);
                        }
                    }
                    else
                    {
                        SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                        SendError(i, "У игрока нет столько денег.");
                    }

                    p_temp[i][fix_flood] = INVALID_PLAYER_ID;
                    SendInfo(i, "Пассажир вышел из транспортного средства.");

                    p_temp[i][taxi_zp] = 0.0;
                    p_temp[i][taxi_enter] = 0;
                    DeletePVar(i,"@passenger");

                    foreach(new id: Player)
                    {
                        if(IsPlayerInVehicle(id, vehicleid) && id != i && id != playerid)
                        {
                            SendInfo(i, "%s [%d] сел в Ваше такси.", get_name(id), id);
                            //SendInfo(i, "Довезите игрока и поездка будет оплачена государством.");

                            p_temp[i][taxi_enter] = timestamp + 120;

                            SetPVarInt(i,"@passenger",id+1);
                            SetPVarInt(i,"@passenger_count",GetPVarInt(i,"@passenger_count")+1);
                            break;
                        }
                    }
                }
            }
        }
    }
    return 1;
}

public OnPlayerStreamIn(playerid, forplayerid)
{
    if(p_temp[playerid][family_label] != Text3D:-1)
        Streamer_ToggleItem(forplayerid, STREAMER_TYPE_3D_TEXT_LABEL, p_temp[playerid][family_label], p_info[forplayerid][p_settings][FAMILY_LABEL]);
    if(p_temp[playerid][pame_label] != Text3D:-1)
        Streamer_ToggleItem(forplayerid, STREAMER_TYPE_3D_TEXT_LABEL, p_temp[playerid][pame_label], p_info[forplayerid][p_settings][PAME_LABEL]);

    if(!p_info[forplayerid][p_settings][ACC_VISIBLE])
    {
        for(new i = MAX_PLAYER_ATTACHED_OBJECTS-1; i != -1; i--)
        {
            if(IsPlayerAttachedObjectSlotUsed(playerid, i))
                RemoveAttachedObjectForPlayer(playerid, forplayerid, i);
        }
    }
    return 1;
}

public OnPlayerStreamOut(playerid, forplayerid)
{
    if(pSpectateId[forplayerid] == playerid)
        UpdateSpectatingStatus(forplayerid, playerid);

    if(p_temp[playerid][family_label] != Text3D:-1)
        Streamer_ToggleItem(forplayerid, STREAMER_TYPE_3D_TEXT_LABEL, p_temp[playerid][family_label], 1);
    if(p_temp[playerid][pame_label] != Text3D:-1)
        Streamer_ToggleItem(forplayerid, STREAMER_TYPE_3D_TEXT_LABEL, p_temp[playerid][pame_label], 1);

    if(p_temp[playerid][chase_followerId] == forplayerid && p_info[playerid][wanted] > 1 && IsPlayerFractionPolice(forplayerid))
    {
        p_temp[playerid][chase_followerId] =
        p_temp[forplayerid][chase_targetId] = INVALID_PLAYER_ID;
        SendInfo(forplayerid, "Преступник скрылся от преследования.");
        DisablePlayerCheckpoint(forplayerid);

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] прекратил погоню за %s [%d].", get_name(forplayerid), forplayerid, get_name(playerid), playerid);
        SendFractionMessage(p_info[forplayerid][member], 0x33CC66FF, STRING_GLOBAL);
    }
    return 1;
}

public OnVehicleStreamIn(vehicleid, forplayerid)
{
    if(!IsValidVehicle(vehicleid) || p_info[forplayerid][loggedIn] != 1) return 0;
    sc_OnVehicleStreamIn(vehicleid, forplayerid);
    SetVehicleParamsForPlayer(vehicleid, forplayerid, 0, veh_info[vehicleid][v_lock]);

    if(veh_info[vehicleid][v_custom_text] != INVALID_3DTEXT_ID)
    {
        if(GetPlayerGameVersion(forplayerid) < CLIENT_VERSION_052021) Streamer_ToggleItem(forplayerid, STREAMER_TYPE_3D_TEXT_LABEL, veh_info[vehicleid][v_custom_text], 1);
        else Streamer_ToggleItem(forplayerid, STREAMER_TYPE_3D_TEXT_LABEL, veh_info[vehicleid][v_custom_text], !p_info[forplayerid][p_settings][REAL_CARS]);
    }

    if(veh_info[vehicleid][v_number_text] != INVALID_3DTEXT_ID)
    {
        Streamer_ToggleItem(forplayerid, STREAMER_TYPE_3D_TEXT_LABEL, veh_info[vehicleid][v_number_text], p_info[forplayerid][p_settings][NUMBER_VEHICLES]);
    }
    return 1;
}

public OnVehicleStreamOut(vehicleid, forplayerid)
{
    if(!IsValidVehicle(vehicleid) || p_info[forplayerid][loggedIn] != 1) return 0;
    if(veh_info[vehicleid][v_custom_text] != INVALID_3DTEXT_ID)
        Streamer_ToggleItem(forplayerid, STREAMER_TYPE_3D_TEXT_LABEL, veh_info[vehicleid][v_custom_text], 1);
    if(veh_info[vehicleid][v_number_text] != INVALID_3DTEXT_ID)
        Streamer_ToggleItem(forplayerid, STREAMER_TYPE_3D_TEXT_LABEL, veh_info[vehicleid][v_number_text], 1);
    return 1;
}

public OnPlayerStateChange(playerid, newstate, oldstate)
{
    // States
    /*
    #define PLAYER_STATE_NONE                      (0)
    #define PLAYER_STATE_ONFOOT                    (1)
    #define PLAYER_STATE_DRIVER                    (2)
    #define PLAYER_STATE_PASSENGER                 (3)
    #define PLAYER_STATE_WASTED                    (7)
    #define PLAYER_STATE_SPAWNED                   (8)
    #define PLAYER_STATE_SPECTATING                (9)
    */
    //SendDebug(playerid, "newstate %d | oldstate %d", newstate, oldstate);

    new
        playerSpectatorId = pSpectatorId[playerid],
        vehicleid = GetPlayerVehicleID(playerid);
    if(playerSpectatorId != INVALID_PLAYER_ID) SetTimerEx("UpdateSpectatingStatus", 1500, false, "ii", playerSpectatorId, playerid);
    SetPlayerHealth(playerid, p_info[playerid][pHealth]);

    if((newstate == PLAYER_STATE_SPECTATING || newstate == PLAYER_STATE_WASTED) && GetPlayerSkin(playerid) > 311) 
    {
        SetPlayerSkin(playerid, 252);
        if(newstate == PLAYER_STATE_WASTED) SpawnPlayer(playerid);
    }
    if(newstate == PLAYER_STATE_ONFOOT && oldstate == PLAYER_STATE_SPAWNED)
    {
        if(p_temp[playerid][cossack_robbers_register] != 2 && player_lobby_type[playerid] != LOBBY_TYPE_PARKOUR)
            SetPlayerSkinEx(playerid);
    }

    if(oldstate == PLAYER_STATE_DRIVER && p_temp[playerid][LastDriverVehicleIDx] != INVALID_VEHICLE_ID)
    {
        new scdvehicleid = p_temp[playerid][LastDriverVehicleIDx];
        if(!strequals(veh_info[scdvehicleid][v_radio_url], "") && veh_info[scdvehicleid][v_radio] == 1)
        {
            format(veh_info[scdvehicleid][v_radio_url], 128, "");
            veh_info[scdvehicleid][v_radio] = 0;
            for(new i = 0, scdplayerid; i < 8; i++)
            {
                scdplayerid = veh_info[scdvehicleid][v_passenger][i];
                if(!IsPlayerConnected(scdplayerid)) continue;
                if(!IsPlayerInAnyVehicle(scdplayerid)) continue;
                if(GetPlayerVehicleID(scdplayerid) != scdvehicleid) continue;
                if(p_info[scdplayerid][p_settings][STATUS_RADIO] != 0) continue;
                if(GetPVarInt(scdplayerid, "UseMusic") != 0) continue;
                DeletePVar(scdplayerid, "UseMusicVehicle");
                StopAudioStreamForPlayer(scdplayerid);
            }
            p_temp[playerid][radio_type] = TYPE_RADIO_LIST; // ID из массива RadioList;
            p_temp[playerid][radio_type_track] = TYPE_RADIO_LIST; // ID из массива RadioList;
            p_temp[playerid][radio_idx] = -1; // ID из массива RadioList;
            p_temp[playerid][radio_type_idx] = -1; // ID из папки;
            p_temp[playerid][radio_timer] = 0; // Время до окончания таймера;
            if(p_temp[playerid][TextDrawRadio] == true) UpdateRadio(playerid);
        }
    }

    if(oldstate == PLAYER_STATE_DRIVER || oldstate == PLAYER_STATE_PASSENGER)
    {
        if(GetPVarInt(playerid, "UseMusicVehicle") == 1)
        {
            DeletePVar(playerid, "UseMusicVehicle");
            StopAudioStreamForPlayer(playerid);
        }
    }

    if(newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER)
    {
        new iSeat = GetPlayerVehicleSeat(playerid);
        if(0 <= iSeat <= 7)
            veh_info[vehicleid][v_passenger][iSeat] = playerid;

        if(veh_info[vehicleid][v_radio] != 0 && p_info[playerid][p_settings][STATUS_RADIO] == 0 && GetPVarInt(playerid, "UseMusic") == 0)
        {
            SetPVarInt(playerid, "UseMusicVehicle", 1);
            PlayAudioStreamForPlayer(playerid, veh_info[vehicleid][v_radio_url]);
        }
    }
    if((oldstate == PLAYER_STATE_DRIVER || oldstate == PLAYER_STATE_PASSENGER) && GetPVarInt(playerid, "UseMusicVehicle") == 1)
    {
        DeletePVar(playerid, "UseMusicVehicle");
        StopAudioStreamForPlayer(playerid);
    }

    if(newstate == PLAYER_STATE_PASSENGER || oldstate == PLAYER_STATE_PASSENGER)
    {
        if(p_temp[playerid][tTied] == 1) Fix_TogglePlayerControllable(playerid, false);
    }

    if(newstate == PLAYER_STATE_DRIVER)
    {
        if(IsPlayerInDynamicArea(playerid, MARKET_CUBE) ||
            IsPlayerInDynamicArea(playerid, VEHICLE_MARKET_CUBE) || 
            IsPlayerInDynamicArea(playerid, MINE_POLYGON)/* ||
            IsPlayerInDynamicArea(playerid, FARM_POLYGON)*/)
        {
            SetVehicleToRespawn(vehicleid);
            SendInfo(playerid, "На данной территории запрещено находиться в транспортном средстве.");
            SendInfo(playerid, "Транспортное средство отправлено на место парковки.");
            return 1;
        }

        new model_vehicle = veh_info[vehicleid][v_model];
        p_temp[playerid][LastDriverVehicleIDx] = vehicleid;
        if(model_vehicle < 400) model_vehicle = GetVehicleModel(vehicleid);
        /*if(veh_info[vehicleid][v_job] == 0 && p_info[playerid][Lic][LIC_TAXI] == 1 && IsPlayerOwnerVehicle(playerid, vehicleid))
            SendInfo(playerid, "Вы можете начать работу такси с помощью команды /startjob");*/

        ShowTextDrawForPlayer(playerid, TD_ID_SPEEDOMETER);

        if(veh_info[vehicleid][v_loading] >= 1 && veh_info[vehicleid][v_loading] <= 4)
        {
            if((army(playerid) || gang(playerid) || mafia(playerid) || biker(playerid) || IsPlayerFractionMedic(playerid)) && veh_info[vehicleid][v_npoId] == p_info[playerid][member])
            {
                switch(veh_info[vehicleid][v_loading])
                {
                    case 1: ShowPlayerDialog(playerid, D_EXIT_LOAD_UNLOAD, DIALOG_STYLE_MSGBOX, ""I"Загрузка наркотиков", ""W"Вы желаете закончить загрузку наркотиков?", "Да", "Нет");
                    case 2: ShowPlayerDialog(playerid, D_EXIT_LOAD_UNLOAD, DIALOG_STYLE_MSGBOX, ""I"Загрузка патронов и материалов", ""W"Вы желаете закончить загрузку патронов и материалов?", "Да", "Нет");
                    case 3: ShowPlayerDialog(playerid, D_EXIT_LOAD_UNLOAD, DIALOG_STYLE_MSGBOX, ""I"Загрузка патронов и материалов", ""W"Вы желаете закончить загрузку патронов и материалов?", "Да", "Нет");
                    case 4: ShowPlayerDialog(playerid, D_EXIT_LOAD_UNLOAD, DIALOG_STYLE_MSGBOX, ""I"Загрузка медикаментов", ""W"Вы желаете закончить загрузку медикаментов?", "Да", "Нет");
                }
                SetPVarInt(playerid, "LoadUnload:idx", veh_info[vehicleid][v_loading]);
                return 1;
            }
        }
        if(veh_info[vehicleid][v_loading] >= 5 && veh_info[vehicleid][v_loading] <= 6)
        {
            if(veh_info[vehicleid][v_rented_ID] != INVALID_MYSQL_ID && !IsPlayerRentedVehicle(playerid, vehicleid))
            {
                SendError(playerid, "Данное транспортное средство уже арендовано.");
                return RemovePlayerFromVehicle(playerid);
            }
            if(p_info[playerid][job] == JOB_OIL && p_temp[playerid][Work_ID] == OIL_WORK)
            {
                switch(veh_info[vehicleid][v_loading])
                {
                    case 5: ShowPlayerDialog(playerid, D_EXIT_LOAD_UNLOAD, DIALOG_STYLE_MSGBOX, ""I"Загрузка бочек", ""W"Вы желаете закончить загрузку бочек?", "Да", "Нет");
                    case 6: ShowPlayerDialog(playerid, D_EXIT_LOAD_UNLOAD, DIALOG_STYLE_MSGBOX, ""I"Разгрузка бочек", ""W"Вы желаете закончить разгрузку бочек?", "Да", "Нет");
                }
                SetPVarInt(playerid, "LoadUnload:idx", veh_info[vehicleid][v_loading]);
                return 1;
            }
        }
        if(veh_info[vehicleid][v_loading] >= 7 && veh_info[vehicleid][v_loading] <= 8)
        {
            if(veh_info[vehicleid][v_rented_ID] != INVALID_MYSQL_ID && !IsPlayerRentedVehicle(playerid, vehicleid))
            {
                SendError(playerid, "Данное транспортное средство уже арендовано.");
                return RemovePlayerFromVehicle(playerid);
            }
            if(p_info[playerid][job] == JOB_ROADMAN && p_temp[playerid][Work_ID] == ROADMAN_WORK)
            {
                switch(veh_info[vehicleid][v_loading])
                {
                    case 7: ShowPlayerDialog(playerid, D_EXIT_LOAD_UNLOAD, DIALOG_STYLE_MSGBOX, ""I"Загрузка мешков с мусором", ""W"Вы желаете закончить загрузку мешков с мусором?", "Да", "Нет");
                    case 8: ShowPlayerDialog(playerid, D_EXIT_LOAD_UNLOAD, DIALOG_STYLE_MSGBOX, ""I"Разгрузка мешков с мусором", ""W"Вы желаете закончить разгрузку мешков с мусором?", "Да", "Нет");
                }
                SetPVarInt(playerid, "LoadUnload:idx", veh_info[vehicleid][v_loading]);
                return 1;
            }
        }
        if(model_vehicle == 427) SetPlayerArmour(playerid, 0.0);
        SetVehicleParamsVEx(vehicleid, veh_info[vehicleid][v_engine], veh_info[vehicleid][v_light], alarm, veh_info[vehicleid][v_lock], bonnet, boot, objective);

        if(p_temp[playerid][Work_ID] > NONE_WORK &&
            p_temp[playerid][Work_ID] != DRUG_WORK && p_temp[playerid][Work_ID] != LABORATORY_WORK &&
            model_vehicle != 532 && model_vehicle != 530 &&
            model_vehicle != 524 && p_temp[playerid][Work_ID] != THEFT_CAR_WORK &&
            model_vehicle != 448 && p_temp[playerid][Work_ID] != PIZZABOY_WORK &&
            model_vehicle != 428 && p_temp[playerid][Work_ID] != COLLECTOR_WORK &&
            model_vehicle != 552 && p_temp[playerid][Work_ID] != ELECTRIC_WORK &&
            model_vehicle != 609 && p_temp[playerid][Work_ID] != ELECTRIC_WORK &&
            model_vehicle != 454 && p_temp[playerid][Work_ID] != OIL_WORK &&
            model_vehicle != 472 && p_temp[playerid][Work_ID] != OIL_WORK &&
            model_vehicle != 452 && p_temp[playerid][Work_ID] != OIL_WORK &&
            model_vehicle != 446 && p_temp[playerid][Work_ID] != OIL_WORK &&
            model_vehicle != 493 && p_temp[playerid][Work_ID] != OIL_WORK &&
            model_vehicle != 544 && p_temp[playerid][Work_ID] != FIREMAN_WORK &&
            model_vehicle != 554 && p_temp[playerid][Work_ID] != ROADMAN_WORK &&
            model_vehicle != 437 && p_temp[playerid][Work_ID] != BUS_WORK &&
            model_vehicle != 431 && p_temp[playerid][Work_ID] != BUS_WORK &&
            model_vehicle != 525 && p_temp[playerid][Work_ID] != MECHANIC_WORK &&
            model_vehicle != 519 && p_temp[playerid][Work_ID] != PILOT_WORK &&
            model_vehicle != 498 && p_temp[playerid][Work_ID] != ROBBER_WORK &&
            model_vehicle != 530 && p_temp[playerid][Work_ID] != CONSTRUCTION_WORK &&
            model_vehicle != 400 && p_temp[playerid][Work_ID] != TAXI_WORK &&
            model_vehicle != 415 && p_temp[playerid][Work_ID] != TAXI_WORK &&
            model_vehicle != 418 && p_temp[playerid][Work_ID] != TAXI_WORK &&
            model_vehicle != 420 && p_temp[playerid][Work_ID] != TAXI_WORK &&
            model_vehicle != 438 && p_temp[playerid][Work_ID] != TAXI_WORK &&
            model_vehicle != 560 && p_temp[playerid][Work_ID] != TAXI_WORK &&
            !IsPlayerOwnerVehicle(playerid, vehicleid) && p_temp[playerid][Work_ID] != TAXI_WORK &&
            model_vehicle != 456 && p_temp[playerid][Work_ID] != TRUCK_WORK &&
            model_vehicle != 498 && p_temp[playerid][Work_ID] != TRUCK_WORK &&
            model_vehicle != 455 && p_temp[playerid][Work_ID] != TRUCK_WORK &&
            model_vehicle != 532 && p_temp[playerid][Work_ID] != FARM_WORK &&
            model_vehicle != 478 && p_temp[playerid][Work_ID] != FARM_WORK &&
            model_vehicle != 440 && p_temp[playerid][Work_ID] != FARM_WORK &&
            model_vehicle != 538 && p_temp[playerid][Work_ID] != TRAIN_WORK &&
            model_vehicle != 449 && p_temp[playerid][Work_ID] != TRAM_WORK &&
            model_vehicle != 422 && p_temp[playerid][Work_ID] != HUNTING_WORK &&
            model_vehicle != 578 && p_temp[playerid][Work_ID] != PANEL_WORK)
        {
            SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
            return RemovePlayerFromVehicle(playerid);
        }

        if(model_vehicle >= 400 && GetVehicleData(model_vehicle, E_VD_TYPE) != VEHICLE_STATE_VELO_MOPED)
        {
            if(GetVehicleData(model_vehicle, E_VD_TYPE) == VEHICLE_STATE_BOAT)
            {
                if(p_info[playerid][Lic][LIC_BOAT] != 1 /*&& LeasonState[playerid] == 0*/)
                {
                    SendError(playerid, "У Вас нет лицензии на \"%s\".", name_license[LIC_BOAT]);
                    RemovePlayerFromVehicle(playerid);
                    return 1;
                }
            }
            else if(GetVehicleData(model_vehicle, E_VD_TYPE) == VEHICLE_STATE_MOTO)
            {
                if(p_info[playerid][Lic][LIC_MOTO] != 1 && GetPVarInt(playerid, "EKZAMEN") != 1411 && model_vehicle != 462)
                {
                    SendError(playerid, "У Вас нет лицензии на \"%s\".", name_license[LIC_MOTO]);
                    RemovePlayerFromVehicle(playerid);
                    return 1;
                }
            }
            else if(GetVehicleData(model_vehicle, E_VD_TYPE) == VEHICLE_STATE_PLANE)
            {
                if(p_info[playerid][Lic][LIC_PLANE] != 1 /*&& LeasonState[playerid] == 0*/)
                {
                    SendError(playerid, "У Вас нет лицензии на \"%s\".", name_license[LIC_PLANE]);
                    RemovePlayerFromVehicle(playerid);
                    return 1;
                }
            }
            else if(p_info[playerid][Lic][LIC_CAR] != 1 && GetPVarInt(playerid, "EKZAMEN") != 1411 && GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_CAR)
            {
                SendError(playerid, "У Вас нет лицензии на \"%s\".", name_license[LIC_CAR]);
                RemovePlayerFromVehicle(playerid);
                return 1;
            }
            else
            {
                SendMes(playerid, COLOR_GREEN, "Завести двигатель: "W"L.CTRL (/en){"#cGREEN"} | Включить фары: "W"/light{"#cGREEN"} | Включить радио: "W"/radio");
                SetVehicleParamsVEx(vehicleid, veh_info[vehicleid][v_engine], veh_info[vehicleid][v_light], alarm, veh_info[vehicleid][v_lock], bonnet, boot, objective);
            }
        }
        else SetVehicleParamsVEx(vehicleid, true, veh_info[vehicleid][v_light], alarm, veh_info[vehicleid][v_lock], bonnet, boot, objective);

        if(veh_info[vehicleid][v_npoType] == NPO_FAMILY)
        {
            new family_idx = veh_info[vehicleid][v_family_id];
            if(GetPlayerFamilyID(playerid) != family_idx)
            {
                SendError(playerid, "Вы не состоите в семье \"%s\".", FamilyData[family_idx][fName]);
                RemovePlayerFromVehicle(playerid);
                return 1;
            }
            if(p_info[playerid][family_rang] < veh_info[vehicleid][v_family_rang])
            {
                RemovePlayerFromVehicle(playerid);
                SendError(playerid, "Данное транспортное средство доступно с %d ранга.", veh_info[vehicleid][v_family_rang]);
                return 1;
            }
            new fhouseid = FamilyData[family_idx][fHouseID];
            if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_BOAT && (fhouseid == INVALID_HOUSE_ID || h_info[fhouseid][h_boat_status] == 0))
            {
                RemovePlayerFromVehicle(playerid);
                SendError(playerid, "У Вашей семьи нет дома с выходом на пирс.");
                return SendInfo(playerid, "Советуем купить дом с пирсом либо продать данное Т/С.");
            }
            if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_PLANE && (fhouseid == INVALID_HOUSE_ID || (h_info[fhouseid][h_air_pos][0] == 0.0 && h_info[fhouseid][h_air_pos][1] == 0.0)))
            {
                RemovePlayerFromVehicle(playerid);
                SendError(playerid, "У Вашей семьи нет дома с вертолетной площадкой.");
                return SendInfo(playerid, "Советуем купить дом с вертолетной площадкой либо продать данное Т/С.");
            }
        }

        if(veh_info[vehicleid][v_npoType] == NPO_FACTION)
        {
            if(p_info[playerid][member] == veh_info[vehicleid][v_npoId])
            {
                if(!gang(playerid) && !mafia(playerid) && !biker(playerid) && p_info[playerid][fwork] == false)
                {
                    RemovePlayerFromVehicle(playerid);
                    return SendError(playerid, "Вы не начали рабочий день.");
                }
                if((p_info[playerid][member] == POLICE_LS && model_vehicle == 497 && p_info[playerid][rang] < 5) ||
                    (p_info[playerid][member] == NATIONAL_GUARD && (model_vehicle == 548 || model_vehicle == 433) && p_info[playerid][rang] < 2))
                {
                    RemovePlayerFromVehicle(playerid);
                    return SendError(playerid, "У Вас слишком маленький ранг для использования этого транспортного средства.");
                }
                /*
                if(p_info[playerid][rang] < veh_info[vehicleid][v_fraction_rang])
                {
                    RemovePlayerFromVehicle(playerid);
                    SendError(playerid, "Данное транспортное средство доступно с %d ранга.", veh_info[vehicleid][v_fraction_rang]);
                    return 1;
                }
                */
            }
            else
            {
                if(veh_info[vehicleid][v_npoId] == NATIONAL_GUARD && arm_skin(playerid) && model_vehicle == 433) { }
                else if(GetFactionCategory(veh_info[vehicleid][v_npoId]) == FACTION_CATEGORY_PD &&
                    p_info[playerid][member] == MAYOR_LS && p_info[playerid][rang] == 8) { }
                else if(veh_info[vehicleid][v_npoId] == NATIONAL_GUARD &&
                    p_info[playerid][member] == MAYOR_LS && p_info[playerid][rang] == 7) { }
                else if(GetFactionCategory(veh_info[vehicleid][v_npoId]) == FACTION_CATEGORY_MEDIC &&
                    p_info[playerid][member] == MAYOR_LS && p_info[playerid][rang] == 6) { }
                else if(GetFactionCategory(veh_info[vehicleid][v_npoId]) == FACTION_CATEGORY_SNN &&
                    p_info[playerid][member] == MAYOR_LS && p_info[playerid][rang] == 5) { }
                else
                {
                    RemovePlayerFromVehicle(playerid);
                    return SendError(playerid, "У Вас нет ключей от этого транспортного средства.");
                }
            }
            // if((veh_info[vehicleid][v_npoId] != NATIONAL_GUARD || !arm_skin(playerid) || model_vehicle != 433))
            if(model_vehicle == 433 || model_vehicle == 482)
            {
                SendInfo(playerid, "Патронов в транспортном средстве: %d из %d.", veh_info[vehicleid][v_patron], MAX_VEHICLE_PATRON_MATERIALS);
                SendInfo(playerid, "Материалов в транспортном средстве: %d из %d.", veh_info[vehicleid][v_materials], MAX_VEHICLE_PATRON_MATERIALS);
                SendInfo(playerid, "Управление загрузкой: /load");
                SendInfo(playerid, "Управление разгрузкой: /unload");
            }
            if(model_vehicle == 478)
            {
                SendInfo(playerid, "Наркотиков в транспортном средстве: %d гр.", veh_info[vehicleid][v_drugs]);
                SendInfo(playerid, "Управление загрузкой: /load");
                SendInfo(playerid, "Управление разгрузкой: /unload");
            }
            if(model_vehicle == 499)
            {
                SendInfo(playerid, "Медикаментов в транспортном средстве: %d из %d.", veh_info[vehicleid][v_medicines], MAX_VEHICLE_MEDICINES);
                SendInfo(playerid, "Управление загрузкой: /load");
                SendInfo(playerid, "Управление разгрузкой: /unload");
            }
            return 1;
        }

        if(veh_info[vehicleid][v_npoType] == NPO_PUB_SCHOOL && GetVehicleModelEx(vehicleid) == 400)
        {
            if(p_info[playerid][Lic][LIC_CAR] == 1 || GetPVarInt(playerid, "EKZAMEN") != 1411)
                return RemovePlayerFromVehicle(playerid);

            SetPlayerRaceCheckpoint(playerid, 0, -2036.2540,-155.6833,35.3011, -2036.1633,-173.3876,35.8262, 2.5);
            SetPVarInt(playerid, "LESCAR", CHECKPOINT_1);

            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Практическая часть", ""W"Вы приступили к сдаче экзамена на получение лицензии на наземный транспорт.\n\nВаши задачи:\n• Двигаться по маршруту, соблюдая правила дорожного движения;\n• Избегать столкновений со встречным транспортом;\n\nЕсли Вы повредите транспортное средство, экзамен будет провален.", "Начать", "");
            return 1;
        }
        if(veh_info[vehicleid][v_npoType] == NPO_PUB_SCHOOL && GetVehicleModelEx(vehicleid) == 461)
        {
            if(p_info[playerid][Lic][LIC_MOTO] == 1 || GetPVarInt(playerid, "EKZAMEN") != 1411)
                return RemovePlayerFromVehicle(playerid);

            SetPlayerRaceCheckpoint(playerid, 0, -2036.2540,-155.6833,35.3011, -2036.1633,-173.3876,35.8262, 2.5);
            SetPVarInt(playerid, "LESCAR", CHECKPOINT_1);

            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Практическая часть", ""W"Вы приступили к сдаче экзамена на получение лицензии на мото-транспорт.\n\nВаши задачи:\n• Двигаться по маршруту, соблюдая правила дорожного движения;\n• Избегать столкновений со встречным транспортом;\n\nЕсли Вы повредите транспортное средство, экзамен будет провален.", "Начать", "");
            return 1;
        }
        if(IsPlayerOwnerVehicle(playerid, vehicleid))
        {
            if( veh_info[vehicleid][v_pos][0] == 560.2803 ||
                veh_info[vehicleid][v_pos][0] == 548.9030 ||
                veh_info[vehicleid][v_pos][0] == 2474.3396 ||
                veh_info[vehicleid][v_pos][0] == 2474.6365 ||
                veh_info[vehicleid][v_pos][0] == -1985.2921 ||
                veh_info[vehicleid][v_pos][0] == -1985.7993 ||
                veh_info[vehicleid][v_pos][0] == -1645.3274 ||
                veh_info[vehicleid][v_pos][0] == -1639.3306)
                    return SendInfo(playerid, "Припарковать транспортное средство: /park");
            
        }
        if(IsPlayerFractionPolice(playerid) && GetPVarInt(playerid, "Convoy") > 0)
        {
            new string[144];
            format(string, 144, "%s у Вас под конвоем, посадить в машину?", get_name(GetPVarInt(playerid, "Convoy") - 1));
            return ShowPlayerDialog(playerid, D_CONVOY, DIALOG_STYLE_MSGBOX, ""I"Посадить в машину?", string, "Да", "Нет");
        }

        if(veh_info[vehicleid][v_temp_job] >= JOB_BUS)
        {
            if(veh_info[vehicleid][v_used_key_ID] != playerid)
            {
                RemovePlayerFromVehicle(playerid);
                return SendError(playerid, "У Вас нет ключей от этого транспортного средства.");
            }
            if(IsPlayerRentedVehicle(playerid, vehicleid)) p_temp[playerid][ExitCarTimer] = false; //KillTimer(GetPVarInt(playerid, "ExitCarTimer"));

            switch(veh_info[vehicleid][v_temp_job])
            {
                case JOB_BUS:
                {
                    BusGoNext(playerid);
                    ExitCount[playerid] = 0;
                    return 1;
                }
                case JOB_FIREMAN:
                {
                    if(p_temp[playerid][FireStatus] != 0)
                    {
                        DisablePlayerCheckpoint(playerid);
                        DisablePlayerRaceCheckpoint(playerid);
                        new index = p_temp[playerid][FireStatus] - 1;
                        SetPlayerRaceCheckpoint(playerid, 1, FireInfo[index][fPos][0], FireInfo[index][fPos][1], FireInfo[index][fPos][2], 0, 0, 0, 5);
                    }
                    ExitCount[playerid] = 0;
                    return 1;
                }
                case JOB_TC_TRUCK:
                {
                    TruckerGoNext(playerid);
                    ExitCount[playerid] = 0;
                }
                case JOB_ROADMAN, JOB_COLLECTOR, JOB_ELECTRIC, JOB_OIL, JOB_MECHANIC:
                {
                    ExitCount[playerid] = 0;
                    return 1;
                }
            }
        }

        if(veh_info[vehicleid][v_npoType] == NPO_JOB)
        {
            if(IsPlayerRentedVehicle(playerid, vehicleid)) p_temp[playerid][ExitCarTimer] = false; //KillTimer(GetPVarInt(playerid, "ExitCarTimer"));
            if(p_info[playerid][job] != veh_info[vehicleid][v_npoId] && (veh_info[vehicleid][v_npoId] != JOB_CONSTRUCTION_FORKLIFT && p_temp[playerid][Work_ID] != CONSTRUCTION_WORK) &&
                (veh_info[vehicleid][v_npoId] != JOB_RAILWAY_FACTORY_FORKLIFT && p_temp[playerid][Work_ID] != RAILWAY_WORK) && (veh_info[vehicleid][v_npoId] != JOB_FARM_TRACTOR && p_temp[playerid][Work_ID] != FARM_WORK) &&
                (veh_info[vehicleid][v_npoId] != JOB_FARM_COMBINE && p_temp[playerid][Work_ID] != FARM_WORK) && (veh_info[vehicleid][v_npoId] != JOB_FARM_PRODUCT && p_temp[playerid][Work_ID] != FARM_WORK) &&
                (veh_info[vehicleid][v_npoId] != JOB_COLLECTOR && p_temp[playerid][Work_ID] != COLLECTOR_WORK) && (veh_info[vehicleid][v_npoId] != JOB_ROBBER && p_temp[playerid][Work_ID] != ROBBER_WORK) &&
                (veh_info[vehicleid][v_npoId] != JOB_ELECTRIC && p_temp[playerid][Work_ID] != ELECTRIC_WORK) && (veh_info[vehicleid][v_npoId] != JOB_HUNTING && p_temp[playerid][Work_ID] != HUNTING_WORK) &&
                (veh_info[vehicleid][v_tc] != p_info[playerid][taxi_idx] && veh_info[vehicleid][v_npoId] == JOB_TC_TAXI) &&
                (veh_info[vehicleid][v_tc] != p_info[playerid][tc_idx] && veh_info[vehicleid][v_npoId] == JOB_TC_TRUCK) &&
                (veh_info[vehicleid][v_npoId] != JOB_PANEL && p_temp[playerid][Work_ID] != PANEL_WORK) && (veh_info[vehicleid][v_npoId] != JOB_OIL && p_temp[playerid][Work_ID] != OIL_WORK) &&
                (veh_info[vehicleid][v_npoId] != JOB_ROADMAN && p_temp[playerid][Work_ID] != ROADMAN_WORK))
            {
                if(veh_info[vehicleid][v_npoId] == JOB_TRAIN || veh_info[vehicleid][v_npoId] == JOB_TRAM)
                {
                    new Float:slx, Float:sly, Float:slz;
                    GetPlayerPos(playerid, slx, sly, slz);
                    SetPlayerPos(playerid, slx, sly, slz + 5.0);
                    SetCameraBehindPlayer(playerid);
                }
                else RemovePlayerFromVehicle(playerid);
                return SendError(playerid, "У Вас нет ключей от этого транспортного средства.");
            }

            switch(veh_info[vehicleid][v_npoId])
            {
                case JOB_TC_TAXI:
                {
                    if((!mafia(playerid) && !gang(playerid) && !biker(playerid)) && p_info[playerid][fwork] == true)
                    {
                        SendError(playerid, "Вы не закончили рабочий день.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(veh_info[vehicleid][v_rented_ID] != INVALID_MYSQL_ID && !IsPlayerRentedVehicle(playerid, vehicleid))
                    {
                        SendError(playerid, "Данное транспортное средство уже арендовано.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(!IsPlayerRentedVehicle(playerid, vehicleid) && p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID)
                    {
                        SendError(playerid, "У Вас уже есть арендованное транспортное средство.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(veh_info[vehicleid][v_tc] != p_info[playerid][taxi_idx])
                    {
                        SendError(playerid, "Вы не работаете в данном таксопарке.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(!IsPlayerRentedVehicle(playerid, vehicleid))
                    {
                        ShowPlayerDialog(playerid, D_TC_VEHICLE_TAXI, DIALOG_STYLE_MSGBOX, ""I"Аренда транспорта", ""W"Вы желаете арендовать данное транспортное средство и начать рабочий день?", "Да", "Нет");
                    }
                    else
                    {
                        ExitCount[playerid] = 0;
                    }
                }
                case JOB_TC_TRUCK:
                {
                    if((!mafia(playerid) && !gang(playerid) && !biker(playerid)) && p_info[playerid][fwork] == true)
                    {
                        SendError(playerid, "Вы не закончили рабочий день.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(veh_info[vehicleid][v_rented_ID] != INVALID_MYSQL_ID && !IsPlayerRentedVehicle(playerid, vehicleid))
                    {
                        SendError(playerid, "Данное транспортное средство уже арендовано.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(!IsPlayerRentedVehicle(playerid, vehicleid) && p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID)
                    {
                        SendError(playerid, "У Вас уже есть арендованное транспортное средство.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(veh_info[vehicleid][v_tc] != p_info[playerid][tc_idx])
                    {
                        SendError(playerid, "Вы не работаете в данной транспортной компании.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(!IsPlayerRentedVehicle(playerid, vehicleid))
                    {
                        ShowPlayerDialog(playerid, D_TC_VEHICLE_TRUCKER, DIALOG_STYLE_MSGBOX, ""I"Аренда транспорта", ""W"Вы желаете арендовать данное транспортное средство и начать рабочий день?", "Да", "Нет");
                    }
                    else
                    {
                        TruckerGoNext(playerid);
                        ExitCount[playerid] = 0;
                    }
                }
                case JOB_BUS:
                {
                    if((!mafia(playerid) && !gang(playerid) && !biker(playerid)) && p_info[playerid][fwork] == true)
                    {
                        SendError(playerid, "Вы не закончили рабочий день.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(veh_info[vehicleid][v_rented_ID] != INVALID_MYSQL_ID && !IsPlayerRentedVehicle(playerid, vehicleid))
                    {
                        SendError(playerid, "Данное транспортное средство уже арендовано.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(!IsPlayerRentedVehicle(playerid, vehicleid) && p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID)
                    {
                        SendError(playerid, "У Вас уже есть арендованное транспортное средство.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(!IsPlayerRentedVehicle(playerid, vehicleid))
                    {
                        if(p_temp[playerid][Work_ID] > NONE_WORK)
                        {
                            SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
                            return RemovePlayerFromVehicle(playerid);
                        }
                        if(p_info[playerid][job] != JOB_BUS)
                        {
                            SendError(playerid, "Вы не работаете водителем автобуса.");
                            return RemovePlayerFromVehicle(playerid);
                        }

                        SetPVarInt(playerid, "ARENDA:FIX", 1);
                        SetPVarInt(playerid, "ARENDA:PRICE", 500);
                        ShowPlayerDialog(playerid, D_RENT_WORK_CAR, DIALOG_STYLE_MSGBOX, ""I"Аренда транспорта", ""W"Вы желаете арендовать это транспортное средство?\n\nСтоимость: 500$.", "Далее", "Отмена");
                    }
                    else
                    {
                        BusGoNext(playerid);
                        ExitCount[playerid] = 0;
                    }
                }
                case JOB_MECHANIC:
                {
                    if((!mafia(playerid) && !gang(playerid) && !biker(playerid)) && p_info[playerid][fwork] == true)
                    {
                        SendError(playerid, "Вы не закончили рабочий день.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(veh_info[vehicleid][v_rented_ID] != INVALID_MYSQL_ID && !IsPlayerRentedVehicle(playerid, vehicleid))
                    {
                        SendError(playerid, "Данное транспортное средство уже арендовано.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(!IsPlayerRentedVehicle(playerid, vehicleid) && p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID)
                    {
                        SendError(playerid, "У Вас уже есть арендованное транспортное средство.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(!IsPlayerRentedVehicle(playerid, vehicleid))
                    {
                        if(p_temp[playerid][Work_ID] > NONE_WORK)
                        {
                            SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");
                            return RemovePlayerFromVehicle(playerid);
                        }
                        if(p_info[playerid][job] != JOB_MECHANIC)
                        {
                            SendError(playerid, "Вы не работаете автомехаником.");
                            return RemovePlayerFromVehicle(playerid);
                        }
                        SetPVarInt(playerid, "ARENDA:FIX", 1);
                        SetPVarInt(playerid, "ARENDA:PRICE", 1000);
                        ShowPlayerDialog(playerid, D_RENT_WORK_CAR, DIALOG_STYLE_MSGBOX, ""I"Аренда транспорта", ""W"Вы желаете арендовать это транспортное средство?\n\nСтоимость: 1000$.", "Далее", "Отмена");
                    }
                    else ExitCount[playerid] = 0;
                }
                case JOB_PIZZABOY:
                {
                    if((!mafia(playerid) && !gang(playerid) && !biker(playerid)) && p_info[playerid][fwork] == true)
                    {
                        SendError(playerid, "Вы не закончили рабочий день.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(veh_info[vehicleid][v_rented_ID] != INVALID_MYSQL_ID && !IsPlayerRentedVehicle(playerid, vehicleid))
                    {
                        SendError(playerid, "Данное транспортное средство уже арендовано.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(!IsPlayerRentedVehicle(playerid, vehicleid) && p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID)
                    {
                        SendError(playerid, "У Вас уже есть арендованное транспортное средство.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(!IsPlayerRentedVehicle(playerid, vehicleid))
                    {
                        if(p_temp[playerid][Work_ID] != PIZZABOY_WORK)
                        {
                            SendError(playerid, "Вы должны начать рабочий день.");
                            return RemovePlayerFromVehicle(playerid);
                        }

                        SetPVarInt(playerid, "ARENDA:FIX", 1);
                        SetPVarInt(playerid, "ARENDA:PRICE", 250);
                        ShowPlayerDialog(playerid, D_RENT_WORK_CAR, DIALOG_STYLE_MSGBOX, ""I"Аренда транспорта", ""W"Вы желаете арендовать это транспортное средство?\n\nСтоимость: 250$.", "Далее", "Отмена");
                    }
                    else
                    {
                        if(p_temp[playerid][PizzaboyIDx] != -1) SetHouseCheckpoint(playerid, 0, p_temp[playerid][PizzaboyIDx]);
                        ExitCount[playerid] = 0;
                    }
                    return 1;
                }
                case JOB_FIREMAN:
                {
                    if((!mafia(playerid) && !gang(playerid) && !biker(playerid)) && p_info[playerid][fwork] == true)
                    {
                        SendError(playerid, "Вы не закончили рабочий день.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(veh_info[vehicleid][v_rented_ID] != INVALID_MYSQL_ID && !IsPlayerRentedVehicle(playerid, vehicleid))
                    {
                        SendError(playerid, "Данное транспортное средство уже арендовано.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(!IsPlayerRentedVehicle(playerid, vehicleid) && p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID)
                    {
                        SendError(playerid, "У Вас уже есть арендованное транспортное средство.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(!IsPlayerRentedVehicle(playerid, vehicleid))
                    {
                        if(p_temp[playerid][Work_ID] != FIREMAN_WORK)
                        {
                            SendError(playerid, "Вы должны начать рабочий день.");
                            return RemovePlayerFromVehicle(playerid);
