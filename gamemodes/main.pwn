                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы желаете выставить на аукцион бизнес?\n\nВведите стоимость от половины гос. стоимости до полной:\n\nГос. стоимость: %d$.", b_info[b][_price]);
