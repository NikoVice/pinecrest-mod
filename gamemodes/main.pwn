                        biz_finka[biz_id] += ((price / 100) * 80) - ((price / 100) * 8);
                        UpdateIntForFinanceBiz(biz_id, ((price / 100) * 80) - ((price / 100) * 8));
                    }

                    OnServerInfoForMoney[10] += price;
                    SetPlayerMoney(playerid, -price, true, "покупка в садовом центре");

                    SendAccess(playerid, "Вы приобрели \"%s\" за %d$.", GardenCenter[listitem][GardenCenterName], price);
                    SendInfo(playerid, "Используйте /garden чтобы установить его на территории сада.");
                }
