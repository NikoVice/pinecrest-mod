CMD:asettax(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10)
        return 1;

    new fraction, money;
    if(sscanf(params, "ii", fraction, money)) return SendInfo(playerid, "�����������: /asettax [id �������] [���-��]");

    if(!(1 <= fraction <= 21))
        return SendError(playerid, "�������� ID �������.");

    SetFractionWarehouse(fraction, fwMoney, money);

    SendAccess(playerid, "�� �������� �� ������ \"%s\" %d$.", GetFractionName(fraction), money);
    SendInfo(playerid, "�� ������� \"%s\" %d$.", GetFractionName(fraction), GetFractionWarehouse(fraction, fwMoney));
    return 1;
}

