                    ShowPlayerDialog(playerid, D_FRACTION_VEHICLE_SELL, DIALOG_STYLE_MSGBOX, ""I"������� ����������", str, "��", "���");
                }
                case 2:
                {
                    if(p_info[playerid][leader] == 0) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
                    if(!gang(playerid) && !mafia(playerid) && !biker(playerid)) return SendError(playerid, "�������� ������ ��� ����������� �����������.");
                    if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "�� ������ ���������� � ������������ ��������.");
                    new vehicleid = GetPlayerVehicleID(playerid);
                    if(veh_info[vehicleid][v_npoType] != NPO_FACTION || veh_info[vehicleid][v_npoId] != p_info[playerid][member]) return SendError(playerid, "������������ �������� �� ����������� ����� �������.");
                    if(veh_info[vehicleid][v_owner_id] != INVALID_MYSQL_ID) return SendError(playerid, "������������ ��������� ������� �����.");
                    ShowPlayerDialog(playerid, D_FRACTION_VEHICLE_RANK, DIALOG_STYLE_INPUT, ""I"�������� ���� ��� ����������", ""W"������� ����, ������� ������� ����������:", "�����", "������");
