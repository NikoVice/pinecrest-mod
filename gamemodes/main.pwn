            mysql_tquery(con_bd, STRING_GLOBAL, "CheckUseNickNameCallback", "iis", playerid, GetPVarInt(playerid, "CHANGE_NICK:FREE") == 1 ? 1 : 2, inputtext);
            return 1;
        }
        case D_COMMAND:
        {
