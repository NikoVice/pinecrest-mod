            }

            if(p_temp[playerid][TrainStop] == true)
            {
                p_temp[playerid][TrainStopIDx] = p_temp[playerid][TrainStopIDx] + 1;
                if(p_temp[playerid][TrainStopIDx] >= 5) p_temp[playerid][TrainStopIDx] = 0;
                if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Машинист поезда\nСлед. остановка: "W"%s"I"\nПроезд бесплатный", TrainStopName[p_temp[playerid][TrainStopIDx]]);
                    Update3DTextLabelText(veh_info[vehicleid][v_text], COLOR_MAIN, STRING_GLOBAL);
                }
                p_temp[playerid][TrainTimer] = 11;
                new str[128];
                format(str, sizeof(str), "Поезд отъезжает через несколько секунд, след. остановка %s.", TrainStopName[p_temp[playerid][TrainStopIDx]]);
                ProxDetector(30.0, playerid, str, COLOR_GREEN, COLOR_GREEN, COLOR_GREEN, COLOR_GREEN, COLOR_GREEN);
                DisablePlayerRaceCheckpoint(playerid);
            }
            else if(p_temp[playerid][pPressed] == sizeof(Train) - 1)
            {
                p_temp[playerid][pPressed] = 0;
                new idx = p_temp[playerid][pPressed];
                SetPlayerRaceCheckpoint(playerid, 0, Train[idx][trainPosX], Train[idx][trainPosY], Train[idx][trainPosZ]-1.5, Train[idx+1][trainPosX], Train[idx+1][trainPosY], Train[idx+1][trainPosZ]-1.5, 3.0);
            }
