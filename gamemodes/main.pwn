            if(p_temp[playerid][Work_ID] == THEFT_CAR_WORK && listitem == 4) return EndPlayerJob(playerid);
            if(p_temp[playerid][Work_ID] != THEFT_CAR_WORK) return SendError(playerid, "�� �� ������ ������� ����.");
            if(!(0 <= listitem <= 3)) return SendError(playerid, "���-�� ����� �� ���, ���������� ������ ��� �������� ������ �������.");
            static v_skills[] = {0, 15, 30, 50};
