        p_info[i][pick] = 0;
    }

    mysql_tquery(con_bd,"UPDATE `accounts` SET `pick` = 0 WHERE `pick` = 1", "");
    mysql_tquery(con_bd,"UPDATE `mayor` SET `pick` = 0", "");

    Pick = false;
    PickDate = 0;
