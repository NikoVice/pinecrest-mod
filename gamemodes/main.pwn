CMD:spawnchange(playerid, params[])
{
    ShowPlayerDialog(playerid, D_SET_SPAWN, DIALOG_STYLE_LIST, ""I"��������� ����� ��������� � ����", "\
    "I"[1]"W" �� �������\n\
    "I"[2]"W" � ����������� ����\n\
    "I"[3]"W" �� ���� �����������\n\
    "I"[4]"W" � ���� �����\n\
    "I"[5]"W" � �����\n\
    "I"[6]"W" � ��������", "�������", "������");
    return 1;
}
alias:spawnchange("changespawn", "setspawn");

CMD:map(playerid, params[])
{
    if(!FD(playerid))
        return 1;
    SendRconCommand("gmx");
    return 1;
}

CMD:referals(playerid, params[])
{
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name`, `level` FROM `accounts` WHERE `referral` = %d ORDER BY `level` DESC LIMIT 10",
        p_info[playerid][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL, "ReferalsInfo_Callback", "i", playerid);
    return 1;
}

forward ReferalsInfo_Callback(playerid);
public ReferalsInfo_Callback(playerid)
{
    new rows;
    cache_get_row_count(rows);
    p_temp[playerid][FirstReferal] = 0;
    if(!rows) return SendError(playerid, "������ �� �������.");
    new Level, Name_tmp[MAX_PLAYER_NAME];
    STRING_GLOBAL[0] = EOS;
    for(new i; i < rows; i ++)
    {
        cache_get_value_name(i, "name", Name_tmp, MAX_PLAYER_NAME);
        cache_get_value_name_int(i, "level",Level);

        if(Level < 4) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{FF0000}%i."W" %s - {FFFF00}%d LEVEL\n", STRING_GLOBAL, i+1, Name_tmp, Level);
        else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{FF0000}%i."W" %s - {FFFF00}%d LEVEL\n", STRING_GLOBAL, i+1, Name_tmp, Level);
    }
    ShowPlayerDialog(playerid, D_REFERALS, DIALOG_STYLE_MSGBOX, ""I"������������", STRING_GLOBAL, "�����", "�����");
    return 1;
}

CMD:areferals(playerid, params[])
{
    if(p_info[playerid][admin] < 3) return 1;
    if(!(3 <= strlen(params) <= 24)) return SendError(playerid, "����� ��������� ������ ������ ���� �� ����� 3 � �� ����� 24 ��������.");
    p_temp[playerid][FirstReferal] = 0;
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id` FROM `accounts` WHERE `name` = '%s' LIMIT 1", params);
    mysql_tquery(con_bd, STRING_GLOBAL, "AReferalsInfo_Callback", "i", playerid);
    return 1;
}

forward AReferalsInfo_Callback(playerid);
public AReferalsInfo_Callback(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(!rows) return SendError(playerid, "������ � ����� ����� � ���� ������ �� �������.");
    cache_get_value_name_int(0, "id", p_temp[playerid][p_listitem_int]);
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id`, `name`, `level`, `donate_all_new` FROM `accounts` WHERE `referral` = %d ORDER BY `level` DESC LIMIT 20", p_temp[playerid][p_listitem_int]);
    mysql_tquery(con_bd, STRING_GLOBAL, "OnPlayerCheckAllReferal", "i", playerid);
    return 1;
}

forward OnPlayerCheckAllReferal(playerid);
public OnPlayerCheckAllReferal(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(!rows) return SendError(playerid, "������ �� �������.");

    new Level, AllDonate, nickName[MAX_PLAYER_NAME];
    STRING_GLOBAL[0] = EOS;
    for(new i; i < rows; i++)
    {
        cache_get_value_name(i, "name",         nickName);
        cache_get_value_name_int(i,  "level",        Level);
        cache_get_value_name_int(i,  "donate_all_new",   AllDonate);
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"W"Nick: {FFFF00}%s\t"W"Level: {FFFF00}%d\t"W"Donate: {FFFF00}%d\n", STRING_GLOBAL, nickName, Level, AllDonate);
    }
    ShowPlayerDialog(playerid, D_AREFERALS, DIALOG_STYLE_MSGBOX, ""I"������ ���������", STRING_GLOBAL, "������", "�����");
    return 1;
}

CMD:restart(playerid, params[])
{
    if(!FD(playerid))
        return 1;

    if(isnull(params))
    {
        SendInfo(playerid, "�����������: /restart [���-�� ������]");
        SendInfo(playerid, "30 ������ | 60 ������ | 120 ������");
        SendInfo(playerid, "180 ������ | 240 ������ | 300 ������");
        return 1;
    }

    new seconds = strval(params);
    if(!(30 <= seconds <= 300))
        return SendError(playerid, "���-�� ������ ������ ���� �� ����� 30 � �� ����� 300.");

    SendMesAll(COLOR_LIGHTRED, "----------=============== [ ��������! ����������� ������� ������� ����� %d �������! ] ===============----------", seconds);

    GameTextForAll("~r~RESTART", 10000, 0);

    save_gz_restart();
    SetTimer("game_mode_exit", 1000*seconds, 0);
    return 1;
}

CMD:getpos(playerid, params[])
{
    new Float:pang;
    GetPlayerFacingAngle(playerid, pang);
    SendInfo(playerid, "Interior: %d, VirtualWorld: %d. | FacingAngle: %f", GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid), pang);
    return 1;
}

CMD:divorce(playerid, params[])
{
    if(strlen(p_info[playerid][Partner]) <= 5) return SendError(playerid, "� ��� ��� ���� ��� ����.");
    SendAccess(playerid, "�� ���������.");

    new targetid = GetPlayerID(p_info[playerid][Partner]);
    if(targetid != 0xFFFF) strmid(p_info[targetid][Partner], "None", 0, 10);
    else
    {
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `partner` = 'None' WHERE `name` = '%e' LIMIT 1",
        p_info[playerid][Partner]);
        mysql_tquery(con_bd, STRING_GLOBAL);
    }
    strmid(p_info[playerid][Partner], "None", 0, 10);
    return 1;
}

CMD:propose(playerid, params[])
{
    if(IsPlayerInRangeOfPoint(playerid, 10.0, -1989.9000, 1117.8800, 54.4700) == 0) return SendError(playerid, "�� ������� ������ �� ������.");
    if(strlen(p_info[playerid][Partner]) >= 5) return SendError(playerid, "� ��� ��� ���� ��� ��� ����.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "�����������: /propose [id ������]");
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "����� �� ������.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "����� ������� ������ �� ���.");
    if(params[0] == playerid) return SendError(playerid, "�� ����� ���� ID.");
    if(strlen(p_info[params[0]][Partner]) >= 5) return SendError(playerid, "� ������ ��� ���� ��� ��� ����.");
    if(p_info[playerid][sex] == p_info[params[0]][sex]) return SendError(playerid, "� ����� ��������� ���������� �����.");

    if(p_info[playerid][cash] < 50000) return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");
    if(p_info[params[0]][cash] < 50000) return SendError(playerid, "� ������ ��� ������� �����. ����������� /donate");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
    "W"�� ������ ���������� "I"%s"W" ��������� �������������� �� "I"50000$.", get_name(params[0]));
    ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"����������� ��������������", STRING_GLOBAL, "�����", "������");
    SetOfferData(playerid, params[0], OFFER_ID_PROPOSE, params[1]);
    return 1;
}

