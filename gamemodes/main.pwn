forward load_radar();
public load_radar()
{
    new rows;
    cache_get_row_count(rows);
    if(rows)
    {
        for(new idx = 0; idx < rows; idx++)
        {
            cache_get_value_name_int(idx, "rID", RadarInfo[idx][rID]);
            cache_get_value_name_int(idx, "rRadius", RadarInfo[idx][rRadius]);
            cache_get_value_name_int(idx, "rSpeed", RadarInfo[idx][rSpeed]);
            cache_get_value_name_float(idx, "rX", RadarInfo[idx][rX]);
            cache_get_value_name_float(idx, "rY", RadarInfo[idx][rY]);
            cache_get_value_name_float(idx, "rZ", RadarInfo[idx][rZ]);
            cache_get_value_name_float(idx, "rRZ", RadarInfo[idx][rRZ]);

            RadarInfo[idx][rObj] = CreateDynamicObject(18880, RadarInfo[idx][rX], RadarInfo[idx][rY], RadarInfo[idx][rZ], 0.0, 0.0, RadarInfo[idx][rRZ], -1, -1, -1, 120.0, 120.0);
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Радар №%d\nОграничение скорости: %d км/ч", RadarInfo[idx][rID], RadarInfo[idx][rSpeed]);
            RadarInfo[idx][r3DText] = CreateDynamic3DTextLabel(STRING_GLOBAL, COLOR_MAIN, RadarInfo[idx][rX], RadarInfo[idx][rY], RadarInfo[idx][rZ], 15.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, streamer_TESTLOL);

            RadarInfo[idx][rArea] = CreateDynamicSphere(RadarInfo[idx][rX], RadarInfo[idx][rY], RadarInfo[idx][rZ], 20.0, 0, 0, -1);
            UpdateAreaInfo(RadarInfo[idx][rArea], TYPE_RADAR, AREA_SUBTYPE_INVALID_ID, idx);

            RadarInfo[idx][rMapIcon] = CreateDynamicMapIcon(RadarInfo[idx][rX], RadarInfo[idx][rY], RadarInfo[idx][rZ], 34, -1, 0, -1, -1, 100.0);
            TOTALRADAR++;
        }
    }
    printf("Радары загружены  [%i штук] ", TOTALRADAR);
    return 1;
}
