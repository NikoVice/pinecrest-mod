            if(listitem == 0)
                ShowPlayerDialog(playerid, 17, DIALOG_STYLE_INPUT, ""I"Создание дома", ""W"Введите через запятую: (Тип дома),(Цена)\nТип домов: 1 тип - 15кв.м | 2 тип - 36кв.м | 3 тип - 72кв.м | 4 тип - 120кв.м\n\n"I"[ Например: 1,50000 | где - (1 Тип, 50000 - цена) ]","Создать", "Назад");
