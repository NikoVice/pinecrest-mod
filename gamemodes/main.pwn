        case D_CASINO_BLOCK:
        {
            if(!response) return 1;
            p_info[playerid][casino_block] = timestamp + 86400;
            MysqlUpdatePlayerInt(playerid, "casino_block", p_info[playerid][casino_block]);
            SendAccess(playerid, "Вы заблокировали себе вход в казино на 24 часа.");
            SendInfo(playerid, "Отменить данное действие невозможно.");
            return 1;
        }

        case D_BLACKJACK_SET_BET:
        {
            new tableID = blackjackPlayerData[playerid][BJ_CurrentTableID];
            if(!response || tableID == -1 || (blackjackTableData[tableID][BJ_CurrentTableState] != BJ_StateNone && blackjackTableData[tableID][BJ_CurrentTableState] != BJ_StateWaitBets))
                return 1;


            if(isnull(inputtext))
                return ShowPlayerDialog(playerid, D_BLACKJACK_SET_BET, DIALOG_STYLE_INPUT, "Ставка", ""W"Введите сумму которую желаете поставить:", "Поставить", "Закрыть");

            new
                bj_bet = strval(inputtext);

            if(!(10000 <= bj_bet <= 2000000))
            {
                ShowPlayerDialog(playerid, D_BLACKJACK_SET_BET, DIALOG_STYLE_INPUT, "Ставка", ""W"Введите сумму которую желаете поставить:", "Поставить", "Закрыть");
                return SendError(playerid, "Сумма ставки должна быть от "I"$10000 "W"до "I"$2000000"W".");
            }

            if(bj_bet > p_info[playerid][cash])
            {
                ShowPlayerDialog(playerid, D_BLACKJACK_SET_BET, DIALOG_STYLE_INPUT, "Ставка", ""W"Введите сумму которую желаете поставить:", "Поставить", "Закрыть");
                return SendError(playerid, "Недостаточно денег чтобы сделать ставку.");
            }

            blackjackPlayerData[playerid][BJ_SetBet][0] = bj_bet;
            SetPlayerMoney(playerid, -blackjackPlayerData[playerid][BJ_SetBet][0], true, "ставка в blackjack");

            SendAccess(playerid, "Вы поставили $%d. Ожидайте начала игры.", bj_bet);

            UpdateBJPInfoTextdrawForAll(playerid);
            blackjackPlayerData[playerid][BJ_ButtonsState][BJ_ButtonStayOrBet] = false;
            ShowBlackjackButtonsForPlayer(playerid);
            return 1;

        }

        case D_BILLBOARD:
        {
            if(!response) return 1;
            if(listitem < 0 || listitem > MAX_BILLBOARD - 1) return SendError(playerid, "Что-то пошло не так, попробуйте заново или обновите версию клиента.");
            new biz_id = GetPVarInt(playerid, "bID");
            if(BillboardInfo[listitem][bbPlayerID] == 0)
            {
                for(new i = 0; i < MAX_BILLBOARD; i++)
                {
                    if(BillboardInfo[i][bbPlayerID] == p_info[playerid][ID])
                    {
                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                        Вы уже арендовали билборд {"#cBLUE"}\"%s\"."W"\n\n\
                        Чтобы управлять рекламой, выберите его в списке.", BillboardInfo[i][bbName]);
                        ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"У Вас уже есть арендованный билборд", STRING_GLOBAL, "Закрыть", "");
                        return 1;
                    }
                }
                if(p_info[playerid][level] < 5) return SendError(playerid, "Аренда билборда доступна с 5-ого уровня.");
                ShowDialogBillboard(playerid, biz_id, BB_LIST_RENT, listitem);
            }
            else if(BillboardInfo[listitem][bbPlayerID] == p_info[playerid][ID])
            {
                ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, listitem);
                SetPVarInt(playerid, "BILLBOARD:idx", listitem);
            } else ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Билборд уже арендован", ""W"Данный билборд уже арендован.", "Закрыть", "");
            return 1;
        }
        case D_BILLBOARD_RENT:
        {
            new biz_id = GetPVarInt(playerid, "bID"), idx = GetPVarInt(playerid, "BILLBOARD:idx");
            if(!response)
            {
                Fix_TogglePlayerControllable(playerid, 1);
                SetPlayerPos(playerid, b_info[biz_id][b_menu][0], b_info[biz_id][b_menu][1], b_info[biz_id][b_menu][2]);
                SetPlayerInterior(playerid, b_info[biz_id][_int]);
                SetPlayerVirtualWorld(playerid, b_info[biz_id][_world]);
                SetCameraBehindPlayer(playerid);
                DeletePVar(playerid, "BILLBOARD:idx");
                return 1;
            }
            new fix_listitem;
            if(sscanf(inputtext, "i", fix_listitem)) return ShowDialogBillboard(playerid, biz_id, BB_LIST_RENT, idx), SendError(playerid, "Вы ничего не ввели.");
            if(fix_listitem < 1 || fix_listitem > 7) return ShowDialogBillboard(playerid, biz_id, BB_LIST_RENT, idx), SendError(playerid, "Количество дней должно быть не менее 1 и не более 7.");
            new till = b_info[biz_id][_till], price = (BILLBOARD_PRICE_RENT * till) * fix_listitem;
            if(p_info[playerid][cash] < price) return ShowDialogBillboard(playerid, biz_id, BB_LIST_RENT, idx), SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            OnServerInfoForMoney[10] += price;
            SetPlayerMoney(playerid, -price, true, "аренда билборда");

            new prod = price / 10;

            if(b_info[biz_id][_prod] >= prod)
            {
                b_info[biz_id][_prod] -= prod;
                b_info[biz_id][_bank] += (price / 100) * 90;
                AddMafiaBank(biz_id, price/10);

                biz_finka[biz_id] += (price / 100) * 90;
                UpdateIntForFinanceBiz(biz_id, (price / 100) * 90);
            }

            BillboardInfo[idx][bbPlayerID] = p_info[playerid][ID];
            BillboardInfo[idx][bbDays] = fix_listitem;

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `billboard` SET `playerid` = %d, `days` = %d WHERE `id` = %d",
            BillboardInfo[idx][bbPlayerID], BillboardInfo[idx][bbDays], BillboardInfo[idx][bbMySQLID]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            SendAccess(playerid, "Вы арендовали билборд на %d дн.", BillboardInfo[idx][bbDays]);
            SendInfo(playerid, "Для настройки параметров билборда воспользуйтесь меню.");

            ShowDialogBillboard(playerid, biz_id, BB_LIST_SETTINGS, idx);
            return 1;
        }
        case D_BILLBOARD_SETTINGS:
        {
            new biz_id = GetPVarInt(playerid, "bID");
