                                if(count >= 30) ShowPlayerDialog(playerid, D_MDC_VEHICLE_NOTE, DIALOG_STYLE_MSGBOX, ""I"MDC - ���������� ������ � ��", "{B4B5B7}���������� ������ � ��\n\n��������!\n��� ������� ������!", "�������", "");
                                else ShowPlayerDialog(playerid, D_MDC_ADD_NOTE, DIALOG_STYLE_INPUT, ""I"MDC - ���������� ������ � ��", "{B4B5B7}���������� ������ � ��\n\n������� ����� �������:", "����", "�����");
                                return 1;
