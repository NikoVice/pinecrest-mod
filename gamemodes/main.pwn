}
forward load_mayor();
public load_mayor()
{
    new str[256], time = GetTickCount();
    if(cache_num_rows())
    {
        f_mysql_fetch_row_format(0, str, cache_num_fields());
        sscanf(str, "p<|>is[256]is[144]",
        Pick,
        PickNames,
        PickDate,
        PickVotes);
        sscanf(PickNames, "p<,>s[32]s[32]s[32]s[32]s[32]s[32]s[32]", PickName[0], PickName[1], PickName[2], PickName[3], PickName[4], PickName[5], PickName[6]);
        sscanf(PickVotes, "p<,>a<i>[7]", PickVote);
    }
    printf("������ ������������� ��������� �� %d ��", GetTickCount()-time);
    return 1;
}
