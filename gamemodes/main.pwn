        case D_PROMOCODE_BACK_CONTROL: return ShowDialogPromocode(playerid, PROMOCODE_CONTROL);
        case D_CRAFT_COUNT:
        {
            if(!response) return 1;

            new
                fix_listitem = -1;

            if(sscanf(inputtext, "i", fix_listitem))
                return SendMes(playerid, COLOR_DARKORANGE, "[КРАФТ]: "W"Вы ничего не ввели.");

            if(fix_listitem < 1 || fix_listitem > 50)
                return SendMes(playerid, COLOR_DARKORANGE, "[КРАФТ]: "W"Количество должно быть не менее 1 и не более 50.");

            p_temp[playerid][craft_count] = fix_listitem;
            UpdatePlayerCraft(playerid, CRAFT_TYPE_UPDATE_COUNT);
            new idx = p_temp[playerid][craft_idx];
            if(idx == -1) UpdatePlayerCraft(playerid, CRAFT_TYPE_UPDATE_MAIN);
            else UpdatePlayerCraft(playerid, CRAFT_TYPE_UPDATE_MAIN, CraftInfo[idx][cItemsIDx]);

            SendMes(playerid, COLOR_GREEN, "[КРАФТ]: "W"Вы изменили количество на %d.", fix_listitem);
            return 1;
        }
        case D_VC_RACK:
        {
            if(!response) return 1;
            new idx = p_temp[playerid][p_listitem][listitem];

            if(p_temp[playerid][p_listitem_int] != -1)
            {
                new iTax;
                for(new i = p_temp[playerid][p_listitem_int]-1; i != -1; i--)
                    iTax += VideoCardsInfo[p_temp[playerid][p_listitem][i]][vcTax];
                if(p_temp[playerid][p_listitem_int] == listitem)
                {
                    if(iTax <= 0) 
                    {
                        SendError(playerid, "Данные видеокарты ещё не обладают налогом.");
                        return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]);
                    }
                    f(STRING_GLOBAL, ""W"На всех видеокартах сейчас налог: "I"%d$."W"\n\n\
                        Вы действительно хотите оплатить налог?", iTax);
                    ShowPlayerDialog(playerid, D_VC_TAX_ALL, DIALOG_STYLE_MSGBOX, ""I"Оплатить налог", STRING_GLOBAL, "Да", "Нет");
                    return 1;
                }
                else if(p_temp[playerid][p_listitem_int]+1 == listitem)
                {
                    new iBTC, btc;
                    for(new i = p_temp[playerid][p_listitem_int]-1; i != -1; i--)
                    {
                        btc = floatround(VideoCardsInfo[p_temp[playerid][p_listitem][i]][vcBitcoin], floatround_floor);
                        if(btc > 0) 
                            iBTC += btc;
                    }
                    if(iBTC <= 0) 
                    {
                        SendError(playerid, "Данные видеокарты ещё не заработали BTC.");
                        return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]);
                    }
                    if(iTax > 0) 
                    {
                        SendError(playerid, "На какой-то из видеокарт есть не оплаченный налог.");
                        return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]);
                    }
                    if(iBTC < 1) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]), SendError(playerid, "Количество BTC должно быть не менее 1.");
                    new max_btc = MAX_PLAYER_BITCOIN - p_info[playerid][bitcoin];
                    if(max_btc < 0 || iBTC > max_btc) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]), SendError(playerid, "Количество Bitcoin не может быть более %d.", max_btc);

                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, ""W"\
                    Выводить можно только целую часть прибыли, сейчас можно\n\
                    вывести: "I"%d BTC."W"\n\n\
                    Вы действительно хотите вывести BTC?", iBTC);
                    ShowPlayerDialog(playerid, D_VC_BITCOIN_ALL, DIALOG_STYLE_MSGBOX, ""I"Забрать прибыль", STRING_GLOBAL, "Да", "Нет");
                    return 1;
                }
            }
            if(idx == -1) return SendError(playerid, "Стойка не определена, попробуйте еще раз.");
            ShowVideoCards(playerid, VIDEO_CARDS_TYPE_CONTROL, idx);
            
            for(new i = 0; i < p_temp[playerid][p_listitem_int]; i++) p_temp[playerid][p_listitem][i] = -1;
            p_temp[playerid][p_listitem_int] = -1;
            return 1;
        }
        case D_VC_CONTROL:
        {
            if(!response) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]);
            new idx = p_temp[playerid][vc_idx];
            switch(listitem)
            {
                case 0:
                {
                    if(VideoCardsInfo[idx][vcStatus] == 0)
                    {
                        if(VideoCardsInfo[idx][vcBitcoin] >= MAX_VIDEO_CARDS_BITCOIN) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_CONTROL, idx), SendError(playerid, "На видеокарте максимальное количество Bitcoin, выведите их.");
                        if(VideoCardsInfo[idx][vcTax] >= MAX_VIDEO_CARDS_TAX) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_CONTROL, idx), SendError(playerid, "На видеокарте максимальное количество налога, оплатите его.");
                        if(VideoCardsInfo[idx][vcCoolant] < 50.0) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_CONTROL, idx), SendError(playerid, "Состояние охлаждающей жидкости меньше половины, пополните ее.");
                    }
                    VideoCardsInfo[idx][vcStatus] ^= 1;
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `videocards` SET `status` = %d, `coolant` = '%f' WHERE `id` = %d",
                    VideoCardsInfo[idx][vcStatus], VideoCardsInfo[idx][vcCoolant], VideoCardsInfo[idx][vcMySQLIDx]);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                    SendInfo(playerid, "Вы %s видеокарту.", VideoCardsInfo[idx][vcStatus] == 0 ? "остановили" : "запустили");
                    ShowVideoCards(playerid, VIDEO_CARDS_TYPE_CONTROL, idx);
                }
                case 1: ShowVideoCards(playerid, VIDEO_CARDS_TYPE_BITCOIN, idx);
                case 2: ShowVideoCards(playerid, VIDEO_CARDS_TYPE_TAX, idx);
                case 3: ShowVideoCards(playerid, VIDEO_CARDS_TYPE_POWER_STATION, idx);
                case 4:
                {
                    if(VideoCardsInfo[idx][vcCoolant] == 100.0) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_CONTROL, idx), SendError(playerid, "Охлаждающая жидкость на видеокарте имеет максимальное значение.");
                    if(!GetInventoryAmount(playerid, 709)) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_CONTROL, idx), SendError(playerid, "У Вас нет охлаждающей жидкости.");

                    GivePlayerInventory(playerid, 709, -1);

                    VideoCardsInfo[idx][vcCoolant] += 50.0;
                    if(VideoCardsInfo[idx][vcCoolant] > 100.0) VideoCardsInfo[idx][vcCoolant] = 100.0;

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `videocards` SET `coolant` = '%f' WHERE `id` = %d",
                    VideoCardsInfo[idx][vcCoolant], VideoCardsInfo[idx][vcMySQLIDx]);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                    SendAccess(playerid, "Вы залили охлаждающую жидкость. Состояние: %f.", VideoCardsInfo[idx][vcCoolant]);
                    ShowVideoCards(playerid, VIDEO_CARDS_TYPE_CONTROL, idx);
                }
                case 5: ShowVideoCards(playerid, VIDEO_CARDS_TYPE_UPGRADE, idx);
                case 6: ShowVideoCards(playerid, VIDEO_CARDS_TYPE_HELP, idx);
            }
            return 1;
        }
        case D_VC_BITCOIN_ALL:
        {
            if(!response) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]);
            new iBTC, idx, btc;
            for(new i = p_temp[playerid][p_listitem_int]-1; i != -1; i--)
            {
                idx = p_temp[playerid][p_listitem][i];
                btc = floatround(VideoCardsInfo[idx][vcBitcoin], floatround_floor);
                if(btc > 0) 
                    iBTC += btc;
            }
            if(iBTC < 1) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]), SendError(playerid, "Количество BTC должно быть не менее 1.");
            new max_btc = MAX_PLAYER_BITCOIN - p_info[playerid][bitcoin];
            if(max_btc < 0 || iBTC > max_btc) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]), SendError(playerid, "Количество Bitcoin не может быть более %d.", max_btc);

            for(new i = p_temp[playerid][p_listitem_int]-1; i != -1; i--)
            {
                idx = p_temp[playerid][p_listitem][i];
                btc = floatround(VideoCardsInfo[idx][vcBitcoin], floatround_floor);
                if(btc > 0)
                {
                    VideoCardsInfo[idx][vcBitcoin] -= float(btc);
                    p_info[playerid][bitcoin] += btc;
                    
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `videocards` SET `bitcoin` = '%f' WHERE `id` = %d",
                    VideoCardsInfo[idx][vcBitcoin], VideoCardsInfo[idx][vcMySQLIDx]);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                }
            }
            SendAccess(playerid, "Вы сняли %d BTC.", iBTC);

            MysqlUpdatePlayerInt(playerid, "bitcoin", p_info[playerid][bitcoin]);
