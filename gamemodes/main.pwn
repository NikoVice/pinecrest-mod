LoadDatabaseInfo()
{
    //mysql_tquery(con_bd,"SELECT * FROM `fraction_store`", "fraction_store",""); // Загрузка складов;
    mysql_tquery(con_bd,"SELECT * FROM `hotel_rooms`", "load_hotel_rooms",""); // Загрузка номеров в отеле;
    mysql_tquery(con_bd,"SELECT * FROM `other`", "load_other",""); // Загрузка переменных;
    mysql_tquery(con_bd,"SELECT * FROM `gangzone`", "load_gangzone",""); // Загрузка гангзон;
    mysql_tquery(con_bd,"SELECT * FROM `radars`", "load_radar",""); // Загрузка радаров;
    mysql_tquery(con_bd,"SELECT * FROM `family`", "load_family", ""); // Загрузка семей;
    mysql_tquery(con_bd,"SELECT * FROM `mayor`", "load_mayor",""); // Загрузка мэрий;
    mysql_tquery(con_bd,"SELECT * FROM `graffiti`", "load_graffiti",""); // Загрузка граффити;
    mysql_tquery(con_bd,"SELECT * FROM `parkings`", "load_park",""); // Загрузка парковок;
