stock button_cancelbuy(playerid)
{
    if(GetPlayerInterior(playerid) == 15 && GetPlayerVirtualWorld(playerid) == 2023 && GetPlayerSkin(playerid) > 311)
    {
        HideTextDrawForPlayer(playerid, TD_ID_SHOP);

        SetCameraBehindPlayer(playerid);
        p_temp[playerid][shop_id] = 0;
        return 1;
    }
    if(p_temp[playerid][tune_default] == true)
        return ShowPlayerDialog(playerid, D_TUNE_DEFAULT_CANCEL, DIALOG_STYLE_MSGBOX, ""I"������ �������", ""W"�� ������������� ������ ���������� �� �������?", "��", "���");
    /*
    if(p_temp[playerid][tune_object] == true)
        return ShowPlayerDialog(playerid, D_TUNE_OBJECT_CANCEL, DIALOG_STYLE_MSGBOX, ""I"������ �������", ""W"�� ������������� ������ ���������� �� �������?", "��", "���");
    */
    new h = GetPlayerHouseID(playerid);
    if(h != INVALID_HOUSE_ID && p_temp[playerid][h_repair_txtid] != -1)
    {
        new h_class = h_info[h][h_squar]-1;
        new int_id = h_info[h][h_int];
        if(IsPlayerInRangeOfPoint(playerid, 50.0, h_ints[h_class][int_id][i_spawn_pos][0],h_ints[h_class][int_id][i_spawn_pos][1],h_ints[h_class][int_id][i_spawn_pos][2]) && h+50 == GetPlayerVirtualWorld(playerid) ||
            IsPlayerInRangeOfPoint(playerid, 50.0, g_info[h_class-1][g_pX], g_info[h_class-1][g_pY], g_info[h_class-1][g_pZ]) && h+50 == GetPlayerVirtualWorld(playerid))
            return ShowPlayerDialog(playerid, D_CANCEL_REPAIR, DIALOG_STYLE_MSGBOX, ""I"������ �������", ""W"�� ������������� ������ ���������� �� �������?", "��", "���");
    }
    new biz_id = GetPVarInt(playerid, "bID");
    if(b_info[biz_id][_tip] == 2 && PlayerToPoint(5.0,playerid,b_info[biz_id][b_menu][0],b_info[biz_id][b_menu][1],b_info[biz_id][b_menu][2]))
    {
        if(!gang(playerid) && !mafia(playerid) && !biker(playerid) && p_info[playerid][fwork] != true)
            return ShowPlayerDialog(playerid,D_CANCEL_SKIN, DIALOG_STYLE_MSGBOX, ""I"������ �������", ""W"�� ������������� ������ ���������� �� �������?", "��", "���");
    }
    else if(b_info[biz_id][_tip] == B_ACCESSORIES && PlayerToPoint(5.0,playerid,b_info[biz_id][b_menu][0],b_info[biz_id][b_menu][1],b_info[biz_id][b_menu][2]))
        return ShowPlayerDialog(playerid, D_CANCEL_ACCESSORIES, DIALOG_STYLE_MSGBOX, ""I"������ �������", ""W"�� ������������� ������ ���������� �� �������?", "��", "���");
    return 1;
}

stock button_buy(playerid)
{
    if(GetPlayerInterior(playerid) == 15 && GetPlayerVirtualWorld(playerid) == 2023 && GetPlayerSkin(playerid) > 311)
    {
        return ShowPlayerDialog(playerid, D_BUY_REAL_SKIN, DIALOG_STYLE_MSGBOX, ""I"�������", ""W"�� ������������� ������ ������ ������ ����?", "��", "���");
    }

    if(p_temp[playerid][tune_default] == true)
        return ShowPlayerDialog(playerid, D_TUNE_DEFAULT_BUY, DIALOG_STYLE_MSGBOX, ""I"�������", ""W"�� ������������� ������ ������ ��������� �������?", "��", "���");
    /*
    if(p_temp[playerid][tune_object] == true)
        return ShowPlayerDialog(playerid, D_TUNE_OBJECT_BUY, DIALOG_STYLE_MSGBOX, ""I"�������", ""W"�� ������������� ������ ������ ������ ���������?", "��", "���");
    */
    new h = GetPlayerHouseID(playerid);
    if(h != INVALID_HOUSE_ID && p_temp[playerid][h_repair_txtid] != -1)
    {
        new h_class = h_info[h][h_squar]-1;
        new int_id = h_info[h][h_int];
        if( IsPlayerInRangeOfPoint(playerid, 50.0, h_ints[h_class][int_id][i_spawn_pos][0],h_ints[h_class][int_id][i_spawn_pos][1],h_ints[h_class][int_id][i_spawn_pos][2]) && h+50 == GetPlayerVirtualWorld(playerid) ||
            IsPlayerInRangeOfPoint(playerid, 50.0, g_info[h_class-1][g_pX], g_info[h_class-1][g_pY], g_info[h_class-1][g_pZ]) && h+50 == GetPlayerVirtualWorld(playerid))
            return ShowPlayerDialog(playerid, D_BUY_REPAIR, DIALOG_STYLE_MSGBOX, ""I"�������", "�� ������������� ������ ������ ������ ������?", "��", "���");
    }
    new biz_id = GetPVarInt(playerid, "bID");
    if(b_info[biz_id][_tip] == 2 && PlayerToPoint(5.0,playerid,b_info[biz_id][b_menu][0],b_info[biz_id][b_menu][1],b_info[biz_id][b_menu][2]))
    {
        if(!gang(playerid) && !mafia(playerid) && !biker(playerid) && p_info[playerid][fwork] != true)
            return ShowPlayerDialog(playerid, D_BUY_SKIN, DIALOG_STYLE_MSGBOX, ""I"�������", ""W"�� ������������� ������ ������ ������ ����?", "��", "���");
    }
    else if(b_info[biz_id][_tip] == B_ACCESSORIES && PlayerToPoint(5.0,playerid,b_info[biz_id][b_menu][0],b_info[biz_id][b_menu][1],b_info[biz_id][b_menu][2]))
        return ShowPlayerDialog(playerid, D_BUY_ACCESSORIES, DIALOG_STYLE_MSGBOX, ""I"������� ����������", "�� ������������� ������ ������ ������ ���������?", "��", "���");
    return 1;
}

stock button_next(playerid)
{
    if(GetPlayerInterior(playerid) == 15 && GetPlayerVirtualWorld(playerid) == 2023 && GetPlayerSkin(playerid) > 311)
    {
        p_temp[playerid][shop_id]++;
        if(p_temp[playerid][shop_id] >= sizeof(skinDonate)) p_temp[playerid][shop_id] = 0;
        SetPlayerSkin(playerid, ItemsInfo[skinDonate[p_temp[playerid][shop_id]][0]][iModel]);
        new string[14];
        format(string,sizeof(string),"%d FM", skinDonate[p_temp[playerid][shop_id]][1]);
        PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], string);
        return 1;
    }

    if(p_temp[playerid][tune_default] == true)
    {
        if(!IsPlayerInAnyVehicle(playerid) || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
            return Service_Error(playerid, "�� ������ ���������� � ������������ ��������.");
        new vehicleid = GetPlayerVehicleID(playerid),
            tune_id = p_temp[playerid][p_listitem][1];
        if(p_temp[playerid][p_listitem][0] != vehicleid)
            return Service_Error(playerid, "ID ���������� �� ��������� � ��������������, �������������� �������� ����������� ��������.");
        new max_value = p_temp[playerid][p_listitem][5];
        if(max_value == -1) return Service_Error(playerid, "�� ������� ������������ ��������, �������������� �������� ����������� ��������.");

        p_temp[playerid][shop_id]++;
        if(p_temp[playerid][shop_id] >= max_value) p_temp[playerid][shop_id] = 0;

        new till = Service_GetTill(playerid);
        if(till == -1) return Service_Error(playerid, "�� ������ ID �����������, �������������� �������� ����������� ��������.");

        STRING_GLOBAL[0] = EOS;
        if(p_temp[playerid][TextDrawServiceTune])
        {
            f(STRING_GLOBAL, "%d", GetPriceTuneElement(tune_id, p_temp[playerid][shop_id]) * till);
            PlayerTextDrawSetString(playerid, PTD_ServiceTune[playerid][8], STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            GetVehicleComponentName(p_temp[playerid][e_tListComponents][p_temp[playerid][shop_id]], STRING_GLOBAL);
            PlayerTextDrawSetString(playerid, PTD_ServiceTune[playerid][15], STRING_GLOBAL);
        }
        else
        {
            f(STRING_GLOBAL, "%d$", GetPriceTuneElement(tune_id, p_temp[playerid][shop_id]) * till);
            PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], STRING_GLOBAL);
        }

        if(tune_id == v_paintjob) ChangeVehiclePaintjob(vehicleid, p_temp[playerid][shop_id]);
        else
        {
            VEx_AddVehicleComponent(vehicleid, p_temp[playerid][e_tListComponents][p_temp[playerid][shop_id]]);
            if(tune_id == v_sideskirt || tune_id == v_vents) VEx_AddVehicleComponent(vehicleid, p_temp[playerid][e_tListComponents][p_temp[playerid][shop_id]]);
        }
        return 1;
    }
    new h = GetPlayerHouseID(playerid);
    if(h != INVALID_HOUSE_ID && p_temp[playerid][h_repair_txtid] != -1)
    {
        new h_class = h_info[h][h_squar]-1;
        new int_id = h_info[h][h_int];
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL,"%d$", h_info[h][h_squar]*TEXTURE_HOUSE_PRICE);
        if(IsPlayerInRangeOfPoint(playerid, 50.0, h_ints[h_class][int_id][i_spawn_pos][0],h_ints[h_class][int_id][i_spawn_pos][1],h_ints[h_class][int_id][i_spawn_pos][2]) && h+50 == GetPlayerVirtualWorld(playerid))
        {
            new txd_max_value = GetMaxCountTextureHouse(p_temp[playerid][h_repair_txtid]);
            if(txd_max_value == -1) return SendError(playerid, "���: 7099 / ���������� �� �����! %d", p_temp[playerid][h_repair_txtid]);

            p_temp[playerid][shop_id]++;
            if(p_temp[playerid][shop_id] >= txd_max_value) p_temp[playerid][shop_id] = 0;
            h_info[h][h_mapping_id][p_temp[playerid][h_repair_txtid]] = p_temp[playerid][shop_id];
            House_Repair(h);
        }
        if(h_class == 0) return 1;
        if(IsPlayerInRangeOfPoint(playerid, 50.0, g_info[h_class-1][g_pX], g_info[h_class-1][g_pY], g_info[h_class-1][g_pZ]) && h+50 == GetPlayerVirtualWorld(playerid))
        {
            new txd_max_value = GetMaxCountTextureGarage(p_temp[playerid][h_repair_txtid]);
            if(txd_max_value == -1) return SendError(playerid, "���: 7098 / ���������� �� �����! %d", p_temp[playerid][h_repair_txtid]);

            p_temp[playerid][shop_id]++;
            if(p_temp[playerid][shop_id] >= txd_max_value) p_temp[playerid][shop_id] = 0;
            h_info[h][h_garage_id][p_temp[playerid][h_repair_txtid]] = p_temp[playerid][shop_id];
            Garage_Repair(h);
        }
        PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], STRING_GLOBAL);
        return 1;
    }

    new biz_id = GetPVarInt(playerid, "bID");
    if(b_info[biz_id][_tip] == 2 && PlayerToPoint(5.0,playerid,b_info[biz_id][b_menu][0],b_info[biz_id][b_menu][1],b_info[biz_id][b_menu][2]))
    {
        if(!gang(playerid) && !mafia(playerid) && !biker(playerid) && p_info[playerid][fwork] != true)
        {
            new string[256];
            if(p_info[playerid][sex] == 2)
            {
                p_temp[playerid][shop_id]++;
                if(p_temp[playerid][shop_id] >= sizeof(skinBuyMan)) p_temp[playerid][shop_id] = 0;
                SetPlayerSkin(playerid, ItemsInfo[skinBuyMan[p_temp[playerid][shop_id]]][iModel]);
                format(string,sizeof(string),"%d$",ItemsInfo[skinBuyMan[p_temp[playerid][shop_id]]][iPrice]);
                PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], string);
            }
            else
            {
                p_temp[playerid][shop_id]++;
                if(p_temp[playerid][shop_id] >= sizeof(skinBuyMale)) p_temp[playerid][shop_id] = 0;
                SetPlayerSkin(playerid, ItemsInfo[skinBuyMale[p_temp[playerid][shop_id]]][iModel]);
                format(string,sizeof(string),"%d$",ItemsInfo[skinBuyMale[p_temp[playerid][shop_id]]][iPrice]);
                PlayerTextDrawSetString(playerid, PTD_Shop[playerid][10], string);
            }
            return 1;
        }
    }
    else if(b_info[biz_id][_tip] == B_ACCESSORIES && PlayerToPoint(5.0,playerid,b_info[biz_id][b_menu][0],b_info[biz_id][b_menu][1],b_info[biz_id][b_menu][2]))
    {
        if(p_temp[playerid][p_listitem_int] == -1) return SendError(playerid, "��������� ������: 11.01-2144.");
        p_temp[playerid][shop_id]++;
        if(p_temp[playerid][shop_id] >= p_temp[playerid][p_listitem_int]) p_temp[playerid][shop_id] = 0;
        PreviewShopAccessories(playerid);
    }
    return 1;
}

