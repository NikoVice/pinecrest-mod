            if(FreelanceContract[idx][fcStatus] != 1) return ShowFreelance(playerid, FREELANCE_TYPE_LIST), SendError(playerid, "Данная задача уже выполняется или она была удалена.");
            FreelanceContract[idx][fcStatus] = 2;
