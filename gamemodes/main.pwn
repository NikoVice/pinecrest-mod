        if(--p_temp[playerid][shop_id] < 0) p_temp[playerid][shop_id] = (max_value-1);
        if(p_temp[playerid][shop_id] < 0 || p_temp[playerid][shop_id] > max_value) p_temp[playerid][shop_id] = 0;
        new groupid = p_temp[playerid][shop_id];
