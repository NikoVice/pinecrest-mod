    //if(timestamp_minute == 12 && timestamp_second == 05 || timestamp_minute == 32 && timestamp_second == 05 || timestamp_minute == 52 && timestamp_second == 05) TeleportInMP = false;

    if(timestamp_minute%10 == 0 && timestamp_second == 10)
    {
        mysql_tquery(con_bd, "SELECT * FROM `bitcoin` WHERE 1", "load_curs_btc", "i", 1);

        if(FifteenCheck == 0)
        {
            SendMesAll(COLOR_GREEN, "В магазине ты можешь приобрести нужное количество игровых денег и потратить их на");
            SendMesAll(COLOR_GREEN, "желаемый "W"дом, транспорт, бизнес, аксессуар, костюм{"#cGREEN"} или на покупку других вещей");
            SendMesAll(COLOR_GREEN, " — Игроки со статусом "W"VIP{"#cGREEN"} имеют большое количество возможностей и привилегий,");
            SendMesAll(COLOR_GREEN, " подробнее: "W"/donate > [21] VIP-аккаунт");
            SendMesAll(COLOR_GREEN, " — В магазине так-же можно приобрести редкий и уникальный "W"транспорт, Premium,");
            SendMesAll(COLOR_GREEN, " "W"слоты, навыки,{"#cGREEN"} а так-же предметы, которые выделят тебя из толпы.");
            SendMesAll(COLOR_GREEN, "Воспользоваться нашим магазином: "W"/donate{"#cGREEN"} Пополнить счет: "W""SITE_URL"/donate");
            FifteenCheck = 1;
        }
        else if(FifteenCheck == 1)
        {
            SendMesAll(COLOR_GREEN, "Захотели восстановить свой аккаунт? Переходите по ссылке: "W"pinecrest-rp.com/restore");
            SendMesAll(COLOR_GREEN, "Не знаете как зайти на форум? Переходите по ссылке: "W""FORUM_URL"");
            SendMesAll(COLOR_GREEN, "Хотите самыми первыми узнавать об обновлениях? Подпишитесь: "W""VK_URL"");
            FifteenCheck = 2;
        }
        else if(FifteenCheck == 2)
        {
            SendMesAll(COLOR_GREEN, "Хотите заработать "W"250000${"#cGREEN"} без каких-либо забот?");
            SendMesAll(COLOR_GREEN, "Если да, то приглашайте своих друзей играть вместе с Вами.");
            SendMesAll(COLOR_GREEN, "При достижении ими 5-ого уровня, Вам будет начислено "W"250000${"#cGREEN"} за каждого приглашенного.");
            FifteenCheck = 3;
        }
        else if(FifteenCheck == 3)
        {
            SendMesAll(COLOR_GREEN, "Хотите получить "W"бесплатно{"#cGREEN"} предметы инвентаря, скины, аксессуары, деньги и Pinecrest Money?");
            SendMesAll(COLOR_GREEN, "Если да, то отправляйтесь на поиски сундуков с сокровищами.");
            SendMesAll(COLOR_GREEN, "Они спрятаны в укромных местах по всей карте.");
            FifteenCheck = 0;
        }
        new idx = ServerInfo[DonationMultiplier];
        if(idx != 1)
        {
            SendMesAll(COLOR_LIGHTRED, "[X%d ДОНАТ]: "W"Действует {"#cLIGHTRED"}« Акция X%d »."W" Все зачисления {"#cLIGHTRED"}%s.", idx, idx, idx == 2 ? "удваиваются" : idx == 3 ? "утраиваются" : "умножаются на четыре");
            //SendMesAll(COLOR_LIGHTRED, "[АКЦИИ]: "W"Успей воспользоваться данным предложением. Приобрести: {"#cLIGHTRED"}/donate");
            //SendMesAll(COLOR_LIGHTRED, "[ВЕСЕННЯЯ РАСПРОДАЖА]:"W" До конца понедельника на все товары из магазина {"#cLIGHTRED"}« Скидка 30%% ».");
        }
    }
    if(EventTime)
    {
        if(EventTime == 1)
        {
            if(RaceStarted == true)
            {
                if(EventPlayersCount(0) < MIN_RACE_PLAYERS)
                {
                    RaceStarted = false;
                    ClearEventPlayers(0);
                    SendMesAll(0xFFD700FF, "Внимание! "W"Гонки отменены из-за недостаточного количества человек.");
                }
                else EventStart(0);
            }
            else if(DerbyStarted == true)
            {
                if(EventPlayersCount(1) < MIN_DERBY_PLAYERS)
                {
                    DerbyStarted = false;
                    ClearEventPlayers(1);
                    SendMesAll(0xFFD700FF, "Внимание! "W"Дерби отменено из-за недостаточного количества человек.");
                }
                else EventStart(1);
            }
            else if(PaintBallStarted == true)
            {
                if(EventPlayersCount(2) < MIN_PAINTBALL_PLAYERS)
                {
                    PaintBallStarted = false;
                    ClearEventPlayers(2);
                    SendMesAll(0xFFD700FF, "Внимание! "W"Пейнтбол отменен из-за недостаточного количества человек.");
                }
                else EventStart(2);
            }
            else if(CossackRobbersStart == true)
            {
                if(CheckPlayersCountCossackRobbers(CHECK_COSSACK_ROBBERS_MIN) == -1)
                {
                    CossackRobbersStart = false;
                    ClearPlayerCossackRobbers();
                    SendMesAll(0xFFD700FF, "Внимание! "W"Казаки-разбойники отменены из-за недостаточного количества человек.");
                }
                else StartCossackRobbers();
            }
        }
        else if(EventTime == 120)
        {
            if(RaceStarted == true)
            {
                SendMesAll(0xFFD700FF, "Внимание! "W"Регистрация на гонки завершится через 2 минуты! ( /gps > [12] Развлечения > [1] Центр развлечений )");
                SendMesAll(0xFFD700FF, "Внимание! "W"Чтобы попасть на гонки, можно воспользоваться командой /go - телепорт.");
                TeleportInMP = true;
            }
            if(DerbyStarted == true)
            {
                SendMesAll(0xFFD700FF, "Внимание! "W"Регистрация на дерби завершится через 2 минуты! ( /gps > [12] Развлечения > [1] Центр развлечений )");
                SendMesAll(0xFFD700FF, "Внимание! "W"Чтобы попасть на дерби, можно воспользоваться командой /go - телепорт.");
                TeleportInMP = true;
            }
            if(PaintBallStarted == true)
            {
                SendMesAll(0xFFD700FF, "Внимание! "W"Регистрация на пейнтбол завершится через 2 минуты! ( /gps > [12] Развлечения > [1] Центр развлечений )");
                SendMesAll(0xFFD700FF, "Внимание! "W"Чтобы попасть на пейнтбол, можно воспользоваться командой /go - телепорт.");
                TeleportInMP = true;
            }
            if(CossackRobbersStart == true)
            {
                SendMesAll(0xFFD700FF, "Внимание! "W"Регистрация на Казаки-разбойники завершится через 2 минуты! ( /gps > [12] Развлечения > [1] Центр развлечений )");
                SendMesAll(0xFFD700FF, "Внимание! "W"Чтобы попасть на Казаки-разбойники, можно воспользоваться командой /go - телепорт.");
                TeleportInMP = true;
            }
        }
        else if(EventTime == 180)
        {
            if(RaceStarted == true) SendMesAll(0xFFD700FF, "Внимание! "W"Регистрация на гонки завершится через 3 минуты! ( /gps > [12] Развлечения > [1] Центр развлечений )");
            if(DerbyStarted == true) SendMesAll(0xFFD700FF, "Внимание! "W"Регистрация на дерби завершится через 3 минуты! ( /gps > [12] Развлечения > [1] Центр развлечений )");
            if(PaintBallStarted == true) SendMesAll(0xFFD700FF, "Внимание! "W"Регистрация на пейнтбол завершится через 3 минуты! ( /gps > [12] Развлечения > [1] Центр развлечений )");
            if(CossackRobbersStart == true) SendMesAll(0xFFD700FF, "Внимание! "W"Регистрация на Казаки-разбойники завершится через 3 минуты! ( /gps > [12] Развлечения > [1] Центр развлечений )");
        }
        EventTime--;
    }
    new number = 0;
    if(DerbyPasses == true)
    {
        for(new i; i < MAX_DERBY_PLAYERS; i++) if(DerbyPlayers[i] != INVALID_PLAYER_ID) number++;
        if(number == 1)
        {
            for(new i; i < MAX_DERBY_PLAYERS; i++)
            {
                if(DerbyPlayers[i] != INVALID_PLAYER_ID)
                {
                    new super_prize_idx;
                    if(random(10) == 0)
                    {
                        new accessories_prize[4] = {447, 448, 449, 450}, idx = random(sizeof(accessories_prize));
                        if(GivePlayerInventory(DerbyPlayers[i], accessories_prize[idx], .reason = "победа в дерби"))
                        {
                            SendAccess(DerbyPlayers[i], "Вы выиграли суперприз \"%s\".", ItemsInfo[accessories_prize[idx]][iName]);
                            super_prize_idx = accessories_prize[idx];
                        }
                    }
                    OnServerInfoForMoney[15] += DERBY_PRIZ;
                    SetPlayerMoney(DerbyPlayers[i], DERBY_PRIZ, 1, "победа в дерби");
                    if(super_prize_idx != 0) SendMesAll(0xFFD700FF, "Внимание! "W"На дерби победил(-а) %s. Приз: %d$ и %s.", p_info[DerbyPlayers[i]][name], DERBY_PRIZ, ItemsInfo[super_prize_idx][iName]);
                    else SendMesAll(0xFFD700FF, "Внимание! "W"На дерби победил(-а) %s. Приз: %d$.", p_info[DerbyPlayers[i]][name], DERBY_PRIZ);
                    SetPlayerVirtualWorld(DerbyPlayers[i], 0);
                    SetPlayerInterior(DerbyPlayers[i], 0);
                    SetPlayerPos(DerbyPlayers[i], 1421.7180,-1623.7816,13.5469);
                    SetPlayerFacingAngle(DerbyPlayers[i], 270.0074);
                    RegisterDerby[DerbyPlayers[i]] = 0;
                    DerbyPlayers[i] = INVALID_PLAYER_ID;
                    if(DerbyVehicles[i] != INVALID_VEHICLE_ID) DestroyVehicleVEx(DerbyVehicles[i]);
                    DerbyVehicles[i] = INVALID_VEHICLE_ID;
                    DerbyPasses = false;
                }
            }
        }
        else number = 0;
    }
    if(PaintBallPasses == true)
    {
        for(new i = 0; i < MAX_PAINTBALL_PLAYERS; i++) if(PaintBallPlayers[i] != INVALID_PLAYER_ID) number++;
        if(number == 1)
        {
            for(new i = 0; i < MAX_PAINTBALL_PLAYERS; i++)
            {
                if(PaintBallPlayers[i] != INVALID_PLAYER_ID)
                {
                    if(PaintBallLeaderID != PaintBallPlayers[i]) PaintBallLeaderKills = PaintBallKills[PaintBallPlayers[i]];
                    new super_prize_idx;
                    if(random(10) == 0)
                    {
                        new accessories_prize[2] = {458, 459}, idx = random(sizeof(accessories_prize));
                        if(GivePlayerInventory(PaintBallPlayers[i], accessories_prize[idx], .reason = "победа на пейнтболе"))
                        {
                            SendAccess(PaintBallPlayers[i], "Вы выиграли суперприз \"%s\".", ItemsInfo[accessories_prize[idx]][iName]);
                            super_prize_idx = accessories_prize[idx];
                        }
                    }
                    OnServerInfoForMoney[15] += PAINTBALL_PRIZ;
                    SetPlayerMoney(PaintBallPlayers[i], PAINTBALL_PRIZ, true, "победа на пейнтболе");
                    if(super_prize_idx != 0) SendMesAll(0xFFD700FF, "Внимание! "W"На пейнтболе победил(-а) %s с %d убийст(-ом/-ами). Приз: %d$ и %s.", get_name(PaintBallPlayers[i]), PaintBallLeaderKills, PAINTBALL_PRIZ, ItemsInfo[super_prize_idx][iName]);
                    else SendMesAll(0xFFD700FF, "Внимание! "W"На пейнтболе победил(-а) %s с %d убийст(-ом/-ами). Приз: %d$.", get_name(PaintBallPlayers[i]), PaintBallLeaderKills, PAINTBALL_PRIZ);
                    SetPlayerHealth(PaintBallPlayers[i], 100.0);
                    SetPlayerInterior(PaintBallPlayers[i], 0);
                    SetPlayerVirtualWorld(PaintBallPlayers[i], 0);
                    SetPlayerPos(PaintBallPlayers[i], 1421.7180,-1623.7816,13.5469);
                    SetPlayerFacingAngle(PaintBallPlayers[i], 270.0074);
                    SetCameraBehindPlayer(PaintBallPlayers[i]);
                    RegisterPaintBall[PaintBallPlayers[i]] = 0;
                    ResetPlayerWeapons(PaintBallPlayers[i]);

                    if((p_info[PaintBallPlayers[i]][member] != 0 && p_info[PaintBallPlayers[i]][fwork] == true)) SetPlayerColor(PaintBallPlayers[i], fraction_color[p_info[PaintBallPlayers[i]][member]]);
                    else SetPlayerColor(PaintBallPlayers[i],  fraction_color[0]);
                    if(p_info[PaintBallPlayers[i]][admin] > 0) SetPlayerColor(PaintBallPlayers[i], 0xFFFFFF00);
                    HideTextDrawForPlayer(PaintBallPlayers[i], TD_ID_CAPTURE);
                    PaintBallPlayers[i] = INVALID_PLAYER_ID;
                }
            }
            PaintBallLeaderKills = 0, PaintBallLeaderID = INVALID_PLAYER_ID;
            PaintBallPasses = false;
            PaintBallTimerSec = 0;
        }
        else number = 0;
    }
    if(PaintBallTimerSec > 0/* && EventTimerSec <= 0*/)
    {
        for(new i = 0; i < MAX_PAINTBALL_PLAYERS; i++)
        {
            if(PaintBallPlayers[i] != INVALID_PLAYER_ID)
                CaptureInfoUpdate(PaintBallPlayers[i], CAPTURE_ID_PAINTBALL, false);
        }
        PaintBallTimerSec --;
        if(PaintBallTimerSec <= 0) EndPaintBall();
    }
    if(CossackRobbersTime > 0/* && EventTimerSec <= 0*/)
    {
        for(new i = 0, x = 0, scdplayerid = INVALID_PLAYER_ID; i < MAX_COSSACK_ROBBERS_TEAM; i++)
        {
            for(x = 0; x < MAX_COSSACK_ROBBERS_PLAYERS; x++)
            {
                scdplayerid = CossackRobbersPlayers[i][x];
                if(scdplayerid != INVALID_PLAYER_ID)
                {
                    CaptureInfoUpdate(scdplayerid, CAPTURE_ID_COSSACK_ROBBERS, -1, false);
                }
            }
        }
        CossackRobbersTime --;
        if(CossackRobbersTime <= 0) EndCossackRobbers();
    }
    if(AdvertSendingInfo[0] > 0) AdvertSendingInfo[0]--;
    if(AdvertSendingInfo[0] == 0)
    {
        new success_advert_sending = 0;
        for(new idx; idx < MAX_NEWS_ADS; idx++)
        {
            if(AdvertInfo[idx][aAlreadyEdited] == 0) continue;
            if(AdvertInfo[idx][aQueue] == AdvertSendingInfo[1])
            {
                if(AdvertInfo[idx][aAlreadyEdited] == 0) format(AdvertInfo[idx][aEdited], MAX_PLAYER_NAME, "None");
                STRING_MIN[0] = EOS;
                format(STRING_MIN, sizeof(STRING_MIN), "%s: %s (т. %d)", AdvertInfo[idx][aVIP] == false ? "Объявление" : "VIP объявление", AdvertInfo[idx][aText], AdvertInfo[idx][aPhone]);
                SendNewsMessageForServer(AdvertInfo[idx][aVIP] == false ? COLOR_NEWSAD : COLOR_YELLOW, STRING_MIN);
                STRING_MIN[0] = EOS;
                format(STRING_MIN, sizeof(STRING_MIN), "     Прислал(-а): %s. Отправил(-а) сотрудни(-к/-ца) прессы: %s.", AdvertInfo[idx][aSender], AdvertInfo[idx][aEdited]);
                SendNewsMessageForServer(AdvertInfo[idx][aVIP] == false ? COLOR_NEWSADTWO : COLOR_YELLOW, STRING_MIN);
                ClearAdvert(idx);
                AdvertSendingInfo[0] = 15;
                AdvertSendingInfo[1]++;
                if(AdvertSendingInfo[1] >= MAX_NEWS_ADS) AdvertSendingInfo[1] = 0;
                success_advert_sending = 1;
                break;
            }
        }
        if(success_advert_sending == 0)
        {
            AdvertSendingInfo[1]++;
            if(AdvertSendingInfo[1] >= MAX_NEWS_ADS) AdvertSendingInfo[1] = 0;
        }
    }

    if(PickDate <= timestamp && Pick == true) ResetPick(), SendMesAll(0xFFD700FF, "Внимание! "W"В штате закончились выборы. Посмотреть результаты: /picklist");

    new stringF[144], player_state, temp_rob_bank_idx, temp_rob_bank_type, temp_rob_bank_money, temp_rob_bank_gold, temp_rob_fuel_idx, temp_rob_fuel_type, temp_rob_fuel_max, temp_rob_fuel_biz_idx, temp_rob_fuel_liters; // Float:temp_pos_x[3];

    if(timestamp_minute == 00 && timestamp_second == 00) mysql_tquery(con_bd, "START TRANSACTION;");
    foreach(new i: Player)
    {
        if(p_temp[i][LoggedTime] != -1 && p_temp[i][LoggedTime] < timestamp && p_info[i][loggedIn] == 0)
        { //вначале должно быть!
            SendInfo(i, "Время на авторизацию ограничено.");
            Kick(i);
            continue;
        }
        /*if(p_info[i][loggedIn] == 0)
        {
            if(GetPlayerSkin(i) == 0){
                GetPlayerPos(i,temp_pos_x[0], temp_pos_x[1], temp_pos_x[2]);
                if(p_temp[i][pos_X] != temp_pos_x[0]) Kick(i);
            }
            continue;
        }*/
        if(!p_info[i][loggedIn]) continue;
        if(p_temp[i][time_save_player] < 300) p_temp[i][time_save_player]++;
        if(p_temp[i][time_save_player] >= 300)
        {
            p_temp[i][time_save_player] = 0;
            save_player(i);
        }
        // Ваш код ниже
        /*if(p_temp[i][EventPickupID] != -1)
        {
            if(!IsPlayerInRangeOfPoint(i, 2.5, p_temp[i][PickupPosX], p_temp[i][PickupPosY], p_temp[i][PickupPosZ]))
                p_temp[i][EventPickupID] = -1;
        }*/
        if(p_temp[i][ClearAnimFix] == 1)
        {
            if(p_temp[i][ClearAnimTimerFix] <= timestamp)
            {
                p_temp[i][ClearAnimFix] = 0;
                if(!IsPlayerInAnyVehicle(i)) ClearAnimText(i);
            }
        }
        if(p_temp[i][repair_timer] > 0)
        {
            p_temp[i][repair_timer]--;
            if(p_temp[i][repair_timer] == 0)
            {
                new vehicleid = GetPVarInt(i, #VEHICLE_ID_REPAIR);
                DeletePVar(i, #VEHICLE_ID_REPAIR);
                if(GetVehicleModelEx(vehicleid) == 3610) SetVehicleHealth(vehicleid, 3000.0);
                else SetVehicleHealth(vehicleid, 1000.0);
                RepairVehicle(vehicleid);
                GameTextForPlayer(i, "~b~+ repair vehicle", 1000, 1);
                SendAccess(i, "Вы отремонтировали транспортное средство.");

                MeAction(i, "достал(-а) инструменты, затем починил(-а) ими т/с");
            }
            else
            {
                f(STRING_GLOBAL, "~r~repair vehicle %d seconds", p_temp[i][repair_timer]);
                GameTextForPlayer(i, STRING_GLOBAL, 1000, 1);
            }
        }
        if(p_info[i][cash] != GetPlayerMoney(i))
        {
            ResetPlayerMoney(i);
            GivePlayerMoney(i, p_info[i][cash]);
        }
        if(p_info[i][bank] > 1_900_000_000)
        {
            p_info[i][bank] = 1_900_000_000;
            SendError(i, "У Вас слишком много денег в банке.");
            save_player(i);
        }
        if(p_info[i][cash] > 1_900_000_000)
        {
            p_info[i][cash] = 1_900_000_000;
            SendError(i, "У Вас слишком много денег на руках.");
            save_player(i);
        }

        if(p_temp[i][antibot_check] == true)
        {
            p_temp[i][antibot_time]--;
            if(p_temp[i][antibot_time] == 12)
            {
                ShowPlayerDialog(i, D_ANTI_BOT, DIALOG_STYLE_INPUT, ""I"Проверка на активность", ""W"Какая цифра изображена на экране?", "Далее", "Отмена");
            }
            if(p_temp[i][antibot_time] == 0)
            {
                ClearBot(i, "Время на ответ вышло.");
            }
        }

        if(p_info[i][job_block])
        {
            p_info[i][job_block]--;
            if(p_info[i][job_block] == 0) SendMes(i, COLOR_GREEN, "Вы снова можете работать на всех работах.");
        }

        if(p_temp[i][market_arend] != -1)
        {
            new idx = p_temp[i][market_arend];
            if(!IsPlayerInRangeOfPoint(i, 8.0, MarketInfo[idx][mPos][0], MarketInfo[idx][mPos][1], MarketInfo[idx][mPos][2]))
            {
                SendInfo(i, "Вы отошли слишком далеко от палатки, аренда расторгнута.");
                OnPlayerLeaveFromMarket(i);
            }
        }

        if(p_temp[i][hints_timer])
        {
            p_temp[i][hints_timer]--;
            if(p_temp[i][hints_timer] == 0)
            {
                SendHints(i);
                p_temp[i][hints_timer] = 600;
            }
        }

        if(p_temp[i][robbing_mini_game_sub_type] != 0)
        {
            p_temp[i][robbing_mini_game_timer]--;
            if(p_temp[i][robbing_mini_game_timer] == 0)
            {
                SuccessRobbingMiniGame(i);
            }
            p_temp[i][robbing_mini_game_check]--;
            if(p_temp[i][robbing_mini_game_check] == 0)
            {
                p_temp[i][robbing_mini_game_error]++;
                p_temp[i][robbing_mini_game_check] = 5;
                SendError(i, "Вы не успели нажать на клавишу. Ошибок: %d из %d.", p_temp[i][robbing_mini_game_error], MAX_ROBBING_MINI_GAME_ERROR);
                if(p_temp[i][robbing_mini_game_error] == MAX_ROBBING_MINI_GAME_ERROR)
                {
                    SendError(i, "Вы не успели нажать на нужные клавиши.");
                    FailedRobbingMiniGame(i);
                }
            }
        }

        if(p_temp[i][electric_mini_game_type] != ELECTRIC_TYPE_NONE)
        {
            if(ElectricIDx[i] == -1) HideTextDrawForPlayer(i, TD_ID_ELECTRIC);
            else
            {
                if(PowerLinesInfo[ElectricIDx[i]][plRepair] >= MAX_POWER_LINES_STAGE) HideTextDrawForPlayer(i, TD_ID_ELECTRIC);

                p_temp[i][electric_mini_game_timer]--;
                if(p_temp[i][electric_mini_game_timer] == 0)
                {
                    SuccessElectricMiniGame(i);
                }
                p_temp[i][electric_mini_game_check]--;
                if(p_temp[i][electric_mini_game_check] == 0)
                {
                    p_temp[i][electric_mini_game_error]++;
                    p_temp[i][electric_mini_game_check] = 5;
                    SendError(i, "Вы не успели нажать на провод. Ошибок: %d из %d.", p_temp[i][electric_mini_game_error], MAX_ELECTRIC_MINI_GAME_ERROR);
                    if(p_temp[i][electric_mini_game_error] == MAX_ELECTRIC_MINI_GAME_ERROR)
                    {
                        SendError(i, "Вы не успели нажать на нужные провода.");
                        FailedElectricMiniGame(i);
                    }
                }
            }
        }

        if(p_temp[i][dm_zone_timer])
        {
            p_temp[i][dm_zone_timer]--;
            if(p_temp[i][dm_zone_timer] == 0)
            {
                SendMes(i, COLOR_DARKORANGE, "Вы разморожены.");
                p_temp[i][dm_zone_timer] = 0;
                Fix_TogglePlayerControllable(i, true);
            }
        }

        if(p_temp[i][res_extraction_timer])
        {
            p_temp[i][res_extraction_timer]--;
            if(p_temp[i][res_extraction_timer] == 0)
            {
                new res_idx = p_temp[i][res_use_idx],
                    type = p_temp[i][res_use_type],
                    items_idx;
                if(res_idx != -1 && type != -1)
                {
                    ApplyAnimation(i, "PED", "IDLE_chat", 4.1, 0, 1, 1, 0, 1);
                    switch(type)
                    {
                        case RESOURCES_TYPE_MINE:
                        {
                            if(MineResourcesInfo[res_idx][mStatus] == 1 && IsPlayerInDynamicArea(i, MineResourcesInfo[res_idx][mArea]))
                            {
                                items_idx = MineResourcesInfo[res_idx][mItemsIDx];
                                new max_value = GetPlayerCount(i);
                                if(GetPlayerSkin(i) == 0 || GetPlayerSkin(i) == 74) max_value = max_value * 2;
                                if(GetInventoryFreeItems(i, items_idx) < max_value) 
                                    SendMes(i, COLOR_DARKORANGE, "В инвентаре нет свободного места.");
                                else
                                {
                                    SendMes(i, COLOR_LIME, "Вы добыли {"#cLYELLOW"}\"%s\"{"#cLIME"} в количестве: {"#cLYELLOW"}%d.", ItemsInfo[items_idx][iName], max_value);
                                    GivePlayerInventory(i, items_idx, max_value);
                                    DestroyResources(type, res_idx);
                                    CheckPlayerBot(i, 5);

                                    p_temp[i][res_use_idx] = 
                                    p_temp[i][res_use_type] = -1;
                                }
                            }
                        }
                        case RESOURCES_TYPE_FARM:
                        {
                            if(FarmResourcesInfo[res_idx][fStatus] == 1 && IsPlayerInDynamicArea(i, FarmResourcesInfo[res_idx][fArea]))
                            {
                                items_idx = FarmResourcesInfo[res_idx][fItemsIDx];
                                new max_value = GetPlayerCount(i);
                                if(GetPlayerSkin(i) == 0 || GetPlayerSkin(i) == 74) max_value = max_value * 2;
                                if(FarmResourcesInfo[res_idx][fCount] > 0)
                                {
                                    if(GetInventoryFreeItems(i, items_idx) < max_value) SendMes(i, COLOR_DARKORANGE, "В инвентаре нет свободного места.");
                                    else
                                    {
                                        SendMes(i, COLOR_LIME, "Вы добыли {"#cLYELLOW"}\"%s\"{"#cLIME"} в количестве: {"#cLYELLOW"}%d.", ItemsInfo[items_idx][iName], max_value);
                                        GivePlayerInventory(i, items_idx, max_value);
                                        CheckPlayerBot(i, 5);
                                        FarmResourcesInfo[res_idx][fCount]--;
                                        if(FarmResourcesInfo[res_idx][fCount] == 0) 
                                        {
                                            DestroyResources(type, res_idx);
                                            p_temp[i][res_use_idx] = 
                                            p_temp[i][res_use_type] = -1;
                                        }
                                        else
                                        {
                                            STRING_GLOBAL[0] = EOS;
                                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s ("W"%d"I" из "W"%d"I")\nДля сбора урожая\nНажмите "W"\"ALT\"", ItemsInfo[items_idx][iName], FarmResourcesInfo[res_idx][fCount], MAX_FARM_RESOURCES_COUNT);
                                            UpdateDynamic3DTextLabelText(FarmResourcesInfo[res_idx][fText], COLOR_MAIN, STRING_GLOBAL);
                                        }
                                    }
                                }
                            }
                        }
                        case RESOURCES_TYPE_H_COTTON:
                        {
                            if(ResourcesHouseInfo[res_idx][rhTime] == 6 && IsPlayerInDynamicArea(i, ResourcesHouseInfo[res_idx][rhArea]))
                            {
                                items_idx = 647;
                                new max_value = GetPlayerCount(i) * 10;
                                if(GetPlayerSkin(i) == 0 || GetPlayerSkin(i) == 74) max_value = max_value * 2;
                                if(GetInventoryFreeItems(i, items_idx) < max_value) SendMes(i, COLOR_DARKORANGE, "В инвентаре нет свободного места.");
                                else
                                {
                                    SendMes(i, COLOR_LIME, "Вы добыли {"#cLYELLOW"}\"%s\"{"#cLIME"} в количестве: {"#cLYELLOW"}%d.", ItemsInfo[items_idx][iName], max_value);
                                    GivePlayerInventory(i, items_idx, max_value);
                                    CheckPlayerBot(i, 5);
                                    ResourcesHouseInfo[res_idx][rhTime] = 0;
                                    STRING_GLOBAL[0] = EOS;
                                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `resources_house` SET `time` = %d WHERE `id` = %d",
                                    ResourcesHouseInfo[res_idx][rhTime], ResourcesHouseInfo[res_idx][rhIDx]);
                                    mysql_tquery(con_bd, STRING_GLOBAL);
                                    STRING_GLOBAL[0] = EOS;
                                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Хлопок [%d]\n\nДом: "W"%d"I"\nОсталось %d дней\nМожно собрать через "W"6"I" час(-а/-ов)", ResourcesHouseInfo[res_idx][rhIDx], ResourcesHouseInfo[res_idx][rhHouseIDx], ResourcesHouseInfo[res_idx][rhDay]);
                                    UpdateDynamic3DTextLabelText(ResourcesHouseInfo[res_idx][rhText], COLOR_MAIN, STRING_GLOBAL);
                                }
                            }
                        }
                        case RESOURCES_TYPE_H_LINEN:
                        {
                            if(ResourcesHouseInfo[res_idx][rhTime] == 6 && IsPlayerInDynamicArea(i, ResourcesHouseInfo[res_idx][rhArea]))
                            {
                                items_idx = 648;
                                new max_value = GetPlayerCount(i) * 10;
                                if(GetPlayerSkin(i) == 0 || GetPlayerSkin(i) == 74) max_value = max_value * 2;
                                if(GetInventoryFreeItems(i, items_idx) < max_value) SendMes(i, COLOR_DARKORANGE, "В инвентаре нет свободного места.");
                                else
                                {
                                    SendMes(i, COLOR_LIME, "Вы добыли {"#cLYELLOW"}\"%s\"{"#cLIME"} в количестве: {"#cLYELLOW"}%d.", ItemsInfo[items_idx][iName], max_value);
                                    GivePlayerInventory(i, items_idx, max_value);
                                    CheckPlayerBot(i, 5);
                                    ResourcesHouseInfo[res_idx][rhTime] = 0;
                                    STRING_GLOBAL[0] = EOS;
                                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `resources_house` SET `time` = %d WHERE `id` = %d",
                                    ResourcesHouseInfo[res_idx][rhTime], ResourcesHouseInfo[res_idx][rhIDx]);
                                    mysql_tquery(con_bd, STRING_GLOBAL);
                                    STRING_GLOBAL[0] = EOS;
                                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Лен [%d]\n\nДом: "W"%d"I"\nОсталось %d дней\nМожно собрать через "W"6"I" час(-а/-ов)", ResourcesHouseInfo[res_idx][rhIDx], ResourcesHouseInfo[res_idx][rhHouseIDx], ResourcesHouseInfo[res_idx][rhDay]);
                                    UpdateDynamic3DTextLabelText(ResourcesHouseInfo[res_idx][rhText], COLOR_MAIN, STRING_GLOBAL);
                                }
                            }
                        }
                    }
                }
            }
        }

        if(p_temp[i][farm_extraction_timer])
        {
            p_temp[i][farm_extraction_timer]--;
            if(p_temp[i][farm_extraction_timer] == 0)
            {
                new farm_idx = p_temp[i][farm_use_idx],
                    type = p_temp[i][farm_use_type];
                if(farm_idx != -1 && type != -1)
                {
                    switch(type)
                    {
                        case TYPE_FARM_TREE:
                        {
                            if(IsPlayerInDynamicArea(i, FarmTreeInfo[farm_idx][ftArea]))
                            {
                                ApplyAnimation(i, "PED", "IDLE_chat", 4.1, 0, 1, 1, 0, 1);
                                CheckPlayerFarm(i, TYPE_FARM_TREE, farm_idx);
                            }
                            else ApplyAnimation(i, "PED", "IDLE_chat", 4.1, 0, 1, 1, 0, 1);
                        }
                        case TYPE_FARM_MILKER:
                        {
                            if(IsPlayerInDynamicArea(i, FarmMilkerInfo[farm_idx][fmArea]))
                            {
                                ApplyAnimation(i, "PED", "IDLE_chat", 4.1, 0, 1, 1, 0, 1);
                                CheckPlayerFarm(i, TYPE_FARM_MILKER, farm_idx);
                            }
                            else ApplyAnimation(i, "PED", "IDLE_chat", 4.1, 0, 1, 1, 0, 1);
                        }
                    }
                }
            }
        }

        if(p_temp[i][roadman_extraction_timer])
        {
            p_temp[i][roadman_extraction_timer]--;
            if(p_temp[i][roadman_extraction_timer] == 0)
            {
                new aidx = p_temp[i][roadman_use_idx];
                if(aidx != -1 && RoadCrashAreasIDx[aidx] != -1 && p_temp[i][roadman_hash_idx] == RoadCrashHash)
                {
                    if(IsPlayerInDynamicArea(i, RoadCrashAreasIDx[aidx]))
                    {
                        p_temp[i][roadman_check] = 1;

                        ApplyAnimation(i, "PED", "IDLE_chat", 4.1, 0, 1, 1, 0, 1);

                        if(IsPlayerAttachedObjectSlotUsed(i, 1)) RemovePlayerAttachedObject(i, 1);
                        SetPlayerAttachedObject(i, 1, 2060, 1, 0.11, 0.36, 0.0, 0.0, 90.0);
                        ClearAnimations(i);
                        ApplyAnimation(i, "CARRY", "crry_prtial", 4.1, 1, 0, 0, 1, 1);
                        //SetPlayerSpecialAction(i, SPECIAL_ACTION_CARRY);

                        SendMes(i, COLOR_BLUE, "Вы взяли мешок с мусором, отнесите его в транспортное средство.");

                        DestroyDynamicArea(RoadCrashAreasIDx[aidx]);
                        RoadCrashAreasIDx[aidx] = -1;

                        if(RoadCrashObjectIDx[aidx] != INVALID_OBJECT_ID)
                        {
                            DestroyDynamicObject(RoadCrashObjectIDx[aidx]);
                            RoadCrashObjectIDx[aidx] = -1;
                        }

                        if(CheckRoadCrash() == -1) DestroyRoadCrash();
                    }
                } else ApplyAnimation(i, "PED", "IDLE_chat", 4.1, 0, 1, 1, 0, 1);
            }
        }

        if(p_temp[i][craft_timer] > 0)
        {
            p_temp[i][craft_timer]--;
            if(p_temp[i][craft_timer] == 0) CheckPlayerCraft(i);
        }

        if(p_temp[i][TextDrawDonateInfo] == true) UpdateDonateInfo(i);

        if(p_temp[i][Work_ID] == GREEN_HOUSES_WORK && p_temp[i][GreenHousesTimer] > 0)
        {
            p_temp[i][GreenHousesTimer]--;
            if(p_temp[i][GreenHousesTimer] == 0)
            {
                Fix_TogglePlayerControllable(i, true);
                if(IsPlayerAttachedObjectSlotUsed(i, 0)) RemovePlayerAttachedObject(i, 0);
                SetPlayerAttachedObject(i, 0, 19639, 5, 0.190000, 0.048999, 0.105998, -80.400001, -7.499999, 15.300001, 1.000000, 1.000000, 1.000000, 0, 0);
                if(IsPlayerAttachedObjectSlotUsed(i, 1)) RemovePlayerAttachedObject(i, 1);
                SetPlayerAttachedObject(i, 1, 802, 5, 0.165000, 0.162999, 0.098998, -80.000007, -5.599997, 14.500003, 0.347999, 0.400000, 0.189999, 0, 0);
                //SetPlayerSpecialAction(i, SPECIAL_ACTION_CARRY);
                ClearAnimations(i);
                ApplyAnimation(i, "CARRY", "crry_prtial", 4.1, 1, 0, 0, 1, 1);
                p_temp[i][GreenHousesCheck] = 1;
                SendMes(i, COLOR_SEA_WAVE, "Вы собрали цветы, отнесите их на склад.");
                SetPlayerGPS(i, 999.1111,-2156.2717,13.0938, 2.5);
                new idx = p_temp[i][GreenHousesIDx];
                p_temp[i][GreenHousesIDx] = -1;
                FlowersGreenHousesInfo[idx][fPlayerID] = INVALID_PLAYER_ID;
                CheckFlowers(idx);
            }
        }

        CheckPlayerHunting(i);

        if(p_temp[i][OldPickupID] != -1 || p_temp[i][EventPickupID] != -1)
        {
            if(!IsPlayerInRangeOfPoint(i, 1.5, p_temp[i][PickupPosX], p_temp[i][PickupPosY], p_temp[i][PickupPosZ]))
            {
                p_temp[i][OldPickupID] =
                p_temp[i][EventPickupID] = -1;
                p_temp[i][TickPickup] = 0;
                HideTextDrawForPlayer(i, TD_ID_PRESS_ALT);
            }
        }

        if(p_temp[i][billboard_status] == true)
        {
            p_temp[i][billboard_timer]--;
            if(p_temp[i][billboard_timer] == 0)
            {
                p_temp[i][billboard_status] = false;
                new biz_id = GetPVarInt(i, "bID"), idx = GetPVarInt(i, "BILLBOARD:idx");
                ShowDialogBillboard(i, biz_id, BB_LIST_SETTINGS, idx);
            }
        }

        if(FishStart[i] == true)
        {
            if(!IsPlayerInAnyVehicle(i) && fPlayer_Areaid[i] != -1)
            {
                new index = fPlayer_Areaid[i];

                if(IsPlayerInDynamicArea(i, fFishing_Sphere[index]))
                {
                    if(FishPress[i] == 0)
                    {
                        if(FishTimer[i] > 0)
                        {
                            FishTimer[i]--;
                            if(random(500) == 250) StopFish(i, TYPE_FISH_DESTROY_HOOK);
                        }
                        else
                        {
                            ShowFish(i);
                        }
                    }
                    else
                    {
                        if(FishTimer[i] > 0) FishTimer[i]--;
                        else StopFish(i, TYPE_FISH_DESTROY_LINE);
                    }
                }
            }
        }

        if(p_temp[i][death_status] == 1)
        {
            if(p_temp[i][death_timer] > 0) p_temp[i][death_timer]--;
            if(p_temp[i][death_timer] == 25 && p_temp[i][death_anim] == 0)
            {
                ClearAnimations(i);
                ApplyAnimation(i, "PED", "FLOOR_hit_f", 4.1, 0, 1, 1, 1, 0);
                p_temp[i][death_anim] = 1;
            }
            if(p_temp[i][death_timer] == 0)
            {
                p_temp[i][death_status] = 0;
                p_temp[i][death_anim] = 0;
                Fix_TogglePlayerControllable(i, 1);
                ClearAnimations(i);
                if(p_info[i][p_add_vip] != 0) p_temp[i][dead_status] = false;
                SpawnPlayer(i);
            }
        }
        if(HookahSmokeTimer[i] > 0)
        {
            HookahSmokeTimer[i]--;
            if(HookahSmokeTimer[i] == 0)
            {
                if(IsPlayerAttachedObjectSlotUsed(i, 1)) RemovePlayerAttachedObject(i, 1);
            }
        }
        if(p_temp[i][army_post] != -1 && p_info[i][p_afkTime] < 2) {
            if(++p_temp[i][army_time] >= 30) {
                p_temp[i][army_time] = 0;
                SetPlayerMoney(i, 25, false, "cтоит на посту");
            }
        }
        if(p_temp[i][chase_followerId] != INVALID_PLAYER_ID && p_info[i][p_afkTime] > 180)
        {
            new followerId = p_temp[i][chase_followerId];
            p_temp[i][chase_followerId] =
            p_temp[followerId][chase_targetId] = INVALID_PLAYER_ID;

            SendInfo(followerId, "Игрок находился AFK более 3 минут.");
            p_info[i][jail_time] += (600 * p_info[i][wanted]) + 300;
            if(p_info[i][jail_time] <= 1200) p_info[i][jail] = random(3) + 1;
            else p_info[i][jail] = 5;
            p_info[i][wanted] = 0;

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] AFK более 3 минут при приследовании (+5 мин. к заключению).", get_name(i), i);
            SendFractionMessage(POLICE_LS, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(POLICE_SF, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(POLICE_LV, 0x33CC66FF, STRING_GLOBAL);
            SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);
        }

        GetPlayerPos(i, AntiCheatPlayerPos[i][0], AntiCheatPlayerPos[i][1], AntiCheatPlayerPos[i][2]);
        /*
        GetPlayerPos(i, p_temp[i][check_active_pos][0], p_temp[i][check_active_pos][1], p_temp[i][check_active_pos][2]);

        if(
            p_temp[i][check_active_pos][3] != p_temp[i][check_active_pos][0] &&
            p_temp[i][check_active_pos][4] != p_temp[i][check_active_pos][1])
        {
            p_info[i][check_active_time]++;
            p_temp[i][check_active_pos][3] = p_temp[i][check_active_pos][0];
            p_temp[i][check_active_pos][4] = p_temp[i][check_active_pos][1];
            p_temp[i][check_active_pos][5] = p_temp[i][check_active_pos][2];
        }
        */

        // Обновляем счетчик для проверки на флуд через гос. новости;
        if(GetPVarInt(i, "GovAntiAttack") > 0) SetPVarInt(i, "GovAntiAttack", GetPVarInt(i, "GovAntiAttack") - 1);
        // Обновляем счетчик для проверки на флуд через MSG чат;
        if(GetPVarInt(i, "MSGAntiAttack") > 0) SetPVarInt(i, "MSGAntiAttack", GetPVarInt(i, "MSGAntiAttack") - 1);
        // Обновляем счетчик для проверки на флуд через OOC чат;
        if(GetPVarInt(i, "OOCAntiAttack") > 0) SetPVarInt(i, "OOCAntiAttack", GetPVarInt(i, "OOCAntiAttack") - 1);
        // Обновляем счетчик для проверки на атаку администратора;
        if(GetPVarInt(i, "AntiAdminAttack") > 0) SetPVarInt(i, "AntiAdminAttack", GetPVarInt(i, "AntiAdminAttack") - 1);

        CheckPlayerVehicleDetails(i);
        if(p_info[i][p_vip] != 0 && p_info[i][p_vip_time] < timestamp)
        {
            SendInfo(i, "Срок использования VIP-аккаунта истек.");
            p_info[i][p_vip] = 0;
            p_info[i][p_vip_time] = 0;

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `p_vip` = %d, `p_vip_time` = %d WHERE `id` = %d",
            p_info[i][p_vip], p_info[i][p_vip_time], p_info[i][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL);
        }
        if(p_info[i][p_add_vip] != 0 && p_info[i][p_add_vip_time] < timestamp)
        {
            SendInfo(i, "Срок использования ADD VIP истек.");
            p_info[i][p_add_vip] = 0;
            p_info[i][p_add_vip_time] = 0;

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `p_add_vip` = %d, `p_add_vip_time` = %d WHERE `id` = %d",
            p_info[i][p_add_vip], p_info[i][p_add_vip_time], p_info[i][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL);
        }
        if(p_info[i][p_flin_music] != 0 && p_info[i][p_flin_music_time] < timestamp)
        {
            SendInfo(i, "Срок использования музыкальной подписки истек.");
            p_info[i][p_flin_music] = 0;
            p_info[i][p_flin_music_time] = 0;

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `p_flin_music` = %d, `p_flin_music_time` = %d WHERE `id` = %d",
            p_info[i][p_flin_music], p_info[i][p_flin_music_time], p_info[i][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL);
        }

        if(DriveTime[i] >= 0)
        {
            DriveTime[i] --;

            /*STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "~g~TEST DRIVE FOR ~r~%d ~g~timestamp_second", DriveTime[i]);
            GameTextForPlayer(i, STRING_GLOBAL, 800, 4);*/

            if(DriveTime[i] == 0)
            {
                SendInfo(i, "Время на тест-драйв ограничено.");
                if(DriveAuto[i] != INVALID_VEHICLE_ID) DestroyVehicleVEx(DriveAuto[i]);
                DriveAuto[i] = INVALID_VEHICLE_ID;
                DriveTime[i] = -1;
                GangZoneHideForPlayer(i, Zone_Drive);
                SetPlayerPos(i, 1306.1017,-50.7633,2002.4988);
                SetPlayerFacingAngle(i, 91.2163);
                SetPlayerInterior(i, 1);
                SetPlayerVirtualWorld(i, 3000);
            }
        }

        if(pSpectateId[i] != INVALID_PLAYER_ID && pSpectatorId[pSpectateId[i]] != INVALID_PLAYER_ID)
            UpdateSpectatingTargetInfo(i);

        if(p_temp[i][tGagTime])
        {
            p_temp[i][tGagTime] --;
            if(p_temp[i][tGagTime] == 1)
            {
                p_temp[i][tGag] = false;
                p_temp[i][tGagTime] = 0;
                SendInfo(i, "Вы потеряли кляп и снова можете разговаривать.");
            }
        }
        /*if(GetPlayerWeapon(i) == 41)
        {
            ResetPlayerWeapons(i);
            for (new i; i < MAX_WEAPONS; i++) GivePlayerWeapon(i, p_info[i][Weapon][i], p_info[i][Ammo][i]);
            SetPlayerArmedWeapon(i, 0);
        }*/
        if(p_temp[i][UnFreezeFix] == 1)
        {
            if(p_temp[i][UnFreezeTimerFix] <= timestamp)
            {
                p_temp[i][UnFreezeFix] = 0;
                Fix_TogglePlayerControllable(i, true);
            }
        }
        if(p_temp[i][bonfire_timer] > 0)
        {
            p_temp[i][bonfire_timer]--;
            if(p_temp[i][bonfire_timer] <= 0) DestroyBonfire(i, 1);
        }
        if(RegisterDerby[i] == 2 && IsPlayerInAnyVehicle(i) && GetPlayerVirtualWorld(i) == 500)
        {
            new vehicleid = GetPlayerVehicleID(i);
            new Float:veh_hp;
            GetVehicleHealth(vehicleid, veh_hp);
            if(veh_hp <= 300)
            {
                if(RegisterDerby[i] == 2)
                {
                    for(new idx; idx < MAX_DERBY_PLAYERS; idx++)
                    {
                        if(DerbyPlayers[idx] == i)
                        {
                            SetPlayerVirtualWorld(DerbyPlayers[idx], 0);
                            SetPlayerInterior(DerbyPlayers[idx], 0);
                            SetPlayerPos(DerbyPlayers[idx], 1421.7180,-1623.7816,13.5469);
                            SetPlayerFacingAngle(DerbyPlayers[idx], 270.0074);
                            RegisterDerby[DerbyPlayers[idx]] = 0;
                            DerbyPlayers[idx] = INVALID_PLAYER_ID;
                            if(DerbyVehicles[idx] != INVALID_VEHICLE_ID) DestroyVehicleVEx(DerbyVehicles[idx]);
                            DerbyVehicles[idx] = INVALID_VEHICLE_ID;
                            SendInfo(i, "Вы были дисквалифицированны с дерби.");
                            break;
                        }
                    }
                }
            }
        }
        if(player_lobby_status[i] == true && player_lobby_idx[i] != -1)
        {
            new idx = player_lobby_idx[i], type = LobbyInfo[idx][LobbyType] - 1, map = LobbyInfo[idx][LobbyMap];
            if(player_lobby_type[i] >= LOBBY_TYPE_RACE && player_lobby_type[i] <= LOBBY_TYPE_STUNT)
            {
                if(GetPlayerState(i) != PLAYER_STATE_DRIVER)
                {
                    for(new x = 0; x < MAX_PLAYERS_LOBBY; x++)
                    {
                        if(LobbyInfo[idx][LobbyPlayers][x] == i)
                        {
                            if(LobbyInfo[idx][LobbyVehicles][x] != INVALID_VEHICLE_ID)
                            {
                                RepairVehicle(LobbyInfo[idx][LobbyVehicles][x]);
                                SetVehiclePos(LobbyInfo[idx][LobbyVehicles][x], LobbyPos[type][map][x][0], LobbyPos[type][map][x][1], LobbyPos[type][map][x][2]);
                                SetVehicleZAngle(LobbyInfo[idx][LobbyVehicles][x], LobbyPos[type][map][x][3]);
                                PutPlayerInVehicle(i, LobbyInfo[idx][LobbyVehicles][x], 0);
                                SetCameraBehindPlayer(i);
                                p_info[i][pHealth] = 100.0;
                                SetPlayerHealth(i, 100.0);
                                break;
                            }
                            else OnPlayerLeaveLobby(i, idx, "Не найдено транспортное средство.");
                        }
                    }
                }
                else
                {
                    new vehicleid = GetPlayerVehicleID(i);
                    new Float:veh_hp;
                    GetVehicleHealth(vehicleid, veh_hp);
                    if(veh_hp <= 300)
                    {
                        OnPlayerLeaveLobby(i, player_lobby_idx[i], "Транспортное средство менее 300 HP.");
                    }
                }
            }
            else if(player_lobby_type[i] == LOBBY_TYPE_PARKOUR)
            {
                new Float:pos[3], sidx = random(20);
                GetPlayerPos(i, pos[0], pos[1], pos[2]);
                if(pos[2] < LobbyPos[type][map][sidx][2] - 2.5)
                {
                    SetPlayerPos(i, LobbyPos[type][map][sidx][0], LobbyPos[type][map][sidx][1], LobbyPos[type][map][sidx][2]);
                    SetPlayerFacingAngle(i, LobbyPos[type][map][sidx][3]);
                    SetCameraBehindPlayer(i);
                    p_info[i][pHealth] = 100.0;
                    SetPlayerHealth(i, 100.0);
                }
            }
        }
        if(p_temp[i][AddictionFix] == 1)
        {
            if(p_temp[i][AddictionTimerFix] <= timestamp)
            {
                p_temp[i][AddictionFix] = 0;
                if(GetPlayerInterior(i) != 0) SetPlayerWeather(i, 1);
                else SetPlayerWeather(i, Default_Weather);
            }
        }
        if(p_temp[i][LoginFix] == 1)
        {
            if(p_temp[i][LoginTimerFix] <= timestamp)
            {
                p_temp[i][LoginFix] = 0;
                p_temp[i][LoginTimerFix] = 0;
                OnLoginTimeout(i);
            }
        }
        if(p_temp[i][UseMaskFix] == 1)
        {
            if(p_temp[i][UseMaskTimerFix] <= timestamp)
            {
                maskOFF(i);
            }
        }
        if(p_info[i][p_afkTick] > 10000)
        {
            p_info[i][p_afkTick] = 1;
            p_info[i][p_afkCheck] = 0;
        }
        if(p_info[i][p_afkCheck] < p_info[i][p_afkTick])
        {
            p_info[i][p_afkCheck] = p_info[i][p_afkTick];
            p_info[i][p_afkTime] = 0;
            p_info[i][check_active_time]++;
        }

        if(p_info[i][p_afkTime] < 2) p_temp[i][DiseaseTime]++;
        if(p_temp[i][DiseaseTime] >= 600 && p_info[i][p_afkTime] < 2)
        {
            new Float:shealth;
            p_temp[i][DiseaseTime] = 0;
            if(p_info[i][Disease][0] && p_info[i][admin] == 0)
            {
                MeAction(i, "покашлял(-а)");
                GetPlayerHealth(i, shealth);
                SetPlayerHealth(i, shealth-p_info[i][Disease][0]*1.000);
            }
            if(p_info[i][Disease][1] && p_info[i][admin] == 0)
            {
                DoAction(i, "Стошнило.");
                GetPlayerHealth(i, shealth);
                SetPlayerHealth(i, shealth-p_info[i][Disease][1]*2.000);
            }
            if(p_info[i][Disease][2] && p_info[i][admin] == 0)
            {
                GetPlayerHealth(i, shealth);
                SetPlayerHealth(i, shealth-p_info[i][Disease][2]*6.000);
            }
            if(p_info[i][Disease][3] && p_info[i][admin] == 0)
            {
                GetPlayerHealth(i, shealth);
                SetPlayerHealth(i, shealth-p_info[i][Disease][3]*8.000);
            }
            if(p_info[i][Disease][4] && p_info[i][admin] == 0)
            {
                GetPlayerHealth(i, shealth);
                SetPlayerHealth(i, shealth-p_info[i][Disease][4]*10.000);
            }
            if(p_info[i][Disease][5] && p_info[i][admin] == 0)
            {
                GetPlayerHealth(i, shealth);
                SetPlayerHealth(i, shealth-p_info[i][Disease][5]*4.000);
            }
        }
        if(p_temp[i][LaboratoryTimer] > 0)
        {
            p_temp[i][LaboratoryTimer]--;
            if(p_temp[i][LaboratoryTimer] == 0)
            {
                new amount = RandomEx(200, 400);
                p_temp[i][LaboratoryCheck] = amount;
                Fix_TogglePlayerControllable(i, true);
                ClearAnimations(i);
                ApplyAnimation(i, "CARRY", "crry_prtial", 4.1, 1, 0, 0, 1, 1);
                //SetPlayerSpecialAction(i, SPECIAL_ACTION_CARRY);
                SetPlayerAttachedObject(i, 1, 1279, 6, 0.0, 0.10, -0.2, -110.0, 0.0, 78.0, 1.000000, 1.000000, 1.000000);
                SendMes(i, COLOR_LYELLOW, "Вы разработали {"#cLIME"}%d{"#cLYELLOW"} ед. медикаментов.", amount);
                SendMes(i, COLOR_SEA_WAVE, "Отнесите медикаменты на склад.");
            }
        }
        if(p_temp[i][radio_timer])
        {
            p_temp[i][radio_timer]--;
            if(p_temp[i][TextDrawRadio] == true) UpdateRadio(i);
            if(p_temp[i][radio_timer] == 0)
            {
                if(p_temp[i][radio_type_idx] != -1 && p_temp[i][radio_idx] != MAX_RADIO_LIST_TRACK && RadioList[p_temp[i][radio_idx] + 1][rType] == p_temp[i][radio_type_track])
                {
                    p_temp[i][radio_type_idx]++; // ID из папки;
                    p_temp[i][radio_idx]++; // ID из массива;
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "http://cdn.pinecrest-rp.com/gm/music/%s/%d.mp3", radio_list_type_name[p_temp[i][radio_type_track]], p_temp[i][radio_type_idx]);
                    p_temp[i][radio_timer] = RadioList[p_temp[i][radio_idx]][rTime];
                    PlayRadio(i, p_temp[i][radio_use_type], STRING_GLOBAL);
                }
                else
                {
                    p_temp[i][radio_type] = TYPE_RADIO_LIST; // ID из массива RadioList;
                    p_temp[i][radio_type_track] = TYPE_RADIO_LIST; // ID из массива RadioList;
                    p_temp[i][radio_idx] = -1; // ID из массива RadioList;
                    p_temp[i][radio_type_idx] = -1; // ID из папки;
                    p_temp[i][radio_timer] = 0; // Время до окончания таймера;
                    if(p_temp[i][TextDrawRadio] == true) UpdateRadio(i);
                }
            }
        }
        if(p_info[i][p_afkCheck] == p_info[i][p_afkTick])
        {
            p_info[i][p_afkTime]++;
            if(p_info[i][p_afkTime] > 2)
            {
                p_info[i][p_afk_today]++;
                format(stringF,sizeof(stringF), "ESC: %s",ConvertTime(p_info[i][p_afkTime]-2, 1));
                SetPlayerChatBubble(i, stringF, COLOR_MAIN, 20.0, 1200);
            }
            if(p_info[i][p_afkTime] > 60 && GetPVarInt(i,"BoneStol_ID"))
            {
                SendInfo(i, "За столом нельзя стоять в AFK более 1 минуты.");
                Kick(i);
            }
        }
        if(p_info[i][p_afkTime] < 2)
        {
            p_info[i][p_time_payday]++;
            p_info[i][p_time_today]++;
            if(p_info[i][level] >= 3)
            {
                p_info[i][daily_time]++;
                if(p_info[i][daily_time] == 10800)
                {
                    SendInfo(i, "Вы можете воспользоваться наградами и забрать их.");
                    SendInfo(i, "Чтобы забрать: /mn > [12] Задания, достижения и награды");
                    p_info[i][daily_days]++;
                    p_info[i][daily_today]++;
                }
                new max_time = GetPlayerRouletteTime(i), max_payday = GetPlayerRoulettePayDay(i);
                p_info[i][free_roulette_time]++;
                if(p_info[i][free_roulette_time] >= max_time)
                {
                    SendInfo(i, "Вы отыграли %d часа и получили \"Bronze\" рулетку.", max_payday);
                    SendInfo(i, "Помните, за каждые %d часа игры выдается случайная рулетка.", max_payday);

                    SetPlayerItem(i, 5, p_info[i][ID], TYPE_GIVE_ITEM_INVENTORY, 1, 642);

                    p_info[i][free_roulette_time] = 0;

                    Log(LOG_player, INFO, "%s[%d](%s %s) получил Bronze рулетку | #FreeRoulette",
                    get_name(i), p_info[i][ID], p_temp[i][session_IP], IsPlayerMobile(i) ? "Mobile": "PC");
                }
            }
            if(p_info[i][battle_lvl] < MAX_BATTLEPASS_REWARD)
            {
                p_info[i][battle_info][3]++;
                if(p_info[i][battle_info][3] >= MAX_BATTLEPASS_EXP_TIME)
                {
                    p_info[i][battle_info][3] = 0;
                    SendMes(i, COLOR_GREEN, "[BATTLE PASS]:"W" За %d часа игры Вам выдано %d Battle Pass EXP.", MAX_BATTLEPASS_EXP_TIME / 3600, MAX_BATTLEPASS_EXP);
                    UpdatePlayerBattlePassLevel(i, MAX_BATTLEPASS_EXP);
                }
            }
            if(p_temp[i][TextDrawBattlePass] == true) UpdatePlayerBattlePass(i, BATTLEPASS_TYPE_UPDATE_STATS);
            if(p_temp[i][TextDrawDaily] == true) UpdatePlayerDaily(i, DAILY_TYPE_UPDATE_TIME);
            if(p_temp[i][TextDrawTHunterGPS] == true) UpdatePlayerTHunter(i);
            #if ACTION_100_HOUR == 1
                if(p_info[i][level] >= 5)
                {
                    if(p_info[i][gift_promocode_status] == 0)
                    {
                        p_info[i][gift_promocode_time]++;
                        if(p_info[i][gift_promocode_time] >= 360000)
                        {
                            p_info[i][gift_promocode_status] = 2;
                            //SetPlayerMoney(i, 1_000_000, true, "праздничная акция 100 часов");

                            SetPlayerItem(i, 14, p_info[i][ID], TYPE_GIVE_ITEM_VIP, 2, 14);
                            SetPlayerItem(i, 14, p_info[i][ID], TYPE_GIVE_ITEM_VEHICLE, 3251);

                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `gift_promocode_status` = %d WHERE `id` = %d",
                                p_info[i][gift_promocode_status], p_info[i][ID]);
                            mysql_tquery(con_bd, STRING_GLOBAL);

                            /*
                            if(p_info[i][p_add_vip] != 1) p_info[i][p_add_vip_time] = 0;
                            p_info[i][p_add_vip] = 1;
                            if(p_info[i][p_add_vip_time]) p_info[i][p_add_vip_time] += 86400 * 14;
                            else p_info[i][p_add_vip_time] = (timestamp + (86400 * 14));
                            */

                            SendAccess(i, "Вы получили Silver VIP на 14 дней и Nissan 370Z (RealCars).");

                            /*
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `gift_promocode_status` = %d, `p_add_vip` = %d, `p_add_vip_time` = %d WHERE `id` = %d",
                            p_info[i][gift_promocode_status], p_info[i][p_add_vip], p_info[i][p_add_vip_time], p_info[i][ID]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                            */
                        }
                    }
                }
            #endif
        }

        p_info[i][p_game_time]++;

        if(p_info[i][admin] > 0 && timestamp_hour >= 6 && timestamp_hour <= 23) {
            if(p_info[i][p_afkTime] > 2) a_info[i][a_afk]++;
            a_info[i][a_day_on]++;
        }
        //if(p_info[i][p_countUseCheat] > 0) p_info[i][p_countUseCheat]--;

        if(p_temp[i][phone_talk] > 0)
        {
            p_temp[i][phone_talk]++;
            format(stringF,sizeof(stringF),"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~Time: ~r~%d sec.",p_temp[i][phone_talk]-1);
            GameTextForPlayer(i, stringF, 1100, 3);
        }

        if(p_temp[i][dice_timer] > 0)
        {
            p_temp[i][dice_timer]--;
            if(p_temp[i][dice_timer] == 0) EndBones(i);
        }

        //GetPlayerHealth(i, p_info[i][pHealth]);
        //if(p_info[i][pHealth] > 160.0) p_info[i][pHealth] = 160.0;
        if(p_info[i][in_hospital] == true && p_info[i][p_afkTime] < 2)
        {
            if(p_info[i][pHealth] < 100.0)
            {
                if(p_temp[i][hospital_bed_id] != -1)
                {
                    p_info[i][pHealth] += 2;
                    if(p_info[i][p_vip]) p_info[i][pHealth] += 2;
                }
                else
                {
                    p_info[i][pHealth] += 1;
                    if(p_info[i][p_vip]) p_info[i][pHealth] += 1;
                }
                SetPlayerHealth(i, p_info[i][pHealth]);
            }
            else
            {
                if(p_temp[i][hospital_bed_id] != -1) ClearHospitalBed(i);
                p_info[i][in_hospital] = false;
            }
        }
        if(timestamp_hour == 5 && timestamp_minute == 00 && timestamp_second == 01)
        {
            GameTextForPlayer(i, "~r~RESTART", 10000, 0);
            SendMes(i, COLOR_LIGHTRED, "----------=============== [ Внимание! Автоматический рестарт сервера через 1 минуту! ] ===============----------");
        }
        if(timestamp_minute == 00 && timestamp_second == 00)
        {
            //SetPlayerVirtualWorldTime(timestamp_hour);
            if(p_temp[i][BeingInSpace] == false) SetPlayerTime(i, timestamp_hour, timestamp_minute);
            PayDay(i);
        }
        if(p_temp[i][p_in_pickup] == PICKUP_EAT)
        {
            if(p_info[i][satiety] < 100.0 || p_info[i][thirst] < 100.0)
            {
                p_info[i][satiety] =
                p_info[i][thirst] = 100.0;
                if(GetPlayerDisease(i, 1, 10, 3) == 1) // Шанс 30 процентов;
                {
                    p_info[i][Disease][1]++;
                    SendInfo(i, "У Вас появилось новое заболевание - диарея %d степени.", p_info[i][Disease][1]);
                }
            }
        }
        if(p_temp[i][p_in_pickup] == PICKUP_HEAL)
        {
            if(p_info[i][pHealth] < 100.0)
            {
                GameTextForPlayer(i, "~b~HEAL: +10", 2000, 6);
                p_info[i][pHealth] += 10.0;
                SetPlayerHealth(i, p_info[i][pHealth]);
            }
        }
        if(TheftCarTime[i] > 0)
        {
            TheftCarTime[i]--;
            if(TheftCarTime[i] == 1)
            {
                if(p_info[i][job_skill_count][6] > 0)
                {
                    p_info[i][job_skill_count][6]--;
                    SavePlayerWorkSkill(i);
                }
                else if(p_info[i][job_skill][6] > 1 && p_info[i][job_skill_count][6] == 0)
                {
                    p_info[i][job_skill][6]--;
                    p_info[i][job_skill_count][6] = 24;
                    SavePlayerWorkSkill(i);
                }
                SendInfo(i, "Время вышло, задание провалено.");
                DestroyTheftCarVehicle(i);
                ClearTheftCar(i, TYPE_THEFT_CAR_VEHICLE);
            }
        }
        if(p_temp[i][ExitCarTimer] == true)
            OnPlayerExitCar(i);
        if(p_temp[i][Work_ID] == TRAIN_WORK && p_temp[i][TrainVehicleIDx] != INVALID_VEHICLE_ID && GetPlayerVehicleID(i) != p_temp[i][rented_veh] && GetPlayerVehicleID(i) != p_temp[i][TrainVehicleIDx])
        {
            SendMes(i, COLOR_DARKORANGE, "Вы вышли из поезда.");
            EndPlayerJob(i);
        }
        if(p_temp[i][Work_ID] == TRAM_WORK && p_temp[i][TramVehicleIDx] != INVALID_VEHICLE_ID && GetPlayerVehicleID(i) != p_temp[i][rented_veh] && GetPlayerVehicleID(i) != p_temp[i][TramVehicleIDx])
        {
            SendMes(i, COLOR_DARKORANGE, "Вы вышли из трамвая.");
            EndPlayerJob(i);
        }
        //TimerKillList(i);
        /////////////////////////////////////////
        player_state = GetPlayerState(i);
        if(player_state == PLAYER_STATE_DRIVER)
        {
            new vehicleid = GetPlayerVehicleID(i), speed = GetVehicleSpeed(vehicleid),
                vehicle_model = GetVehicleModelEx(vehicleid);
            new Float:new_vhealth;
            GetVehicleHealth(vehicleid, new_vhealth);
            if(vehicle_model != 0)
            {
                //if(veh_info[vehicleid][v_engine] == 0 && GetVehicleData(vehicle_model, E_VD_TYPE) == VEHICLE_STATE_VELO_MOPED) SetVehicleSpeed(vehicleid, 0);
                if(GetVehicleData(vehicle_model, E_VD_TYPE) != VEHICLE_STATE_BOAT &&
                    GetVehicleData(vehicle_model, E_VD_TYPE) != VEHICLE_STATE_PLANE)
                {
                    new speed = GetVehicleSpeed(vehicleid);
                    if(speed > p_info[i][p_carlimit] && p_info[i][p_carlimit] != 0)
                    {
                        speed = p_info[i][p_carlimit];
                        SetVehicleSpeed(vehicleid, speed);
                    }
                    OnPlayerUpdateVehicleSpeed(i);
                }
            }
            if(new_vhealth <= 300.0)
            {
                if(RegisterDerby[i] == 2)
                {
                    for(new p = 0; p < MAX_DERBY_PLAYERS; p++)
                    {
                        if(DerbyPlayers[p] == i)
                        {
                            SetPlayerVirtualWorld(DerbyPlayers[p], 0);
                            SetPlayerInterior(DerbyPlayers[p], 0);
                            SetPlayerPos(DerbyPlayers[p], 1421.7180,-1623.7816,13.5469);
                            SetPlayerFacingAngle(DerbyPlayers[p], 270.0074);
                            RegisterDerby[DerbyPlayers[p]] = 0;
                            DerbyPlayers[p] = INVALID_PLAYER_ID;
