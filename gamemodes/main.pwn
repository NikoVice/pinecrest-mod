CMD:party(playerid, params[])
{
    new vehicleid = p_temp[playerid][rented_veh];
    switch(p_temp[playerid][Work_ID])
    {
        case ELECTRIC_WORK:
        {
            if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "У Вас нет арендованного рабочего транспортного средства.");
            if(veh_info[vehicleid][v_npoType] != NPO_JOB && veh_info[vehicleid][v_npoId] != JOB_ELECTRIC && veh_info[vehicleid][v_temp_job] != JOB_ELECTRIC) return SendError(playerid, "У Вас нет арендованного рабочего транспортного средства.");
            if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /party [id игрока]");
            if(!IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
            if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");
            if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
            if(p_temp[params[0]][Work_ID] != ELECTRIC_WORK) return SendError(playerid, "Игрок не работает электриком.");
            if(ElectricParty[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок уже работает совместно с кем-то.");
            new scdvehicleid = p_temp[params[0]][rented_veh];
            if(scdvehicleid != INVALID_VEHICLE_ID)
            {
                if((veh_info[scdvehicleid][v_npoType] == NPO_JOB && veh_info[scdvehicleid][v_npoId] == JOB_ELECTRIC) || veh_info[scdvehicleid][v_temp_job] == JOB_ELECTRIC) return SendError(playerid, "У игрока есть арендованное рабочее транспортное средство.");
            }

            SendAccess(playerid, "Вы предложили %s [%d] работать электриком совместно.", get_name(params[0]), params[0]);
            SendInfo(params[0], "%s [%d] предложил Вам работать электриком совместно.", get_name(playerid), playerid);

            SetFreeSlotOffer(params[0], playerid, OFFER_ID_ELECTRIC_PARTY);
        }
        case COLLECTOR_WORK:
        {
            if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "У Вас нет арендованного рабочего транспортного средства.");
            if(veh_info[vehicleid][v_npoType] != NPO_JOB && veh_info[vehicleid][v_npoId] != JOB_COLLECTOR && veh_info[vehicleid][v_temp_job] != JOB_COLLECTOR) return SendError(playerid, "У Вас нет арендованного рабочего транспортного средства.");
            if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /party [id игрока]");
            if(!IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
            if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");
            if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
            if(p_temp[params[0]][Work_ID] != COLLECTOR_WORK) return SendError(playerid, "Игрок не работает инкассатором.");
            if(CollectorParty[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок уже работает совместно с кем-то.");
            new scdvehicleid = p_temp[params[0]][rented_veh];
            if(scdvehicleid != INVALID_VEHICLE_ID)
            {
                if((veh_info[scdvehicleid][v_npoType] == NPO_JOB && veh_info[scdvehicleid][v_npoId] == JOB_COLLECTOR) || veh_info[scdvehicleid][v_temp_job] == JOB_COLLECTOR) return SendError(playerid, "У игрока есть арендованное рабочее транспортное средство.");
            }

            SendAccess(playerid, "Вы предложили %s [%d] работать инкассатором совместно.", get_name(params[0]), params[0]);
            SendInfo(params[0], "%s [%d] предложил Вам работать инкассатором совместно.", get_name(playerid), playerid);

            SetFreeSlotOffer(params[0], playerid, OFFER_ID_COLLECTOR_PARTY);
        }
        case ROBBER_WORK:
        {
            if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "У Вас нет арендованного рабочего транспортного средства.");
            if(veh_info[vehicleid][v_npoType] != NPO_JOB || veh_info[vehicleid][v_npoId] != JOB_ROBBER) return SendError(playerid, "У Вас нет арендованного рабочего транспортного средства.");
            if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /party [id игрока]");
            if(!IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
            if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");
            if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
            if(p_temp[params[0]][Work_ID] != ROBBER_WORK) return SendError(playerid, "Игрок не работает грабителем.");
            if(RobberParty[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок уже работает совместно с кем-то.");
            new scdvehicleid = p_temp[params[0]][rented_veh];
            if(scdvehicleid != INVALID_VEHICLE_ID)
            {
                if(veh_info[scdvehicleid][v_npoType] == NPO_JOB && veh_info[scdvehicleid][v_npoId] == JOB_ROBBER) return SendError(playerid, "У игрока есть арендованное рабочее транспортное средство.");
            }

            SendAccess(playerid, "Вы предложили %s [%d] работать грабителем совместно.", get_name(params[0]), params[0]);
            SendInfo(params[0], "%s [%d] предложил Вам работать грабителем совместно.", get_name(playerid), playerid);

            SetFreeSlotOffer(params[0], playerid, OFFER_ID_ROBBER_PARTY);
        }
        default: SendError(playerid, "Вы не работаете на работе, на которой можно работать совместно.");
    }
    return 1;
}

CMD:leaveparty(playerid, params[])
{
    switch(p_temp[playerid][Work_ID])
    {
        case ELECTRIC_WORK:
        {
            if(ElectricParty[playerid] == INVALID_PLAYER_ID) return SendError(playerid, "Вы не работаете с кем-то совместно.");

            new scdplayerid = ElectricParty[playerid];
            if(IsPlayerConnected(scdplayerid))
            {
                for(new i = 0; i < 3; i++)
                {
                    if(ElectricMembersParty[scdplayerid][i] == playerid)
                    {
                        SendInfo(scdplayerid, "%s [%d] отказал(-ся/-ась) работать с Вами, Вы больше не работаете совместно.", get_name(playerid), playerid);
                        SendInfo(playerid, "Вы отказались работать совместно с %s [%d]", get_name(scdplayerid), scdplayerid);
                        ElectricMembersParty[scdplayerid][i] = INVALID_PLAYER_ID;
                    }
                }
            }
            ElectricParty[playerid] = INVALID_PLAYER_ID;
            SendMes(playerid, COLOR_BLUE, "Вы больше не работаете совместно.");

            ElectricIDx[playerid] = -1;
            ElectricVehicleIDx[playerid] = INVALID_VEHICLE_ID;
            ElectricAttachedObject[playerid] = 0;

            DisablePlayerCheckpoint(playerid);
            CancelPlayerGPS(playerid);
        }
        case COLLECTOR_WORK:
        {
            if(CollectorParty[playerid] == INVALID_PLAYER_ID) return SendError(playerid, "Вы не работаете с кем-то совместно.");

            new scdplayerid = CollectorParty[playerid];
            if(IsPlayerConnected(scdplayerid))
            {
                for(new i = 0; i < 3; i++)
                {
                    if(CollectorMembersParty[scdplayerid][i] == playerid)
                    {
                        SendInfo(scdplayerid, "%s [%d] отказал(-ся/-ась) работать с Вами, Вы больше не работаете совместно.", get_name(playerid), playerid);
                        SendInfo(playerid, "Вы отказались работать совместно с %s [%d]", get_name(scdplayerid), scdplayerid);
                        CollectorMembersParty[scdplayerid][i] = INVALID_PLAYER_ID;
                    }
                }
            }
            CollectorParty[playerid] = INVALID_PLAYER_ID;
            SendMes(playerid, COLOR_BLUE, "Вы больше не работаете совместно.");

            CollectorIDx[playerid] = -1;
            CollectorVehicleIDx[playerid] = INVALID_VEHICLE_ID;
            CollectorAttachedObject[playerid] = 0;

            DisablePlayerCheckpoint(playerid);
            CancelPlayerGPS(playerid);
        }
        case ROBBER_WORK:
        {
            if(RobberParty[playerid] == INVALID_PLAYER_ID) return SendError(playerid, "Вы не работаете с кем-то совместно.");

            new scdplayerid = RobberParty[playerid];
            if(IsPlayerConnected(scdplayerid))
            {
                for(new i = 0; i < 3; i++)
                {
                    if(RobberMembersParty[scdplayerid][i] == playerid)
                    {
                        SendInfo(scdplayerid, "%s [%d] отказал(-ся/-ась) работать с Вами, Вы больше не работаете совместно.", get_name(playerid), playerid);
                        SendInfo(playerid, "Вы отказались работать совместно с %s [%d]", get_name(scdplayerid), scdplayerid);
                        RobberMembersParty[scdplayerid][i] = INVALID_PLAYER_ID;
                    }
                }
            }
            RobberParty[playerid] = INVALID_PLAYER_ID;
            SendAccess(playerid, "Вы больше не работаете совместно.");

            RobberIDx[playerid] = -1;
            RobberVehicleIDx[playerid] = INVALID_VEHICLE_ID;
            RobberAttachedObject[playerid] = 0;

            DisablePlayerCheckpoint(playerid);
            CancelPlayerGPS(playerid);
        }
        default: SendError(playerid, "Вы не работаете на работе, на которой можно работать совместно.");
    }
    return 1;
}

CMD:giveinv(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10) return 1;
    if(sscanf(params, "uii", params[0], params[1], params[2])) return SendInfo(playerid, "Используйте: /giveinv [id игрока] [id предмета] [кол-во]");
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "Игрок не найден.");
    if(params[1] < 0 || params[1] >= MAX_ITEMS) return SendError(playerid, "ID предмета должен быть не менее 0 и не более %d.", MAX_ITEMS);
    if(params[2] < 1 || params[2] > 1000) return SendError(playerid, "Количество должно быть не менее 1 и не более 1000.");

    if(!GivePlayerInventory(params[0], params[1], params[2], .reason = "выдача /giveinv"))
        return 1;
    // Администратор Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) выдал Durel_Pavel[3](127.0.0.1 PC/0.3.7-R2) аксессуар <Голубая луна>(144)
    Log(LOG_player, INFO, "Администратор %s[%d](%s %s) выдал %s[%d](%s %s) предмет <%s>(%d) в кол-во %d | #giveinv",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC",
        ItemsInfo[params[1]][iName], params[1], params[2]);

    SendAccess(playerid, "Вы выдали %s [%d] предмет \"%s\" в количестве %d.", get_name(params[0]), params[0], ItemsInfo[params[1]][iName], params[2]);
    SendInfo(params[0], "Администратор %s [%d] выдал Вам предмет \"%s\" в количестве %d.", get_name(playerid), playerid, ItemsInfo[params[1]][iName], params[2]);
    return 1;
}
alias:giveinv("giveac", "setskinmain");

CMD:captcha(playerid, params[])
{
    ShowTextDraw_Captcha(playerid, CAPTCHA_TRAINING_ID);
    return 1;
}

IsGPSVisable(playerid)
{
    if(IsPlayerInAnyVehicle(playerid))
    {
        new vehicleid = GetPlayerVehicleID(playerid);

        if(veh_info[vehicleid][v_npoType] == NPO_JOB &&
            (veh_info[vehicleid][v_npoId] == JOB_BUS || veh_info[vehicleid][v_npoId] == JOB_PIZZABOY ||
            veh_info[vehicleid][v_npoId] == JOB_COLLECTOR || veh_info[vehicleid][v_npoId] == JOB_FIREMAN ||
            veh_info[vehicleid][v_npoId] == JOB_CONSTRUCTION_FORKLIFT || veh_info[vehicleid][v_npoId] == JOB_ROBBER ||
            veh_info[vehicleid][v_npoId] == JOB_TRAIN || veh_info[vehicleid][v_npoId] == JOB_TRAM ||
            veh_info[vehicleid][v_npoId] == JOB_PILOT || veh_info[vehicleid][v_npoId] == JOB_RAILWAY_FACTORY_FORKLIFT ||
            veh_info[vehicleid][v_npoId] == JOB_HUNTING || veh_info[vehicleid][v_npoId] == JOB_PANEL) ||
            veh_info[vehicleid][v_temp_job] == JOB_BUS || veh_info[vehicleid][v_temp_job] == JOB_COLLECTOR ||
            veh_info[vehicleid][v_temp_job] == JOB_FIREMAN || veh_info[vehicleid][v_temp_job] == JOB_PILOT) return SendError(playerid, "Вы не можете пользоваться этим во время работы.");
    }

    if(p_temp[playerid][Work_ID] == CONSTRUCTION_WORK || p_temp[playerid][Work_ID] == LABORATORY_WORK ||
        p_temp[playerid][Work_ID] == SPACE_WORK || p_temp[playerid][Work_ID] == RAILWAY_WORK ||
        p_temp[playerid][Work_ID] == COLLECTOR_WORK || p_temp[playerid][Work_ID] == ROBBER_WORK ||
        p_temp[playerid][Work_ID] == CAR_FACTORY_WORK || p_temp[playerid][Work_ID] == HUNTING_WORK ||
        p_temp[playerid][Work_ID] == GUN_FACTORY_WORK || p_temp[playerid][Work_ID] == ELECTRIC_WORK) return SendError(playerid, "Вы не закончили рабочий день на прошлой работе.");

    if(TheftCarGPS[playerid] != false || 
        p_temp[playerid][taxi_bots_idx] != 0 ||
        p_temp[playerid][mechanic_idx] != 0 ||
        p_temp[playerid][panic_target_id] != INVALID_PLAYER_ID) return SendError(playerid, "Вы не можете пользоваться этим во время работы.");

    return -1;
}

GetPlayerDisease(playerid, idx, first_parameter, second_parameter)
{
    if(random(first_parameter) < second_parameter && p_info[playerid][Disease][idx] != 3 && p_info[playerid][level] >= 10 && p_info[playerid][admin] == 0 && p_info[playerid][DonateUpdate][2] == 0 && p_info[playerid][p_add_vip] == 0 && (p_info[playerid][cash] + p_info[playerid][bank] + p_info[playerid][bank_deposit] >= 5000000)) return 1;
    return 0;
}

CMD:findhouse(playerid, params[])
{
    if(p_info[playerid][cash] < 2500) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

    new
        houseId = strval(params);

    if(!(0 <= houseId < totalhouses) || h_info[houseId][h_mysql_id] == INVALID_MYSQL_ID)
        return SendError(playerid, "Неверный ID дома.");

    SetPlayerMoney(playerid, -2500, true, "/findhouse");

    SetPlayerGPS(playerid, h_info[houseId][h_enter][0], h_info[houseId][h_enter][1], h_info[houseId][h_enter][2], 5.0);
    SendInfo(playerid, "\"Дом #%d\" отмечен на GPS навигаторе. Расстояние: %.0f метров.", houseId, GetPlayerDistanceFromPoint(playerid, h_info[houseId][h_enter][0], h_info[houseId][h_enter][1], h_info[houseId][h_enter][2]));
    return 1;
}

CMD:findbiz(playerid, params[])
{
    if(p_info[playerid][cash] < 5000) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

    new
        bizz_id = strval(params);

    if(!(0 <= bizz_id < totalbizz) || b_info[bizz_id][b_mysql_id] == INVALID_MYSQL_ID)
        return SendError(playerid, "Неверный ID бизнеса.");

    SetPlayerMoney(playerid, -5000, true, "/findbiz");

    SetPlayerGPS(playerid, b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2], 5.0);
    SendInfo(playerid, "\"Бизнес #%d\" отмечен на GPS навигаторе. Расстояние: %.0f метров.", bizz_id, GetPlayerDistanceFromPoint(playerid, b_info[bizz_id][b_enter][0], b_info[bizz_id][b_enter][1], b_info[bizz_id][b_enter][2]));
    return 1;
}

CMD:start(playerid, params[])
{
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "Вы должны находиться в транспортном средстве.");
    new vehicleid = GetPlayerVehicleID(playerid);
    if(!IsPlayerOwnerVehicle(playerid, vehicleid)) return SendError(playerid, "Вы должны находиться в личном транспортном средстве.");
    if(IsPlayerRentedVehicle(playerid, p_temp[playerid][rented_veh])) callcmd::unrent(playerid, "/0");
    ShowPlayerDialog(playerid, D_START_WORK, DIALOG_STYLE_LIST, ""I"Работа на личном транспортном средстве", "\
        "I"[1]"W" Водитель автобуса\n\
        "I"[2]"W" Автомеханик\n\
        "I"[3]"W" Инкассатор\n\
        "I"[4]"W" Пожарный\n\
        "I"[5]"W" Пилот\n\
        "I"[6]"W" Электрик\n\
        "I"[7]"W" Ремонтник панелей\n\
        "I"[8]"W" Нефтяник\n\
        "I"[9]"W" Дальнобойщик", "Далее", "Отмена");
    return 1;
}

