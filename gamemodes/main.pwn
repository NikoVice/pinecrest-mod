            {
                p_temp[playerid][pPressed]++;
                new idx = p_temp[playerid][pPressed];
                SetPlayerRaceCheckpoint(playerid, 1, Train[idx][trainPosX], Train[idx][trainPosY], Train[idx][trainPosZ]-1.5, 0, 0, 0, 3.0);
            }
            else
            {
