        case D_FRACTION_VEHICLE_SELL:
        {
            if(!response) return callcmd::fcars(playerid, "/0");
            if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "�� ������ ���������� � ������������ ��������.");
            if(p_info[playerid][admin] < 10) return SendError(playerid, "������ ����������� �������� ������ ������� �������������.");
            new vehicleid = GetPlayerVehicleID(playerid);
            if(veh_info[vehicleid][v_npoType] != NPO_FACTION || veh_info[vehicleid][v_npoId] != p_info[playerid][member]) return SendError(playerid, "������������ �������� �� ����������� ����� �������.");
            if(veh_info[vehicleid][v_owner_id] != INVALID_MYSQL_ID) return SendError(playerid, "������������ ��������� ������� �����.");
            new price = GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_PRICE)/2;

            new frac_id = p_info[playerid][member];
            new idx = GetSlotFractionVehicle(frac_id, GetVehicleModelEx(vehicleid));
            if(idx == -1) return SendError(playerid, "������ ������ �� �������� �� ���� ��������.");
            DestroyVehicleVEx(vehicleid);
            veh_info[vehicleid][v_lock] = 0;

            FractionsData[frac_id][fVehModelMaxCount][idx]--;
            if(FractionsData[frac_id][fVehModelMaxCount][idx] <= 0)
            {
                FractionsData[frac_id][fVehModelsID][idx] =
                FractionsData[frac_id][fVehModelMaxCount][idx] =
                FractionsData[frac_id][fVehModelUseCount][idx] = 0;
                if(idx < MAX_FRACTIONS_VEHICLES-1)
                {
                    for(new i = idx; i < MAX_FRACTIONS_VEHICLES; i++)
                    {
                        FractionsData[frac_id][fVehModelsID][i] = FractionsData[frac_id][fVehModelsID][i+1];
                        FractionsData[frac_id][fVehModelMaxCount][i] = FractionsData[frac_id][fVehModelMaxCount][i+1];
                        FractionsData[frac_id][fVehModelUseCount][i] = FractionsData[frac_id][fVehModelUseCount][i+1];
                        FractionsData[frac_id][fVehAccessRank][i] = FractionsData[frac_id][fVehAccessRank][i+1];
                        if(i+2 < MAX_FRACTIONS_VEHICLES && FractionsData[frac_id][fVehModelsID][i+2] == 0)
                        {
                            FractionsData[frac_id][fVehModelsID][i+1] =
                            FractionsData[frac_id][fVehModelMaxCount][i+1] =
                            FractionsData[frac_id][fVehModelUseCount][i+1] = 0;
                            FractionsData[frac_id][fVehAccessRank][i+1] = 1;
                            break;
                        }
                    }
                }
            }
