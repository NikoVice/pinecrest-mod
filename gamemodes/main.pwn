        case 0:
        {
            new cost_house = h_info[typeId][h_value], list_percent[3] = {95, 90, 85}, vip_idx = p_info[playerid][p_vip];
            if(vip_idx) cost_house = ((h_info[typeId][h_value] / 100) * list_percent[vip_idx - 1]);

            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, ""W"\
                ����� ����: %d\n\
                ����� ����: %s\n\
                ��������� ����: %d$", typeId, house_class[h_info[typeId][h_squar]-1], cost_house);
            ShowPlayerDialog(playerid, D_REALTOR_HOUSE_INFO, DIALOG_STYLE_MSGBOX, ""I"���", STRING_GLOBAL, "GPS", "������");
        }
        case 1:
        {
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, ""W"\
                ����� �������: %d\n\
                �������� �������: %s\n\
                ��� �������: %s\n\
                ��������� �������: %d$", typeId, b_info[typeId][_name], bizz_type_name[b_info[typeId][_tip]], b_info[typeId][_price]);
            ShowPlayerDialog(playerid, D_REALTOR_BIZZ_INFO, DIALOG_STYLE_MSGBOX, ""I"������", STRING_GLOBAL, "GPS", "������");
        }
        case 2:
        {
            new cost_house = h_info[typeId][h_value], list_percent[3] = {95, 90, 85}, vip_idx = p_info[playerid][p_vip];
            if(vip_idx) cost_house = ((h_info[typeId][h_value] / 100) * list_percent[vip_idx - 1]);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, ""W"\
                ����� ����: %d\n\
                ����� ����: %s\n\
                ��������� ����: %d$\n\n", typeId, house_class[h_info[typeId][h_squar]-1], cost_house);
            f(STRING_GLOBAL, "%s\
                "I"[1]"W" ��������: %s\n\
                "I"[2]"W" ����������: %s\n\
                "I"[3]"W" ������: %s\n\
                "I"[4]"W" ���������� ���������: %s\n\n", STRING_GLOBAL,
                h_info[typeId][h_improve][SUBSIDY] == 1 ?  ("{008000}����"):("{FF0000}���"), h_info[typeId][h_improve][RENTERS] == 1 ?  ("{008000}����"):("{FF0000}���"),
                h_info[typeId][h_improve][BASEMENT] == 1 ?  ("{008000}����"):("{FF0000}���"), h_info[typeId][h_improve][UNDERGROUND] == 1 ?  ("{008000}����"):("{FF0000}���"));

            new count[3];

            for(new i = 1; i <= totalpanel; i++)
            {
                if(PanelHouseInfo[i][PanelHouseIDx] != typeId) continue;
                f(STRING_GLOBAL, "%s"I"[%d]"W" ��������� ������ (%d ��.)\n", STRING_GLOBAL, count[2] + 1, PanelHouseInfo[i][PanelHouseDay]);
                count[0]++;
            }
            if(count[0] != 0) strcat(STRING_GLOBAL, "\n\n");
            for(new i = 1, str_count; i <= totalvideocards; i++)
            {
                if(VideoCardsInfo[i][vcHouseIDx] != typeId) continue;
                f(STRING_GLOBAL, "%s"I"[%d]"W" ���������� (%d ��.)%s", STRING_GLOBAL, count[1] + 1, VideoCardsInfo[i][vcLevel], str_count == 2 ? "\n" : "\t");
                count[1]++;
                str_count++;
                if(str_count == 3) str_count = 0;
            }
            if(count[1] != 0) strcat(STRING_GLOBAL, "\n\n");
            for(new i = 1, str_count; i <= totalundergroundbots; i++)
            {
                if(UndergroundBotsInfo[i][ubHouseIDx] != typeId) continue;
                f(STRING_GLOBAL, "%s"I"[%d]"W" ������� (%s)%s", STRING_GLOBAL, count[2] + 1, UndergroundBotsName[UndergroundBotsInfo[i][ubEducation] - 1], str_count == 2 ? "\n" : "\t");
                count[2]++;
                str_count++;
                if(str_count == 3) str_count = 0;
            }
            ShowPlayerDialog(playerid, D_EXCHANGE_PREVIEW_INFO, DIALOG_STYLE_MSGBOX, ""I"���", STRING_GLOBAL, "�����", "");
        }
        case 3:
        {
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "SELECT * FROM `bizz_finka` WHERE `bizz_id` = %d LIMIT 1", b_info[typeId][b_mysql_id]);
            mysql_tquery(con_bd, STRING_GLOBAL, "OnLoadStatsBizz", "iii", playerid, typeId, 1); 
        }
    }
    return 1;
}


