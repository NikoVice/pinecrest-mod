                    if(iTax > 0) 
                    {
                        SendError(playerid, "�� �����-�� �� ��������� ���� �� ���������� �����.");
                        return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]);
                    }
                    if(iBTC < 1) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]), SendError(playerid, "���������� BTC ������ ���� �� ����� 1.");
                    new max_btc = MAX_PLAYER_BITCOIN - p_info[playerid][bitcoin];
                    if(max_btc < 0 || iBTC > max_btc) return ShowVideoCards(playerid, VIDEO_CARDS_TYPE_RACK, p_temp[playerid][vc_rack]), SendError(playerid, "���������� Bitcoin �� ����� ���� ����� %d.", max_btc);

