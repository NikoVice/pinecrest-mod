}

CMD:ir(playerid, params[])
{
    if(p_info[playerid][fwork] == false || biker(playerid) || mafia(playerid) || gang(playerid)) return 1;
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "У Вас кляп.");
    if(!p_info[playerid][p_settings][CHAT_FRACTION]) return SendError(playerid, "У Вас отключен фракционный чат.");
    if(p_info[playerid][mute] > 0) return SendError(playerid, "У Вас блокировка чата.");
    if(p_info[playerid][rang] < 3) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(strlen(params) < 1 || strlen(params) > 80) return SendError(playerid, "Кол-во символов в сообщении не может быть менее 1 и более 80.");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);
    STRING_GLOBAL[0] = EOS;
    new category_id = -1, mayor_rang = -1;
    switch(p_info[playerid][member])
    {
        case RADIO_LS, RADIO_SF, RADIO_LV: category_id = FACTION_CATEGORY_SNN, mayor_rang = 5;
        case MEDIC_LS, MEDIC_SF, MEDIC_LV: category_id = FACTION_CATEGORY_MEDIC, mayor_rang = 6;
        case NATIONAL_GUARD: category_id = FACTION_CATEGORY_ARMY, mayor_rang = 7;
        case POLICE_LS, POLICE_SF, POLICE_LV, POLICE_RC, FBI_TEAM: category_id = FACTION_CATEGORY_PD, mayor_rang = 8;
        case MAYOR_LS:
        {
            if(p_info[playerid][rang] == 5)  category_id = FACTION_CATEGORY_SNN, mayor_rang = 5;
            else if(p_info[playerid][rang] == 6) category_id = FACTION_CATEGORY_MEDIC, mayor_rang = 6;
            else if(p_info[playerid][rang] == 7) category_id = FACTION_CATEGORY_ARMY, mayor_rang = 7;
            else if(p_info[playerid][rang] == 8) category_id = FACTION_CATEGORY_PD, mayor_rang = 8;
            else return 1;
        }
        default: return 1;
    }
    if(category_id == -1 || mayor_rang == -1) return 1;
    if(p_info[playerid][member] != MAYOR_LS) f(STRING_GLOBAL, "[IR] [%s] %s %s[%d]: %s", GetFractionName(p_info[playerid][member]), GetPlayerFractionRangName(playerid), get_name(playerid), playerid, params);
    else f(STRING_GLOBAL, "[IR] [%s] %s[%d]: %s", GetPlayerFractionRangName(playerid), get_name(playerid), playerid, params);
    foreach(new targetid : Player)
    {
        if(category_id == FACTION_CATEGORY_PD)
        {
            if(((GetFactionCategory(p_info[targetid][member]) == FACTION_CATEGORY_FBI || GetFactionCategory(p_info[targetid][member]) == FACTION_CATEGORY_PD) && p_info[targetid][fwork] == true) || (p_info[targetid][member] == MAYOR_LS && p_info[targetid][rang] == 8 && p_info[targetid][fwork] == true))
                SendMes(targetid, 0x3399CCFF, STRING_GLOBAL);
        }
        else if((GetFactionCategory(p_info[targetid][member]) == category_id && p_info[targetid][fwork] == true) || (p_info[targetid][member] == MAYOR_LS && p_info[targetid][rang] == mayor_rang && p_info[targetid][fwork] == true))
            SendMes(targetid, 0x3399CCFF, STRING_GLOBAL);
    }
    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "На поясном держателе висит портативная рация.");
        MeAction(playerid, "отцепив портативную рацию нажал на кнопку, после чего передал сообщение");
    }
    return 1;
}

CMD:irb(playerid, params[])
{
    if(p_info[playerid][fwork] == false || biker(playerid) || mafia(playerid) || gang(playerid)) return 1;
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "У Вас кляп.");
    if(!p_info[playerid][p_settings][CHAT_FRACTION]) return SendError(playerid, "У Вас отключен фракционный чат.");
    if(p_info[playerid][mute] > 0) return SendError(playerid, "У Вас блокировка чата.");
    if(p_info[playerid][rang] < 2) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(strlen(params) < 1 || strlen(params) > 80) return SendError(playerid, "Кол-во символов в сообщении не может быть менее 1 и более 80.");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);
    STRING_GLOBAL[0] = EOS;
    new category_id = -1, mayor_rang = -1;
    switch(p_info[playerid][member])
    {
        case RADIO_LS, RADIO_SF, RADIO_LV: category_id = FACTION_CATEGORY_SNN, mayor_rang = 5;
        case MEDIC_LS, MEDIC_SF, MEDIC_LV: category_id = FACTION_CATEGORY_MEDIC, mayor_rang = 6;
        case NATIONAL_GUARD: category_id = FACTION_CATEGORY_ARMY, mayor_rang = 7;
        case POLICE_LS, POLICE_SF, POLICE_LV, POLICE_RC, FBI_TEAM: category_id = FACTION_CATEGORY_PD, mayor_rang = 8;
        case MAYOR_LS:
        {
            if(p_info[playerid][rang] == 5)  category_id = FACTION_CATEGORY_SNN, mayor_rang = 5;
            else if(p_info[playerid][rang] == 6) category_id = FACTION_CATEGORY_MEDIC, mayor_rang = 6;
            else if(p_info[playerid][rang] == 7) category_id = FACTION_CATEGORY_ARMY, mayor_rang = 7;
            else if(p_info[playerid][rang] == 8) category_id = FACTION_CATEGORY_PD, mayor_rang = 8;
            else return 1;
        }
        default: return 1;
    }
    if(category_id == -1 || mayor_rang == -1) return 1;
    if(p_info[playerid][member] != MAYOR_LS) f(STRING_GLOBAL, "(( [R] [%s] %s %s[%d]: %s ))", GetFractionName(p_info[playerid][member]), GetPlayerFractionRangName(playerid), get_name(playerid), playerid, params);
    else f(STRING_GLOBAL, "(( [R] [%s] %s[%d]: %s ))", GetPlayerFractionRangName(playerid), get_name(playerid), playerid, params);
    foreach(new targetid : Player)
    {
        if(category_id == FACTION_CATEGORY_PD)
        {
            if(((GetFactionCategory(p_info[targetid][member]) == FACTION_CATEGORY_FBI || GetFactionCategory(p_info[targetid][member]) == FACTION_CATEGORY_PD) && p_info[targetid][fwork] == true) || (p_info[targetid][member] == MAYOR_LS && p_info[targetid][rang] == 8 && p_info[targetid][fwork] == true))
                SendMes(targetid, 0x3399CCFF, STRING_GLOBAL);
        }
        else if((GetFactionCategory(p_info[targetid][member]) == category_id && p_info[targetid][fwork] == true) || (p_info[targetid][member] == MAYOR_LS && p_info[targetid][rang] == mayor_rang && p_info[targetid][fwork] == true))
            SendMes(targetid, 0x3399CCFF, STRING_GLOBAL);
    }
    return 1;
}

CMD:lr(playerid, params[])
{
    if(p_info[playerid][leader] == 0) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(strlen(params) < 1 || strlen(params) > 80) return SendError(playerid, "Кол-во символов в сообщении не может быть менее 1 и более 80.");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);
    f(STRING_GLOBAL, "[LR] [%s] %s %s[%d]: %s", GetFractionName(p_info[playerid][member]), GetPlayerFractionRangName(playerid), get_name(playerid), playerid, params);
    foreach(new targetid: Player)
    {
        if(p_info[targetid][leader] != 0) SendMes(targetid, 0x3399CCFF, STRING_GLOBAL);
    }
    return 1;
}

CMD:namestore(playerid, params[])
{
    if(p_info[playerid][admin] < 3) return 1;
    if(!(3 <= strlen(params) <= 24)) return SendError(playerid, "Длина введеного текста должна быть не менее 3 и не более 24 символов.");
    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id` FROM `accounts` WHERE `name` = '%e' LIMIT 1", params);
    mysql_tquery(con_bd, STRING_GLOBAL, "OnServerCheckAccountData", "i", playerid);
    return 1;
}

forward OnServerCheckAccountData(playerid);
public OnServerCheckAccountData(playerid)
{
    new string;
    cache_get_row_count(string);
    if(!string) return SendError(playerid, "Ничего не найдено.");

    new BaseID;
    cache_get_value_name_int(0, "id", BaseID);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `log_name` WHERE `OWNER` = %d",
    BaseID);
    mysql_tquery(con_bd, STRING_GLOBAL, "OnServerCheckNickNameData", "i", playerid);
    return 1;
}

forward OnServerCheckNickNameData(playerid);
public OnServerCheckNickNameData(playerid)
{
    new string;
    cache_get_row_count(string);
    if(!string) return SendError(playerid, "Ничего не найдено.");

    STRING_GLOBAL[0] = EOS;
    strcat(STRING_GLOBAL, ""W"№ Старый ник\t"W"Новый ник\t"W"Дата изменения\n"W"");

    for(new i; i != string; i ++)
    {
        new old_name[MAX_PLAYER_NAME];
        new new_name[MAX_PLAYER_NAME];
        new str_date[MAX_PLAYER_NAME];

        cache_get_value_name(i, "OLD_NAME", old_name, MAX_PLAYER_NAME);
        cache_get_value_name(i, "NEW_NAME", new_name, MAX_PLAYER_NAME);
        cache_get_value_name(i, "DATA",     str_date, MAX_PLAYER_NAME);

        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{FF0000}%s     {00FF00}%s     "W"%s\n", STRING_GLOBAL, old_name, new_name, str_date);
    }
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"История смены ника", STRING_GLOBAL, "Закрыть", "");
    return 1;
}

CMD:uptest(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10) return 1;
    TEST_SYSTEM = !TEST_SYSTEM;
    SendAccess(playerid, "Выполнено.");
    return 1;
}

CMD:wbook(playerid, params[])
{
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "Используйте: /wbook [id игрока]");
    if(IsPlayerConnected(params[0]) == 0) return SendError(playerid, "Игрок не найден.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");

    if(params[0] == playerid)
    {
        ShowWBook(playerid, playerid);
        MeAction(playerid, "достал(-а) трудовую книгу и рассматривает ее");
    }
    else
    {
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL, ""W"Вы хотите предложить"I"%s "W"посмотреть Вашу трудовую книгу.", get_name(params[0]));
        ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"Трудовая книга.", STRING_GLOBAL, "Далее", "Отмена");
        SetOfferData(playerid, params[0], OFFER_ID_SHOW_WBOOK);
    }
    return 1;
}


CMD:rang(playerid, params[])
{
    STRING_GLOBAL[0] = EOS;
    if(sscanf(params, "ui", params[0], params[1])) return SendInfo(playerid, "Используйте: /rang [id игрока] [ранг]");
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не найден.");
    if(params[0] == playerid) return SendError(playerid, "Вы ввели свой ID.");
    if(p_info[playerid][member] == MAYOR_LS && p_info[params[0]][member] != MAYOR_LS)
    {
        if(p_info[params[0]][leader] != 0) return SendError(playerid, "Игрок лидер фракции.");
        switch(p_info[playerid][rang])
        {
            case 8:
            {
                if(GetFactionCategory(p_info[params[0]][member]) != FACTION_CATEGORY_PD)
                    return SendError(playerid, "Игрок не состоит в полиции.");
            }
            case 7:
            {
                if(GetFactionCategory(p_info[params[0]][member]) != FACTION_CATEGORY_ARMY)
                    return SendError(playerid, "Игрок не состоит в армии.");
            }
            case 6:
            {
                if(GetFactionCategory(p_info[params[0]][member]) != FACTION_CATEGORY_MEDIC)
                    return SendError(playerid, "Игрок не состоит в больнице.");
            }
            case 5:
            {
                if(GetFactionCategory(p_info[params[0]][member]) != FACTION_CATEGORY_SNN)
                    return SendError(playerid, "Игрок не состоит в радиоцентре.");
            }
            default: return SendError(playerid, "Вы не министр.");
        }
    }
    else
    {
        if(p_info[playerid][leader] == 0 && p_info[playerid][rang] < 9) return true;
        if(p_info[params[0]][member] != p_info[playerid][member]) return SendError(playerid, "Игрок не состоит во фракции.");
        if(p_info[params[0]][leader] == p_info[playerid][member]) return 1;
        if(GetFactionCategory(p_info[playerid][member]) == FACTION_CATEGORY_ARMY && p_info[playerid][rang] < 7) return 1;
        if(p_info[playerid][rang] <= p_info[params[0]][rang]) return 1;
        if(p_info[params[0]][fwork] == false) return SendError(playerid, "Игрок должен быть в форме.");
        if(p_info[playerid][rang] <= 9 && params[1] > 7) return SendError(playerid, "Ранг не может быть 7.");
        if(!(1 <= params[1] <= p_info[playerid][rang]-1)) return SendError(playerid, "Ранг не может быть менее 1 и более чем %d(Ваш-1).", p_info[playerid][rang]-1);
    }
    if(!(1 <= params[1] <= 9))
        return SendError(playerid, "Ранг не может быть менее 1 и более 9.");

    p_info[params[0]][rang] = params[1];
    SetPlayerFractionSkin(params[0]);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы изменили %s [%d] ранг на %s (%d).", get_name(params[0]), params[0], GetPlayerFractionRangName(params[0]), p_info[params[0]][rang]);
    SendAccess(playerid, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s [%d] изменил Ваш ранг на %s (%d).", get_name(playerid), playerid, GetPlayerFractionRangName(params[0]), p_info[params[0]][rang]);
    SendAccess(params[0], STRING_GLOBAL);

    save_player(params[0]);

    Log(LOG_player, INFO, "%s[%d](%s %s) был повышен/понижен %s[%d](%s %s) на %d ранг в %s | #Fraction",
        get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", params[1], GetFractionName(p_info[params[0]][member]));

    Log(LOG_player, INFO, "%s[%d](%s %s) повысил/понизил %s[%d](%s %s) на %d ранг в %s | #Fraction",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC", params[1], GetFractionName(p_info[params[0]][member]));
    return true;
}
CMD:gov(playerid, params[])
{
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "У Вас кляп.");
    if(p_info[playerid][mute] > 0) return SendError(playerid, "У Вас блокировка чата.");
    if(gos(playerid) == 0 && GetFactionCategory(p_info[playerid][member]) != FACTION_CATEGORY_SNN) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(p_info[playerid][rang] < 9) return SendError(playerid, "Вы не можете пользоваться этой командой.");
    if(!(1 <= strlen(params) <= 80)) return SendError(playerid, "Длина введеного текста должна быть не менее 1 и не более 80 символов.");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 0);

    // Проверяем счетчик;
    if(GetPVarInt(playerid, "GovAntiAttack") > 20) return OnPlayerSystemBan(playerid, "GOV-ATTACK");
    // Обновляем счетчик;
    SetPVarInt(playerid, "GovAntiAttack", GetPVarInt(playerid, "GovAntiAttack") + 5);

    SendMesAll(0x18A5E6FF, "[Гос. новости] %s [%d]: "W"%s", get_name(playerid), playerid, params);
    return 1;
}
alias:gov("government");
//ТЕЛЕФОН
CMD:sms(playerid, params[])
{
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "У Вас кляп.");
    if(p_info[playerid][mute] > 0) return SendError(playerid, "У Вас блокировка чата.");

    if(!GetInventoryAmount(playerid, p_info[playerid][active_phone_id]))
    {
        SendError(playerid, "Вы не можете отправить сообщение, причин может быть несколько:");
        SendError(playerid, "1. У Вас нет телефона;");
        SendError(playerid, "2. У Вас не выбран активный телефон с помощью команды /phone;");
        return 1;
    }

    if(!p_info[playerid][phone_number]) return SendError(playerid, "У Вас нет номера телефона.");
    if(sscanf(params, "is[144]", params[0], params[1])) return SendInfo(playerid, "Используйте: /sms [номер телефона] [текст]" );
    if(strlen(params[1]) < 1 || strlen(params[1]) > 50) return SendError(playerid, "Кол-во символов в сообщении не может быть менее 1 и более 50.");
    if(p_temp[playerid][offphone] == true) return SendError(playerid, "У Вас выключен телефон, включите его.");
    if(AdvertisingCheck(params[1])) return AdvertisingPunishment(playerid, params[0], 1);
    if(params[0] == 0) return 1;
    if(params[0] == 14)
    {
        if(p_info[playerid][news] != RADIO_LS) return SendError(playerid, "Вы должны быть подключены к радиостанции.");
        if(EtherSms[0] == false) return SendError(playerid, "Радиостанция не принимает сообщения.");

        if(p_info[playerid][phone_balance] < SmsPrice[0])
            return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

        foreach(new i : gFactionPlayers[RADIO_LS])
        {
            if((GetPVarInt(i, "Ether") == RADIO_LS))
            {
                p_info[playerid][phone_balance] -= SmsPrice[0];

                SetFractionWarehouse(RADIO_LS, fwMoney, SmsPrice[0]/10);
                PlayerPlaySound(i, 1052, 0.0, 0.0, 0.0);
                PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SMS: %s | Отправитель: %s [%d] (т. %d)", params[1], get_name(playerid), playerid, p_info[playerid][phone_number]);
                SendInfo(i, STRING_GLOBAL);

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SMS: %s | Получатель: LSN (т. 555)", params[1]);
                SendInfo(playerid, STRING_GLOBAL);

                SendAccess(playerid, "Вы отправили сообщение.");
                MeAction(playerid, "достал(-а) мобильный телефон");

                Log(LOG_player, INFO, "%s[%d](%s %s) отправил sms: %s. Получатель: LSN | #AdminLogs",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    params[1]);
                break;
            }
        }
        return 1;
    }
    if(params[0] == 15)
    {
        if(p_info[playerid][news] != RADIO_SF) return SendError(playerid, "Вы должны быть подключены к радиостанции.");
        if(EtherSms[1] == false) return SendError(playerid, "Радиостанция не принимает сообщения.");

        if(p_info[playerid][phone_balance] < SmsPrice[1])
            return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

        foreach(new i : gFactionPlayers[RADIO_SF])
        {
            if((GetPVarInt(i, "Ether") == RADIO_SF))
            {
                p_info[playerid][phone_balance] -= SmsPrice[1];

                SetFractionWarehouse(RADIO_SF, fwMoney, SmsPrice[1]/10);

                PlayerPlaySound(i, 1052, 0.0, 0.0, 0.0);
                PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SMS: %s | Отправитель: %s [%d] (т. %d)", params[1], get_name(playerid), playerid, p_info[playerid][phone_number]);
                SendInfo(i, STRING_GLOBAL);

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SMS: %s | Получатель: SFN (т. 777)", params[1]);
                SendInfo(playerid, STRING_GLOBAL);

                SendAccess(playerid, "Вы отправили сообщение.");
                MeAction(playerid, "достал(-а) мобильный телефон");

                Log(LOG_player, INFO, "%s[%d](%s %s) отправил sms: %s. Получатель: SFN | #AdminLogs",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    params[1]);
                break;
            }
        }
        return 1;
    }
    if(params[0] == 16)
    {
        if(p_info[playerid][news] != RADIO_LV) return SendError(playerid, "Вы должны быть подключены к радиостанции.");
        if(EtherSms[2] == false) return SendError(playerid, "Радиостанция не принимает сообщения.");

        if(p_info[playerid][phone_balance] < SmsPrice[1])
            return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

        foreach(new i : gFactionPlayers[RADIO_LV])
        {
            if((GetPVarInt(i, "Ether") == RADIO_LV))
            {
                p_info[playerid][phone_balance] -= SmsPrice[2];

                SetFractionWarehouse(RADIO_LV, fwMoney, SmsPrice[2]/10);
                PlayerPlaySound(i, 1052, 0.0, 0.0, 0.0);
                PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SMS: %s | Отправитель: %s [%d] (т. %d)", params[1], get_name(playerid), playerid, p_info[playerid][phone_number]);
                SendInfo(i, STRING_GLOBAL);

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SMS: %s | Получатель: LVN (т. 999)", params[1]);
                SendInfo(playerid, STRING_GLOBAL);

                SendAccess(playerid, "Вы отправили сообщение.");
                MeAction(playerid, "достал(-а) мобильный телефон");

                Log(LOG_player, INFO, "%s[%d](%s %s) отправил sms: %s. Получатель: LVN | #AdminLogs",
                    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                    params[1]);
                break;
            }
        }
        return 1;
    }
    new count;
    foreach(new i: Player)
    {
        if(!p_info[i][loggedIn]) continue;
        if(p_info[i][phone_number] == params[0])
        {
            if(!GetInventoryAmount(i, p_info[i][active_phone_id]) || p_temp[i][offphone] == true)
            {
                SendError(playerid, "Вы не можете отправить сообщение на данный номер, причин может быть несколько:");
                SendError(playerid, "1. У игрока выключен телефон;");
                SendError(playerid, "2. У игрока не выбран активный телефон с помощью команды /phone;");
                return 1;
            }

            PlayerPlaySound(i,1052, 0.0, 0.0, 0.0 );
            PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0 );

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SMS: %s | Отправитель: %s [%d] (т. %d)", params[1], get_name(playerid), playerid, p_info[playerid][phone_number]);
            SendInfo(i, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SMS: %s | Получатель: %s [%d] (т. %d)", params[1], get_name(i), i, p_info[i][phone_number]);
            SendInfo(playerid, STRING_GLOBAL);

            SendAccess(playerid, "Вы отправили сообщение.");
            MeAction(playerid, "достал(-а) мобильный телефон");

            Log(LOG_player, INFO, "%s[%d](%s %s) отправил sms: %s. Получатель: %s[%d](%s %s) | #AdminLogs",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                params[1],
                get_name(i), p_info[i][ID], p_temp[i][session_IP], IsPlayerMobile(i) ? "Mobile": "PC");
            count++;
            break;
        }
    }
    if(count == 0) SendError(playerid, "Номер телефона вне зоны доступа сети.");
    return 1;
}

CMD:call(playerid, params[])
{
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "У Вас кляп.");
    if(p_info[playerid][mute] > 0) return SendError(playerid, "У Вас блокировка чата.");

    if(!GetInventoryAmount(playerid, p_info[playerid][active_phone_id]))
    {
        SendError(playerid, "Вы не можете позвонить, причин может быть несколько:");
        SendError(playerid, "1. У Вас нет телефона;");
        SendError(playerid, "2. У Вас не выбран активный телефон с помощью команды /phone;");
        return 1;
    }

    if(!p_info[playerid][phone_number]) return SendError(playerid, "У Вас нет номера телефона.");
    if(sscanf(params, "i", params[0])) {
        ShowPlayerDialog(playerid, D_PHONE_CALL, DIALOG_STYLE_INPUT, ""I"Позвонить", ""W"\
        Введите номер гос. службы:\n\n\
        Полиция - "I"10"W"\n\
        Скорая помощь - "I"11"W"\n\
        Такси - "I"12"W"\n\
        Автомеханик - "I"13"W"\n\
        Радиоцентр [LS] - "I"14"W"\n\
        Радиоцентр [SF] - "I"15"W"\n\
        Радиоцентр [LV] - "I"16"W"\n\
        Мобильный банк - "I"17"W"\n\
        Баланс телефона - "I"18", "Далее", "Отмена");
        return SendInfo(playerid, "Используйте: /call [номер]");
    }
    if(!params[0]) return true;
    if(params[0] == p_info[playerid][phone_number]) return SendError(playerid, "Вы ввели свой номер.");
    if(p_temp[playerid][offphone] == true) return SendError(playerid, "У Вас выключен телефон, включите его.");
    if(p_temp[playerid][calling] != INVALID_PLAYER_ID) return SendError(playerid, "Вы уже с кем-то говорите.");
    new str[64];

    switch(params[0])
    {
        case 18:
        {
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, ""W"Баланс Вашего телефона составляет: "I"%d$", p_info[playerid][phone_balance]);
            ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Баланс",STRING_GLOBAL, "Понял", "");
            return 1;
        }
        case 17:
        {
            if(p_info[playerid][DonateUpdate][0] == 0) return SendError(playerid, "У Вас нет \"Мобильного банка\".");
            ShowPlayerDialog(playerid, D_BANK_MENU, DIALOG_STYLE_LIST, ""I"Банковские услуги", ""I"[1]"W" {"#cLIGHTRED"}Снять"W" или {"#cGREEN"}положить"W" деньги\n"I"[2]"W" Перевести деньги\n"I"[3]"W" Оплатить дом\n"I"[4]"W" Оплатить бизнес\n"I"[5]"W" Пополнить баланс телефона\n"I"[6]"W" Банковский вклад\n"I"[7]"W" Пенсия\n"I"[8]"W" Штрафы\n{"#cLIGHTRED"}[9] Bitcoin", "Далее", "Отмена");
            return 1;
        }
        case 10:
        {
            if(GetPVarInt(playerid, "call:flood") > timestamp) return SendError(playerid, "Вы не можете так часто делать вызовы.");
            if(GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0) return SendError(playerid, "Вы не можете делать вызовы в помещении.");
            SetPVarInt(playerid, "CALL:SERVICES", 1);
            ShowPlayerDialog
            (
                playerid, D_PHONE_CALL_SERVICE, DIALOG_STYLE_INPUT,
                ""I"Полиция",
                ""W"Введите своё сообщение:",
                "Позвонить", "Отмена"
            );
        }
        case 11:
        {
            if(GetPVarInt(playerid, "call:flood") > timestamp) return SendError(playerid, "Вы не можете так часто делать вызовы.");
            if(GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0) return SendError(playerid, "Вы не можете делать вызовы в помещении.");
            SetPVarInt(playerid, "CALL:SERVICES", 2);
            ShowPlayerDialog
            (
                playerid, D_PHONE_CALL_SERVICE, DIALOG_STYLE_INPUT,
                ""I"Скорая помощь",
                ""W"Введите своё сообщение:",
                "Позвонить", "Отмена"
            );
        }
        case 12:
        {
            if(GetPVarInt(playerid, "call:flood") > timestamp) return SendError(playerid, "Вы не можете так часто делать вызовы.");
            if(GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0) return SendError(playerid, "Вы не можете делать вызовы в помещении.");

            STRING_GLOBAL[0] = EOS, STRING_MIN[0] = EOS;
            new count;
            for(new idx = 0; idx < totalbizz; idx++)
            {
                if(b_info[idx][_tip] != B_TAXI) continue;
                format(STRING_MIN, sizeof(STRING_MIN), ""I"[%d]"W" %s\n", count + 1, b_info[idx][_name]);
                strcat(STRING_GLOBAL, STRING_MIN);
                p_temp[playerid][p_listitem][count] = idx;
                count++;
            }
            ShowPlayerDialog(playerid, D_TC_CALL_TAXI, DIALOG_STYLE_LIST, ""I"Служба такси", STRING_GLOBAL, "Далее", "Отмена");
        }
        case 13:
        {
            if(GetPVarInt(playerid, "call:flood") > timestamp) return SendError(playerid, "Вы не можете так часто делать вызовы.");
            if(GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0) return SendError(playerid, "Вы не можете делать вызовы в помещении.");
            SetPVarInt(playerid, "CALL:SERVICES", 4);
            ShowPlayerDialog
            (
                playerid, D_PHONE_CALL_SERVICE, DIALOG_STYLE_INPUT,
                ""I"Автомеханик",
                ""W"Введите своё сообщение:",
                "Позвонить", "Отмена"
            );
        }
        case 14:
        {
            if(GetPVarInt(playerid, "Ether"))
                return SendError(playerid, "Вы находитесь в прямом эфире.");

            if(p_info[playerid][news] != RADIO_LS)
                return SendError(playerid, "Вы должны быть подключены к радиостанции.");

            if(EtherCall[0] == false)
                return SendError(playerid, "Радиостанция не принимает звонки.");

            foreach(new i: gFactionPlayers[RADIO_LS])
            {
                if((GetPVarInt(i, "Ether") == RADIO_LS))
                {
                    if(p_temp[i][calling] != INVALID_PLAYER_ID)
                        return SendError(playerid, "Абонент разговаривает по телефону.");

                    if(p_info[i][jail_time] > 0)
                        return SendError(playerid, "Абонент временно недоступен.");

                    p_temp[playerid][calling] = i;
                    p_temp[i][calling] = playerid;

                    SendInfo(i, "Вас вызывает %s [%d] (т. %d).", get_name(playerid), playerid, p_info[playerid][phone_number]);
                    SendInfo(i, "Ответить на звонок: /p");
                    SendInfo(i, "Сбросить звонок: /h");

                    format(str, sizeof(str), "У %s звонит мобильный телефон", get_name(i));
                    ProxDetector(13.0, i, str, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE);

                    PlayerPlaySound(i, 23000, 0.0, 0.0, 0.0);
                    PlayerPlaySound(playerid, 3600, 0.0, 0.0, 0.0);

                    if(!IsPlayerInAnyVehicle(playerid))
                        SetPlayerSpecialAction(playerid, 11);
                }
            }
        }
        case 15:
        {
            if(GetPVarInt(playerid, "Ether"))
                return SendError(playerid, "Вы находитесь в прямом эфире.");

            if(p_info[playerid][news] != RADIO_SF)
                return SendError(playerid, "Вы должны быть подключены к радиостанции.");

            if(EtherCall[1] == false)
                return SendError(playerid, "Радиостанция не принимает звонки.");

            foreach(new i: gFactionPlayers[RADIO_SF])
            {
                if((GetPVarInt(i, "Ether") == RADIO_SF))
                {
                    if(p_temp[i][calling] != INVALID_PLAYER_ID)
                        return SendError(playerid, "Абонент разговаривает по телефону.");

                    if(p_info[i][jail_time] > 0)
                        return SendError(playerid, "Абонент временно недоступен.");

                    p_temp[playerid][calling] = i;
                    p_temp[i][calling] = playerid;

                    SendInfo(i, "Вас вызывает %s [%d] (т. %d).", get_name(playerid), playerid, p_info[playerid][phone_number]);
                    SendInfo(i, "Ответить на звонок: /p");
                    SendInfo(i, "Сбросить звонок: /h");

                    format(str, sizeof(str), "У %s звонит мобильный телефон", get_name(i));
                    ProxDetector(13.0, i, str, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE);

                    PlayerPlaySound(i, 23000, 0.0, 0.0, 0.0);
                    PlayerPlaySound(playerid, 3600, 0.0, 0.0, 0.0);

                    if(!IsPlayerInAnyVehicle(playerid))
                        SetPlayerSpecialAction(playerid, 11);
                }
            }
        }
        case 16:
        {
            if(GetPVarInt(playerid, "Ether"))
                return SendError(playerid, "Вы находитесь в прямом эфире.");

            if(p_info[playerid][news] != RADIO_LV)
                return SendError(playerid, "Вы должны быть подключены к радиостанции.");

            if(EtherCall[2] == false)
                return SendError(playerid, "Радиостанция не принимает звонки.");

            foreach(new i: gFactionPlayers[RADIO_LV])
            {
                if((GetPVarInt(i, "Ether") == RADIO_LV))
                {
                    if(p_temp[i][calling] != INVALID_PLAYER_ID)
                        return SendError(playerid, "Абонент разговаривает по телефону.");

                    if(p_info[i][jail_time] > 0)
                        return SendError(playerid, "Абонент временно недоступен.");

                    p_temp[playerid][calling] = i;
                    p_temp[i][calling] = playerid;

                    SendInfo(i, "Вас вызывает %s [%d] (т. %d).", get_name(playerid), playerid, p_info[playerid][phone_number]);
                    SendInfo(i, "Ответить на звонок: /p");
                    SendInfo(i, "Сбросить звонок: /h");

                    format(str, sizeof(str), "У %s звонит мобильный телефон", get_name(i));
                    ProxDetector(13.0, i, str, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE);

                    PlayerPlaySound(i, 23000, 0.0, 0.0, 0.0);
                    PlayerPlaySound(playerid, 3600, 0.0, 0.0, 0.0);

                    if(!IsPlayerInAnyVehicle(playerid))
                        SetPlayerSpecialAction(playerid, 11);
                }
            }
        }
        default:
        {
            foreach(new i: Player)
            {
                if(!p_info[i][loggedIn]) continue;
                if(p_info[i][phone_number] == params[0] && GetInventoryAmount(i, p_info[i][active_phone_id]) == 1)
                {
                    if(p_temp[i][offphone] == true) return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Ошибка", "У игрока выключен телефон!", "Закрыть","");
                    if(p_temp[i][calling] != INVALID_PLAYER_ID) return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Ошибка","{00FF00}Линия занята!","Закрыть","");

                    //p_temp[playerid][calling] = i;
                    p_temp[i][calling] = playerid;

                    SendInfo(i, "Вас вызывает %s [%d] (т. %d).", get_name(playerid), playerid, p_info[playerid][phone_number]);
                    SendInfo(i, "Ответить на звонок: /p");
                    SendInfo(i, "Сбросить звонок: /h");

                    SetPlayerChatBubble(playerid, "Достал(-а) телефон", COLOR_MAIN, 20.0, 10000);
                    SetPlayerChatBubble(i, "Звонит телефон", COLOR_MAIN, 20.0, 10000);
                    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
                    return 1;
                }
            }
            SendError(playerid, "Вы не можете позвонить на данный номер, причин может быть несколько:");
            SendError(playerid, "1. Игрока с данным номером нет в игре;");
            SendError(playerid, "2. У игрока не выбран активный телефон с помощью команды /phone;");
        }
    }
    return true;
}

CMD:h(playerid, params[])
{
    if(!GetInventoryAmount(playerid, p_info[playerid][active_phone_id]))
    {
        SendError(playerid, "Вы не можете закончить разговор, причин может быть несколько:");
        SendError(playerid, "1. У Вас нет телефона;");
        SendError(playerid, "2. У Вас не выбран активный телефон с помощью команды /phone;");
        return 1;
    }

    if(!p_info[playerid][phone_number]) return SendError(playerid, "У Вас нет номера телефона.");

    new id = p_temp[playerid][calling];
    if(id == INVALID_PLAYER_ID)
        return SendError(playerid, "Вам никто не звонит.");

    p_temp[playerid][calling] = INVALID_PLAYER_ID;
    p_temp[id][calling] = INVALID_PLAYER_ID;

    if(p_temp[id][phone_talk] == 0 && !GetPVarInt(playerid, "EtherCalled"))
    {
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL,sizeof(STRING_GLOBAL), "UPDATE `phone_contacts` SET `MissedCalls` = `MissedCalls`+1 WHERE `NickTarget` = '%e' AND `NickPlayer` = '%s'",
        get_name(playerid), get_name(id));
        mysql_tquery(con_bd, STRING_GLOBAL);
    }

    SendAccess(playerid, "Вы закончили разговор с %s.", get_name(id));
    SendInfo(id, "%s закончил с Вами разговор.", get_name(playerid));

    if(p_temp[playerid][phone_talk] > 0)
    {
        SendInfo(playerid, "Время разговора %d сек.", p_temp[playerid][phone_talk]);
        SendInfo(id, "Время разговора %d сек.", p_temp[id][phone_talk]);
    }

    p_temp[id][phone_talk] = 0;
    p_temp[playerid][phone_talk] = 0;

    SetPlayerChatBubble(playerid, "Положил(-а) телефон", COLOR_MAIN, 20.0, 10000);

    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_STOPUSECELLPHONE);
    SetPlayerSpecialAction(id, SPECIAL_ACTION_STOPUSECELLPHONE);


    if(GetPVarInt(playerid, "EtherCalled")) DeletePVar(playerid, "EtherCalled");
    if(GetPVarInt(id, "EtherCalled")) DeletePVar(id, "EtherCalled");
    return true;
}
alias:h("hangup");


CMD:pdd(playerid, params[])
{
    STRING_GLOBAL[0] = EOS;
    strcat(STRING_GLOBAL, "<< 1. Общие правила >>\n\n");
    strcat(STRING_GLOBAL, "Обгон транспортного средства разрешен только с левой стороны,\n");
    strcat(STRING_GLOBAL, "при этом водители обязаны убедиться, что встречная полоса свободна на достаточном для обгона расстояние.\n");
    strcat(STRING_GLOBAL, "При ДТП водители обязаны позвонить в полицию, и дождаться ДПС\n\n");
    strcat(STRING_GLOBAL, "<< 2. Скорость движения >> \n\n");
    strcat(STRING_GLOBAL, "В переделах города разрешается движение транспортных средств со скоростью не более 50 км/ч.\n");
    strcat(STRING_GLOBAL, "В жилых зонах и на дворовых территориях не более 30 км/ч\n\n");
    strcat(STRING_GLOBAL, "<< 3. Остановка и стоянка >>\n\n");
    strcat(STRING_GLOBAL, "Остановка и стоянка транспортных средств разрешаются на правой стороне дороги на обочине.\n");
    strcat(STRING_GLOBAL, "В специальных отведенных для этого местах\n\n");
    strcat(STRING_GLOBAL, "<< 4. ДПС >> \n\n");
    strcat(STRING_GLOBAL, "При виде автомобиля с включенной сереной, водитель обязан сбавить скорость и прижаться к обочине.\n");
    strcat(STRING_GLOBAL, "Водитель обязан предъявить паспорт/лицензии, если тот попросил");
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Правила дорожного движения", STRING_GLOBAL, "Готово", "");

    /*new str_pdd[68];
    format(str_pdd, sizeof(str_pdd), "%s читает Правила Дорожного Движения.", get_name(playerid));
    ProxDetector(5.0, playerid, str_pdd, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);*/
    return 1;
}

CMD:p(playerid, params[])
{
    if(p_info[playerid][mute] > 0)
        return SendError(playerid, "У Вас блокировка чата.");
    if(p_temp[playerid][tGag] == true)
        return SendError(playerid, "У Вас кляп.");
    if(p_temp[playerid][calling] == INVALID_PLAYER_ID)
        return SendError(playerid, "Вам никто не звонит.");

    if(!GetInventoryAmount(playerid, p_info[playerid][active_phone_id]))
    {
        SendError(playerid, "Вы не можете начать разговор, причин может быть несколько:");
        SendError(playerid, "1. У Вас нет телефона;");
        SendError(playerid, "2. У Вас не выбран активный телефон с помощью команды /phone;");
        return 1;
    }

    if(!p_info[playerid][phone_number]) return SendError(playerid, "У Вас нет номера телефона.");

    new id = p_temp[playerid][calling];
    if(id == INVALID_PLAYER_ID) return 1;

    p_temp[id][calling] = playerid;
    p_temp[id][phone_talk] = 1;
    p_temp[playerid][phone_talk] = 1;

    if(GetPVarInt(playerid, "Ether"))
    {
        switch(p_info[playerid][news])
        {
            case RADIO_LS: CallNews[0]++;
            case RADIO_SF: CallNews[1]++;
            case RADIO_LV: CallNews[2]++;
        }
        SetPVarInt(id, "EtherCalled", p_info[playerid][news]);
    }

    SendAccess(playerid, "Вы приняли звонок от %s.", get_name(id));
    SendInfo(id, "%s ответил на Ваш звонок.", get_name(playerid));

    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
    SetPlayerChatBubble(playerid, "Ответил(-а) на звонок", COLOR_MAIN, 20.0, 10000);
    return 1;
}
alias:p("pickup");

CMD:taxi(playerid, params[]) return SendInfo(playerid, "Используйте: /call 12");

CMD:smoke(playerid, params[])
{
    if(RegisterPaintBall[playerid] == 2) return SendError(playerid, "Во время пейнтбола запрещено пользоваться сигаретами.");
    if(p_temp[playerid][cossack_robbers_register] == 2) return SendError(playerid, "Во время Казаков-разбойников запрещено пользоваться сигаретами.");
    if(player_lobby_status[playerid] == true) return SendError(playerid, "Находясь в лобби запрещено пользоваться сигаретами.");
    if(GetPlayerStatusCapture(playerid)) return SendError(playerid, "Пользоваться сигаретами во время захватов территорий и бизнесов запрещено.");
    if(GetInventoryAmount(playerid, 652) == 0) return SendError(playerid, "У Вас нет сигареты.");
    if(p_info[playerid][satiety] < 20) return SendError(playerid, "Сначала нужно поесть, иначе Вы отравитесь.");
    SendAccess(playerid, "Вы закурили сигарету.");
    SendInfo(playerid, "С помощью кнопки ALT продолжайте курение.");
    GivePlayerInventory(playerid, 652, -1);
    for(new i = 0; i < 2; i++) p_info[playerid][cigarette_status][i] = 1;
    if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
    SetPlayerAttachedObject(playerid, 1, 1485, 6, 0.015000, -0.035000, 0.006998, -4.199997, 2.700002, 15.899977, 1.000000, 1.000000, 1.000000);
    ApplyAnimation(playerid, "SMOKING", "M_smk_drag", 4.1, 0, 0, 0, 0, 0, 1);
    SetPlayerChatBubble(playerid, "+ 5 HP", COLOR_MAIN, 20.0, 10000);
    GameTextForPlayer(playerid, "~b~+ 5 hp", 1000, 1);
    SendInfo(playerid, "Здоровье пополнено на 5.");
    p_info[playerid][pHealth] += 5.0;
    SetPlayerHealth(playerid, p_info[playerid][pHealth]);
    if(p_info[playerid][pHealth] > 100.0)
    {
        p_info[playerid][pHealth] = 100.0;
        SetPlayerHealth(playerid, 100.0);
    }

    if(p_info[playerid][Disease][2] == 3 && GetPlayerDisease(playerid, 3, 10, 1) == 1) // Шанс 10 процентов;
    {
        p_info[playerid][Disease][3]++;
        SendInfo(playerid, "У Вас появилось новое заболевание - рак легких %d степени.", p_info[playerid][Disease][3]);
    }

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "Сигареты в правом кармане.");
        MeAction(playerid, "засунул правую руку в карман, после чего нащупав сигареты с зажигалкой достал их");
        MeAction(playerid, "быстрым движением правой руки зажег зажигалку и подкурил сигарету");
        DoAction(playerid, "Подкуренная сигарета в правой руке.");
    }
    return 1;
}

CMD:healme(playerid, params[])
{
    if(RegisterPaintBall[playerid] == 2) return SendError(playerid, "Во время пейнтбола запрещено пользоваться аптечкой.");
    if(p_temp[playerid][cossack_robbers_register] == 2) return SendError(playerid, "Во время Казаков-разбойников запрещено пользоваться аптечкой.");
    if(player_lobby_status[playerid] == true) return SendError(playerid, "Находясь в лобби запрещено пользоваться аптечкой.");
    if(GetPlayerStatusCapture(playerid)) return SendError(playerid, "Пользоваться аптечкой во время захватов территорий и бизнесов запрещено.");
    if(GetInventoryAmount(playerid, 632) == 0) return SendError(playerid, "У Вас нет аптечки.");
    if(p_info[playerid][satiety] < 20) return SendError(playerid, "Сначала нужно поесть, иначе Вы отравитесь.");
    if(p_temp[playerid][SparringID] != -1) return SendError(playerid, "В спарринге не доступно.");
    SetPlayerChatBubble(playerid, "+ 60 HP", COLOR_MAIN, 20.0, 10000);
    GameTextForPlayer(playerid, "~b~+ 60 hp", 1000, 1);
    SendAccess(playerid, "Вы воспользовались аптечкой.");
    SendInfo(playerid, "Здоровье пополнено на 60.");
    //SetPVarInt(playerid, "HEAL", GetPVarInt(playerid, "HEAL") -1);
    GivePlayerInventory(playerid, 632, -1);
    GetPlayerHealth(playerid, p_info[playerid][pHealth]);
    p_info[playerid][pHealth] += 60.0;
    if(p_info[playerid][pHealth] > 100.0) p_info[playerid][pHealth] = 100.0;
    SetPlayerHealth(playerid, p_info[playerid][pHealth]);
    ApplyAnimation(playerid,"ped","gum_eat",4.0,0,0,0,0,0,1);

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "Баночка с обезболивающим в кармане.");
        MeAction(playerid, "засунул правую руку в карман, после чего нащупав банку достал ее");
        MeAction(playerid, "открыл и высыпал пару таблеток на ладонь, после чего закинул их в рот");
        DoAction(playerid, "Таблетка во рту.");
    }
    return 1;
}

CMD:mask(playerid, params[])
{
    if(p_temp[playerid][UseMaskFix] == 1) return maskOFF(playerid);
    if(p_info[playerid][p_settings][PACIFIST_MODE])
        return SendError(playerid, "В режиме пацифиста недоступно. Подробней: /pacifistinfo.");
    if(GetInventoryAmount(playerid, 633) == 0) return SendError(playerid, "У Вас нет маски.");
    SetPlayerChatBubble(playerid, "Надел(-а) маску", COLOR_MAIN, 20.0, 10000);
    ApplyAnimation(playerid, "SHOP", "ROB_Shifty", 4.0, 0, 0, 0, 0, 0, 1);
    SetPlayerColor(playerid, 0x4F4F4F00);
    GivePlayerInventory(playerid, 633, -1);
    p_temp[playerid][UseMaskFix] = 1;
    p_temp[playerid][UseMaskTimerFix] = timestamp + 600;
    SendAccess(playerid, "Вы надели маску.");
    SendInfo(playerid, "Ваше местоположение на GPS навигаторе скрыто на 10 мин.");

    if(p_info[playerid][p_settings][ROLEPLAY] == 1)
    {
        DoAction(playerid, "Маска лежит в кармане.");
        MeAction(playerid, "засунул правую руку в карман, после чего нащупав маску достал ее и одел на голову");
    }
    return 1;
}

maskOFF(playerid)
{
    if(!p_temp[playerid][UseMaskFix]) return 1;
    p_temp[playerid][UseMaskFix] = 0;
    SendInfo(playerid, "С Вас снята маска.");
    SetPlayerColor(playerid,  fraction_color[p_info[playerid][fwork] == true ? p_info[playerid][member] : 0]);
    return 1;
}

