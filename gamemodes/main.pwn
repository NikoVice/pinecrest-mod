            if(p_temp[playerid][market_arend] != -1) return SendError(playerid, "� ��� ��� ���� ������������ �������."), ClearPlayerMarketUse(playerid);
            if(p_info[playerid][exchangePartner] != INVALID_PLAYER_ID) return SendError(playerid, "� ��� �� ����������� �����.");
            new idx = p_temp[playerid][market_buy_idx];
            if(MarketInfo[idx][mOwnerID] != INVALID_PLAYER_ID) return SendError(playerid, "������ ������� ��� ����� ����������."), ClearPlayerMarketUse(playerid);
            p_temp[playerid][market_arend] = idx;
            MarketInfo[idx][mOwnerID] = playerid;
            SendAccess(playerid, "�� ���������� �������.");
            SendInfo(playerid, "������������� �����: /market");
            UpdateMarket(idx);

            for(new i = MAX_MARKET_PLAYER_USE-1; i != -1; i--)
            {
                if(MarketInfo[idx][mPlayerUse][i] != INVALID_PLAYER_ID)
                    MarketInfo[idx][mPlayerUse][i] = INVALID_PLAYER_ID;
            }
            return 1;
        }
