            new i = AirDropUseItems[playerid], idx = AirDropUse[playerid];
            if(!response) return ShowAirDropContent(playerid, idx), AirDropUseItems[playerid] = -1;
            if(strlen(inputtext) == 0) return SendError(playerid, "Вы ничего не ввели."), ShowAirDropContent(playerid, idx), AirDropUseItems[playerid] = -1;
            new count = strval(inputtext);
            if(count < 1 || count > AirDropInfo[idx][AirDropContent][i]) return SendError(playerid, "Кол-во содержимого должно быть не менее 1 и не более %d.", AirDropInfo[idx][AirDropContent][i]), ShowAirDropContent(playerid, idx), AirDropUseItems[playerid] = -1;
            if(!GivePlayerInventory(playerid, i + TRANSFER_ITEMS, count)) return ShowAirDropContent(playerid, idx), AirDropUseItems[playerid] = -1;
            AirDropInfo[idx][AirDropContent][i] -= count;
            SendInfo(playerid, "Вы взяли %d \"%s\" из AirDrop.", count, ItemsInfo[i + TRANSFER_ITEMS][iName]);
            ShowAirDropContent(playerid, idx);
