                    if(p_info[playerid][cash] < 50000) return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");
                    if(strequals(p_info[seller_id][Partner], get_name(playerid))) return SendError(playerid, "�� ��� ������.");
                    SetPlayerMoney(seller_id, -50000, true, "�������");
                    SetPlayerMoney(playerid, -50000, true, "�������");

                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "��������! "W"%s [%d] � %s [%d] ������ ��� � ����!", get_name(playerid), playerid, get_name(seller_id), seller_id);
                    SendMesAll(0xFFD700FF, STRING_GLOBAL);

                    strmid(p_info[playerid][Partner], get_name(seller_id), 0, strlen(get_name(seller_id)));
                    strmid(p_info[seller_id][Partner], get_name(playerid), 0, strlen(get_name(playerid)));

                    SendAccess(seller_id, "%s ��������(-��/-���) �� �������������� �� 50000$.", get_name(playerid));
                    SendInfo(playerid, "�� ����������� �� �������������� � %s �� 50000$.", get_name(seller_id));
                    return 1;
                }
                default: return SendError(playerid, "��� �����������.");
            }

            return 1;
        }
        case D_BL_MENU:
