alias:fraction("fr", "fract", "lmenu", "leadermenu");

forward leave_offline(playerid);
public leave_offline(playerid)
{
    new rows, members, rangs, mysql_player_id;
    cache_get_row_count(rows);
    if(!rows) return SendError(playerid, "������ �� �������.");
    cache_get_value_name_int(0, "id", mysql_player_id);
    cache_get_value_name_int(0, "member", members);
    cache_get_value_name_int(0, "rang", rangs);
    if(p_info[playerid][rang] <= rangs) return SendError(playerid, "� ��� ������� ��������� ���� �� �������.");
    if(p_info[playerid][member] != members) return SendError(playerid, "����� �� ������� �� �������.");

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `log_fraction` (`PlayerID`, `Member`, `Rang`, `Type`, `Reason`) VALUES (%d, %d, %d, '1', '������� ����')", mysql_player_id, members, rangs);
    mysql_tquery(con_bd, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `leader` = 0, `member` = 0, `rang` = 0, `fskin` = 0, `spawn` = 0, `fwork` = 0 WHERE `id` = %d", mysql_player_id);
    mysql_tquery(con_bd, STRING_GLOBAL);

    Log(LOG_player, INFO, "[%d] ��� ������ %s[%d](%s %s) �� %s. �������: ������� | #Fraction",
        mysql_player_id, get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", GetFractionName(p_info[playerid][member]));

    Log(LOG_player, INFO, "%s[%d](%s %s) ������ [%d] �� %s. �������: ������� | #Fraction",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", mysql_player_id, GetFractionName(p_info[playerid][member]));

    SendAccess(playerid, "�� ������� ������ �� �������.");
    return true;
}
CMD:invite(playerid, params[])
{
    if(p_info[playerid][rang] < 9) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");

    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "�����������: /invite [id ������]");
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "����� �� ������.");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "����� ������� ������ �� ���.");
    if(p_info[params[0]][warn_time] > timestamp) return SendError(playerid, "� ������ ���� ��������������.");
    if(GetPVarInt(params[0],"BoneStol_ID")) return 1;
    if(p_temp[params[0]][bl_fraction][p_info[playerid][member]] == true) return SendError(playerid, "����� � ������ ������ �������.");
    if(p_info[params[0]][level] < 2) return SendError(playerid, "� ������ ��� 2 ������.");
    switch(p_info[playerid][member])
    {
        case POLICE_LS, POLICE_SF, POLICE_LV, POLICE_RC:
        {
            if(!p_info[params[0]][billet_army]) SendInfo(playerid, "��������������, � ������� ������ ��� �������� ������.");
        }
        case FBI_TEAM:
        {
            if(!p_info[params[0]][billet_cop]) SendInfo(playerid, "��������������, � ������� ������ ��� ������������ ������.");
        }
        default: if(p_info[params[0]][member] != 0) return SendError(playerid, "����� ������� �� �������.");
    }
    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, ""W"�� ������ ���������� "I"%s "W"�������� � ������� \"%s\"", get_name(params[0]), GetFractionName(p_info[playerid][member]));
    ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"������� � �������", STRING_GLOBAL, "�����", "������");
    SetOfferData(playerid, params[0], OFFER_ID_INVITE);
    return true;
}
CMD:uninvite(playerid, params[])
{
    if(sscanf(params, "us[144]", params[0], params[1])) return SendInfo(playerid, "�����������: /uninvite [id ������] [�������]");
    if(params[0] == playerid) return SendError(playerid, "�� ����� ���� ID.");
    if(params[0] == INVALID_PLAYER_ID) return SendError(playerid, "����� �� ������.");
    if(p_info[playerid][member] == MAYOR_LS && p_info[params[0]][member] != MAYOR_LS)
    {
        if(p_info[params[0]][leader] != 0) return SendError(playerid, "����� ����� �������.");
        switch(p_info[playerid][rang])
        {
            case 8:
            {
                if(GetFactionCategory(p_info[params[0]][member]) != FACTION_CATEGORY_PD)
                    return SendError(playerid, "����� �� ������� � �������.");
            }
            case 7:
            {
                if(GetFactionCategory(p_info[params[0]][member]) != FACTION_CATEGORY_ARMY)
                    return SendError(playerid, "����� �� ������� � �����.");
            }
            case 6:
            {
                if(GetFactionCategory(p_info[params[0]][member]) != FACTION_CATEGORY_MEDIC)
                    return SendError(playerid, "����� �� ������� � ��������.");
            }
            case 5:
            {
                if(GetFactionCategory(p_info[params[0]][member]) != FACTION_CATEGORY_SNN)
                    return SendError(playerid, "����� �� ������� � �����������.");
            }
            default: return SendError(playerid, "�� �� �������.");
        }
    }
    else
    {
        if(p_info[playerid][rang] < 8) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
        if(p_info[params[0]][member] != p_info[playerid][member]) return SendError(playerid, "����� �� ������� �� �������.");
        if(p_info[params[0]][leader] == p_info[playerid][member]) return 1;
        if(p_info[params[0]][rang] >= p_info[playerid][rang]) return 1;
    }
    if(AdvertisingCheck(params[1])) return AdvertisingPunishment(playerid, params[1], 0);
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "�� ������� %s [%d] �� \"%s\". �������: %s", get_name(params[0]), params[0], GetFractionName(p_info[playerid][member]), params[1]);
    SendAccess(playerid, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s [%d] ������ ��� �� \"%s\". �������: %s", get_name(playerid), playerid, GetFractionName(p_info[playerid][member]), params[1]);
    SendInfo(params[0], STRING_GLOBAL);

    Log(LOG_player, INFO, "%s[%d](%s %s) ��� ������ %s[%d](%s %s) �� %s. �������: %s | #Fraction",
        get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", GetFractionName(p_info[playerid][member]), params[1]);

    Log(LOG_player, INFO, "%s[%d](%s %s) ������ %s[%d](%s %s) �� %s. �������: %s | #Fraction",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        get_name(params[0]), p_info[params[0]][ID], p_temp[params[0]][session_IP], IsPlayerMobile(params[0]) ? "Mobile": "PC", GetFractionName(p_info[playerid][member]), params[1]);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `log_fraction` (`PlayerID`, `Member`, `Rang`, `Type`, `Reason`) VALUES (%d, %d, %d, '1', '%s')",
    p_info[params[0]][ID], p_info[params[0]][member], p_info[params[0]][rang], params[1]);
    mysql_tquery(con_bd, STRING_GLOBAL);

    if(GetPlayerStatusCapture(params[0]))
            HideTextDrawForPlayer(params[0], TD_ID_CAPTURE);

    Iter_Remove(gFactionPlayers[p_info[params[0]][member]], params[0]);
    p_info[params[0]][member] = 0;
    p_info[params[0]][rang] = 0;
    p_info[params[0]][fskin] = 0;
    Iter_Add(gFactionPlayers[p_info[params[0]][member]], params[0]);
    if(GetFreeSlotHouse(params[0]) != p_info[params[0]][house_slots] || p_info[params[0]][key_h_rent] != INVALID_HOUSE_ID) p_info[params[0]][spawn] = 2;
    else p_info[params[0]][spawn] = 0;
    p_info[params[0]][fwork] = false;
    SetPlayerSkinEx(params[0]);
    SetPlayerColor(params[0], fraction_color[0]);
    if(GetFactionCategory(p_info[params[0]][member]) == FACTION_CATEGORY_PD || GetFactionCategory(p_info[params[0]][member]) == FACTION_CATEGORY_FBI)
        p_temp[params[0]][StatusOnDuty] = 0;
    save_player(params[0]);
    f_ResetPlayerWeapons(params[0]);

    /*
    p_info[params[0]][ftop_gkills_week] = 
    p_info[params[0]][ftop_gdeaths_week] = 0;
    p_info[params[0]][ftop_gdamagegive_week] = 
    p_info[params[0]][ftop_gdamagetake_week] = 0;
    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `ftop_gkills_week` = 0, `ftop_gdeaths_week`  = 0, `ftop_gdamagegive_week` = 0.0, `ftop_gdamagetake_week` = 0.0 WHERE `id` = %d", p_info[params[0]][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL);
    */
    return true;
}
CMD:offuninvite(playerid, params[])
{
    if(p_info[playerid][member] == 0 || p_info[playerid][rang] < 9) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(isnull(params) || strlen(params) > 20) return SendInfo(playerid, "�����������: /offuninvite [�������]");
    if(GetPlayerID(params) != INVALID_PLAYER_ID) return SendError(playerid, "����� � ����.");
    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id`, `member`, `rang` FROM `accounts` WHERE `name` = '%e' LIMIT 1", params);
    mysql_tquery(con_bd, STRING_GLOBAL, "leave_offline", "i", playerid);
    return true;
}

CMD:leavejob(playerid, params[])
{
    if(p_info[playerid][job] <= 0) return SendError(playerid, "�� ����� �� ���������.");
    if(p_temp[playerid][Work_ID] > NONE_WORK) return SendError(playerid, "�� �� ��������� ������� ���� �� ������� ������.");
    SendAccess(playerid, "�� ��������� � ������.");
    Iter_Remove(gJobPlayers[p_info[playerid][job]], playerid);
    p_info[playerid][job] = 0;
    return 1;
}

CMD:leave(playerid, params[])
{
