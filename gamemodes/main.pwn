CMD:en(playerid)
{
    if(!IsPlayerInAnyVehicle(playerid) || GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
    new vehicleid = GetPlayerVehicleID(playerid),
        vehmodel = GetVehicleModelEx(vehicleid);
    if(vehmodel-400 < 0) return 1;
    if(GetVehicleData(vehmodel, E_VD_TYPE) == VEHICLE_STATE_CAR && p_info[playerid][Lic][LIC_CAR] != 1 && !GetPVarInt(playerid, "EKZAMEN")) return 1;
    if(GetVehicleData(vehmodel, E_VD_TYPE) == VEHICLE_STATE_MOTO && p_info[playerid][Lic][LIC_MOTO] != 1 && !GetPVarInt(playerid, "EKZAMEN")) return 1;
    if(veh_info[vehicleid][v_loading] != 0 || veh_info[vehicleid][v_pickup] != -1)
        return SendError(playerid, "��������� ��������/��������.");
    new Float:new_vhealth;
    GetVehicleHealth(vehicleid, new_vhealth);
    if(new_vhealth <= 300.0 && veh_info[vehicleid][v_engine] == 0)
    {
        SetVehicleHealth(vehicleid, 300.0);
        SetVehicleParamsVEx(vehicleid, false, veh_info[vehicleid][v_light], alarm, veh_info[vehicleid][v_lock], bonnet, boot, objective);
        SendError(playerid, "��������� ������������� �������� ������, �������� ��������.");
        return 1;
    }
    if(veh_info[vehicleid][v_timer_engine_off] > 0) return SendError(playerid, "������������ �������� ����������������. ������� ��������� ������ ��� %d ���.", veh_info[vehicleid][v_timer_engine_off]);
    if(GetSlotVehicleMarket(veh_info[vehicleid][v_mysql_id]) != -1) return SendError(playerid, "�������������� � ������������ �������� ����������, ��� ��������� �� ���������.");
    if(veh_info[vehicleid][v_npoType] == NPO_ROBBERY_HOUSE && p_temp[playerid][rob_house_idx] != veh_info[vehicleid][v_rob_house_idx]) return SendError(playerid, "�� �� ���������� � ���������� ����, �������� ����������� ������ ������������ ��������."), RemovePlayerFromVehicle(playerid);
    if(veh_info[vehicleid][v_npoType] == NPO_ROBBERY_BANK && p_temp[playerid][rob_bank_idx] != veh_info[vehicleid][v_rob_bank_idx]) return SendError(playerid, "�� �� ���������� � ���������� �����, �������� ����������� ������ ������������ ��������, ���� �� ��������� ���������."), RemovePlayerFromVehicle(playerid);
    if(veh_info[vehicleid][v_npoType] == NPO_ROBBERY_FUEL && p_temp[playerid][rob_fuel_idx] != veh_info[vehicleid][v_rob_fuel_idx]) return SendError(playerid, "�� �� ���������� � ���������� ���, �������� ����������� ������ ������������ ��������, ���� �� ��������� ���������."), RemovePlayerFromVehicle(playerid);
    if(veh_info[vehicleid][v_npoType] == NPO_JOB && veh_info[vehicleid][v_npoId] == JOB_TRAIN && p_temp[playerid][rented_veh] == INVALID_VEHICLE_ID) return SendError(playerid, "�� �� ������ ������� ����."), RemovePlayerFromVehicle(playerid);
    if(veh_info[vehicleid][v_npoType] == NPO_JOB && veh_info[vehicleid][v_npoId] == JOB_TRAM && p_temp[playerid][rented_veh] == INVALID_VEHICLE_ID) return SendError(playerid, "�� �� ������ ������� ����."), RemovePlayerFromVehicle(playerid);
    if(veh_info[vehicleid][v_npoType] == NPO_PUB_SALON) return 1;
    if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_VELO_MOPED) return 1;

    if((veh_info[vehicleid][v_npoType] == NPO_PLAYERCAR || veh_info[vehicleid][v_npoType] == NPO_ARENDCAR || veh_info[vehicleid][v_npoType] == NPO_TEMPCAR || veh_info[vehicleid][v_npoType] == NPO_ROBBERY_HOUSE || veh_info[vehicleid][v_npoType] == NPO_ROBBERY_BANK || veh_info[vehicleid][v_npoType] == NPO_ROBBERY_FUEL || veh_info[vehicleid][v_npoType] == NPO_EVENTCAR) && veh_info[vehicleid][v_npoId] == NPO_NONE)
    {
        if(IsPlayerOwnerVehicle(playerid, vehicleid) ||
            veh_info[vehicleid][v_used_key_ID] == playerid ||
            veh_info[vehicleid][v_rented_ID] == p_info[playerid][ID] ||
            veh_info[vehicleid][v_rob_house_idx] != -1 && veh_info[vehicleid][v_rob_house_idx] == p_temp[playerid][rob_house_idx] ||
            veh_info[vehicleid][v_rob_bank_idx] != -1 && veh_info[vehicleid][v_rob_bank_idx] == p_temp[playerid][rob_bank_idx] ||
            veh_info[vehicleid][v_rob_fuel_idx] != -1 && veh_info[vehicleid][v_rob_fuel_idx] == p_temp[playerid][rob_fuel_idx] ||
            (p_temp[playerid][Work_ID] == THEFT_CAR_WORK && TheftCarIDx[playerid] != -1 && TheftCarVehicle[TheftCarIDx[playerid]][tcvVehicle] == vehicleid)) { }
        else return SendError(playerid, "� ��� ��� ������ �� ����� ������������� ��������.");
    }
    if(veh_info[vehicleid][v_npoType] == NPO_FAMILY && veh_info[vehicleid][v_family_id] != -1 && GetPlayerFamilyID(playerid) != veh_info[vehicleid][v_family_id]) return SendError(playerid, "������������ �������� ����������� ����� \"%s\".", FamilyData[veh_info[vehicleid][v_family_id]][fName]);
    if(veh_info[vehicleid][v_loading]) return SendError(playerid, "� ������������ �������� ������ �������� ��� ���������.");
    if(veh_info[vehicleid][v_npoType] == NPO_FACTION && (veh_info[vehicleid][v_npoId] != p_info[playerid][member] &&
        p_info[playerid][member] != MAYOR_LS && GetPlayerSkin(playerid) != 287))
            return SendError(playerid, "� ��� ��� ������ �� ����� ������������� ��������.");

    if(veh_info[vehicleid][v_engine] == 0)
    {
        if((GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_MOTO || GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_CAR) && veh_info[vehicleid][v_fuel] <= 0.0) return SendError(playerid, "� ������������ �������� ��� �������.");
        if((veh_info[vehicleid][v_owner_id] != INVALID_MYSQL_ID || veh_info[vehicleid][v_family_id] != -1) && veh_info[vehicleid][v_premium] == 0)
        {
            if(GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_MOTO || GetVehicleData(GetVehicleModelEx(vehicleid), E_VD_TYPE) == VEHICLE_STATE_CAR)
            {
                if(veh_info[vehicleid][v_details][0] <= 5.0)
                {
                    if(random(3) != 2) return SendInfo(playerid, "�� �� ������ ������� ������������ ��������. �������� ������� ��� ���������� ��� ���.");
                }
                veh_info[vehicleid][v_details][0] -= 0.2;
                if(veh_info[vehicleid][v_details][0] < 0.0) veh_info[vehicleid][v_details][0] = 0.0;
            }
        }
        PlayerPlaySound(playerid, 31810, 0.0, 0.0, 0.0);
        MeAction(playerid, "�����(-�) ���������");
        veh_info[vehicleid][v_engine] = 1;
    }
    else if(veh_info[vehicleid][v_engine] == 1)
    {
        PlayerPlaySound(playerid, 31810, 0.0, 0.0, 0.0);
        MeAction(playerid, "��������(-�) ���������");
        veh_info[vehicleid][v_engine] = 0;
    }
    SetVehicleParamsVEx(vehicleid, veh_info[vehicleid][v_engine], veh_info[vehicleid][v_light], alarm, veh_info[vehicleid][v_lock], bonnet, boot, objective);
    OnPlayerUpdateVehicleInfo(playerid, SPEEDO_ENGINE);
    return 1;
}

CMD:me(playerid, params[])
{
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "� ��� ����.");
    if(p_info[playerid][mute] > 0) return SendError(playerid, "� ��� ���������� ����.");
    if(GetPVarInt(playerid,"BoneStol_ID")) return 1;
    if(isnull(params)) return SendInfo(playerid, "�����������: /me [�����]");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);
    MeAction(playerid, params);
    STRING_GLOBAL[0] = EOS;
    f(STRING_GLOBAL, "%s[%d] %s", get_name(playerid), playerid, params);
    SetPlayerChatBubble(playerid, STRING_GLOBAL, COLOR_MAIN, 20.0, 10000);
    return true;
}

CMD:do(playerid, params[])
{
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "� ��� ����.");
    if(p_info[playerid][mute] > 0) return SendError(playerid, "� ��� ���������� ����.");
    if(GetPVarInt(playerid,"BoneStol_ID")) return 1;
    if(isnull(params)) return SendInfo(playerid, "�����������: /do [�����]");
    if(strlen(params) > 64) return SendInfo(playerid, "�����������: /do [�����]");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);
    DoAction(playerid, params);
    return 1;
}

CMD:ab(playerid, params[])
{
    if(p_temp[playerid][tGag] == true) return SendError(playerid, "� ��� ����.");
    if(p_info[playerid][mute] > 0) return SendError(playerid, "� ��� ���������� ����.");
    if(GetPVarInt(playerid,"BoneStol_ID")) return 1;
    if(isnull(params)) return SendInfo(playerid, "�����������: /ab [�����]");
    if(strlen(params) > 128) return SendInfo(playerid, "�����������: /ab [�����]");
    if(AdvertisingCheck(params)) return AdvertisingPunishment(playerid, params, 1);

    if(sscanf(params, "s[128]", params[0]))
    return SendInfo(playerid, "�����������: /ab [�����]");

    f(STRING_GLOBAL, "> (( %s[%d]: %s ))", get_name(playerid), playerid, params[0]);

    SendClientMessage(playerid, 0xffaadd, STRING_GLOBAL);

    f(STRING_GLOBAL, "(( %s ))", params[0]);
    SetPlayerChatBubble(playerid, STRING_GLOBAL, COLOR_MAIN, 20.0, 10000);
    return 1;
}

