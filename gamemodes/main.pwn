SetCameraForPlayer(playerid, id_camera, Float:distanse = 8.5, Float:camera_Z = 3.0, isMove = false, type = TYPE_UPDATE_CAMERA_INVALID)
{
    new Float:x, Float:y, Float:z, Float:a,
        Float:x2, Float:y2;

    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER || GetPlayerState(playerid) == PLAYER_STATE_PASSENGER)
    {
        new vehicleid = GetPlayerVehicleID(playerid);
        GetVehiclePos(vehicleid, x, y, z);
        GetVehicleZAngle(vehicleid, a);
    }
    else
    {
        GetPlayerPos(playerid, x, y, z);
        GetPlayerFacingAngle(playerid, a);
    }

    new oldA = id_camera;

    if(type == TYPE_UPDATE_CAMERA_RIGHT)
    {
        id_camera = id_camera - 30;
        if(id_camera < 0) id_camera += 360;
    }
    else if(type == TYPE_UPDATE_CAMERA_LEFT)
    {
        id_camera = id_camera + 30;
        if(id_camera > 360) id_camera -= 360;
    }

    x2 = x - distanse * floatsin(a-id_camera, degrees);
    y2 = y + distanse * floatcos(a-id_camera, degrees);

    if(isMove)
    {
        new Float:OldX, Float:OldY;

        OldX = x - distanse * floatsin(a-oldA, degrees);
        OldY = y + distanse * floatcos(a-oldA, degrees);
        InterpolateCameraPos(playerid, OldX, OldY, z+camera_Z, x2, y2, z+camera_Z, 500);
        InterpolateCameraLookAt(playerid, x, y, z, x, y, z, 500);
    }
    else
    {
        SetPlayerCameraPos(playerid, x2, y2, z+camera_Z);
        SetPlayerCameraLookAt(playerid, x, y, z);
    }
    p_temp[playerid][camera_id] = id_camera;
}
//=========================
CMD:resetevent(playerid)
{
    if(!FD(playerid) || p_info[playerid][admin] < 10)
        return 1;
    ClearEvent();
    return 1;
}

ClearEvent()
{
    mysql_tquery(con_bd,
        "UPDATE `accounts` SET `gift_promocode_status` = 0, `gift_promocode_time` = 0, `gift` = 0, `gift_check` = 0, `gift_idx` = 0, `event_quest_id` = 0, `event_quest_stage` = 0", "");
}
//=========================

this::CheckedIsPC(playerid)
{
    if(IsPlayerMobile(playerid))
    {
        printf("CHEAT_LOG: not PC - %s", get_name(playerid));
        p_temp[playerid][mobile_version] = -1;

        new nick_name[MAX_PLAYER_NAME];
        f(nick_name, "%s%s[PC]", get_name(playerid));
        SetPlayerName(playerid, nick_name);
    }
    p_temp[playerid][is_mobile] = false;
    
    return 1;
}

ShowDialogAraSellItems(playerid, slot_id)
{
    STRING_GLOBAL[0] = EOS;
    new itemID = InventoryPlayer[playerid][slot_id][inv_item_id],
        dialog_stype = DIALOG_STYLE_MSGBOX;
    if(ItemsInfo[itemID][iType] == TYPE_ITEMS_INVENTORY)
    {
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Введите кол-во \"%s\" цена за 1шт %d$:", ItemsInfo[itemID][iName], ItemsInfo[itemID][iStateCost]);
        dialog_stype = DIALOG_STYLE_INPUT;
    }
    else if(ItemsInfo[itemID][iType] == TYPE_ITEMS_ACCESSORIES ||
        ItemsInfo[itemID][iType] == TYPE_ITEMS_SKINS ||
        ItemsInfo[itemID][iType] == TYPE_ITEMS_VEHICLE_TUNE)
    {
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Стоимость \"%s\" за 1 шт. %d$", ItemsInfo[itemID][iName], ItemsInfo[itemID][iStateCost]);
    }
    else return SendError(playerid, "Другие виды предметов пока не разработаны.");
    ShowPlayerDialog(playerid, D_ARA_SELL_ITEM, dialog_stype, ""I"Настройки товара", STRING_GLOBAL, "Далее", "Отмена");
    return 1;
}

Google_ShowMainPanel(playerid)
{
    if(strlen(p_info[playerid][google_code]) < 5)
    {
        if(!IsMailConfirmed(playerid))
        {
            ShowPlayerSettings(playerid);
            return SendError(playerid, "Для начала необходимо подтвердить E-Mail.");
        }
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "{"#cLIGHTRED"}ВАЖНО! ПРОЧИТАТЬ ДО КОНЦА!"W"\n\n\
            1. Нажав \"Далее\" мы отправим секретный ключ на вашу почту, его необходимо записать или сохранить, восстановить его {"#cLIGHTRED"}нельзя."W"\n\n\
            2. Включаем телефон, заходим в Play Market, Apple Store или Microsoft Store в зависимости от Вашей операционной системы.\n\n\
            3. Вводим в поиск \"Authenticator\" и скачиваем его.\n\n\
            4. Открываем \"Authenticator\" и нажимаем на плюсик (+) или \"ввести код\".\n\n\
            5. Вводим секретный ключ, который необходимо было записать или сохранить.\n\
            {33CC66}Информация:"W" Можно вводить любое имя, оно никак не влияет на процесс защиты. В поле код или секретный ключ вводим\n\
            секретный ключ, который необходимо было записать или сохранить.\n\n\
            6. Далее подтверждаем и сохраняем.\n\n\
            7. Теперь при входе на сервер или настройки \"Google Authenticator\" необходимо вводить код из приложения.\n\
            {33CC66}Информация:"W" Это несколько цифр меняющихся каждые 30 секунд в меню приложения.");
        ShowPlayerDialog(playerid, D_GOOGLE_AUTH_CREATE, DIALOG_STYLE_MSGBOX, ""I"Google Authenticator", STRING_GLOBAL, "Далее", "Отмена");
    }
    else 
    {
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL,sizeof(STRING_GLOBAL), "{00FF7F}» {ffffff}Тип: {0099CC}%s\n{00FF7F}» {ffffff}Сменить тип защиты\n{ff0000}» {ffffff}Отключить привязку", p_info[playerid][google_auth] == 0 ? "Запрашивать всегда" : "Запрашивать при смене IP адреса");
        ShowPlayerDialog(playerid, D_GOOGLE_AUTH_MAIN_PANEL, DIALOG_STYLE_LIST, ""I"Защита Google", STRING_GLOBAL, "Далее", "Отмена");
    }
    return 1;
}
