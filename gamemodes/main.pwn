            f(STRING_GLOBAL, ""W"\
            �������� �������: %s\n\
            ��� �������: %s\n\n\
            ������� ������: ������\n\
            ���� ������ ������ ���� ������ ������� �� 10 ���������.\n\
            ���� ���� ������ ��������, ��� �������� 90 ��������� �� ����� ������.\n\n\
            �� ����� ��������: %d ���(-�/-��)\n\n\
            ������� ������:", b_info[b][_name], bizz_type_name[b_info[b][_tip]], b_info[b][b_auction_time]);//, b_info[b][b_auction_bet]);
            ShowPlayerDialog(playerid, D_AUCTION_BIZZ_BET, DIALOG_STYLE_INPUT, ""I"������� ��������", STRING_GLOBAL, "�����", "GPS");
            return 1;
        }
        case D_AUCTION_HOUSE:
        {
            if(!response) return 1;
            if(!(0 <= listitem <= 30)) return SendError(playerid, "����� ������� ����� ������.");
            new h = p_temp[playerid][p_listitem][listitem];
            p_temp[playerid][p_listitem][listitem] = -1;
            p_temp[playerid][p_listitem_int] = h;
            if(h > totalhouses) return 1;
            if(h == INVALID_HOUSE_ID) return 1;
            if(h_info[h][h_auction_bet] == 0) return 1;
            if(h_info[h][h_delete] == 1) return 1;
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, ""W"\
