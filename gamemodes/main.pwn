                    if(mafia(playerid) || gang(playerid) || biker(playerid)) strcat(STRING_GLOBAL, ""I"[10]"W" �������/������� �����\t"I"[9+]\n");
                    if(gang(playerid) != 0) strcat(STRING_GLOBAL, ""I"[11]"W" �������/������� ������� �����\t"I"[9+]\n");
                    //if(gang(playerid) != 0 && DrugDenInfo[ddOwner] == p_info[playerid][member]) strcat(STRING_GLOBAL, ""I"[12]"W" ��������� ����������\t"I"[10+]");
                    if(GetFactionType(p_info[playerid][member]) == FACTION_TYPE_SNN)
                    {
                        strcat(STRING_GLOBAL, ""I"[10]"W" ������ ���\t"I"[10+]\n");
                        strcat(STRING_GLOBAL, ""I"[11]"W" ��������� ������\t"I"[10+]\n");
                        strcat(STRING_GLOBAL, ""I"[12]"W" �������/������� ������� �����\t"I"[9+]\n");
                    }
                    ShowPlayerDialog(playerid, D_LEADER_MENU, DIALOG_STYLE_TABLIST_HEADERS, "���� ����������", STRING_GLOBAL, "�����", "������");
                }
                case 1: callcmd::members(playerid, "/0");
