                    if(!IsPlayerInRangeOfPoint(playerid, 25.0, b_info[b][b_enter][0], b_info[b][b_enter][1], b_info[b][b_enter][2])) return SendError(playerid, "�� ������� ������ �� �������.");
                    if(GardenInfo[idx][gBizIDx] != b) return SendError(playerid, "�� �� ������ ������� ������ ������. �������: ������ �� ��������� �� ����� ��������.");
                }
