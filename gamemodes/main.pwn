CMD:medcard(playerid, params[])
{
    if(!p_info[playerid][med_card]) return SendError(playerid, "� ��� ��� ���. �����.");
    if(sscanf(params, "u", params[0]))
    {
        params[0] = playerid;
        SendInfo(playerid, "�����������: /medcard [id ������]");
    }
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "����� ������� ������ �� ���.");
    if(params[0] == playerid)
    {
        ShowMeditionCard(playerid, playerid);
    }
    else if(GetPVarInt(params[0],"BoneStol_ID")) return 1;
    else
    {
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL, ""W"�� ������ ���������� "I"%s "W"���������� ���� ��� �����.", get_name(params[0]));
        ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"���.�����", STRING_GLOBAL, "�����", "������");
        SetOfferData(playerid, params[0], OFFER_ID_SHOW_MED_CARD);
    }
    return 1;
}

CMD:medins(playerid, params[])
{
    if(!IsPlayerFractionMedic(playerid) || p_info[playerid][rang] < 3) return 1;
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "�����������: /medins [id ������]");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "����� ������� ������ �� ���.");
    if(GetPVarInt(params[0],"BoneStol_ID")) return 1;
    if(p_info[params[0]][med_insurance] != 0) return SendError(playerid, "� ������ ���� ���. �����������");

    SendAccess(playerid, "�� ���������� %s [%d] ���������� ���. ����������� �� 10000$.", get_name(params[0]), params[0]);
    SendInfo(params[0], "%s [%d] ��������� ��� ���������� ���. ����������� �� 10000$.", get_name(playerid), playerid);

    SetFreeSlotOffer(params[0], playerid, OFFER_ID_MED_INSURANCE, 10000);
    return 1;
}


CMD:givemedcard(playerid, params[])
{
    if(!IsPlayerFractionMedic(playerid) || p_info[playerid][rang] < 3) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(sscanf(params, "u", params[0])) return SendInfo(playerid, "�����������: /givemedcard [id ������]");
    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID) return SendError(playerid, "����� ������� ������ �� ���.");
    if(!PlayerToPoint(40.0,playerid, FractionsData[p_info[playerid][member]][fSpawnPos][0], FractionsData[p_info[playerid][member]][fSpawnPos][1], FractionsData[p_info[playerid][member]][fSpawnPos][2]))
        return SendError(playerid, "�� ������ ���������� � ��������.");
    if(!IsPlayerConnected(params[0])) return true;
    if(params[0] == INVALID_PLAYER_ID) return true;
    if(params[0] == playerid) return SendError(playerid, "�� ����� ���� ID.");
    if(p_info[params[0]][med_card] == 1) return SendError(playerid, "� ������ ��� ���� ���. �����.");
    if(GetFractionWarehouse(p_info[playerid][member], fwDrugs) < 50) return SendError(playerid, "�� ������ ������������ ������������.");

    new price = 2500;
    switch(p_info[params[0]][level])
    {
        case 1 .. 5: price = 2500;
        case 6 .. 10: price = 5000;
        case 11 .. 15: price = 7500;
        default: price = 10000;
    }

    SendAccess(playerid, "�� ���������� %s [%d] ���������� ���. ����� �� %d$.", get_name(params[0]), params[0], price);
    SendInfo(params[0], "%s [%d] ��������� ��� ���������� ���. ����� �� %d$.", get_name(playerid), playerid, price);

    SetFreeSlotOffer(params[0], playerid, OFFER_ID_BUY_MED_CARD, price);
    return 1;
}

CMD:hospital(playerid, params[])
{
    new hospital_id = GetPlayerVirtualWorld(playerid) - 1;
    if(!(0 <= hospital_id <= 2)) return 1;
    for(new i = sizeof(HospitalBedInfo)-1; i != -1; i--)
    {
        if(p_temp[playerid][hospital_bed_id] != -1) continue;
        if(!IsPlayerInRangeOfPoint (playerid, 2.0, HospitalBedInfo[i][hb_X],HospitalBedInfo[i][hb_Y],HospitalBedInfo[i][hb_Z])) continue;

        if(HospitalBedInfo[i][hb_Busy][hospital_id] != INVALID_PLAYER_ID)
        {
            SendError(playerid, "�� ����� ��� �����.");
            break;
        }
        p_temp[playerid][hospital_bed_id] = i;
        STRING_GLOBAL[0] = EOS;

        f(STRING_GLOBAL, ""W"�� ������������� ������ ���������� ������ ����� �� "I"%d$", BED_PRICE);
        ShowPlayerDialog (playerid, D_HOSPITAL_BED, DIALOG_STYLE_MSGBOX, ""I"�����", STRING_GLOBAL, "��", "���" );
        break;
    }
    return 1;
}

CMD:heal(playerid, params[])
{
    if(!IsPlayerFractionMedic(playerid) && (p_info[playerid][member] != PRISON || p_info[playerid][rang] < 5))
        return 1;

    new target, price;
    if(sscanf(params, "ui", target, price)) return SendInfo(playerid, "�����������: /heal [id ������] [���������]");

    if(!(50 <= price <= 500))
        return SendError(playerid, "��������� ������� �� ����� ���� ����� 50$ � ����� 500$.");

    if(target == INVALID_PLAYER_ID || !IsPlayerConnected(target) || target == playerid)
        return SendError(playerid, "����� �� ������.");

    if(!IsPlayerStream(5.0, playerid, target) || pSpectateId[target] != INVALID_PLAYER_ID)
        return SendError(playerid, "����� ������� ������ �� ���.");

    new
        target_vehicle = GetPlayerVehicleID(target),
        playerid_vehicle = GetPlayerVehicleID(playerid);

    if(p_info[target][level] <= 3 && (!medic_car(playerid_vehicle) && !medic_car(target_vehicle)) && (price < 50 || price > 100))
        return SendError(playerid, "��������� ������� ���������� �� ����� ���� ����� 50$ � ����� 100$.");
    else  if(p_info[target][level] >= 4 && (!medic_car(playerid_vehicle) && !medic_car(target_vehicle)) && (price < 100 || price > 300))
        return SendError(playerid, "��������� �������� ������� �� ����� ���� ����� 100$ � ����� 300$.");
    else  if((medic_car(playerid_vehicle) && playerid_vehicle == target_vehicle) && (price < 300 || price > 500))
        return SendError(playerid, "��������� ������� � ������ �� ����� ���� ����� 300$ � ����� 500$.");

    if(IsPlayerInRangeOfPoint(playerid, 100.0, 185.5570,-1681.7745,1007.4592))
    {
        switch(p_info[playerid][member])
        {
            case MEDIC_LS: if(GetPlayerVirtualWorld(playerid) != 1) return SendError(playerid, "�� ������ ���������� � �������� \"Los Santos\".");
            case MEDIC_SF: if(GetPlayerVirtualWorld(playerid) != 2) return SendError(playerid, "�� ������ ���������� � �������� \"San Fierro\".");
            case MEDIC_LV: if(GetPlayerVirtualWorld(playerid) != 3) return SendError(playerid, "�� ������ ���������� � �������� \"Las Venturas\".");
        }
    }
    if(p_info[target][med_insurance] != 0)
    {
        SendInfo(target, "� ��� ��������� ���. ���������, ���� ������� ������� � 2 ����.");
        SendInfo(playerid, "� ������ ��������� ���. ���������, ���� ������� ������� � 2 ����.");
        price = price/2;
    }

    if(medic_car(playerid_vehicle) && playerid_vehicle == target_vehicle || PlayerToPoint(100.0, playerid, 185.5570,-1681.7745,1007.4592))
    {
        SendAccess(playerid, "�� ���������� %s [%d] ���������� �� %d$.", get_name(target), target, price);
        SendInfo(target, "%s [%d] ��������� ��� ���������� �� %d$.", get_name(playerid), playerid, price);

        SetFreeSlotOffer(target, playerid, OFFER_ID_BUY_HEAL, price);
    }
    return 1;
}

CMD:tpcor(playerid, params[])
{
    if(p_info[playerid][admin] < 5 && p_temp[playerid][premiumgamer] != PREMIUM_GAME) return 1;
    new Float:pX, Float:pY, Float:pZ, int_, world_;
    if(sscanf(params, "p<,>fffI(-1)I(-1)", pX, pY, pZ, int_, world_)) return SendInfo(playerid, "�����������: /tpcor [x] [y] [z] [a] [interior] [virtualworld]");
    SetPlayerPos(playerid, pX, pY, pZ);
    //if(pA != -1) SetPlayerFacingAngle(playerid, pA);
    if(int_!= -1) SetPlayerInterior(playerid, int_);
    if(world_ != -1) SetPlayerVirtualWorld(playerid, world_);
    return 1;
}

CMD:pass(playerid, params[])
{
    if(!p_info[playerid][passport]) return SendError(playerid, "� ��� ��� ��������.");

    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "�����������: /pass [id ������]");

    if(params[0] == INVALID_PLAYER_ID)
        return SendError(playerid, "����� �� ������.");

    if(!IsPlayerStream(5.0, playerid, params[0]) || pSpectateId[params[0]] != INVALID_PLAYER_ID)
        return SendError(playerid, "����� ������� ������ �� ���.");

    if(pSpectateId[params[0]] != INVALID_PLAYER_ID)
        return 1;

    if(GetPVarType(params[0],"BoneStol_ID") == PLAYER_VARTYPE_INT)
        return 1;

    if(params[0] == playerid)
    {
        ShowPass(playerid, playerid);
        MeAction(playerid, "������(-�) ID ����� � ������������� ��");
    }
    else
    {
        STRING_GLOBAL[0] = EOS;
        f(STRING_GLOBAL, ""W"�� ������ ���������� "I"%s "W"���������� ���� ID �����.", get_name(params[0]));
        ShowPlayerDialog(playerid, D_OFFER_PLAYER, DIALOG_STYLE_MSGBOX, ""I"ID �����.", STRING_GLOBAL, "�����", "������");
        SetOfferData(playerid, params[0], OFFER_ID_SHOW_PASS);
    }
    return 1;
}

alias:pass("showcard", "idcard", "card");

CMD:gotoveh(playerid, params[])
{
    if(p_info[playerid][admin] < 3)
        return 1;

    if(isnull(params))
        return SendInfo(playerid, "�����������: /gotoveh [id ������������� ��������]");

    new
        vehicle = strval(params);

    if(vehicle == INVALID_VEHICLE_ID || !IsValidVehicle(vehicle))
        return SendError(playerid, "�������� ID ������������� ��������.");

    new
        Float:x,
        Float:y,
        Float:z;

    GetVehiclePos(vehicle, x, y, z);
    SetPlayerPos(playerid, x + 2.0, y + 2.0, z);

    SendAccess(playerid, "�� ����������������� � ������������� ��������.");
    return 1;
}

CMD:settime(playerid, params[])
{
    if(SRV_ID != 0 && (!FD(playerid) || p_info[playerid][admin] < 6)) return 1;

    if(isnull(params))
        return SendInfo(playerid, "�����������: /settime [�����]");

    new
        hour = strval(params);

    if(!(0 <= hour <= 24))
        return SendError(playerid, "����� ������ ���� �� ����� 0 � �� ����� 24.");

    foreach(new i:Player)
    {
        if(p_temp[i][BeingInSpace] != false) continue;
        SetPlayerTime(i, hour, 0);
    }

    SendAccess(playerid, "�� �������� ����� �� �������.");
    return 1;
}

CMD:amusic(playerid, params[])
{
    if(!FD(playerid) || p_info[playerid][admin] < 10)
        return 1;

    new radius, link[144];
    if(sscanf(params, "is[144]", radius, link)) return SendInfo(playerid, "�����������: /amusic [������] [������]");

    if(!(1 <= radius <= 100))
        return SendError(playerid, "������ ������ ���� �� ����� 1 � �� ����� 100.");

    new
        Float:x,
        Float:y,
        Float:z;

    GetPlayerPos(playerid, x, y, z);

    foreach(new i: Player)
    {
        if(!p_info[i][loggedIn]) continue;
        if(!IsPlayerInRangeOfPoint(i, float(radius), x, y, z))
            continue;

        PlayAudioStreamForPlayer(i, link);
    }

    SendAccess(playerid, "�� �������� ������.");
    return 1;
}

CMD:banip(playerid, params[])
{
    if(p_info[playerid][admin] < 5)
        return 1;

    new ban_ip[22],
        reason[144];

    if(sscanf(params, "s[24]s[144]", ban_ip, reason))
        return SendInfo(playerid, "�����������: /banip [ip �����] [�������]");

    if(strfind(ban_ip, "*", true) != -1 || strfind(ban_ip, "#", true) != -1)
        return SendInfo(playerid, "�����������: /banip [ip �����] [�������]");

    if(AdvertisingCheck(reason)) return AdvertisingPunishment(playerid, reason, 0);
    if(IsAAdminAttack(playerid, 7)) return 1;

    foreach(new i:Player)
    {
        if(FD(i))
        {
            if(strequals(ban_ip, p_info[i][regIP]) || strequals(ban_ip, p_temp[i][session_IP]))
            {
                SendInfo(playerid, "� ��� ���� ����� ����� �������������� �� ������� ���� �� IP ����. ��������������.");

                Iter_Remove(gAdmins, playerid);
                p_info[playerid][admin] = 0;
                p_info[playerid][admin_pass] = 0;
                Kick(playerid);
                return 1;
            }
        }
    }

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `IP` FROM `table_ban` WHERE `IP` = '%e' LIMIT 1", ban_ip);
    mysql_tquery(con_bd, STRING_GLOBAL, "banip", "iss", playerid, ban_ip, reason);
    return 1;
}
forward banip(playerid,ip_banned[], reason[]);
public banip(playerid,ip_banned[], reason[])
{
    new rows;
    cache_get_row_count(rows);
    if(!rows)
    {
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `table_ban` (`IP`, `Name_Admin`, `Ban_Data`, `Ban_Reason`, `Unban_Data`) VALUES ('%e', '%e', NOW(), '%e', %d)",
        ip_banned, get_name(playerid), reason, timestamp + (7*86400));
        mysql_tquery(con_bd, STRING_GLOBAL);

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] ������������ IP: %s. �������: %s", get_name(playerid), playerid, ip_banned, reason);
        SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

        WriteAdminLog(TYPE_LOG_BANIP, playerid, ip_banned, INVALID_PLAYER_ID, reason);
    }
    else SendError(playerid, "IP ��� �������������.");
    return 1;
}

CMD:unbanip(playerid, params[])
{
    if(p_info[playerid][admin] < 5) return 1;
    if(isnull(params) || strlen(params) > 16) return SendInfo(playerid, "�����������: /unbanip [ip ������]");
    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `IP` FROM `table_ban` WHERE `IP` = '%e' LIMIT 1",
    params);
    mysql_tquery(con_bd, STRING_GLOBAL, "unban_ip", "is", playerid, params);
    return 1;
}

forward unban_ip(playerid,ip_banned[]);
public unban_ip(playerid,ip_banned[])
{
    new rows;
    cache_get_row_count(rows);
    if(!rows) return SendError(playerid, "IP �� �������������.");

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `table_ban` WHERE `IP` = '%e' LIMIT 1",
    ip_banned);
    mysql_tquery(con_bd, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] ������������� IP: %s.", get_name(playerid), playerid, ip_banned);
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

    WriteAdminLog(TYPE_LOG_UNBANIP, playerid, ip_banned, INVALID_PLAYER_ID);
    return 1;
}
CMD:disband(playerid, params[])
{
    if(p_info[playerid][admin] < 6) return 1;
    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "�����������: /disband [id �������]");
    if(params[0] > MAX_FRACTIONS || params[0] < 1) return SendError(playerid, "ID ������� ������ ���� �� ����� 1 � �� ����� %d.", MAX_FRACTIONS);

    if(GetPVarInt(playerid, "DisbandAccept") != params[0])
    {
        SendInfo(playerid, "�� ������������� ������ �������������� \"%s\"?", GetFractionName(params[0]));
        SendInfo(playerid, "��� ������������� ������� ������� ��� ���.");
        SetPVarInt(playerid, "DisbandAccept", params[0]);
        return 1;
    }

    foreach(new i: Player)
    {
        if(p_info[i][member] != params[0]) continue;

        if(!p_info[i][admin])
        {
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `log_fraction` (`PlayerID`, `Member`, `Rang`, `Type`, `Reason`) VALUES (%d, %d, %d, '1', '���. �������������')",
            p_info[i][ID], p_info[i][member], p_info[i][rang]);
            mysql_tquery(con_bd, STRING_GLOBAL);
        }

        if(GetPlayerStatusCapture(i))
                HideTextDrawForPlayer(i, TD_ID_CAPTURE);

        Iter_Remove(gFactionPlayers[p_info[i][member]], i);
        p_info[i][member] = 0;
        p_info[i][rang] = 0;
        p_info[i][fskin] = 0;
        Iter_Add(gFactionPlayers[p_info[i][member]], i);
        if(GetFreeSlotHouse(i) != p_info[i][house_slots] || p_info[i][key_h_rent] != INVALID_HOUSE_ID) p_info[i][spawn] = 2;
        else p_info[i][spawn] = 0;
        p_info[i][fwork] = false;
        SetPlayerSkinEx(i);
        SetPlayerColor(i, fraction_color[0]);
        if(GetFactionCategory(p_info[i][member]) == FACTION_CATEGORY_PD || GetFactionCategory(p_info[i][member]) == FACTION_CATEGORY_FBI)
            p_temp[i][StatusOnDuty] = 0;
        save_player(i);
        f_ResetPlayerWeapons(i);

        /*
        p_info[i][ftop_gkills_week] = 
        p_info[i][ftop_gdeaths_week] = 0;
        p_info[i][ftop_gdamagegive_week] = 
        p_info[i][ftop_gdamagetake_week] = 0;
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `ftop_gkills_week` = 0, `ftop_gdeaths_week`  = 0, `ftop_gdamagegive_week` = 0.0, `ftop_gdamagetake_week` = 0.0 WHERE `id` = %d", p_info[i][ID]);
        mysql_tquery(con_bd, STRING_GLOBAL);
        */

        SendInfo(i, "������������� %s [%d] ������ ��� �� \"%s\" �� ������� �������������.", get_name(playerid), playerid, GetFractionName(params[0]));

        Log(LOG_player, INFO, "%s[%d](%s %s) ��� ������ %s[%d](%s %s) �� %s. �������: ���. ������������� | #Fraction",
            get_name(i), p_info[i][ID], p_temp[i][session_IP], IsPlayerMobile(i) ? "Mobile": "PC",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", GetFractionName(params[0]));

        Log(LOG_player, INFO, "%s[%d](%s %s) ������ %s[%d](%s %s) �� %s. �������: ���. ������������� | #Fraction",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
            get_name(i), p_info[i][ID], p_temp[i][session_IP], IsPlayerMobile(i) ? "Mobile": "PC", GetFractionName(params[0]));
    }

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id`, `member`, `rang` FROM `accounts` WHERE `member` = '%d'", params[0]);
    mysql_tquery(con_bd, STRING_GLOBAL, "disband_offline", "i", playerid);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `leader` = 0, `member` = 0, `rang` = 0, `fskin` = 0, `spawn` = 0, `fwork` = 0 WHERE `member` = %d",
    params[0]);
    mysql_tquery(con_bd, STRING_GLOBAL);

    DeletePVar(playerid, "DisbandAccept");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] ������������� \"%s\".", get_name(playerid), playerid, GetFractionName(params[0]));
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

    SendAccess(playerid, "�� �������������� \"%s\".", GetFractionName(params[0]));

    Log(LOG_player, INFO, "%s[%d](%s %s) ������������� ������� %s | #AdminLogs",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        GetFractionName(params[0]));


    return 1;
}
forward disband_offline(playerid);
public disband_offline(playerid)
{
    if(cache_num_rows())
    {
        new members, rangs, mysql_player_id;
        for(new i = 0; i < cache_num_rows(); i++)
        {
            cache_get_value_name_int(i, "id", mysql_player_id);
            cache_get_value_name_int(i, "member", members);
            cache_get_value_name_int(i, "rang", rangs);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `log_fraction` (`PlayerID`, `Member`, `Rang`, `Type`, `Reason`) VALUES (%d, %d, %d, '1', '���. �������������')", mysql_player_id, members, rangs);
            mysql_tquery(con_bd, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `leader` = 0, `member` = 0, `rang` = 0, `fskin` = 0, `spawn` = 0, `fwork` = 0 WHERE `id` = %d", mysql_player_id);
            mysql_tquery(con_bd, STRING_GLOBAL);
        }
    }
    return 1;
}

