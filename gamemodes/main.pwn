CMD:sellinfo(playerid, params[])
{
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Информация", ""W"\
        Продажа/обмен имущества возможна только через "I"/trade ID-игрока.\"", "Понял", "");
    return 1;
