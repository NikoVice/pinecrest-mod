            return 1;
        }
        case D_BATTLEPASS_BUY_LEVEL:
        {
            if(!response) return ShowBattlePass(playerid, BATTLEPASS_TYPE_SHOP);
            new fix_listitem = -1;
            if(sscanf(inputtext, "i", fix_listitem)) return SendMes(playerid, COLOR_DARKORANGE, "[BATTLE PASS]:"W" Вводить нужно только цифру пункта."), ShowBattlePass(playerid, BATTLEPASS_TYPE_SHOP);
            new max_level = MAX_BATTLEPASS_REWARD - p_info[playerid][battle_lvl];
            if(fix_listitem < 1 || fix_listitem > max_level) return SendMes(playerid, COLOR_DARKORANGE, "[BATTLE PASS]:"W" Количество уровней не может быть менее 1 и более %d.", max_level), ShowBattlePass(playerid, BATTLEPASS_TYPE_SHOP);
            new price = fix_listitem * BATTLEPASS_PRICE_LVL;
