    "W"��������:\t{FFFF00}%s\n\
    "W"���������:\t{FFFF00}%d\n\
    "W"������:\t{FFFF00}%s", code, Activate, CreateTime);
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"���������� � ���������", STRING_GLOBAL, "�������", "������");
    return 1;
}

forward CheckPromo(playerid,code[]);
public CheckPromo(playerid,code[])
{
    if(cache_num_rows() > 0)
        return SendError(playerid, "�� ��� ������������ ���� �����-���.");

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `promo` WHERE `name` = '%e'",
    code);
    mysql_tquery(con_bd, STRING_GLOBAL, "ActivatePromo", "is", playerid, code);
    return 1;
}
forward ActivatePromo(playerid,code[]);
public ActivatePromo(playerid,code[])
{
    new rows = 0;
    cache_get_row_count(rows);
    if(0 == rows)  return SendError(playerid, "�����-��� �� ������.");

    new typepriz,
        amountpriz,
        nactivations,
        string[356],
        activate,
        block,
        data[24],
        typetext[34],
        typetext1[24];

    for(new i ; i < rows; i++)
    {
        cache_get_value_name(i, "date", data, 24);
        cache_get_value_name_int(i, "activate", activate);
        cache_get_value_name_int(i, "block", block);
        cache_get_value_name_int(i, "nactivations", nactivations);
        cache_get_value_name_int(i, "typepriz", typepriz);
        cache_get_value_name_int(i, "amountpriz", amountpriz);
    }

    if(block > 0)
        return SendError(playerid, "�����-��� ������������.");

    if(typepriz != 4 && p_info[playerid][level] < 3) return SendError(playerid, "������������ �����-��� ����� � 3-��� ������.");

    if(typepriz == 4 && p_info[playerid][level] > 1) return SendError(playerid, "������������ ������ �����-��� ����� ������ �� 1-�� ������.");

    if(activate != 0)
    {
        format(string,sizeof(string),""W"�����-��� '%s' "W"��� ����������� {65A0D0}%s\n"W"� ���������, �� ��������. �� ������, ��������� � ������ ���..",code,data);
        ShowPlayerDialog(playerid,D_NULL,DIALOG_STYLE_MSGBOX, ""I"������",string,"�������","");
        return 1;
    }

    if(nactivations == 0)
    {
        format(string,100,"%02d:%02d:%02d",timestamp_hour, timestamp_minute, timestamp_second);

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `promo` SET `activate` = 1, `date` = '%s' WHERE `name` = '%s'",
        string, code);
        mysql_tquery(con_bd, STRING_GLOBAL);

        SendError(playerid, "���-�� ��������� �����-���� ����������.");
        return 1;
    }
    else nactivations--;
    switch(typepriz)
    {
        case 1:
        {
            typetext = "����(EXP) � ����������",typetext1 = "��";
            p_info[playerid][exp] += amountpriz;

            // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) ������� 30 EXP �� �����-��� newyear
            Log(LOG_player, INFO, "%s[%d](%s %s) ������� %d EXP �� �����-��� <%s>",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                amountpriz, code);

            PlayerLevelUpdateCheck(playerid);
        }
        case 2:
        {
            typetext = "������� ������ � ����������",typetext1 = "$.";
            SetPlayerMoney(playerid, amountpriz, true, "�����-��� <%s>", code);
        }
        case 3:
        {
            typetext = "Pinecrest Money � ����������",typetext1 = "��";
            p_info[playerid][flinmoney] += amountpriz;
            MysqlUpdatePlayerInt(playerid, "flinmoney", p_info[playerid][flinmoney]);

            // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) ������� 30 FM �� �����-��� newyear
            Log(LOG_player, INFO, "%s[%d](%s %s) ������� %d FM �� �����-��� <%s>",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                amountpriz, code);
        }
        case 4:
        {
            p_info[playerid][Lic][LIC_CAR] = 1;
            p_info[playerid][Lic_Warn][LIC_CAR] = 0;
            p_info[playerid][Lic_Time][LIC_CAR] = 336;
            OnPlayerUpdateLicData(playerid);

            CheckPlayerMission(playerid, START_SCHOOL);

            AddVehicleToPlayer(playerid, amountpriz, 3);
        }
    }

    SendAccess(playerid, "�� ������������ �����-���.");

    STRING_GLOBAL[0] = EOS;
    if(typepriz == 4) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "���� �������: ������������ �������� %s �� 72 ���� � �������� �� �������� ���������.", GetVehicleName(INVALID_VEHICLE_ID, amountpriz));
    else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "���� �������: %s %d %s.", typetext, amountpriz, typetext1);
    SendInfo(playerid, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `promo_activations` (`account_id`, `name_promo`) VALUES (%d, '%s')",
    p_info[playerid][ID], code);
    mysql_tquery(con_bd, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `promo` SET `nactivations` = %d WHERE `name` = '%s'",
    nactivations, code);
    mysql_tquery(con_bd, STRING_GLOBAL);
    return 1;
}
//////////////////////
BuySkinShop(playerid)
{
    new cost_skin,
        list_percent[3] = {90, 80, 70};

    if(p_info[playerid][sex] == 2) cost_skin = ItemsInfo[skinBuyMan[p_temp[playerid][shop_id]]][iPrice];
    else cost_skin = ItemsInfo[skinBuyMale[p_temp[playerid][shop_id]]][iPrice];
    if(p_info[playerid][p_vip]) cost_skin = ((cost_skin / 100) * list_percent[p_info[playerid][p_vip]-1]);
    if(p_info[playerid][cash] < cost_skin) return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");

    new skin_id,
        biz_id = GetPVarInt(playerid, "bID");
    if(p_info[playerid][sex] == 2) skin_id = skinBuyMan[p_temp[playerid][shop_id]]; //getIDx
    else skin_id = skinBuyMale[p_temp[playerid][shop_id]];

    if(!GivePlayerInventory(playerid, skin_id, .status_use = 1))
        return 1;

    if(b_info[biz_id][_prod] >= ((cost_skin / 100) * 40) / 100)
    {
        b_info[biz_id][_prod] -= ((cost_skin / 100) * 40) / 100;
        b_info[biz_id][_bank] += ((cost_skin / 100) * 40) - ((cost_skin / 100) * 4);
        AddMafiaBank(biz_id, (cost_skin / 100) * 4);

        biz_finka[biz_id] += ((cost_skin / 100) * 40) - ((cost_skin / 100) * 4);
        UpdateIntForFinanceBiz(biz_id, ((cost_skin / 100) * 40) - ((cost_skin / 100) * 4));
    }
    SetPlayerMoney(playerid, -cost_skin, true, "������� ������/����� (%d)", skin_id);

    SendAccess(playerid, "�� ��������� ������.");
    SendInfo(playerid, "����� ����� �������������� ����������.");

    HideTextDrawForPlayer(playerid, TD_ID_SHOP);

    SetCameraBehindPlayer(playerid);
    p_temp[playerid][p_listitem_int] = -1;
    p_temp[playerid][shop_id] = 0;

    CheckPlayerMission(playerid, START_CLOTHES);
    return 1;
}
/////////////////////////////
Declension_GetWord(result[], const size = sizeof(result), num, const word_1[], const word_2[], const word_3[])
{
    num %= 100;
    if(num > 19)
    {
        num %= 10;
    }

    result[0] = '\0';

    switch (num)
    {
        case 1:
        {
            strcat(result, word_1, size);
        }
        case 2..4:
        {
            strcat(result, word_2, size);
        }
        default:
        {
            strcat(result, word_3, size);
        }
    }
}

Declension_ReturnWord(num, const word_1[MAX_LANG_VALUE_STRING], const word_2[MAX_LANG_VALUE_STRING], const word_3[MAX_LANG_VALUE_STRING])
{
    new
        result[MAX_LANG_VALUE_STRING];

    Declension_GetWord(result, sizeof(result), num, word_1, word_2, word_3);
    return result;
}

forward OnMoveBarrierUpdateData();
public OnMoveBarrierUpdateData()
{
    for(new i; i != MAX_BARRIER_OBJECT; i ++)
