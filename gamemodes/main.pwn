forward CreatePromo(playerid,code[]);
public CreatePromo(playerid,code[])
{
    new rows,
        string[356],
        typetext[24];

    cache_get_row_count(rows);

    if(rows)
        return SendError(playerid, "Промокод уже используется.");

    new type = p_temp[playerid][TYPEPROMO];

    switch(type)
    {
        case 1: typetext = "Опыт(ЕХР)";
        case 2: typetext = "Игровая валюта";
        case 3: typetext = "Pinecrest Money";
        case 4: typetext = "Транспортное средство";
    }

    new
        amount = p_temp[playerid][AMOUNTPROMO],
        totalactivate = p_temp[playerid][ACTIVATEPROMO];

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `promo` (`name`, `typepriz`, `amountpriz`, `nactivations`, `date`) VALUES ('%s', %d, %d, %d, NOW())",
    code, type, amount, totalactivate);
    mysql_tquery(con_bd, STRING_GLOBAL);

    format(string,sizeof(string),""W"Промокод {65A0D0}'%s' "W"успешно создан\n\n"W"Тип выигрыша: {65A0D0}%d (%s)\n"W"Количество выигрыша/дней: {65A0D0}%d\n"W"Число доступных активаций: {65A0D0}%d",code,type,typetext,amount,totalactivate);
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Создание промокода | {FE6060}Финал", string, "Закрыть", "");

    p_temp[playerid][TYPEPROMO] =
    p_temp[playerid][AMOUNTPROMO] =
    p_temp[playerid][ACTIVATEPROMO] = -1;
    p_temp[playerid][PROMO] = EOS;
    return 1;
}
forward DeletePromo(playerid,code[]);
public DeletePromo(playerid,code[])
{
    if(0 == cache_num_rows())
        return SendError(playerid, "Промокод не найден.");

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `promo` WHERE `name` = '%s'",
    code);
    mysql_tquery(con_bd, STRING_GLOBAL);

    SendAccess(playerid, "Вы удалили промокод \"%s\".", code);
    return 1;
}
forward BlockPromo(playerid,code[]);
public BlockPromo(playerid,code[])
{
    if(0 == cache_num_rows())
        return SendError(playerid, "Промокод не найден.");

    new string[128];
    format(string, sizeof(string), "%02d:%02d:%02d", timestamp_hour, timestamp_minute, timestamp_second);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `promo` SET `block` = 1, `date` = '%s' WHERE `name` = '%s'", string, code);
    mysql_tquery(con_bd, STRING_GLOBAL);

    SendAccess(playerid, "Вы заблокировали промокод \"%s\".", code);
    return 1;
}


CMD:makehelper(playerid, params[])
{
    if(p_info[playerid][admin] < 5) return 1;

    new target;
    if(sscanf(params, "ui", target)) return SendInfo(playerid, "Используйте: /makehelper [id игрока]");

    if(target == INVALID_PLAYER_ID || !IsPlayerConnected(target))
        return SendError(playerid, "Игрок не найден.");

    if(p_info[target][admin] == 0) return SendError(playerid, "Игрок не является администратором проекта, назначьте для начала его.");

    if(p_info[target][admin] > 1) return SendError(playerid, "Игрок не может назначен если имеет 1 лвл и выше.");

    if(p_info[target][helper] == 1) {
        SendAccess(playerid, "Вы сняли %s [%d] с должности помощника. Не забудьте снять его с адм /makeadmin %d 0", get_name(target), target, target);
        SendInfo(target, "Администратор %s [%d] снял Вас с должности помощника.", get_name(playerid), playerid);


        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] снял %s [%d] с должности помощника.", get_name(playerid), playerid, get_name(target), target);
        SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

        p_info[target][helper] = 0;
        MysqlUpdatePlayerInt(target, "helper", p_info[target][helper]);

    }
    else
    {
        SendAccess(playerid, "Вы назначили %s [%d] на должность помощника (хелпер) проекта.", get_name(target), target);
        SendInfo(target, "Администратор %s [%d] назначил Вас на должность помощника (хелпер) проекта.", get_name(playerid), playerid);

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] назначил %s [%d] на должность помощника (хелпер) проекта.", get_name(playerid), playerid, get_name(target), target);
        SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

        Iter_Remove(gAdmins, target);
        Iter_Add(gHelpers, playerid);
        p_info[target][helper] = 1;
        MysqlUpdatePlayerInt(target, "helper", p_info[target][helper]);
    }
    return 1;
}

CMD:makeyoutube(playerid, params[])
{
    if(p_info[playerid][youtube_adm] < 5 && p_info[playerid][admin] < 7) return 1;

    new target, admin_level;
    if(sscanf(params, "ui", target, admin_level)) return SendInfo(playerid, "Используйте: /makeyoutube [id игрока] [уровень]");

    if(target == INVALID_PLAYER_ID || !IsPlayerConnected(target))
        return SendError(playerid, "Игрок не найден.");

    if(!(0 <= admin_level <= 3))
        return SendError(playerid, "Уровень ютуберки не может быть менее 0 или более 3.");

    if(p_info[target][youtube_adm] == admin_level)
        return SendError(playerid, "Уровень ютуберки не может быть равен текущему.");

    if(admin_level == 0) // игрок сейчас админ и мы его снимаем с админки
    {
        /*if(p_info[target][youtube_adm] > p_info[playerid][youtube_adm])
            return SendError(playerid, "Уровень ютуберки выше чем Ваш.");*/

        p_info[target][admin_pass] = 0;

        SendAccess(playerid, "Вы сняли %s [%d] с должности ютубера.", get_name(target), target);
        SendInfo(target, "Администратор %s [%d] снял Вас с должности ютубера.", get_name(playerid), playerid);

        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `admin_logs` WHERE `name` = '%e'",
        get_name(target));
        mysql_tquery(con_bd, STRING_GLOBAL);

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] снял %s [%d] с должности ютубера.", get_name(playerid), playerid, get_name(target), target);
        SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);
    }
    else // игрок сейчас не админ и мы его назначаем администратором, либо повышаем уровень ютубера
    {
        SendAccess(playerid, "Вы назначили %s [%d] на должность ютубера %d уровня.", get_name(target), target, admin_level);
        SendInfo(target, "Администратор %s [%d] назначил Вас на должность ютубера %d уровня.", get_name(playerid), playerid, admin_level);

        if(p_info[target][youtube_adm] == 0) // игрок не админ и мы его назначаем
        {
            p_info[target][admin_pass] = 100000 + random(899999);

            SendInfo(target, "Ваш пароль от панели ютубера: %d.", p_info[target][admin_pass]);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `admin_logs` (`name`) VALUES ('%e')",
            get_name(target));
            mysql_tquery(con_bd, STRING_GLOBAL);
        }

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] назначил %s [%d] на должность ютубера %d уровня.", get_name(playerid), playerid, get_name(target), target, admin_level);
        SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);
    }

    p_info[target][youtube_adm] = admin_level;
    MysqlUpdatePlayerInt(target, "youtube_adm", p_info[target][youtube_adm]);
    return 1;
}

CMD:delyoutube(playerid, params[])
{
    if(p_info[playerid][youtube_adm] < 5 && p_info[playerid][admin] < 7) return 1;

    if(isnull(params))
        return SendInfo(playerid, "Используйте: /delyoutube [никнейм]");

    if(GetPlayerID(params) != INVALID_PLAYER_ID)
        return SendError(playerid, "Игрок в игре.");



    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `youtube_adm` FROM `accounts` WHERE `name` = '%e' LIMIT 1", params);
    new Cache:cache = mysql_query(con_bd, STRING_GLOBAL, true);

    if(!cache_num_rows())
        return SendError(playerid, "Игрок не ютубер.");

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `youtube_adm` = 0, `admin_pass` = 0 WHERE `name` = '%e' LIMIT 1",
    params);
    mysql_tquery(con_bd, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `admin_logs` WHERE `name` = '%e'",
    params);
    mysql_tquery(con_bd, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] снял %s с должности ютубера.", get_name(playerid), playerid, params);
    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);

    SendAccess(playerid, "Вы сняли %s с должности ютубера.", params);

    cache_delete(cache);
    return 1;
}

forward OnServerGetActivationPromo(playerid, code[]);
public OnServerGetActivationPromo(playerid, code[])
{
    new rows = 0;
    cache_get_row_count(rows);
    if(rows == 0)  return SendError(playerid, "Промокод не найден.");

    new Activate;
    new CreateTime[24];
    cache_get_value_name_int(0, "Activation", Activate);
    cache_get_value_name(0, "CreateTime", CreateTime, 24);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
    "W"Промокод:\t{FFFF00}%s\n\
    "W"Активаций:\t{FFFF00}%d\n\
    "W"Создан:\t{FFFF00}%s", code, Activate, CreateTime);
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Информация о промокоде", STRING_GLOBAL, "Принять", "Отмена");
    return 1;
}

forward CheckPromo(playerid,code[]);
public CheckPromo(playerid,code[])
{
    if(cache_num_rows() > 0)
        return SendError(playerid, "Вы уже активировали этот бонус-код.");

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `promo` WHERE `name` = '%e'",
    code);
    mysql_tquery(con_bd, STRING_GLOBAL, "ActivatePromo", "is", playerid, code);
    return 1;
}
forward ActivatePromo(playerid,code[]);
public ActivatePromo(playerid,code[])
{
    new rows = 0;
    cache_get_row_count(rows);
    if(0 == rows)  return SendError(playerid, "Бонус-код не найден.");

    new typepriz,
        amountpriz,
        nactivations,
        string[356],
        activate,
        block,
        data[24],
        typetext[34],
        typetext1[24];

    for(new i ; i < rows; i++)
    {
        cache_get_value_name(i, "date", data, 24);
        cache_get_value_name_int(i, "activate", activate);
        cache_get_value_name_int(i, "block", block);
        cache_get_value_name_int(i, "nactivations", nactivations);
        cache_get_value_name_int(i, "typepriz", typepriz);
        cache_get_value_name_int(i, "amountpriz", amountpriz);
    }

    if(block > 0)
        return SendError(playerid, "Бонус-код заблокирован.");

    if(typepriz != 4 && p_info[playerid][level] < 3) return SendError(playerid, "Активировать бонус-код можно с 3-его уровня.");

    if(typepriz == 4 && p_info[playerid][level] > 1) return SendError(playerid, "Активировать данный бонус-код можно только на 1-ом уровне.");

    if(activate != 0)
    {
        format(string,sizeof(string),""W"Бонус-код '%s' "W"уже активирован {65A0D0}%s\n"W"К сожалению, Вы опоздали. Но ничего, получится в другой раз..",code,data);
        ShowPlayerDialog(playerid,D_NULL,DIALOG_STYLE_MSGBOX, ""I"Ошибка",string,"Закрыть","");
        return 1;
    }

    if(nactivations == 0)
    {
        format(string,100,"%02d:%02d:%02d",timestamp_hour, timestamp_minute, timestamp_second);

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `promo` SET `activate` = 1, `date` = '%s' WHERE `name` = '%s'",
        string, code);
        mysql_tquery(con_bd, STRING_GLOBAL);

        SendError(playerid, "Кол-во активаций бонус-кода ограничено.");
        return 1;
    }
    else nactivations--;
    switch(typepriz)
    {
        case 1:
        {
            typetext = "Опыт(EXP) в количестве",typetext1 = "шт";
            p_info[playerid][exp] += amountpriz;

            // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) получил 30 EXP за бонус-код newyear
            Log(LOG_player, INFO, "%s[%d](%s %s) получил %d EXP за бонус-код <%s>",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                amountpriz, code);

            PlayerLevelUpdateCheck(playerid);
        }
        case 2:
        {
            typetext = "Игровая валюта в количестве",typetext1 = "$.";
            SetPlayerMoney(playerid, amountpriz, true, "бонус-код <%s>", code);
        }
        case 3:
        {
            typetext = "Pinecrest Money в количестве",typetext1 = "шт";
            p_info[playerid][flinmoney] += amountpriz;
            MysqlUpdatePlayerInt(playerid, "flinmoney", p_info[playerid][flinmoney]);

            // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) получил 30 FM за бонус-код newyear
            Log(LOG_player, INFO, "%s[%d](%s %s) получил %d FM за бонус-код <%s>",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                amountpriz, code);
        }
        case 4:
        {
            p_info[playerid][Lic][LIC_CAR] = 1;
            p_info[playerid][Lic_Warn][LIC_CAR] = 0;
            p_info[playerid][Lic_Time][LIC_CAR] = 336;
            OnPlayerUpdateLicData(playerid);

            CheckPlayerMission(playerid, START_SCHOOL);

            AddVehicleToPlayer(playerid, amountpriz, 3);
        }
    }

    SendAccess(playerid, "Вы активировали бонус-код.");

    STRING_GLOBAL[0] = EOS;
    if(typepriz == 4) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Ваша награда: транспортное средство %s на 72 часа и лицензия на наземный транспорт.", GetVehicleName(INVALID_VEHICLE_ID, amountpriz));
    else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Ваша награда: %s %d %s.", typetext, amountpriz, typetext1);
    SendInfo(playerid, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `promo_activations` (`account_id`, `name_promo`) VALUES (%d, '%s')",
    p_info[playerid][ID], code);
    mysql_tquery(con_bd, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `promo` SET `nactivations` = %d WHERE `name` = '%s'",
    nactivations, code);
    mysql_tquery(con_bd, STRING_GLOBAL);
    return 1;
}
//////////////////////
BuySkinShop(playerid)
{
    new cost_skin,
        list_percent[3] = {90, 80, 70};

    if(p_info[playerid][sex] == 2) cost_skin = ItemsInfo[skinBuyMan[p_temp[playerid][shop_id]]][iPrice];
    else cost_skin = ItemsInfo[skinBuyMale[p_temp[playerid][shop_id]]][iPrice];
    if(p_info[playerid][p_vip]) cost_skin = ((cost_skin / 100) * list_percent[p_info[playerid][p_vip]-1]);
    if(p_info[playerid][cash] < cost_skin) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

    new skin_id,
        biz_id = GetPVarInt(playerid, "bID");
    if(p_info[playerid][sex] == 2) skin_id = skinBuyMan[p_temp[playerid][shop_id]]; //getIDx
    else skin_id = skinBuyMale[p_temp[playerid][shop_id]];

    if(!GivePlayerInventory(playerid, skin_id, .status_use = 1))
        return 1;

    if(b_info[biz_id][_prod] >= ((cost_skin / 100) * 40) / 100)
    {
        b_info[biz_id][_prod] -= ((cost_skin / 100) * 40) / 100;
        b_info[biz_id][_bank] += ((cost_skin / 100) * 40) - ((cost_skin / 100) * 4);
        AddMafiaBank(biz_id, (cost_skin / 100) * 4);

        biz_finka[biz_id] += ((cost_skin / 100) * 40) - ((cost_skin / 100) * 4);
        UpdateIntForFinanceBiz(biz_id, ((cost_skin / 100) * 40) - ((cost_skin / 100) * 4));
    }
    SetPlayerMoney(playerid, -cost_skin, true, "покупка одежды/скина (%d)", skin_id);

    SendAccess(playerid, "Вы приобрели одежду.");
    SendInfo(playerid, "Чтобы одеть воспользуйтесь инвентарем.");

    HideTextDrawForPlayer(playerid, TD_ID_SHOP);

    SetCameraBehindPlayer(playerid);
    p_temp[playerid][p_listitem_int] = -1;
    p_temp[playerid][shop_id] = 0;

    CheckPlayerMission(playerid, START_CLOTHES);
    return 1;
}
/////////////////////////////
Declension_GetWord(result[], const size = sizeof(result), num, const word_1[], const word_2[], const word_3[])
{
    num %= 100;
    if(num > 19)
    {
        num %= 10;
    }

    result[0] = '\0';

    switch (num)
    {
        case 1:
        {
            strcat(result, word_1, size);
        }
        case 2..4:
        {
            strcat(result, word_2, size);
        }
        default:
        {
            strcat(result, word_3, size);
        }
    }
}

Declension_ReturnWord(num, const word_1[MAX_LANG_VALUE_STRING], const word_2[MAX_LANG_VALUE_STRING], const word_3[MAX_LANG_VALUE_STRING])
{
    new
        result[MAX_LANG_VALUE_STRING];

    Declension_GetWord(result, sizeof(result), num, word_1, word_2, word_3);
    return result;
}

forward OnMoveBarrierUpdateData();
public OnMoveBarrierUpdateData()
{
    for(new i; i != MAX_BARRIER_OBJECT; i ++)
    {
        if(MoveBarrier[i] >= 1)
        {
            MoveBarrier[i] --;
            if(MoveBarrier[i] == 0)
            {
                switch(i)
                {
                    case 0: MoveObject(MoveDoor[0],   1805.617070, 822.9752800, 10.58120-0.2, 0.06, 0.00000, 90.000000, 0.00000);
                    case 1: MoveObject(MoveDoor[1],   1788.937380, 822.9378100, 10.58120-0.2, 0.06, 0.00000, -90.00000, 0.00000);
                    case 2: MoveObject(MoveDoor[2],   -1504.50085, 703.9182100, 45.18680-0.2, 0.06, 0.00000, 90.000000, 315.00000);
                    case 3: MoveObject(MoveDoor[3],   -1516.65540, 715.3021200, 45.16680-0.2, 0.06, 0.00000, -90.00000, 315.00000);
                    case 4: MoveObject(MoveDoor[4],   57.74950000, -1528.52222, 4.854500-0.2, 0.06, 0.00000, 90.000000, 80.00000);
                    case 5: MoveObject(MoveDoor[5],   37.00850000, -1532.99900, 4.814500-0.2, 0.06, 0.00000, -90.00000, 80.00000);
                    case 6: MoveObject(MoveDoor[6],   56.35770000, -1536.47522, 4.814500-0.2, 0.06, 0.00000, -90.00000, 80.00000);
                    case 7: MoveObject(MoveDoor[7],   38.49480000, -1525.18457, 4.854500-0.2, 0.06, 0.00000, 90.000000, 80.00000);
                    case 8: MoveObject(MoveDoor[8],   1544.668210, -1630.81287, 13.21160-0.2, 0.06, 0.00000, 90.000000, 90.00000);
                    case 9: MoveObject(MoveDoor[9],   2238.195070, 2450.482420, 10.72600-0.2, 0.06, 0.00000, -90.00000, 269.00000);
                    case 10: MoveObject(MoveDoor[10], -1572.20288, 658.8060900, 6.962200-0.2, 0.06, 0.00000, 90.000000, 90.00000);
                    case 11: MoveObject(MoveDoor[11], -1701.44482, 687.5681200, 24.83200-0.2, 0.06, 0.00000, -90.00000, 90.00000);
                    case 12: MoveObject(MoveDoor[12], 2343.746090, 2422.990720, 10.66930-0.2, 0.06, 0.00000, 90.000000, 0.00000);
                    case 13: MoveObject(MoveDoor[13], 774.5297200, -1330.19800, 13.35650-0.2, 0.06, 0.00000, 90.000000, 0.00000);
                    case 14: MoveObject(MoveDoor[14], 774.5297200, -1385.30029, 13.35650-0.2, 0.06, 0.00000, 90.000000, 0.00000);
                }
                MoveBarrier[i] = 0;
            }
        }
    }
    return 1;
}

AddVehicleToPlayer(playerid, modelid, typeid, price = 0)
{
    if(modelid < 400) return 1;
    new custom_id = -1;
    if(!(400 <= modelid <= 612))
    {
        custom_id = GetSlotVehicleModelSync(modelid);
        if(custom_id == -1) return SendError(playerid, "Данного автомобиля нет в списке Real Cars");
    }
    new rows = GetPlayerCountCars(p_info[playerid][ID], GetVehicleData(modelid, E_VD_TYPE)),
        count_limit = GetPlayerLimiteCars(playerid, GetVehicleData(modelid, E_VD_TYPE));
    if(rows < count_limit)
    {
        new color = random(6), car_id;
        switch(GetVehicleData(modelid, E_VD_TYPE))
        {
            case VEHICLE_STATE_MOTO, VEHICLE_STATE_VELO_MOPED:
            {
                car_id = CreateVehicleVEx(NPO_PLAYERCAR, NPO_NONE, modelid, 2136.9063,-1146.9723,24.1492,360.0, color, color, 1800);
            }
            case VEHICLE_STATE_CAR:
            {
                switch(random(3))
                {
                    case 0: car_id = CreateVehicleVEx(NPO_PLAYERCAR, NPO_NONE, modelid, 2148.7544,1397.9063,10.5574,180.0, color, color, 1800);
                    case 1: car_id = CreateVehicleVEx(NPO_PLAYERCAR, NPO_NONE, modelid, 2142.4277,1397.9630,10.5574,180.0, color, color, 1800);
                    case 2: car_id = CreateVehicleVEx(NPO_PLAYERCAR, NPO_NONE, modelid, 2135.9500,1398.2472,10.5574,180.0, color, color, 1800);
                }
            }
            case VEHICLE_STATE_BOAT:
            {
                switch(random(3))
                {
                    case 0: car_id = CreateVehicleVEx(NPO_PLAYERCAR, NPO_NONE, modelid, 132.1968,-1800.3795,-0.0,138.1145, color, color, 1800);
                    case 1: car_id = CreateVehicleVEx(NPO_PLAYERCAR, NPO_NONE, modelid, 118.8191,-1800.5955,-0.0,45.4816, color, color, 1800);
                    case 2: car_id = CreateVehicleVEx(NPO_PLAYERCAR, NPO_NONE, modelid, 123.3519,-1793.6954,-0.0,45.4816, color, color, 1800);
                }
            }
            case VEHICLE_STATE_PLANE:
            {
                switch(random(2))
                {
                    case 0: car_id = CreateVehicleVEx(NPO_PLAYERCAR, NPO_NONE, modelid, 1618.6765,1538.0615,10.9496,21.2388, color, color, 1800);
                    case 1: car_id = CreateVehicleVEx(NPO_PLAYERCAR, NPO_NONE, modelid, 1639.0493,1543.7990,10.9899,21.2388, color, color, 1800);
                }
            }
        }
        veh_info[car_id][v_lock] = 1;
        veh_info[car_id][v_color] = color;
        for(new i; i < 5; i++) veh_info[car_id][v_details][i] = 100.0;
        //format(veh_info[car_id][v_number], 16, "NULL");
        veh_info[car_id][v_fuel] = GetVehicleData(modelid, E_VD_MAX_FUEL);
        /*veh_info[car_id][v_int] =
        veh_info[car_id][v_virt] =
        veh_info[car_id][v_insurance] = 0;*/
        veh_info[car_id][v_owner_id] = p_info[playerid][ID];
        veh_info[car_id][v_premium] = 0;
        if(typeid == 2) veh_info[car_id][v_premium] = 1;
        if(typeid == 3) veh_info[car_id][v_bonus] = timestamp+259200;
        if(typeid == 4) veh_info[car_id][v_sell_block] = 1;
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `vehicle` \
            (`v_owner_id`, `v_model`, `v_premium`, `v_bonus`, `v_sell_block`, `v_pos_0`, `v_pos_1`, `v_pos_2`, `v_pos_3`, `v_lock`, `v_fuel`, `v_color_0`, `v_color_1`, `v_int`, `v_virt`) VALUES \
            (%d, %d, %d, %d, %d, %f, %f, %f, %f, %d, %f, %d, %d, %d, %d)",
            veh_info[car_id][v_owner_id], veh_info[car_id][v_model], veh_info[car_id][v_premium], veh_info[car_id][v_bonus], veh_info[car_id][v_sell_block],
            veh_info[car_id][v_pos][0], veh_info[car_id][v_pos][1], veh_info[car_id][v_pos][2], veh_info[car_id][v_pos][3],
            veh_info[car_id][v_lock], veh_info[car_id][v_fuel], veh_info[car_id][v_color][0], veh_info[car_id][v_color][1],
            veh_info[car_id][v_int], veh_info[car_id][v_virt]);
        mysql_tquery(con_bd, STRING_GLOBAL, "get_vehicle_id", "ii", playerid, car_id);

        SendAccess(playerid, "Ваше транспортное средство создано.");
        SendInfo(playerid, "Найти транспортное средство: /findcar");
        SendInfo(playerid, "Загрузить или выгрузить транспортное средство: /cars");

        if(typeid == 4) SendMes(playerid, COLOR_DARKORANGE, "[ВНИМАНИЕ]: "W"Данное транспортное средство подарочное, продажа государству возможна за 0$!");

        if(typeid != 3) CheckPlayerMission(playerid, START_VEHICLE);
    }
    else
    {
        if(typeid == 3) return SendError(playerid, "У Вас нет свободного места под транспорт.");
        p_temp[playerid][p_listitem_int] = modelid;
        p_temp[playerid][p_listitem][0] = typeid;
        p_temp[playerid][p_listitem][1] = price;
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `v_model`, `v_number`, `v_twinturbo`, `v_premium`, `v_bonus`, `v_sell_block`, `v_mysql_id` FROM `vehicle` WHERE `v_owner_id` = %d", p_info[playerid][ID]);
        mysql_tquery(con_bd, STRING_GLOBAL, "AddVehicleToPlayerCallback", "i", playerid);
    }
    return 1;
}

forward AddVehicleToPlayerCallback(playerid);
public AddVehicleToPlayerCallback(playerid)
{
    new rows = cache_num_rows();
    if(!rows)
        return SendError(playerid, "Произошла не известная ошибка 2008-1 / Сообщите на форум.");
    if(p_temp[playerid][p_listitem_int] < 400)
        return SendError(playerid, "Произошла не известная ошибка 2008-2 / Сообщите на форум.");
    new temp_mysql_id, temp_model_id, twinturbo, premium, bonus, sell_block, count = 0,
        twinturbo_status[][] = {"", "[{ffff00}TT"W"]"},
        premium_status[][] = {"", "[{ffff00}PREMIUM"W"]"};
    STRING_GLOBAL[0] = EOS;
    for(new i; i < rows; i++)
    {
        cache_get_value_name_int(i, "v_model", temp_model_id);
        cache_get_value_name_int(i, "v_mysql_id", temp_mysql_id);
        if(GetSlotVehicleMarket(temp_mysql_id) != -1 || GetVehicleData(temp_model_id, E_VD_TYPE) != GetVehicleData(p_temp[playerid][p_listitem_int], E_VD_TYPE)) continue;
        //cache_get_value_name(i, "v_number", veh_number, 16);
        //if(strequals(veh_number, "NULL")) veh_number = "НЕТ НОМЕРОВ";
        cache_get_value_name_int(i, "v_twinturbo", twinturbo);
        cache_get_value_name_int(i, "v_premium", premium);
        cache_get_value_name_int(i, "v_bonus", bonus);
        cache_get_value_name_int(i, "v_sell_block", sell_block);
        f(STRING_GLOBAL, "%s"I"[%d]"W" %s (ID: %d) %s %s \t%s%s%s\n",
            STRING_GLOBAL, count+1, GetVehicleName(INVALID_VEHICLE_ID, temp_model_id), temp_model_id, twinturbo_status[twinturbo], premium_status[premium],
            GetPlayerVehicleMySQLID(playerid, p_temp[playerid][p_listitem_cars][count]) != -1 ? "[{ffcc00}Используется"W"]" : "[{669900}Не используется"W"]", bonus == 0 ? "" : "[{ffff00}BONUS"W"]", sell_block == 0 ? "" : "[{"#cLIGHTRED"}Подарочный т/с, продажа за 0$"W"]");
        p_temp[playerid][p_listitem_cars][count] = temp_mysql_id;
        count++;
    }
    p_temp[playerid][loadcar_max] = count;
    ShowPlayerDialog(playerid, D_ADD_NEW_TRANSPORT, DIALOG_STYLE_TABLIST, ""I"Заменить личный транспорт", STRING_GLOBAL, "Заменить", "Продать");
    return 1;
}

forward check_used_veh_number(playerid, veh_number, size_veh_num);
public check_used_veh_number(playerid, veh_number, size_veh_num)
{
    new rows, veh_number_rice;
    cache_get_row_count(rows);
    if(rows)
    {
        SendError(playerid, "Номер транспортного средства уже используется.");
        return ShowPlayerDialog(playerid, D_BUY_VEH_NUMBER_STEP1, DIALOG_STYLE_INPUT, ""I"Приобретение номера", ""W"\
        Введите номер, который желаете приобрести на данное транспортное средство:\n\n\
        Стоимость:\n\n\
        \tТрехзначный - от "I"500000$"W" до "I"2500000$"W"\n\
        \tЧетырехзначный - от "I"100000$"W" до "I"500000$"W"\n\
        \tПятизначный - от "I"10000$"W" до "I"100000$", "Далее", "Отмена");
    }
    switch(size_veh_num)
    {
        case 3:
        {
            switch(veh_number)
            {
                case 111, 222, 333, 444, 555, 666, 777, 888, 999, 100, 200, 300, 400, 500, 600, 700, 800, 900, 123, 321, 911: veh_number_rice = 2500000;
                default: veh_number_rice = 500000;
            }
        }
        case 4:
        {
            switch(veh_number)
            {
                case 1111, 2222, 3333, 4444, 5555, 6666, 7777, 8888, 9999, 1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 1234, 4321: veh_number_rice = 500000;
                default: veh_number_rice = 100000;
            }
        }
        case 5:
        {
            switch(veh_number)
            {
                case 11111, 22222, 33333, 44444, 55555, 66666, 77777, 88888, 99999, 10000, 20000, 30000, 40000, 50000, 60000, 70000, 80000, 90000, 12345, 54321: veh_number_rice = 100000;
                default: veh_number_rice = 10000;
            }
        }
        default: veh_number_rice = 0;
    }
    if(veh_number_rice)
    {
        p_temp[playerid][p_listitem][0] = veh_number;
        p_temp[playerid][p_listitem][1] = veh_number_rice;
        p_temp[playerid][p_listitem][2] = size_veh_num;
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof STRING_GLOBAL, ""W"\
        Номер: "I"%d"W"\n\n\
        Стоимость: "I"%d$"W"\n\n\
        Вы желаете приобрести данный номер для транспортного средства?", veh_number, veh_number_rice);
        return ShowPlayerDialog(playerid, D_BUY_VEH_NUMBER_STEP2, DIALOG_STYLE_MSGBOX, ""I"Приобретение номера", STRING_GLOBAL, "Да", "Нет");
    }
    return 1;
}

forward CheckUseNickNameCallback(playerid, type, inputtext[]);
public CheckUseNickNameCallback(playerid, type, inputtext[])
{
    if(cache_num_rows())
        return SendError(playerid, "Никнейм уже используется.");

    switch(type)
    {
        case 0:
        {
            OnServerInfoForMoney[14] += 3000000;
            SetPlayerMoney(playerid, -3000000, true, "смена ника в мэрии");
            SetPVarInt(playerid, "CHANGE_NICK:MAYOR", 1);
            SetPlayerNickName(playerid, inputtext);

            SetFractionWarehouse(MAYOR_LS, fwMoney, 300000);
        }
        case 1:
        {
            if(GetPVarInt(playerid, "CHANGE_NICK:FLOOD") > timestamp) return SendError(playerid, "Отправлять заявление на смену никнейма можно раз в 5 минут.");
            if(GetPVarInt(playerid, "CHANGE_NICK:FREE") != 1) return 1;
            if(!SetChangeNick(playerid)) return SendError(playerid, "Повторите попытку позже, сейчас большая очередь на смену ника.");
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] просит сменить ник на %s.", get_name(playerid), playerid, inputtext);
            SendAdminMessage(0x33CC66FF, STRING_GLOBAL);

            SendAccess(playerid, "Вы отправили заявление на изменение никнейма на %s.", inputtext);
            SendInfo(playerid, "Ожидайте вердикта администрации.");

            SetPVarString(playerid, "NewNickName", inputtext);
            SetPVarInt(playerid, "CHANGE_NICK:FLOOD", timestamp + 300);
        }
        case 2:
        {
            if(p_info[playerid][flinmoney] < donate_name) return SendError(playerid, "У Вас нет столько Pinecrest Money.");
            SendMesAll(0xFFD700FF, "Внимание! "W"%s [%d] изменил никнейм на %s.", get_name(playerid), playerid, inputtext);
            SetPlayerNickName(playerid, inputtext);
        }
    }
    return 1;
}

PlayerLevelUpdateCheck(playerid)
{
    if(p_info[playerid][exp] >= (p_info[playerid][level]+1)*4)
    {
        p_info[playerid][exp] -= (p_info[playerid][level]+1)*4;
        p_info[playerid][level] += 1;

        SendInfo(playerid, "Ваш игровой уровень повышен.");

        SetPlayerScore(playerid, p_info[playerid][level]);

        new promocode_use_idx = p_info[playerid][promocode_use];

        if(p_info[playerid][level] == 5 && p_info[playerid][exp] == 0 && promocode_use_idx != 0)
        {
            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `promocode` WHERE `id` = %d LIMIT 1",
            promocode_use_idx);
            mysql_tquery(con_bd, STRING_GLOBAL, "OnPlayerSelectPromocode", "dd", playerid, 3);
        }

        if(p_info[playerid][level] == 5 && p_info[playerid][checkdrug] == 0 && p_info[playerid][referral] != 0)
        {
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id` FROM `accounts` WHERE `id` = %d", p_info[playerid][referral]);
            new Cache:result = mysql_query(con_bd, STRING_GLOBAL);

            if(cache_num_rows() != 0)
            {
                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `referralmoney` = `referralmoney` + '250000', `referralcount` = `referralcount` + '1' WHERE `id` = %d",
                    p_info[playerid][referral]);
                mysql_tquery(con_bd, STRING_GLOBAL);

                OnServerInfoForMoney[9] += 250000;
                p_info[playerid][checkdrug] = 1;
            }
            else p_info[playerid][checkdrug] = 1;
            cache_delete(result);
        }
    }
}

public OnPlayerTakeDamage(playerid, issuerid, Float:amount, weaponid, bodypart)
{
    if(SRV_ID == 0) SendMesAll(-1, "OnPlayerTakeDamage playerid = %d issuerid = %d amount = %f weaponid = %d bodypart = %d", playerid, issuerid, amount, weaponid, bodypart);
    if(p_info[playerid][loggedIn] != 1) return 0;
    if(issuerid != INVALID_PLAYER_ID)
    {
        if(p_info[issuerid][loggedIn] != 1) return 0;
        if(!CheckPlayerDM(issuerid)) return 0;
        if(!PacifistMode(playerid, issuerid)) return 0;
        TakePlayerDamage(playerid, issuerid, amount, weaponid, bodypart);
    }
    if(!weaponid || WEAPON_VEHICLE <= weaponid <= WEAPON_COLLISION)
        DamageInformer(playerid, issuerid, amount, weaponid);
    return 1;
}

public OnPlayerGiveDamage(playerid, damagedid, Float:amount, weaponid, bodypart)
{
    if(SRV_ID == 0) SendMesAll(-1, "OnPlayerGiveDamage: playerid = %d damagedid = %d amount = %f weaponid = %d bodypart = %d", playerid, damagedid, amount, weaponid, bodypart);
    if(p_info[playerid][loggedIn] != 1 || p_info[damagedid][loggedIn] != 1) return 0;
    if(weaponid == WEAPON_NITESTICK && damagedid != INVALID_PLAYER_ID && IsPlayerFractionPolice(playerid) && !IsPlayerFractionPolice(damagedid) && RegisterPaintBall[playerid] != 2 && p_temp[playerid][cossack_robbers_register] != 2 && player_lobby_status[playerid] == false)
    {
        if(p_temp[damagedid][tazer_dest] == true) SendError(playerid, "Игрок уже оглушен.");
        else
        {
            new Float:p_hp[2];
            GetPlayerHealth(damagedid, p_hp[0]);
            GetPlayerArmour(damagedid, p_hp[1]);
            if(p_hp[1] > 0.0) SetPlayerArmour(damagedid, p_hp[1]+amount);
            else SetPlayerHealth(damagedid, p_hp[0]+amount);

            Fix_TogglePlayerControllable(damagedid, 0);
            ApplyAnimationFix(damagedid,"CRACK","crckidle2",3.0);
            p_temp[damagedid][tazer_dest] = true;
            SetTimerEx("TazerEndTimer", 10000, 0, "i", damagedid);

            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "оглушил(-а) %s", get_name(damagedid));
            MeAction(playerid, STRING_GLOBAL);
        }
        return 0;
    }
    if(!PacifistMode(damagedid, playerid)) return 0;
    CheckDMAnalyze(playerid, damagedid);
    if(damagedid != INVALID_PLAYER_ID)
    {
        if(p_info[playerid][p_settings][STATUS_DAMAGE] == 0)
        {
            /*
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "~r~DAMAGE DONE: %0.2f", amount);
            GameTextForPlayer(playerid, STRING_GLOBAL, 500, 6);
            */
        }
        if(p_info[damagedid][p_settings][STATUS_DAMAGE] == 0)
        {
            /*
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "~r~DAMAGE RECEIVED: %0.2f", amount);
            GameTextForPlayer(damagedid, STRING_GLOBAL, 500, 6);
            */
        }
    }

    if(damagedid != INVALID_PLAYER_ID && gang(playerid) && gang(damagedid))
    {
        if(GetGangZoneID(playerid) != INVALID_CRIMINAL_ZONE_ID && GetGangZoneID(damagedid) != INVALID_CRIMINAL_ZONE_ID)
        {
            new faction_playerid = p_info[playerid][member];
            new faction_damagedid = p_info[damagedid][member];
            if(faction_playerid != faction_damagedid)
            {
                new i = GetCaptureID(faction_playerid, faction_damagedid);
                if(i != -1)
                {
                    p_temp[playerid][CaptureBizWarInfoFloat][0] += amount;
                    p_temp[damagedid][CaptureBizWarInfoFloat][1] += amount;

                    p_info[playerid][ftop_gdamagegive_week] += amount;
                    MysqlUpdatePlayerFloat(playerid, "ftop_gdamagegive_week", p_info[playerid][ftop_gdamagegive_week]);

                    p_info[damagedid][ftop_gdamagetake_week] += amount;
                    MysqlUpdatePlayerFloat(damagedid, "ftop_gdamagetake_week", p_info[damagedid][ftop_gdamagetake_week]);
                }
            }
        }
    }

    if(damagedid != INVALID_PLAYER_ID && p_temp[playerid][cossack_robbers_register] == 2 && p_temp[damagedid][cossack_robbers_register] == 2)
    {
        new faction_playerid = p_temp[playerid][cossack_robbers_team];
        new faction_damagedid = p_temp[damagedid][cossack_robbers_team];

        if(faction_playerid != faction_damagedid)
        {
            p_temp[playerid][cossack_robbers_give] += amount;
            p_temp[damagedid][cossack_robbers_take] += amount;
        }
    }

    if(damagedid != INVALID_PLAYER_ID && (mafia(playerid) && mafia(damagedid) || biker(playerid) && biker(damagedid) || mafia(playerid) && biker(damagedid) || biker(playerid) && mafia(damagedid)))
    {
        new faction_playerid = p_info[playerid][member];
        new faction_damagedid = p_info[damagedid][member];
        if(faction_playerid != faction_damagedid)
        {
            if(biz_war_gangzone != -1 && IsPlayerToSquare(damagedid, BizWar_Info [ bWarPos ] [ 0 ], BizWar_Info [ bWarPos ] [ 1 ], BizWar_Info [ bWarPos ] [ 2 ], BizWar_Info [ bWarPos ] [ 3 ]))
            {
                if((BizWar_Info[bMafia][0] == faction_playerid || BizWar_Info[bMafia][1] == faction_playerid)
                && (BizWar_Info[bMafia][0] == faction_damagedid || BizWar_Info[bMafia][1] == faction_damagedid))
                {
                    p_temp[playerid][CaptureBizWarInfoFloat][0] += amount;
                    p_temp[damagedid][CaptureBizWarInfoFloat][1] += amount;
                }
            }
        }
    }
    CheckFamilyDamage(playerid, damagedid, amount);
    return 1;
}

public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
    if(p_info[playerid][loggedIn] != 1)
        return 0;
    if(!SRV_ID) SendMesAll(-1, "OnPlayerWeaponShot: playerid = %d weaponid = %d hittype = %d hitid = %d fX = %f fY = %f fZ = %f", playerid, weaponid, hittype, hitid, fX, fY, fZ);
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER && weaponid != 38 && !(21 < weaponid < 35))
        return 0;
    if(weaponid > 47 && hittype == 0 && fX == 0.0000 && hitid == 0 && fY == 0.0000 && fZ == 0.0000)
        return 0;
    if(weaponid == 38)
        return 0;

    // anticheat:
    if((!(22 <= weaponid <= 34) && weaponid != 38) || IsPlayerPausedAC(playerid) || !FastBullet(playerid, weaponid)) return 0;

	new weap, ammo, slot = WeaponSlots[weaponid];
  	GetPlayerWeaponData(playerid, slot, weap, ammo);
	playerAmmo[playerid][slot]--;

	if(!CheatStatus[AC_AMMO] && ammo > (playerAmmo[playerid][slot] + 5))
	{
        CheatCount[AC_AMMO]++;
        return 0;
    }
    if(!CheatStatus[AC_WEAPON] && weaponid != playerWeapon[playerid][slot])
    {
        CheatCount[AC_WEAPON]++;
        return 0;
    }
    new Float:topldist;
	switch(hittype)
	{
		case BULLET_HIT_TYPE_PLAYER:
		{
			if(!IsPlayerConnected(hitid) || IsPlayerPausedAC(hitid)) return 0;
            new Float:ac_pos_x, Float:ac_pos_y, Float:ac_pos_z;
			GetPlayerPos(hitid, ac_pos_x, ac_pos_y, ac_pos_z);
		 	if((topldist = GetPlayerDistanceFromPoint(playerid, ac_pos_x, ac_pos_y, ac_pos_z)) > MaxDistShot[weaponid - 22]) return 0;

		 	new Float:ac_pos_n, Float:ac_pos_sz, Float:lac_pos_z;
		 	GetPlayerPos(playerid, ac_pos_n, ac_pos_n, lac_pos_z);
			GetPlayerLastShotVectors(playerid, ac_pos_n, ac_pos_n, ac_pos_n, ac_pos_n, ac_pos_n, ac_pos_sz);

			if(!CheatStatus[AC_DAMAGER] && !IsPlayerMobile(playerid) && floatabs(fZ - (ac_pos_sz-lac_pos_z)) > 0.35)
			{
				CheatCount[AC_DAMAGER]++;
		        AddWarning(playerid, CheatName[AC_DAMAGER]);
		        return 0;
		    }
		}
		case BULLET_HIT_TYPE_VEHICLE:
		{
			if(!GetVehicleModel(hitid)) return 0;
			if(GetVehicleDriverIDAC(hitid) == INVALID_PLAYER_ID) return 0;
		}
		case BULLET_HIT_TYPE_OBJECT: if(!IsValidObject(hitid)) return 0;
		case BULLET_HIT_TYPE_PLAYER_OBJECT: if(!IsValidPlayerObject(playerid, hitid)) return 0;
	}
	CheckProcetShot(playerid, hittype);

    if(hittype == BULLET_HIT_TYPE_PLAYER && hitid != INVALID_PLAYER_ID)
    {
        if(!IsPlayerStreamedIn(hitid, playerid))
            return 0;
        if(!CheckPlayerDM(playerid)) return 0;
        if(!PacifistMode(hitid, playerid)) return 0;
        if((weaponid == WEAPON_SILENCED || weaponid == WEAPON_NITESTICK) && IsPlayerFractionPolice(playerid) && !IsPlayerFractionPolice(hitid) && RegisterPaintBall[playerid] != 2 && p_temp[playerid][cossack_robbers_register] != 2 && player_lobby_status[playerid] == false)
        {
            if(p_temp[hitid][tazer_dest] == true) SendError(playerid, "Игрок уже оглушен.");
            else
            {
                Fix_TogglePlayerControllable(hitid, 0);
                ApplyAnimationFix(hitid,"CRACK","crckidle2",3.0);
                p_temp[hitid][tazer_dest] = true;
                SetTimerEx("TazerEndTimer", 10000, 0, "i", hitid);

                STRING_GLOBAL[0] = EOS;
                f(STRING_GLOBAL, "оглушил(-а) %s", get_name(hitid));
                MeAction(playerid, STRING_GLOBAL);
            }
            return 0;
        }
        if((weaponid == WEAPON_SHOTGSPA) && IsPlayerFractionPolice(playerid) && !IsPlayerFractionPolice(hitid) && RegisterPaintBall[playerid] != 2 && p_temp[playerid][cossack_robbers_register] != 2 && player_lobby_status[playerid] == false)
        {
            if(p_temp[hitid][tazer_dest] == true) SendError(playerid, "Игрок уже оглушен.");
            else
            {
                Fix_TogglePlayerControllable(hitid, 0);
                GoUseAnim(hitid,"WUZI","CS_Dead_Guy",4.1,0,1,1,1,0);
                p_temp[hitid][tazer_dest] = true;
                SetTimerEx("TazerEndTimer", 10000, 0, "i", hitid);

                STRING_GLOBAL[0] = EOS;
                f(STRING_GLOBAL, "оглушил(-а) %s", get_name(hitid));
                MeAction(playerid, STRING_GLOBAL);
            }
            return 0;
        }
        if((AntiDMZone(playerid, true) || AntiDMZone(hitid, true) || p_info[playerid][jail_time] > 0) && p_info[playerid][admin] < 10)
        {
            ShowPlayerDialog(playerid, D_DM_ZONE, DIALOG_STYLE_MSGBOX, ""I"Зеленая зона", ""W"Вы находитесь в {"#cGREEN"}\"зеленой зоне\","W" здесь запрещено драться!", "ОК", "");
            ClearAnimations(playerid);
            ApplyAnimation(playerid,"MISC","plyr_shkhead",4.0,0,0,0,0,0,1);
            return 0;
        }
        if(GetPlayerStatusCapture(hitid) == CAPTURE_ID_GANG || GetPlayerStatusCapture(hitid) == CAPTURE_ID_MAFIA) /*|| GetPlayerStatusCapture(playerid) == CAPTURE_ID_FAMILY*/
        {
            if(p_info[playerid][member] == p_info[hitid][member])
            {
                GameTextForPlayer(playerid, "~r~ANTI TEAM KILL", 1000, 3);
                return 0;
            }

            if(gang(hitid))
            {
                new faction_playerid = p_info[playerid][member],
                    faction_target = p_info[hitid][member];
                if(faction_playerid != faction_target)
                {
                    new id = GetCaptureID(faction_playerid, faction_target);
                    if(id != -1)
                    {
                        if(!IsPlayerMobile(playerid) && GetGangPC(p_info[playerid][member]) != p_info[playerid][ID])
                        {
                            GameTextForPlayer(playerid, "~r~You are not a registered PC", 1000, 3);
                            return 0;
                        }

                        if((IsGangSpawnKill(playerid) == p_info[playerid][member] || IsGangSpawnKill(hitid) == p_info[hitid][member]) && 
                            (Capture_Info[id][gTime] > 190 || Capture_Info[id][gStatus] == GANG_ZONE_PREPARATION))
                        {
                            STRING_GLOBAL[0] = EOS;
                            new diff = Capture_Info[id][gStatus] == GANG_ZONE_PREPARATION ? 20*60 : 0;
                            f(STRING_GLOBAL, "~r~Spawn Damage is blocked %s", ConvertTime(diff+Capture_Info[id][gTime]-190, 1));
                            GameTextForPlayer(playerid, STRING_GLOBAL, 1000, 3);
                            return 0;
                        }
                        if(p_temp[playerid][GM_MODE_Time] != 0 || p_temp[hitid][GM_MODE_Time] != 0)
                        {
                            f(STRING_GLOBAL, "~r~Damage is blocked %d seconds", p_temp[playerid][GM_MODE_Time] > 0 ? p_temp[playerid][GM_MODE_Time] : p_temp[hitid][GM_MODE_Time]);
                            GameTextForPlayer(playerid, STRING_GLOBAL, 1000, 3);
                            return 0;
                        }
                    }
                    else
                    {
                        GameTextForPlayer(playerid, "~r~Damage is blocked", 1000, 3);
                        return 0;
                    }
                }
            }
        }
        p_temp[hitid][fix_shot] = timestamp+5;
    }

    if(weaponid == WEAPON_SHOTGUN && hittype == BULLET_HIT_TYPE_VEHICLE && (IsPlayerFractionPolice(playerid) && p_info[playerid][rang] > 5))
    {
        if(random(100) < 70)
        {
            if(!IsValidVehicle(hitid)) return 0;
            if((GetVehicleData(GetVehicleModelEx(hitid), E_VD_TYPE) == VEHICLE_STATE_VELO_MOPED ||
                GetVehicleData(GetVehicleModelEx(hitid), E_VD_TYPE) == VEHICLE_STATE_CAR ||
                GetVehicleData(GetVehicleModelEx(hitid), E_VD_TYPE) == VEHICLE_STATE_MOTO) && veh_info[hitid][v_timer_engine_off] == 0)
            {
                SetVehicleParamsVEx(hitid, false, veh_info[hitid][v_light], alarm, veh_info[hitid][v_lock], bonnet, boot, objective);
                veh_info[hitid][v_timer_engine_off] = 5+random(10);
                SendAccess(playerid, "Двигатель был выведен из строя на %d секунд.", veh_info[hitid][v_timer_engine_off]);
            }
        }
        MeAction(playerid, "выпустил электро-магнитный импульс");
    }

    new weap_slot = WEAPON_Slot[weaponid];
    if(p_info[playerid][Weapon][weap_slot] == weaponid)
    {
        if(p_info[playerid][Ammo][weap_slot] > 0) p_info[playerid][Ammo][weap_slot]--;
    }

    if(hittype == BULLET_HIT_TYPE_OBJECT && (weaponid == 25 || weaponid == 30 || weaponid == 31) && p_temp[playerid][Work_ID] == HUNTING_WORK && HuntingStatus[playerid] == true && HuntingIDx[playerid] != -1)
    {
        if(IsPlayerInRangeOfPoint(playerid, 1000.0, -1313.7373,-2189.4028,24.7333))
        {
            for(new i; i < sizeof(HuntingInfo); i++)
            {
                if(hitid == HuntingInfo[i][hObject])
                {
                    if(HuntingInfo[i][hStatus] == HUNTING_DEER_STATUS_CREATE)
                    {
                        if(HuntingInfo[i][hPlayerID] != playerid) return SendError(playerid, "Вы ошиблись, этот олень для другого охотника.");
                        SetPlayerHunting(playerid);
                        break;
                    }
                }
            }
        }
        return 1;
    }

    //damage system:
    if(hittype == BULLET_HIT_TYPE_PLAYER || hittype == BULLET_HIT_TYPE_VEHICLE)
	{
		if(!CheatStatus[AC_DAMAGESYS])
		{
		    CheatCount[AC_DAMAGESYS]++;
			DamageSystem(playerid, weaponid, hitid, hittype, topldist);
            return 0;
		}
	}

    CCTV_OnPlayerWeaponShot(playerid, weaponid);
    return 1;
}
public OnPlayerShootDynamicObject(playerid, weaponid, objectid, Float:x, Float:y, Float:z)
{
    CCTV_OnPlayerShootDynamicObject(playerid, weaponid, objectid);
    return 1;
}

forward TazerEndTimer(playerid);
public TazerEndTimer(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    Fix_TogglePlayerControllable(playerid, 1);
    ClearAnimations(playerid, true);
    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
    ApplyAnimation(playerid,"FAT","IDLE_tired", 4.0, 0, 0, 0, 0, 1);
    p_temp[playerid][tazer_dest] = false;
    return 1;
}

CheckDMAnalyze(playerid, targetid)
{
    new pWeapon = GetPlayerWeapon(playerid);
    if( targetid != playerid &&
        p_info[playerid][p_settings][STATUS_REPORT_DM] == 0 &&
        player_lobby_status[playerid] != true && player_lobby_status[targetid] != true &&
        p_info[playerid][admin] < 1 &&
        GetPlayerWeapon(targetid) == 0 &&
        pSpectatorId[playerid] == INVALID_PLAYER_ID &&
        p_info[playerid][jail] == 0 && p_info[targetid][jail] == 0 &&
        p_temp[playerid][DuelID] == INVALID_PLAYER_ID &&
        GetPlayerStatusCapture(targetid) == CAPTURE_ID_NONE && GetPlayerStatusCapture(playerid) == CAPTURE_ID_NONE &&
        p_temp[targetid][SparringID] == -1 && p_temp[playerid][SparringID] == -1)
    {
        if(p_temp[playerid][anti_dm_oldtargetid] == targetid)
        {
            new Float:target_hp;
            GetPlayerHealth(targetid, target_hp);

            p_temp[playerid][anti_dm_count]++;
            if (p_temp[playerid][anti_dm_count] >= 8 && (pWeapon >= 0 && pWeapon <= 15) || // Кулачные
                p_temp[playerid][anti_dm_count] >= 2 && (pWeapon >= 22 && pWeapon <= 27) || // Пистолеты + дробовики
                p_temp[playerid][anti_dm_count] >= 4 && (pWeapon == 31 || pWeapon == 30)  ||// M4, AK
                target_hp < 30.0)
            {
                new admin_count;
                foreach(new i: gAdmins)
                {
                    if(p_temp[i][avto_dm_check] == true && GetPlayerState(i) == PLAYER_STATE_ONFOOT && p_info[i][p_afkTime] < 2)
                    {
                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, "%d",  playerid);
                        callcmd::recon(i, STRING_GLOBAL);

                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s[%d] возможно DM %s[%d] администратор %s отправлен в рекон.",
                            get_name(playerid), playerid, get_name(targetid), targetid, get_name(i));
                        SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);
                        admin_count++;

                        /*a_info[i][a_ans] = 1;
                        MysqlUpdateAdminInt(i, "a_ans", a_info[i][a_ans]);*/
                        break;
                    }
                }
                /*
                if(!admin_count)
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s[%d] возможно DM %s[%d] - ПРОВЕРЬТЕ(!).",
                        get_name(playerid), playerid, get_name(targetid), targetid);
                    SendAdminMessage(COLOR_LIGHTRED, STRING_GLOBAL);
                }
                */
                if(ServerInfo[FreezeOnDM])
                {
                    Fix_TogglePlayerControllable(playerid, 0);

                    p_temp[playerid][UnFreezeFix] = 1;
                    p_temp[playerid][UnFreezeTimerFix] = timestamp + 2;
                    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, "Подозрение в ДМ", "Вы подозреваетесь в DM, система заморозила вас на 3 секунды.\nВнимание, DM - наказуемое нарушение правил(!).", "Понял", "");
                }
            }
        }
        else
        {
            p_temp[playerid][anti_dm_oldtargetid] = targetid;
            p_temp[playerid][anti_dm_count] = 1;
        }
    }
}

CheckPlayerDM(playerid)
{
    if(ServerInfo[AntiDMSystem])
    {
        if( p_info[playerid][level] < 5 &&
            p_info[playerid][member] == 0 &&
            p_info[playerid][Lic][LIC_WEAPON] != 1 &&
            GetPlayerVirtualWorld(playerid) == 0 &&
            GetPlayerInterior(playerid) == 0 &&
            RegisterPaintBall[playerid] != 2 &&
            p_temp[playerid][cossack_robbers_register] != 2 &&
            player_lobby_status[playerid] != true)
        {
            ShowPlayerDialog(playerid, D_DM_ZONE, DIALOG_STYLE_MSGBOX, ""I"Вам запрещено наносить урон", ""W"\
            Если Вы не состоите во фракции, у Вас нет лицензии на оружие и Вы не участвуете в мероприятии,\n\
            то до "I"5-ого уровня"W" Вам запрещено наносить урон другим игрокам.", "ОК", "");
            return 0;
        }
    }
    return 1;
}
///////////////////////////////////////////
// treiler systems
GetPlayerCheckTreiler(mysql_id)
{
    new Cache: result, rows;
    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `v_mysql_id` FROM `vehicle` WHERE `v_owner_id` = %d AND `v_model` = 508", mysql_id);
    result = mysql_query(con_bd, STRING_GLOBAL);
    rows = cache_num_rows();
    cache_delete(result);
    return rows;
}

GetPlayerCountCars(idx, type)
{
    new count = 0;
    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `v_mysql_id`, `v_owner_id`, `v_model` FROM `vehicle` WHERE `v_owner_id` = %d", idx);
    new Cache:result = mysql_query(con_bd, STRING_GLOBAL);
    if(cache_num_rows())
    {
        new modelid;
        for(new i; i < cache_num_rows(); i++)
        {
            cache_get_value_name_int(i, "v_model", modelid);
            if(GetVehicleData(modelid, E_VD_TYPE) == type) count++;
        }
    }
    cache_delete(result);
    return count;
}

SpawnToTreiler(playerid, vehicleid)
{
    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "Произошла не известная ошибка: ST3107");
    SetPlayerPos(playerid, 4511.3545,-1724.8218,778.6371);
    SetPlayerFacingAngle(playerid, 180.0);
    SetCameraBehindPlayer(playerid);
    SetPlayerInterior(playerid, vehicleid);
    SetPlayerVirtualWorld(playerid, vehicleid);
    Fix_TogglePlayerControllable(playerid, 0);

    p_temp[playerid][UnFreezeFix] = 1;
    p_temp[playerid][UnFreezeTimerFix] = timestamp + 2;

    p_temp[playerid][in_enter_vehicle] = vehicleid;
    return 1;
}

/////////////////////////////////////////////////////////////////////////
LoadACSettings()
{
    new DB:db = db_open("anticheat.db");
/*
    CREATE TABLE "anticheat" (
    "id"    INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT UNIQUE,
    "name"    TEXT,
    "value"    INTEGER DEFAULT 1,
    "maxwarns"    INTEGER DEFAULT 3)
*/
    new DBResult:res = db_query(db, "SELECT * FROM anticheat");

    for(new i, num_rows = db_num_rows(res); i < num_rows; i++)
    {
        db_get_field_assoc(res, "name", AntiCheat[i][acName], 64);
        AntiCheat[i][acValue] = db_get_field_assoc_int(res, "value");
        AntiCheat[i][acMaxWarns] = db_get_field_assoc_int(res, "maxwarns");
        db_next_row(res);
    }

    db_close(db);
}
ShowSetMaxWarns(const playerid, const cheat)
{
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Текущее значение: %d\n\nНовое значение:", AntiCheat[cheat][acMaxWarns]);
    ShowPlayerDialog(playerid, D_AC_SETMAXWARNS, DIALOG_STYLE_INPUT, ""I"Количество предупреждений до кика",
        STRING_GLOBAL, "ОК", "Назад");
    return 1;
}

ShowCheatList(const playerid, const dialogid)
{
    if(dialogid == D_AC_PANEL)
    {
        ShowPlayerDialog(playerid, D_AC_PANEL, DIALOG_STYLE_LIST,
            ""I"Управление античитом",
            ""I"[1]"W" Включить/выключить\n"I"[2]"W" Количество предупреждений до кика", "Выбрать", "Закрыть");
        return 1;
    }

    new num[4];

    STRING_GLOBAL[0] = EOS;
    for(new i; i < sizeof AntiCheat; i++)
    {
        strcat(STRING_GLOBAL, AntiCheat[i][acName]);
        strcat(STRING_GLOBAL, "\t");
        if(dialogid == D_AC_ONOFF)
        {
            strcat(STRING_GLOBAL, AntiCheat[i][acValue] ? ("{1cb81c}") : ("{ff6347}"));
            strcat(STRING_GLOBAL, AntiCheat[i][acValue] ? ("true") : ("false"));
        }
        else
        {
            valstr(num, AntiCheat[i][acMaxWarns]);
            strcat(STRING_GLOBAL, num);
        }
        strcat(STRING_GLOBAL, "\n");
    }

    ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_TABLIST,
        dialogid == D_AC_ONOFF ? ("Включить/выключить") : ("Количество предупреждений до кика"),
        STRING_GLOBAL, "Выбрать", "Назад");
    return 1;
}

SaveAntiCheat(const cheat)
{
    static const fqstr[] = "UPDATE `anticheat` SET `value` = %d, `maxwarns` = %d WHERE `id` = %d";
    new qstr[sizeof fqstr + 1];
    format(qstr, sizeof qstr, fqstr, AntiCheat[cheat][acValue], AntiCheat[cheat][acMaxWarns], cheat + 1);

    new DB:db = db_open("anticheat.db");
    db_free_result(db_query(db, qstr));
    db_close(db);
}

///////////////////////////////////////////////
// слет имущества
CheckHouse()
{
    new bool:check_house = false,
        playerid,
        city;

    for(new h = 0; h < totalhouses; h++)
    {
        if(h_info[h][h_mysql_id] == INVALID_MYSQL_ID) continue;
        if(timestamp_hour == 20)
        {
            if(h_info[h][h_paydays_received] == -1) h_info[h][h_rent] = 0;
        }
        if(h_info[h][h_auction_bet] > 0)
        {
            if(h_info[h][h_auction_user_id] == INVALID_MYSQL_ID) continue;
            if(h_info[h][h_auction_time] > 0) h_info[h][h_auction_time]--;
            check_house = false;
            if(h_info[h][h_auction_time] <= 0)
            { //отдаем победителю аукциона дом
                playerid = GetPlayerUserID(h_info[h][h_auction_user_id]);
                if(playerid != INVALID_PLAYER_ID)
                {
                    if(GetFreeSlotHouse(playerid) == ALL_BUSY_SLOT_HOUSE || p_info[playerid][key_h_rent] != INVALID_HOUSE_ID)
                    {
                        SendError(playerid, "У Вас уже есть дом или Вы подселены.");
                        SendInfo(playerid, "Вам возвращено %d$ с послед. ставки.", (h_info[h][h_auction_bet]/100)*90);
                        p_info[playerid][bank] += (h_info[h][h_auction_bet]/100)*90;
                        MysqlUpdatePlayerInt(playerid, "bank",  p_info[playerid][bank]);
                        check_house = true;
                    }
                    SetFreeSlotHouse(playerid, h);
                    strmid(h_info[h][h_owner], get_name(playerid), 0, strlen(get_name(playerid)), MAX_PLAYER_NAME);
                    p_info[playerid][spawn] = SPAWN_HOUSE;
                    SendInfo(playerid, "Вы выиграли на аукционе \"Дом № %d\". Ставка: %d$.", h, h_info[h][h_auction_bet]);

                    //lastlog(BUY_HOUSE_GOS,"покупка дома аукционе", h_info[h][h_mysql_id], playerid, playerid, -h_info[h][h_auction_bet]);
                    // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) купил на аукционе дом (%d)[%d] за %d$
                    // [logs] реализовать получение версии клиента
                    Log(LOG_player, INFO, "%s[%d](%s %s) купил на аукционе дом (%d)[%d] за %d$",
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                        h, h_info[h][h_mysql_id], h_info[h][h_auction_bet]);

                    CheckPlayerMission(playerid, START_HOUSE);
                }
                else
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `house` WHERE `h_user_id` = %d OR\
                        `h_r_user_id_0` = %d OR `h_r_user_id_1` = %d OR `h_r_user_id_2` = %d OR `h_r_user_id_3` = %d OR `h_r_user_id_4` = %d LIMIT 1",
                        h_info[h][h_auction_user_id], h_info[h][h_auction_user_id], h_info[h][h_auction_user_id], h_info[h][h_auction_user_id], h_info[h][h_auction_user_id], h_info[h][h_auction_user_id]);
                    new Cache:result = mysql_query(con_bd, STRING_GLOBAL);

                    if(cache_num_rows() != 0)
                    {
                        STRING_GLOBAL[0] = EOS;
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank` = `bank` + %d WHERE `id` = %d",
                        h_info[h][h_auction_bet]-(h_info[h][h_auction_bet]/10), h_info[h][h_auction_user_id]);
                        mysql_tquery(con_bd, STRING_GLOBAL);
                        check_house = true;
                    }
                    else
                    {
                        STRING_GLOBAL[0] = EOS;
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name` FROM `accounts` WHERE `id` = %d LIMIT 1",
                        h_info[h][h_auction_user_id]);
                        mysql_tquery(con_bd, STRING_GLOBAL, "set_new_owner", "ii", h, 0);

                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, ""W"Вы успешно приобрели дом "I"№%d победив на аукционе", h);
                        AddNotify(h_info[h][h_auction_user_id], STRING_GLOBAL);

                        //lastlog(FLY_HOUSE_PLAYER,"Покупка дома аукционе [offline]", h_info[h][h_mysql_id], -1, -1, -h_info[h][h_auction_bet], h_info[h][h_owner]);
                    }
                    cache_delete(result);
                }
                if(check_house == true)
                {
                    h_info[h][h_auction_bet] /= 2;
                    h_info[h][h_auction_user_id] = INVALID_MYSQL_ID;
                    save_house(h);
                }
                else
                {
                    if(h_info[h][h_user_id] != INVALID_MYSQL_ID) //владельцу дома отдаем деньги по окончанию аукциона
                    {
                        playerid = GetPlayerUserID(h_info[h][h_user_id]);
                        if(playerid != INVALID_PLAYER_ID)
                        {
                            p_info[playerid][spawn] = p_info[playerid][bank];

                            SendInfo(playerid, "Вам возвращено %d$ с последней ставки.", (h_info[h][h_auction_bet]/100)*90);
                            p_info[playerid][bank] += (h_info[h][h_auction_bet]/100)*90;
                            MysqlUpdatePlayerInt(playerid, "bank",  p_info[playerid][bank]);

                            ClearOwnerHouse(playerid, h);
                        }
                        else
                        {
                            STRING_GLOBAL[0] = EOS;
                            f(STRING_GLOBAL, ""W"Вам возвращено %d$ с последней ставки на дом "I"№%d", (h_info[h][h_auction_bet]/100)*90, h);
                            AddNotify(h_info[h][h_user_id], STRING_GLOBAL);

                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank` = `bank` + %d, `spawn` = 0 WHERE `id` = %d",
                            h_info[h][h_auction_bet]-(h_info[h][h_auction_bet]/10), h_info[h][h_user_id]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                        }
                    }

                    new family_idx = GetFamilyIDFromHouseID(h);
                    if(family_idx != -1)
                    {
                        DeleteFamilyVehicle(family_idx);

                        FamilyData[family_idx][fHouseID] = INVALID_HOUSE_ID;
                        h_info[h][h_family_id] = -1;

                        SendFamilyMessage(family_idx, "Дом семьи слетел из-за продажи на аукционе.");
                    }

                    h_info[h][h_user_id] = h_info[h][h_auction_user_id];
                    h_info[h][h_lock] = 1;
                    h_info[h][h_garage_lock] = 1;
                    h_info[h][h_rent] = 24;
                    h_info[h][h_owned_at] = timestamp;
                    h_info[h][h_paydays_received] = 0;
                    //set default house new
                    h_info[h][h_int] =
                    h_info[h][h_improve][SUBSIDY] =
                    h_info[h][h_improve][RENTERS] =
                    h_info[h][h_improve][BASEMENT] =
                    h_info[h][h_improve][UNDERGROUND] = 0;
                    h_info[h][h_family_id] = -1;

                    ClearInventoryItems(h_info[h][h_mysql_id], INVENTORY_OWNER_TYPE_HOUSE);

                    for(new i = 0; i < 28; i++) h_info[h][h_garden_items][i] = 0;
                    h_info[h][h_panel_items] = 0;
                    for(new i = 1; i <= totalgarden; i++)
                    {
                        if(GardenInfo[i][gHouseIDx] != h) continue;
                        DestroyGarden(i);
                    }
                    for(new i = 1; i <= totalpanel; i++)
                    {
                        if(PanelHouseInfo[i][PanelHouseIDx] != h) continue;
                        DestroyPanel(i);
                    }
                    for(new i = 1; i <= totalvideocards; i++)
                    {
                        if(VideoCardsInfo[i][vcHouseIDx] != h) continue;
                        DestroyVideoCards(i);
                    }
                    for(new i = 1; i <= totalundergroundbots; i++)
                    {
                        if(UndergroundBotsInfo[i][ubHouseIDx] != h) continue;
                        DestroyUndergroundBots(i);
                    }

                    save_house_interior(h); // обнуление кастомный инты
                    save_garage_interior(h);

                    update_house(h);
                    save_house(h);
                    h_info[h][h_auction_bet] = 0;
                    h_info[h][h_auction_user_id] = INVALID_MYSQL_ID;
                }
            }
        }
        else
        {
            if(h_info[h][h_rent] > 0) h_info[h][h_rent]--;


            if(h_info[h][h_user_id] == INVALID_MYSQL_ID && h_info[h][h_delete] == 0 && SRV_ID)
            {
                h_info[h][h_delete_time]++;
                if(h_info[h][h_delete_time] == 24)
                {
                    h_info[h][h_delete] = 1;
                    if(IsValidDynamicMapIcon(h_info[h][h_icon])) DestroyDynamicMapIcon(h_info[h][h_icon]);
                    if(IsValidDynamic3DTextLabel(h_info[h][h_text])) DestroyDynamic3DTextLabel(h_info[h][h_text]);
                    if(IsValidDynamicPickup(h_info[h][h_pickup_enter])) DestroyDynamicPickup(h_info[h][h_pickup_enter]);
                    if(IsValidDynamic3DTextLabel(h_info[h][h_attic_text])) DestroyDynamic3DTextLabel(h_info[h][h_attic_text]);
                    if(IsValidDynamicArea(h_info[h][h_garage_area][0])) DestroyDynamicArea(h_info[h][h_garage_area][0]);
                    if(IsValidDynamic3DTextLabel(h_info[h][h_garage_text])) DestroyDynamic3DTextLabel(h_info[h][h_garage_text]);
                }
            }

            if(h_info[h][h_rent] <= 0 && h_info[h][h_user_id] != INVALID_MYSQL_ID)
            {
                city = GetCityName(h_info[h][h_enter][0], h_info[h][h_enter][1]);
                SendMesAll(COLOR_LIGHTRED, "Внимание! "W"Дом в городе %s был продан сервером. Причина: неуплата налогов.", gSAZonesCity[city][SAZONE_NAME]);

                if(h_info[h][h_paydays_received] == -1)
                    Log(LOG_player, INFO, "%s[%d](Offline) дом (%d)[%d] был продан сервером из-за недостаточного онлайна владельца за %d$",
                        h_info[h][h_owner], h_info[h][h_user_id], h, h_info[h][h_mysql_id], h_info[h][h_value]/2);
                else
                    Log(LOG_player, INFO, "%s[%d](Offline) дом (%d)[%d] был продан сервером из-за неуплату налогов за %d$",
                        h_info[h][h_owner], h_info[h][h_user_id], h, h_info[h][h_mysql_id], h_info[h][h_value]/2);

                playerid = GetPlayerUserID(h_info[h][h_user_id]);
                if(playerid != INVALID_PLAYER_ID)
                {
                    ClearOwnerHouse(playerid, h);
                    if(h_info[h][h_paydays_received] == -1) SendInfo(playerid, "У Вас забрали дом из-за недостаточного онлайна.");
                    else SendInfo(playerid, "У Вас забрали дом из-за не оплаты аренды.");
                    SendInfo(playerid, "Денежные средства за дом зачислены на банковский счет.");
                    OnServerInfoForMoney[3] += h_info[h][h_value]/2;
                    p_info[playerid][bank] += h_info[h][h_value]/2;
                    MysqlUpdatePlayerInt(playerid, "bank", p_info[playerid][bank]);

                    p_info[playerid][spawn] = SPAWN_DEFAULT;
                }
                else
                {
                    STRING_GLOBAL[0] = EOS;
                    if(h_info[h][h_paydays_received] == -1) f(STRING_GLOBAL, ""W"У Вас забрали дом "I"№%d "W"из-за недостаточного онлайна.\n"W"Вам возвращено за дом "I"%d$.", h, h_info[h][h_value]/2);
                    else f(STRING_GLOBAL, ""W"У Вас забрали дом "I"№%d "W"из-за не оплаты аренды .\n"W"Вам возвращено за дом "I"%d$.", h, h_info[h][h_value]/2);
                    AddNotify(h_info[h][h_user_id], STRING_GLOBAL);
                    OnServerInfoForMoney[3] += h_info[h][h_value]/2;

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `spawn` = 0, `bank` = `bank` + %d WHERE `id` = %d",
                    h_info[h][h_value]/2, h_info[h][h_user_id]);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                }

                h_info[h][h_user_id] = INVALID_MYSQL_ID;
                h_info[h][h_lock] =
                h_info[h][h_garage_lock] =
                h_info[h][h_attic_lock] =
                h_info[h][h_underground_lock] = 1;
                h_info[h][h_paydays_received] = 0;
                strmid(h_info[h][h_owner], "The State", 0, strlen("The State"), MAX_PLAYER_NAME);

                new family_idx = GetFamilyIDFromHouseID(h);
                if(family_idx != -1)
                {
                    DeleteFamilyVehicle(family_idx);
                    FamilyData[family_idx][fHouseID] = INVALID_HOUSE_ID;
                    h_info[h][h_family_id] = -1;

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `family` SET `house_id` = -1 WHERE `id` = %d",
                        FamilyData[family_idx][fMysqlID]);
                    mysql_tquery (con_bd, STRING_GLOBAL);

                    SendFamilyMessage(family_idx, "Дом семьи слетел из-за не уплаты.");
                }

                h_info[h][h_int] =
                h_info[h][h_improve][SUBSIDY] =
                h_info[h][h_improve][RENTERS] =
                h_info[h][h_improve][BASEMENT] =
                h_info[h][h_improve][UNDERGROUND] = 0;
                h_info[h][h_family_id] = -1;

                for(new i = 0; i < 28; i++) h_info[h][h_garden_items][i] = 0;
                h_info[h][h_panel_items] = 0;
                for(new i = 1; i <= totalgarden; i++)
                {
                    if(GardenInfo[i][gHouseIDx] != h) continue;
                    DestroyGarden(i);
                }
                for(new i = 1; i <= totalpanel; i++)
                {
                    if(PanelHouseInfo[i][PanelHouseIDx] != h) continue;
                    DestroyPanel(i);
                }
                for(new i = 1; i <= totalvideocards; i++)
                {
                    if(VideoCardsInfo[i][vcHouseIDx] != h) continue;
                    DestroyVideoCards(i);
                }
                for(new i = 1; i <= totalundergroundbots; i++)
                {
                    if(UndergroundBotsInfo[i][ubHouseIDx] != h) continue;
                    DestroyUndergroundBots(i);
                }
            }

            for(new i; i <= h_info[h][h_squar]; i++)
            {
                if( h_info[h][h_r_days][i] > 0) h_info[h][h_r_days][i]--;
                if(h_info[h][h_r_days][i] <= 0 && h_info[h][h_r_user_id][i] != INVALID_MYSQL_ID)
                {
                    playerid = GetPlayerUserID(h_info[h][h_r_user_id][i]);
                    if(playerid != INVALID_PLAYER_ID)
                    {
                        p_info[playerid][key_h_rent] = -1;
                        SendInfo(playerid, "У Вас выселили из дома из-за не оплаты аренды.");

                        p_info[playerid][spawn] = SPAWN_DEFAULT;

                        p_info[playerid][h_r_settings][R_GARAGE] =
                        p_info[playerid][h_r_settings][R_BASEMENT] =
                        p_info[playerid][h_r_settings][R_UNDERGROUND] = 0;

                        MysqlUpdatePlayerStr(playerid, "h_r_settings", "0|0|0");
                    }
                    else
                    {
                        STRING_GLOBAL[0] = EOS;
                        f(STRING_GLOBAL, ""W"Вас выселили из дома "I"№%d "W"из-за не оплаты аренды.", h);
                        AddNotify(h_info[h][h_r_user_id][i], STRING_GLOBAL);

                        STRING_GLOBAL[0] = EOS;
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `spawn` = 0, `h_r_settings` = '0|0|0|0' WHERE `id` = %d",
                        h_info[h][h_r_user_id][i]);
                        mysql_tquery(con_bd, STRING_GLOBAL);
                    }
                    h_info[h][h_r_user_id][i] = INVALID_MYSQL_ID;
                }
            }
            update_house(h);
            save_house(h);
        }
        h_info[h][h_robbery] = 0;
        h_info[h][h_robbery_count] = 10;
    }
}

CheckBizz()
{
    new bool:check_bizz = false,
        playerid;

    for(new b = 0; b < totalbizz; b++)
    {
        if(b_info[b][b_mysql_id] == INVALID_MYSQL_ID) continue;
        if(b_info[b][_tip] == B_OIL_RIG)
        {
            if(b_info[b][b_oil] < MAX_BIZ_OIL)
            {
                b_info[b][b_oil] += RandomEx(MIN_OIL_PRODUCTION, MAX_OIL_PRODUCTION);
                if(b_info[b][b_oil] > MAX_BIZ_OIL) b_info[b][b_oil] = MAX_BIZ_OIL;
                update_bizz(b, 1);
            }
        }
        if(b_info[b][b_mafia] == MAFIA_RM)
        {
            SetFractionWarehouse(MAFIA_RM, fwMoney, gBankMafia[BANK_RM][b]);
            gBankMafia[BANK_RM][b] = 0;
        }
        if(b_info[b][b_mafia] == MAFIA_LCN)
        {
            SetFractionWarehouse(MAFIA_LCN, fwMoney, gBankMafia[BANK_LCN][b]);
            gBankMafia[BANK_LCN][b] = 0;
        }
        if(b_info[b][b_mafia] == MAFIA_YAKUDZA)
        {
            SetFractionWarehouse(MAFIA_YAKUDZA, fwMoney, gBankMafia[BANK_YAKUZA][b]);
            gBankMafia[BANK_YAKUZA][b] = 0;
        }
        if(b_info[b][b_mafia] == BIKER)
        {
            SetFractionWarehouse(BIKER, fwMoney, gBankMafia[BANK_BIKER][b]);
            gBankMafia[BANK_BIKER][b] = 0;
        }
        if(b_info[b][b_mafia] == MAFIA_IRAN)
        {
            SetFractionWarehouse(MAFIA_IRAN, fwMoney, gBankMafia[BANK_IRAN][b]);
            gBankMafia[BANK_IRAN][b] = 0;
        }

        if(b_info[b][b_user_id] != INVALID_MYSQL_ID && b_info[b][b_owned_at]+2629743 < timestamp)
        {
            if(b_info[b][b_paydays_received] >= 5)
            {
                b_info[b][b_owned_at] = timestamp;
                b_info[b][b_paydays_received] = 0;
            }
            else
            {
                if(ServerInfo[OnlineBizzSystem])
                {
                    b_info[b][b_paydays_received] = -1;
                    if(15 <= timestamp_hour <= 22)
                        b_info[b][b_rent] = 0;
                }
                else
                {
                    printf("[TOWB]: bizz_id: %d", b);
                    b_info[b][b_owned_at] = timestamp;
                    b_info[b][b_paydays_received] = 0;
                }
            }
        }

        if(b_info[b][b_auction_bet] > 0)
        {
            if(b_info[b][b_auction_user_id] != INVALID_MYSQL_ID)
            {
                if(b_info[b][b_auction_time] > 0) b_info[b][b_auction_time]--;
                check_bizz = false;
                if(b_info[b][b_auction_time] <= 0)
                { //отдаем победителю аукциона бизнес
                    playerid = GetPlayerUserID(b_info[b][b_auction_user_id]);
                    if(playerid != INVALID_PLAYER_ID)
                    {
                        if(GetFreeSlotBizz(playerid) == ALL_BUSY_SLOT_BIZZ) {
                            SendError(playerid, "У Вас нет свободного слота для бизнеса.");
                            SendInfo(playerid, "Вам возвращено %d$ с послед. ставки.", (b_info[b][b_auction_bet]/100)*90);
                            p_info[playerid][bank] += (b_info[b][b_auction_bet]/100)*90;
                            MysqlUpdatePlayerInt(playerid, "bank",  p_info[playerid][bank]);
                            check_bizz = true;
                        }
                        SetFreeSlotBizz(playerid, b);

                        strmid(b_info[b][_owner], get_name(playerid), 0, strlen(get_name(playerid)), MAX_PLAYER_NAME);

                        SendInfo(playerid, "Вы выиграли на аукционе \"%s\". Ставка: %d$.", b_info[b][_name], b, b_info[b][b_auction_bet]);
                        //lastlog(BUY_BIZZ_GOS,"покупка бизнеса аукционе", b_info[b][b_mysql_id], playerid, playerid, -b_info[b][b_auction_bet]);
                        // [logs] реализовать получение версии клиента
                        // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) купил через аукцион бизнес <%s - %s>(%d)[%d] за %d$
                        Log(LOG_player, INFO, "%s[%d](%s %s) купил через аукцион бизнес <%s - %s>(%d)[%d] за %d$",
                            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                            b_info[b][_name], bizz_type_name[b_info[b][_tip]], b, b_info[b][b_mysql_id], b_info[b][b_auction_bet]);
                    }
                    else
                    {
                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `b_mysql_id` FROM `biz` WHERE `b_user_id` = %d LIMIT 1",
                        b_info[b][b_auction_user_id]);
                        new Cache:result = mysql_query(con_bd, STRING_GLOBAL);

                        if(cache_num_rows() != 0)
                        {
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank` = `bank` + %d WHERE `id` = %d",
                            (b_info[b][b_auction_bet]/100)*90, b_info[b][b_auction_user_id]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                            check_bizz = true;
                        }
                        else
                        {
                            STRING_GLOBAL[0] = EOS;
                            f(STRING_GLOBAL, ""W"Вы приобрели бизнес "I"№%d "W"на аукционе.", b);
                            AddNotify(b_info[b][b_auction_user_id], STRING_GLOBAL);

                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `name` FROM `accounts` WHERE `id` = %d LIMIT 1", b_info[b][b_auction_user_id]);
                            mysql_tquery(con_bd, STRING_GLOBAL, "set_new_owner", "ii", b, 1);

                            //lastlog(FLY_BIZZ_PLAYER,"Покупка бизнеса аукциона [offline]", b_info[b][b_mysql_id], -1, -1, -b_info[b][b_auction_bet], b_info[b][_owner]);
                        }
                        cache_delete(result);
                    }
                    if(check_bizz == true)
                    {
                        b_info[b][b_auction_bet] /= 2;
                        b_info[b][b_auction_user_id] = INVALID_MYSQL_ID;
                        save_bizz(b);
                        continue;
                    }
                    if(b_info[b][b_user_id] != INVALID_MYSQL_ID)
                    {
                        playerid = GetPlayerUserID(b_info[b][b_user_id]);
                        if(playerid != INVALID_PLAYER_ID)
                        {
                            Log(LOG_player, INFO, "%s[%d](%s %s)[%d$] получил %d$ за ставку с аукциона бизнеса %s[%d] | #Auction",
                                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                                p_info[playerid][bank], b_info[b][b_auction_bet]-(b_info[b][b_auction_bet]/10), b_info[b][_name], b_info[b][b_mysql_id]);

                            SendInfo(playerid, "Вам возвращено %d$ с послед. ставки.", (b_info[b][b_auction_bet]/100)*90);
                            p_info[playerid][bank] += (b_info[b][b_auction_bet]/100)*90;
                            MysqlUpdatePlayerInt(playerid, "bank",  p_info[playerid][bank]);

                            ClearOwnerBizz(playerid, b);
                        }
                        else
                        {
                            Log(LOG_player, INFO, "NickName[%d](Offline) получил %d$ за ставку с аукциона бизнеса [%d] | #Auction",
                                b_info[b][b_user_id], (b_info[b][b_auction_bet]/100)*90, b_info[b][b_mysql_id]);

                            STRING_GLOBAL[0] = EOS;
                            f(STRING_GLOBAL, ""W"Вы продали бизнес "I"№%d "W"на аукционе, Ваш доход: "I"%d$.", b, (b_info[b][b_auction_bet]/100)*90);
                            AddNotify(b_info[b][b_user_id], STRING_GLOBAL);

                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank` = `bank` + %d WHERE `id` = %d",
                            b_info[b][b_auction_bet]-(b_info[b][b_auction_bet]/10), b_info[b][b_user_id]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                        }
                    }
                    b_info[b][b_owned_at] = timestamp;
                    b_info[b][b_paydays_received] = 0;
                    b_info[b][b_user_id] = b_info[b][b_auction_user_id];
                    b_info[b][b_rent] = 24;

                    OnServerInfoForMoney[36] += b_info[b][b_auction_bet];

                    b_info[b][b_auction_bet] = 0;
                    b_info[b][b_auction_user_id] = INVALID_MYSQL_ID;
                    update_bizz(b);
                    save_bizz(b);
                }
            }
        }
        else
        {
            if(b_info[b][b_rent] > 0) b_info[b][b_rent]--;
            if(b_info[b][b_rent] <= 0 && b_info[b][b_user_id] != INVALID_MYSQL_ID)
            {
                SendMesAll(COLOR_LIGHTRED, "Внимание! "W"Бизнес %d (%d$) был продан сервером. Причина: %s.", b, b_info[b][_price], b_info[b][b_paydays_received] == -1 ? "недостаточного онлайна владельца" : "неуплаты налогов");

                Log(LOG_player, INFO, "%s[%d](Offline) бизнес <%s - %s>(%d)[%d] был продан сервером из-за %s за %d$",
                        b_info[b][_owner], b_info[b][b_user_id],
                        b_info[b][_name], bizz_type_name[b_info[b][_tip]], b, b_info[b][b_mysql_id], 
                        b_info[b][b_paydays_received] == -1 ? "недостаточного онлайна владельца" : "неуплаты налогов", b_info[b][_price]);

                playerid = GetPlayerUserID(b_info[b][b_user_id]);
                if(playerid != INVALID_PLAYER_ID)
                {
                    ClearOwnerBizz(playerid, b);
                    SendInfo(playerid, "У Вас забрали бизнес из-за %s.", b_info[b][b_paydays_received] == -1 ? "недостаточного онлайна" : "не оплаты аренды");
                    SendInfo(playerid, "Денежные средства за бизнес зачислены на банковский счет.");
                    OnServerInfoForMoney[5] += (b_info[b][_price]/2) + b_info[b][_bank];
                    p_info[playerid][bank] += (b_info[b][_price]/2) + b_info[b][_bank];
                    MysqlUpdatePlayerInt(playerid, "bank", p_info[playerid][bank]);

                    switch(b_info[b][_tip])
                    {
                        case B_TAXI:
                        {
                            p_info[playerid][taxi_rank] = 0;
                            p_info[playerid][taxi_idx] = 0;
                            p_info[playerid][taxi_percent] = 0;
                            p_info[playerid][taxi_salary] = 0;
                            p_info[playerid][taxi_salary_all] = 0;
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `taxi` = 0, `taxi_rank` = 0, `taxi_idx` = 0, `taxi_percent` = 0, `taxi_salary` = 0, `taxi_salary_all` = 0 WHERE `id` = %d",
                            p_info[playerid][ID]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                        }
                        case B_TRUCKER:
                        {
                            p_info[playerid][tc_rank] = 0;
                            p_info[playerid][tc_idx] = 0;
                            p_info[playerid][tc_percent] = 0;
                            p_info[playerid][tc_salary] = 0;
                            p_info[playerid][tc_salary_all] = 0;
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `tc` = 0, `tc_rank` = 0, `tc_idx` = 0, `tc_percent` = 0, `tc_salary` = 0, `tc_salary_all` = 0 WHERE `id` = %d",
                            p_info[playerid][ID]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                        }
                    }
                }
                else
                {
                    STRING_GLOBAL[0] = EOS;
                    if(b_info[b][b_paydays_received] == -1) f(STRING_GLOBAL, ""W"У Вас забрали бизнес "I"№%d "W"из-за недостаточного онлайна.", b);
                    else f(STRING_GLOBAL, ""W"У Вас забрали бизнес "I"№%d "W"из-за не оплаты аренды.", b);
                    AddNotify(b_info[b][b_user_id], STRING_GLOBAL);
                    OnServerInfoForMoney[5] += (b_info[b][_price] / 2) + b_info[b][_bank];

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `bank` = `bank` + %d WHERE `id` = %d",
                    (b_info[b][_price] / 2) + b_info[b][_bank], b_info[b][b_user_id]);
                    mysql_tquery(con_bd, STRING_GLOBAL);

                    switch(b_info[b][_tip])
                    {
                        case B_TAXI:
                        {
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `taxi` = 0, `taxi_rank` = 0, `taxi_idx` = 0, `taxi_percent` = 0, `taxi_salary` = 0, `taxi_salary_all` = 0 WHERE `id` = %d",
                            b_info[b][b_user_id]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                        }
                        case B_TRUCKER:
                        {
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `tc` = 0, `tc_rank` = 0, `tc_idx` = 0, `tc_percent` = 0, `tc_salary` = 0, `tc_salary_all` = 0 WHERE `id` = %d",
                            b_info[b][b_user_id]);
                            mysql_tquery(con_bd, STRING_GLOBAL);
                        }
                    }
                }
                b_info[b][b_owned_at] =
                b_info[b][b_paydays_received] = 0;
                b_info[b][b_user_id] = INVALID_MYSQL_ID;
                b_info[b][b_rent] = 0;
                b_info[b][b_order] = 0;
                b_info[b][b_order_player_id] = INVALID_PLAYER_ID;
                strmid(b_info[b][_owner], "State", 0, strlen("State"), 255);
                save_bizz(b);
                update_bizz(b);
            }
        }
    }
}

CheckVehicle()
{
    foreach(new v: Vehicle)
    {
        CheckVehicleInsurance(v);

        if(veh_info[v][v_bonus] != 0)
        {
            if(veh_info[v][v_bonus] < timestamp)
            {
                veh_info[v][v_bonus] = 0;

                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `vehicle` WHERE `v_mysql_id` = %d",
                    veh_info[v][v_mysql_id]);
                mysql_tquery(con_bd, STRING_GLOBAL);

                ClearInventoryItems(veh_info[v][v_mysql_id], INVENTORY_OWNER_TYPE_VEHICLE);

                new playerid = GetPlayerUserID(veh_info[v][v_owner_id]);
                if(playerid != INVALID_PLAYER_ID)
                {
                    if(p_info[playerid][active_vehicle_id] == v) p_info[playerid][active_vehicle_id] = 0;
                    SendInfo(playerid, "Время использования транспортного средства закончилось.");
                    Log(LOG_player, INFO, "%s[%d](%s %s) изъято бонусное т/с <%s>(%d)[%d]",
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                        GetVehicleName(v), veh_info[v][v_model], veh_info[v][v_mysql_id]);
                }
                else
                {
                    AddNotify(veh_info[v][v_owner_id], "Время использования бонусного транспортного средства закончилось.");
                    Log(LOG_player, INFO, "Offline[%d](127.0.0.1 127.0.0.1) изъято бонусное т/с <%s>(%d)[%d]",
                        veh_info[v][v_owner_id], GetVehicleName(v), veh_info[v][v_model], veh_info[v][v_mysql_id]);
                }
                veh_info[v][v_lock] = 0;
                DestroyVehicleVEx(v);
            }
            else SaveVehicle(v);
        }
    }
}

CheckHotel()
{
    new playerid;
    for(new i = totalbizz-1; i != -1; i--)
    {
        if(b_info[i][b_mysql_id] == INVALID_MYSQL_ID) continue;
        //_tip
        new biz_id = b_info[i][b_mysql_id];
        for(new idx = 0; idx < MAX_HOTEL_ROOMS; idx++)
        {
            if(hotel_rooms_info[biz_id][idx][hr_rent] > 0) hotel_rooms_info[biz_id][idx][hr_rent]--;
            if(hotel_rooms_info[biz_id][idx][hr_rent] <= 0 && hotel_rooms_info[biz_id][idx][hr_user_id] != INVALID_MYSQL_ID)
            {
                //lastlog(FLY_HOTEL_PLAYER, "Выселение из отеля сервером, не оплата!", -1, -1, -1, -1, hotel_rooms_info[biz_id][idx][hr_owner]);
                // [logs] реализовать получение версии клиента
                Log(LOG_player, INFO, "%s[%d](Offline) был выселен сервером из-за неуплаты налогов из номера %d отеля %d",
                    hotel_rooms_info[biz_id][idx][hr_owner], hotel_rooms_info[biz_id][idx][hr_user_id],
                    idx, biz_id);

                playerid = GetPlayerUserID(hotel_rooms_info[biz_id][idx][hr_user_id]);
                if(playerid != INVALID_PLAYER_ID)
                {
                    p_info[playerid][key_hotel] = -1;
                    p_info[playerid][key_hotel_room] = -1;
                    SendInfo(playerid, "Вас выселили из отеля из-за не оплаты аренды.");

                    p_info[playerid][spawn] = SPAWN_DEFAULT;
                }
                else
                {
                    AddNotify(hotel_rooms_info[biz_id][idx][hr_user_id], "Вас выселили из отеля из-за не оплаты аренды.");

                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `spawn` = 0 WHERE `id` = %d",
                    hotel_rooms_info[biz_id][idx][hr_user_id]);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                }

                strmid(hotel_rooms_info[biz_id][idx][hr_owner], "None", 0, strlen("None"), MAX_PLAYER_NAME);
                hotel_rooms_info[biz_id][idx][hr_user_id] = 0;
                hotel_rooms_info[biz_id][idx][hr_rent] = 24;

                DestroyDynamicPickup(hotel_rooms_info[biz_id][idx][hr_pickup]);
                hotel_rooms_info[biz_id][idx][hr_pickup] = CreateDynamicPickup(((hotel_rooms_info[biz_id][idx][hr_user_id] == 0) ? 1273 : 1272), 23, hotel_rooms_pos[idx][0], hotel_rooms_pos[idx][1], hotel_rooms_pos[idx][2], b_info[biz_id][_world]);
                UpdatePickupInfo(hotel_rooms_info[biz_id][idx][hr_pickup], TYPE_BUSINESS, PICKUP_SUBTYPE_BUSINESS_HOTEL, biz_id);

                save_hotel_rooms(biz_id, idx);
            }
        }
    }
}

forward set_new_owner(id, type);
public set_new_owner(id, type)
{
    new rows, nickname[MAX_PLAYER_NAME];
    cache_get_row_count(rows);
    if(!rows) return 1;
    cache_get_value_name(0, "name", nickname, MAX_PLAYER_NAME);
    if(type == 0)
    {
        strmid(h_info[id][h_owner], nickname, 0, strlen(nickname), MAX_PLAYER_NAME);
        // [logs] реализовать получение версии клиента
        // Jeffrey_Collinz[2](Offline) купил на аукционе дом (%d)[%d] за %d$
        Log(LOG_player, INFO, "%s[%d](Offline) купил на аукционе дом (%d)[%d] за %d$",
            nickname, h_info[id][h_auction_user_id], id, h_info[id][h_mysql_id], h_info[id][h_auction_bet]);
    }
    else
    {
        strmid(b_info[id][_owner], nickname, 0, strlen(nickname), MAX_PLAYER_NAME);
        // Jeffrey_Collinz[2](Offline) купил на аукционе бизнес <%s - %s>(%d)[%d] за %d$
        Log(LOG_player, INFO, "%s[%d](Offline) купил на аукционе бизнес <%s - %s>(%d)[%d] за %d$",
            nickname, b_info[id][b_auction_user_id], b_info[id][_name], bizz_type_name[b_info[id][_tip]],
            id, b_info[id][b_mysql_id], b_info[id][b_auction_bet]);
    }
    return 1;
}

forward OnPlayerSelectLogs(playerid, TYPE_LOG);
public  OnPlayerSelectLogs(playerid, TYPE_LOG)
{
    new rows;
    cache_get_row_count(rows);
    if(!rows) return SendError(playerid, "Ничего не найдено.");

    if(rows)
    {
        new CountLog = 0,
            PlayerName[MAX_PLAYER_NAME],
            NickTarget[MAX_PLAYER_NAME],
            TimeName[MAX_PLAYER_NAME + 6],
            ReasonName[MAX_PLAYER_NAME * 3];

        STRING_GLOBAL[0] = EOS;
        STRING_GLOBAL = "Результаты по запросу:\n\n";
        for(new i; i != rows; i++)
        {
            cache_get_value_name(i, "ADMIN", NickTarget, MAX_PLAYER_NAME);
            cache_get_value_name(i, "PLAYER", PlayerName, MAX_PLAYER_NAME);
            cache_get_value_name(i, "REASON", ReasonName, MAX_PLAYER_NAME * 3);
            cache_get_value_name(i, "DATA", TimeName, MAX_PLAYER_NAME + 6);

            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"I"[%d] "W"[%s] %s %s %s. Причина: %s\n", STRING_GLOBAL, CountLog + 1, TimeName, NameTypeHistoryPunishment[TYPE_LOG-1], NickTarget, PlayerName, ReasonName);
            CountLog++;
        }

        if(CountLog == 0) return SendError(playerid, "Ничего не найдено.");
        ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_LIST, ""I"Запрос", STRING_GLOBAL, "Закрыть", "");
    }
    return 1;
}

GetRangDuel(playerid)
{
    new duelid = p_temp[playerid][DuelID];
    if(duelid == INVALID_PLAYER_ID) return DUEL_RANK_NONE;
    if(DuelData[duelid][dCommand1][0] == playerid && DuelData[duelid][dCommand2][0] != playerid)
        return DUEL_RANK_OWNER_1;
    if(DuelData[duelid][dCommand1][0] != playerid && DuelData[duelid][dCommand2][0] == playerid)
        return DUEL_RANK_OWNER_2;
    for(new i; i < 10; i++)
    {
        if(DuelData[duelid][dCommand1][i] == playerid) return DUEL_RANK_MEMBER_1;
        if(DuelData[duelid][dCommand2][i] == playerid) return DUEL_RANK_MEMBER_2;
    }
    return DUEL_RANK_NONE;
}

OnServerShowDialogDuelMenu(playerid)
{
    if(playerid == INVALID_PLAYER_ID) return 1;
    if(p_info[playerid][level] < 2) return SendError(playerid, "У Вас нет 2-ого уровня.");

    new rang_duel = GetRangDuel(playerid),
        duel_id = p_temp[playerid][DuelID],
        duel_name_map[][] = {"Случайная", "Snow", "Inferno", "Desert", "Wahehouse"};

    if(rang_duel == DUEL_RANK_NONE)
        return ShowPlayerDialog(playerid, D_DUEL_PLAYER, DIALOG_STYLE_INPUT, ""I"Дуэли", ""W"Вы хотите создать дуэль? Если да, введите "I"ID "W"противника:", "Да", "Отмена");

    if(rang_duel == DUEL_RANK_MEMBER_1 || rang_duel == DUEL_RANK_MEMBER_2)
    {
        ShowPlayerDialog(playerid, D_DUEL_CANCEL, DIALOG_STYLE_MSGBOX, ""I"Дуэли", "Вы хотите покинуть дуэль?", "Да", "Отмена");
        return SendError(playerid, "Вы зарегистрированы как один из участников команды.");
    }
    if(rang_duel == DUEL_RANK_OWNER_1)
    {
        if(duel_id == INVALID_PLAYER_ID) return 1;
        if(DuelData[duel_id][dCommand2][0] == INVALID_PLAYER_ID) return 1;
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL),
        ""I"[1]"W" Изменить ставку\t"I"%d\n\
        "I"[1]"W" Выбрать оружие\t"I"%s\n\
        "I"[2]"W" Количество раундов\t"I"%d\n\
        "I"[3]"W" Карта\t"I"%s\n\
        "I"[4]"W" Добавить участников\t \n\
        "I"[5]"W" Предложить начать дуэль\t"I"%s\n\
        "I"[6]"W" Удалить дуэль\t \n\
        "I"[7]"W" Дуэль семей\t"I"%s",
        DuelData[duel_id][dBank],
        WEAPON_Name[DuelData[duel_id][dGun]],
        DuelData[duel_id][dRound],
        duel_name_map[DuelData[duel_id][dMap]],
        get_name(DuelData[duel_id][dCommand2][0]),
        DuelData[duel_id][dFamilyStatus] == 0 ? "[-]" : "[+]");
        ShowPlayerDialog(playerid, D_DUEL_MENU, DIALOG_STYLE_TABLIST, ""I"Меню дуэли", STRING_GLOBAL, "Выбрать", "Отмена");
    }
    if(rang_duel == DUEL_RANK_OWNER_2)
    {
        if(duel_id == INVALID_PLAYER_ID) return 1;
        if(DuelData[duel_id][dCommand1][0] == INVALID_PLAYER_ID) return 1;
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL),
        ""I"[1]"W" Изменить ставку\t"I"%d\n\
        "I"[1]"W" Выбрать оружие\t"I"%s\n\
        "I"[2]"W" Количество раундов\t"I"%d\n\
        "I"[3]"W" Карта\t"I"%s\n\
        "I"[4]"W" Добавить участников\t \n\
        "I"[5]"W" Предложить начать дуэль\t"I"%s\n\
        "I"[6]"W" Удалить дуэль\t \n\
        "I"[7]"W" Дуэль семей\t"I"%s",
        DuelData[duel_id][dBank],
        WEAPON_Name[DuelData[duel_id][dGun]],
        DuelData[duel_id][dRound],
        duel_name_map[DuelData[duel_id][dMap]],
        get_name(DuelData[duel_id][dCommand1][0]),
        DuelData[duel_id][dFamilyStatus] == 0 ? "[-]" : "[+]");
        ShowPlayerDialog(playerid, D_DUEL_MENU, DIALOG_STYLE_LIST, ""I"Меню дуэли", STRING_GLOBAL, "Выбрать", "Отмена");
    }
    return 1;
}

/////////////////////////////////////////////////////////////////////////////
CMD:boot(playerid, params[])
{
    if(IsTDVisible(playerid) != -1) return 1;
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT)
        return 1;

    new Float:CarPos[3];
    foreach(new v: PlayerVehiclesStream[playerid])
    {
        if(GetVehicleData(GetVehicleModelEx(v), E_VD_TYPE) !=  VEHICLE_STATE_CAR)
            continue;
        //if(veh_info[v][v_mysql_id] == 0 && veh_info[v][v_family_id] == -1)
        //    continue;
        if(GetSlotVehicleMarket(veh_info[v][v_mysql_id]) != -1) continue;
        if(!IsPlayerOwnerVehicle(playerid, v) &&
            veh_info[v][v_used_key_ID] != p_info[playerid][ID]) continue;
        GetCoordBootVehicle(v, CarPos[0],CarPos[1],CarPos[2]);
        if(!IsPlayerInRangeOfPoint(playerid,2.5,CarPos[0],CarPos[1],CarPos[2]))
            continue;

        /*
        if(veh_info[v][v_inventory_use] != INVALID_PLAYER_ID)
            return SendError(playerid, "С инвентарем уже взаимодействуют.");
        veh_info[v][v_inventory_use] = playerid;
        */

        SetPVarInt(playerid, #VEHICLEID_BOOT, v);
        ShowTextDrawForPlayer(playerid, TD_ID_INVENTORY_OTHER);
        Interface_Show(playerid, EQUIPMENT_INVENTORY_BOOT);
        break;
    }
    return 1;
}
alias:boot("invcar", "invveh", "invvehicle");

GetCoordBootVehicle(vehicleid, &Float:x, &Float:y, &Float:z) // функция для нахождения координат багажника
{
    new Float:angle,Float:distance;
    GetVehicleModelInfo(GetVehicleModelEx(vehicleid), 1, x, distance, z);
    distance = distance/2 + 0.1;
    GetVehiclePos(vehicleid, x, y, z);
    GetVehicleZAngle(vehicleid, angle);
    x += (distance * floatsin(-angle+180, degrees));
    y += (distance * floatcos(-angle+180, degrees));
    return 1;
}

SendNewsMessageForServer(color, text_ad[])
{
    foreach(new playerid : Player)
    {
        if(p_info[playerid][p_settings][CHAT_ADVERT] == 1 && p_temp[playerid][premiumgamer] != PREMIUM_GAME) SendMes(playerid, color, text_ad);
    }
}
SendAdminMessageForServer(color, text_message[])
{
    foreach(new playerid : Player)
    {
        if(p_info[playerid][p_settings][CHAT_ADMIN_ACT] == 1 && p_temp[playerid][premiumgamer] != PREMIUM_GAME) SendMes(playerid, color, text_message);
    }
}
