                        SendMes(playerid, COLOR_LIME, "Команды транспортных средств: {"#cLYELLOW"}/mm > [5] Команды сервера > [3] Команды транспорта");

                        p_temp[playerid][rented_veh] = vehicleid;
                        veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];
                    }
                    if(p_temp[playerid][FarmTrailer] == INVALID_VEHICLE_ID)
                    {
                        new Float: VehiclePosX,
                            Float: VehiclePosY,
                            Float: VehiclePosZ,
                            Float: VehiclePosR;

                        GetVehiclePos(vehicleid, VehiclePosX, VehiclePosY, VehiclePosZ);
                        GetVehicleZAngle(vehicleid, VehiclePosR);

                        VehiclePosY = VehiclePosY - (2.0 * floatcos(VehiclePosR, degrees));
                        VehiclePosX = VehiclePosX - (-2.0 * floatsin(VehiclePosR, degrees));

                        p_temp[playerid][FarmTrailer] = CreateVehicleVEx(NPO_NONE, NPO_NONE, 610, VehiclePosX, VehiclePosY, VehiclePosZ, VehiclePosR, random(128), random(128), 3600);
                        p_temp[playerid][FarmTrailerTimer] = SetTimerEx("AttachedTrailerToVehicleFarm", 2500, false, "i", playerid);

                        SendMes(playerid, COLOR_SEA_WAVE, "Отправляйтесь на поле, найдите места, где можно собрать пшеницу и соберите её.");
                        SendMes(playerid, COLOR_BLUE, "Место обозначено на GPS навигаторе.");
                        SetPlayerGPS(playerid, -236.2293,-1371.2150,10.4374, 5.0);
                    }
                    else
                    {
                        new Float: VehiclePosX,
                            Float: VehiclePosY,
                            Float: VehiclePosZ,
                            Float: VehiclePosR;

                        GetVehiclePos(vehicleid, VehiclePosX, VehiclePosY, VehiclePosZ);
                        GetVehicleZAngle(vehicleid, VehiclePosR);

                        VehiclePosY = VehiclePosY - (2.0 * floatcos(VehiclePosR, degrees));
                        VehiclePosX = VehiclePosX - (-2.0 * floatsin(VehiclePosR, degrees));

                        SetVehiclePos(p_temp[playerid][FarmTrailer], VehiclePosX, VehiclePosY, VehiclePosZ);
                        SetVehicleZAngle(p_temp[playerid][FarmTrailer], VehiclePosR);

                        AttachTrailerToVehicle(p_temp[playerid][FarmTrailer], vehicleid);

                        SendMes(playerid, COLOR_SEA_WAVE, "Отправляйтесь на поле, найдите места, где можно собрать пшеницу и соберите её.");
                        SendMes(playerid, COLOR_BLUE, "Место обозначено на GPS навигаторе.");
                        SetPlayerGPS(playerid, -236.2293,-1371.2150,10.4374, 5.0);
                    }
                }
                case JOB_FARM_COMBINE:
                {
                    if(veh_info[vehicleid][v_rented_ID] != INVALID_MYSQL_ID && p_temp[playerid][rented_veh] != vehicleid)
                    {
                        SendError(playerid, "Данное транспортное средство уже арендовано.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(vehicleid != p_temp[playerid][rented_veh] && p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID)
                    {
                        SendError(playerid, "У Вас уже есть арендованное транспортное средство.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(p_temp[playerid][Work_ID] != FARM_WORK)
                    {
                        SendError(playerid, "Вы не работаете на ферме.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(p_temp[playerid][FarmType] != 4)
                    {
                        SendError(playerid, "Вы не работаете водителем комбайна.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(p_temp[playerid][rented_veh] != vehicleid)
                    {
                        SendMes(playerid, COLOR_LGREEN, "Вы арендовали транспортное средство.");
                        SendMes(playerid, COLOR_BLUE, "Для отмены аренды транспортного средства: "W"/unrent");
                        SendMes(playerid, COLOR_LIME, "Команды транспортных средств: {"#cLYELLOW"}/mm > [5] Команды сервера > [3] Команды транспорта");

                        p_temp[playerid][rented_veh] = vehicleid;
                        veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];
                    }
                    SendMes(playerid, COLOR_SEA_WAVE, "Отправляйтесь на поле, найдите места, где можно собрать пшеницу и соберите её.");
                    SendMes(playerid, COLOR_BLUE, "Место обозначено на GPS навигаторе.");
                    SetPlayerGPS(playerid, -236.2293,-1371.2150,10.4374, 5.0);
                }
                case JOB_FARM_PRODUCT:
                {
                    if(veh_info[vehicleid][v_rented_ID] != INVALID_MYSQL_ID && p_temp[playerid][rented_veh] != vehicleid)
                    {
                        SendError(playerid, "Данное транспортное средство уже арендовано.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(vehicleid != p_temp[playerid][rented_veh] && p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID)
                    {
                        SendError(playerid, "У Вас уже есть арендованное транспортное средство.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(p_temp[playerid][Work_ID] != FARM_WORK)
                    {
                        SendError(playerid, "Вы не работаете на ферме.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(p_temp[playerid][FarmType] != 5)
                    {
                        SendError(playerid, "Вы не работаете развозчиком продуктов.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(p_temp[playerid][rented_veh] != vehicleid)
                    {
                        SendMes(playerid, COLOR_LGREEN, "Вы арендовали транспортное средство.");
                        SendMes(playerid, COLOR_BLUE, "Для отмены аренды транспортного средства: "W"/unrent");
                        SendMes(playerid, COLOR_LIME, "Команды транспортных средств: {"#cLYELLOW"}/mm > [5] Команды сервера > [3] Команды транспорта");

                        p_temp[playerid][rented_veh] = vehicleid;
                        veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];
                    }
                    if(p_temp[playerid][FarmBizIDx] != -1)
                    {
                        new idx = p_temp[playerid][FarmBizIDx];
                        SendMes(playerid, COLOR_DARKORANGE, "У Вас есть заказ на доставку %d товара в \"%s\".", b_info[idx][b_order], b_info[idx][_name]);
                        SendMes(playerid, COLOR_BLUE, "Место обозначено на GPS навигаторе.");
                        SetPlayerGPS(playerid, b_info[idx][b_enter][0], b_info[idx][b_enter][1], b_info[idx][b_enter][2], 5.0);
                        return 1;
                    }
                    else
                    {
                        SendMes(playerid, COLOR_SEA_WAVE, "Отправляйтесь на склад, берите заказ и выполняйте его.");
                        SendMes(playerid, COLOR_BLUE, "Место обозначено на GPS навигаторе.");
                        SetPlayerGPS(playerid, -375.0554, -1448.7446, 25.9800, 5.0);
                    }
                }
                case JOB_HUNTING:
                {
                    if(veh_info[vehicleid][v_rented_ID] != INVALID_MYSQL_ID && p_temp[playerid][rented_veh] != vehicleid)
                    {
                        SendError(playerid, "Данное транспортное средство уже арендовано.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(vehicleid != p_temp[playerid][rented_veh] && p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID)
                    {
                        SendError(playerid, "У Вас уже есть арендованное транспортное средство.");
                        return RemovePlayerFromVehicle(playerid);
                    }
                    if(p_temp[playerid][rented_veh] != vehicleid)
                    {
                        if(p_temp[playerid][Work_ID] != HUNTING_WORK || HuntingStatus[playerid] == false)
                        {
                            SendMes(playerid, COLOR_DARKORANGE, "Вы должны получить разрешение на охоту.");
                            SendMes(playerid, COLOR_BLUE, "Место обозначено на GPS навигаторе.");
                            SetPlayerGPS(playerid, -1314.2607,-2209.8271,25.7308, 6.0);
                            return RemovePlayerFromVehicle(playerid);
                        }
                        SendMes(playerid, COLOR_LGREEN, "Вы арендовали транспортное средство.");
                        SendMes(playerid, COLOR_BLUE, "Для отмены аренды транспортного средства: "W"/unrent");
                        SendMes(playerid, COLOR_LIME, "Команды транспортных средств: {"#cLYELLOW"}/mm > [5] Команды сервера > [3] Команды транспорта");
                        SendMes(playerid, COLOR_SEA_WAVE, "Ожидайте информацию о местоположении оленя.");
                        p_temp[playerid][rented_veh] = vehicleid;
                        veh_info[vehicleid][v_rented_ID] = p_info[playerid][ID];
                        HuntingTimeCreteDeer[playerid] = RandomEx(15, 30);
                        HuntingVehicleIDx[playerid] = vehicleid;
                    }
                    return 1;
                }
            }
            return 1;
        }

        if(GetVehicleModelEx(vehicleid) == 427) SetPlayerArmour(playerid, 0.0);

        if(veh_info[vehicleid][v_npoType] == NPO_PUB_SALON)
        {
            p_temp[playerid][veh_id_buy] = vehicleid;
            if(veh_info[vehicleid][v_npoId] == NPO_CUSTOM_VEH)
            {
                new custom_id = GetSlotVehicleModelSync(veh_info[vehicleid][v_model]);
                if(custom_id == -1) return SendError(playerid, "Неизвестная ошибка: RC3007");
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    Название: "I"%s (ID: %d)"W"\n\n\
                    Стоимость: "I"%d FM"W"\n\
                    Макс. скорость: "I"%d KM/H"W"\n\
                    Макс. вместимость бака: "I"%d"W"\n\n\
                    Класс: "I"%s"W"\n\
                    Тип: "I"%s"W"\n\n\
                    "I"1."W" Приобрести\n\
                    "I"2."W" Тест-драйв",
                    GetVehicleName(INVALID_VEHICLE_ID, customVehModels[custom_id][CustomID]), customVehModels[custom_id][CustomID],
                    customVehModels[custom_id][ModelPrice], floatround(customVehModels[custom_id][ModelMaxSpeed]-50.0),
                    GetVehicleData(customVehModels[custom_id][ModelID], E_VD_MAX_FUEL), vehicle_class_name[GetVehicleData(customVehModels[custom_id][ModelID], E_VD_CLASS)], vehicle_type_name[GetVehicleData(customVehModels[custom_id][ModelID], E_VD_TYPE)]);
                ShowPlayerDialog(playerid, D_AVTOSALON_BUY, DIALOG_STYLE_INPUT, ""I"Покупка транспорта", STRING_GLOBAL, "Да", "Нет");
            }
            else
            {
                new modelid = GetVehicleModelEx(vehicleid),
                    cost_car = GetVehicleData(modelid, E_VD_PRICE);
                new list_percent[3] = {95, 90, 85}, vip_idx = p_info[playerid][p_vip];
                if(vip_idx) cost_car = ((cost_car / 100) * list_percent[vip_idx - 1]);

                if(GetVehicleData(modelid, E_VD_TYPE) == VEHICLE_STATE_CAR || GetVehicleData(modelid, E_VD_TYPE) == VEHICLE_STATE_MOTO)
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    Название: "I"%s (ID: %d)"W"\n\n\
                    Стоимость: "I"%d$"W"\n\
                    Макс. скорость: "I"%d KM/H"W"\n\
                    Макс. вместимость бака: "I"%d"W"\n\n\
                    Класс: "I"%s"W"\n\
                    Тип: "I"%s"W"\n\n\
                    Вы желаете приобрести данное транспортное средство?", GetVehicleName(vehicleid), GetVehicleData(modelid, E_VD_ID), cost_car, floatround(GetVehicleData(modelid, E_VD_MAX_SPEED)),
                    GetVehicleData(modelid, E_VD_MAX_FUEL), vehicle_class_name[GetVehicleData(modelid, E_VD_CLASS)], vehicle_type_name[GetVehicleData(modelid, E_VD_TYPE)]);
                    ShowPlayerDialog(playerid, D_AVTOSALON_BUY, DIALOG_STYLE_MSGBOX, ""I"Покупка транспорта", STRING_GLOBAL, "Да", "Нет");
                }
                else
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    Название: "I"%s (ID: %d)"W"\n\n\
                    Стоимость: "I"%d$"W"\n\
                    Класс: "I"%s"W"\n\
                    Тип: "I"%s"W"\n\n\
                    Вы желаете приобрести данное транспортное средство?", GetVehicleName(vehicleid), GetVehicleData(modelid, E_VD_ID), cost_car, vehicle_class_name[GetVehicleData(modelid, E_VD_CLASS)],
                    vehicle_type_name[GetVehicleData(modelid, E_VD_TYPE)]);
                    ShowPlayerDialog(playerid, D_AVTOSALON_BUY, DIALOG_STYLE_MSGBOX, ""I"Покупка транспорта", STRING_GLOBAL, "Да", "Нет");
                }
            }
        }
        return 1;
    }
    if(oldstate == PLAYER_STATE_DRIVER)
    {
        new vehicleid = p_temp[playerid][LastDriverVehicleIDx];
        if(p_temp[playerid][rented_veh] != INVALID_VEHICLE_ID && p_temp[playerid][LastDriverVehicleIDx] != INVALID_VEHICLE_ID)
        {
            if(veh_info[vehicleid][v_npoType] == NPO_JOB &&
                (veh_info[vehicleid][v_npoId] == JOB_BUS || veh_info[vehicleid][v_npoId] == JOB_PILOT) || veh_info[vehicleid][v_temp_job] == JOB_BUS || veh_info[vehicleid][v_temp_job] == JOB_PILOT) DisablePlayerCheckpoint(playerid);
            if(IsPlayerRentedVehicle(playerid, vehicleid) && (veh_info[vehicleid][v_npoType] == NPO_JOB || veh_info[vehicleid][v_temp_job] >= JOB_BUS) && veh_info[vehicleid][v_npoId] != JOB_TRAIN && veh_info[vehicleid][v_npoId] != JOB_TRAM)
            {
                if(p_temp[playerid][ExitCarTimer]) p_temp[playerid][ExitCarTimer] = false;//KillTimer(GetPVarInt(playerid, "ExitCarTimer"));
                if((veh_info[vehicleid][v_npoType] == NPO_JOB && (veh_info[vehicleid][v_npoId] == JOB_MECHANIC || veh_info[vehicleid][v_npoId] == JOB_COLLECTOR || veh_info[vehicleid][v_npoId] == JOB_FIREMAN || veh_info[vehicleid][v_npoId] == JOB_ROADMAN || veh_info[vehicleid][v_npoId] == JOB_PANEL || veh_info[vehicleid][v_npoId] == JOB_ELECTRIC || veh_info[vehicleid][v_npoId] == JOB_ROBBER)) ||
                veh_info[vehicleid][v_temp_job] == JOB_MECHANIC || veh_info[vehicleid][v_temp_job] == JOB_COLLECTOR || veh_info[vehicleid][v_temp_job] == JOB_FIREMAN || veh_info[vehicleid][v_temp_job] == JOB_ELECTRIC)
                {
                    ExitCount[playerid] = 180;
                    SendMes(playerid, COLOR_DARKORANGE, "У Вас есть 3 мин. чтобы вернуться в транспортное средство.");

                    if(veh_info[vehicleid][v_npoId] == JOB_FIREMAN || veh_info[vehicleid][v_temp_job] == JOB_FIREMAN)
                    {
                        f_GivePlayerWeapon(playerid, 42, 9999);
                        p_temp[playerid][FireAmmo] = 9999;

                        SetPlayerArmedWeapon(playerid, 42);
                    }
                    if(veh_info[vehicleid][v_npoId] == JOB_MECHANIC || veh_info[vehicleid][v_temp_job] == JOB_MECHANIC)
                    {
                        f_GivePlayerWeapon(playerid, 42, 9999);
                        p_temp[playerid][mechanic_ammo] = 9999;

                        SetPlayerArmedWeapon(playerid, 42);
                    }
                }
                else if(veh_info[vehicleid][v_npoType] == NPO_JOB && veh_info[vehicleid][v_npoId] == JOB_OIL || veh_info[vehicleid][v_temp_job] == JOB_OIL)
                {
                    ExitCount[playerid] = 600;
                    SendMes(playerid, COLOR_DARKORANGE, "У Вас есть 10 мин. чтобы вернуться в транспортное средство.");
                }
                else if(veh_info[vehicleid][v_npoType] == NPO_JOB && veh_info[vehicleid][v_npoId] == JOB_CONSTRUCTION_FORKLIFT)
                {
                    ExitCount[playerid] = 5;
                    SendMes(playerid, COLOR_DARKORANGE, "У Вас есть 5 сек. чтобы вернуться в транспортное средство.");
                }
                else if(veh_info[vehicleid][v_npoType] == NPO_JOB && veh_info[vehicleid][v_npoId] == JOB_RAILWAY_FACTORY_FORKLIFT)
                {
                    ExitCount[playerid] = 5;
                    SendMes(playerid, COLOR_DARKORANGE, "У Вас есть 5 сек. чтобы вернуться в транспортное средство.");
                }
                else if(veh_info[vehicleid][v_npoType] == NPO_JOB && (veh_info[vehicleid][v_npoId] == JOB_FARM_TRACTOR || veh_info[vehicleid][v_npoId] == JOB_FARM_COMBINE || veh_info[vehicleid][v_npoId] == JOB_FARM_PRODUCT))
                {
                    ExitCount[playerid] = 5;
                    SendMes(playerid, COLOR_DARKORANGE, "У Вас есть 5 сек. чтобы вернуться в транспортное средство.");
                }
                else if(veh_info[vehicleid][v_npoType] == NPO_JOB && veh_info[vehicleid][v_npoId] == JOB_HUNTING)
                {
                    ExitCount[playerid] = 120;
                    SendMes(playerid, COLOR_DARKORANGE, "У Вас есть 2 мин. чтобы вернуться в транспортное средство.");
                }
                else
                {
                    ExitCount[playerid] = 60;
                    SendMes(playerid, COLOR_DARKORANGE, "У Вас есть 1 мин. чтобы вернуться в транспортное средство.");
                }
                p_temp[playerid][ExitCarTimer] = true;
            }
        }
        if(vehicleid == p_temp[playerid][airballoon_vehicleID])
        {
            DeletePlayerAirBalloon(playerid);
            AttachToPlayerAccOrCostume(playerid, INVALID_PLAYER_ID);
        }
        p_temp[playerid][twinturbo_on] = 0;
        OnPlayerUpdateVehicleInfo(playerid, SPEEDO_TWINTURBO);
        HideTextDrawForPlayer(playerid, TD_ID_SPEEDOMETER);
        // for(new i; i < 6; i ++) PlayerTextDrawHide(playerid,speedTD[playerid][i]);
        // KillTimer(GetPVarInt(playerid, "SPEED"));

        p_temp[playerid][LastDriverVehicleIDx] = INVALID_VEHICLE_ID;
    }
    if(newstate == PLAYER_STATE_PASSENGER)
    {
        if(!IsValidVehicle(vehicleid)) return 1;
        if((veh_info[vehicleid][v_npoType] == NPO_JOB && veh_info[vehicleid][v_npoId] == JOB_TC_TAXI) || veh_info[vehicleid][v_job] == JOB_TC_TAXI)
        {
            foreach(new i: Player)
            {
                if(!p_info[i][loggedIn]) continue;
                if(GetPlayerVehicleSeat(i) == 0 && GetPlayerVehicleID(i) == vehicleid && (IsPlayerOwnerVehicle(playerid, vehicleid) || p_temp[i][rented_veh] != INVALID_VEHICLE_ID) && p_temp[i][Work_ID] == TAXI_WORK)
                {
                    SendInfo(i, "%s [%d] сел в Ваше такси.", get_name(playerid), playerid);
                    //SendInfo(i, "Довезите игрока и поездка будет оплачена государством.");
                    SetPVarInt(i,"@passenger",playerid+1);
                    SetPVarInt(i,"@passenger_count",GetPVarInt(i,"@passenger_count")+1);

                    GetPlayerPos(playerid, p_temp[playerid][TaxiFix][0], p_temp[playerid][TaxiFix][1], p_temp[playerid][TaxiFix][2]);
                    if(p_temp[i][p_GPS] == false) ShowPlayerDialog(playerid, D_SELECT_TAXI, DIALOG_STYLE_LIST, ""I"Навигация такси", ""I"[1]"W" Поставить метку\n"I"[2]"W" Выбрать из навигатора", "Принять", "Отмена");
                    break;
                }
            }
        }
        if(GetVehicleModelEx(vehicleid) == 487 && veh_info[vehicleid][v_int] == 100)
        { // FIX воздушный шар, когда у пассажиров были выдны акксесуары
            RemovePlayerAccessories(playerid, false);
            SetPVarInt(playerid, #AIRBALLOON_USE, vehicleid);
        }
    }
    if(oldstate == PLAYER_STATE_PASSENGER)
    {
        ResetPlayerWeapons(playerid);
        for (new i; i < MAX_WEAPONS; i++)
        {
            if(p_info[playerid][Weapon][i] == 42)
            {
                p_info[playerid][Weapon][i] = 0;
                p_info[playerid][Ammo][i] = 0;
                p_temp[playerid][FireAmmo] = 0;
                p_temp[playerid][mechanic_ammo] = 0;
                continue;
            }
            GivePlayerWeapon(playerid, p_info[playerid][Weapon][i], p_info[playerid][Ammo][i]);
        }
        SetPlayerArmedWeapon(playerid, 0);
        if(GetPVarInt(playerid, #AIRBALLOON_USE) == vehicleid)
        {
            AttachToPlayerAccOrCostume(playerid, INVALID_PLAYER_ID);
            DeletePVar(playerid, #AIRBALLOON_USE);
        }
    }
    return 1;
}

public OnPlayerEnterCheckpoint(playerid)
{
    if(p_temp[playerid][p_GPS] == true)
    {
        if(p_temp[playerid][panic_target_id] != INVALID_PLAYER_ID)
            p_temp[playerid][panic_target_id] = INVALID_PLAYER_ID;
        CancelPlayerGPS(playerid);
        SendInfo(playerid, "Вы достигли места назначения.");
        return 1;
    }


    if(p_temp[playerid][Work_ID] == COLLECTOR_WORK || p_temp[playerid][Work_ID] == ROBBER_WORK || p_temp[playerid][Work_ID] == ELECTRIC_WORK || p_temp[playerid][Work_ID] == OIL_WORK)
    {
        if(GetPVarInt(playerid, "USE_OnPlayerEnterCheckpoint") > timestamp) return 0;
        SetPVarInt(playerid, "USE_OnPlayerEnterCheckpoint", timestamp + 2);
    }

    if(p_temp[playerid][prison_escape] == 2 && p_info[playerid][jail] > 0 && p_temp[playerid][prison_escape_time] > 0)
    {
        DisablePlayerCheckpoint(playerid);
        SendAccess(playerid, "Вы скрылись от погони за Вами.");
        p_info[playerid][jail] =
        p_info[playerid][jail_time] =
        p_temp[playerid][prison_escape] =
        p_temp[playerid][prison_escape_time] = 0;
        SetPlayerWantedLevel(playerid, p_info[playerid][wanted]);
        return 1;
    }
    if(p_temp[playerid][prison_work] == 1 && p_info[playerid][jail] == 5 && GetPlayerVirtualWorld(playerid) == 1)
    {
        if(p_info[playerid][jail_time] < 20) return SendError(playerid, "Вы не заключенный в тюрьме или время заключения минимальное.");
        if(!p_temp[playerid][prison_work]) return SendError(playerid, "Для начала необходимо начать выполнять исправительные работы.");
        ClearAnimations(playerid);
        ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 1, 0, 0, 1, 1);
        //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
        p_temp[playerid][prison_work] = 2;
        SendAccess(playerid, "Вы взяли мешок.");
        SendInfo(playerid, "Отнесите его на склад.");
        DisablePlayerCheckpoint(playerid);
        return 1;
    }
    #if EVENT_HALLOWEEN == 1
        if(p_info[playerid][halloween_id] == 1 && p_info[playerid][halloween_progress] < 3)
        {
            new houseId = GetPVarInt(playerid, "HALLOWEEN:HOUSE_ID");
            if(houseId != 0 && 1 <= houseId <= totalhouses-1)
            {
                if(IsPlayerInRangeOfPoint(playerid, 2.5, h_info[houseId][h_enter][0], h_info[houseId][h_enter][1], h_info[houseId][h_enter][2]))
                {
                    DisablePlayerCheckpoint(playerid);
                    DeletePVar(playerid, "HALLOWEEN:HOUSE_ID");
                    MeAction(playerid, "постучал(-а) в дверь с словами \"Сладость или гадость\"");

                    new result = random(5);
                    switch(result)
                    {
                        case 0: ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Хозяин дома", ""W"Классный у тебя костюм! Конечно, держи.", "Закрыть", "");
                        case 1: ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Хозяка дома", ""W"Костюм для Хеллоуина сам делал? Очень крутой! Бери конфеты.", "Закрыть", "");
                        case 2: ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Хозяин дома", ""W"И тебя с праздником, бери конфеты!", "Закрыть", "");
                        case 3: ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Хозяин дома", ""W"Ничего я тебе не дам! Уйди отсюда!", "Закрыть", "");
                        default: ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""I"Хозяин дома", ""W"Вроде не маленький, а занимаешься ерундой. Нет у меня конфет!", "Закрыть", "");
                    }

                    if(result <= 2)
                    {
                        p_info[playerid][halloween_progress]++;
                        MysqlUpdatePlayerInt(playerid, "halloween_progress", p_info[playerid][halloween_progress]);
                        SendAccess(playerid, "Отлично, конфеты получены.");
                    }
                    else SendError(playerid, "К сожалению, конфеты здесь получить не удалось.");
                    HalloweenQuest_Check(playerid);
                    return 1;
                }
            }
        }

        if(p_info[playerid][halloween_id] == 2 && 3 <= p_info[playerid][halloween_progress] <= 6)
        {
            new graver_id = GetPVarInt(playerid, "HALLOWEEN:GRAVER_ID");
            if(graver_id != 0 && 1 <= graver_id <= MAX_HALLOWEEN_GRAVES+1)
            {
                graver_id--;
                if(IsPlayerInRangeOfPoint(playerid, 2.5, halloween_graves_pos[graver_id][0], halloween_graves_pos[graver_id][1], halloween_graves_pos[graver_id][2]))
                {
                    ClearAnimations(playerid);
                    ApplyAnimation(playerid, "CARRY", "putdwn", 4.0, 0, 1, 1, 0, 0, 1);
                    //SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);

                    DisablePlayerCheckpoint(playerid);
                    DeletePVar(playerid, "HALLOWEEN:GRAVER_ID");
                    MeAction(playerid, "наклонился и возложил(-а) цветы");

                    p_info[playerid][halloween_progress]++;
                    MysqlUpdatePlayerInt(playerid, "halloween_progress", p_info[playerid][halloween_progress]);
                    SendAccess(playerid, "Отлично, цветы возложены.");

                    HalloweenQuest_Check(playerid);
                    return 1;
                }
            }
        }
    #endif
    if(p_temp[playerid][Work_ID] == DRUG_WORK && p_temp[playerid][WorkCheckDrug] != -1 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
    {
        if(IsPlayerInRangeOfPoint(playerid, 2.0, drug_position[p_temp[playerid][WorkCheckDrug]][0], drug_position[p_temp[playerid][WorkCheckDrug]][1], drug_position[p_temp[playerid][WorkCheckDrug]][2]))
        {
            ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 4.0, 0, 0, 0, 0, 0, 1);
            if(p_temp[playerid][WorkCountDrug] == 0)
            {
                SetTimerEx("DrugsOff", (3500 + random(2500)), 0, "d", playerid);
                p_temp[playerid][WorkCountDrug] = 1;
            }
            return 1;
        }
    }

    new vehicleid = GetPlayerVehicleID(playerid);

    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
    {
        if(p_temp[playerid][Work_ID] == THEFT_CAR_WORK && TheftCarGPS[playerid] == true)
        {
            if(TheftCarIDx[playerid] == -1) return SendError(playerid, "У Вас нет контракта.");
            new idx = TheftCarIDx[playerid];
            if(TheftCarVehicle[idx][tcvVehicle] != vehicleid) return SendError(playerid, "Транспортное средство не является заказным.");
            if(AntiCheatWarningTime[playerid][0] > timestamp) return SendError(playerid, "Вы не можете доставлять транспортные средства так часто, подождите.");
            new Float:v_hp;
            GetVehicleHealth(vehicleid, v_hp);
            if(v_hp < 750) return SendError(playerid, "Транспортное средство в неисправном состоянии.");

            new vehicle_model = GetVehicleModelEx(vehicleid), class = GetVehicleData(vehicle_model, E_VD_CLASS), salary[5] = {2500, 5000, 7500, 10000, 10000}, new_salary = salary[class];

            new reason_money = GetPlayerMoneySkill(playerid, new_salary, 6);
            UpdatePlayerWorkSkill(playerid, 6);

            CheckPlayerMission(playerid, START_THEFT);
            CheckPlayerMission(playerid, DAILY_THEFT);
            CheckPlayerMission(playerid, ACHIEVEMENT_THEFT);

            CheckPlayerFreelance(playerid, FREELANCE_THEFT);
            CheckPlayerBattlePass(playerid, BATTLEPASS_THEFT);

            SetPlayerMoney(playerid, reason_money, true, "зарплата автоугон");
            OnServerInfoForMoney[16] += reason_money;

            SendMes(playerid, COLOR_BLUE, "Вы сдали транспортное средство.");
            SendMes(playerid, COLOR_LYELLOW, "К Вашей зарплате добавлено: {"#cLIME"}%d$.", reason_money);

            veh_info[vehicleid][v_thief_ID] = INVALID_PLAYER_ID;

            RemovePlayerFromVehicle(playerid);
            DestroyTheftCarVehicle(playerid);
            ClearTheftCar(playerid, TYPE_THEFT_CAR_VEHICLE);

            UpdateFamilyLevel(playerid);
            UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_THEFT_CAR); // Контракты: Автоугон
            return 1;
        }
    }

    if(p_temp[playerid][Work_ID] == PIZZABOY_WORK && p_temp[playerid][PizzaboyIDx] != -1)
    {
        new houseid = p_temp[playerid][PizzaboyIDx];
        if(IsPlayerInRangeOfPoint(playerid, 5.0, h_info[houseid][h_enter][0], h_info[houseid][h_enter][1], h_info[houseid][h_enter][2]))
        {
            if(AntiCheatWarningTime[playerid][0] > timestamp) return SendError(playerid, "Вы не можете доставлять заказы так часто, подождите.");

            DisablePlayerCheckpoint(playerid);
            SendMes(playerid, COLOR_BLUE, "Вы доставили заказ.");
            new reason_money = GetPlayerMoneySkill(playerid, p_temp[playerid][PizzaboySalary], 7);

            if(CheckPlayerMaxSalarySkill(playerid, 7, reason_money))
            {
                SetPlayerMoney(playerid, reason_money, true, "зарплата пицца");
                OnServerInfoForMoney[17] += reason_money;
                SendMes(playerid, COLOR_LYELLOW, "К Вашей зарплате добавлено: {"#cLIME"}%d$.", reason_money);

                p_info[playerid][job_skill_salary][7] += reason_money;
            }
            else SendError(playerid, "За последний час игры было заработано максимальное количество денежных средств.");

            if(GetPlayerGiveCasket(100, 5) != -1) GivePlayerCasket(playerid, -1);
            UpdatePlayerWorkSkill(playerid, 7);
            SendMes(playerid, COLOR_SEA_WAVE, "Отправляйтесь к \"Cluckin Bell\" чтобы взять новый заказ.");
            p_temp[playerid][PizzaboyIDx] = -1;
            p_temp[playerid][PizzaboySalary] = 0;

            AntiCheatWarningTime[playerid][2] = timestamp + AntiCheatWarningTime[playerid][1];

            CheckPlayerMission(playerid, START_PIZZA);
            CheckPlayerMission(playerid, DAILY_PIZZA);
            CheckPlayerMission(playerid, ACHIEVEMENT_PIZZA);

            CheckPlayerFreelance(playerid, FREELANCE_PIZZA);
            CheckPlayerBattlePass(playerid, BATTLEPASS_PIZZA);

            UpdateFamilyLevel(playerid);
            UpdateFamilyContract(playerid, CONTRACT_FAMILY_ID_PIZZABOY); // Контракты: Развозчик пиццы
        } else SetHouseCheckpoint(playerid, 0, p_temp[playerid][PizzaboyIDx]);
        return 1;
    }
    if(p_temp[playerid][Work_ID] == SPACE_WORK && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
    {
        new idx = p_temp[playerid][SpaceIDx] - 1;
        if(idx != -1 && IsPlayerInRangeOfPoint(playerid, 5.0, SpaceFossilsInfo[idx][sfPos][0], SpaceFossilsInfo[idx][sfPos][1], SpaceFossilsInfo[idx][sfPos][2]))
        {
            SendMes(playerid, COLOR_SEA_WAVE, "Чтобы добыть ископаемые, нажимайте ALT.");
            DisablePlayerCheckpoint(playerid);
            return 1;
        }
    }
    if(p_temp[playerid][Work_ID] == COLLECTOR_WORK && CollectorIDx[playerid] != -1)
    {
        switch(CollectorAttachedObject[playerid])
        {
            case 0:
            {
                if(IsPlayerInRangeOfPoint(playerid, 5.0, 1362.6382,-1658.9019,13.4751) && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
                {
                    CheckPlayerCollector(playerid);
                    return 1;
                }
            }
            case 1, 3:
            {
                if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
                {
                    new idx = CollectorVehicleIDx[playerid], Float:x, Float:y, Float:z;
                    GetCoordBootVehicle(idx, x, y, z);
                    if(IsPlayerInRangeOfPoint(playerid, 2.5, x, y, z))
                    {
                        CheckPlayerCollector(playerid);
                        return 1;
                    }
                }
            }
            case 2:
            {
                new idx = CollectorIDx[playerid];
                if(IsPlayerInRangeOfPoint(playerid, 5.0, ATMInfo[idx][aPos][0], ATMInfo[idx][aPos][1], ATMInfo[idx][aPos][2]))
                {
                    CheckPlayerCollector(playerid);
                    return 1;
                }
            }
            case 4:
            {
                if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
                {
                    new idx = CollectorIDx[playerid];
                    if(IsPlayerInRangeOfPoint(playerid, 2.5, ATMInfo[idx][aPos][0], ATMInfo[idx][aPos][1], ATMInfo[idx][aPos][2]))
                    {
                        CheckPlayerCollector(playerid);
                        return 1;
                    }
                }
            }
            case 5:
            {
                if(IsPlayerInRangeOfPoint(playerid, 5.0, 1362.6382,-1651.1910,13.4759))
                {
                    new vehicleid = CollectorVehicleIDx[playerid];
                    if(!IsPlayerRentedVehicle(playerid, vehicleid)) return SendError(playerid, "Данное транспортное средство не является Вашим арендованным транспортным средством.");
                    if(veh_info[vehicleid][v_npoType] != NPO_JOB && veh_info[vehicleid][v_npoId] != JOB_COLLECTOR && veh_info[vehicleid][v_temp_job] != JOB_COLLECTOR) return SendError(playerid, "Данное транспортное средство не является транспортным средством принадлежащем банку.");
                    CheckPlayerCollector(playerid);
                    return 1;
                }
            }
        }
        return 1;
    }
    if(p_temp[playerid][Work_ID] == ELECTRIC_WORK && ElectricIDx[playerid] != -1)
    {
        new idx = ElectricIDx[playerid], vehicleid = ElectricVehicleIDx[playerid], Float:x, Float:y, Float:z;
        switch(ElectricAttachedObject[playerid])
        {
            case 0:
            {
                if(IsPlayerInRangeOfPoint(playerid, 5.0, PowerLinesInfo[idx][plPos][0], PowerLinesInfo[idx][plPos][1], PowerLinesInfo[idx][plPos][2]) && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
                {
                    CheckPlayerElectric(playerid);
                    return 1;
                }
            }
            case 1, 3:
            {
                if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
                {
                    GetCoordBootVehicle(vehicleid, x, y, z);
                    if(IsPlayerInRangeOfPoint(playerid, 2.5, x, y, z))
                    {
                        CheckPlayerElectric(playerid);
                        return 1;
                    }
                }
            }
            case 2, 4:
            {
                if(IsPlayerInRangeOfPoint(playerid, 5.0, 2076.8025,-2006.6671,13.5469))
                {
                    CheckPlayerElectric(playerid);
                    return 1;
                }
            }
            case 5:
            {
                if(IsPlayerInRangeOfPoint(playerid, 5.0, -65.1904,-1120.8057,1.0781))
                {
                    new vehicleid = ElectricVehicleIDx[playerid];
                    if(!IsPlayerRentedVehicle(playerid, vehicleid)) return SendError(playerid, "Данное транспортное средство не является Вашим арендованным транспортным средством.");
                    if(veh_info[vehicleid][v_npoType] != NPO_JOB && veh_info[vehicleid][v_npoId] != JOB_ELECTRIC && veh_info[vehicleid][v_temp_job] != JOB_ELECTRIC) return SendError(playerid, "Данное транспортное средство не является транспортным средством принадлежащем электрикам.");
                    CheckPlayerElectric(playerid);
                    return 1;
                }
            }
        }
        return 1;
    }
    if(p_temp[playerid][Work_ID] == ROBBER_WORK && RobberIDx[playerid] != -1)
    {
        if(RobberAttachedObject[playerid] == 0 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
        {
            new idx = RobberIDx[playerid];
            if(IsPlayerInRangeOfPoint(playerid, 2.5, h_info[idx][h_enter][0], h_info[idx][h_enter][1], h_info[idx][h_enter][2]))
            {
                CheckPlayerRobbery(playerid);
                return 1;
            }
        }
        else if(RobberAttachedObject[playerid] == 1 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
        {
            new idx = RobberVehicleIDx[playerid], Float:x, Float:y, Float:z;
            GetCoordBootVehicle(idx, x, y, z);
            if(IsPlayerInRangeOfPoint(playerid, 2.5, x, y, z))
            {
                CheckPlayerRobbery(playerid);
                return 1;
            }
        }
        else if(RobberAttachedObject[playerid] == 2 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
            if(IsPlayerInRangeOfPoint(playerid, 5.0, 1751.4620,-2056.3772,13.8308))
            {
                new vehicleid = GetPlayerVehicleID(playerid);
                if(!IsPlayerRentedVehicle(playerid, vehicleid)) return SendError(playerid, "Данное транспортное средство не является Вашим арендованным транспортным средством.");
                if(veh_info[vehicleid][v_npoType] != NPO_JOB || veh_info[vehicleid][v_npoId] != JOB_ROBBER) return SendError(playerid, "Данное транспортное средство не является транспортным средством принадлежащем грабителям.");
                CheckPlayerRobbery(playerid);
                return 1;
            }
        }
        return 1;
    }
    if(p_temp[playerid][Work_ID] == HUNTING_WORK && HuntingStatus[playerid] == true && HuntingIDx[playerid] != -1)
    {
        new idx = HuntingIDx[playerid];
        if(HuntingInfo[idx][hStatus] == HUNTING_DEER_STATUS_TAKE && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
        {
            new vehicleid = HuntingVehicleIDx[playerid], Float:x, Float:y, Float:z;
            GetCoordBootVehicle(vehicleid, x, y, z);
            if(IsPlayerInRangeOfPoint(playerid, 2.5, x, y, z))
            {
                SetPlayerHunting(playerid);
                return 1;
            }
        }
        return 1;
    }
    return 1;
}

public OnPlayerLeaveCheckpoint(playerid)
{
    return 1;
}

SetPlayerGPS(playerid, Float:fX, Float:fY, Float:fZ, Float:sizeGPS)
{
    SetPlayerCheckpoint(playerid, fX, fY, fZ, sizeGPS);
    p_temp[playerid][p_GPS] = true;
    if(p_info[playerid][p_settings][INTERFACE]) ShowTextDrawForPlayer(playerid, TD_ID_GPS);
}

CancelPlayerGPS(playerid)
{
    if(p_temp[playerid][TaxiArea] != -1)
    {
        DestroyDynamicArea(p_temp[playerid][TaxiArea]);
        p_temp[playerid][TaxiArea] = -1;
    }
    if(p_temp[playerid][panic_target_id] != INVALID_PLAYER_ID)
    {
        p_temp[playerid][panic_target_id] = INVALID_PLAYER_ID;
    }

    DisablePlayerCheckpoint(playerid);
    p_temp[playerid][p_GPS] = false;
    if(p_info[playerid][p_settings][INTERFACE]) HideTextDrawForPlayer(playerid, TD_ID_GPS);
}

public OnPlayerEnterRaceCheckpoint(playerid)
{
    new distance = floatround(GetPlayerDistanceFromPoint(playerid, AntiCheatPlayerPos[playerid][0], AntiCheatPlayerPos[playerid][1], AntiCheatPlayerPos[playerid][2]));
    new max_distance = 75;

    if(p_info[playerid][job] == JOB_PILOT)
    {
        if(IsPlayerInAnyVehicle(playerid))
        {
            new vehicleid = GetPlayerVehicleID(playerid);
            if(veh_info[vehicleid][v_npoId] == JOB_PILOT || veh_info[vehicleid][v_temp_job] == JOB_PILOT) max_distance = 80;
        }
    }

    if(distance > max_distance) return 1;

    new vehicleid = GetPlayerVehicleID(playerid);

    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);

    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
    {
        if(GetPlayerVirtualWorld(playerid) == 500)
        {
            for(new i = 0; i < MAX_RACE_PLAYERS; i++)
            {
                if(RacePlayers[i] == playerid)
                {
                    if((EventMap == 0 && RacePosition[i] == 29) || (EventMap == 1 && RacePosition[i] == 33))
                    {
                        DisablePlayerRaceCheckpoint(RacePlayers[i]);
                        if(RaceWinnerIDs[0] == INVALID_PLAYER_ID)
                        {
                            RaceWinnerIDs[0] = RacePlayers[i];
                            new super_prize_idx;
                            if(random(10) == 0)
                            {
                                new accessories_prize[4] = {447, 448, 449, 450}, idx = random(sizeof(accessories_prize));
                                if(GivePlayerInventory(RacePlayers[i], accessories_prize[idx], .reason = "приз за 1 место гонки"))
                                {
                                    SendAccess(RacePlayers[i], "Вы выиграли суперприз \"%s\".", ItemsInfo[accessories_prize[idx]][iName]);
                                    super_prize_idx = accessories_prize[idx];
                                }
                            }
                            OnServerInfoForMoney[15] += RACE_PRIZ_ONE;
                            SetPlayerMoney(RacePlayers[i], RACE_PRIZ_ONE, 1, "приз за 1 место гонки");
                            if(super_prize_idx != 0) SendMesAll(0xFFD700FF, "Внимание! "W"Первое место на гонках занял(-а) %s. Приз: %d$ и %s.", p_info[RacePlayers[i]][name], RACE_PRIZ_ONE, ItemsInfo[super_prize_idx][iName]);
                            else SendMesAll(0xFFD700FF, "Внимание! "W"Первое место на гонках занял(-а) %s. Приз: %d$.", p_info[RacePlayers[i]][name], RACE_PRIZ_ONE);
                        }
                        else if(RaceWinnerIDs[1] == INVALID_PLAYER_ID)
                        {
                            RaceWinnerIDs[1] = RacePlayers[i];
                            new super_prize_idx;
                            if(random(10) == 0)
                            {
                                new accessories_prize[4] = {447, 448, 449, 450}, idx = random(sizeof(accessories_prize));
                                if(GivePlayerInventory(RacePlayers[i], accessories_prize[idx], .reason = "приз за 2 место гонки"))
                                {
                                    SendAccess(RacePlayers[i], "Вы выиграли суперприз \"%s\".", ItemsInfo[accessories_prize[idx]][iName]);
                                    super_prize_idx = accessories_prize[idx];
                                }
                            }
                            OnServerInfoForMoney[15] += RACE_PRIZ_TWO;
                            SetPlayerMoney(RacePlayers[i], RACE_PRIZ_TWO, 1, "приз за 2 место гонки");
                            if(super_prize_idx != 0) SendMesAll(0xFFD700FF, "Внимание! "W"Второе место на гонках занял(-а) %s. Приз: %d$ и %s.", p_info[RacePlayers[i]][name], RACE_PRIZ_TWO, ItemsInfo[super_prize_idx][iName]);
                            else SendMesAll(0xFFD700FF, "Внимание! "W"Второе место на гонках занял(-а) %s. Приз: %d$.", p_info[RacePlayers[i]][name], RACE_PRIZ_TWO);
                        }
                        else if(RaceWinnerIDs[2] == INVALID_PLAYER_ID)
                        {
                            RaceWinnerIDs[2] = RacePlayers[i];
                            new super_prize_idx;
                            if(random(10) == 0)
                            {
                                new accessories_prize[4] = {447, 448, 449, 450}, idx = random(sizeof(accessories_prize));
                                if(GivePlayerInventory(RacePlayers[i], accessories_prize[idx], .reason = "приз за 3 место гонки"))
                                {
                                    SendAccess(RacePlayers[i], "Вы выиграли суперприз \"%s\".", ItemsInfo[accessories_prize[idx]][iName]);
                                    super_prize_idx = accessories_prize[idx];
                                }
                            }
                            OnServerInfoForMoney[15] += RACE_PRIZ_THREE;
                            SetPlayerMoney(RacePlayers[i], RACE_PRIZ_THREE, 1, "приз за 3 место гонки");
                            if(super_prize_idx != 0) SendMesAll(0xFFD700FF, "Внимание! "W"Третье место на гонках занял(-а) %s. Приз: %d$ и %s.", p_info[RacePlayers[i]][name], RACE_PRIZ_THREE, ItemsInfo[super_prize_idx][iName]);
                            else SendMesAll(0xFFD700FF, "Внимание! "W"Третье место на гонках занял(-а) %s. Приз: %d$.", p_info[RacePlayers[i]][name], RACE_PRIZ_THREE);
                        }
                        RemovePlayerFromVehicle(RacePlayers[i]);
                        SetPlayerInterior(playerid, 0);
                        SetPlayerVirtualWorld(playerid, 0);
                        SetPlayerPos(playerid, 1421.7180,-1623.7816,13.5469);
                        SetPlayerFacingAngle(playerid, 270.0);
                        RegisterRace[playerid] = 0;
                        RacePlayers[i] = INVALID_PLAYER_ID;
                        if(RaceVehicles[i] != INVALID_VEHICLE_ID) DestroyVehicleVEx(RaceVehicles[i]);
                        RaceVehicles[i] = INVALID_VEHICLE_ID;
                    }
                    else
                    {
