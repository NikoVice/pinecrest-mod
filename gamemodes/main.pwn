    veh_info[vehicleid][v_used_key_ID] = params[0];
    SendAccess(playerid, "�� ������ %s [%d] ����� �� \"%s\".", get_name(params[0]), params[0], GetVehicleName(vehicleid));
    SendInfo(params[0], "%s [%d] ����� ��� ����� �� \"%s\".", get_name(playerid), playerid, GetVehicleName(vehicleid));
    return true;
}

CMD:limit(playerid, params[])
{
    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "�����������: /limit [��������]");
    if(params[0] < 0 || params[0] > 140) return SendError(playerid, "�������� ������ ���� �� ����� 0 � �� ����� 140.");
