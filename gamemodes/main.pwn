alias:blacklist("bl");

forward fraction_blacklist(playerid, type, nickname[], reason[], target_mysqlid);
public fraction_blacklist(playerid, type, nickname[], reason[], target_mysqlid)
{
    switch(type)
    {
        case 1:
        {
            if(!cache_num_rows()) return SendError(playerid, "����� �� ������ � ���� ������.");
            new mysql_id;
            cache_get_value_name_int(0, "id", mysql_id);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `fraction_blacklist` (`f_bl_frac`, `f_bl_player_id`, `f_bl_target_id`, `f_bl_date`, `f_bl_reason`) VALUES (%d, %d, %d, NOW(), '%s')",
            p_info[playerid][member], p_info[playerid][ID], mysql_id, reason);
            mysql_tquery(con_bd, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s ����(-��) %s � ������ ������ %s. �������: %s", get_name(playerid), nickname, GetFractionName(p_info[playerid][member]), reason);
            SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
        }
        case 2:
        {
            if(!cache_num_rows()) return SendError(playerid, "����� �� ������ � ���� ������.");
            new mysql_id;
            cache_get_value_name_int(0, "id", mysql_id);
            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `fraction_blacklist` WHERE `f_bl_target_id` = %d AND `f_bl_frac` = %d",
            mysql_id, p_info[playerid][member]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            STRING_GLOBAL[0] = EOS;
            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s �����(-��) %s �� ������� ������ %s.", get_name(playerid), nickname, GetFractionName(p_info[playerid][member]));
            SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
        }
    }
    return 1;
}

forward load_fraction_blacklist(playerid);
public load_fraction_blacklist(playerid)
{
    new rows;
    cache_get_row_count(rows);
    if(rows)
    {
        for(new i, fr_id; i < rows; i++)
        {
            cache_get_value_name_int(i, "f_bl_frac", fr_id);
            p_temp[playerid][bl_fraction][fr_id] = true;
            cache_get_value_name(i, "f_bl_reason", p_temp[playerid][bl_reason][fr_id], 32);
        }
    }
    return 1;
}

CMD:fstats(playerid, params[])
{
    if(!p_info[playerid][member]) return SendError(playerid, "�� �� �������� �� �������.");
    if(p_info[playerid][rang] < 9) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(sscanf(params, "u", params[0])) return SendError(playerid, "�����������: /fstats [id ������]");
    if(params[0] == INVALID_PLAYER_ID || !IsPlayerConnected(params[0])) return SendError(playerid, "����� �� ������.");
    if(p_info[params[0]][member] == 0) return SendError(playerid, "����� �� ������� �� �������.");
    if(p_info[params[0]][member] != p_info[playerid][member]) return SendError(playerid, "����� ��������� � ������ �������.");
    ShowFracStats(params[0], playerid);
    return 1;
}

CMD:myfstats(playerid, params[])
{
    if(!p_info[playerid][member]) return SendError(playerid, "�� �� �������� �� �������.");
    ShowFracStats(playerid, playerid);
    return 1;
}

