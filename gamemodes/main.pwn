                    new cost_house = h_info[houseId][h_value];

                    new list_percent[3] = {95, 90, 85}, vip_idx = p_info[playerid][p_vip];
                    if(vip_idx) cost_house = ((cost_house / 100) * list_percent[vip_idx - 1]);

                    if(GetPlayerVirtualWorld(playerid) == GetPVarInt(playerid, "bID") && GetPlayerVirtualWorld(playerid) != 0)
                    {
                        SetPlayerInterior(playerid,0);
                        Fix_TogglePlayerControllable(playerid, false);
                        SetPlayerPos(playerid,h_info[houseId][h_enter][0], h_info[houseId][h_enter][1], h_info[houseId][h_enter][2]);

                        new Float:hx, Float:hy, Float:hz, Float:ha,
                            Float:hx2, Float:hy2;
                        ha = h_info[houseId][h_enter][3];
                        hx = h_info[houseId][h_enter][0] + 1.0 * floatsin(-ha, degrees); //смещение от Х вперед!
                        hy = h_info[houseId][h_enter][1] + 1.0 * floatcos(-ha, degrees); //смещение от Y вперед! в сторону куда смотрим(!)
                        hz = h_info[houseId][h_enter][2]+0.5;

                        hx2 = hx - 12.0 * floatsin(ha, degrees);
                        hy2 = hy + 6.0 * floatcos(ha, degrees);

                        InterpolateCameraPos(playerid,hx,hy,hz,hx2,hy2,hz+2.2, 3500);
                        InterpolateCameraLookAt(playerid,hx,hy,hz, hx,hy,hz, 3500);

