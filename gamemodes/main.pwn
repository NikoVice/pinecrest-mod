{
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
    "I"[1]"W" Статистика персонажа\n\
    "I"[2]"W" Инвентарь"W"\n\
    "I"[3]"W" Настройки\n\
