        new i = p_temp[playerid][slot_machine_use];
        if(_:clickedid == 65535) SelectTextDraw(playerid, 0x007FFFFF);
        else if(clickedid == SlotMachineTD[1])
        {
            if(SlotMachine[i][sm_objStop] != 3) return SendError(playerid, "��������� ���� ����������� ��������.");
            if(p_info[playerid][cash] < SlotMachine[i][sm_bet]) return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate");
            SetPlayerMoney(playerid, -SlotMachine[i][sm_bet], true, "�������� � ������� ��������");
            new str[128];
            format(str, sizeof(str), "~w~BALANCE: ~g~$%d.~n~~w~RATE: ~y~$%d.", p_info[playerid][cash], SlotMachine[i][sm_bet]);
            PlayerTextDrawSetString(playerid, SlotMScoreTD[playerid], str);
            PlayerTextDrawShow(playerid, SlotMScoreTD[playerid]);
            SlotMachine[i][sm_objStop] = 0;
            switch(random(1000))
            {
                case 130..140, 230..240, 330..340, 540..550:
                {
                    SlotMachine[i][sm_comb] = 2;
                    new rand = 1 + random(2);
                    for(new f = 1; f <= 3; f++) SpinReel(i, f, rand);
                }
                case 101..105, 501..505, 701..705, 801..805:
                {
                    SlotMachine[i][sm_comb] = 3;
                    new rand = 3 + random(2);
                    for(new f = 1; f <= 3; f++) SpinReel(i, f, rand);
                }
                case 28, 38, 88, 98, 528:
                {
                    SlotMachine[i][sm_comb] = 4;
                    for(new f = 1; f <= 3; f++) SpinReel(i, f, 5);
                }
                case 598, 628, 698, 728, 798:
                {
                    SlotMachine[i][sm_comb] = 4;
                    for(new f = 1; f <= 3; f++) SpinReel(i, f, 6);
                }
                case 93, 203, 213, 313, 403, 506, 513:
                {
                    SlotMachine[i][sm_comb] = 5;
                    for(new f = 1; f <= 3; f++) SpinReel(i, f, 7);
                }
                case 185, 290, 605, 815, 920:
                {
                    SlotMachine[i][sm_comb] = 10;
                    for(new f = 1; f <= 3; f++) SpinReel(i, f, 8);
                }
                default:
                {
                    switch (random(10))
                    {
                        case 3, 7:
                        {
                            SlotMachine[i][sm_comb] = 2;
                            for(new f = 1; f <= 3; f++) SpinReel(i, f, 0);
                            return 1;
                        }
                    }
                    new rand[3];
                    while(rand[0] == rand[1] && rand[1] == rand[2])
                    {
                        for(new f; f < 3; f++) rand[f] = random(9);
                    }
                    SlotMachine[i][sm_comb] = 0;
                    for(new f = 1; f <= 3; f++) SpinReel(i, f, rand[f - 1]);
                }
            }
            return 1;
        }
        else if(clickedid == SlotMachineTD[2]) return ExitSlotMachine(playerid);
        else if(clickedid == SlotMachineTD[3])
        {
            if(SlotMachine[i][sm_objStop] != 3) return SendError(playerid, "��������� ���� ����������� ��������.");
            if(SlotMachine[i][sm_bet] <= 1000) return 1;
            SlotMachine[i][sm_bet] -= 1000;
            new str[128];
            format(str, sizeof(str), "~w~BALANCE: ~g~$%d.~n~~w~RATE: ~y~$%d.", p_info[playerid][cash], SlotMachine[i][sm_bet]);
            PlayerTextDrawSetString(playerid, SlotMScoreTD[playerid], str);
            PlayerTextDrawShow(playerid, SlotMScoreTD[playerid]);
            return 1;
        }
        else if(clickedid == SlotMachineTD[4])
        {
            if(SlotMachine[i][sm_objStop] != 3) return SendError(playerid, "��������� ���� ����������� ��������.");
            if(SlotMachine[i][sm_bet] >= 1000000) return SendError(playerid, "������������ ������ $1000000.");
            SlotMachine[i][sm_bet] += 1000;
            new str[128];
            format(str, sizeof(str), "~w~BALANCE: ~g~$%d.~n~~w~RATE: ~y~$%d.", p_info[playerid][cash], SlotMachine[i][sm_bet]);
            PlayerTextDrawSetString(playerid, SlotMScoreTD[playerid], str);
            PlayerTextDrawShow(playerid, SlotMScoreTD[playerid]);
            return 1;
        }
    }
    return 1;
}

public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
    //SendDebug(playerid, "event PTD click");
    if(p_info[playerid][loggedIn] != 1) return 0;
    if(p_info[playerid][exchangePartner] != INVALID_PLAYER_ID && p_temp[playerid][TextDrawTrade] == false) return SendError(playerid, "� ��� �� ����������� �����.");
    if(GetPVarInt(playerid, #CCTV_ID) > 0) CC_OnPlayerClickPlayerTextDraw(playerid, playertextid);
    if(IsPlayerUseMDC(playerid))
        return MDC_OnPlayerClickPlayerTextDraw(playerid, playertextid);
    if(playertextid == PTD_ListPage[playerid][20]) //Button: CANCEL
        return CancelButtonTDList(playerid);
    if(p_info[playerid][durak_table])
        return Durak_HandlePTDClick(playerid, playertextid);
    if(p_temp[playerid][TextDrawTHunterGame]) return THunter_OnClickPlayerTextDraw(playerid, playertextid);
    if(p_temp[playerid][TextDrawRobberyRobbing]) return Robbing_OnClickPlayerTextDraw(playerid, playertextid);
    if(p_temp[playerid][TextDrawCraft]) return Craft_OnClickPlayerTextDraw(playerid, playertextid);
    if(p_temp[playerid][TextDrawBattlePass]) return BP_OnClickPlayerTextDraw(playerid, playertextid);
    if(p_temp[playerid][TextDrawDaily]) return Daily_OnClickPlayerTextDraw(playerid, playertextid);
    if(p_temp[playerid][TextDrawElectric]) return Electric_OnClickPlayerTextDraw(playerid, playertextid);
    if(p_temp[playerid][TextDrawRadio]) return Radio_OnClickPlayerTextDraw(playerid, playertextid);
    if(p_info[playerid][p_settings][INTERFACE] &&
        (p_temp[playerid][TextDrawServiceTune] || p_temp[playerid][TextDrawPlayerMenu] ||
        p_temp[playerid][TextDrawInventory] ||
        p_temp[playerid][TextDrawRoulette] || p_temp[playerid][TextDrawCase] || p_temp[playerid][TextDrawPhone] ||
        p_temp[playerid][TextDrawTrade]))
        return Interface_OnClickPlayerTextDraw(playerid, playertextid);
    if(p_temp[playerid][TextDrawEquipment])
        return Interface_OnClickPlayerTextDraw(playerid, playertextid);
    if(blackjackPlayerData[playerid][BJ_CurrentTableID] != -1) 
        return BJ_OnPlayerClickPlayerTD(playerid, playertextid);

    if(playertextid == PTD_Shop[playerid][3]) return button_back(playerid);
    else if(playertextid == PTD_Shop[playerid][4]) return button_next(playerid);
    else if(playertextid == PTD_Shop[playerid][7]) return button_buy(playerid);
    else if(playertextid == PTD_Shop[playerid][8]) return button_cancelbuy(playerid);
    else if(playertextid == PTD_Dice[playerid][12])
    {
        new s = GetPVarInt(playerid,"BoneStol_ID")-1;
        if(s == -1) return 1;
        if(GetPVarInt(playerid,"CasinoRang"))
        {
            if(DiceInfo[s][bank] > 0) return SendError(playerid, "� ������ ������ ������ �������� ��������� �����, � ����� ���� �������� ��������."), UpdateBone(s);
            ShowPlayerDialog(playerid, D_DICE_SET, DIALOG_STYLE_INPUT, "��������� ������ ��� ����:","������ ������ ���� �� ����� 1000$\n� �� ����� 100000000$. ������� ����� ������.","�����","������");
            return 1;
        }
        if(!DiceInfo[s][bet]) return SendError(playerid, "�� ����� ��� ������."), UpdateBone(s);
        if(p_info[playerid][cash] < DiceInfo[s][bet]) return SendError(playerid, "� ��� ��� ������� �����. ����������� /donate"), UpdateBone(s);
        if(DiceInfo[s][game_start] > 0) return SendError(playerid, "���� ��� ��������."), UpdateBone(s);
        for(new i = 4; i != -1; i--)
        {
            if(DiceInfo[s][dice_gamer][i] == playerid)
            {
                if(DiceInfo[s][dice_set][i])
                    return SendError(playerid, "�� ��� ��������� ������."), UpdateBone(s);
                DiceInfo[s][dice_set][i] = 1;
                break;
            }
        }
        SetPlayerMoney(playerid, -DiceInfo[s][bet], true, "������ � ������");
        DiceInfo[s][bank] += DiceInfo[s][bet];
        UpdateBone(s);
        return 1;
    }
    else if(playertextid == PTD_Dice[playerid][13])
    {
        new s = GetPVarInt(playerid,"BoneStol_ID")-1;
        if(s == -1) return 1;
        if(GetPVarInt(playerid,"CasinoRang"))
        {
            if(DiceInfo[s][game_start] > 0) return SendError(playerid, "���� ��� ��������."), UpdateBone(s);
            new count;
            for(new i = 4; i != -1; i--) 
            {
                if(DiceInfo[s][dice_gamer][i] != INVALID_PLAYER_ID && DiceInfo[s][dice_set][i] == 1)
                    count++;
            }
            if(count < 2) return SendError(playerid, "������� ���� �������."), UpdateBone(s);
            DiceInfo[s][game_start] = 30;
            SetTimerEx("UpdateGameDice", 1000, false, "i", s);
        }
        else
        {
            new gamer_id, null;
            for(new i = 4; i != -1; i--)
            {
                gamer_id = DiceInfo[s][dice_gamer][i];
                if(gamer_id == playerid)
                {
                    if(!DiceInfo[s][dice_set][i]) 
                    {
                        SendError(playerid, "�� �� ������� ������.");
                        continue;
                    }
                    if(DiceInfo[s][game_start] <= 0)
                    {
                        SendError(playerid, "���� ��� �� ��������.");
                        continue;
                    }
                    if(DiceInfo[s][dice_set][i] > 1) 
                    {
                        SendError(playerid, "�� ��� ������ �����.");
                        continue;
                    }
                    DiceInfo[s][dice_set][i] = random(10) + 2;
                }
                if(DiceInfo[s][dice_set][i] == 1) null++;
            }
            if(DiceInfo[s][game_start] > 0 && !null) DiceInfo[s][game_start] = 2;
        }
        UpdateBone(s);
        return 1;
    }
    else if(playertextid == PTD_Dice[playerid][14]) return ShowPlayerDialog(playerid, D_DICE_EXIT, DIALOG_STYLE_MSGBOX, ""I"�����", ""W"���� �� ������� ������ � ���� ��� ��������, �� ������ ��� �� ��������!\n�� ����� ������ �������� ����?", "��", "���");
    else if(playertextid == PTD_MiniGames[playerid])
    {
        HideTextDrawForPlayer(playerid, TD_ID_MINI_GAMES);
        switch(p_temp[playerid][mini_games_type])
        {
            case 1:
            {
                switch(random(100))
                {
                    case 0..29:
                    {
                        SendInfo(playerid, "� ��� �� ���������� ��������� �����, �����������.");
                        ShowTextDrawForPlayer(playerid, TD_ID_MINI_GAMES);
                    }
                    case 30..89:
                    {
                        SendInfo(playerid, "� ��� �� ���������� ��������� �����, ���� ���������� �������� �� 5 �����.");
                        if(p_info[playerid][jail] != 5) SendInfo(playerid, "�� ���� ���������� � ����������� ������.");
                        p_info[playerid][jail] = 5;
                        switch(p_info[playerid][p_vip])
                        {
                            case 1: p_info[playerid][jail_time] += ((5 * 60) / 100) * 90;
                            case 2: p_info[playerid][jail_time] += ((5 * 60) / 100) * 80;
                            case 3: p_info[playerid][jail_time] += ((5 * 60) / 100) * 70;
                            default: p_info[playerid][jail_time] += 5*60;
                        }
                        p_temp[playerid][prison_escape] =
                        p_temp[playerid][prison_escape_time] = 0;
                    }
                    case 90..100:
                    {
                        new idx = random(15),
                            Float:escape_pos[][] =
                            {
                                {2308.7800, -1217.9900, 23.8700},
                                {-1989.9000, 1117.8800, 54.4700},
                                {-1640.0566,-2240.6355,31.4766},
                                {870.2867,-25.2779,63.9615},
                                {154.2019,-1942.3723,3.7734},
                                {377.1042,-2052.6394,8.0156},
                                {1029.7124,-1437.4984,14.2454},
                                {726.7692,-1435.3933,14.2454},
                                {335.5566,-1341.1031,14.5078},
                                {-76.2300,-1555.9801,3.0034},
                                {-373.9689,-1427.7361,26.0316},
                                {-388.5044,-1150.2087,69.4382},
                                {-349.0255,-1051.8118,59.3166},
                                {-187.0412,-308.0168,2.2398},
                                {-546.8495,-186.9221,78.4063}
                            };
                        SetPlayerCheckpoint(playerid, escape_pos[idx][0], escape_pos[idx][1], escape_pos[idx][2], 2.5);
                        SendAccess(playerid, "� ��� ���������� ��������� �����, ��� ���������� ��������� �� ����������� ����� �� 5 �����.");

                        p_info[playerid][wanted] = 6;
                        SetPlayerWantedLevel(playerid, p_info[playerid][wanted]);

                        p_temp[playerid][prison_escape] = 2;
                        p_temp[playerid][prison_escape_time] = 300;

                        SetPlayerInterior(playerid, 0);
                        SetPlayerVirtualWorld(playerid, 0);
                        switch(p_info[playerid][jail])
                        {
                            case 1:
                            {
                                SetPlayerPos(playerid, 1547.1400,-1675.8500,13.9531);
                                SetPlayerFacingAngle(playerid, 90.0);
                            }
                            case 2:
                            {
                                SetPlayerPos(playerid, -1605.4330,712.3948,13.8672);
                                SetPlayerFacingAngle(playerid, 0.0);
                            }
                            case 3:
                            {
                                SetPlayerPos(playerid, 2336.9790,2456.6194,14.9688);
                                SetPlayerFacingAngle(playerid, 180.0);
                            }
                            case 4:
                            {
                                SetPlayerPos(playerid, 630.1443,-571.8186,16.3359);
                                SetPlayerFacingAngle(playerid, 268.2991);
                            }
                            case 5:
                            {
                                SetPlayerPos(playerid, 2414.2959,1123.7134,10.8203);
                                SetPlayerFacingAngle(playerid, 270.0);
                            }
                        }

                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] ������(-�) �� ������.", get_name(playerid), playerid);
                        SendFractionMessage(POLICE_LS, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_SF, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_LV, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(PRISON, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(FBI_TEAM, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);
                    }
                }
            }
            case 2:
            {
                switch(random(100))
                {
                    case 0..29:
                    {
                        SendInfo(playerid, "� ��� �� ���������� �������� ������� ������, �����������.");
                        ShowTextDrawForPlayer(playerid, TD_ID_MINI_GAMES);
                    }
                    case 30..89:
                    {
                        SendAccess(playerid, "� ��� ���������� �������� ������� ������, ��������� ������������.");

                        p_info[playerid][wanted] = 6;
                        SetPlayerWantedLevel(playerid, p_info[playerid][wanted]);

                        /*
                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] �������(-��/-���) �������� ������� ������.", get_name(playerid), playerid);
                        SendFractionMessage(POLICE_LS, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_SF, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_LV, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(FBI_TEAM, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);
                        */
                    }
                    case 90..100:
                    {
                        SendAccess(playerid, "� ��� ���������� �������� ������� ������, ��� ������ ����� ��������.");

                        p_info[playerid][army_skin] = 1;
                        SendInfo(playerid, "���������� ������: /switchskin");
                        SendInfo(playerid, "�������� ��������, ����� ���������� ����� ��������.");

                        p_info[playerid][wanted] += 2;
                        if(p_info[playerid][wanted] > 6) p_info[playerid][wanted] = 6;
                        SetPlayerWantedLevel(playerid, p_info[playerid][wanted]);

                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] �������(-�) ������� ������.", get_name(playerid), playerid);
                        SendFractionMessage(POLICE_LS, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_SF, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_LV, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(FBI_TEAM, 0x33CC66FF, STRING_GLOBAL);
                        SendFractionMessage(POLICE_RC, 0x33CC66FF, STRING_GLOBAL);
                    }
                }
            }
        }
        return 1;
    }
    else if(playertextid == PhoneMain[playerid][37]) // ������;
    {
        if(p_temp[playerid][offphone] == true) return SendError(playerid, "� ��� �������� �������, �������� ���.");
        if(!p_info[playerid][phone_number]) return SendError(playerid, "� ��� ��� ������ ��������.");
        ShowPlayerDialog(playerid, D_PHONE_CALL, DIALOG_STYLE_INPUT, ""I"���������", ""W"\
        ������� ����� ���. ������:\n\n\
        ������� - "I"10"W"\n\
        ������ ������ - "I"11"W"\n\
        ����� - "I"12"W"\n\
        ����������� - "I"13"W"\n\
        ���������� [LS] - "I"14"W"\n\
        ���������� [SF] - "I"15"W"\n\
        ���������� [LV] - "I"16"W"\n\
        ��������� ���� - "I"17"W"\n\
        ������ �������� - "I"18", "�����", "������");
        return 1;
    }
    else if(playertextid == PhoneMain[playerid][38]) // ���������;
    {
        if(p_temp[playerid][offphone] == true) return SendError(playerid, "� ��� �������� �������, �������� ���.");
        if(!p_info[playerid][phone_number]) return SendError(playerid, "� ��� ��� ������ ��������.");
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT t.`NickPlayer`, t.`NickTarget`, t.`Text`, t.`Read`, t.`Time` FROM `phone_messages` AS t JOIN (SELECT `NickPlayer`, `Text`, max(`Time`) as `mtime` FROM `phone_messages` WHERE `NickTarget` = '%s' GROUP BY `NickPlayer`, `NickTarget`, `Text`, `Read`, `Time`) as t1 ON t.NickPlayer= t1.NickPlayer AND t.`Time` = t1.`mtime` ORDER BY t.`Time` DESC LIMIT 20",
        get_name(playerid));
        mysql_tquery(con_bd, STRING_GLOBAL, "ShowPlayerMessages", "d", playerid);
        return 1;
    }
    else if(playertextid == PhoneMain[playerid][39]) // ��������;
    {
        if(p_temp[playerid][offphone] == true) return SendError(playerid, "� ��� �������� �������, �������� ���.");
        if(!p_info[playerid][phone_number]) return SendError(playerid, "� ��� ��� ������ ��������.");
        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `phone_contacts`.`NickTarget`, `phone_contacts`.`MissedCalls`, `accounts`.`phone_number`, `accounts`.`online`, `phone_contacts`.`BlackList` FROM `phone_contacts`, `accounts` WHERE `phone_contacts`.`NickPlayer` = '%s' AND `accounts`.`name` = `phone_contacts`.`NickTarget` ORDER BY `phone_contacts`.`BlackList` DESC LIMIT 20",
        get_name(playerid));
        mysql_tquery(con_bd, STRING_GLOBAL, "MysqlShowContacts", "d", playerid);
        return 1;
    }
    else if(playertextid == PhoneMain[playerid][40]) // ���������;
    {
        STRING_MIN[0] = EOS;
        format(STRING_MIN, sizeof(STRING_MIN), "\
        "I"[1]"W" %s �������\n\
        "I"[2]"W" ������ �������", p_temp[playerid][offphone] ? "{"#cGREEN"}��������"W"" : "{"#cLIGHTRED"}���������"W"");
        ShowPlayerDialog(playerid, D_PHONE_SETTINGS, DIALOG_STYLE_LIST, ""I"���������", STRING_MIN, "�����", "������");
        return 1;
    }
    if(playertextid == Editor_PTD[playerid][84]) // x left
    {
        UpdatePlayerAttachedObject(playerid, TYPE_UPDATE_CAMERA_LEFT, TYPE_OFFSET_X);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][90]) // x right
    {
        UpdatePlayerAttachedObject(playerid, TYPE_UPDATE_CAMERA_RIGHT, TYPE_OFFSET_X);
        return 1;
    }
    else if(playertextid == Editor_PTD[playerid][70]) // y left
    {
