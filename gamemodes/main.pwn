                SetPlayerMoney(playerid, ADVERT_PRICE / 2, true, "отредактировал объявление");
                SetFractionWarehouse(p_info[playerid][member], fwMoney, ADVERT_PRICE/2);
                AdvertList(playerid);
                p_info[playerid][fracdata][17]++;
                SaveFracData(playerid);
                CheckPlayerMission(playerid, NEWS_EDIT);
                UpdateFamilyLevel(playerid);
                p_info[playerid][ftop_edit]++;
                MysqlUpdatePlayerInt(playerid, "ftop_edit", p_info[playerid][ftop_edit]);

                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `user_id` FROM `edit_advertise` WHERE `user_id` = %d",
                p_info[playerid][ID]);
                mysql_tquery(con_bd, STRING_GLOBAL, "OnMemoryCheckPlayerID", "i", playerid);
            }
            else SendAccess(playerid, "Вы отредактировали объявление.");
            AdvertInfo[GetPVarInt(playerid, "advert_id_to_sending") - 1][aIsTooked] = false;
            DeletePVar(playerid, "advert_id_to_sending");
            AdvertList(playerid);
            return 1;
        }
        case D_BOOMBOX:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0:
                {
                    if(p_temp[playerid][music_area] != -1) return SendError(playerid, "Вы уже установили музыкальный проигрыватель, теперь включите его.");
                    if(AntiDMZone(playerid)) return SendError(playerid, "Вы не можете установить музыкальный проигрыватель в \"Зеленой зоне\".");
                    ShowPlayerDialog(playerid, D_BOOMBOX_TYPE, DIALOG_STYLE_LIST, ""I"Тип", ""I"[1]"W" Колонка\n"I"[2]"W" Бумбокс", "Далее", "Отмена");
                    return 1;
                }
                case 1:
                {
                    if(p_temp[playerid][music_area] == -1) return SendError(playerid, "Сначала установите свой музыкальный проигрыватель.");
                    if(IsPlayerInRangeOfPoint(playerid, 3.0, GetPVarFloat(playerid, "BBX"), GetPVarFloat(playerid, "BBY"), GetPVarFloat(playerid, "BBZ")))
                    {
                        ShowPlayerRadio(playerid, RADIO_TYPE_BOOMBOX);
                    }
                    else return SendError(playerid, "Вы должны находиться рядом со своим музыкальным проигрывателем.");
                    return 1;
                }
                case 2:
                {
                    if(p_temp[playerid][music_area] == -1) return SendError(playerid, "Сначала установите свой музыкальный проигрыватель.");
                    if(IsPlayerInRangeOfPoint(playerid, 3.0, GetPVarFloat(playerid, "BBX"), GetPVarFloat(playerid, "BBY"), GetPVarFloat(playerid, "BBZ")))
                    {
                        PickUpBoombox(playerid);
                        SendAccess(playerid, "Вы забрали свой музыкальный проигрыватель.");
                    }
                    return 1;
                }
            }
            return 1;
        }
        case D_BOOMBOX_TYPE:
        {
            if(!response) return ShowPlayerDialog(playerid, D_BOOMBOX, DIALOG_STYLE_LIST, ""I"Музыкальный проигрыватель", ""I"[1]"W" Поставить\n"I"[2]"W" Включить\n"I"[3]"W" Забрать", "Далее", "Отмена");
            if(AntiDMZone(playerid)) return SendError(playerid, "Не возможно установить в Зеленой Зоне");
            if(p_temp[playerid][music_area] != -1) return SendError(playerid, "Вы уже установили музыкальный проигрыватель, теперь включите его.");
            PlayPlayerBoomBoxOrColumn(playerid, listitem);
            return 1;
        }
        case D_FLIN_MUSIC:
        {
            if(!response) return 1;
            if(p_info[playerid][p_flin_music_free] == 0)
            {
                p_info[playerid][p_flin_music_free] = 1;
                p_info[playerid][p_flin_music] = 1;
                if(p_info[playerid][p_flin_music_time]) p_info[playerid][p_flin_music_time] += 86400 * 3;
                else p_info[playerid][p_flin_music_time] = (timestamp + (86400 * 3));
                new year, month, day, hour, minute, second;
                gmtime(p_info[playerid][p_flin_music_time] - timestamp, year, month, day, hour, minute, second);
                SendMes(playerid, COLOR_GREEN, "[МУЗЫКАЛЬНАЯ ПОДПИСКА]:"W" Вы воспользовались бесплатной подпиской.");
                SendMes(playerid, COLOR_GREEN, "[МУЗЫКАЛЬНАЯ ПОДПИСКА]:"W" До окончания подписки осталось: %dм. %dд. %dч. %dм. %dс.", month-1, day-1, hour, minute, second);
                STRING_GLOBAL[0] = EOS;
                mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `p_flin_music_free` = %d, `p_flin_music` = %d, `p_flin_music_time` = %d WHERE `id` = %d",
                p_info[playerid][p_flin_music_free], p_info[playerid][p_flin_music], p_info[playerid][p_flin_music_time], p_info[playerid][ID]);
                mysql_tquery(con_bd, STRING_GLOBAL);
                return 1;
            }

            if(p_info[playerid][flinmoney] < RADIO_PRICE) return SendError(playerid, "У Вас нет столько Pinecrest Money.");
            if(!GivePlayerInventory(playerid, 733)) return SendError(playerid, "В инвентаре нет места.");

            p_info[playerid][flinmoney] -= RADIO_PRICE;
            MysqlUpdatePlayerInt(playerid, "flinmoney", p_info[playerid][flinmoney]);
            SendAccess(playerid, "Вы приобрели %s за %d Pinecrest Money.", ItemsInfo[733][iName], RADIO_PRICE);

            Log(LOG_player, INFO, "%s[%d](%s %s) приобретение %s за %d FM | #Donate",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                ItemsInfo[733][iName], RADIO_PRICE);
            return 1;
        }
        case D_PLAYER_TC_MENU:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0: ShowDialogBiz(playerid, TC_MINI_STATS);
                case 1: ShowDialogBiz(playerid, TC_INVITE);
                case 2: ShowDialogBiz(playerid, TC_UNINVITE);
                case 3: ShowDialogBiz(playerid, TC_HELP);
            }
            return 1;
        }
        case D_PLAYER_TC_INVITE:
        {
            if(!response) return ShowDialogBiz(playerid, TC_PLAYER_MENU);
            new biz_id = p_temp[playerid][p_tc_id];
            switch(b_info[biz_id][_tip])
            {
                case B_TAXI:
                {
                    if(p_info[playerid][level] < 2) return SendError(playerid, "У Вас нет 2-ого уровня.");
                    p_info[playerid][taxi_idx] = biz_id;
                    p_info[playerid][taxi_rank] = 1;
                    p_info[playerid][taxi_percent] = 30;
                    p_info[playerid][taxi_salary] = 0;
                    p_info[playerid][taxi_salary_all] = 0;
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `taxi_idx` = %d, `taxi_rank` = 1, `taxi_percent` = 30, `taxi_salary` = 0, `taxi_salary_all` = 0 WHERE `id` = %d",
                    p_info[playerid][taxi_idx], p_info[playerid][ID]);
                    mysql_tquery(con_bd, STRING_GLOBAL);
                    SendAccess(playerid, "Вы устроились в таксопарк %s [%d].", b_info[biz_id][_name], b_info[biz_id][b_mysql_id]);
                }
                case B_TRUCKER:
                {
                    if(p_info[playerid][level] < 10) return SendError(playerid, "У Вас нет 10-ого уровня.");
                    p_info[playerid][tc_idx] = biz_id;
                    p_info[playerid][tc_rank] = 1;
                    p_info[playerid][tc_percent] = 30;
                    p_info[playerid][tc_salary] = 0;
                    p_info[playerid][tc_salary_all] = 0;
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `tc_idx` = %d, `tc_rank` = 1, `tc_percent` = 30, `tc_salary` = 0, `tc_salary_all` = 0 WHERE `id` = %d",
