AdvertisingCheck(text[])
{
    for(new i = 1; i < sizeof(AdvertisingText); i++)
    {
        if(strfind(text, AdvertisingText[i], false) != -1)
        {
            return 1;
        }
    }
    return 0;
}

AdvertisingPunishment(playerid, text[], type)
{
    if(type == 1)
    {
        /*switch(p_info[playerid][p_vip])
        {
            case 1: p_info[playerid][jail_time] += ((180 * 60) / 100) * 90;
            case 2: p_info[playerid][jail_time] += ((180 * 60) / 100) * 80;
            case 3: p_info[playerid][jail_time] += ((180 * 60) / 100) * 70;
            default: p_info[playerid][jail_time] += 180*60;
        }

        SendInfo(playerid, "��� ��� ����� ��� ���� �� ���������� � �������.");
        SendInfo(playerid, "���������� ���-�� ������� �� ������ ���������� ����: /time");
        */
        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[ANTI-SPAM] %s [%d] �������: %s", get_name(playerid), playerid, text);
        SendAdminMessage(COLOR_RED, STRING_GLOBAL);

        //Log(LOG_player, INFO, "%s[%d](%s %s)[%d$] ������� ��� ���� �� 180 �����. �������: <%s>",
        //    get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash], text);
    }
    else
    {
        new year, month, day;

        getdate(year, month, day);
        new unbandate;
        if(p_info[playerid][p_vip])
        {
            if(p_info[playerid][p_vip] == 3 && p_info[playerid][p_add_vip] == 1) unbandate = (((30 * 86400) / 100) * 60) + timestamp;
            else
            {
                switch(p_info[playerid][p_vip])
                {
                    case 1: unbandate = (((30 * 86400) / 100) * 90) + timestamp;
                    case 2: unbandate = (((30 * 86400) / 100) * 80) + timestamp;
                    case 3: unbandate = (((30 * 86400) / 100) * 70) + timestamp;
                }
            }
        } else unbandate = (30 * 86400) + timestamp;

        STRING_GLOBAL[0] = EOS;
        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `table_ban` (`Name_Admin`, `Name_Player`, `Ban_Data`, `Unban_Data`, `Ban_Reason`) VALUES ('System', '%e', NOW(), %d, 'ANTI-SPAM')",
        get_name(playerid), unbandate);
        mysql_tquery(con_bd, STRING_GLOBAL);

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"��������! ��� ������ ��� {"#cLIGHTRED"}��������.\n\
            "W"��� �������(�): {"#cLIGHTRED"}System\n\
            "W"�����: {"#cLIGHTRED"}%02d:%02d:%02d\n\
            "W"����: {"#cLIGHTRED"}%d.%d.%d\n\
            "W"�������: {"#cLIGHTRED"}ANTI-SPAM\n\
            "W"������ �����: {"#cLIGHTRED"}30 ����\n\n\
            ����� ���������: {"#cLIGHTRED"}"FORUM_URL"\n"W"����� > ������ > {"#cLIGHTRED"}������ �� �������������",
            timestamp_hour, timestamp_minute, timestamp_second,
            year, month, day);

        ShowPlayerDialog(playerid,D_NULL,DIALOG_STYLE_MSGBOX, ""I"����������", STRING_GLOBAL,"�������","");

        STRING_GLOBAL[0] = EOS;
        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[ANTI-SPAM] %s [%d] ��� ������������ �� 30 ����. �������: %s", get_name(playerid), playerid, text);
        SendAdminMessage(COLOR_RED, STRING_GLOBAL);

        Log(LOG_player, INFO, "%s[%d](%s %s)[%d$] ��� ������������ �� 30 ����. �������: <%s>",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][cash], text);

        Kick(playerid);
    }
    return 1;
}

IsAAdminAttack(playerid, amount)
{
    if(p_info[playerid][admin] > 5) return 0;

    // �������� �������;
    if(GetPVarInt(playerid, "AntiAdminAttack") > 20 || GetPVarInt(playerid, "AntiAdminAssault") > 25) return OnPlayerSystemBan(playerid, "ADMIN-ATTACK");
    // ��������� �������;
    SetPVarInt(playerid, "AntiAdminAttack", GetPVarInt(playerid, "AntiAdminAttack") + amount);
    SetPVarInt(playerid, "AntiAdminAssault", GetPVarInt(playerid, "AntiAdminAssault") + 1);
    return 0;
}

OnPlayerSystemBan(playerid, reason[])
{
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s [%d] ��� ������������ ��������. �������: %s", get_name(playerid), playerid, reason);
    //WriteLog("attack", STRING_GLOBAL);

    new unbandate = timestamp + (365 * 86400);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `table_ban` (`Name_Admin`, `Name_Player`, `Ban_Data`, `Unban_Data`, `Ban_Reason`) VALUES ('System', '%e', NOW(), %d, '%e')",
    get_name(playerid), unbandate, reason);
    mysql_tquery(con_bd, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `admin` = 0, `admin_pass` = 0 WHERE `id` = %d",
    p_info[playerid][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL);

    SendClientMessage(playerid, COLOR_RED, "[Pinecrest]: I'll kill anyone who dare to go against me.");

    Kick(playerid);
    return 1;
}

UpdateHostname()
{
    new str[128];
    if(ServerInfo[Experian] == 1 && ServerInfo[DonationMultiplier] < 2)
    {
        format(str, sizeof(str), "hostname Pinecrest RolePlay | Server: %02d", SRV_ID);
        SendRconCommand(str);
        TextDrawSetString(TD_Actions[1], "�����������");
    }
    else
    {
        if(ServerInfo[DonationMultiplier] < 2) format(str, sizeof(str), "hostname Pinecrest RolePlay | Server: %02d | X%d EXP", SRV_ID, ServerInfo[Experian]);
        else if(ServerInfo[Experian] != 1 && ServerInfo[DonationMultiplier] > 1) format(str, sizeof(str), "hostname Pinecrest RolePlay | Server: %02d | X%d EXP | X%d DONATE", SRV_ID, ServerInfo[Experian], ServerInfo[DonationMultiplier]);
        else if(ServerInfo[DonationMultiplier] > 1) format(str, sizeof(str), "hostname Pinecrest RolePlay | Server: %02d | X%d DONATE", SRV_ID, ServerInfo[DonationMultiplier]);
        else format(str, sizeof(str), "hostname Pinecrest RolePlay | Server: %02d", SRV_ID);
        SendRconCommand(str);

        f(str, "�%d �����, X%d ��, �%d EXP", ServerInfo[DonationMultiplier], ServerInfo[Salary], ServerInfo[Experian]);
        TextDrawSetString(TD_Actions[1], str);
    }
    Logotype_Update();
    return 1;
}

