                strcat(STRING_GLOBAL,"4. Транспортное средство\n\n");
                strcat(STRING_GLOBAL,"Если указан тип '1', то в качестве количества приза - количество EXP\n");
                strcat(STRING_GLOBAL,"Если указаны типы '2' и '3', то соответственно указываете количество игровой валюты, и FM для выигрыша.\n");
                strcat(STRING_GLOBAL,"Если указан тип '4', то соответственно указываете ID транспортного средства.\n\n");
                strcat(STRING_GLOBAL,"{F6F7D8}Указывать все значения нужно через запятую!\n");
                strcat(STRING_GLOBAL,"Пример: 1,30,10\n");
                strcat(STRING_GLOBAL,"Где 1 - тип приза(Опыт), 3 - количество ЕХР, 10 - число доступных активаций промокода");
                ShowPlayerDialog(playerid,D_PROMO_CREATE_2,DIALOG_STYLE_INPUT, ""I"Создание промокода | Шаг: 2", STRING_GLOBAL,"Далее","Назад");
