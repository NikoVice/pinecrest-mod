        case D_BONUS_ACTIVE:
        {
            if(!response)
                return callcmd::menu(playerid, "/0");

            if(strlen(inputtext) > 0)
            {
                for(new i, j = strlen(inputtext); i < j; i++)
                {
                    if(inputtext[i] == '|')
                        inputtext[i] = 0;
                }
            }

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `promo_activations` WHERE `account_id` = %d AND `name_promo` = '%e'",
            p_info[playerid][ID], inputtext);
            mysql_tquery(con_bd, STRING_GLOBAL, "CheckPromo", "is", playerid, inputtext);
        }
        case D_TAKE_LIST:
        {
            if(!response) return 1;
            SetPVarInt(playerid, "take:list", listitem+1);
            switch(listitem)
            {
                case 0: ShowPlayerDialog(playerid, D_TAKE_SELECT, DIALOG_STYLE_INPUT, ""I"Лицензия на наземный транспорт", ""W"Введите ID игрока:", "Изъять", "Отмена");
                case 1: ShowPlayerDialog(playerid, D_TAKE_SELECT, DIALOG_STYLE_INPUT, ""I"Лицензия на мото-транспорт", ""W"Введите ID игрока:", "Изъять", "Отмена");
                case 2: ShowPlayerDialog(playerid, D_TAKE_SELECT, DIALOG_STYLE_INPUT, ""I"Лицензия на водный транспорт", ""W"Введите ID игрока:", "Изъять", "Отмена");
                case 3: ShowPlayerDialog(playerid, D_TAKE_SELECT, DIALOG_STYLE_INPUT, ""I"Лицензия на воздушный транспорт", ""W"Введите ID игрока:", "Изъять", "Отмена");
                case 4: ShowPlayerDialog(playerid, D_TAKE_SELECT, DIALOG_STYLE_INPUT, ""I"Лицензия на оружие", ""W"Введите ID игрока:", "Изъять", "Отмена");
                case 5: ShowPlayerDialog(playerid, D_TAKE_SELECT, DIALOG_STYLE_INPUT, ""I"Материалы", ""W"Введите ID игрока:", "Изъять", "Отмена");
                case 6: ShowPlayerDialog(playerid, D_TAKE_SELECT, DIALOG_STYLE_INPUT, ""I"Патроны", ""W"Введите ID игрока:", "Изъять", "Отмена");
                case 7: ShowPlayerDialog(playerid, D_TAKE_SELECT, DIALOG_STYLE_INPUT, ""I"Наркотики", ""W"Введите ID игрока:", "Изъять", "Отмена");
                case 8: ShowPlayerDialog(playerid, D_TAKE_SELECT, DIALOG_STYLE_INPUT, ""I"Оружие", ""W"Введите ID игрока:", "Изъять", "Отмена");
            }
            return 1;
        }
        case D_TAKE_SELECT:
        {
            if(!response) return DeletePVar(playerid, "take:list");
            if(((!IsPlayerFractionPolice(playerid) && p_info[playerid][member] != PRISON) || p_info[playerid][rang] < 4) && p_info[playerid][admin] < 4)
                return SendError(playerid, "Вы не можете пользоваться этой командой.");
            new fix_listitem;
            if(sscanf(inputtext, "i", fix_listitem)) return SendError(playerid, "Вы ничего не ввели.");
            if(fix_listitem == INVALID_PLAYER_ID) return SendError(playerid, "Игрок не найден.");
            if(fix_listitem == playerid) return SendError(playerid, "Вы ввели свой ID.");
            if(!IsPlayerStream(5.0, playerid, fix_listitem) || pSpectateId[fix_listitem] != INVALID_PLAYER_ID) return SendError(playerid, "Игрок слишком далеко от Вас.");
            new string[144];
            new idx = GetPVarInt(playerid, "take:list");
            DeletePVar(playerid, "take:list");
            switch(idx)
            {
                case 1 .. 5:
                {
                    if(p_info[fix_listitem][Lic][idx - 1] != 1) return SendError(playerid, "У игрока нет лицензии на \"%s\".", name_license[idx - 1]);

                    p_info[fix_listitem][Lic][idx - 1] = 0;
                    p_info[fix_listitem][Lic_Warn][idx - 1] = 0;
                    p_info[fix_listitem][Lic_Time][idx - 1] = 0;
                    format(string, sizeof(string), "%s забрал(а) у %s лицензию на \"%s\"", get_name(playerid), get_name(fix_listitem), name_license[idx - 1]);
                    OnPlayerUpdateLicData(fix_listitem);
                }
                case 6:
                {
                    if(GetInventoryAmount(fix_listitem, 627) == 0) return SendError(playerid, "У игрока нет материалов.");

                    if(p_info[playerid][Update][2] == 1)
                    {
                        switch(random(5))
                        {
                            case 1, 2:
                            {
                                format(string, sizeof(string), "%s забрал(а) у %s материалы", get_name(playerid) , get_name(fix_listitem));
                                GivePlayerInventory(fix_listitem, 627, -GetInventoryAmount(fix_listitem, 627));
                            }
                            default: return SendError(playerid, "Вы ничего не нашли.");
                        }
                    }
                    format(string, sizeof(string), "%s забрал(а) у %s материалы", get_name(playerid) , get_name(fix_listitem));
                    GivePlayerInventory(fix_listitem, 627, -GetInventoryAmount(fix_listitem, 627));
                }
                case 7:
                {
                    if(GetInventoryAmount(fix_listitem, 628) == 0) return SendError(playerid, "У игрока нет патронов.");

                    if(p_info[playerid][Update][2] == 1)
                    {
                        switch(random(5))
                        {
                            case 1, 2:
                            {
                                format(string, sizeof(string), "%s забрал(а) у %s патроны", get_name(playerid) , get_name(fix_listitem));
                                GivePlayerInventory(fix_listitem, 628, -GetInventoryAmount(fix_listitem, 628));
                            }
                            default: return SendError(playerid, "Вы ничего не нашли.");
                        }
                    }

                    format(string, sizeof(string), "%s забрал(а) у %s патроны", get_name(playerid) , get_name(fix_listitem));
                    GivePlayerInventory(fix_listitem, 628, -GetInventoryAmount(fix_listitem, 628));
                }
                case 8:
                {
                    if(GetInventoryAmount(fix_listitem, 629) == 0) return SendError(playerid, "У игрока нет наркотиков.");

                    if(p_info[playerid][Update][2] == 1)
                    {
                        switch(random(5))
                        {
                            case 1, 2:
                            {
                                format(string, sizeof(string), "%s забрал(а) у %s наркотики", get_name(playerid), get_name(fix_listitem));
                                GivePlayerInventory(fix_listitem, 629, -GetInventoryAmount(fix_listitem, 629));
                            }
                            default: return SendError(playerid, "Вы ничего не нашли.");
                        }
                    }

                    format(string, sizeof(string), "%s забрал(а) у %s наркотики", get_name(playerid) , get_name(fix_listitem));
                    GivePlayerInventory(fix_listitem, 629, -GetInventoryAmount(fix_listitem, 629));
                }
                case 9:
                {
                    new count = 0;
                    for(new i; i < MAX_WEAPONS; i++)
                    {
                        if(p_info[fix_listitem][Weapon][i] != 0) count++;
                    }

                    if(count == 0) return SendError(playerid, "У игрока нет оружия.");

                    format(string, sizeof(string), "%s забрал(а) у %s оружие", get_name(playerid), get_name(fix_listitem));
                    f_ResetPlayerWeapons(fix_listitem);
                }
            }
            ProxDetector(10.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);

            p_info[playerid][fracdata][7]++;
            SaveFracData(playerid);

            CheckPlayerMission(playerid, POLICE_TAKE);
            UpdateFamilyLevel(playerid);

            p_info[playerid][ftop_take]++;
            MysqlUpdatePlayerInt(playerid, "ftop_take", p_info[playerid][ftop_take]);
            return true;
        }
        case D_BUY_HEAL_ADDICT_PICKUP:
        {
            if(!response) return 1;
            if(p_info[playerid][cash] < 1000)
                return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
            OnServerInfoForMoney[23] += 1000;
            SetPlayerMoney(playerid, -1000, true, "лечение от ломки");
            p_info[playerid][d_addiction] = 0;
            SendAccess(playerid, "Вы вылечились от наркозависимости.");
            return 1;
        }
        case D_FBI_SPY:
        {
            if(!response) return 1;
            new frac_id, skin_id;
            if(sscanf(inputtext, "p<,>ii", frac_id, skin_id)) return SendError(playerid, "Вы ничего не ввели.");
            STRING_GLOBAL[0] = EOS;
            frac_id--, skin_id--;
            //if(frac_id == FREE_SLOT_FRAC) return SendError(playerid, "Данная организация недоступна.");
            if(!(0 <= frac_id < MAX_FRACTIONS) || !(0 <= skin_id <= 9)) return SendError(playerid, "Введите ID фракции и ID ранга.");
            if(frac_id == 0)
            {
                p_temp[playerid][SpyStatus] = 0;
                p_temp[playerid][SpyRang] = 0;
                SetPlayerSkin(playerid, p_info[playerid][sex] == 2 ? 78 : 90);
                SetPlayerColor(playerid,  fraction_color[0]);
                SendAccess(playerid, "Вы замаскировались под фракцию \"%s\".", GetFractionName(0));
                SendInfo(playerid, "Управление маскировкой: /spy");
            }
            else
            {
                p_temp[playerid][SpyStatus] = frac_id;
                p_temp[playerid][SpyRang] = skin_id;
                if(p_info[playerid][sex] == 2) SetPlayerSkin(playerid, FractionsData[frac_id][fManSkin][skin_id]);
                else SetPlayerSkin(playerid, FractionsData[frac_id][fWomanSkin][skin_id]);
                SetPlayerColor(playerid, fraction_color[frac_id]);
            }
            SetPVarInt(playerid,"spy_fbi", frac_id);

            if(p_info[playerid][p_settings][ROLEPLAY] == 1)
            {
                DoAction(playerid, "Сумка с формой в правой руке.");
                MeAction(playerid, "осмотрев содержимое сумки вытащил из нее нужную форму, после чего переоделся");
            }
            return 1;
        }
        case D_MEH_CONTRACT:
        {
            if(!response) return 1;
            new litres;
            if(sscanf(inputtext, "i", litres)) return SendError(playerid, "Вы ничего не ввели.");

            if((litres%2) > 0 || litres == 0) return SendError(playerid, "Кол-во топлива должно быть крыным двум.");
            if(litres < 100 || litres > 1000) return SendError(playerid, "Кол-во топлива должно быть не менее 100 и не более 1000.");

            new idx = GetPVarInt(playerid,"bID");
            new price = BIZZ_FILL_PRICE * litres * b_info[idx][_till];

            if(p_info[playerid][cash] < price) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");

            new mehname [32];
            GetPVarString(playerid,"MehName",mehname,32);

            if(b_info[idx][_prod] >= litres)
            {
                b_info[idx][_prod] -= litres;
                b_info[idx][_bank] += (price / 100) * 90;
                AddMafiaBank(idx, price/10);

                biz_finka[idx] += (price / 100) * 90;
                UpdateIntForFinanceBiz(idx, (price / 100) * 90);
            }

            OnServerInfoForMoney[10] += price;
            SetPlayerMoney(playerid, -price, true, "заправка автомобиля");
            SetPVarInt(playerid,"toplivo",GetPVarInt(playerid,"toplivo") + litres);
            return 1;
        }
        case D_EMAIL_SELECT_TYPE:
        {
            if(!response) return 1;
            SendCodeMail(playerid, p_info[playerid][mail]);
            switch(listitem)
            {
                case 0:
                    ShowPlayerDialog(playerid, D_EMAIL_UNBINDING, DIALOG_STYLE_INPUT, ""I"E-Mail", ""W"Для отвязки текущей почты.\nВведите код высланный Вам на Email адрес:", "Далее", "Отмена");
                case 1:
                    ShowPlayerDialog(playerid, D_EMAIL_OLD_UNLINK, DIALOG_STYLE_INPUT, ""I"E-Mail", ""W"Для смены текущей почты на новую.\nВведите код высланный Вам на Email адрес:", "Далее", "Отмена");
            }
            return 1;
        }
        case D_EMAIL_OLD_UNLINK:
        {
            if(!response) return 1;
            if(!strlen(p_info[playerid][mail]))
                return SendError(playerid, "Ваш E-Mail отвязан.");
            if(!strlen(inputtext) || strval(inputtext) != p_temp[playerid][random_code])
            {
                SendError(playerid, "Код введен неверно, повторите попытку.");
                return  ShowPlayerDialog(playerid, D_EMAIL_OLD_UNLINK, DIALOG_STYLE_INPUT, ""I"E-Mail", ""W"Для смены текущей почты на новую.\nВведите код высланный Вам на Email адрес:", "Далее", "Отмена");
            }
            SetPVarInt(playerid, #PROTECTION_DIALOG, 1);
            ShowPlayerDialog(playerid, D_EMAIL_NEW_LINK, DIALOG_STYLE_INPUT, ""I"E-Mail", ""W" Чтобы предотвратить потерю Вашего аккаунта, мы хотим\n\
                защитить его с помощью привязки к электронной почте.\n\
                Это поможет не допустить попытку взлома или утери данных\n\
                аккаунта.\n\n\
                "I"Вводите настоящую, ее надо будет подтвердить, подходит только Google/Yandex.", "Далее", "Отмена");
            return 1;
        }
        case D_EMAIL_NEW_LINK:
        {
            new protection = GetPVarInt(playerid, #PROTECTION_DIALOG);
            DeletePVar(playerid, #PROTECTION_DIALOG);
            if(!response || !protection)
                return 1;
            if(!(5 <= strlen(inputtext) <= 36))
            {
                SetPVarInt(playerid, #PROTECTION_DIALOG, 1);
                return ShowPlayerDialog(playerid, D_EMAIL_NEW_LINK, DIALOG_STYLE_INPUT, ""I"E-Mail", ""W" Чтобы предотвратить потерю Вашего аккаунта, мы хотим\n\
                    защитить его с помощью привязки к электронной почте.\n\
                    Это поможет не допустить попытку взлома или утери данных\n\
                    аккаунта.\n\n\
                    "I"Вводите настоящую, ее надо будет подтвердить, подходит только Google/Yandex.", "Далее", "Отмена");
            }
            if(strfind(inputtext, "@", true) == -1 || strfind(inputtext, ".", true) == -1)
            //if(strfind(inputtext, "@gmail.com", true) == -1 && strfind(inputtext, "@yandex.ru", true) == -1)
            {
                SetPVarInt(playerid, #PROTECTION_DIALOG, 1);
                SendError(playerid, "Только Google или Yandex.");
                ShowPlayerDialog(playerid, D_EMAIL_NEW_LINK, DIALOG_STYLE_INPUT, ""I"E-Mail", ""W" Чтобы предотвратить потерю Вашего аккаунта, мы хотим\n\
                защитить его с помощью привязки к электронной почте.\n\
                Это поможет не допустить попытку взлома или утери данных\n\
                аккаунта.\n\n\
                "I"Вводите настоящую, ее надо будет подтвердить, подходит только Google/Yandex.", "Далее", "Отмена");
                return 1;
            }
            SendCodeMail(playerid, inputtext);
            SetPVarString(playerid, #MAIL_NEW, inputtext);
            ShowPlayerDialog(playerid, D_EMAIL_NEW_LINK_CONFIRM, DIALOG_STYLE_INPUT, ""I"E-Mail", ""W"Введите код высланный Вам на Email адрес:", "Дальше", "Отмена");
            return 1;
        }
        case D_EMAIL_NEW_LINK_CONFIRM:
        {
            new mail_new[64];
            GetPVarString(playerid, #MAIL_NEW, mail_new);
            DeletePVar(playerid, #MAIL_NEW);
            if(!response) return 1;
            if(!strlen(inputtext) || strval(inputtext) != p_temp[playerid][random_code])
            {
                SendError(playerid, "Код введен неверно, повторите попытку.");
                return  ShowPlayerDialog(playerid, D_EMAIL_NEW_LINK_CONFIRM, DIALOG_STYLE_INPUT, ""I"E-Mail", ""W"Для смены текущей почты на новую.\nВведите код высланный Вам на Email адрес:", "Далее", "Отмена");
            }
            p_info[playerid][mail][0] = EOS;
            strcat(p_info[playerid][mail], mail_new);
            p_info[playerid][email_confirmed] = 1;

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `mail` = '%e', `email_confirmed` = %d WHERE `id` = %d",
                p_info[playerid][mail], p_info[playerid][email_confirmed], p_info[playerid][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            SendAccess(playerid, "Новый E-Mail привязан.");
            return 1;
        }
        case D_EMAIL_UNBINDING:
        {
            if(!response) return 1;
            if(!strlen(p_info[playerid][mail]))
                return SendError(playerid, "E-Mail не привязан.");
            if(!strlen(inputtext) || strval(inputtext) != p_temp[playerid][random_code])
            {
                SendError(playerid, "Код введен неверно, повторите попытку.");
                return ShowPlayerDialog(playerid, D_EMAIL_UNBINDING, DIALOG_STYLE_INPUT, ""I"E-Mail", ""W"Для отвязки текущей почты.\nВведите код высланный Вам на Email адрес:", "Далее", "Отмена");
            }
            p_info[playerid][mail][0] = EOS;
            p_info[playerid][email_confirmed] = 0;

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `mail` = '%e', `email_confirmed` = %d WHERE `id` = %d",
            p_info[playerid][mail], p_info[playerid][email_confirmed], p_info[playerid][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            SendAccess(playerid, "Вы отвязали E-Mail.");
            return 1;
        }
        case D_EMAIL_CONFIRM:
        {
            if(!response) return 1;
            if(p_info[playerid][email_confirmed])
                return SendError(playerid, "E-Mail уже подтвержден.");
            if(!strlen(inputtext) || strval(inputtext) != p_temp[playerid][random_code])
            {
                SendError(playerid, "Код введен неверно, повторите попытку.");
                return ShowPlayerDialog(playerid, D_EMAIL_CONFIRM, DIALOG_STYLE_INPUT, ""I"E-mail", ""W"Введите код высланный Вам на Email адрес:", "Далее", "Отмена");
            }
            p_info[playerid][email_confirmed] = 1;
            MysqlUpdatePlayerInt(playerid, "email_confirmed", p_info[playerid][email_confirmed]);
            SendAccess(playerid, "Вы подтвердили E-Mail.");
            return 1;
        }

        case D_LOAD_CAR:
        {
            if(!response) return 1;
            if(listitem >= p_temp[playerid][loadcar_max])
            {
                new price, idx_list = p_temp[playerid][p_listitem_int], id_count = (idx_list == VEHICLE_STATE_CAR) ? (1) : (0),
                count_veh = p_info[playerid][veh_slots][idx_list]-id_count;
                if(count_veh <= 0) count_veh = 1;
                price = 250 * count_veh;
                p_temp[playerid][p_listitem][0] = idx_list;
                p_temp[playerid][p_listitem][1] = price;
                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                Вы желаете приобрести дополнительный слот для {"#cGREEN"}\"%s\"?"W"\n\n\
                Стоимость: "I"%d Pinecrest Money"W"\n\n\
                Доп. слотов на данный момент: {"#cLIGHTRED"}%d"W"\n\
                Стоимость след. доп. слота: {"#cLIGHTRED"}%d"W" Pinecrest Money", vehicle_type_name[idx_list], price, count_veh-1, price+250);
                ShowPlayerDialog(playerid, D_BUY_VEH_SLOTS, DIALOG_STYLE_MSGBOX, ""I"Слоты для транспортных средств", STRING_GLOBAL, "Далее", "Отмена");
            }
            else
            {
                if(listitem == -1) return SendError(playerid, "Что-то пошло не так, попробуйте заново или обновите версию клиента.");
                if(p_temp[playerid][p_listitem_cars][listitem] == -1) return callcmd::cars(playerid, "/0");
                new index_list = p_temp[playerid][p_listitem_cars][listitem],
                    vehicleid = GetPlayerVehicleMySQLID(playerid, index_list, E_PLAYER_VEHICLES_VALUE:E_VEHICLIE_ID);
                p_temp[playerid][p_listitem_cars][listitem] = -1;

                if(vehicleid == -1)
                {
                    if(GetFreeSlotVehicle(playerid) == ALL_BUSY_SLOT_VEHICLE)
                    {
                        SendError(playerid, "У Вас уже есть загруженные транспортные средства.");
                        SendInfo(playerid, "Используйте /cars чтобы выгрузить их из сервера.");
                        return 1;
                    }
                    STRING_GLOBAL[0] = EOS;
                    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `vehicle` WHERE `v_mysql_id` = %d AND `v_owner_id` = %d LIMIT 1",
                    index_list, p_info[playerid][ID]);
                    mysql_tquery(con_bd, STRING_GLOBAL, "LoadPlayerVehicle", "i", playerid);
                }
                else if(index_list == veh_info[vehicleid][v_mysql_id])
                {
                    new vehicle_slot = GetPlayerVehicleMySQLID(playerid, index_list);
                    if(vehicle_slot == -1)
                        return SendError(playerid, "Автомобиля в этом слоте не найдено.");
                    p_info[playerid][active_vehicle_id] = vehicle_slot;
                    ShowPlayerDialog(playerid, D_PLAYER_VEHICLE, DIALOG_STYLE_LIST, ""I"Меню личного транспорта", "\
                        "I"[1]"W" Тех. паспорт\n\
                        "I"[2]"W" Управление элементами\n\
                        "I"[3]"W" Заправить из канистры\n\
                        "I"[4]"W" Починить рем. комплектом\n\
                        "I"[5]"W" Припарковать\n\
                        "I"[6]"W" Продать по гос. цене\n\
                        "I"[7]"W" Доставить\n\
                        "I"[8]"W" Отметить на GPS навигаторе\n\
                        "I"[9]"E" Выгрузить из сервера", "Выбрать", "Отмена");
                }
                else UnLoadPlayerVehicle(playerid, vehicleid);
            }
            return 1;
        }
        case D_PLAYER_VEHICLE:
        {
            if(!response) return 1;
            new vehicleid = GetPlayerVehicleIDEx(playerid);
            if(vehicleid == INVALID_VEHICLE_ID)
                return SendError(playerid, "Транспорт в этом слоте не найдено.");
            if(listitem <= 5 && GetPlayerVehicleID(playerid) != vehicleid && GetPlayerState(playerid) != PLAYER_STATE_ONFOOT)
                return SendError(playerid, "Вы не находитесь в выбранном автомобиле.");
            switch(listitem)
            {
                case 0: callcmd::carpass(playerid, "/0");
                case 1: callcmd::carmenu(playerid, "/0");
                case 2: callcmd::pour(playerid, "/0");
                case 3: callcmd::repaircar(playerid, "/0");
                case 4: callcmd::park(playerid, "/0");
                case 5: callcmd::sellcar(playerid, "/0");
                case 6: VehiclePlayer_Delivery(playerid, vehicleid);
                case 7: VehiclePlayer_Find(playerid, vehicleid);
                case 8: UnLoadPlayerVehicle(playerid, vehicleid);
            }
            return 1;
        }
        case D_EXIT_LOAD_UNLOAD:
        {
            new idx = GetPVarInt(playerid, "LoadUnload:idx");
            DeletePVar(playerid, "LoadUnload:idx");

            if(!response) return RemovePlayerFromVehicle(playerid);

            new vehicleid = GetPlayerVehicleID(playerid);

            if(veh_info[vehicleid][v_loading] == 0) return SendError(playerid, "Загрузка или разгрузка уже закончена.");

            switch(idx)
            {
                case 1:
                {
                    SendMes(playerid, COLOR_BLUE, "Вы закончили загрузку наркотиков.");
                    SendMes(playerid, COLOR_LIME, "Выгрузить наркотики: {"#cLYELLOW"}/unload");
                }
                case 2:
                {
                    SendMes(playerid, COLOR_BLUE, "Вы закончили загрузку патронов и материалов.");
                    SendMes(playerid, COLOR_LIME, "Разгрузить патроны и материалы: {"#cLYELLOW"}/unload");
                }
                case 3:
                {
                    SendMes(playerid, COLOR_BLUE, "Вы закончили загрузку патронов и материалов.");
                    SendMes(playerid, COLOR_LIME, "Список гос. контрактов: {"#cLYELLOW"}/warehouse");
                    SendMes(playerid, COLOR_LIME, "Разгрузить патроны и материалы: {"#cLYELLOW"}/unload");
                }
                case 4:
                {
                    SendMes(playerid, COLOR_BLUE, "Вы закончили загрузку медикаментов.");
                    SendMes(playerid, COLOR_LIME, "Разгрузить медикаменты: {"#cLYELLOW"}/unload");
                }
                case 5:
                {
                    SendMes(playerid, COLOR_BLUE, "Вы закончили загрузку бочек с нефтью.");
                    SendMes(playerid, COLOR_LIME, "Разгрузить бочки: {"#cLYELLOW"}/oil");
                    ExitCount[playerid] = 0;
                    p_temp[playerid][ExitCarTimer] = false;
                }
                case 6:
                {
                    SendMes(playerid, COLOR_BLUE, "Вы закончили разгрузку бочек с нефтью.");
                    SendMes(playerid, COLOR_LIME, "Загрузить бочки: {"#cLYELLOW"}/oil");
                    ExitCount[playerid] = 0;
                    p_temp[playerid][ExitCarTimer] = false;
                }
                case 7:
                {
                    SendMes(playerid, COLOR_BLUE, "Вы закончили загрузку мешков с мусором.");
                    SendMes(playerid, COLOR_LIME, "Разгрузить мешки с мусором: {"#cLYELLOW"}/road");
                    ExitCount[playerid] = 0;
                    p_temp[playerid][ExitCarTimer] = false;
                }
                case 8:
                {
                    SendMes(playerid, COLOR_BLUE, "Вы закончили разгрузку мешков с мусором.");
                    SendMes(playerid, COLOR_LIME, "Загрузить мешки с мусором: {"#cLYELLOW"}/road");
                    ExitCount[playerid] = 0;
                    p_temp[playerid][ExitCarTimer] = false;
                }
            }

            if(veh_info[vehicleid][v_text] != INVALID_3DTEXT_ID)
            {
                Delete3DTextLabel(veh_info[vehicleid][v_text]);
                veh_info[vehicleid][v_text] = INVALID_3DTEXT_ID;
            }

            if(veh_info[vehicleid][v_pickup] != -1)
            {
                DestroyDynamicPickup(veh_info[vehicleid][v_pickup]);
                veh_info[vehicleid][v_pickup] = -1;
            }
            veh_info[vehicleid][v_loading] = 0;
            veh_info[vehicleid][v_loading_playerid] = INVALID_PLAYER_ID;
            return 1;
        }
        case D_DONATE:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0:
                {
                    if(!IsPlayerMobile(playerid))
                    {
                        callcmd::donate(playerid, "/0");
                        return SendError(playerid, "С ПК не работает.");
                    }
                    SendInfo(playerid, "Если у Вас ничего не отображается, обновите клиент до последней версии.");
                    SendShowDonate(playerid);
                }
                case 1: ShowPlayerDonate(playerid, DONATE_TYPE_MONEY);
                case 2:
                {
                    if(GetMaxCountDonateHotDeals(HOT_DEALS_TYPE_OVER_SIZED) <= 0) return ShowPlayerDonate(playerid, DONATE_TYPE_MENU), SendError(playerid, "На данный момент нет горячих предложений крупногабаритного типа.");
                    ShowPlayerListTD(playerid, LIST_TD_ID_HOT_DEALS_OVER_SIZED);
                }
                case 3:
                {
                    if(GetMaxCountDonateHotDeals(HOT_DEALS_TYPE_SMALL_SIZED) <= 0) return ShowPlayerDonate(playerid, DONATE_TYPE_MENU), SendError(playerid, "На данный момент нет горячих предложений малогабаритного типа.");
                    ShowPlayerList(playerid, LIST_ID_HOT_DEALS_SMALL_SIZED);
                }
                case 4:
                {
                    if(IsPlayerMobile(playerid) && GetPlayerGameVersion(playerid) < CLIENT_VERSION_022023)
                        return SendInfo(playerid, "У вас что-то с файлами игры или клиентом игры, введите /realhelp.");

                    ShowPlayerListTD(playerid, LIST_TD_ID_DONATE_REAL_CARS);
                }
                case 5: ShowPlayerListTD(playerid, LIST_TD_ID_DONATE_VEHICLE);
                case 6: ShowPlayerListTD(playerid, LIST_TD_ID_DONATE_SKIN);
                case 7: 
                {
                    if(GetPlayerGameVersion(playerid) < CLIENT_VERSION_20022023)
                        return SendInfo(playerid, "У вас что-то с файлами игры или клиентом игры, введите /realhelp.");
                    ShowPlayerListTD(playerid, LIST_TD_ID_DONATE_REAL_SKIN);
                }
                case 8: ShowPlayerListTD(playerid, LIST_TD_ID_DONATE_ACCESSORIES);
                case 9: ShowPlayerListTD(playerid, LIST_TD_ID_DONATE_VEHICLE_TUNE);
                case 10: ShowPlayerListTD(playerid, LIST_TD_ID_DONATE_TENT);
                case 22: ShowPlayerDonate(playerid, DONATE_TYPE_OTHER);
                default: ShowPlayerDonate(playerid, DONATE_TYPE_MAIN, listitem - 4);
            }
            return 1;
        }
        case D_DONATE_MONEY:
        {
            if(!response) return ShowPlayerDonate(playerid, DONATE_TYPE_MENU);
            new fix_listitem;
            if(sscanf(inputtext, "i", fix_listitem)) return SendError(playerid, "Вы ничего не ввели.");
            if(p_info[playerid][flinmoney] <= 0) return SendError(playerid, "У Вас нет Pinecrest Money.");
            if(fix_listitem < 50) return SendError(playerid, "Количество Pinecrest Money не может быть менее 50.");
            if(fix_listitem > p_info[playerid][flinmoney]) return SendError(playerid, "Количество Pinecrest Money не может быть более %d.", p_info[playerid][flinmoney]);
            new price = fix_listitem * ServerInfo[Donate];
            SetPlayerMoney(playerid, price, true, "донат конверт");
            p_info[playerid][flinmoney] -= fix_listitem;

            SendAccess(playerid, "Вы конвертировали %d Pinecrest Money в %d$.", fix_listitem, price);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `flinmoney` = %d, `money` = %d WHERE `id` = %d",
            p_info[playerid][flinmoney], p_info[playerid][cash], p_info[playerid][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            ShowPlayerDonate(playerid, DONATE_TYPE_MENU);

            Log(LOG_player, INFO, "%s[%d](%s %s) конвертирование игровой валюты %d FM в %d$ | #Donate",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
                fix_listitem, (fix_listitem * ServerInfo[Donate]));
            return 1;
        }

        case D_DONATE_MAIN:
        {
            if(!response) return ShowPlayerDonate(playerid, DONATE_TYPE_MENU);
            PlayerDonateBuy(playerid, listitem);
            return 1;
        }
        case D_DONATE_OTHER:
        {
            if(!response) return ShowPlayerDonate(playerid, DONATE_TYPE_MENU);
            switch(listitem)
            {
                case 0:
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"Вы желаете снять предупреждение?\n\nСтоимость: "I"%d Pinecrest Money", donate_warn);
                    ShowPlayerDialog(playerid, D_DONATE_UNWARN, DIALOG_STYLE_MSGBOX, ""I"Снять предупреждение", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 1: 
                {
                    ShowPlayerDialog(playerid, D_CHANGE_NICK, DIALOG_STYLE_INPUT, ""I"Изменить ник", 
                            ""W"Если Вы по каким-то причинам хотите сменить свой никнейм, введите новый в поле ниже:\n\n\
                            "I"Примечания:"W" Имя должно соответствовать правилам сервера (формат Nick_Name), состоять\n\
                            только из букв, не являться оскорбляющим).", "Далее", "Отмена");
                }
                case 2: ShowPlayerDialog(playerid, D_SLOTS_DONATE, DIALOG_STYLE_LIST, ""I"Слоты", ""I"[1]"W" Слоты для транспортных средств\n"I"[2]"W" Слоты для бизнесов\n"I"[3]"W" Слоты для домов\n"I"[4]"W" Слоты для инвентаря", "Далее", "Отмена");
                case 3: ShowPlayerDialog(playerid, D_DONATE_BUY_NUMBER, DIALOG_STYLE_INPUT, ""I"Номер телефона", ""W"Введите номер телефона от "I"3"W" до "I"6"W" цифр:\n\n{"#cRED"}Обратите внимание! От количества одинаковых цифр зависит стоимость номера телефона.", "Далее", "Отмена");
                case 4: ShowPlayerDialog(playerid, D_DONATE_BUY_EXP, DIALOG_STYLE_INPUT, ""I"Очки опыта", ""W"Введите количество очков опыта:\n\nСтоимость: "I"1"W" очка опыта "I"4 Pinecrest Money", "Далее", "Отмена");
                case 5:
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    Вы желаете приобрести гражданские монеты?\n\n\
                    Введите кол-во гражданских монет от "I"1"W" до "I"%d:"W"\n\n\
                    Стоимость: "I"1"W" гражданской монеты "I"2 Pinecrest Money", GetInventoryAmount(playerid, 641));
                    ShowPlayerDialog(playerid, D_DONATE_BUY_CIVIL_COINS, DIALOG_STYLE_INPUT, ""I"Гражданские монеты", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 6:
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    Вы желаете приобрести семейные монеты?\n\n\
                    Введите кол-во семейных монет монет от "I"1"W" до "I"%d:"W"\n\n\
                    Стоимость: "I"1"W" семейной монеты "I"2 Pinecrest Money", GetInventoryAmount(playerid, 645));
                    ShowPlayerDialog(playerid, D_DONATE_BUY_FAMILY_COINS, DIALOG_STYLE_INPUT, ""I"Семейные монеты", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 7:
                {
                    if(p_info[playerid][family_id] == -1) return SendError(playerid, "Вы не состоите в семье.");
                    new family_idx = GetPlayerFamilyID(playerid);
                    if(family_idx == -1) return SendError(playerid, "Вы не состоите в семье.");

                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    Вы желаете приобрести семейные EXP?\n\n\
                    Информация: {"#cLIGHTRED"}семейные EXP расширяют ее возможности."W"\n\n\
                    Введите кол-во EXP от "I"1"W" до "I"%d:"W"\n\n\
                    Стоимость: "I"2"W" EXP "I"2 Pinecrest Money", ((FamilyData[family_idx][fLevel]+1)*COUNT_EXP_FAMILY)-FamilyData[family_idx][fExp]);
                    ShowPlayerDialog(playerid, D_FAMILY_BUY_EXP, DIALOG_STYLE_INPUT, ""I"Семейные EXP", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 8:
                {
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "\
                    "I"Pinecrest Music"W" дает вам мгновенный доступ к тысячам песен — от старых фаворитов до последних хитов.\n\
                    Просто нажмите кнопку воспроизведения, чтобы транслировать все, что вам нравится.\n\n\
                    Рэп, хип-хоп, рок, фонк, поп-музыка, эстрадная музыка, классическая музыка, панк и джаз, все это есть\n\
                    в подписке за "I"%d"W" Pinecrest Money в месяц.\n\n\
                    %s", RADIO_PRICE, p_info[playerid][p_flin_music_free] == 0 ? "Хотите попробовать 3 дня подписки бесплатно?" : "Хотите перейти к оформлению подписки?");
                    ShowPlayerDialog(playerid, D_FLIN_MUSIC, DIALOG_STYLE_MSGBOX, ""I"Подписка Pinecrest Music", STRING_GLOBAL, "Да", "Нет");
                }
                case 9:
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    Вы желаете приобрести \"Premium\" на транспортное средство?\n\n\
                    Данный предмет будет добавлен в инвентарь, в дальнейшем его можно будет установить\n\
                    на транспортное средство или продать другим игрокам на центральном рынке.\n\n\
                    Привилегий \"Premium\":\n\n\
                    \t— {"#cLIGHTRED"}В транспортном средстве не ломаются детали;"W"\n\
                    \t— {"#cLIGHTRED"}Стоимость доставки транспортного средства с помощью "W"/cars{"#cLIGHTRED"} и "W"/fixcar{"#cLIGHTRED"} ниже в два раза;"W"\n\n\
                    Стоимость: "I"%d Pinecrest Money", donate_vehicle_premium);
                    ShowPlayerDialog(playerid, D_DONATE_BUY_PREMIUM_CAR, DIALOG_STYLE_MSGBOX, ""I"Premium на транспортное средство", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 10:
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    Вы желаете приобрести \"Premium\" на аксессуар?\n\n\
                    Данный предмет будет добавлен в инвентарь, в дальнейшем его можно будет установить\n\
                    на аксессуар или продать другим игрокам на центральном рынке.\n\n\
                    Привилегий \"Premium\":\n\n\
                    \t— {"#cLIGHTRED"}Состояние аксессуара не изнашивается;"W"\n\n\
                    Стоимость: "I"%d Pinecrest Money", donate_acc_premium);
                    ShowPlayerDialog(playerid, D_DONATE_BUY_PREMIUM_ACC, DIALOG_STYLE_MSGBOX, ""I"Premium на аксессуар", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 11:
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    Вы желаете приобрести \"Premium\" на скин?\n\n\
                    Данный предмет будет добавлен в инвентарь, в дальнейшем его можно будет установить\n\
                    на скин или продать другим игрокам на центральном рынке.\n\n\
                    Привилегий \"Premium\":\n\n\
                    \t— {"#cLIGHTRED"}Одежда не загрязняется и ее нет необходимости стирать;"W"\n\n\
                    Стоимость: "I"%d Pinecrest Money", donate_skin_premium);
                    ShowPlayerDialog(playerid, D_DONATE_BUY_PREMIUM_SKIN, DIALOG_STYLE_MSGBOX, ""I"Premium на скин", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 12:
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    Вы желаете приобрести случайное транспортное средство?\n\n\
                    Информация:\n\n\
                    \t— {"#cLIGHTRED"}Стоимость выпадающего транспортного средства составляет не менее "W"100000${"#cLIGHTRED"} и не более "W"2500000$;\n\
                    \t— {"#cLIGHTRED"}Выпадающее транспортное средство является премиальным и имеет несколько привилегий:"W"\n\
                    \t\t— {"#cLIGHTRED"}В транспортном средстве не ломаются детали;"W"\n\
                    \t\t— {"#cLIGHTRED"}Стоимость доставки транспортного средства с помощью "W"/cars{"#cLIGHTRED"} и "W"/fixcar{"#cLIGHTRED"} ниже в два раза;"W"\n\n\
                    Стоимость: "I"%d Pinecrest Money", donate_vehicle);
                    ShowPlayerDialog(playerid, D_DONATE_BUY_VEHICLE, DIALOG_STYLE_MSGBOX, ""I"Случайное транспортное средство", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 13:
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    Вы желаете приобрести случайный скин?\n\n\
                    Информация:\n\n\
                    \t— {"#cLIGHTRED"}ID выпадающего скина не менее "W"1{"#cLIGHTRED"} и не более "W"311{"#cLIGHTRED"} за исключением ID "W"74.\n\n\
                    Стоимость: "I"%d Pinecrest Money", donate_skin);
                    ShowPlayerDialog(playerid, D_DONATE_BUY_SKIN, DIALOG_STYLE_MSGBOX, ""I"Случайный скин", STRING_GLOBAL, "Далее", "Отмена");
                }
            }
            return 1;
        }
        
        case D_DONATE_BUY:
        {
            if(!response) return ShowPlayerDonate(playerid, DONATE_TYPE_MENU);
            new i = p_temp[playerid][donate_parameter][0], price = p_temp[playerid][donate_parameter][1];
            if(i == -1) return ShowPlayerDonate(playerid, DONATE_TYPE_MENU), SendError(playerid, "Произошла ошибка, не определен ID предмета, попробуйте ещё раз.");
            if(price <= 0) return ShowPlayerDonate(playerid, DONATE_TYPE_MENU), SendError(playerid, "Произошла ошибка, не определен ID предмета, попробуйте ещё раз.");
            if(p_info[playerid][flinmoney] < price) return ShowPlayerDonate(playerid, DONATE_TYPE_MENU), SendError(playerid, "У Вас нет столько Pinecrest Money.");
            new type = DonateInfo[i][dType], idx = DonateInfo[i][dIDx], bool:message_show = false, iCount = 1;
            switch(type)
            {
                case TYPE_DONATE_REAL_CARS, TYPE_DONATE_VEHICLE, TYPE_DONATE_SKIN, TYPE_DONATE_REAL_SKIN:
                {
                    new donate_list_type[4] = {TYPE_GIVE_ITEM_U_VEHICLE, TYPE_GIVE_ITEM_U_VEHICLE, TYPE_GIVE_ITEM_SKIN, TYPE_GIVE_ITEM_SKIN};
                    SetPlayerItem(playerid, 9, p_info[playerid][ID], donate_list_type[type], idx, 100000, 0, price);
                    message_show = true;
                    Log(LOG_player, INFO, "%s[%d](%s %s) приобретение <%s>(%d) за %d FM | #Donate",
                        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", 
                        DonateInfo[i][dName], DonateInfo[i][dIDx], price);
                }
                case TYPE_DONATE_ROULETTE, TYPE_DONATE_CASE, TYPE_DONATE_CASKET, TYPE_DONATE_MAPBOX:
                {
                    if(sscanf(inputtext, "i", iCount))
                        return ShowPlayerDonate(playerid, DONATE_TYPE_MENU), SendError(playerid, "Вводить нужно число.");
                    if(p_info[playerid][flinmoney] < iCount*price)
                        return ShowPlayerDonate(playerid, DONATE_TYPE_MENU), SendError(playerid, "У Вас нет столько Pinecrest Money.");
                    if(!GivePlayerInventory(playerid, idx, iCount, .reason = "покупка из доната"))
                        return 1;
                }
                case TYPE_DONATE_ACCESSORIES, TYPE_DONATE_VEHICLE_TUNE, TYPE_DONATE_TENT, TYPE_DONATE_IPHONE: // Предметы инвентаря;
                {
                    if(!GivePlayerInventory(playerid, idx, 1, .reason = "покупка из доната"))
                        return 1;
                }
                case TYPE_DONATE_PACKAGE:
                {
                    SetPlayerMoney(playerid, idx, true, "пакет игровой валюты");
                }
                case TYPE_DONATE_SKILL:
                {
                    if(p_info[playerid][job_skill][idx] == SkillData[idx][sMax]) return ShowPlayerDonate(playerid, DONATE_TYPE_MENU), SendError(playerid, "У Вас уже есть максимальный навык на данной работе.");
                    SetPlayerItem(playerid, 4, p_info[playerid][ID], TYPE_GIVE_ITEM_ACCESSORIES, SkillData[idx][sAccessories]);
                    p_info[playerid][job_skill][idx] = SkillData[idx][sMax];
                    p_info[playerid][job_skill_count][idx] = 0;
                    SavePlayerWorkSkill(playerid);
                }
                case TYPE_DONATE_VIP:
                {
                    if(p_info[playerid][p_vip] > 0 && idx < p_info[playerid][p_vip]) return ShowPlayerDonate(playerid, DONATE_TYPE_MENU), SendError(playerid, "У Вас уже есть VIP статус уровнем выше.");
                    new temp_idx = DonateInfo[i][dSubIDx];
                    switch(idx)
                    {
                        case 1 .. 3:
                        {
                            if(temp_idx == 30 || temp_idx == 3650) SendMesAll(COLOR_LIGHTRED, "[VIP]: "W"%s [%d] приобрел(-а) {"#cLIGHTRED"}\"VIP %s\".", get_name(playerid), playerid, DonateInfo[i][dName]);
                            if(p_info[playerid][p_vip] != idx) p_info[playerid][p_vip_time] = 0;
                            p_info[playerid][p_vip] = idx;
                            if(p_info[playerid][p_vip_time]) p_info[playerid][p_vip_time] += 86400 * temp_idx;
                            else p_info[playerid][p_vip_time] = (timestamp + (86400 * temp_idx));
                        }
                        case 4:
                        {
                            if(!GivePlayerInventory(playerid, 732, 1)) return SendError(playerid, "В инвентаре нет места.");
                            SendMesAll(COLOR_LIGHTRED, "[ADD VIP]: "W"%s [%d] приобрел(-а) {"#cLIGHTRED"}\"%s\".", get_name(playerid), playerid, DonateInfo[i][dName]);
                        }
                        default:
                        {
                            if(!GivePlayerInventory(playerid, 738, 1)) return SendError(playerid, "В инвентаре нет места.");
                            SendMesAll(COLOR_LIGHTRED, "[ADD VIP]: "W"%s [%d] приобрел(-а) {"#cLIGHTRED"}\"%s\".", get_name(playerid), playerid, DonateInfo[i][dName]);
                        }
                    }
                }
                case TYPE_DONATE_COSTUME:
                {
                    if(p_info[playerid][costume][idx] == 1) return ShowPlayerDonate(playerid, DONATE_TYPE_MENU), SendError(playerid, "У Вас уже есть костюм \"%s\".", CostumeName[idx]);
                    GivePlayerCostume(playerid, idx);
                }
                case TYPE_DONATE_SERVICE:
                {
                    switch(idx)
                    {
                        case 0 .. 3:
                        {
                            if(p_info[playerid][DonateUpdate][idx] == 1) return SendError(playerid, "У Вас уже есть \"%s\".", DonateInfo[i][dName]);
                            p_info[playerid][DonateUpdate][idx] = 1;
                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%i|%i|%i|%i",
                            p_info[playerid][DonateUpdate][0], p_info[playerid][DonateUpdate][1], p_info[playerid][DonateUpdate][2], p_info[playerid][DonateUpdate][3]);
                            MysqlUpdatePlayerStr(playerid, "DonateUpdate", STRING_GLOBAL);
                        }
                        case 4:
                        {
                            new count = 0;
                            for(new i; i < 6; i++)
                            {
                                if(p_info[playerid][Disease][i] != 0) count++;
                            }
                            if(count == 0) return ShowPlayerDonate(playerid, DONATE_TYPE_MENU), SendError(playerid, "У Вас нет болезней.");
                            for(new i; i < 6; i++) p_info[playerid][Disease][i] = 0;
                        }
                        case 5:
                        {
                            if(p_info[playerid][d_addiction] <= 0) return ShowPlayerDonate(playerid, DONATE_TYPE_MENU), SendError(playerid, "У Вас нет наркозависимости.");
                            p_info[playerid][d_addiction] = 0;
                            p_info[playerid][d_demolition] = 0;
                        }
                    }
                }
                case TYPE_DONATE_KITS:
                {
                    switch(idx)
                    {
                        case 0:
                        {
                            for(new i; i != LIC_ALL; i++)
                            {
                                p_info[playerid][Lic][i] = 1;
                                p_info[playerid][Lic_Warn][i] = 0;
                                p_info[playerid][Lic_Time][i] = 8760;
                            }
                            OnPlayerUpdateLicData(playerid);
                        }
                        case 1:
                        {
                            for(new i; i != 4; i++) p_info[playerid][pstyle][i] = 1;

                            STRING_GLOBAL[0] = EOS;
                            format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%i|%i|%i|%i",
                            p_info[playerid][pstyle][0], p_info[playerid][pstyle][1], p_info[playerid][pstyle][2], p_info[playerid][pstyle][3]);
                            MysqlUpdatePlayerStr(playerid, "Style", STRING_GLOBAL);
                        }
                    }
                }
            }
            p_info[playerid][flinmoney] -= iCount*price;
            MysqlUpdatePlayerInt(playerid, "flinmoney", p_info[playerid][flinmoney]);
            if(DonateInfo[i][dType] == TYPE_DONATE_VIP && (DonateInfo[i][dIDx] == 4 || DonateInfo[i][dIDx] == 5)) SendAccess(playerid, "Вы приобрели \"%s\" за %d Pinecrest Money.", DonateInfo[i][dName], price);
            else SendAccess(playerid, "Вы приобрели %d ед. \"%s\" - %s за %d Pinecrest Money.", iCount, DonateName[type], DonateInfo[i][dName], price);
            if(message_show) SendInfo(playerid, "Чтобы получить введите: /items");
            for(new i = 0; i < 2; i++) p_temp[playerid][donate_parameter][i] = -1;
            ShowPlayerDonate(playerid, DONATE_TYPE_MENU);
            Log(LOG_player, INFO, "%s[%d](%s %s) приобрел %d ед. %s - %s за %d Pinecrest Money | #Donate",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", 
                iCount, DonateName[type], DonateInfo[i][dName], price);
            return 1;
        }
        case D_DONATE_UNWARN:
        {
            if(!response) return ShowPlayerDonate(playerid, DONATE_TYPE_OTHER);
            if(p_info[playerid][warn] <= 0) return ShowPlayerDonate(playerid, DONATE_TYPE_OTHER), SendError(playerid, "У Вас нет предупреждений.");
            if(p_info[playerid][flinmoney] < donate_warn) return ShowPlayerDonate(playerid, DONATE_TYPE_OTHER), SendError(playerid, "У Вас нет столько Pinecrest Money.");

            p_info[playerid][flinmoney] -= donate_warn;
            p_info[playerid][warn] -= 1;
            p_info[playerid][warn_time] = 0;
            SendAccess(playerid, "Вы сняли предупреждение с аккаунта.");

            ShowPlayerDonate(playerid, DONATE_TYPE_OTHER);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `flinmoney` = %d, `warn` = %d, `warn_time` = %d WHERE `id` = %d",
            p_info[playerid][flinmoney], p_info[playerid][warn], p_info[playerid][warn_time], p_info[playerid][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            Log(LOG_player, INFO, "%s[%d](%s %s) приобретение снятия предупреждения за %d FM | #Donate",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", donate_warn);
            return 1;
        }
        case D_SLOTS_DONATE:
        {
            if(!response) return ShowPlayerDonate(playerid, DONATE_TYPE_OTHER);
            switch(listitem)
            {
                case 0: ShowPlayerDialog(playerid, D_BUY_VEH_SLOTS_LIST, DIALOG_STYLE_LIST, ""I"Слоты для транспортных средств", ""I"[1]"W" Велик\n"I"[2]"W" Мото\n"I"[3]"W" Автомобиль\n"I"[4]"W" Водный\n"I"[5]"W" Воздушный", "Далее", "Отмена");
                case 1:
                {
                    if(p_info[playerid][bizz_slots] >= MAX_BIZZ_PLAYER)
                    {
                        SendError(playerid, "Достигнуто максимального значения - %d бизнесов.", MAX_BIZZ_PLAYER);
                        return ShowPlayerDonate(playerid, DONATE_TYPE_OTHER);
                    }
                    new price, count_bizz = p_info[playerid][bizz_slots];
                    if(count_bizz <= 0) count_bizz = 1;
                    price = 1500 * count_bizz;
                    p_temp[playerid][p_listitem_int] = price;
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    Вы желаете приобрести дополнительный слот для {"#cGREEN"}\"Бизнес\"?"W"\n\n\
                    Стоимость: "I"%d Pinecrest Money"W"\n\n\
                    Доп. слотов на данный момент: {"#cLIGHTRED"}%d"W"\n\
                    Стоимость след. доп. слота: {"#cLIGHTRED"}%d"W" Pinecrest Money", price, count_bizz-1, price+1500);
                    ShowPlayerDialog(playerid, D_BUY_BIZZ_SLOTS, DIALOG_STYLE_MSGBOX, ""I"Слоты для бизнесов", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 2:
                {
                    if(p_info[playerid][house_slots] >= MAX_HOUSE_PLAYER)
                    {
                        SendError(playerid, "Достигнуто максимального значения - %d дома.", MAX_HOUSE_PLAYER);
                        return ShowPlayerDonate(playerid, DONATE_TYPE_OTHER);
                    }
                    new price, count_house = p_info[playerid][house_slots];
                    if(count_house <= 0) count_house = 1;
                    price = 1500 * count_house;
                    p_temp[playerid][p_listitem_int] = price;
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    Вы желаете приобрести дополнительный слот для {"#cGREEN"}\"Дома\"?"W"\n\n\
                    Стоимость: "I"%d Pinecrest Money"W"\n\n\
                    Доп. слотов на данный момент: {"#cLIGHTRED"}%d"W"\n\
                    Стоимость след. доп. слота: {"#cLIGHTRED"}%d"W" Pinecrest Money", price, count_house-1, price+1500);
                    ShowPlayerDialog(playerid, D_BUY_HOUSE_SLOTS, DIALOG_STYLE_MSGBOX, ""I"Слоты для домов", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 3:
                {
                    if(p_info[playerid][inv_slots] >= MAX_PLAYER_EQUIPMENT)
                    {
                        SendError(playerid, "Достигнуто максимального значения - %d слотов.", MAX_PLAYER_EQUIPMENT);
                        return ShowPlayerDonate(playerid, DONATE_TYPE_OTHER);
                    }
                    new price, count_slots = p_info[playerid][inv_slots];
                    if(count_slots <= 59) count_slots = 60;
                    price = 5*count_slots;
                    p_temp[playerid][p_listitem_int] = price;
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""W"\
                    Вы желаете приобрести дополнительных 10 слотов для {"#cGREEN"}\"Инвентаря\"?"W"\n\n\
                    Стоимость: "I"%d Pinecrest Money"W"\n\n\
                    Доп. слотов на данный момент: {"#cRED"}%d"W"\n\
                    Стоимость след. доп. слота: {"#cRED"}%d"W" Pinecrest Money", price, count_slots-60, price);
                    ShowPlayerDialog(playerid, D_BUY_INV_SLOTS, DIALOG_STYLE_MSGBOX, ""I"Слоты для инвентаря", STRING_GLOBAL, "Далее", "Отмена");
                }
            }
            return 1;
        }
        case D_BUY_INV_SLOTS:
        {
            if(!response) return ShowPlayerDialog(playerid, D_SLOTS_DONATE, DIALOG_STYLE_LIST, ""I"Слоты", ""I"[1]"W" Слоты для транспортных средств\n"I"[2]"W" Слоты для бизнесов\n"I"[3]"W" Слоты для домов\n"I"[4]"W" Слоты для инвентаря", "Далее", "Отмена");
            new price = p_temp[playerid][p_listitem_int];
            if(price <= 0) return 1;
            if(p_info[playerid][flinmoney] < price)
            {
                SendError(playerid, "У Вас нет столько Pinecrest Money.");
                return ShowPlayerDonate(playerid, DONATE_TYPE_OTHER);
            }
            if(p_info[playerid][inv_slots] >= MAX_PLAYER_EQUIPMENT)
            {
                SendError(playerid, "Достигнуто максимального значения - %d слотов.", MAX_PLAYER_EQUIPMENT);
                return ShowPlayerDonate(playerid, DONATE_TYPE_OTHER);
            }
            p_info[playerid][flinmoney] -= price;
            p_info[playerid][inv_slots] += 10;

            ShowPlayerDonate(playerid, DONATE_TYPE_OTHER);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `flinmoney` = %d, `inv_slots` = %d WHERE `id` = %d",
                p_info[playerid][flinmoney], p_info[playerid][inv_slots], p_info[playerid][ID]);
            mysql_tquery(con_bd, STRING_GLOBAL);

            SendAccess(playerid, "Вы приобрели дополнительные 10 слотов для инвентаря.");

            Log(LOG_player, INFO, "%s[%d](%s %s) приобретение доп. 10 слотов для инвентаря за %d FM | #Donate",
                get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", price);
            return 1;
        }
        case D_BUY_HOUSE_SLOTS:
        {
            if(!response) return ShowPlayerDialog(playerid, D_SLOTS_DONATE, DIALOG_STYLE_LIST, ""I"Слоты", ""I"[1]"W" Слоты для транспортных средств\n"I"[2]"W" Слоты для бизнесов\n"I"[3]"W" Слоты для домов\n"I"[4]"W" Слоты для инвентаря", "Далее", "Отмена");
            new price = p_temp[playerid][p_listitem_int];
            if(price == -1) return 1;
            if(p_info[playerid][flinmoney] < price)
            {
                SendError(playerid, "У Вас нет столько Pinecrest Money.");
                return ShowPlayerDonate(playerid, DONATE_TYPE_OTHER);
            }
            if(p_info[playerid][house_slots] >= MAX_HOUSE_PLAYER)
            {
                SendError(playerid, "Достигнуто максимального значения - %d дома.", MAX_HOUSE_PLAYER);
                return ShowPlayerDonate(playerid, DONATE_TYPE_OTHER);
            }
            p_info[playerid][flinmoney] -= price;
            p_info[playerid][house_slots] += 1;

            ShowPlayerDonate(playerid, DONATE_TYPE_OTHER);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `flinmoney` = %d, `house_slots` = %d WHERE `id` = %d",
            p_info[playerid][flinmoney], p_info[playerid][house_slots], p_info[playerid][ID]);
