            new bankid = RobberyBankContract[idx][rbcBankIDx];
            SendAccess(playerid, "Вы приобрели контракт за %d$ на ограбления банка %s.", price, BankInfo[bankid][bName]);
            SendInfo(playerid, "Подробнее: /robbing");
            SendInfo(playerid, "Помощь по ограблениям: /mn > [4] Помощь по игре > [17] Ограбление банка");
            p_temp[playerid][rob_bank_idx] = idx;
            p_temp[playerid][rob_bank_rank] = 0;
            ShowRobberyBank(playerid, ROBBERY_BANK_MENU);
            if(GetPlayerAttachedCostume(playerid) != -1)
            {
                SendInfo(playerid, "С Вас снят костюм, он будет надет после завершения ограбления.");
                TakePlayerAttachedCostume(playerid, GetPlayerAttachedCostume(playerid), false);
            }
            else RemovePlayerAccessories(playerid, false);
            return 1;
        }
        case D_ROB_BANK_CONTRACT_INFO:
        {
            if(IsPlayerInRangeOfPoint(playerid, 2.5, 1413.4436,-1487.6085,20.4344)) return ShowRobberyBank(playerid, ROBBERY_BANK_NPC_1);
            else return ShowRobberyBank(playerid, ROBBERY_BANK_MENU);
        }
        case D_ROB_BANK_MENU:
        {
            if(!response) return 1;
            new idx = p_temp[playerid][rob_bank_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении банка.");
            switch(listitem)
            {
                case 0: ShowRobberyBank(playerid, ROBBERY_BANK_CONTRACT_INFO, idx);
                case 1: ShowRobberyBank(playerid, ROBBERY_BANK_PLAYER, idx);
                case 2: ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx);
                case 3:
                {
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    SetPlayerGPS(playerid, 1721.0063,-1636.1530,20.2115, 5.0);
                    SendInfo(playerid, "Вилли отмечен на GPS навигаторе. Расстояние: %.0f метров.", GetPlayerDistanceFromPoint(playerid, 1721.0063,-1636.1530,20.2115));
                }
                case 4:
                {
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    SetPlayerGPS(playerid, 926.2943,-1298.4442,13.5469, 5.0);
                    SendInfo(playerid, "Роберт отмечен на GPS навигаторе. Расстояние: %.0f метров.", GetPlayerDistanceFromPoint(playerid, 926.2943,-1298.4442,13.5469));
                }
                case 5:
                {
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    SetPlayerGPS(playerid, 1632.7802,-1521.7112,13.6076, 5.0);
                    SendInfo(playerid, "Вилли отмечен на GPS навигаторе. Расстояние: %.0f метров.", GetPlayerDistanceFromPoint(playerid, 1632.7802,-1521.7112,13.6076));
                }
                case 6:
                {
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    SetPlayerGPS(playerid, 1359.2579,-1720.1215,8.5869, 5.0);
                    SendInfo(playerid, "Джон отмечен на GPS навигаторе. Расстояние: %.0f метров.", GetPlayerDistanceFromPoint(playerid, 1359.2579,-1720.1215,8.5869));
                }
                case 7:
                {
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    SetPlayerGPS(playerid, 1132.4374,-1345.9816,13.9844, 5.0);
                    SendInfo(playerid, "Доминик отмечен на GPS навигаторе. Расстояние: %.0f метров.", GetPlayerDistanceFromPoint(playerid, 1132.4374,-1345.9816,13.9844));
                }
                case 8:
                {
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    SetPlayerGPS(playerid, 382.1675,-2013.8407,7.8359, 5.0);
                    SendInfo(playerid, "Джек отмечен на GPS навигаторе. Расстояние: %.0f метров.", GetPlayerDistanceFromPoint(playerid, 382.1675,-2013.8407,7.8359));
                }
                case 9:
                {
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    new bankid = RobberyBankContract[idx][rbcBankIDx];
                    SetPlayerGPS(playerid, BankInfo[bankid][bEnter][0], BankInfo[bankid][bEnter][1], BankInfo[bankid][bEnter][2], 5.0);
                    SendInfo(playerid, "Банк отмечен на GPS навигаторе. Расстояние: %.0f метров.", GetPlayerDistanceFromPoint(playerid, BankInfo[bankid][bEnter][0], BankInfo[bankid][bEnter][1], BankInfo[bankid][bEnter][2]));
                }
                case 10:
                {
                    new vehicleid = RobberyBankContract[idx][rbcVehicleIDx];
                    if(vehicleid == INVALID_VEHICLE_ID) return SendError(playerid, "В контракте нет транспортного средства, продайте вещи из сумки Джеку."), ShowRobberyBank(playerid, ROBBERY_BANK_MENU);

                    new Float:x, Float:y, Float:z, Float:r;

                    GetVehicleZAngle(vehicleid, r);
                    GetVehiclePos(vehicleid, x, y, z);
                    y = y - (2.5 * floatcos(r, degrees));
                    x = x - (-2.5 * floatsin(r, degrees));

                    if(!IsPlayerInRangeOfPoint(playerid, 5.0, x, y, z)) return SendError(playerid, "Вы далеко от багажника."), ShowRobberyBank(playerid, ROBBERY_BANK_MENU);

                    new items_idx, count_list[2] = {MAX_ROBBERY_BANK_MONEY, MAX_ROBBERY_BANK_GOLD}, max_count, count;
                    if(p_temp[playerid][rob_bank_backup_items][0] == 0 && p_temp[playerid][rob_bank_backup_items][1] == 0)
                    {
                        for(new i = 0; i < MAX_ROBBERY_BANK_VEHICLE_ITEMS; i++)
                        {
                            items_idx = RobberyBankContract[idx][rbcVehicleItems][i];
                            max_count = count_list[i];
                            if(items_idx != 0)
                            {
                                if(items_idx > max_count) items_idx = max_count;
                                RobberyBankContract[idx][rbcVehicleItems][i] -= items_idx;
                                p_temp[playerid][rob_bank_backup_items][i] += items_idx;
                                STRING_GLOBAL[0] = EOS;
                                f(STRING_GLOBAL, "[ROBBERY] %s [%d] взял(-а) %d%s из транспортного средства.", get_name(playerid), playerid, items_idx, i == 0 ? "$" : " кг. золота");
                                SendRobberyBankMessage(idx, 0xDEB887FF, STRING_GLOBAL);
                                SendAccess(playerid, "Вы взяли %d%s из транспортного средства.", items_idx, i == 0 ? "$" : " кг. золота");
                                count++;
                            }
                        }
                        if(count == 0) SendError(playerid, "В транспортном средстве ничего нет."), ShowRobberyBank(playerid, ROBBERY_BANK_MENU);
                    }
                    else
                    {
                        for(new i = 0; i < MAX_ROBBERY_BANK_VEHICLE_ITEMS; i++)
                        {
                            items_idx = p_temp[playerid][rob_bank_backup_items][i];
                            max_count = count_list[i];
                            if(items_idx != 0)
                            {
                                if(items_idx > max_count) items_idx = max_count;
                                RobberyBankContract[idx][rbcVehicleItems][i] += items_idx;
                                p_temp[playerid][rob_bank_backup_items][i] = 0;
                                if(p_temp[playerid][rob_bank_timer] == 2) p_temp[playerid][rob_bank_timer] = 1;
                                STRING_GLOBAL[0] = EOS;
                                f(STRING_GLOBAL, "[ROBBERY] %s [%d] положил(-а) %d%s в транспортного средства.", get_name(playerid), playerid, items_idx, i == 0 ? "$" : " кг. золота");
                                SendAccess(playerid, "Вы положили %d%s в транспортного средства.", items_idx, i == 0 ? "$" : " кг. золота");
                                count++;
                            }
                        }
                        if(count == 0) SendError(playerid, "В сумке ничего нет."), ShowRobberyBank(playerid, ROBBERY_BANK_MENU);
                    }
                }
                case 11:
                {
                    if(RobberyBankContract[idx][rbcStatus] == 3) return SendError(playerid, "Ограбление банка уже началось."), ShowRobberyBank(playerid, ROBBERY_BANK_MENU);

                    for(new i = 0; i < MAX_ROBBERY_BANK_ITEMS_START; i++)
                    {
                        if(RobberyBankContract[idx][rbcItemsStart][i] == 0 && RobberyBankItemsStart[i][rbiStatus] == true) return SendError(playerid, "Для начала ограбления необходимо приобрести предмет \"%s\".", RobberyBankItemsStart[i][rbiName]), ShowRobberyBank(playerid, ROBBERY_BANK_MENU);
                    }
                    if(RobberyBankContract[idx][rbcVehicleIDx] == INVALID_VEHICLE_ID) return SendError(playerid, "Для начала ограбления необходимо арендовать транспортное средство."), ShowRobberyBank(playerid, ROBBERY_BANK_MENU);
                    ShowRobberyBank(playerid, ROBBERY_BANK_START, idx);
                }
                case 12: ShowRobberyBank(playerid, ROBBERY_BANK_ITEMS_LIST, idx);
                case 13:
                {
                    if(RobberyBankContract[idx][rbcTimeUpdate]) return SendError(playerid, "Продлевать контракт можно 1 раз."), ShowRobberyBank(playerid, ROBBERY_BANK_MENU);
                    ShowRobberyBank(playerid, ROBBERY_BANK_EXTEND_CONTRACT, idx);
                }
                case 14:
                {
                    if(p_temp[playerid][rob_bank_backup_pickup] == -1 || p_temp[playerid][rob_bank_backup_area] == -1) return SendError(playerid, "Вы не теряли сумку или ее кто-то уже забрал."), ShowRobberyBank(playerid, ROBBERY_BANK_MENU);
                    new Float:distance = GetPlayerDistanceFromPoint(playerid, p_temp[playerid][rob_bank_backup_pos][0], p_temp[playerid][rob_bank_backup_pos][1], p_temp[playerid][rob_bank_backup_pos][2]);
                    if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                    SetPlayerGPS(playerid, p_temp[playerid][rob_bank_backup_pos][0], p_temp[playerid][rob_bank_backup_pos][1], p_temp[playerid][rob_bank_backup_pos][2], 5.0);
                    SendInfo(playerid, "\"Сумка\" отмечена на GPS навигаторе. Расстояние: %.0f метров.", distance);
                }
                case 15:
                {
                    if(RobberyBankContract[idx][rbcOwnerID] == p_info[playerid][ID]) return SendError(playerid, "Владелец контракта не может покинуть ограбление банка, откажитесь от контракта."), ShowRobberyBank(playerid, ROBBERY_BANK_MENU);
                    ShowRobberyBank(playerid, ROBBERY_BANK_LEAVE);
                }
                case 16:
                {
                    if(RobberyBankContract[idx][rbcOwnerID] != p_info[playerid][ID]) return SendError(playerid, "Вы не являетесь владелецем контракта."), ShowRobberyBank(playerid, ROBBERY_BANK_MENU);
                    ShowRobberyBank(playerid, ROBBERY_BANK_DELETE, idx);
                }
            }
            return 1;
        }
        case D_ROB_BANK_PLAYER:
        {
            if(!response) return ShowRobberyBank(playerid, ROBBERY_BANK_MENU);
            new scdplayerid, rank, idx = p_temp[playerid][rob_bank_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении банка.");
            if(RobberyBankContract[idx][rbcStatus] == 3) return ShowRobberyBank(playerid, ROBBERY_BANK_PLAYER, idx), SendError(playerid, "Вы не можете пригласить подельника, ограбление банка уже началось.");
            if(sscanf(inputtext, "p<,>ii", scdplayerid, rank)) return ShowRobberyBank(playerid, ROBBERY_BANK_PLAYER, idx), SendError(playerid, "Вводить нужно только цифру пункта.");
            if(scdplayerid == INVALID_PLAYER_ID) return ShowRobberyBank(playerid, ROBBERY_BANK_PLAYER, idx), SendError(playerid, "Игрок не найден.");
            if(!IsPlayerStream(5.0, playerid, scdplayerid) || pSpectateId[scdplayerid] != INVALID_PLAYER_ID) return ShowRobberyBank(playerid, ROBBERY_BANK_PLAYER, idx), SendError(playerid, "Игрок слишком далеко от Вас.");
            if(rank < 2 || rank > 5) return ShowRobberyBank(playerid, ROBBERY_BANK_PLAYER, idx), SendError(playerid, "Должность должна быть не менее 2 и не более 5.");
            if(RobberyBankContract[idx][rbcPlayerID][rank-1] != INVALID_PLAYER_ID) return ShowRobberyBank(playerid, ROBBERY_BANK_PLAYER, idx), SendError(playerid, "На данной должности уже есть подельник.");
            if(gos(scdplayerid)) return SendError(playerid, "Данный игрок не состоит в семье или нелегальной организации.");
            if((!mafia(scdplayerid) && !gang(scdplayerid) && !biker(scdplayerid)) && p_info[scdplayerid][fwork] == true) return SendError(playerid, "Данынй игрок не закончил рабочий день.");
            if(p_temp[scdplayerid][rob_house_idx] != -1 || p_temp[scdplayerid][rob_bank_idx] != -1 || p_temp[scdplayerid][rob_fuel_idx] != -1) return ShowRobberyHouse(playerid, ROBBERY_HOUSE_PLAYER, idx), SendError(playerid, "Данный игрок уже состоит в какой-то команде в ограблении дома, банка или АЗС.");
            if(p_info[scdplayerid][level] < 20) return SendError(playerid, "Участвовать в ограблениях можно с 20-ого уровня.");
            SendAccess(playerid, "Вы предложили %s [%d] участвовать в ограблении банка на должности \"%s\".", get_name(scdplayerid), scdplayerid, RobberyBankPlayer[rank - 1][rbpName]);
            SendInfo(scdplayerid, "%s [%d] предложил Вам участвовать в ограблении банка на должности \"%s\".", get_name(playerid), playerid, RobberyBankPlayer[rank - 1][rbpName]);
            SetFreeSlotOffer(scdplayerid, playerid, OFFER_ID_INVITE_ROB_BANK, 0, rank - 1);
            return 1;
        }
        case D_ROB_BANK_USE:
        {
            if(!response) return ShowRobberyBank(playerid, ROBBERY_BANK_MENU);
            new idx = p_temp[playerid][rob_bank_idx];
            if(idx == -1) return SendError(playerid, "Вы не участвуете в ограблении банка.");
            new bankid = RobberyBankContract[idx][rbcBankIDx], scdplayerid;
            if(RobberyBankContract[idx][rbcStatus] != 3) return ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx), SendError(playerid, "Вы не можете использовать предметы, ограбление банка еще не началось.");
            if(RobberyBankContract[idx][rbcItemsStart][listitem] == 0) return ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx), SendError(playerid, "В списке предметов для ограбления банка нет \"%s\".", RobberyBankItemsStart[listitem][rbiName]);
            switch(listitem)
            {
                case 0:
                {
                    if(RobberyBankContract[idx][rbcPlayerID][1] != INVALID_PLAYER_ID && p_temp[playerid][rob_bank_rank] != 1) return ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx), SendError(playerid, "Использовать бронежилеты может только \"%s\".", RobberyBankPlayer[1][rbpName]);
                    RobberyBankContract[idx][rbcItemsStart][0] = 0;
                    for(new i = 0; i < MAX_ROBBERY_BANK_PLAYER; i++)
                    {
                        scdplayerid = RobberyBankContract[idx][rbcPlayerID][i];
                        if(scdplayerid != INVALID_PLAYER_ID)
                        {
                            SetPlayerArmour(scdplayerid, 100);
                        }
                    }
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "[ROBBERY] %s [%d] использовал(-а) бронежилеты для всей команды.", get_name(playerid), playerid);
                    SendRobberyBankMessage(idx, 0xDEB887FF, STRING_GLOBAL);
                }
                case 1:
                {
                    if(RobberyBankContract[idx][rbcPlayerID][1] != INVALID_PLAYER_ID && p_temp[playerid][rob_bank_rank] != 1) return ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx), SendError(playerid, "Использовать оружие может только \"%s\".", RobberyBankPlayer[1][rbpName]);
                    RobberyBankContract[idx][rbcItemsStart][1] = 0;
                    for(new i = 0; i < MAX_ROBBERY_BANK_PLAYER; i++)
                    {
                        scdplayerid = RobberyBankContract[idx][rbcPlayerID][i];
                        if(scdplayerid != INVALID_PLAYER_ID)
                        {
                            f_GivePlayerWeapon(scdplayerid, 24, 50);
                            f_GivePlayerWeapon(scdplayerid, 31, 150);
                        }
                    }
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "[ROBBERY] %s [%d] использовал(-а) оружие для всей команды.", get_name(playerid), playerid);
                    SendRobberyBankMessage(idx, 0xDEB887FF, STRING_GLOBAL);
                }
                case 2:
                {
                    if(RobberyBankContract[idx][rbcPlayerID][1] != INVALID_PLAYER_ID && p_temp[playerid][rob_bank_rank] != 1) return ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx), SendError(playerid, "Использовать взрывчатку может только \"%s\".", RobberyBankPlayer[1][rbpName]);
                    if(!IsPlayerInRangeOfPoint(playerid, 2.5, 2273.6716,-62.5555,1070.2646) || GetPlayerVirtualWorld(playerid) != bankid) return ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx), SendError(playerid, "Вы слишком далеко от места установки взрывчатки или находитесь не в том банке.");

                    if(RobberyBankContract[idx][rbcAnticall][ROB_BANK_ANTICALL_GAS] == 1 && RobberyBankContract[idx][rbcAnticall][ROB_BANK_ANTICALL_WT] == 1) {}
                    else CallingPoliceToRobberyBank(idx, RobberyBankContract[idx][rbcBankIDx]);

                    RobberyBankContract[idx][rbcItemsStart][2] = 0;
                    StartRobbingMiniGame(playerid, ROBBING_TYPE_BANK, ROB_BANK_ITEMS_EXPLODE, 180);
                }
                case 3:
                {
                    if(RobberyBankContract[idx][rbcPlayerID][1] != INVALID_PLAYER_ID && p_temp[playerid][rob_bank_rank] != 1) return ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx), SendError(playerid, "Использовать газ может только \"%s\".", RobberyBankPlayer[1][rbpName]);
                    if(!IsPlayerInRangeOfPoint(playerid, 2.5, 2291.6636,-50.4572,1070.2646) || GetPlayerVirtualWorld(playerid) != bankid) return ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx), SendError(playerid, "Вы слишком далеко от места выброса газа или находитесь не в том банке.");
                    if(RobberyBankContract[idx][rbcAnticall][ROB_BANK_ANTICALL_GAS] == 1) return ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx), SendError(playerid, "В банке уже разбросан газ.");

                    RobberyBankContract[idx][rbcItemsStart][3] = 0;
                    StartRobbingMiniGame(playerid, ROBBING_TYPE_BANK, ROB_BANK_ITEMS_GAS, 60);
                }
                case 4:
                {
                    if(RobberyBankContract[idx][rbcPlayerID][2] != INVALID_PLAYER_ID && p_temp[playerid][rob_bank_rank] != 2) return ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx), SendError(playerid, "Использовать перебитые номера может только \"%s\".", RobberyBankPlayer[2][rbpName]);
                    new vehicleid = RobberyBankContract[idx][rbcVehicleIDx];
                    if(vehicleid == INVALID_VEHICLE_ID) return ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx), SendError(playerid, "Транспортное средство для ограбления банка не арендовано.");
                    new Float:x, Float:y, Float:z, Float:r;
                    GetVehicleZAngle(vehicleid, r);
                    GetVehiclePos(vehicleid, x, y, z);
                    y = y - (2.5 * floatcos(r, degrees));
                    x = x - (-2.5 * floatsin(r, degrees));
                    if(!IsPlayerInRangeOfPoint(playerid, 5.0, x, y, z)) return ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx), SendError(playerid, "Вы далеко от багажника.");
                    if(RobberyBankContract[idx][rbcVehicleNumber] == 1) return ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx), SendError(playerid, "На машине уже установлены перебитые номера.");
                    RobberyBankContract[idx][rbcItemsStart][4] = 0;
                    StartRobbingMiniGame(playerid, ROBBING_TYPE_BANK, ROB_BANK_ITEMS_NUMBER, 60);
                }
                case 5:
                {
                    if(RobberyBankContract[idx][rbcPlayerID][3] != INVALID_PLAYER_ID && p_temp[playerid][rob_bank_rank] != 3) return ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx), SendError(playerid, "Использовать маски может только \"%s\".", RobberyBankPlayer[3][rbpName]);
                    if(RobberyBankContract[idx][rbcItemsStart][8] != 0) return ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx), SendError(playerid, "Для начала необходимо использовать \"%s\".", RobberyBankItemsStart[8][rbiName]);
                    RobberyBankContract[idx][rbcItemsStart][5] = 0;
                    new idx_skin;
                    for(new i = 0; i < MAX_ROBBERY_BANK_PLAYER; i++)
                    {
                        scdplayerid = RobberyBankContract[idx][rbcPlayerID][i];
                        if(scdplayerid != INVALID_PLAYER_ID)
                        {
                            idx_skin = GetPlayerSkin(scdplayerid);
                
                            STRING_GLOBAL[0] = EOS;
                            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `accessories_coords` WHERE `type` = 31 AND `skin_id` = %d LIMIT 1", idx_skin);
                            mysql_pquery(con_bd, STRING_GLOBAL, "AccessoriesCoords", "ddd", scdplayerid, p_info[scdplayerid][ID], 2);
                            //SetPlayerAttachedObject(scdplayerid, 0, 19801, 2, fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ);

                            SetPlayerChatBubble(scdplayerid, "Надел(-а) маску", COLOR_MAIN, 20.0, 10000);
                            if(!IsPlayerInAnyVehicle(scdplayerid)) ApplyAnimation(scdplayerid, "SHOP", "ROB_Shifty", 4.0, 0, 0, 0, 0, 0, 1);
                            SetPlayerColor(scdplayerid, 0x4F4F4F00);
                            p_temp[scdplayerid][UseMaskFix] = 1;
                            p_temp[scdplayerid][UseMaskTimerFix] = timestamp + 3600;
                            SendAccess(scdplayerid, "Вы надели маску.");
                            SendInfo(scdplayerid, "Ваше местоположение на GPS навигаторе скрыто на 60 мин.");

                            if(p_info[playerid][p_settings][ROLEPLAY] == 1)
                            {
                                DoAction(scdplayerid, "Маска лежит в кармане.");
                                MeAction(scdplayerid, "засунул правую руку в карман, после чего нащупав маску достал ее и одел на голову");
                            }
                        }
                    }
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, "[ROBBERY] %s [%d] использовал(-а) маски для всей команды.", get_name(playerid), playerid);
                    SendRobberyBankMessage(idx, 0xDEB887FF, STRING_GLOBAL);
                }
                case 6:
                {
                    if(RobberyBankContract[idx][rbcPlayerID][3] != INVALID_PLAYER_ID && p_temp[playerid][rob_bank_rank] != 3) return ShowRobberyBank(playerid, ROBBERY_BANK_USE, idx), SendError(playerid, "Использовать маски может только \"%s\".", RobberyBankPlayer[3][rbpName]);
