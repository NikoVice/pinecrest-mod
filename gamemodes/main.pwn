        case D_MARKET_BUY_ITEM_ADD: // ��������� - ������� � �������: ����������
        {
            if(p_temp[playerid][market_arend] == -1) return SendError(playerid, "�� �� ��������� ����������� ����� ���� �������.");
            if(!response) return ShowPlayerControlMarket(playerid);
            new count = 1, price, item_id = GetPVarInt(playerid, #SELECT_SLOT_ID),
                iColor1, iColor2, iWear, premium;
            if(ItemsInfo[item_id][iType] == TYPE_ITEMS_INVENTORY)
            {
                if(!IsTextNums(inputtext, 0, 1))
                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
