                return Kick(playerid);
            }
            if(!(5 <= strlen(inputtext) <= 36))
            {
                ShowPlayerDialog(playerid, D_EMAIL_REG, DIALOG_STYLE_INPUT, ""I"Электронная почта", ""W"\
                Чтобы предотвратить потерю Вашего аккаунта, мы хотим\n\
                защитить его с помощью привязки к электронной почте.\n\
                Это поможет не допустить попытку взлома или утери данных\n\
                аккаунта.\n\n\
                "I"Вводите настоящую, ее надо будет подтвердить, подходит только Google/Yandex.", "Далее", "Отмена");
                return 1;
            }
            if(strfind(inputtext, "@", true) == -1 || strfind(inputtext, ".", true) == -1)
            //if(strfind(inputtext, "@gmail.com", true) == -1 && strfind(inputtext, "@yandex.ru", true) == -1)
            {
                SendError(playerid, "Только Google или Yandex.");
                ShowPlayerDialog(playerid, D_EMAIL_REG, DIALOG_STYLE_INPUT, ""I"Электронная почта", ""W"\
                Чтобы предотвратить потерю Вашего аккаунта, мы хотим\n\
                защитить его с помощью привязки к электронной почте.\n\
                Это поможет не допустить попытку взлома или утери данных\n\
                аккаунта.\n\n\
                "I"Вводите настоящую, ее надо будет подтвердить, подходит только Google/Yandex.", "Далее", "Отмена");
                return 1;
            }
            p_info[playerid][mail][0] = EOS;
            strcat(p_info[playerid][mail], inputtext);

            STRING_GLOBAL[0] = EOS;
            mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id` FROM `accounts` WHERE `mail` = '%e' LIMIT 1", inputtext);
            mysql_tquery(con_bd, STRING_GLOBAL, "mail_player", "d", playerid);
            return 1;
        }
        case 1000:
        {
            if(!response) return 1;
            else callcmd::menu(playerid, "/0");
        }
        case D_MENU:
        {
            if(!response) return 1;
            switch (listitem)
            {
                case 0: player_stats(playerid, playerid);
                case 1: callcmd::inventory(playerid, "/0");
                case 2: ShowPlayerSettings(playerid);
                case 3: ShowPlayerDialog(playerid, D_HELP, DIALOG_STYLE_LIST, ""I"Помощь по игре", ""I"[1]"W" Что же такое SA-MP Mobile?\n"I"[2]"W" Что такое Pinecrest Mobile и в чем его плюсы?\n"I"[3]"W" F.A.Q\n"I"[4]"W" Что такое RolePlay и в чем его суть?\n"I"[5]"W" Термины и понятия\n"I"[6]"W" Почему важно использовать ресурсы Pinecrest Mobile?\n"I"[7]"W" Как правильно начать игру и играть дальше?\n"I"[8]"W" Как получить помощь в игре?\n"I"[9]"W" Различия фракций и общественных работ\n"I"[10]"W" Кто такие лидеры и админы?\n"I"[11]"W" Развлечения на сервере\n"I"[12]"W" Первоначальные работы\n"I"[13]"W" Основные работы\n"I"[14]"W" Рыбалка\n"I"[15]"W" Охота\n"I"[16]"W" Ограбление дома\n"I"[17]"W" Ограбление банка\n"I"[18]"W" Ограбление АЗС\n"I"[19]"W" Майнинг ферма\n"I"[20]"W" Биржа труда\n"I"[21]"W" Battle Pass\n"I"[22]"W" Подпольное помещение\n"I"[23]"W" Ежедневные награды\n"I"[24]"W" Ларцы\n"I"[25]"W" Автосалоны\n"I"[26]"W" Аренда транспорта\n"I"[27]"W" Авторынок\n"I"[28]"W" Аукцион контейнеров", "Далее", "Отмена");
                case 4: ShowPlayerDialog(playerid, D_COMMAND, DIALOG_STYLE_LIST, ""I"Команды сервера", ""I"[1]"W" Общие команды\n"I"[2]"W" Команды фракции\n"I"[3]"W" Команды транспорта\n"I"[4]"W" Команды дома\n"I"[5]"W" Команды бизнеса\n"I"[6]"W" Команды службы такси и транспортной компании\n"I"[7]"W" Команды по работе\n"I"[8]"W" Команды лидерам и заместителям\n"I"[9]"W" Команды семьи\n"I"[10]"W" Команды рыбалки", "Далее", "Отмена");
                case 5: ShowPlayerDialog(playerid, 9, DIALOG_STYLE_INPUT, ""I"Жалоба администрации", ""W"Введите свое обращение к администрации:", "Далее", "Отмена");
                case 6: callcmd::myskill(playerid, "/0");
                case 7:
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""I"[1]"W" Решительность: %s\n"I"[2]"W" Фортуна: %s\n"I"[3]"W" Планшет: %s\n"I"[4]"W" Информация", p_info[playerid][Update][0] ? ("{33CC66}Имеется"W"") : ("{"#cLIGHTRED"}100000$"W""), p_info[playerid][Update][2] ? ("{33CC66}Имеется"W"") : ("{"#cLIGHTRED"}250000$"W""), p_info[playerid][Update][3] ? ("{33CC66}Имеется"W"") : ("{"#cLIGHTRED"}250000$"W""));
                    ShowPlayerDialog(playerid, D_UPDATE_PLAYER, DIALOG_STYLE_LIST, ""I"Улучшения", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 8: ShowPlayerDialog(playerid, D_DONATION, DIALOG_STYLE_LIST, ""I"Пожертвования", ""I"[1]"W" Пожертвовать\n"I"[2]"W" Самые щедрые", "Далее", "Отмена");
                case 9:
                {
                    if(timestamp_minute >= 0 && timestamp_minute <= 5) return SendError(playerid, "Активировать бонус-код нельзя в первые 5 мин. часа.");
                    ShowPlayerDialog(playerid, D_BONUS_ACTIVE,DIALOG_STYLE_INPUT, ""I"Активация бонус-кода", ""W"Введите бонус-код:", "Далее","Отмена");
                }
                case 10: callcmd::promocode(playerid, "/0");
                case 11: callcmd::mission(playerid, "/0");
                case 12: callcmd::bp(playerid, "/0");
                case 13: callcmd::donate(playerid, "/0");
                case 14:
                {
                    STRING_GLOBAL[0] = EOS;
                    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
                    "I"[1]"W" Bronze рулетка (%d Pinecrest Money)\n\
                    "I"[2]"W" Silver рулетка (%d Pinecrest Money)\n\
                    "I"[3]"W" Gold рулетка (%d Pinecrest Money)", RoulettePrice[0], RoulettePrice[1], RoulettePrice[2]);
                    ShowPlayerDialog(playerid, D_ROULETTE, DIALOG_STYLE_LIST, ""I"Рулетка", STRING_GLOBAL, "Далее", "Отмена");
                }
                case 15: ShowPlayerCaseList(playerid);
                case 16:
                {
                    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, ""I"Горячие клавиши", "\
                    Клавиша\tОписание\tТип\n\
                    CTRL\tЗавести или заглушить двигатель\tТранспортное средство\n\
                    \t\t\n\
                    ALT\tЗанять место в палате\tБез транспортного средства\n\
                    \t\t\n\
                    Y\tОткрыть инвентарь\tЛюбой\n\
                    N\tОткрыть личное меню\tЛюбой", "Отмена", "");
                }
            }
            return 1;
        }
        case D_PRISON_MENU:
        {
            if(!response) return 1;
            if(!listitem) ShowPrisonMenuDoor(playerid);
            else ShowPlayerDialog(playerid, D_PRISON_RUPOR, DIALOG_STYLE_LIST, ""I"Управление рупором", ""I"[1]"W" Холл\n"I"[2]"W" Комната рабочая\n"I"[3]"W" Везде", "Выбрать", "Отмена");
            return 1;
        }
        case D_PRISON_RUPOR:
        {
            if(!response) return ShowPrisonMenu(playerid);
            p_temp[playerid][p_listitem_int] = listitem;
            ShowPlayerDialog(playerid, D_PRISON_RUPOR_TEXT, DIALOG_STYLE_INPUT, ""I"Управление рупором", ""W"Введите какой текст хотите оповестить в данной комнате:", "Ввести", "Отмена");
            return 1;
        }
        case D_PRISON_RUPOR_TEXT:
        {
            if(!response) return ShowPrisonMenu(playerid);
            if(!strlen(inputtext) || strlen(inputtext) < 4 || strlen(inputtext) > 64)
            {
                ShowPlayerDialog(playerid, D_PRISON_RUPOR, DIALOG_STYLE_INPUT, ""I"Управление рупором", ""W"Введите какой текст хотите оповестить в данной комнате:", "Ввести", "Отмена");
                return SendError(playerid, "Вы ничего не ввели.");
            }
            if(AdvertisingCheck(inputtext)) return AdvertisingPunishment(playerid, inputtext, 1);
            STRING_GLOBAL[0] = EOS;
            f(STRING_GLOBAL, "[Рупор] %s: {FFEE00}%s", get_name(playerid), inputtext);
            foreach(new i: Player)
            {
                if(!p_info[i][loggedIn]) continue;
                if(IsPlayerInRangeOfPoint(i, 50.0, -301.8503,1457.4397,2059.8870) && GetPlayerVirtualWorld(i) == 1 && p_temp[playerid][p_listitem_int] == 0)
                    SendClientMessage(i, COLOR_MAIN, STRING_GLOBAL);
                if(IsPlayerInRangeOfPoint(i, 50.0, 164.6087,1113.5807,2086.6179) && GetPlayerVirtualWorld(i) == 1 && p_temp[playerid][p_listitem_int] == 1)
                    SendClientMessage(i, COLOR_MAIN, STRING_GLOBAL);
                if(IsPlayerInRangeOfPoint(i, 50.0, -301.8503,1457.4397,2059.8870) || IsPlayerInRangeOfPoint(i, 50.0, 164.6087,1113.5807,2086.6179) &&
                    GetPlayerVirtualWorld(i) == 1 && p_temp[playerid][p_listitem_int] == 2)
                    SendClientMessage(i, COLOR_MAIN, STRING_GLOBAL);
            }
            p_temp[playerid][p_listitem_int] = -1;
            ShowPrisonMenu(playerid);
            return 1;
        }
        case D_PRISON_DOOR:
        {
            if(!response) return ShowPrisonMenu(playerid);
            new idx = strval(inputtext);
            if((idx != -1 && idx != -2 && idx != -3) && (idx < 1 || idx > 18)) return SendError(playerid, "ID камеры должен быть не менее 1 и не более 18 или -1, -2, -3.");
            if(idx == -1 || idx == -2 || idx == -3)
            {
                switch(idx)
                {
                    case -1:
                    {
                        for(new i; i < sizeof(PrisonDoor); i++)
                        {
                            if(PrisonDoor[i] != INVALID_OBJECT_ID)
                            {
                                DestroyDynamicObject(PrisonDoor[i]);
                                PrisonDoor[i] = INVALID_OBJECT_ID;
                            }
                        }
                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s %s [%d] открыл(-а) все камеры.", GetPlayerFractionRangName(playerid), get_name(playerid), playerid);
                        SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
                        ShowPrisonMenuDoor(playerid);
                    }
                    case -2:
                    {
                        for(new i; i < sizeof(PrisonDoor); i++)
                        {
                            if(PrisonDoor[i] == INVALID_OBJECT_ID)
                                PrisonDoor[i] = CreateDynamicObject(19303, PrisonDoorCoords[i][0], PrisonDoorCoords[i][1], PrisonDoorCoords[i][2], 0.0, 0.0, PrisonDoorCoords[i][3], 1, 1);
                        }
                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s %s [%d] закрыл(-а) все камеры.", GetPlayerFractionRangName(playerid), get_name(playerid), playerid);
                        SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
                        ShowPrisonMenuDoor(playerid);
                    }
                    case -3:
                    {
                        STRING_GLOBAL[0] = EOS;
                        format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s %s [%d] отправил(-а) Всех заключенных в камеры.", GetPlayerFractionRangName(playerid), get_name(playerid), playerid);
                        foreach(new i:Player)
                        {
                            if(p_info[i][jail] != 5) continue;
                            if(p_temp[i][prison_escape_time] > 0) continue;
                            SendInfo(i, STRING_GLOBAL);
                            SpawnPlayer(i);
                        }
                        SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
                        ShowPrisonMenuDoor(playerid);
                    }
                }
            }
            if(idx >= 1 && idx <= 19)
            {
                new str[128];
                if(PrisonDoor[idx-1] != INVALID_OBJECT_ID)
                {
                    DestroyDynamicObject(PrisonDoor[idx-1]);
                    PrisonDoor[idx-1] = INVALID_OBJECT_ID;
                    format(str, sizeof(str), "[F] %s %s [%d] открыл дверь в камере [ID %d].", GetPlayerFractionRangName(playerid), get_name(playerid), playerid, idx);
                    SendFractionMessage(p_info[playerid][member], 0x33CC66FF, str);
                    ShowPrisonMenuDoor(playerid);
                }
                else
                {
                    PrisonDoor[idx-1] = CreateDynamicObject(2930, PrisonDoorCoords[idx-1][0], PrisonDoorCoords[idx-1][1], PrisonDoorCoords[idx-1][2], 0.0, 0.0, PrisonDoorCoords[idx-1][3], 1, 1);
                    format(str, sizeof(str), "[F] %s %s [%d] закрыл дверь в камере [ID %d].", GetPlayerFractionRangName(playerid), get_name(playerid), playerid, idx);
                    SendFractionMessage(p_info[playerid][member], 0x33CC66FF, str);
                    ShowPrisonMenuDoor(playerid);
                }
            }
        }
        case D_PRISON_WORK:
        {
            if(!response) return 1;
            p_temp[playerid][prison_work] = !p_temp[playerid][prison_work];
            if(!p_temp[playerid][prison_work]) DisablePlayerCheckpoint(playerid);
            else
            {
                new idx = random(sizeof(PrisonWorkPos)-1);
                SetPlayerCheckpoint(playerid, PrisonWorkPos[idx][0], PrisonWorkPos[idx][1], PrisonWorkPos[idx][2]-1.0, 1.1);
            }
            SendAccess(playerid, "Вы %s выполнять исправительные работы.", p_temp[playerid][prison_work] == 1 ? ("начали"):("завершили"));
            return 1;
        }
        case D_UPDATE_PLAYER:
        {
            if(!response) return callcmd::menu(playerid, "/0");
            switch(listitem)
            {
                case 0:
                {
                    if(p_info[playerid][cash] < 100000) return SendError(playerid, "У Вас нет столько денег. Используйте /donate");
                    if(p_info[playerid][Update][0] == 1) return SendError(playerid, "У Вас уже имеется данное улучшение.");

                    SetPlayerMoney(playerid, -100000,  true, "купил улучшение <Решительность>");
