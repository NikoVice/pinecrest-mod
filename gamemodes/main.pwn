                    if(player_lobby_settings[playerid][1] < 2 || player_lobby_settings[playerid][1] > 20) return ShowLobbyCreate(playerid), SendError(playerid, "����������� �� ����� ���� ����� 2 � ����� 20.");
                    if(player_lobby_settings[playerid][2] < 60 || player_lobby_settings[playerid][2] > 600) return ShowLobbyCreate(playerid), SendError(playerid, "����� �� ����� ���� ����� 1 � ����� 10.");
