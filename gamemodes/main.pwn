            }
        }
        if(player_state == PLAYER_STATE_ONFOOT && (GetPlayerFamilyID(i) != -1 || gang(i) || mafia(i) || biker(i)) && p_temp[i][rob_fuel_timer] == 1 && p_temp[i][rob_fuel_timer_max] > 0 && p_temp[i][rob_fuel_backup] == 1)
        {
            temp_rob_fuel_idx = p_temp[i][rob_fuel_idx];
            temp_rob_fuel_type = RobberyFuelContract[temp_rob_fuel_idx][rfcType];
            temp_rob_fuel_biz_idx = RobberyFuelContract[temp_rob_fuel_idx][rfcFuelIDx];
            temp_rob_fuel_max = temp_rob_fuel_type == 0 ? MAX_ROBBERY_FUEL_LITERS : MAX_ROBBERY_FUEL_LITERS * 2;
            if(temp_rob_fuel_idx != -1 && GetPlayerVirtualWorld(i) == 0 && IsPlayerInRangeOfPoint(i, 10.0, b_info[temp_rob_fuel_biz_idx][b_enter][0], b_info[temp_rob_fuel_biz_idx][b_enter][1], b_info[temp_rob_fuel_biz_idx][b_enter][2]))
            {
                temp_rob_fuel_liters = RandomEx(5, 10);
                if(p_temp[i][rob_fuel_backup_items][0] < temp_rob_fuel_max)
                {
                    p_temp[i][rob_fuel_backup_items][0] += temp_rob_fuel_liters;
                    if(p_temp[i][rob_fuel_backup_items][0] > temp_rob_fuel_max) p_temp[i][rob_fuel_backup_items][0] = temp_rob_fuel_max;
                }
                new str[64];
                format(str, sizeof(str), "~n~~n~~n~~n~~n~~n~~g~%d LITERS~n~~b~%d SEC.", p_temp[i][rob_fuel_backup_items][0], p_temp[i][rob_fuel_timer_max]);
                GameTextForPlayer(i, str, 500, 3);
