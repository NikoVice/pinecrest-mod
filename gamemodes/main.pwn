GetPlayerMoneySkill(playerid, money, work_id)
{
    new reason_money;
    if(p_info[playerid][p_vip])
    {
        if(p_info[playerid][p_vip] == 3 && p_info[playerid][p_add_vip] == 1) reason_money = money * 2;
        else
        {
            switch(p_info[playerid][p_vip])
            {
                case 1: reason_money = money + ((money / 100) * 25);
                case 2: reason_money = money + ((money / 100) * 50);
                case 3: reason_money = money + ((money / 100) * 75);
            }
        }
    }
    else reason_money = money;

    reason_money += (reason_money / 100) * p_info[playerid][job_skill][work_id];

    return reason_money;
}

CheckPlayerMaxSalarySkill(playerid, idx, salary)
{
    new max_salary = SkillData[idx][sMaxSalary];

    if(p_info[playerid][p_vip])
    {
        if(p_info[playerid][p_vip] == 3 && p_info[playerid][p_add_vip] == 1) max_salary = max_salary * 2;
        else
        {
            switch(p_info[playerid][p_vip])
            {
                case 1: max_salary = max_salary + ((max_salary / 100) * 25);
                case 2: max_salary = max_salary + ((max_salary / 100) * 50);
                case 3: max_salary = max_salary + ((max_salary / 100) * 75);
            }
        }
    }

    if(p_info[playerid][job_skill_salary][idx] + salary < max_salary) return 1;
    return 0;
}
