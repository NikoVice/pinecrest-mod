            p_temp[playerid][p_listitem][39] = -1;
            if(!IsPlayerConnected(id_leader)) return SendError(playerid, "Игрок не в сети.");
            if(p_info[playerid][admin] < 4 && id_leader != playerid) id_leader = playerid;
