        case D_AUCTION_BIZZ_BET:
        {
            if(GetFreeSlotBizz(playerid) == ALL_BUSY_SLOT_BIZZ) return SendError(playerid, "� ��� ��� ���������� ����� ��� �������.");
            new b = p_temp[playerid][p_listitem_int];
            if(!response)
            {
                if(p_temp[playerid][p_GPS] == true) CancelPlayerGPS(playerid);
                SetPlayerGPS(playerid, b_info[b][b_enter][0], b_info[b][b_enter][1], b_info[b][b_enter][2], 5.0);
                return SendAccess(playerid, "������ ��������� �� GPS ����������.");
            }
            else
            {
                new fix_listitem;
                if(sscanf(inputtext, "i", fix_listitem) || !(0 <= fix_listitem <= 999_999_999))
                {
                    STRING_GLOBAL[0] = EOS;
                    f(STRING_GLOBAL, ""W"\
                    �������� �������: %s\n\
                    ��� �������: %s\n\n\
                    ������� ������: ������\n\
                    ���� ������ ������ ���� ������ ������� �� 10 ���������.\n\
