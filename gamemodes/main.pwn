cmd:i(playerid)
{
    if(SRV_ID) return 1;
    SendInfo(playerid, "id: %d", GetVehicleModelEx(GetPlayerVehicleID(playerid)));
    return 1;
}

CMD:hidra(playerid)
{
    if(SRV_ID) return 1;
    new vehicleid = GetPlayerVehicleID(playerid);
    SendAccess(playerid, "Вы установили данный компонент.");
    VEx_AddVehicleComponent(vehicleid, 1087);
    return 1;
}

cmd:rh(playerid)
{
    if(SRV_ID) return 1;
    RemovePlayerFromVehicle(playerid);
    return 1;
}

public OnPlayerDamageStatusUpdateAC(playerid, hitid, hittype, weaponid)
{
    if(!p_info[playerid][loggedIn]) return 0;
    if(hittype == BULLET_HIT_TYPE_PLAYER)
    {
        if(!p_info[hitid][loggedIn]) return 0;
        if(p_info[hitid][admin] > 0 && p_temp[hitid][gm_mode])
            return 0;
    }
    return 1;
}
