                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
                    return 1;
                }
                new free_amount = GetInventoryFreeItems(playerid, item_id);
                if(!(1 <= count <= free_amount))
                {
                    ShowDialogMarketItemsBuyAdd(playerid, item_id);
                    if(!free_amount) SendError(playerid, "� ��������� ��� �����.");
                    else SendError(playerid, "���-�� ������ ������ ���� �� ����� 1 � �� ����� %d.", free_amount);
                    return 1;
                }
            }
            else if(ItemsInfo[item_id][iType] == TYPE_ITEMS_ACCESSORIES)
