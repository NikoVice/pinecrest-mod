SetPlayerNickName(playerid, nick[] = "")
{
    if(!(3 <= strlen(nick) <= 20))
        return 0;

    if(GetPVarInt(playerid, "CHANGE_NICK:FREE") == 1)
    {
        p_info[playerid][free_change_nick] = timestamp+2592000;
        MysqlUpdatePlayerInt(playerid, "free_change_nick", p_info[playerid][free_change_nick]);

        DeletePVar(playerid, "CHANGE_NICK:FREE");

        // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) ������� ��� �� <Durel_Pavel> ���������
        Log(LOG_player, INFO, "%s[%d](%s %s) ������� ��� �� %s ���������",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", nick);
    }
    else if(GetPVarInt(playerid, "CHANGE_NICK:MAYOR") == 1)
    {
        DeletePVar(playerid, "CHANGE_NICK:MAYOR");

        // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2) ������� ��� �� <Durel_Pavel> � �����
        Log(LOG_player, INFO, "%s[%d](%s %s) ������� ��� �� %s � �����",
            get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC", nick);
    }
    else
    {
        if(p_info[playerid][flinmoney] < donate_name) return SendError(playerid, "� ��� ��� ������� Pinecrest Money.");
        // Jeffrey_Collinz[2](127.0.0.1 PC/0.3.7-R2)[150 FM] ������� ��� �� <Durel_Pavel> �� 100 FM
        Log(LOG_player, INFO, "%s[%d](%s %s)[%d FM] ������� ��� �� %s �� %d FM | #Donate", get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP],
            IsPlayerMobile(playerid) ? "Mobile": "PC", p_info[playerid][flinmoney], nick, donate_name);

        p_info[playerid][flinmoney] -= donate_name;
        MysqlUpdatePlayerInt(playerid, "flinmoney", p_info[playerid][flinmoney]);
    }

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `log_name` (`OWNER`, `OLD_NAME`, `NEW_NAME`) VALUES (%d, '%s', '%s')",
    p_info[playerid][ID], get_name(playerid), nick);
    mysql_tquery(con_bd, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `admin_log` SET `PLAYER` = '%s' WHERE `PLAYER` = '%s'",
    nick, get_name(playerid));
    mysql_tquery(con_bd, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `name` = '%e' WHERE `id` = %d",
    nick, p_info[playerid][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `promocode` SET `owner` = '%e' WHERE `ownerid` = %d",
    nick, p_info[playerid][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `partner` = '%s' WHERE `partner` = '%e' LIMIT 1",
        nick, get_name(playerid));
    mysql_tquery(con_bd, STRING_GLOBAL);

    UnLoadPlayerVehicle(playerid);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `vehicle` SET `v_owner` = '%e' WHERE `v_owner_id` = %d",
        nick, p_info[playerid][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL);

    new bizz_id;
    for(new i; i < p_info[playerid][bizz_slots]; i++)
    {
        bizz_id = GetPlayerBizzID(playerid, i);
        if(bizz_id != INVALID_BIZZ_ID)
        {
            strmid(b_info[bizz_id][_owner], nick, 0, strlen(nick), 255);
            save_bizz(bizz_id);
            update_bizz(bizz_id);
        }
    }

    new house_id;
    for(new i; i < p_info[playerid][house_slots]; i++)
    {
        house_id = GetPlayerHouseID(playerid, i);
        if(house_id != INVALID_HOUSE_ID && house_id != p_info[playerid][key_h_rent])
        {
            strmid(h_info[house_id][h_owner], nick, 0, strlen(nick), MAX_PLAYER_NAME);
            update_house(house_id);
            save_house(house_id);
        }
    }

    SendAccess(playerid, "�� �������� �������.");
    SendInfo(playerid, "�������� ��� � ������ ���� (settings.ini > name = Nick_Name).");

    p_info[playerid][loggedIn] = 0;
    Kick(playerid);
    return 1;
}

forward OnPasswordCheckAuth(playerid);
public OnPasswordCheckAuth(playerid)
{
    new bool:match = bcrypt_is_equal();
    if(match == true)
    {
        p_temp[playerid][LoggedTime] = -1;
        if(strlen(p_info[playerid][google_code]) > 5 && (!p_info[playerid][google_auth] || (p_info[playerid][google_auth] && !strequals(p_temp[playerid][session_IP], p_info[playerid][lastIP]))))
            return ShowPlayerDialog(playerid, D_GOOGLE_AUTH, DIALOG_STYLE_INPUT, ""I"Google Authenticator", ""W"������� ����������� ��� �� ���������� Google Authenticator:\n\n{"#cLIGHTRED"}�������� ��������! ��� ������� �� ����.", "�����", "");

        if(ServerInfo[VKSecurity] && IsVKConfirmed(playerid) && (!p_info[playerid][vk_auth] || (p_info[playerid][vk_auth] && !strequals(p_temp[playerid][session_IP], p_info[playerid][lastIP]))))
            return VK_ShowDialogAuth(playerid);

        if(ServerInfo[TGSecurity] && IsTGConfirmed(playerid) && (!p_info[playerid][tg_auth] || (p_info[playerid][tg_auth] && !strequals(p_temp[playerid][session_IP], p_info[playerid][lastIP]))))
            return TG_ShowDialogAuth(playerid);

        LoadPlayerAccount(playerid);
    }
    else ErrorDialogMessage(playerid, 2, 2);
    return 1;
}

forward OnPasswordCheckChange(playerid);
public OnPasswordCheckChange(playerid)
{
    new bool:match = bcrypt_is_equal();
    if(match == true)
        ShowPlayerDialog(playerid, D_CHANGE_PASS_NEW, 1, ""I"�������� ������", ""W"������� ����� ������:", "�����", "������");
    else
        SendError(playerid, "�� ����� �������� ������.");
    return 1;
}

forward OnPasswordHashedNCP(playerid, password_text[]);
public OnPasswordHashedNCP(playerid, password_text[])
{
    new hash[BCRYPT_HASH_LENGTH + 1];
    bcrypt_get_hash(hash);

    strmid(p_info[playerid][password], hash, 0, 128, 128);

    STRING_GLOBAL[0] = EOS;
    mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `password` = '%e' WHERE `id` = %d",
    hash, p_info[playerid][ID]);
    mysql_tquery(con_bd, STRING_GLOBAL);

    SendInfo(playerid, "��� ����� ������: %s", password_text);
    SendInfo(playerid, "������������� ������� ��������. �������: F8");
    save_player(playerid);
    return 1;
}

forward OnPasswordHashed(playerid);
public OnPasswordHashed(playerid)
{
    new hash[BCRYPT_HASH_LENGTH + 1];
    bcrypt_get_hash(hash);

    strmid(p_info[playerid][password], hash, 0, 128, 128);

    ShowPlayerDialog(playerid, D_EMAIL_REG, DIALOG_STYLE_INPUT, ""I"����������� �����", ""W"\
    ����� ������������� ������ ������ ��������, �� �����\n\
    �������� ��� � ������� �������� � ����������� �����.\n\
    ��� ������� �� ��������� ������� ������ ��� ����� ������\n\
    ��������.\n\n\
    "I"������� ���������, �� ���� ����� �����������, �������� ������ Google/Yandex.", "�����", "������");
    return 1;
}

CMD:ans(playerid, params[])
{
    if(p_info[playerid][admin] < 1)
        return 1;

    new target, text[144];
    if(sscanf(params, "us[144]", target, text)) return SendInfo(playerid, "�����������: /ans [id ������] [�����]");

    if(target == INVALID_PLAYER_ID)
        return SendError(playerid, "����� �� ������.");

    if(AdvertisingCheck(text)) return AdvertisingPunishment(playerid, text, 0);

    STRING_GLOBAL[0] = EOS;
    if(p_info[playerid][helper] == 1) format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[H] %s [%d] ������� %s [%d]: %s", get_name(playerid), playerid, get_name(target), target, text);
    else format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s [%d] ������� %s [%d]: %s", get_name(playerid), playerid, get_name(target), target, text);
    SendAdminMessage(0xD99B69FF, STRING_GLOBAL, true);

    if(p_info[playerid][helper] == 1) SendInfo(target, "�������� %s [%d] ������� ���: %s", get_name(playerid), playerid, text);
        else SendInfo(target, "������������� %s [%d] ������� ���: %s", get_name(playerid), playerid, text);

    if(GetPVarInt(target, "report_id")-1 != -1)
    {
        new report_id = GetPVarInt(target, "report_id")-1;

        aReportInfo[report_id][rID] = report_id;
        aReportInfo[report_id][rPlayerID] = INVALID_PLAYER_ID;
        aReportInfo[report_id][rText][0] = EOS;
        aReportInfo[report_id][rWhenWroted_Time] = -1;
        aReportInfo[report_id][rIsTooked] = false;
        aReportInfo[report_id][rWhenWroted_Text][0] = EOS;

        DeletePVar(target, "report_id");

        a_info[playerid][a_ans] = 1;
        MysqlUpdateAdminInt(playerid, "a_ans", a_info[playerid][a_ans]);
    }

    Log(LOG_player, INFO, "%s[%d](%s %s) ������� %s[%d](%s %s): %s | #AdminLogs",
        get_name(playerid), p_info[playerid][ID], p_temp[playerid][session_IP], IsPlayerMobile(playerid) ? "Mobile": "PC",
        get_name(target), p_info[target][ID], p_temp[target][session_IP], IsPlayerMobile(target) ? "Mobile": "PC", text);
    return 1;
}

CMD:alock(playerid, params[])
{
    if(p_info[playerid][admin] < 4) return 1;
    new Float:POS[3], getcar = INVALID_VEHICLE_ID;
    foreach(new i: Vehicle)
    {
        if(veh_info[i][v_admin] == 1)
        {
            GetVehiclePos(i, POS[0], POS[1], POS[2]);
            if(IsPlayerInRangeOfPoint(playerid, 5.0 ,POS[0], POS[1], POS[2])) {
                getcar = i;
                break;
            }
        }
    }
    if(getcar == INVALID_VEHICLE_ID) return SendError(playerid, "�� ������� ������ �� ������������� �������� ���������� ��������������.");
    if(!veh_info[getcar][v_lock])
    {
        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~vehicle locked", 1000, 3);
        PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
        veh_info[getcar][v_lock] = 1;
        new string[48];
        format(string, sizeof(string),"%s ������(�) ���������", get_name(playerid));
        distance_chat(playerid,10.0,0xDE92FFFF,string);
    }
    else
    {
        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~vehicle unlocked", 1000, 3);
        PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
        veh_info[getcar][v_lock] = 0;
        new string[48];
        format(string, sizeof(string),"%s ������(�) ���������", get_name(playerid));
        distance_chat(playerid,10.0,0xDE92FFFF,string);
    }
    SetVehicleParamsVEx(getcar, veh_info[getcar][v_engine], veh_info[getcar][v_light], alarm, veh_info[getcar][v_lock], bonnet, boot, objective);
    OnPlayerUpdateVehicleInfo(playerid, SPEEDO_DOORS);
    return true;
}

CMD:delvehall(playerid, params[])
{
    if(p_info[playerid][admin] < 4) return true;
    foreach(new v: Vehicle)
    {
        if(veh_info[v][v_admin] == 1)
        {
            veh_info[v][v_admin] = 0;
            veh_info[v][v_lock] = 0;
            DestroyVehicleVEx(v);
        }
    }
    return SendAccess(playerid, "�� ������� ��� ������������ �������� ��������� ��������������.");
}

CMD:tpbizmenu(playerid, params[])
{
    if(p_info[playerid][admin] < 7) return true;
    new biz_id = GetPVarInt(playerid, "bID");
    SetPlayerPos(playerid, b_info[biz_id][b_menu][0], b_info[biz_id][b_menu][1], b_info[biz_id][b_menu][2]);
    SetPlayerInterior(playerid, b_info[biz_id][_int]);
    SetPlayerVirtualWorld(playerid, b_info[biz_id][_world]);
    return 1;
}

