    return 1;
}

CMD:bizwar(playerid, params[])
{
    if(!mafia(playerid) && !biker(playerid)) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(p_info[playerid][rang] < 6) return SendError(playerid, "�� �� ������ ������������ ���� ��������.");
    if(BizWar_Info[bWarTime] > 0) return SendError(playerid, "������ ������� ��� ����.");
    if(sscanf(params, "i", params[0])) return SendInfo(playerid, "�����������: /bizwar [id ����������]");
    if(params[0] < 1 || params[0] > 4) return SendError(playerid, "ID ���������� ������ ���� �� ����� 1 � �� ����� 4.");

    if(timestamp_hour < 10 || timestamp_hour > 23) return SendError(playerid, "��������� ������ ������� ��������� � 10:00 �� 23:00.");
    if(!(0 <= timestamp_minute <= 5)) return SendError(playerid, "��������� ������ ���������� ��������� � **:00 �� **:05.");

    if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "�� ���������� � ������������ ��������.");
    if(Iter_Count(gFactionPlayers[p_info[playerid][member]]) < 3) return SendError(playerid, "� ����� ������� ������� ���� ������� � ����.");
    if(GetPVarInt(playerid, "FLOOD:CAPTURE") > timestamp) return SendError(playerid, "�� �� ������ ��� ����� ������������ �������.");
    SetPVarInt(playerid, "FLOOD:CAPTURE", timestamp+10);

    for(new i; i < totalbizz; i++) {
        if(b_info[i][b_mysql_id] == INVALID_MYSQL_ID) continue;
        if(IsPlayerInRangeOfPoint(playerid,2.5,b_info[i][b_enter][0],b_info[i][b_enter][1],b_info[i][b_enter][2])) //fixeds
        {
            if(b_info[i][b_mafia] == p_info[playerid][member]) return SendError(playerid, "������ ������ ����������� ����� �������.");
            if(!(MAFIA_RM <= b_info[i][b_mafia] <= MAFIA_YAKUDZA) && b_info[i][b_mafia] != BIKER && b_info[i][b_mafia] != MAFIA_IRAN)
            {
                b_info[i][b_mafia] = p_info[playerid][member];
                MafiaCountBizz(b_info[i][b_mafia], 1);
                save_bizz(i);
                update_bizz(i);
                SendAccess(playerid, "�� ����� ������ ��� �������� ����� ��� ��������.");
                return 1;
            }
            if(Iter_Count(gFactionPlayers[b_info[i][b_mafia]]) < 3) return SendError(playerid, "� \"%s\" ������� ���� ������� � ����.", GetFractionName(b_info[i][b_mafia]));
            if(params[0] < 3)
            {
                SendAccess(playerid, "�� ������ ������ ������� \"%s\". ����� �������: %d. �������� �������: %s.", b_info[i][_name], params[0], GetFractionName(b_info[i][b_mafia]));
                SendInfo(playerid, "������� ��������� ����� 5 �����.");

                STRING_GLOBAL[0] = EOS;
                format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[F] %s [%d] �� \"%s\" ����� ������ ������� \"%s\". ��������: \"%s\". ����������: %d.", get_name(playerid), playerid, GetFractionName(p_info[playerid][member]), b_info[i][_name], GetFractionName(b_info[i][b_mafia]), params[0]);
                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, STRING_GLOBAL);
                SendFractionMessage(b_info[i][b_mafia], 0x33CC66FF, STRING_GLOBAL);
                SendFractionMessage(p_info[playerid][member], 0x33CC66FF, "[F] ������� ��������� ����� 5 �����.");
                SendFractionMessage(b_info[i][b_mafia], 0x33CC66FF, "[F] ������� ��������� ����� 5 �����.");

                switch(params[0])
                {
                    case 1: {
                        BizWar_Info [ bWarPos ] [ 0 ] = 273;
                        BizWar_Info [ bWarPos ] [ 1 ] = 2429;
                        BizWar_Info [ bWarPos ] [ 2 ] = 450.400146484375;
                        BizWar_Info [ bWarPos ] [ 3 ] = 2558;
                    }
                    case 2: {
                        BizWar_Info [ bWarPos ] [ 0 ] = -469.60003662109375;
                        BizWar_Info [ bWarPos ] [ 1 ] = 2171;
                        BizWar_Info [ bWarPos ] [ 2 ] = -292.60003662109375;
                        BizWar_Info [ bWarPos ] [ 3 ] = 2300;
                    }
                    case 3: {
                        BizWar_Info [ bWarPos ] [ 0 ] = -592.5999145507812;
                        BizWar_Info [ bWarPos ] [ 1 ] = -179;
                        BizWar_Info [ bWarPos ] [ 2 ] = -415.59991455078125;
                        BizWar_Info [ bWarPos ] [ 3 ] = -50;
                    }
                }
                biz_war_gangzone = GangZoneCreate(BizWar_Info [ bWarPos ] [ 0 ],BizWar_Info [ bWarPos ] [ 1 ], BizWar_Info [ bWarPos ] [ 2 ], BizWar_Info [ bWarPos ] [ 3 ]);
                GangZoneShowForAll(biz_war_gangzone, 0xB2B2B2AA);
                GangZoneFlashForAll(biz_war_gangzone, COLOR_RED);

                BizWar_Info[bWarTime] = 450;
                BizWar_Info[bMafia][0] = p_info[playerid][member];
                BizWar_Info[bMafia][1] = b_info[i][b_mafia];
                BizWar_Info[bCount][0] = 0;
                BizWar_Info[bCount][1] = 0;

                InitTopList(p_info[playerid][member], b_info[i][b_mafia], CAPTURE_ID_MAFIA, 450);

                SetTimerEx("BizWarTimer",1000,0,"iii", i, p_info[playerid][member], BizWar_Info[bMafia][1]);

                foreach(new i:Player)
                {
                    if(p_info[i][member] == BizWar_Info[bMafia][0] || p_info[i][member] == BizWar_Info[bMafia][1])
                    {
                        ShowTextDrawForPlayer(i, TD_ID_CAPTURE);
                        CaptureInfoUpdate(i, CAPTURE_ID_MAFIA);
                    }
                }
            }
            else
            {
                SendInfo(playerid, "�������� �� ����� ����� ��� �������.");
                SendInfo(playerid, "����� ������ ���� � ��������� \"Las Venturas\".");
                p_temp[playerid][biz_war_map] = true;
                p_temp[playerid][p_listitem_int] = i;
            }
            return 1 ;
        }
    }
    SendError(playerid, "�� ������� ������ �� �������.");
    return 1;
}

CMD:togphone(playerid, params[])
{
    if(p_temp[playerid][offphone] != true) p_temp[playerid][offphone] = true, SendAccess(playerid, "�� ��������� �������.");
    else if(p_temp[playerid][offphone] == true) p_temp[playerid][offphone] = false, SendAccess(playerid, "�� �������� �������.");
    return 1;
}

CMD:to(playerid, params[])
{
    if(p_info[playerid][member] <= 0 && p_info[playerid][job] <= 0)
        return 1;

    new targetid;
    if(sscanf(params, "u", targetid))
        return SendInfo(playerid, "�����������: /to [id ������]");

    new service_check = GetPVarInt(targetid, "CALL:SERVICES");
    if(service_check != 5) DeletePVar(targetid, "CALL:SERVICES");

    switch(service_check)
    {
        case 0: return SendError(playerid, "����� �� ������� ��� ��� ����� ��� ������ ���-�� �� �������.");
        //case 1: if(!IsPlayerFractionPolice(playerid)) return SendError(playerid, "����� �� ������� ���.");
        case 2: if(!IsPlayerFractionMedic(playerid)) return SendError(playerid, "����� �� ������� ���.");
        case 3:
        {
            if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "�� ������ ���������� � ������������ ��������.");
            if(p_info[playerid][taxi_idx] == 0) return SendError(playerid, "����� �� ������� ���.");
            new tcid = p_info[playerid][taxi_idx], idx = p_temp[targetid][tc_call_idx], type = p_temp[targetid][tc_call_type], vehicleid = GetPlayerVehicleID(playerid);
            if(tcid != idx) return SendError(playerid, "����� �� ������� ���� ������ �����.");
            if(GetBizVehicleType(vehicleid) != type) return SendError(playerid, "���� ������������ �������� �� �������� ��� ��� ������.");
            if(p_temp[playerid][taxi_bots_idx] != 0) DestroyTaxi(playerid);
            p_temp[playerid][taxi_bots_idx] = 0;
            p_temp[playerid][taxi_bots_timer] = RandomEx(120, 240);
        }
        case 4:
        {
            if(p_info[playerid][job] != JOB_MECHANIC) return SendError(playerid, "����� �� ������� ���.");
            if(p_temp[playerid][mechanic_idx] != 0) DestroyMechanic(playerid);
            p_temp[playerid][mechanic_idx] = 0;
            p_temp[playerid][mechanic_timer] = RandomEx(120, 240);
        }
        case 5:
        {
            p_temp[playerid][panic_target_id] = targetid;
        }
        default: return 1;
    }

    new Float: x, Float: y, Float: z;
    GetPlayerPos(targetid, x, y, z);
    SetPlayerGPS(playerid, x, y, z, 4.0);

    SendAccess(playerid, "�� ������ ����� �� %s [%d].", get_name(targetid), targetid);
    SendAccess(targetid, "%s [%d] ������ ��� �����.", get_name(playerid), playerid);
    return 1;
}


