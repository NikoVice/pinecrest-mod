# ============================================================================
#  Pinecrest - server configuration (.env)
#  Read at startup by gamemodes/logic/server_config.inc
#  Format: KEY=VALUE  (lines starting with # are comments)
#  Copy/edit this file per server for multi-server setups.
# ============================================================================

# --- MySQL database ---------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_USER=pinecrestphp
MYSQL_PASSWORD=Ghrf88ls!!
MYSQL_DATABASE=pinecrestphp

# --- Server identity --------------------------------------------------------
# SERVER_NAME: gamemode text / browser hostname shown in the SA-MP list.
SERVER_NAME=Pinecrest RolePlay

# SERVER_ID: logical id of this server instance.
#   -1  = auto-detect from the port set in server.cfg (legacy behaviour)
#    0  = main server, 1, 2, ... = additional servers
SERVER_ID=-1
