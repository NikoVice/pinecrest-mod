# ============================================================================
#  Pinecrest - server configuration template
#  Copy this file to "scriptfiles/.env" and edit the values for each server.
#  Format: KEY=VALUE  (lines starting with # are comments)
# ============================================================================

# --- MySQL database ---------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=your_db_name

# --- Server identity --------------------------------------------------------
# SERVER_NAME: gamemode text / browser hostname shown in the SA-MP list.
SERVER_NAME=Pinecrest RolePlay

# SERVER_ID: logical id of this server instance.
#   -1  = auto-detect from the port set in server.cfg
#    0  = main server, 1, 2, ... = additional servers
SERVER_ID=-1
